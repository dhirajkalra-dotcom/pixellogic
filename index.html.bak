                    </div>
                    <div style="padding:1.25rem 1.5rem;display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:0.6rem;">
                        ${[
                          ['Ctrl + S','Save current project immediately without leaving workspace'],
