    gap: 5px;
    transition: background 0.15s, background-color 0.3s ease;
}
.pl-tut-btn-next:hover { background: #4f46e5; }
.pl-tut-btn-next svg { flex-shrink: 0; }
</style>

<!-- Floating tutorial card (highlight is a CSS class on the element itself) -->
<div id="pl-tutorial-card" role="dialog" aria-label="Pixelogic App Tour">
