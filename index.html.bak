009B (0.94mm 1210x680)","pitchMm":0.94,"panelWidthMm":1210,"panelHeightMm":680,"panelResWidth":1280,"panelResHeight":720,"full":{"r":0.71,"g":0.51,"b":0.41,"w":1.15,"s":0.18},"half":{"r":0.45,"g":0.32,"b":0.27,"w":0.7,"s":0.18}}];

                /* ================================================================
                   LED SHEETS TAB (Excel-Style Multi-Unit & Power Load Schedule)
                   Connected two-way with Pixel Designer & LED Power Catalog
                   ================================================================ */
                const SHEETS_UNIT_TO_MM = { m: 1000, cm: 10, mm: 1, ft: 304.8, in: 25.4 };
                const SHEETS_BREAKERS = [10, 13, 16, 20, 25, 32, 40, 50, 63, 80, 100, 125, 160, 200, 250, 315, 400];
                const getSheetsNextBreaker = (amps) => SHEETS_BREAKERS.find(b => b >= amps) || Math.ceil(amps / 10) * 10;

                const inferLedSpecsFromEntry = (entry) => {
                    if (entry && Number(entry.panelWidthMm) > 0 && Number(entry.panelHeightMm) > 0 && Number(entry.panelResWidth) > 0 && Number(entry.panelResHeight) > 0) {
                        const pw = Number(entry.panelWidthMm);
                        const ph = Number(entry.panelHeightMm);
                        const rw = Number(entry.panelResWidth);
                        const rh = Number(entry.panelResHeight);
                        const exactPitch = Number(entry.pitchMm) || Number((pw / rw).toFixed(2));
                        return {
                            brand: entry.brand,
                            model: entry.model,
                            pitchMm: exactPitch,
                            pitchLabel: `${exactPitch}mm`,
                            panelWidthMm: pw,
                            panelHeightMm: ph,
                            panelResWidth: rw,
                            panelResHeight: rh,
                            full: entry.full || null,
                            half: entry.half || null
                        };
                    }
                    const model = String(entry?.model || '').toUpperCase();
                    let pitchMm = 2.6;
                    let pitchLabel = '2.6mm';
                    if (model.includes('3.9-7.8')) { pitchMm = 3.91; pitchLabel = '3.9 / 7.8mm'; }
                    else if (model.includes('3.91')) { pitchMm = 3.91; pitchLabel = '3.91mm'; }
                    else if (model.includes('1.95')) { pitchMm = 1.95; pitchLabel = '1.95mm'; }
                    else if (model.includes('8.33')) { pitchMm = 8.33; pitchLabel = '8.33mm'; }
                    else if (model === 'D3V') { pitchMm = 3.91; pitchLabel = '3.91mm'; }
                    else if (model === 'D4V') { pitchMm = 4.81; pitchLabel = '4.81mm'; }
                    else if (model.includes('USPORT')) { pitchMm = 6.25; pitchLabel = '6.25mm'; }
                    else if (model.includes('SPHERE')) { pitchMm = 4.0; pitchLabel = '4.0mm (Sphere)'; }
                    else if (model.includes('P7')) { pitchMm = 7.81; pitchLabel = '7.81mm'; }
                    else if (model.includes('P5')) { pitchMm = 5.0; pitchLabel = '5.0mm'; }
                    else {
                        const m = model.match(/(\d+\.\d+)/);
                        if (m) {
                            pitchMm = parseFloat(m[1]);
                            if (Math.abs(pitchMm - 2.9) < 0.05) pitchMm = 2.976;
                            else if (Math.abs(pitchMm - 3.9) < 0.05) pitchMm = 3.91;
                            else if (Math.abs(pitchMm - 4.8) < 0.05) pitchMm = 4.81;
                            else if (Math.abs(pitchMm - 5.9) < 0.05) pitchMm = 5.95;
                            else if (Math.abs(pitchMm - 6.9) < 0.05) pitchMm = 6.94;
                            else if (Math.abs(pitchMm - 1.9) < 0.05) pitchMm = 1.953;
                            else if (Math.abs(pitchMm - 1.5) < 0.05) pitchMm = 1.5625;
                            pitchLabel = `${m[1]}mm`;
                        }
                    }

                    let panelWidthMm = 500;
                    let panelHeightMm = 500;
                    const dimMatch = model.match(/\((\d+)X(\d+)\)/);
                    if (dimMatch) {
                        panelWidthMm = parseInt(dimMatch[1], 10);
                        panelHeightMm = parseInt(dimMatch[2], 10);
                    } else if (model.includes('XL') || model.includes('VANISH 3.9-7.8') || model.includes('TS3.9') || model.includes('P7') || model.includes('ZS 6.9') || model.includes('LS 8.33')) {
                        panelWidthMm = 500;
                        panelHeightMm = 1000;
                    } else if (model.includes('SPHERE LED 1M')) {
                        panelWidthMm = 1000; panelHeightMm = 1000;
                    } else if (model.includes('SPHERE LED 1.5M')) {
                        panelWidthMm = 1500; panelHeightMm = 1500;
                    } else if (model.includes('SPHERE LED 2M')) {
                        panelWidthMm = 2000; panelHeightMm = 2000;
                    } else if (model.includes('SPHERE LED 3M')) {
                        panelWidthMm = 3000; panelHeightMm = 3000;
                    }

                    const panelResWidth = Math.max(16, Math.round(panelWidthMm / pitchMm));
                    const panelResHeight = Math.max(16, Math.round(panelHeightMm / pitchMm));
                    const exactPitch = Number((panelWidthMm / panelResWidth).toFixed(2));

                    return {
                        brand: entry.brand,
                        model: entry.model,
                        pitchMm: exactPitch,
                        pitchLabel,
                        panelWidthMm,
                        panelHeightMm,
                        panelResWidth,
                        panelResHeight,
                        full: entry.full || null,
                        half: entry.half || null
                    };
                };

                const CUSTOM_LED_CATALOG_KEY = 'pixi-logic-custom-led-catalog';

                const loadCustomLedCatalog = () => {
                    if (Array.isArray(state.customLedCatalog)) return state.customLedCatalog;
                    try {
                        const raw = localStorage.getItem(CUSTOM_LED_CATALOG_KEY);
                        const parsed = raw ? JSON.parse(raw) : [];
                        state.customLedCatalog = Array.isArray(parsed) ? parsed : [];
                    } catch (_) {
                        state.customLedCatalog = [];
                    }
                    return state.customLedCatalog;
                };

                const syncCustomLedsIntoPowerData = () => {
                    const customList = loadCustomLedCatalog();
                    customList.forEach(item => {
                        if (!item || !item.brand || !item.model) return;
                        const existingIdx = LED_POWER_DATA.findIndex(d =>
                            String(d.brand).toUpperCase() === String(item.brand).toUpperCase() &&
                            String(d.model).toUpperCase() === String(item.model).toUpperCase()
                        );
                        const powerEntry = {
                            brand: String(item.brand).toUpperCase().trim(),
                            model: String(item.model).trim(),
                            full: item.full || { r: 0.4, g: 0.3, b: 0.25, w: 0.7, s: 0.12 },
                            half: item.half || { r: 0.25, g: 0.2, b: 0.16, w: 0.4, s: 0.12 },
                            isCustom: true,
                            pitchMm: Number(item.pitchMm) || undefined,
                            panelWidthMm: Number(item.panelWidthMm) || undefined,
                            panelHeightMm: Number(item.panelHeightMm) || undefined,
                            panelResWidth: Number(item.panelResWidth) || undefined,
                            panelResHeight: Number(item.panelResHeight) || undefined
                        };
                        if (existingIdx >= 0) {
                            LED_POWER_DATA[existingIdx] = Object.assign({}, LED_POWER_DATA[existingIdx], powerEntry);
                        } else {
                            LED_POWER_DATA.push(powerEntry);
                        }
                    });
                };

                const saveCustomLedCatalog = (list) => {
                    state.customLedCatalog = Array.isArray(list) ? list : [];
                    try {
                        localStorage.setItem(CUSTOM_LED_CATALOG_KEY, JSON.stringify(state.customLedCatalog));
                    } catch (_) {}
                    syncCustomLedsIntoPowerData();
                };

                const getLedSheetsCatalog = () => {
                    syncCustomLedsIntoPowerData();
                    const customList = loadCustomLedCatalog();
                    const catalog = LED_POWER_DATA.map(entry => {
                        const inferred = inferLedSpecsFromEntry(entry);
                        const customMatch = customList.find(c =>
                            String(c.brand).toUpperCase() === String(entry.brand).toUpperCase() &&
                            String(c.model).toUpperCase() === String(entry.model).toUpperCase()
                        );
                        if (customMatch || entry.isCustom) {
                            const src = customMatch || entry;
                            const pw = Number(src.panelWidthMm) || inferred.panelWidthMm || 500;
                            const ph = Number(src.panelHeightMm) || inferred.panelHeightMm || 500;
                            const pitch = Number(src.pitchMm) || inferred.pitchMm || 2.6;
                            const rw = Number(src.panelResWidth) || Math.max(16, Math.round(pw / pitch));
                            const rh = Number(src.panelResHeight) || Math.max(16, Math.round(ph / pitch));
                            const exactPitch = Number(src.pitchMm) || Number((pw / rw).toFixed(2));
                            return {
                                brand: String(src.brand).toUpperCase().trim(),
                                model: String(src.model).trim(),
                                pitchMm: exactPitch,
                                pitchLabel: `${exactPitch}mm`,
                                panelWidthMm: pw,
                                panelHeightMm: ph,
                                panelResWidth: rw,
                                panelResHeight: rh,
                                full: src.full || inferred.full,
                                half: src.half || inferred.half,
                                isCustom: true
                            };
                        }
                        return inferred;
                    });
                    // Also merge any custom LED walls defined in Devices tab
                    try {
                        const customWalls = Array.isArray(state?.devicesV2?.ledWalls) ? state.devicesV2.ledWalls : [];
                        customWalls.forEach(w => {
                            if (!w || !w.brand || !w.model) return;
                            const exists = catalog.some(c => c.brand.toUpperCase() === String(w.brand).toUpperCase() && c.model.toUpperCase() === String(w.model).toUpperCase());
                            if (!exists) {
                                const pw = Number(w.widthMm) || 500;
                                const ph = Number(w.heightMm) || 500;
                                const rw = Number(w.pixelsW) || 192;
                                const rh = Number(w.pixelsH) || 192;
                                const pitch = Number((pw / Math.max(1, rw)).toFixed(2));
                                const maxW = Number(w.powerMaxW) || 150;
                                const typW = Number(w.powerAvgW) || Math.round(maxW * 0.55);
                                const fullWAmps = Number((maxW / 230).toFixed(2));
                                const halfWAmps = Number((typW / 230).toFixed(2));
                                catalog.push({
                                    brand: String(w.brand).toUpperCase(),
                                    model: String(w.model),
                                    pitchMm: pitch,
                                    pitchLabel: `${pitch}mm`,
                                    panelWidthMm: pw,
                                    panelHeightMm: ph,
                                    panelResWidth: rw,
                                    panelResHeight: rh,
                                    full: { r: Number((fullWAmps * 0.6).toFixed(2)), g: Number((fullWAmps * 0.45).toFixed(2)), b: Number((fullWAmps * 0.38).toFixed(2)), w: fullWAmps, s: 0.12 },
                                    half: { r: Number((halfWAmps * 0.6).toFixed(2)), g: Number((halfWAmps * 0.45).toFixed(2)), b: Number((halfWAmps * 0.38).toFixed(2)), w: halfWAmps, s: 0.12 },
                                    isCustom: true
                                });
                            }
                        });
                    } catch (_) {}
                    return catalog;
                };

                const formatSheetUnitNum = (valMm, unit) => {
                    const factor = SHEETS_UNIT_TO_MM[unit] || 1000;
                    const raw = (Number(valMm) || 0) / factor;
                    if (!Number.isFinite(raw) || raw <= 0) return '0';
                    if (unit === 'mm') return String(Math.round(raw));
                    if (unit === 'cm') return Number(raw.toFixed(1)).toString();
                    if (unit === 'm') return Number(raw.toFixed(3)).toString();
                    if (unit === 'in') return Number(raw.toFixed(2)).toString();
                    if (unit === 'ft') return Number(raw.toFixed(2)).toString();
                    return Number(raw.toFixed(2)).toString();
                };

                const applyLedModelToMap = (map, brandName, modelName) => {
                    if (!map) return false;
                    const catalog = getLedSheetsCatalog();
                    const spec = catalog.find(c => c.brand === brandName && c.model === modelName);
                    map.ledBrand = brandName || '';
                    map.ledModel = modelName || '';
                    if (!spec) return false;

                    const prevCalcs = calculateLayout(map) || {};
                    const prevTilesW = Math.max(1, Number(prevCalcs.panelsHorizontally) || Number(map.tilesWide) || 8);
                    const prevTilesH = Math.max(1, Number(prevCalcs.panelsVertically) || Number(map.tilesHigh) || 5);

                    map.ledPitchMm = spec.pitchMm;
                    map.panelWidthMm = spec.panelWidthMm;
                    map.panelHeightMm = spec.panelHeightMm;
                    map.panelDimensionsUnit = 'mm';
                    map.panelResWidth = spec.panelResWidth;
                    map.panelResHeight = spec.panelResHeight;

                    // Preserve tile grid count and update physical screen size in map's preferred unit
                    const newWidthMm = prevTilesW * spec.panelWidthMm;
                    const newHeightMm = prevTilesH * spec.panelHeightMm;
                    const unit = map.screenDimensionsUnit || 'm';
                    const factor = SHEETS_UNIT_TO_MM[unit] || 1000;
                    map.screenWidthValue = Number((newWidthMm / factor).toFixed(4));
                    map.screenHeightValue = Number((newHeightMm / factor).toFixed(4));
                    map.tilesWide = String(prevTilesW);
                    map.tilesHigh = String(prevTilesH);

                    try { applyShapeMask(map); } catch (_) {}
                    return true;
                };

                const updateMapDimensionInUnit = (map, axis, valueInUnit, unit) => {
                    if (!map) return;
                    const numeric = parseFloat(valueInUnit);
                    if (!Number.isFinite(numeric) || numeric <= 0) return;
                    const factor = SHEETS_UNIT_TO_MM[unit] || 1000;
                    const targetMm = numeric * factor;
                    const panelW = Math.max(1, Number(map.panelWidthMm) || 500);
                    const panelH = Math.max(1, Number(map.panelHeightMm) || 500);
                    const curCalcs = calculateLayout(map) || {};
                    const curWidthMm = Number(curCalcs.screenWidthMm) || (panelW * 8);
                    const curHeightMm = Number(curCalcs.screenHeightMm) || (panelH * 5);

                    const nextWidthMm = axis === 'w' ? targetMm : curWidthMm;
                    const nextHeightMm = axis === 'h' ? targetMm : curHeightMm;

                    // Keep the map's screenDimensionsUnit synced to what the user edited or convert cleanly
                    const mapUnit = map.screenDimensionsUnit || 'm';
                    const mapFactor = SHEETS_UNIT_TO_MM[mapUnit] || 1000;
                    map.screenWidthValue = Number((nextWidthMm / mapFactor).toFixed(4));
                    map.screenHeightValue = Number((nextHeightMm / mapFactor).toFixed(4));
                    map.tilesWide = String(Math.max(1, Math.round(nextWidthMm / panelW)));
                    map.tilesHigh = String(Math.max(1, Math.round(nextHeightMm / panelH)));
                    try { applyShapeMask(map); } catch (_) {}
                };

                const updateMapTilesCount = (map, axis, tilesCount) => {
                    if (!map) return;
                    const t = Math.max(1, Math.round(parseFloat(tilesCount) || 1));
                    const panelW = Math.max(1, Number(map.panelWidthMm) || 500);
                    const panelH = Math.max(1, Number(map.panelHeightMm) || 500);
                    const curCalcs = calculateLayout(map) || {};
                    const tilesW = axis === 'w' ? t : Math.max(1, Number(curCalcs.panelsHorizontally) || 1);
                    const tilesH = axis === 'h' ? t : Math.max(1, Number(curCalcs.panelsVertically) || 1);
                    const nextWidthMm = tilesW * panelW;
                    const nextHeightMm = tilesH * panelH;
                    const mapUnit = map.screenDimensionsUnit || 'm';
                    const mapFactor = SHEETS_UNIT_TO_MM[mapUnit] || 1000;
                    map.screenWidthValue = Number((nextWidthMm / mapFactor).toFixed(4));
                    map.screenHeightValue = Number((nextHeightMm / mapFactor).toFixed(4));
                    map.tilesWide = String(tilesW);
                    map.tilesHigh = String(tilesH);
                    try { applyShapeMask(map); } catch (_) {}
                };

                const renderSheetsTab = () => {
                    const c = mainContent.sheets;
                    if (!c) return;

                    const activeProject = state.projects.find(p => p.id === state.activeProjectId) || state.projects[0];
                    if (!activeProject) {
                        c.innerHTML = `<div class="p-8 text-center text-gray-400">No active project found. Create a project in the Projects tab first.</div>`;
                        return;
                    }
                    if (!Array.isArray(activeProject.pixelMaps) || activeProject.pixelMaps.length === 0) {
                        const firstMap = createNewPixelMapObject(1);
                        activeProject.pixelMaps = [firstMap];
                        activeProject.activePixelMapId = firstMap.id;
                    }

                    const sheetsState = state.sheetsState = state.sheetsState || {
                        activeSheet: 'schedule', // 'schedule' | 'catalog' | 'drawings'
                        voltage: 230,
                        phases: 3,
                        brightness: 'full', // 'full' | 'half'
                        scenario: 'w', // 'w' | 'avg' | 'r' | 'g' | 'b' | 's'
                        catalogBrandFilter: 'ALL',
                        catalogSearch: '',
                        selectedCellRef: 'A1',
                        selectedCellFormula: 'Synced with Pixel Designer (project.pixelMaps)'
                    };

                    const catalog = getLedSheetsCatalog();
                    const brands = [...new Set(catalog.map(d => d.brand))].sort();

                    // Build brand pitch summary for dropdown labels
                    const brandPitchSummary = {};
                    brands.forEach(b => {
                        const pitches = [...new Set(catalog.filter(x => x.brand === b).map(x => x.pitchMm))].sort((a, z) => a - z);
                        if (pitches.length === 1) brandPitchSummary[b] = `P${pitches[0]}mm`;
                        else if (pitches.length > 1) brandPitchSummary[b] = `P${pitches[0]}–P${pitches[pitches.length - 1]}mm`;
                        else brandPitchSummary[b] = '';
                    });

                    // Calculate per-row data for Project Schedule
                    let sumTiles = 0;
                    let sumAreaSqM = 0;
                    let sumAreaSqFt = 0;
                    let sumPixels = 0;
                    let sumAmps = 0;
                    let sumWatts = 0;

                    const rowsComputed = activeProject.pixelMaps.map((map, idx) => {
                        const calcs = calculateLayout(map) || {};
                        const panelW = Math.max(1, Number(map.panelWidthMm) || 500);
                        const panelH = Math.max(1, Number(map.panelHeightMm) || 500);
                        const resW = Math.max(1, Number(map.panelResWidth) || 192);
                        const resH = Math.max(1, Number(map.panelResHeight) || 192);
                        const tilesW = Math.max(1, Number(calcs.panelsHorizontally) || Math.round((Number(calcs.screenWidthMm) || 4000) / panelW));
                        const tilesH = Math.max(1, Number(calcs.panelsVertically) || Math.round((Number(calcs.screenHeightMm) || 2500) / panelH));
                        const totalTiles = Math.max(1, Number(calcs.totalPanels) || (tilesW * tilesH));
                        const widthMm = Number(calcs.screenWidthMm) || (tilesW * panelW);
                        const heightMm = Number(calcs.screenHeightMm) || (tilesH * panelH);
                        const totalResW = Number(calcs.totalResWidth) || (tilesW * resW);
                        const totalResH = Number(calcs.totalResHeight) || (tilesH * resH);

                        // Auto-match or read stored LED Brand & Model
                        let ledBrand = map.ledBrand || '';
                        let ledModel = map.ledModel || '';
                        let matchedSpec = catalog.find(item => item.brand === ledBrand && item.model === ledModel);
                        if (!matchedSpec && !ledBrand && !ledModel) {
                            // Try matching by cabinet size & resolution or default to first brand only if explicitly chosen
                            matchedSpec = catalog.find(item => item.panelWidthMm === panelW && item.panelHeightMm === panelH && Math.abs(item.panelResWidth - resW) <= 4);
                            if (matchedSpec) {
                                ledBrand = matchedSpec.brand;
                                ledModel = matchedSpec.model;
                                map.ledBrand = ledBrand;
                                map.ledModel = ledModel;
                            }
                        }

                        const pitchMm = matchedSpec
                            ? matchedSpec.pitchMm
                            : Number((panelW / Math.max(1, resW)).toFixed(2));

                        // Power calculation per tile
                        let perTileAmps = null;
                        if (matchedSpec) {
                            const modeObj = (sheetsState.brightness === 'half' && matchedSpec.half) ? matchedSpec.half : matchedSpec.full;
                            if (modeObj) {
                                if (sheetsState.scenario === 'avg') {
                                    const vals = ['r', 'g', 'b'].map(k => Number(modeObj[k]) || 0).filter(v => v > 0);
                                    perTileAmps = vals.length ? (vals.reduce((a, b) => a + b, 0) / vals.length) : (modeObj.w ? modeObj.w * 0.55 : null);
                                } else {
                                    perTileAmps = modeObj[sheetsState.scenario] != null ? Number(modeObj[sheetsState.scenario]) : (modeObj.w != null ? Number(modeObj.w) : null);
                                }
                            }
                        }
                        if (perTileAmps == null) {
                            // Fallback engineering estimate based on cabinet area (approx 600 W/m2 full white, 300 W/m2 half)
                            const cabAreaSqM = (panelW * panelH) / 1e6;
                            const estWattsPerTile = cabAreaSqM * (sheetsState.brightness === 'half' ? 320 : 600) * (sheetsState.scenario === 's' ? 0.15 : (sheetsState.scenario === 'avg' ? 0.55 : 1));
                            perTileAmps = estWattsPerTile / Math.max(100, Number(sheetsState.voltage) || 230);
                        }

                        const totalAmps = perTileAmps * totalTiles;
                        const totalWatts = totalAmps * (Number(sheetsState.voltage) || 230);
                        const totalKw = totalWatts / 1000;
                        const totalKva = totalKw / 0.9;
                        const phases = Math.max(1, Number(sheetsState.phases) || 3);
                        const tilesPerPhase = Math.ceil(totalTiles / phases);
                        const perPhaseAmps = perTileAmps * tilesPerPhase;
                        const breakerAmps = getSheetsNextBreaker(perPhaseAmps * 1.25);

                        const areaSqM = (widthMm / 1000) * (heightMm / 1000);
                        const areaSqFt = (widthMm / 304.8) * (heightMm / 304.8);

                        sumTiles += totalTiles;
                        sumAreaSqM += areaSqM;
                        sumAreaSqFt += areaSqFt;
                        sumPixels += (totalResW * totalResH);
                        sumAmps += totalAmps;
                        sumWatts += totalWatts;

                        return {
                            idx,
                            map,
                            isActive: String(map.id) === String(activeProject.activePixelMapId),
                            ledBrand,
                            ledModel,
                            matchedSpec,
                            pitchMm,
                            panelW,
                            panelH,
                            resW,
                            resH,
                            tilesW,
                            tilesH,
                            totalTiles,
                            widthMm,
                            heightMm,
                            totalResW,
                            totalResH,
                            perTileAmps,
                            totalAmps,
                            totalWatts,
                            totalKw,
                            totalKva,
                            perPhaseAmps,
                            breakerAmps,
                            areaSqM,
                            areaSqFt
                        };
                    });

                    const sumKw = sumWatts / 1000;
                    const sumKva = sumKw / 0.9;
                    const sumPerPhaseAmps = sumAmps / Math.max(1, Number(sheetsState.phases) || 3);
                    const sumBreaker = getSheetsNextBreaker(sumPerPhaseAmps * 1.25);

                    // Master Calculations aggregation: Segregate by Brand, Model, and Pitch
                    const masterGroupsMap = new Map();

                    rowsComputed.forEach(r => {
                        let brandName = (r.ledBrand || (r.matchedSpec ? r.matchedSpec.brand : '')).trim();
                        let modelName = (r.ledModel || (r.matchedSpec ? r.matchedSpec.model : '')).trim();
                        if (!brandName && !modelName) {
                            brandName = 'CUSTOM';
                            modelName = `${r.panelW}×${r.panelH}mm Panel`;
                        } else if (!brandName) {
                            brandName = 'CUSTOM';
                        } else if (!modelName) {
                            modelName = `${r.panelW}×${r.panelH}mm`;
                        }
                        brandName = brandName.toUpperCase();

                        const pitchMm = Number(r.pitchMm != null ? r.pitchMm : (r.panelW / Math.max(1, r.resW)).toFixed(2));
                        const panelW = r.panelW;
                        const panelH = r.panelH;
                        const resW = r.resW;
                        const resH = r.resH;
                        const groupKey = `${brandName}____${modelName}____${pitchMm}____${panelW}x${panelH}`;

                        if (!masterGroupsMap.has(groupKey)) {
                            masterGroupsMap.set(groupKey, {
                                key: groupKey,
                                brand: brandName,
                                model: modelName,
                                pitchMm: pitchMm,
                                panelW: panelW,
                                panelH: panelH,
                                resW: resW,
                                resH: resH,
                                tileAreaSqM: (panelW * panelH) / 1e6,
                                tileAreaSqFt: ((panelW * panelH) / 1e6) * 10.76391,
                                perTileAmps: r.perTileAmps,
                                matchedSpec: r.matchedSpec,
                                totalTiles: 0,
                                totalAreaSqM: 0,
                                totalAreaSqFt: 0,
                                totalPixels: 0,
                                totalWatts: 0,
                                totalAmps: 0,
                                screens: []
                            });
                        }

                        const grp = masterGroupsMap.get(groupKey);
                        grp.totalTiles += r.totalTiles;
                        grp.totalAreaSqM += r.areaSqM;
                        grp.totalAreaSqFt += r.areaSqFt;
                        grp.totalPixels += (r.totalResW * r.totalResH);
                        grp.totalWatts += r.totalWatts;
                        grp.totalAmps += r.totalAmps;
                        grp.screens.push({
                            mapId: r.map.id,
                            name: r.map.name || `Screen ${r.idx + 1}`,
                            tilesW: r.tilesW,
                            tilesH: r.tilesH,
                            totalTiles: r.totalTiles,
                            widthMm: r.widthMm,
                            heightMm: r.heightMm,
                            areaSqM: r.areaSqM,
                            areaSqFt: r.areaSqFt,
                            totalResW: r.totalResW,
                            totalResH: r.totalResH,
                            totalWatts: r.totalWatts,
                            totalKw: r.totalKw,
                            totalAmps: r.totalAmps,
                            perTileAmps: r.perTileAmps
                        });
                    });

                    const masterCalcGroups = Array.from(masterGroupsMap.values()).sort((a, b) => {
                        const cmpBrand = a.brand.localeCompare(b.brand);
                        if (cmpBrand !== 0) return cmpBrand;
                        const cmpModel = a.model.localeCompare(b.model);
                        if (cmpModel !== 0) return cmpModel;
                        return a.pitchMm - b.pitchMm;
                    });

                    // Finalize electrical load stats per group
                    masterCalcGroups.forEach(grp => {
                        grp.totalKw = grp.totalWatts / 1000;
                        grp.totalKva = grp.totalKw / 0.9;
                        const phases = Math.max(1, Number(sheetsState.phases) || 3);
                        const tilesPerPhase = Math.ceil(grp.totalTiles / phases);
                        grp.perPhaseAmps = grp.perTileAmps * tilesPerPhase;
                        grp.breakerAmps = getSheetsNextBreaker(grp.perPhaseAmps * 1.25);
                        grp.pctTiles = sumTiles > 0 ? ((grp.totalTiles / sumTiles) * 100).toFixed(1) : '0.0';
                        grp.pctArea = sumAreaSqM > 0 ? ((grp.totalAreaSqM / sumAreaSqM) * 100).toFixed(1) : '0.0';
                        grp.pctWatts = sumWatts > 0 ? ((grp.totalWatts / sumWatts) * 100).toFixed(1) : '0.0';
                        grp.heatBtu = Math.round(grp.totalWatts * 3.412142);
                        grp.perTileWatts = grp.perTileAmps * (Number(sheetsState.voltage) || 230);
                    });

                    const UNIT_META = {
                        m:  { label: 'Meters (m)',      short: 'm',  step: '0.01', min: '0.01', color: 'text-emerald-300' },
                        mm: { label: 'Millimeters (mm)', short: 'mm', step: '10',   min: '10',   color: 'text-teal-200' },
                        cm: { label: 'Centimeters (cm)', short: 'cm', step: '1',    min: '1',    color: 'text-blue-200' },
                        in: { label: 'Inches (in)',      short: 'in', step: '0.5',  min: '1',    color: 'text-purple-200' },
                        ft: { label: 'Feet (ft)',        short: 'ft', step: '0.1',  min: '0.1',  color: 'text-amber-200' }
                    };
                    if (!sheetsState.sizeUnit) sheetsState.sizeUnit = 'm';
                    if (!sheetsState.catalogCabUnit) sheetsState.catalogCabUnit = 'mm';

                    const renderScheduleTableHtml = () => {
                        const colLetters = ['A','B','C','D','E','F','G','H','I','J','K','L','M','N','O','P','Q'];
                        const activeGlobalUnit = UNIT_META[sheetsState.sizeUnit] ? sheetsState.sizeUnit : 'm';
                        const uMetaGlobal = UNIT_META[activeGlobalUnit];

                        return `
                        <table class="pl-excel-table" id="pl-sheets-schedule-table">
                            <thead>
                                <tr class="pl-excel-col-letters">
                                    <th class="pl-excel-rownum">fx</th>
                                    ${colLetters.map(l => `<th>${l}</th>`).join('')}
                                </tr>
                                <tr class="pl-excel-group-headers">
                                    <th class="pl-excel-rownum">#</th>
                                    <th colspan="4" style="background:#112233;color:#38bdf8;">Screen &amp; LED Brand / Pitch</th>
                                    <th colspan="3" style="background:#1c1d36;color:#a78bfa;">Tile Grid</th>
                                    <th colspan="2" style="background:#0f2922;color:#34d399;">
                                        <div class="flex items-center justify-center gap-1.5">
                                            <span>Screen Size:</span>
                                            <select id="sheets-header-unit-select" class="bg-slate-950/90 border border-emerald-500/50 rounded px-1.5 py-0.5 text-[11px] text-emerald-300 font-bold focus:outline-none cursor-pointer" title="Switch Screen Size unit for all rows (m, mm, cm, in, ft)">
                                                ${Object.entries(UNIT_META).map(([k, v]) => `<option value="${k}" class="bg-slate-900 text-white" ${activeGlobalUnit === k ? 'selected' : ''}>${v.label}</option>`).join('')}
                                            </select>
                                        </div>
                                    </th>
                                    <th colspan="1" style="background:#1f2430;color:#e2e8f0;">Pixels</th>
                                    <th colspan="6" style="background:#2d1a1e;color:#fb7185;">Power Load (${sheetsState.voltage}V · ${sheetsState.phases}Ph · ${sheetsState.brightness === 'half' ? '50%' : '100%'})</th>
                                    <th colspan="1" style="background:#162032;color:#94a3b8;">Sync</th>
                                </tr>
                                <tr class="pl-excel-sub-headers">
                                    <th class="pl-excel-rownum">Row</th>
                                    <th style="min-width:145px;">Screen Name</th>
                                    <th style="min-width:165px;">LED Brand (Pitch)</th>
                                    <th style="min-width:220px;">LED Model &amp; Pitch</th>
                                    <th style="min-width:118px;">Cabinet (mm / px)</th>
                                    <th style="min-width:68px;">Tiles W</th>
                                    <th style="min-width:68px;">Tiles H</th>
                                    <th style="min-width:68px;">Total</th>
                                    <th style="min-width:92px;">W (${uMetaGlobal.short})</th>
                                    <th style="min-width:92px;">H (${uMetaGlobal.short})</th>
                                    <th style="min-width:118px;">Resolution (px)</th>
                                    <th style="min-width:74px;">A / Tile</th>
                                    <th style="min-width:84px;">Total A</th>
                                    <th style="min-width:105px;">Load (W / kW)</th>
                                    <th style="min-width:78px;">kVA</th>
                                    <th style="min-width:82px;">A / Phase</th>
                                    <th style="min-width:82px;">Breaker</th>
                                    <th style="min-width:168px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${rowsComputed.map(r => {
                                    const rowNum = r.idx + 1;
                                    const rowUnit = activeGlobalUnit;
                                    const uMeta = uMetaGlobal;

                                    const modelsForRowBrand = r.ledBrand
                                        ? catalog.filter(c => c.brand === r.ledBrand)
                                        : catalog;

                                    const brandOpts = `<option value="">-- Custom / Select Brand --</option>` +
                                        brands.map(b => `<option value="${escapeHtml(b)}" ${r.ledBrand === b ? 'selected' : ''}>${escapeHtml(b)} (${brandPitchSummary[b]})</option>`).join('');

                                    const modelOpts = `<option value="">-- Select LED Model &amp; Pitch --</option>` +
                                        modelsForRowBrand.map(m => {
                                            const val = `${m.brand}|||${m.model}`;
                                            const isSel = r.ledBrand === m.brand && r.ledModel === m.model;
                                            const prefix = r.ledBrand ? '' : `${m.brand} · `;
                                            return `<option value="${escapeHtml(val)}" ${isSel ? 'selected' : ''}>${escapeHtml(prefix + m.model)} — P${m.pitchMm}mm (${m.panelWidthMm}×${m.panelHeightMm}mm)</option>`;
                                        }).join('');

                                    const allUnitsTooltip = `m: ${formatSheetUnitNum(r.widthMm, 'm')}×${formatSheetUnitNum(r.heightMm, 'm')}m | mm: ${formatSheetUnitNum(r.widthMm, 'mm')}×${formatSheetUnitNum(r.heightMm, 'mm')}mm | cm: ${formatSheetUnitNum(r.widthMm, 'cm')}×${formatSheetUnitNum(r.heightMm, 'cm')}cm | in: ${formatSheetUnitNum(r.widthMm, 'in')}×${formatSheetUnitNum(r.heightMm, 'in')}in | ft: ${formatSheetUnitNum(r.widthMm, 'ft')}×${formatSheetUnitNum(r.heightMm, 'ft')}ft`;

                                    return `
                                    <tr class="pl-excel-row ${r.isActive ? 'active-map-row' : ''}" data-map-id="${r.map.id}">
                                        <td class="pl-excel-rownum cursor-pointer" data-action="activate-row" data-map-id="${r.map.id}" title="Click to set as active screen in Pixel Designer">
                                            ${r.isActive ? '<span class="inline-block w-2 h-2 rounded-full bg-emerald-400 mr-1"></span>' : ''}${rowNum}
                                        </td>
                                        <td>
                                            <input type="text" class="pl-excel-input font-medium text-white" data-cell="A${rowNum}" data-formula="=SCREEN_NAME(${r.idx + 1})" data-map-id="${r.map.id}" data-sheet-field="name" value="${escapeHtml(r.map.name || '')}" />
                                        </td>
                                        <td>
                                            <select class="pl-excel-select text-sky-300 font-medium" data-cell="B${rowNum}" data-formula="=LED_BRAND(${r.idx + 1})" data-map-id="${r.map.id}" data-sheet-field="brand">
                                                ${brandOpts}
                                            </select>
                                        </td>
                                        <td>
                                            <select class="pl-excel-select text-emerald-300 font-medium" data-cell="C${rowNum}" data-formula="=LED_MODEL_PITCH(${r.idx + 1})" data-map-id="${r.map.id}" data-sheet-field="model">
                                                ${modelOpts}
                                            </select>
                                        </td>
                                        <td class="pl-excel-readonly text-center text-xs text-slate-300" title="Cabinet Dimensions (mm) and Pixel Resolution (px)">
                                            ${r.panelW}×${r.panelH}mm <span class="text-slate-500">(${r.resW}×${r.resH}px)</span>
                                        </td>
                                        <td>
                                            <input type="number" min="1" step="1" class="pl-excel-input num text-violet-300 font-semibold" data-cell="E${rowNum}" data-formula="=ROUND(W_MM / ${r.panelW}, 0)" data-map-id="${r.map.id}" data-sheet-tiles="w" value="${r.tilesW}" />
                                        </td>
                                        <td>
                                            <input type="number" min="1" step="1" class="pl-excel-input num text-violet-300 font-semibold" data-cell="F${rowNum}" data-formula="=ROUND(H_MM / ${r.panelH}, 0)" data-map-id="${r.map.id}" data-sheet-tiles="h" value="${r.tilesH}" />
                                        </td>
                                        <td class="pl-excel-readonly font-bold text-violet-200 text-center">
                                            ${r.totalTiles}
                                        </td>
                                        <!-- Compact Screen Size (W and H controlled by Screen Size header unit dropdown) -->
                                        <td title="${escapeHtml(allUnitsTooltip)}">
                                            <input type="number" min="${uMeta.min}" step="${uMeta.step}" class="pl-excel-input num ${uMeta.color} font-semibold" data-cell="H${rowNum}" data-formula="=WIDTH_${rowUnit.toUpperCase()} (${allUnitsTooltip})" data-map-id="${r.map.id}" data-sheet-unit="${rowUnit}" data-sheet-axis="w" value="${formatSheetUnitNum(r.widthMm, rowUnit)}" />
                                        </td>
                                        <td title="${escapeHtml(allUnitsTooltip)}">
                                            <input type="number" min="${uMeta.min}" step="${uMeta.step}" class="pl-excel-input num ${uMeta.color} font-semibold" data-cell="I${rowNum}" data-formula="=HEIGHT_${rowUnit.toUpperCase()} (${allUnitsTooltip})" data-map-id="${r.map.id}" data-sheet-unit="${rowUnit}" data-sheet-axis="h" value="${formatSheetUnitNum(r.heightMm, rowUnit)}" />
                                        </td>
                                        <!-- Resolution -->
                                        <td class="pl-excel-readonly text-center font-semibold text-slate-200">
                                            ${r.totalResW} × ${r.totalResH}
                                        </td>
                                        <!-- Power Load Columns -->
                                        <td class="pl-excel-readonly text-rose-200" title="${r.matchedSpec ? 'Measured lab report value' : 'Estimated from cabinet area'}">
                                            ${r.perTileAmps.toFixed(2)} A
                                        </td>
                                        <td class="pl-excel-readonly font-bold text-rose-300">
                                            ${r.totalAmps.toFixed(2)} A
                                        </td>
                                        <td class="pl-excel-readonly font-semibold text-amber-300">
                                            ${Math.round(r.totalWatts).toLocaleString()} W <span class="text-xs text-slate-400">(${r.totalKw.toFixed(2)} kW)</span>
                                        </td>
                                        <td class="pl-excel-readonly text-amber-200">
                                            ${r.totalKva.toFixed(2)} kVA
                                        </td>
                                        <td class="pl-excel-readonly text-orange-300">
                                            ${r.perPhaseAmps.toFixed(2)} A
                                        </td>
                                        <td class="pl-excel-readonly font-bold text-yellow-400 text-center">
                                            ${r.breakerAmps} A
                                        </td>
                                        <td class="px-2 py-1 text-center">
                                            <div class="flex items-center justify-center gap-1">
                                                <button type="button" class="px-2 py-1 rounded bg-emerald-600/80 hover:bg-emerald-500 text-white text-[11px] font-semibold" data-action="open-in-designer" data-map-id="${r.map.id}" title="Open this screen in Pixel Designer">
                                                    Design →
                                                </button>
                                                <button type="button" class="px-2 py-1 rounded bg-sky-600/85 hover:bg-sky-500 text-white text-[11px] font-semibold" data-action="open-in-drawings" data-map-id="${r.map.id}" title="Open 8 CAD Engineering Drawings for this screen">
                                                    CAD
                                                </button>
                                                <button type="button" class="px-2 py-1 rounded bg-cyan-600/80 hover:bg-cyan-500 text-white text-[11px] font-semibold" data-action="open-in-patching" data-map-id="${r.map.id}" title="Open &amp; Sync this screen in LED Patching">
                                                    Patch
                                                </button>
                                                <button type="button" class="px-1.5 py-1 rounded bg-amber-600/70 hover:bg-amber-500 text-white text-[11px]" data-action="open-in-power" data-map-id="${r.map.id}" title="Send this screen's LED model &amp; tile count to Power Calculator">
                                                    ⚡
                                                </button>
                                                <button type="button" class="px-1.5 py-1 rounded bg-slate-700 hover:bg-slate-600 text-slate-200 text-[11px]" data-action="duplicate-row" data-map-id="${r.map.id}" title="Duplicate Screen Row">
                                                    Dup
                                                </button>
                                                ${activeProject.pixelMaps.length > 1 ? `
                                                <button type="button" class="px-1.5 py-1 rounded bg-rose-800/70 hover:bg-rose-600 text-rose-100 text-[11px]" data-action="delete-row" data-map-id="${r.map.id}" title="Delete Screen Row">
                                                    ×
                                                </button>` : ''}
                                            </div>
                                        </td>
                                    </tr>`;
                                }).join('')}
                            </tbody>
                            <tfoot>
                                <tr class="bg-slate-900/95 font-bold text-slate-100 border-t-2 border-emerald-500/50">
                                    <td class="pl-excel-rownum text-emerald-400">Σ</td>
                                    <td colspan="4" class="px-3 py-2 text-left text-emerald-300">
                                        PROJECT TOTALS (${rowsComputed.length} Screen${rowsComputed.length === 1 ? '' : 's'})
                                    </td>
                                    <td colspan="2" class="px-2 py-2 text-right text-slate-400">Total Tiles:</td>
                                    <td class="px-2 py-2 text-center text-violet-300 font-mono">${sumTiles}</td>
                                    <td colspan="2" class="px-2 py-2 text-center text-emerald-300 font-mono" title="Total Screen Area">${sumAreaSqM.toFixed(2)} m² (${sumAreaSqFt.toFixed(1)} ft²)</td>
                                    <td class="px-2 py-2 text-center text-slate-200 font-mono">${(sumPixels / 1e6).toFixed(2)} MP</td>
                                    <td class="px-2 py-2 text-right text-slate-400 font-mono">Σ Load:</td>
                                    <td class="px-2 py-2 text-right text-rose-300 font-mono">${sumAmps.toFixed(2)} A</td>
                                    <td class="px-2 py-2 text-right text-amber-300 font-mono">${Math.round(sumWatts).toLocaleString()} W (${sumKw.toFixed(2)} kW)</td>
                                    <td class="px-2 py-2 text-right text-amber-200 font-mono">${sumKva.toFixed(2)} kVA</td>
                                    <td class="px-2 py-2 text-right text-orange-300 font-mono">${sumPerPhaseAmps.toFixed(2)} A/ph</td>
                                    <td class="px-2 py-2 text-center text-yellow-400 font-mono">${sumBreaker} A</td>
                                    <td class="px-2 py-2 text-center text-xs text-slate-500 font-mono">
                                        ${rowsComputed.length} Screen${rowsComputed.length === 1 ? '' : 's'}
                                    </td>
                                </tr>
                            </tfoot>
                        </table>`;
                    };

                    const renderAddBrandPanelHtml = () => {
                        if (!sheetsState.showAddBrandModal) return '';
                        const draft = sheetsState.newLedDraft = sheetsState.newLedDraft || {
                            brand: '',
                            model: '',
                            pitchMm: 2.6,
                            panelWidthMm: 500,
                            panelHeightMm: 500,
                            panelResWidth: 192,
                            panelResHeight: 192,
                            maxWatts: 165,
                            halfWatts: 95,
                            fullW: 0.72,
                            fullR: 0.48,
                            fullG: 0.31,
                            fullB: 0.25,
                            fullS: 0.14,
                            halfW: 0.41,
                            isEditing: false
                        };
                        return `
                        <div class="border-b border-emerald-500/40 bg-slate-900/95 p-4 space-y-3">
                            <div class="flex items-center justify-between gap-2 flex-wrap">
                                <div class="flex items-center gap-2">
                                    <span class="px-2 py-0.5 rounded bg-emerald-500/20 border border-emerald-500/40 text-emerald-300 text-xs font-bold uppercase tracking-wider">
                                        ${draft.isEditing ? 'Edit LED Brand / Model' : '+ Add New LED Brand / Model'}
                                    </span>
                                    <span class="text-xs text-slate-400">
                                        Type a new or existing LED Brand, Pitch (mm), Cabinet Size (mm), and Power Load (in Watts or Amps per tile). Saved permanently across Sheets, Pixel Designer &amp; Power Calc.
                                    </span>
                                </div>
                                <button type="button" id="sheets-close-add-brand-btn" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold">
                                    Close ×
                                </button>
                            </div>

                            <datalist id="sheets-existing-brands-datalist">
                                ${brands.map(b => `<option value="${escapeHtml(b)}"></option>`).join('')}
                            </datalist>

                            <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-2.5 items-end">
                                <div class="col-span-2 sm:col-span-1 lg:col-span-2">
                                    <label class="block text-[11px] font-semibold text-sky-300 mb-1">LED Brand Name *</label>
                                    <input type="text" id="new-led-brand" list="sheets-existing-brands-datalist" placeholder="e.g. ROE VISUAL, LEYARD, ABSEN..." value="${escapeHtml(draft.brand || '')}" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs text-white focus:border-emerald-500 focus:outline-none uppercase" />
                                </div>
                                <div class="col-span-2 sm:col-span-1 lg:col-span-2">
                                    <label class="block text-[11px] font-semibold text-emerald-300 mb-1">Model Name *</label>
                                    <input type="text" id="new-led-model" placeholder="e.g. BP2V2 2.8, UGM 2.6..." value="${escapeHtml(draft.model || '')}" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs text-white focus:border-emerald-500 focus:outline-none" />
                                </div>
                                <div>
                                    <label class="block text-[11px] font-semibold text-cyan-300 mb-1">Pixel Pitch (mm) *</label>
                                    <input type="number" step="0.01" min="0.5" id="new-led-pitch" value="${draft.pitchMm}" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs text-cyan-200 font-mono focus:border-emerald-500 focus:outline-none" />
                                </div>
                                <div>
                                    <label class="block text-[11px] font-semibold text-teal-300 mb-1">Cabinet W × H (mm)</label>
                                    <div class="flex items-center gap-1">
                                        <input type="number" step="1" min="50" id="new-led-cab-w" value="${draft.panelWidthMm}" title="Cabinet Width (mm)" class="w-1/2 bg-slate-950 border border-slate-700 rounded-lg px-2 py-1.5 text-xs text-teal-200 font-mono focus:border-emerald-500 focus:outline-none" />
                                        <span class="text-slate-500 text-xs">×</span>
                                        <input type="number" step="1" min="50" id="new-led-cab-h" value="${draft.panelHeightMm}" title="Cabinet Height (mm)" class="w-1/2 bg-slate-950 border border-slate-700 rounded-lg px-2 py-1.5 text-xs text-teal-200 font-mono focus:border-emerald-500 focus:outline-none" />
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-[11px] font-semibold text-violet-300 mb-1">Cabinet Res W × H (px)</label>
                                    <div class="flex items-center gap-1">
                                        <input type="number" step="1" min="8" id="new-led-res-w" value="${draft.panelResWidth}" title="Cabinet Pixels Wide (auto-calculated from Pitch)" class="w-1/2 bg-slate-950 border border-slate-700 rounded-lg px-2 py-1.5 text-xs text-violet-200 font-mono focus:border-emerald-500 focus:outline-none" />
                                        <span class="text-slate-500 text-xs">×</span>
                                        <input type="number" step="1" min="8" id="new-led-res-h" value="${draft.panelResHeight}" title="Cabinet Pixels High (auto-calculated from Pitch)" class="w-1/2 bg-slate-950 border border-slate-700 rounded-lg px-2 py-1.5 text-xs text-violet-200 font-mono focus:border-emerald-500 focus:outline-none" />
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-[11px] font-semibold text-slate-400 mb-1">Quick Size Preset</label>
                                    <div class="flex items-center gap-1">
                                        <button type="button" class="px-2 py-1.5 rounded bg-slate-800 hover:bg-slate-700 text-[11px] text-slate-200 flex-1" data-cab-preset="500x500">500×500</button>
                                        <button type="button" class="px-2 py-1.5 rounded bg-slate-800 hover:bg-slate-700 text-[11px] text-slate-200 flex-1" data-cab-preset="500x1000">500×1000</button>
                                    </div>
                                </div>
                            </div>

                            <!-- Power Load Row (Watts OR Amps per Tile) -->
                            <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-9 gap-2.5 items-end pt-2 border-t border-slate-800">
                                <div>
                                    <label class="block text-[11px] font-semibold text-amber-300 mb-1" title="Enter Max Watts per tile to auto-fill Amps, or enter Amps directly">Max Power / Tile (W)</label>
                                    <input type="number" step="1" min="1" id="new-led-max-watts" value="${draft.maxWatts}" placeholder="e.g. 170" class="w-full bg-slate-950 border border-amber-500/40 rounded-lg px-2 py-1.5 text-xs text-amber-200 font-mono focus:border-amber-400 focus:outline-none" />
                                </div>
                                <div>
                                    <label class="block text-[11px] font-semibold text-amber-200/80 mb-1" title="50% / Average Watts per tile">50% Power / Tile (W)</label>
                                    <input type="number" step="1" min="1" id="new-led-half-watts" value="${draft.halfWatts}" placeholder="e.g. 95" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-2 py-1.5 text-xs text-amber-100 font-mono focus:border-amber-400 focus:outline-none" />
                                </div>
                                <div>
                                    <label class="block text-[11px] font-semibold text-rose-300 mb-1">100% White (A/tile)</label>
                                    <input type="number" step="0.01" min="0.01" id="new-led-full-w" value="${draft.fullW}" class="w-full bg-slate-950 border border-rose-500/40 rounded-lg px-2 py-1.5 text-xs text-rose-200 font-mono focus:border-rose-400 focus:outline-none" />
                                </div>
                                <div>
                                    <label class="block text-[11px] font-semibold text-red-400 mb-1">100% Red (A)</label>
                                    <input type="number" step="0.01" min="0" id="new-led-full-r" value="${draft.fullR}" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-2 py-1.5 text-xs text-red-300 font-mono focus:outline-none" />
                                </div>
                                <div>
                                    <label class="block text-[11px] font-semibold text-green-400 mb-1">100% Green (A)</label>
                                    <input type="number" step="0.01" min="0" id="new-led-full-g" value="${draft.fullG}" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-2 py-1.5 text-xs text-green-300 font-mono focus:outline-none" />
                                </div>
                                <div>
                                    <label class="block text-[11px] font-semibold text-blue-400 mb-1">100% Blue (A)</label>
                                    <input type="number" step="0.01" min="0" id="new-led-full-b" value="${draft.fullB}" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-2 py-1.5 text-xs text-blue-300 font-mono focus:outline-none" />
                                </div>
                                <div>
                                    <label class="block text-[11px] font-semibold text-emerald-300 mb-1">50% White (A)</label>
                                    <input type="number" step="0.01" min="0" id="new-led-half-w" value="${draft.halfW}" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-2 py-1.5 text-xs text-emerald-200 font-mono focus:outline-none" />
                                </div>
                                <div>
                                    <label class="block text-[11px] font-semibold text-slate-400 mb-1">Standby (A)</label>
                                    <input type="number" step="0.01" min="0" id="new-led-full-s" value="${draft.fullS}" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-2 py-1.5 text-xs text-slate-300 font-mono focus:outline-none" />
                                </div>
                                <div class="col-span-2 sm:col-span-4 lg:col-span-1 flex flex-col gap-1">
                                    <button type="button" id="sheets-save-new-led-btn" class="w-full px-2.5 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold shadow">
                                        Save LED Model
                                    </button>
                                    <button type="button" id="sheets-save-apply-new-led-btn" class="w-full px-2.5 py-1 rounded-lg bg-sky-600 hover:bg-sky-500 text-white text-[11px] font-semibold" title="Save to Database and apply to Active Screen">
                                        Save &amp; Apply
                                    </button>
                                </div>
                            </div>
                        </div>`;
                    };

                    const renderMasterCalculationsTableHtml = () => {
                        return `
                        <div id="pl-sheets-master-container" class="p-4 space-y-4">
                            <!-- Master KPI Stat Cards Row -->
                            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
                                <div class="bg-slate-900/90 border border-sky-500/30 rounded-xl p-3 shadow flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-lg bg-sky-500/15 border border-sky-500/30 flex items-center justify-center text-sky-400 shrink-0 font-bold text-lg">
                                        🏷️
                                    </div>
                                    <div class="min-w-0">
                                        <div class="text-[11px] text-slate-400 uppercase font-semibold tracking-wider">LED Models Used</div>
                                        <div class="text-xl font-bold text-white font-mono leading-tight">${masterCalcGroups.length} <span class="text-xs text-sky-300 font-normal">Types</span></div>
