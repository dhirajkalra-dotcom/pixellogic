                notes: 'COEX series: capacity depends on network topology and receivers.'
            }
        };

        // Persisted user preference: allow running without any template artwork
        try {
            const savedTemplateOptOut = localStorage.getItem('pdfTemplateOptOut');
            if (savedTemplateOptOut !== null) {
                state.pdfExport.templateOptOut = savedTemplateOptOut === 'true';
            }
        } catch (e) {
            console.warn('Could not load PDF template opt-out flag', e);
        }

        // Persisted user preference: export without template background
        try {
            const savedExportNoTemplate = localStorage.getItem('pdfExportWithoutTemplate');
            if (savedExportNoTemplate !== null) {
                state.pdfExport.exportWithoutTemplate = savedExportNoTemplate === 'true';
            }
        } catch (e) {
            console.warn('Could not load PDF export-without-template flag', e);
        }

        try {
            state.pdfExport.useDefaultTemplate = localStorage.getItem('pdfUseDefaultTemplate') === 'true';
        } catch (e) {
            console.warn('Could not load PDF default-template preference', e);
        }

        // Persisted: built-in template gallery preferences
        try {
            const _m = localStorage.getItem('pdfTemplateMode');
            if (_m === 'gallery' || _m === 'custom') state.pdfExport.templateMode = _m;
            const _id = localStorage.getItem('pdfGalleryTemplateId');
            if (_id) state.pdfExport.galleryTemplateId = _id;
            const _ps = localStorage.getItem('pdfPageSize');
            if (_ps) state.pdfExport.pageSize = _ps;
            const _po = localStorage.getItem('pdfPageOrientation');
            if (_po === 'landscape' || _po === 'portrait') state.pdfExport.pageOrientation = _po;
            const _ac = localStorage.getItem('pdfAccentColor');
            if (_ac) state.pdfExport.accentColor = _ac;
            const _logo = localStorage.getItem('pdfLogoSrc');
            if (_logo) {
                state.pdfExport.logoSrc = _logo;
                const lim = new Image();
                lim.onload = () => { state.pdfExport.logoImage = lim; };
                lim.src = _logo;
            }
        } catch (e) {
            console.warn('Could not load PDF gallery preferences', e);
        }

        // Built-in default PDF template: embedded PNG from external-files/default-template.png
        const DEFAULT_TEMPLATE_DATA_URI = window.__EMBEDDED_DEFAULT_TEMPLATE__ || 'data:image/svg+xml;utf8,' + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="1240" height="1754"><rect width="1240" height="1754" fill="%23101216"/><text x="620" y="877" font-family="sans-serif" font-size="36" fill="%239CA3AF" text-anchor="middle">Default Template</text></svg>');
        const DEFAULT_TEMPLATE_PATH = 'external-files/default-template.png';

        const loadDefaultTemplateImage = (onload) => {
            const img = new Image();
            img.onload = () => onload(img, DEFAULT_TEMPLATE_PATH);
            img.onerror = () => {
                const fallback = new Image();
                fallback.onload = () => onload(fallback, DEFAULT_TEMPLATE_DATA_URI);
                fallback.src = DEFAULT_TEMPLATE_DATA_URI;
            };
            img.src = DEFAULT_TEMPLATE_PATH;
        };

        const useDefaultTemplateIfNone = () => {
            if (!state.pdfExport || state.pdfExport.templateOptOut || state.pdfExport.templateSrc) return;
            if (state.pdfExport && !state.pdfExport.templateSrc) {
                loadDefaultTemplateImage((img, src) => {
                    state.pdfExport.templateImage = img;
                    state.pdfExport.templateSrc = src;
                    state.pdfExport.templateIsCustom = false;
                    try { if (state.activeTab === 'pdf' && typeof renderPdfExport === 'function') renderPdfExport(); } catch(e) {}
                });
            }
        };

        const loadInstalledTemplateIfAvailable = async (force = false) => {
            try {
                if (!state.pdfExport || state.pdfExport.templateOptOut) return;
                if (!force && state.pdfExport.templateSrc) return;
                if (!window.installedTemplate || typeof window.installedTemplate.getDefault !== 'function') {
                    useDefaultTemplateIfNone();
                    return;
                }
                const dataUri = await window.installedTemplate.getDefault();
                if (dataUri) {
                    const img = new Image();
                    img.onload = () => {
                        state.pdfExport.templateImage = img;
                        state.pdfExport.templateSrc = dataUri;
                        state.pdfExport.templateIsCustom = false;
                        try { if (state.activeTab === 'pdf' && typeof renderPdfExport === 'function') renderPdfExport(); } catch(e) {}
                    };
                    img.src = dataUri;
                } else {
                    useDefaultTemplateIfNone();
                }
            } catch (e) {
                console.warn('Could not load installed template', e);
                useDefaultTemplateIfNone();
            }
        };

        const showDefaultPdfTemplate = (rerender = true) => {
            loadDefaultTemplateImage((img, src) => {
                    state.pdfExport.templateImage = img;
                    state.pdfExport.templateSrc = src;
                    state.pdfExport.templateIsCustom = false;
                    if (rerender) renderPdfExport();
            });
        };

        const showCustomPdfTemplate = (rerender = true) => {
            if (!state.pdfExport.customTemplateSrc) {
                loadInstalledTemplateIfAvailable();
                return;
            }
            const img = new Image();
            img.onload = () => {
                state.pdfExport.customTemplateImage = img;
                state.pdfExport.templateImage = img;
                state.pdfExport.templateSrc = state.pdfExport.customTemplateSrc;
                state.pdfExport.templateIsCustom = true;
                if (rerender) renderPdfExport();
            };
            img.src = state.pdfExport.customTemplateSrc;
        };

        // --- Load saved template from localStorage (persist default template across sessions)
        try {
            const savedCustomTemplate = localStorage.getItem('pdfCustomTemplateSrc');
            const savedTemplate = savedCustomTemplate
                || (localStorage.getItem('pdfTemplateIsCustom') === 'true' ? localStorage.getItem('pdfTemplateSrc') : null);
            if (savedTemplate) {
                const img = new Image();
                img.onload = () => {
                    state.pdfExport.templateImage = img;
                    state.pdfExport.templateSrc = savedTemplate;
                    const savedIsCustom = localStorage.getItem('pdfTemplateIsCustom');
                    state.pdfExport.templateIsCustom = !!savedCustomTemplate || savedIsCustom === 'true';
                    if (state.pdfExport.templateIsCustom) {
                        state.pdfExport.customTemplateSrc = savedTemplate;
                        state.pdfExport.customTemplateImage = img;
                    }
                    if (window.installedTemplate && typeof window.installedTemplate.getDefault === 'function') {
                        window.installedTemplate.getDefault().then((defaultUri) => {
                            if (defaultUri !== savedTemplate || savedCustomTemplate) return;
                            state.pdfExport.templateIsCustom = false;
                            state.pdfExport.customTemplateSrc = null;
                            state.pdfExport.customTemplateImage = null;
                            try { localStorage.setItem('pdfTemplateIsCustom', 'false'); } catch (_) {}
                            if (state.activeTab === 'pdf' && typeof renderPdfExport === 'function') renderPdfExport();
                        }).catch(() => {});
                    }
                    if (state.pdfExport.useDefaultTemplate) showDefaultPdfTemplate();
                    // If PDF tab is active, re-render so preview shows up
                    try { if (state.activeTab === 'pdf' && typeof renderPdfExport === 'function') renderPdfExport(); } catch(e) { /* ignore if render not yet defined */ }
                };
                img.src = savedTemplate;
            } else if (!state.pdfExport.templateOptOut) {
                // No user-saved template; attempt installed default, then fall back
                loadInstalledTemplateIfAvailable();
            }
        } catch (e) {
            console.warn('Could not load saved PDF template from localStorage', e);
            // On storage error, attempt installed default; fall back to built-in default
            loadInstalledTemplateIfAvailable();
        }
        // --- Load saved placement from localStorage
        try {
            const savedPlacement = localStorage.getItem('pdfPlacement');
            if (savedPlacement) {
                const p = JSON.parse(savedPlacement);
                if (p && typeof p === 'object') {
                    state.pdfExport.placement = Object.assign({}, state.pdfExport.placement, p);
                }
            }
        } catch (e) {
            console.warn('Could not load saved PDF placement', e);
        }
        // Load saved auto-fit preference
        try {
            const savedAutoFit = localStorage.getItem('pdfAutoFit');
            if (savedAutoFit !== null) {
                state.pdfExport.autoFitPlacement = JSON.parse(savedAutoFit);
            }
        } catch (e) {
            console.warn('Could not load saved pdfAutoFit', e);
        }

        // Load saved template areas (map/title/details)
        try {
            const tA = localStorage.getItem('pdfTemplateArea');
            if (tA) {
                const obj = JSON.parse(tA);
                if (obj && typeof obj === 'object') state.pdfExport.templateArea = Object.assign({}, state.pdfExport.templateArea, obj);
            }
        } catch (e) { console.warn('Could not load saved pdfTemplateArea', e); }
        try {
            const tiA = localStorage.getItem('pdfTitleArea');
            if (tiA) {
                const obj = JSON.parse(tiA);
                if (obj && typeof obj === 'object') state.pdfExport.titleArea = Object.assign({}, state.pdfExport.titleArea, obj);
            }
        } catch (e) { console.warn('Could not load saved pdfTitleArea', e); }
        try {
            const dA = localStorage.getItem('pdfDetailsArea');
            if (dA) {
                const obj = JSON.parse(dA);
                if (obj && typeof obj === 'object') state.pdfExport.detailsArea = Object.assign({}, state.pdfExport.detailsArea, obj);
            }
        } catch (e) { console.warn('Could not load saved pdfDetailsArea', e); }

        // Load showTitleBlock flag
        try {
            const st = localStorage.getItem('pdfShowTitleBlock');
            if (st !== null) state.pdfExport.showTitleBlock = JSON.parse(st);
        } catch (e) { console.warn('Could not load saved pdfShowTitleBlock', e); }

        // Load Title Block persisted values
        try {
            const tb = localStorage.getItem('pdfTitleBlock');
            if (tb) {
                const obj = JSON.parse(tb);
                if (obj && typeof obj === 'object') {
                    if (!state.pdfExport.titleBlock) state.pdfExport.titleBlock = {};
                    state.pdfExport.titleBlock = Object.assign({}, state.pdfExport.titleBlock, obj);
                }
            }
        } catch (e) { console.warn('Could not load saved pdfTitleBlock', e); }

        // Load persisted Title Block Area rect
        try {
            const tba = localStorage.getItem('pdfTitleBlockArea');
            if (tba) {
                const obj = JSON.parse(tba);
                if (obj && typeof obj === 'object') state.pdfExport.titleBlockArea = Object.assign({}, state.pdfExport.titleBlockArea, obj);
            }
        } catch (e) { console.warn('Could not load pdfTitleBlockArea', e); }

        // Load persisted Reference Image Area rect
        try {
            const ria = localStorage.getItem('pdfRefImageArea');
            if (ria) {
                const obj = JSON.parse(ria);
                if (obj && typeof obj === 'object') state.pdfExport.refImageArea = Object.assign({}, state.pdfExport.refImageArea, obj);
            }
        } catch (e) { console.warn('Could not load pdfRefImageArea', e); }

        // Load persisted output filename
        try {
            const ofn = localStorage.getItem('pdfOutputFileName');
            if (ofn) state.pdfExport.outputFileName = ofn;
        } catch (e) { console.warn('Could not load pdfOutputFileName', e); }

        // Load persisted global PDF Typography
        try {
            const ts = localStorage.getItem('pdfTextStyle');
            if (ts) {
                const obj = JSON.parse(ts);
                if (obj && typeof obj === 'object') {
                    state.pdfExport.textStyle = Object.assign({}, state.pdfExport.textStyle, obj);
                }
            }
        } catch (e) {
            console.warn('Could not load pdfTextStyle', e);
        }

        // Load persisted Title Block Style
        try {
            const tbs = localStorage.getItem('pdfTitleBlockStyle');
            if (tbs) {
                const obj = JSON.parse(tbs);
                if (obj && typeof obj === 'object') {
                    state.pdfExport.titleBlockStyle = Object.assign({}, state.pdfExport.titleBlockStyle, obj);
                }
            }
        } catch (e) { console.warn('Could not load pdfTitleBlockStyle', e); }
        try {
            const fs = localStorage.getItem('pdfFontScale');
            if (fs) { const n = parseFloat(fs); if (n > 0) state.pdfExport.fontScale = n; }
        } catch (e) { console.warn('Could not load pdfFontScale', e); }

    let inputModalCallback = null;
    let inputModalIsObject = false;

        const PROJECTS_STORAGE_KEY = 'pixi-logic-projects';
        const PROJECT_AUTOSAVE_ENABLED_STORAGE_KEY = 'pixi-logic-project-autosave-enabled';
        const PROJECT_AUTOSAVE_INTERVAL_MS = 3 * 60 * 1000;
        const DEV_ALWAYS_START_FRESH_PIXEL_MAPS = false;
        const resetGeneratedPixelMapsForDev = () => {
            if (!DEV_ALWAYS_START_FRESH_PIXEL_MAPS) return;
            const currentPath = String(window.location && window.location.pathname ? window.location.pathname : '');
            const isPackagedApp = /app\.asar/i.test(currentPath);
            if (isPackagedApp) return;
            try { localStorage.removeItem(PROJECTS_STORAGE_KEY); } catch (_) {}
        };

        // --- Persistence Helpers (Global Map Annotation Presets) ---
        const ANNOTATION_PRESETS_PRIMARY_KEY = 'pixellogic-effects-presets';
        const ANNOTATION_PRESETS_BACKUP_KEY = 'pixellogic-annotation-presets-global';
        const ANNOTATION_PRESETS_DELETED_KEY = 'pixellogic_deleted_annotation_preset_ids';

        const getDeletedAnnotationPresetIds = () => {
            try {
                const raw = localStorage.getItem(ANNOTATION_PRESETS_DELETED_KEY);
                const parsed = raw ? JSON.parse(raw) : [];
                return new Set(Array.isArray(parsed) ? parsed.map(String) : []);
            } catch (_) {
                return new Set();
            }
        };

        const recordDeletedAnnotationPresetId = (id) => {
            if (!id) return;
            try {
                const set = getDeletedAnnotationPresetIds();
                set.add(String(id));
                localStorage.setItem(ANNOTATION_PRESETS_DELETED_KEY, JSON.stringify(Array.from(set)));
            } catch (_) {}
        };

        const DEFAULT_ANNOTATION_PRESETS = [
            {
                id: 'default-stage-standard',
                name: 'Stage Standard',
                isDefault: true,
                data: {
                    details: {
                        coords: { enabled: true, fontSize: 100 },
                        cross: { enabled: true, style: 'solid' },
                        circle: { enabled: false, radius: 100, style: 'solid' },
                        cornerCircles: { enabled: false, radius: 8, style: 'solid' },
                        corners: { enabled: true },
                        dimensions: { enabled: true, showResolution: true, showPhysical: true },
                        info: { enabled: true, position: 'bottom-right', fontSize: 45, fontFamily: 'Arial', showScreenName: true, showResolution: true, showLedPitch: true, showAspectRatio: true, showBorder: true, bgTransparent: true },
                        shared: { color: '#ffffff', thickness: 4 }
                    }
                }
            },
            {
                id: 'default-clean-minimal',
                name: 'Clean Minimal',
                isDefault: true,
                data: {
                    details: {
                        coords: { enabled: false },
                        cross: { enabled: false },
                        circle: { enabled: false },
                        cornerCircles: { enabled: false },
                        corners: { enabled: false },
                        dimensions: { enabled: false },
                        info: { enabled: true, position: 'bottom-right', fontSize: 45, fontFamily: 'Arial', showScreenName: true, showResolution: true, showLedPitch: false, showAspectRatio: false, showBorder: false, bgTransparent: true },
                        shared: { color: '#ffffff', thickness: 3 }
                    }
                }
            },
            {
                id: 'default-full-diagnostic',
                name: 'Full Diagnostics',
                isDefault: true,
                data: {
                    details: {
                        coords: { enabled: true, fontSize: 100 },
                        cross: { enabled: true, style: 'solid' },
                        circle: { enabled: true, radius: 100, style: 'solid' },
                        cornerCircles: { enabled: true, radius: 8, style: 'solid' },
                        corners: { enabled: true },
                        grid: { enabled: true },
                        dimensions: { enabled: true, showResolution: true, showPhysical: true },
                        info: { enabled: true, position: 'bottom-right', fontSize: 48, fontFamily: 'Arial', showScreenName: true, showResolution: true, showLedPitch: true, showAspectRatio: true, showBorder: true, bgTransparent: false, backgroundColor: '#000000' },
                        shared: { color: '#ffffff', thickness: 5 }
                    }
                }
            }
        ];

        const sanitizePresetForStorage = (preset) => {
            if (!preset || typeof preset !== 'object') return null;
            try {
                const clone = JSON.parse(JSON.stringify(preset));
                if (clone.data && clone.data.details && clone.data.details.logo) {
                    delete clone.data.details.logo.imageObject;
                    if (typeof clone.data.details.logo.src === 'string' && clone.data.details.logo.src.length > 50000) {
                        clone.data.details.logo.src = '';
                    }
                }
                return clone;
            } catch (_) {
                return preset;
            }
        };

        const getGlobalAnnotationPresets = () => {
            const deletedIds = getDeletedAnnotationPresetIds();
            const presetsMap = new Map();
            DEFAULT_ANNOTATION_PRESETS.forEach(p => {
                if (p && p.id && !deletedIds.has(String(p.id))) {
                    presetsMap.set(String(p.id), p);
                }
            });

            const ingest = (arr) => {
                if (!Array.isArray(arr)) return;
                arr.forEach(p => {
                    if (p && p.id && p.name && !deletedIds.has(String(p.id))) {
                        presetsMap.set(String(p.id), p);
                    }
                });
            };

            try {
                const raw1 = localStorage.getItem(ANNOTATION_PRESETS_PRIMARY_KEY);
                if (raw1) ingest(JSON.parse(raw1));
            } catch (_) {}

            try {
                const raw2 = localStorage.getItem(ANNOTATION_PRESETS_BACKUP_KEY);
                if (raw2) ingest(JSON.parse(raw2));
            } catch (_) {}

            if (typeof state !== 'undefined' && Array.isArray(state?.effectsPresets)) {
                ingest(state.effectsPresets);
            }

            try {
                if (typeof state !== 'undefined' && Array.isArray(state?.projects)) {
                    state.projects.forEach(proj => {
                        if (Array.isArray(proj.effectsPresets)) ingest(proj.effectsPresets);
                    });
                }
            } catch (_) {}

            const result = Array.from(presetsMap.values()).filter(p => p && p.id && !deletedIds.has(String(p.id)));
            if (typeof state !== 'undefined' && state) {
                state.effectsPresets = result;
            }
            return result;
        };

        const saveGlobalAnnotationPresets = (presets) => {
            const deletedIds = getDeletedAnnotationPresetIds();
            const list = Array.isArray(presets) ? presets : [];
            const sanitized = list.map(sanitizePresetForStorage).filter(p => p && p.id && !deletedIds.has(String(p.id)));
            if (typeof state !== 'undefined' && state) {
                state.effectsPresets = sanitized;
            }
            const json = JSON.stringify(sanitized);
            try { localStorage.setItem(ANNOTATION_PRESETS_PRIMARY_KEY, json); } catch (_) {}
            try { localStorage.setItem(ANNOTATION_PRESETS_BACKUP_KEY, json); } catch (_) {}
            try {
                if (typeof state !== 'undefined' && Array.isArray(state?.projects)) {
                    state.projects.forEach(p => { p.effectsPresets = sanitized; });
                }
            } catch (_) {}
            return sanitized;
        };

        const mergeGlobalAnnotationPresets = (incomingPresets) => {
            if (!Array.isArray(incomingPresets) || incomingPresets.length === 0) return;
            const deletedIds = getDeletedAnnotationPresetIds();
            const current = getGlobalAnnotationPresets();
            const map = new Map(current.map(p => [String(p.id), p]));
            incomingPresets.forEach(p => {
                if (p && p.id && p.name && !deletedIds.has(String(p.id)) && !map.has(String(p.id))) {
                    map.set(String(p.id), p);
                }
            });
            saveGlobalAnnotationPresets(Array.from(map.values()));
        };

        // --- Persistence Helpers (Projects) ---
        let projectPersistTimer = null;
        const persistProjectsNow = () => {
            if (projectPersistTimer) {
                clearTimeout(projectPersistTimer);
                projectPersistTimer = null;
            }
            try {
                const payload = {
                    projects: state.projects,
                    activeProjectId: state.activeProjectId,
                    view3dState: state.view3dState || {},
                    effectsPresets: (typeof getGlobalAnnotationPresets === 'function' ? getGlobalAnnotationPresets() : (state.effectsPresets || [])),
                    designerPresets: state.designerPresets || []
                };
                localStorage.setItem(PROJECTS_STORAGE_KEY, JSON.stringify(payload));
            } catch (e) {
                console.warn('Failed to persist projects', e);
                showNotification('Could not save projects to local storage');
            }
        };

        const persistProjects = (immediate = false) => {
            if (immediate) {
                persistProjectsNow();
                return;
            }
            if (projectPersistTimer) clearTimeout(projectPersistTimer);
            projectPersistTimer = setTimeout(persistProjectsNow, 120);
        };

        // Legacy alias used in some handlers; forwards to persistProjects
        const saveState = () => {
            try { persistProjects(); } catch (e) { /* no-op */ }
        };

        const isProjectAutosaveEnabled = () => {
            try { return localStorage.getItem(PROJECT_AUTOSAVE_ENABLED_STORAGE_KEY) !== 'false'; } catch (_) { return true; }
        };

        const setProjectAutosaveEnabled = (enabled) => {
            try { localStorage.setItem(PROJECT_AUTOSAVE_ENABLED_STORAGE_KEY, String(!!enabled)); } catch (_) { /* best effort */ }
        };

        window.setInterval(() => {
            if (isProjectAutosaveEnabled()) persistProjects(true);
        }, PROJECT_AUTOSAVE_INTERVAL_MS);
        window.addEventListener('pagehide', persistProjectsNow);
        window.addEventListener('beforeunload', persistProjectsNow);

        const loadProjectsFromStorage = () => {
            try {
                const raw = localStorage.getItem(PROJECTS_STORAGE_KEY);
                if (!raw) return false;
                const data = JSON.parse(raw);
                if (!data || !Array.isArray(data.projects)) return false;
                state.projects = data.projects || [];
                if (data.view3dState && typeof data.view3dState === 'object') {
                    state.view3dState = data.view3dState;
                }
                if (Array.isArray(data.effectsPresets) && data.effectsPresets.length > 0) {
                    if (typeof mergeGlobalAnnotationPresets === 'function') {
                        mergeGlobalAnnotationPresets(data.effectsPresets);
                    }
                }
                // Normalize: default missing visualStyle to 'checker' but preserve user's saved choice
                try {
                    (state.projects || []).forEach(p => {
                        if (Array.isArray(p.pixelMaps)) {
                            p.pixelMaps.forEach(m => {
                                if (!m.visualStyle) m.visualStyle = 'checker';
                                // Ensure gradient object is fully valid
                                if (!m.gradient || typeof m.gradient !== 'object') {
                                    m.gradient = { type: 'linear', palette: 'Custom', angle: 90, colors: ['#6366f1', '#ec4899'] };
                                } else {
                                    if (!m.gradient.type) m.gradient.type = 'linear';
                                    if (!m.gradient.palette) m.gradient.palette = 'Custom';
                                    if (typeof m.gradient.angle === 'undefined') m.gradient.angle = 90;
                                    if (!Array.isArray(m.gradient.colors) || m.gradient.colors.length < 2) m.gradient.colors = ['#6366f1', '#ec4899'];
                                }
                                if (!m.checkerPalette) m.checkerPalette = 'Classic';
                                if (!Array.isArray(m.checkerColors) || m.checkerColors.length < 2) {
                                    m.checkerColors = ['#4b5563', '#1f2937'];
                                }
                                // Migration: remove any baked-in personal contact from info overlay
                                try {
                                    const info = m.details && m.details.info ? m.details.info : null;
                                    if (info) {
                                        if (typeof info.name === 'string' && /dhiraj\s+kalra/i.test(info.name)) {
                                            info.name = '';
                                        }
                                        try { delete info.name; delete info.autoName; } catch (_) { /* ignore */ }
                                    }
                                } catch (_) { /* ignore */ }
                            });
                        }
                    });
                    // Persist normalization so subsequent loads are consistent
                    persistProjects();
                } catch (_) { /* best effort */ }
                state.activeProjectId = data.activeProjectId || (state.projects[0]?.id ?? null);
                return state.projects.length > 0;
            } catch (e) {
                console.warn('Failed to load projects from storage', e);
                return false;
            }
        };

        // --- Persistence Helpers (Devices v2) ---
        const DEVICES_STORAGE_KEY = 'pixi-logic-devices-v2';
        const persistDevices = () => {
            try {
                localStorage.setItem(DEVICES_STORAGE_KEY, JSON.stringify(state.devicesV2 || { version: 2, ledWalls: [], projectors: [] }));
            } catch (e) {
                console.warn('Failed to persist devices', e);
                showNotification('Could not save devices to local storage');
            }
        };
        const loadDevicesFromStorage = () => {
            try {
                const raw = localStorage.getItem(DEVICES_STORAGE_KEY);
                if (!raw) return false;
                const data = JSON.parse(raw);
                if (!data || data.version !== 2) return false; // only load v2 to avoid cross-version impact
                state.devicesV2 = {
                    version: 2,
                    ledWalls: Array.isArray(data.ledWalls) ? data.ledWalls : [],
                    projectors: Array.isArray(data.projectors) ? data.projectors : []
                };
                return true;
            } catch (e) {
                console.warn('Failed to load devices from storage', e);
                return false;
            }
        };

        // --- Project Backup & Restore ---
        const downloadJson = (obj, filename) => {
            try {
                const blob = new Blob([JSON.stringify(obj, null, 2)], { type: 'application/json' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url; a.download = filename;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            } catch (e) {
                console.warn('Failed to download JSON', e);
                showNotification('Failed to export JSON');
            }
        };

        const timestamp = () => {
            const d = new Date();
            const pad = (n) => String(n).padStart(2, '0');
            return `${d.getFullYear()}${pad(d.getMonth()+1)}${pad(d.getDate())}-${pad(d.getHours())}${pad(d.getMinutes())}${pad(d.getSeconds())}`;
        };

        const exportProjects = (mode = 'all') => {
            const ts = timestamp();
            const annotationPresetsToExport = typeof getGlobalAnnotationPresets === 'function' ? getGlobalAnnotationPresets() : (state.effectsPresets || []);
            if (mode === 'all') {
                const payload = {
                    version: 1,
                    projects: state.projects || [],
                    activeProjectId: state.activeProjectId || null,
                    view3dState: state.view3dState || {},
                    effectsPresets: annotationPresetsToExport,
                    designerPresets: state.designerPresets || []
                };
                downloadJson(payload, `pixi-logic-projects-${ts}.json`);
            } else if (mode === 'current') {
                const current = state.projects.find(p => p.id === state.activeProjectId);
                if (!current) { showNotification('No active project to export'); return; }
                const payload = {
                    version: 1,
                    projects: [current],
                    activeProjectId: current.id,
                    view3dState: state.view3dState || {},
                    effectsPresets: annotationPresetsToExport,
                    designerPresets: state.designerPresets || []
                };
                const safeName = (current.name || 'project').replace(/[^a-z0-9_-]+/ig, '_');
                downloadJson(payload, `${safeName}-${ts}.json`);
            }
            showNotification('Export started');
        };

        const importProjectsFromObject = (data, mode = 'merge') => {
            try {
                let incoming = [];
                let incomingActiveId = null;
                let incomingView3dState = null;
                if (Array.isArray(data)) {
                    incoming = data;
                } else if (data && typeof data === 'object') {
                    if (Array.isArray(data.projects)) incoming = data.projects;
                    if (data.activeProjectId !== undefined) incomingActiveId = data.activeProjectId;
                    if (data.view3dState && typeof data.view3dState === 'object') incomingView3dState = data.view3dState;
                }
                if (data && typeof data === 'object' && Array.isArray(data.effectsPresets) && data.effectsPresets.length > 0) {
                    if (typeof mergeGlobalAnnotationPresets === 'function') {
                        mergeGlobalAnnotationPresets(data.effectsPresets);
                    }
                }
                if (!Array.isArray(incoming)) throw new Error('Invalid JSON format');

                // Basic validation
                incoming = incoming.filter(p => p && typeof p === 'object' && p.id != null && p.name);
                if (incoming.length === 0) { showNotification('No valid projects found in file'); return; }

                if (mode === 'replace') {
                    state.projects = incoming;
                    state.activeProjectId = incomingActiveId && incoming.some(p => p.id === incomingActiveId) ? incomingActiveId : (incoming[0]?.id ?? null);
                } else { // merge
                    const byId = new Map((state.projects || []).map(p => [p.id, p]));
                    incoming.forEach(p => { byId.set(p.id, p); });
                    state.projects = Array.from(byId.values());
                    if (incomingActiveId && state.projects.some(p => p.id === incomingActiveId)) {
                        state.activeProjectId = incomingActiveId;
                    } else if (!state.activeProjectId) {
                        state.activeProjectId = state.projects[0]?.id ?? null;
                    }
                }
                if (incomingView3dState) state.view3dState = incomingView3dState;
                // Normalize imported projects: default missing visualStyle to 'checker' but preserve user's saved choice
                try {
                    (state.projects || []).forEach(p => {
                        if (Array.isArray(p.pixelMaps)) {
                            p.pixelMaps.forEach(m => {
                                if (!m.visualStyle) m.visualStyle = 'checker';
                                if (!m.gradient || typeof m.gradient !== 'object') {
                                    m.gradient = { type: 'linear', palette: 'Custom', angle: 90, colors: ['#6366f1', '#ec4899'] };
                                } else {
                                    if (!m.gradient.type) m.gradient.type = 'linear';
                                    if (!m.gradient.palette) m.gradient.palette = 'Custom';
                                    if (typeof m.gradient.angle === 'undefined') m.gradient.angle = 90;
                                    if (!Array.isArray(m.gradient.colors) || m.gradient.colors.length < 2) m.gradient.colors = ['#6366f1', '#ec4899'];
                                }
                                if (!m.checkerPalette) m.checkerPalette = 'Classic';
                                if (!Array.isArray(m.checkerColors) || m.checkerColors.length < 2) {
                                    m.checkerColors = ['#4b5563', '#1f2937'];
                                }
                            });
                        }
                    });
                } catch (_) { /* best effort */ }
                state.pdfExport.selectedProjectId = state.activeProjectId || (state.projects[0]?.id ?? null);
                persistProjects();
                showNotification(`Imported ${incoming.length} project(s) (${mode})`);
                // Refresh current tab to reflect changes
                try { switchTab(state.activeTab); } catch (e) { /* best-effort */ }
            } catch (e) {
                console.warn('Import failed', e);
                showNotification('Failed to import projects');
            }
        };

        // --- DOM ELEMENTS ---
        const mainContent = {
            sheets: document.getElementById('sheets-content'),
            designer: document.getElementById('designer-content'),
            visualizer: document.getElementById('visualizer-content'),
            view3d: document.getElementById('view3d-content'),
            effects: document.getElementById('effects-content'),
            canvas: document.getElementById('canvas-content'),
            'led-patching': document.getElementById('led-patching-content'),
            pdf: document.getElementById('pdf-export-content'),
            shows: document.getElementById('shows-content'),
            'circular-led': document.getElementById('circular-led-content'),
            'projector-test-pattern': document.getElementById('projector-test-pattern-content'),
            devices: document.getElementById('devices-content'),
            help: document.getElementById('help-content'),
            'utility-tools': document.getElementById('utility-tools-content'),
            'power-calc': document.getElementById('power-calc-content'),
            'video-converter': document.getElementById('video-converter-content'),
        };
    const navTabs = document.querySelectorAll('.nav-tab[data-tab]');
    const modeToggle = document.getElementById('app-mode-toggle');
    const modeSwitch = document.getElementById('app-mode-switch');
    const modeLabelEl = document.getElementById('app-mode-label');
    const editionToggle = document.getElementById('app-edition-toggle');
    const editionSwitch = document.getElementById('app-edition-switch');
    const editionLabelEl = document.getElementById('app-edition-label');
    const appTitleEl = document.getElementById('app-title');
    const appSubtitleEl = document.getElementById('app-subtitle');

    const APP_MODES = {
        pixel: 'pixel',
        projection: 'projection'
    };
    const lockedProductMode = new URLSearchParams(window.location.search).get('product') || document.documentElement.dataset.product;
    const forcedAppMode = lockedProductMode === APP_MODES.projection ? APP_MODES.projection : APP_MODES.pixel;
    const APP_EDITIONS = { simple: 'simple', advanced: 'advanced' };
    const ADVANCED_TABS = new Set(['sheets', 'view3d', 'canvas', 'led-patching', 'power-calc']);
    const SIMPLE_ONLY_TABS = new Set(['visualizer']);
    let currentAppMode = forcedAppMode;
    let appEdition = APP_EDITIONS.simple;
    const MODE_LABELS = {
        pixel: { title: 'Pixelogic', subtitle: 'LED & Projector Patterns Generator' },
        projection: { title: 'Projection Logic', subtitle: 'Projector Tools & Alignment Patterns' }
    };
    const getAllowedTabsForMode = (mode) => {
        const tabs = mode === APP_MODES.projection
            ? ['projector-test-pattern', 'help']
            : ['sheets', 'designer', 'effects', 'visualizer', 'view3d', 'canvas', 'led-patching', 'pdf', 'shows', 'saved', 'circular-led', 'help', 'utility-tools', 'power-calc', 'video-converter'];
        return appEdition === APP_EDITIONS.simple ? tabs.filter(tab => !ADVANCED_TABS.has(tab)) : tabs.filter(tab => !SIMPLE_ONLY_TABS.has(tab));
    };

    const applyAppMode = (mode, { persist = true } = {}) => {
        const resolvedMode = forcedAppMode || ((mode === APP_MODES.projection) ? APP_MODES.projection : APP_MODES.pixel);
        currentAppMode = resolvedMode;
        if (persist) {
            try { localStorage.setItem('pixi-logic-app-mode', resolvedMode); } catch (_) {}
        }

        const labels = MODE_LABELS[resolvedMode] || MODE_LABELS.pixel;
        if (appTitleEl) appTitleEl.textContent = labels.title;
        if (appSubtitleEl) appSubtitleEl.textContent = labels.subtitle;

        const allowed = new Set(getAllowedTabsForMode(resolvedMode));
        navTabs.forEach(tab => {
            const modes = (tab.dataset.modes || 'pixel').split(/\s+/).filter(Boolean);
            const visible = modes.includes(resolvedMode) && allowed.has(tab.dataset.tab);
            tab.classList.toggle('hidden', !visible);
            tab.setAttribute('aria-hidden', visible ? 'false' : 'true');
            if (!visible) {
                tab.setAttribute('tabindex', '-1');
            } else {
                tab.removeAttribute('tabindex');
            }
        });

        if (modeSwitch) modeSwitch.checked = resolvedMode === APP_MODES.projection;
        if (modeLabelEl) modeLabelEl.textContent = resolvedMode === APP_MODES.projection ? 'Projection Logic' : 'Pixelogic';
        if (modeToggle) modeToggle.style.display = forcedAppMode ? 'none' : '';
        if (editionToggle) editionToggle.style.display = resolvedMode === APP_MODES.pixel ? '' : 'none';

        const current = state.activeTab;
        if (!allowed.has(current)) {
            const fallback = resolvedMode === APP_MODES.projection ? 'projector-test-pattern' : 'designer';
            switchTab(fallback);
        } else {
            switchTab(current);
        }
    };

    const initAppMode = () => {
        let saved = null;
        try { saved = localStorage.getItem('pixi-logic-app-mode'); } catch (_) {}
        applyAppMode(forcedAppMode || saved || APP_MODES.pixel, { persist: false });
    };
    const applyAppEdition = (edition, { persist = true, refresh = true } = {}) => {
        appEdition = edition === APP_EDITIONS.simple ? APP_EDITIONS.simple : APP_EDITIONS.advanced;
        if (persist) {
            try { localStorage.setItem('pixi-logic-app-edition', appEdition); } catch (_) {}
        }
        if (editionSwitch) editionSwitch.checked = appEdition === APP_EDITIONS.advanced;
        if (editionLabelEl) editionLabelEl.textContent = appEdition === APP_EDITIONS.advanced ? 'Advanced' : 'Simple';
        document.documentElement.dataset.edition = appEdition;
        if (refresh) applyAppMode(currentAppMode, { persist: false });
    };
    const initAppEdition = () => {
        applyAppEdition(APP_EDITIONS.simple, { persist: false, refresh: false });
    };
    // Global handler for Learn more links
    document.addEventListener('click', (e) => {
        const go = e.target.closest('[data-goto-tab]');
        if (!go) return;
        e.preventDefault();
        const tab = go.getAttribute('data-goto-tab');
        const key = go.getAttribute('data-highlight');
        if (tab) {
            if (key) pendingHighlight = { tab, key };
            switchTab(tab);
        }
    });
    // Global handler for Performance Mode (delegated)
    document.addEventListener('click', (e) => {
        const lite = e.target.closest('#help-performance-lite, #header-performance-lite');
        const full = e.target.closest('#help-performance-full, #header-performance-full');
        if (lite) {
            try { localStorage.setItem('pixi-logic-preview-cap-mp', '1'); localStorage.setItem('pixi-logic-performance-mode', 'lite'); }
            catch(error) { console.error('Could not save preview quality', error); showNotification('Could not save preview quality.'); return; }
            const badge = document.getElementById('header-performance-status');
            if (badge) { badge.textContent = 'Lite'; badge.classList.remove('hidden'); }
            if (typeof showNotification === 'function') showNotification('Performance: Lite mode enabled');
            if (typeof redrawAffectedVisuals === 'function') redrawAffectedVisuals(); else { try { renderVisualizer(); renderPixelMapDesigner(); renderEffectsDetails(); } catch(_) {} }
        } else if (full) {
            try { localStorage.setItem('pixi-logic-preview-cap-mp', String(PixelLogicRendering.FULL_PREVIEW_MP)); localStorage.setItem('pixi-logic-performance-mode', 'full'); }
            catch(error) { console.error('Could not save preview quality', error); showNotification('Could not save preview quality.'); return; }
            const badge = document.getElementById('header-performance-status');
            if (badge) { badge.classList.add('hidden'); }
            if (typeof showNotification === 'function') showNotification('Full mode: previews up to 8.3MP (4K). Exports remain full resolution.');
            if (typeof redrawAffectedVisuals === 'function') redrawAffectedVisuals(); else { try { renderVisualizer(); renderPixelMapDesigner(); renderEffectsDetails(); } catch(_) {} }
        }
    });

    document.addEventListener('click', async (e) => {
        const button = e.target.closest('#help-graphics-status');
        if (!button) return;
        const status = document.getElementById('help-graphics-details');
        if (!window.appInfo?.getGraphicsStatus) {
            status.textContent = 'Browser mode: GPU selection is managed by your browser. Open the installed desktop app to inspect Electron graphics acceleration.';
            return;
        }
        button.disabled = true;
        status.textContent = 'Checking graphics acceleration...';
        try {
            const graphics = await window.appInfo.getGraphicsStatus();
            const devices = graphics.devices.filter(device => device.active);
            const names = devices.map(device => device.deviceString || `Vendor ${device.vendorId}, device ${device.deviceId}`);
            const detected = graphics.devices.map(device => device.deviceString || `Vendor ${device.vendorId}, device ${device.deviceId}`);
            status.textContent = [
                graphics.disabledByEnvironment ? 'GPU disabled by PIXELLOGIC_DISABLE_GPU=1.' : 'GPU acceleration requested (driver compatibility rules apply).',
                `Active GPU: ${names.join(', ') || 'Not reported'}.`,
                `Renderer: ${graphics.renderer || 'Not reported'}.`,
                `Detected devices: ${detected.join(', ') || 'Not reported'}.`,
                `Canvas: ${graphics.features['2d_canvas'] || 'Not reported'}; compositing: ${graphics.features.gpu_compositing || 'Not reported'}; rasterization: ${graphics.features.rasterization || 'Not reported'}.`,
                'On Windows, choose High performance for this app in Settings > System > Display > Graphics, then restart it.'
            ].join('\n');
        } catch (error) {
            console.error('Could not inspect graphics acceleration', error);
            status.textContent = 'Could not inspect graphics acceleration. Restart the desktop app and try again.';
            showNotification('Could not inspect graphics acceleration.');
        } finally {
            button.disabled = false;
        }
    });

    // Global handler for Help: Video Tutorial (delegated)
    document.addEventListener('click', async (e) => {
        const btn = e.target.closest('#help-open-tutorial-video');
        if (!btn) return;
        e.preventDefault();
        try {
            if (!window.tutorialVideo || typeof window.tutorialVideo.open !== 'function') {
                if (typeof showNotification === 'function') showNotification('Tutorial video is only available in the installed app');
                return;
            }
            const res = await window.tutorialVideo.open();
            if (!res || res.ok !== true) {
                if (typeof showNotification === 'function') showNotification('Could not open tutorial video');
            }
        } catch (err) {
            console.warn('Tutorial video open failed', err);
            if (typeof showNotification === 'function') showNotification('Could not open tutorial video');
        }
    });
    // Global handler for Help: Tutorial PDF
    document.addEventListener('click', async (e) => {
        const btn = e.target.closest('#open-tutorial-pdf-btn');
        if (!btn) return;
        e.preventDefault();
        try {
            if (!window.tutorialPdf || typeof window.tutorialPdf.open !== 'function') {
                if (typeof showNotification === 'function') showNotification('Tutorial PDF is only available in the installed app');
                return;
            }
            const res = await window.tutorialPdf.open();
            if (!res || res.ok !== true) {
                if (typeof showNotification === 'function') showNotification('Could not open tutorial PDF');
            }
        } catch (err) {
            console.warn('Tutorial PDF open failed', err);
            if (typeof showNotification === 'function') showNotification('Could not open tutorial PDF');
        }
    });

    // Set app version badge (attempt to read from Electron app; fallback to inline constant)
    (async function(){
        const badge = document.getElementById('app-version-badge');
        try {
            if (window.appInfo && typeof window.appInfo.getVersion === 'function') {
                const v = await window.appInfo.getVersion();
                if (v) APP_VERSION = v;
            }
        } catch (e) { /* ignore */ }
        if (badge) {
            badge.textContent = `v${APP_VERSION}`;
            badge.title = `Build: ${APP_BUILD_DATE}`;
        }
    })();
        const notificationEl = document.getElementById('notification');

        // Simple confirm dialog (non-blocking) to avoid OS-level confirm focus issues
        const showConfirm = (message, confirmText = 'Confirm', cancelText = 'Cancel') => {
            return new Promise((resolve) => {
                try { if (window.__debugPush) window.__debugPush('showConfirm()'); } catch(_) {}
                const overlay = document.createElement('div');
                overlay.className = 'fixed inset-0 z-50 flex items-center justify-center';
                overlay.style.background = 'rgba(0,0,0,0.5)';
                overlay.style.backdropFilter = 'blur(1px)';
                const box = document.createElement('div');
                box.className = 'bg-gray-800 border border-gray-700 rounded-xl p-5 w-full max-w-sm shadow-2xl';
                box.innerHTML = `
                    <div class="text-gray-200 text-sm">${message}</div>
                    <div class="mt-4 flex justify-end gap-2">
                        <button id="cf-cancel" class="px-3 py-1 rounded bg-gray-700 text-sm">${cancelText}</button>
                        <button id="cf-ok" class="px-3 py-1 rounded bg-red-600 text-white text-sm">${confirmText}</button>
                    </div>
                `;
                overlay.appendChild(box);
                document.body.appendChild(overlay);

                const cleanup = (val) => {
                    try { document.body.removeChild(overlay); } catch(_) {}
                    try {
                        if (typeof unlockShowsUi === 'function') {
                            unlockShowsUi(); setTimeout(unlockShowsUi, 50);
                        }
                    } catch(_) {}
                    resolve(val);
                };

                overlay.addEventListener('click', (e) => {
                    const dialog = box;
                    if (dialog && !dialog.contains(e.target)) cleanup(false);
                });
                const ok = box.querySelector('#cf-ok');
                const cancel = box.querySelector('#cf-cancel');
                if (ok) ok.addEventListener('click', () => cleanup(true), { once: true });
                if (cancel) cancel.addEventListener('click', () => cleanup(false), { once: true });
            });
        };

        // --- RENDER FUNCTIONS ---

        const setupDesignerFloatingPreview = () => {
            state.ui = state.ui || {};
            try {
                if (typeof state.ui.designerFloatingCleanup === 'function') {
                    state.ui.designerFloatingCleanup();
                }
            } catch (_) {}

            const card = document.querySelector('#designer-content .pl-sticky-preview-designer');
            if (!card) return;
            card.classList.remove('pl-fixed-preview-designer');
            card.style.left = '';
            card.style.width = '';
            card.style.maxWidth = '';

            state.ui.designerFloatingCleanup = () => {
                try {
                    card.classList.remove('pl-fixed-preview-designer');
                    card.style.left = '';
                    card.style.width = '';
                    card.style.maxWidth = '';
                } catch (_) {}
            };
        };
        
        const renderPixelMapDesigner = () => {
            // Event delegation in the dashboard handles this now.
            // document.querySelectorAll('.rename-project-btn').forEach(btn => btn.addEventListener('click', (e) => {
            //     e.stopPropagation();
            //     const projectId = parseInt(e.currentTarget.dataset.id);
            //     const project = state.projects.find(p => p.id === projectId);
            //     if (project) {
            //         showInputModal('Rename Project', project.name, (newName) => {
            //             if (newName && newName.trim() !== '') {
            //                 project.name = newName.trim();
            //                 (dashboard removed)
            //             }
            //         });
            //     }
            // }));

            const project = state.projects.find(p => p.id === state.activeProjectId);
            if (!project) {
                return;
            }

            const activeMap = project.pixelMaps.find(m => m.id === project.activePixelMapId);
             if (!activeMap) {
                if (project.pixelMaps.length > 0) {
                    project.activePixelMapId = project.pixelMaps[0].id;
                    renderPixelMapDesigner();
                } else {
                    mainContent.designer.innerHTML = `<div class="text-center p-8 bg-gray-800 rounded-lg">
                        <h2 class="text-2xl font-bold text-gray-400">No Pixel Maps in this Project</h2>
                        <p class="text-gray-500 mt-2">Click "Add Map" to start designing.</p>
                         <button id="add-pixel-map-btn" class="mt-4 btn-glow flex items-center justify-center gap-2 px-4 py-2 font-semibold rounded-lg shadow-md bg-accent hover:bg-accent-dark mx-auto">Add Map</button>
                    </div>`;
                     document.getElementById('add-pixel-map-btn').addEventListener('click', addPixelMap);
                }
                return;
            }

            const calcs = calculateLayout(activeMap);

            const TAB_PALETTE = [
              { bg: '#1e3a6e', active: '#2563eb', text: '#93c5fd', activeText: '#fff' },
              { bg: '#3b1c7c', active: '#7c3aed', text: '#c4b5fd', activeText: '#fff' },
              { bg: '#0d4a44', active: '#0f766e', text: '#5eead4', activeText: '#fff' },
              { bg: '#5c2d06', active: '#b45309', text: '#fcd34d', activeText: '#fff' },
              { bg: '#4c0519', active: '#be123c', text: '#fda4af', activeText: '#fff' },
              { bg: '#022c22', active: '#065f46', text: '#6ee7b7', activeText: '#fff' },
              { bg: '#082f49', active: '#0369a1', text: '#7dd3fc', activeText: '#fff' },
              { bg: '#4a0550', active: '#86198f', text: '#f0abfc', activeText: '#fff' },
            ];
            const canDeleteMaps = project.pixelMaps.length > 1;
            const mapTabsHtml = project.pixelMaps.map((map, idx) => {
                const pal = TAB_PALETTE[idx % TAB_PALETTE.length];
                const isActive = map.id === project.activePixelMapId;
                const bgColor = isActive ? pal.active : pal.bg;
                const textColor = isActive ? pal.activeText : pal.text;
                const style = `background:${bgColor};color:${textColor};border:1px solid ${pal.active};${isActive ? 'box-shadow:0 0 10px ' + pal.active + '99;font-weight:700;' : 'opacity:0.8;'}`;
                const deleteBtnHtml = canDeleteMaps
                    ? `<span data-action="delete-tab-map" data-map-id="${map.id}" class="pixel-map-tab-close inline-flex items-center justify-center w-4 h-4 rounded-none text-xs leading-none opacity-60 hover:opacity-100 hover:bg-black/40 hover:text-red-300 transition-all cursor-pointer select-none ml-1" title="Delete ${escapeHtml(map.name)}">&times;</span>`
                    : '';
                return `<button data-map-id="${map.id}" ${isActive ? 'data-active="true"' : ''} title="Click to select ${escapeHtml(map.name)}" class="pixel-map-tab inline-flex items-center justify-center gap-2 px-3 text-xs font-semibold rounded-none transition-all flex-shrink-0 cursor-pointer h-[34px]" style="${style}"><span class="tab-label whitespace-nowrap leading-none">${escapeHtml(map.name)}</span>${deleteBtnHtml}</button>`;
            }).join('');

            if (!state.designerCompose) state.designerCompose = { mapIds: [], placement: 'right', gapPx: 0 };
            const designerComposeState = state.designerCompose;
            if (!Array.isArray(designerComposeState.mapIds)) designerComposeState.mapIds = [];
            try {
                designerComposeState.mapIds = designerComposeState.mapIds.filter(id => String(id) !== String(project.activePixelMapId));
            } catch (_) {}
            const designerOtherMaps = (project?.pixelMaps || [])
                .filter(pm => String(pm.id) !== String(project.activePixelMapId));
            const designerCombineStripHtml = buildCombineStrip({
                ctx: 'designer',
                primaryName: activeMap?.name || 'Active Map',
                otherMaps: designerOtherMaps,
                selectedIds: designerComposeState.mapIds,
                placement: designerComposeState.placement || 'right',
                makeBtnId: 'designer-compose-create-btn',
                hasExistingComposite: !!(activeMap && activeMap.composite && activeMap.composite.enabled)
            });

            const isCompositeMap = !!(activeMap && activeMap.composite && activeMap.composite.enabled);
            const compositeSourceIds = (activeMap && activeMap.composite && Array.isArray(activeMap.composite.sourceMapIds))
                ? activeMap.composite.sourceMapIds.map(String)
                : [];
            let compositeSourceMaps = [];
            if (isCompositeMap) {
                if (compositeSourceIds.length) {
                    compositeSourceMaps = (project.pixelMaps || []).filter(pm => compositeSourceIds.includes(String(pm.id)));
                } else if (Array.isArray(activeMap.composite.maps)) {
                    const nameList = activeMap.composite.maps.map(m => String(m?.name || '')).filter(Boolean);
                    compositeSourceMaps = (project.pixelMaps || []).filter(pm => nameList.includes(String(pm.name || '')));
                }
            }
            const compositeSourcesHtml = isCompositeMap ? `
                <div class="border border-amber-600/40 bg-amber-900/10 rounded-lg p-3">
                    <h3 class="text-sm font-semibold text-amber-300 mb-2">Composite Sources</h3>
                    <div id="composite-sources-list" class="space-y-2">
                        ${compositeSourceMaps.length ? compositeSourceMaps.map(src => `
                            <div class="flex items-center gap-2 bg-gray-900/60 border border-gray-700 rounded px-2 py-1.5">
                                <span class="text-xs text-gray-200 truncate" title="${escapeHtml(src.name || 'Map')}">${escapeHtml(src.name || 'Map')}</span>
                                <button data-open-composite-source="${src.id}" class="ml-auto px-2 py-0.5 rounded bg-sky-600 hover:bg-sky-700 text-xs">Edit</button>
                            </div>
                        `).join('') : '<div class="text-xs text-gray-500">Source maps not found. Try re-combining.</div>'}
                    </div>
                    <button id="composite-refresh-btn" class="mt-2 w-full px-3 py-1.5 rounded bg-emerald-700 hover:bg-emerald-600 text-xs">Update Composite from Sources</button>
                </div>
            ` : '';

            const getSavedGradientPalettes = () => { try { return JSON.parse(localStorage.getItem('pixi-logic-gradient-palettes')) || []; } catch(_) { return []; } };
            const getSavedCheckerPalettes  = () => { try { return JSON.parse(localStorage.getItem('pixi-logic-checker-palettes')) || []; } catch(_) { return []; } };
            const builtInGrad = [
                { name: 'Sunrise', colors: ['#ff9a9e', '#fad0c4'], type: 'linear', angle: 90 },
                { name: 'Ocean', colors: ['#a1c4fd', '#c2e9fb'], type: 'linear', angle: 90 },
                { name: 'Passion', colors: ['#fa709a', '#fee140'], type: 'linear', angle: 90 },
                { name: 'Forest', colors: ['#43e97b', '#38f9d7'], type: 'linear', angle: 90 },
                { name: 'Amethyst', colors: ['#9d50bb', '#6e48aa'], type: 'linear', angle: 90 },
            ];
            const gradientPalettes = [ { name: 'Custom', colors: activeMap.gradient.colors, type: activeMap.gradient.type, angle: activeMap.gradient.angle }, ...builtInGrad, ...getSavedGradientPalettes() ];
            const paletteOptions = gradientPalettes.map(p => `<option value="${p.name}" ${activeMap.gradient.palette === p.name ? 'selected' : ''}>${p.name}</option>`).join('');

            const builtInChecker = [
                { name: 'Classic', colors: ['#4b5563', '#1f2937'] },
                { name: 'Monochrome', colors: ['#ffffff', '#000000'] },
                { name: 'Earth', colors: ['#a16207', '#422006'] },
                { name: 'Oceanic', colors: ['#0c4a6e', '#082f49'] },
                { name: '100% Colour', colors: ['#ffffff', '#000000'] },
                { name: '50% Colour', colors: ['#bdbdbd', '#1f1f1f'] },
                { name: '25% Colour', colors: ['#8c8c8c', '#1a1a1a'] },
                { name: 'Full H Colour Sweep', colors: ['#ff4d4d', '#4d79ff'] },
                { name: 'Full V Colour Sweep', colors: ['#4dff88', '#4d79ff'] },
                { name: 'Full RGB', colors: ['#ff0000', '#00ff00'] },
                { name: '50% RGB', colors: ['#ff8080', '#80ff80'] },
                { name: '25% RGB', colors: ['#ffb3b3', '#b3ffb3'] },
                { name: 'Full CMY', colors: ['#00ffff', '#ff00ff'] },
                { name: '50% CMY', colors: ['#80ffff', '#ff80ff'] },
                { name: '25% CMY', colors: ['#b3ffff', '#ffb3ff'] },
                { name: 'Rainbow', colors: ['#ff0000', '#8a00ff'] },
                { name: 'Fruit', colors: ['#ff7a00', '#ff2d55'] },
                { name: 'Search', colors: ['#00b3ff', '#003b6f'] },
                { name: 'Glazed', colors: ['#ffe29a', '#ffa99f'] },
                { name: 'Union', colors: ['#1d4ed8', '#ef4444'] },
                { name: 'TCT', colors: ['#a855f7', '#22c55e'] },
                { name: 'Connected', colors: ['#00d4ff', '#005b9a'] },
                { name: 'Freedom', colors: ['#2563eb', '#f97316'] },
                { name: 'Freedom Flag', colors: ['#1d4ed8', '#ffffff'] },
                { name: 'White', colors: ['#ffffff', '#f2f2f2'] },
                { name: 'Gray', colors: ['#9ca3af', '#4b5563'] },
                { name: 'Black', colors: ['#111827', '#000000'] },
                { name: 'Transparent', colors: ['#000000', '#000000'] },
                { name: 'Black/White', colors: ['#000000', '#ffffff'] },
                { name: 'Light Gray/Dark Gray', colors: ['#d1d5db', '#374151'] },
                { name: 'Grayscale V', colors: ['#111827', '#e5e7eb'] },
                { name: 'Grayscale H', colors: ['#e5e7eb', '#111827'] },
                { name: 'Reduced/Full Check', colors: ['#3b82f6', '#1e293b'] },
                { name: 'Full Red', colors: ['#ff0000', '#7f0000'] },
                { name: 'Red', colors: ['#ef4444', '#7f1d1d'] },
                { name: 'Red/Gray', colors: ['#ef4444', '#6b7280'] },
                { name: 'Alt Red', colors: ['#f97316', '#ef4444'] },
                { name: 'Full Green', colors: ['#00ff00', '#007f00'] },
                { name: 'Green', colors: ['#22c55e', '#166534'] },
                { name: 'Green/Gray', colors: ['#22c55e', '#6b7280'] },
                { name: 'Alt Green', colors: ['#84cc16', '#22c55e'] },
                { name: 'Full Blue', colors: ['#0000ff', '#00007f'] },
                { name: 'Blue', colors: ['#3b82f6', '#1e3a8a'] },
                { name: 'Blue/Gray', colors: ['#3b82f6', '#6b7280'] },
                { name: 'Alt Blue', colors: ['#06b6d4', '#3b82f6'] },
                { name: 'Full Red/Green', colors: ['#ff0000', '#00ff00'] },
                { name: 'Full Green/Blue', colors: ['#00ff00', '#0000ff'] },
                { name: 'Full Blue/Red', colors: ['#0000ff', '#ff0000'] },
                { name: 'Red/Green', colors: ['#ef4444', '#22c55e'] },
                { name: 'Green/Blue', colors: ['#22c55e', '#3b82f6'] },
                { name: 'Blue/Red', colors: ['#3b82f6', '#ef4444'] },
                { name: 'Yellow', colors: ['#facc15', '#ca8a04'] },
                { name: 'Yellow/Gray', colors: ['#facc15', '#6b7280'] },
                { name: 'Cyan', colors: ['#22d3ee', '#0e7490'] },
                { name: 'Cyan/Gray', colors: ['#22d3ee', '#6b7280'] },
                { name: 'Magenta', colors: ['#d946ef', '#7e22ce'] },
                { name: 'Magenta/Gray', colors: ['#d946ef', '#6b7280'] },
                { name: 'Orange', colors: ['#f97316', '#9a3412'] },
                { name: 'Orange/Gray', colors: ['#f97316', '#6b7280'] },
                { name: 'Aqua', colors: ['#22d3ee', '#14b8a6'] },
                { name: 'Aqua/Gray', colors: ['#22d3ee', '#6b7280'] },
                { name: 'Purple', colors: ['#8b5cf6', '#4c1d95'] },
                { name: 'Purple/Gray', colors: ['#8b5cf6', '#6b7280'] },
            ];
            const checkerPalettes = [ { name: 'Custom', colors: activeMap.checkerColors }, ...builtInChecker, ...getSavedCheckerPalettes() ];
            const checkerPaletteOptions = checkerPalettes.map(p => `<option value="${p.name}" ${activeMap.checkerPalette === p.name ? 'selected' : ''}>${p.name}</option>`).join('');
            const panelUnit = activeMap.panelDimensionsUnit || 'mm';
            const panelWidthDisplayValue = (typeof activeMap.panelWidthMm === 'number' && !Number.isNaN(activeMap.panelWidthMm)) ? formatPanelUnitValueForInput(activeMap.panelWidthMm, panelUnit) : '';
            const panelHeightDisplayValue = (typeof activeMap.panelHeightMm === 'number' && !Number.isNaN(activeMap.panelHeightMm)) ? formatPanelUnitValueForInput(activeMap.panelHeightMm, panelUnit) : '';
            const panelUnitSelectOptions = PANEL_DIMENSION_UNITS.map(u => `<option value="${u}" ${panelUnit === u ? 'selected' : ''}>${u === 'm' ? 'm (meters)' : u === 'ft' ? 'ft (feet)' : u === 'in' ? 'in (inches)' : u === 'cm' ? 'cm (centimeters)' : 'mm (millimeters)'}</option>`).join('');

            // Wall shape state for the Shape selector UI
            if (!activeMap.shape || typeof activeMap.shape !== 'object') activeMap.shape = { type: 'rectangle', circleMode: 'diameter', circleValue: '' };
            const shapeType = activeMap.shape.type || 'rectangle';
            const circleMode = activeMap.shape.circleMode || 'diameter';
            const circleValue = (activeMap.shape.circleValue ?? '');
            const SHAPE_OPTION_LIST = [
                ['rectangle', 'Rectangle (full grid)'],
                ['circle', 'Circle'],
                ['ellipse', 'Ellipse / Oval'],
                ['triangle', 'Triangle'],
                ['diamond', 'Diamond'],
                ['hexagon', 'Hexagon'],
                ['cross', 'Cross / Plus'],
                ['custom', 'Custom (paint panels)']
            ];
            const shapeOptionsHtml = SHAPE_OPTION_LIST.map(([val, label]) => `<option value="${val}" ${shapeType === val ? 'selected' : ''}>${label}</option>`).join('');
            const shapeUnit = activeMap.screenDimensionsUnit || 'm';

            mainContent.designer.innerHTML = `
                 <div class="bg-gray-800 p-6 rounded-xl shadow-lg">
                    <!-- Sub Navigation for Maps -->
                    <div class="flex flex-wrap justify-between items-center mb-4 gap-4 border-b border-gray-700 pb-4">
                        <div class="flex items-center gap-2 min-w-0 flex-1" style="overflow:hidden;">
                            <div data-map-tab-scroller class="flex items-center gap-1.5 overflow-x-auto min-w-0 flex-1" style="scrollbar-width:thin;scrollbar-color:#374151 transparent;">
                                ${mapTabsHtml}
                            </div>
                            <button id="add-pixel-map-btn" class="btn-glow flex items-center justify-center h-[34px] px-3 rounded-none bg-gray-700 hover:bg-gray-600 text-base font-bold flex-shrink-0 border border-gray-600" title="Add new Pixel Map">+</button>
                        </div>
                        <div class="flex items-center gap-2">
                            <button id="duplicate-pixel-map-btn" class="btn-glow flex items-center justify-center h-[34px] px-3.5 text-xs font-semibold rounded-none bg-gray-700 hover:bg-gray-600 border border-gray-600">Duplicate Map</button>
                            <button id="delete-pixel-map-btn" class="btn-glow flex items-center justify-center h-[34px] px-3.5 text-xs font-semibold rounded-none bg-red-700 hover:bg-red-600 border border-red-500/50">Delete Map</button>
                        </div>
                    </div>

                    <!-- Main Designer Content -->
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                        <!-- Left Column: Controls -->
                        <div class="lg:col-span-1 bg-gray-900/50 p-6 rounded-xl shadow-lg space-y-6">
                                      <div>
                                          <h3 class="pixel-designer-section-heading pixel-designer-section-heading--name text-lg font-semibold border-b-2 border-accent-semi pb-2 mb-4" title="Name of this Pixel Map; shown in tabs and used in PDF/export">Pixel Map Name</h3>
                                          <input type="text" id="map-name-input" value="${escapeHtml(activeMap.name || '')}" placeholder="Enter pixel map name" class="w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent">
                                          <p class="text-xs text-gray-500 mt-1">Press Enter or click outside to save.</p>
                                      </div>
                                      ${compositeSourcesHtml}
                                      <div>
                                          <h3 class="pixel-designer-section-heading pixel-designer-section-heading--dimensions text-lg font-semibold border-b-2 border-accent-semi pb-2 mb-4" title="Physical LED screen width/height and units; drives scaling and overall map size">LED Screen Dimensions</h3>
                                <div class="space-y-4">
                                    <div class="grid grid-cols-3 gap-2 items-end">
                                       <div class="col-span-2">
                                            <label class="text-sm font-medium text-gray-300">Width</label>
                                            <input type="text" data-field="screenWidthValue" value="${activeMap.screenWidthValue || ''}" placeholder="e.g., 8 or 4*2" class="design-input w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent">
                                       </div>
                                       <div>
                                           <label class="text-sm font-medium text-gray-300">Unit</label>
                                            <select data-field="screenDimensionsUnit" class="unit-select w-full bg-gray-900 border border-gray-600 rounded-lg px-2 py-2 focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent">
                                                <option value="m" ${activeMap.screenDimensionsUnit === 'm' ? 'selected' : ''}>meters</option>
                                                <option value="cm" ${activeMap.screenDimensionsUnit === 'cm' ? 'selected' : ''}>cm</option>
                                                <option value="mm" ${activeMap.screenDimensionsUnit === 'mm' ? 'selected' : ''}>mm</option>
                                                <option value="ft" ${activeMap.screenDimensionsUnit === 'ft' ? 'selected' : ''}>feet</option>
                                                <option value="in" ${activeMap.screenDimensionsUnit === 'in' ? 'selected' : ''}>inches</option>
                                            </select>
                                       </div>
                                    </div>
                                    <div class="grid grid-cols-3 gap-2 items-end">
                                       <div class="col-span-2">
                                            <label class="text-sm font-medium text-gray-300">Height</label>
                                            <input type="text" data-field="screenHeightValue" value="${activeMap.screenHeightValue || ''}" placeholder="e.g., 4.5 or 9/2" class="design-input w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent">
                                       </div>
                                        <div class="opacity-0">
                                           <label>Unit</label>
                                           <select class="w-full"></select>
                                       </div>
                                    </div>
                                    <div class="grid grid-cols-2 gap-2 items-end pt-1">
                                        <div>
                                            <label class="text-sm font-medium text-gray-300">Tiles Across</label>
                                            <input type="number" min="1" step="1" data-field="tilesWide" value="${activeMap.tilesWide || Math.max(1, Math.round((Number(activeMap.screenWidthValue) * ({m:1000,cm:10,mm:1,ft:304.8,in:25.4}[activeMap.screenDimensionsUnit || 'm'] || 1000)) / (Number(activeMap.panelWidthMm) || 500)))}" placeholder="e.g., 20" class="design-input w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent">
                                        </div>
                                        <div>
                                            <label class="text-sm font-medium text-gray-300">Tiles High</label>
                                            <input type="number" min="1" step="1" data-field="tilesHigh" value="${activeMap.tilesHigh || Math.max(1, Math.round((Number(activeMap.screenHeightValue) * ({m:1000,cm:10,mm:1,ft:304.8,in:25.4}[activeMap.screenDimensionsUnit || 'm'] || 1000)) / (Number(activeMap.panelHeightMm) || 500)))}" placeholder="e.g., 10" class="design-input w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent">
                                        </div>
                                    </div>
                                    <p class="text-xs text-gray-500">Set tile counts to calculate the screen size from the panel dimensions below.</p>
                                </div>
                            </div>
                            <!-- LED Wall Shape Section -->
                            <div>
                                <h3 class="pixel-designer-section-heading pixel-designer-section-heading--shape text-lg font-semibold border-b-2 border-accent-semi pb-2 mb-4" title="Choose the physical shape of the LED wall. Panels outside the shape are turned off automatically.">LED Wall Shape</h3>
                                <div class="space-y-4">
                                    <div>
                                        <label class="text-sm font-medium text-gray-300">Shape</label>
                                        <select id="wall-shape-select" class="w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2 mt-1.5 focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent">
                                            ${shapeOptionsHtml}
                                        </select>
                                    </div>
                                    <div id="circle-sizing-controls" style="display:${shapeType === 'circle' ? 'block' : 'none'};" class="space-y-2 bg-gray-900/60 border border-gray-700 rounded-lg p-3">
                                        <label class="text-sm font-medium text-gray-300">Size the circle by</label>
                                        <p class="text-xs text-gray-500">Enter just one value — radius, diameter or circumference — and the wall size is calculated for you.</p>
                                        <div class="grid grid-cols-5 gap-2 items-end">
                                            <div class="col-span-2">
                                                <select id="circle-mode-select" class="w-full bg-gray-900 border border-gray-600 rounded-lg px-2 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-accent">
                                                    <option value="radius" ${circleMode === 'radius' ? 'selected' : ''}>Radius</option>
                                                    <option value="diameter" ${circleMode === 'diameter' ? 'selected' : ''}>Diameter</option>
                                                    <option value="circumference" ${circleMode === 'circumference' ? 'selected' : ''}>Circumference</option>
                                                </select>
                                            </div>
                                            <div class="col-span-3">
                                                <div class="relative">
                                                    <input type="text" id="circle-value-input" value="${circleValue}" placeholder="e.g., 5" class="w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2 text-sm placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-accent">
                                                    <span class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">${shapeUnit}</span>
                                                </div>
                                            </div>
                                        </div>
                                        <p id="circle-derived-note" class="text-xs text-emerald-400"></p>
                                    </div>
                                    <div id="shape-custom-note" style="display:${shapeType === 'custom' ? 'block' : 'none'};" class="text-xs text-gray-400 bg-gray-900/60 border border-gray-700 rounded-lg p-3">
                                        Custom mode: click panels in the Live Preview or Visualizer to toggle them on/off and draw any shape (logos, letters, arrows).
                                    </div>
                                    <p id="shape-info-note" class="text-xs text-gray-500" style="display:${(shapeType === 'rectangle' || shapeType === 'custom') ? 'none' : 'block'};">Panels outside the shape are disabled but the project still calculates as a rectangular grid, so export, 3D, patching and power all keep working.</p>
                                </div>
                            </div>
                            <div>
                                <h3 class="pixel-designer-section-heading pixel-designer-section-heading--specs text-lg font-semibold border-b-2 border-accent-semi pb-2 mb-4" title="LED panel size in mm and pixel resolution; affects grid and pixel density">LED Panel Specifications</h3>
                                <!-- Synced LED Brand & Model (with Pitch) from Sheets -->
                                <div class="rounded-lg border border-emerald-500/30 bg-emerald-950/20 p-3 mb-4 space-y-2.5">
                                    <div class="flex items-center justify-between gap-2">
                                        <span class="text-xs font-semibold uppercase tracking-wide text-emerald-300 flex items-center gap-1.5">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="3" x2="9" y2="21"/></svg>
                                            LED Brand &amp; Model (Synced with Sheets)
                                        </span>
                                        ${appEdition === 'advanced' ? `<button type="button" id="designer-open-sheets-btn" class="text-[11px] px-2 py-0.5 rounded bg-emerald-600/80 hover:bg-emerald-500 text-white font-semibold">Open in Sheets →</button>` : ''}
                                    </div>
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                                        <div>
                                            <label class="text-xs font-medium text-gray-300">LED Brand</label>
                                            <select id="designer-led-brand-select" class="w-full bg-gray-900 border border-gray-600 rounded-lg px-2.5 py-1.5 text-sm text-sky-300 mt-1 focus:outline-none focus:ring-2 focus:ring-emerald-500">
                                                <option value="">-- Custom / Select Brand --</option>
                                            </select>
                                        </div>
                                        <div>
                                            <label class="text-xs font-medium text-gray-300">Model &amp; Pixel Pitch</label>
                                            <select id="designer-led-model-select" class="w-full bg-gray-900 border border-gray-600 rounded-lg px-2.5 py-1.5 text-sm text-emerald-300 mt-1 focus:outline-none focus:ring-2 focus:ring-emerald-500">
                                                <option value="">-- Select Model (Pitch) --</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                 <div class="space-y-4">
                                    <div class="grid grid-cols-3 gap-4 items-end">
                                        <div class="col-span-1">
                                            <label class="text-sm font-medium text-gray-300">Panel Width</label>
                                            <div class="relative mt-1.5"><input type="text" data-field="panelWidthMm" value="${panelWidthDisplayValue}" placeholder="e.g., 500" class="design-input w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent"><span class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">${panelUnit}</span></div>
                                        </div>
                                        <div class="col-span-1">
                                            <label class="text-sm font-medium text-gray-300">Panel Height</label>
                                            <div class="relative mt-1.5"><input type="text" data-field="panelHeightMm" value="${panelHeightDisplayValue}" placeholder="e.g., 500" class="design-input w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent"><span class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">${panelUnit}</span></div>
                                        </div>
                                        <div>
                                            <label class="text-sm font-medium text-gray-300">Unit</label>
                                            <select data-field="panelDimensionsUnit" class="unit-select w-full bg-gray-900 border border-gray-600 rounded-lg px-2 py-2 focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent mt-1.5">
                                                ${panelUnitSelectOptions}
                                            </select>
                                        </div>
                                    </div>
                                    <div class="grid grid-cols-[1fr_auto] gap-2 items-end">
                                        <div>
                                            <label class="text-sm font-medium text-gray-300">Saved Panel Size</label>
                                            <select id="panel-size-preset" class="w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2 mt-1.5 focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent">
                                                <option value="">-- Select Saved Size --</option>
                                            </select>
                                        </div>
                                        <button id="save-panel-size-btn" type="button" class="px-3 py-2 rounded-md bg-gray-600 hover:bg-gray-700 text-sm whitespace-nowrap" title="Save the current panel width and height as a reusable preset">Save Current Size</button>
                                    </div>
                                    <div>
                                        <label class="text-sm font-medium text-gray-300">Panel Resolution (pixels per cabinet)</label>
                                        <select id="panel-res-preset" class="w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2 mt-1.5 focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent"></select>
                                    </div>
                                    <button id="save-custom-res-btn" class="hidden w-full mt-2 px-3 py-2 text-sm rounded-md bg-gray-600 hover:bg-gray-700">Save Custom Resolution</button>
                                    <div class="grid grid-cols-2 gap-4">
                                        <div>
                                            <label class="text-sm font-medium text-gray-300">Res Width</label>
                                            <div class="relative mt-1.5"><input type="text" data-field="panelResWidth" value="${activeMap.panelResWidth || ''}" placeholder="e.g., 128" class="design-input w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent"><span class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">px</span></div>
                                        </div>
                                        <div>
                                            <label class="text-sm font-medium text-gray-300">Res Height</label>
                                            <div class="relative mt-1.5"><input type="text" data-field="panelResHeight" value="${activeMap.panelResHeight || ''}" placeholder="e.g., 128" class="design-input w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent"><span class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">px</span></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            

                            <!-- LED Visual Style Section -->
                            <div class="space-y-4">
                                <h3 class="pixel-designer-section-heading pixel-designer-section-heading--style text-lg font-semibold border-b-2 border-accent-semi pb-2 mb-4" title="Choose LED visual style (gradient or checker); adjust palettes, colors, and angles">LED Visual Style</h3>
                                <div class="flex items-center gap-4">
                                    <label><input type="radio" name="visualStyle" value="gradient" class="visual-style-input" ${activeMap.visualStyle === 'gradient' ? 'checked' : ''}> Gradient</label>
                                    <label><input type="radio" name="visualStyle" value="checker" class="visual-style-input" ${activeMap.visualStyle === 'checker' ? 'checked' : ''}> Checker</label>
                                </div>
                                <div id="gradient-controls" style="display: ${activeMap.visualStyle === 'gradient' ? 'block' : 'none'};" class="space-y-4">
                                    <div class="grid grid-cols-2 gap-4">
                                        <div><label class="text-sm">Type</label><select data-gradient-field="type" class="style-input w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2 mt-1.5"><option value="linear" ${activeMap.gradient.type === 'linear' ? 'selected': ''}>Linear</option><option value="radial" ${activeMap.gradient.type === 'radial' ? 'selected': ''}>Radial</option></select></div>
                                        <div><label class="text-sm">Palette</label>
                                            <div class="flex gap-1 items-end mt-1.5">
                                                <select id="gradient-palette" class="style-input flex-1 bg-gray-900 border border-gray-600 rounded-lg px-3 py-2">${paletteOptions}</select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="grid grid-cols-2 gap-4"><div class="flex flex-col gap-1.5"><label class="text-sm">Start Color</label><input type="color" data-gradient-field="color1" value="${activeMap.gradient.colors[0]}" class="style-input w-full h-10 p-0 bg-gray-900 border-none rounded-lg cursor-pointer"></div><div class="flex flex-col gap-1.5"><label class="text-sm">End Color</label><input type="color" data-gradient-field="color2" value="${activeMap.gradient.colors[1]}" class="style-input w-full h-10 p-0 bg-gray-900 border-none rounded-lg cursor-pointer"></div></div>
                                    <div id="gradient-angle-control" style="display: ${activeMap.gradient.type === 'linear' ? 'block' : 'none'};"><label id="gradient-angle-label" class="text-sm">Angle (${activeMap.gradient.angle}°)</label><input type="range" data-gradient-field="angle" min="0" max="360" value="${activeMap.gradient.angle}" class="style-input w-full h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer"></div>
                                </div>
                                <div id="checker-controls" style="display: ${activeMap.visualStyle === 'checker' ? 'block' : 'none'};" class="space-y-4">
                                        <div class="flex flex-col gap-1.5">
                                            <label class="text-sm">Palette</label>
                                            <div class="flex gap-1 items-end mt-1.5">
                                                <select id="checker-palette" class="style-input flex-1 bg-gray-900 border border-gray-600 rounded-lg px-3 py-2">${checkerPaletteOptions}</select>
                                            </div>
                                        </div>
                                    <div class="grid grid-cols-2 gap-4"><div class="flex flex-col gap-1.5"><label class="text-sm">Color 1</label><input type="color" data-checker-field="color1" value="${activeMap.checkerColors[0]}" class="style-input w-full h-10 p-0 bg-gray-900 border-none rounded-lg cursor-pointer"></div><div class="flex flex-col gap-1.5"><label class="text-sm">Color 2</label><input type="color" data-checker-field="color2" value="${activeMap.checkerColors[1]}" class="style-input w-full h-10 p-0 bg-gray-900 border-none rounded-lg cursor-pointer"></div></div>
                                </div>
                            </div>
                                <!-- LED Panel Details Section -->
                <div class="space-y-4">
                            <h3 class="pixel-designer-section-heading pixel-designer-section-heading--details text-lg font-semibold border-b-2 border-accent-semi pb-2 mb-4" title="LED panel numbering style, color, and size; plus border styling below">LED Panel Details</h3>
                                    <div class="flex flex-col gap-1.5">
                                        <label class="text-sm">Numbering Style</label>
                                        <select data-numbering-field="style" class="style-input bg-gray-900 border border-gray-600 rounded-lg px-3 py-2">
                                            <option value="sequential" ${activeMap.numbering.style === 'sequential' ? 'selected' : ''}>Sequential</option>
                                            <option value="rowLetter" ${activeMap.numbering.style === 'rowLetter' ? 'selected' : ''}>Row Letters (A1, A2)</option>
                                            <option value="colLetter" ${activeMap.numbering.style === 'colLetter' ? 'selected' : ''}>Column Letters (A1, B1)</option>
                                            <option value="rowColNum" ${activeMap.numbering.style === 'rowColNum' ? 'selected' : ''}>Number (Row, Col)</option>
                                            <option value="colRowNum" ${activeMap.numbering.style === 'colRowNum' ? 'selected' : ''}>Number (Col, Row)</option>
                                        </select>
                                    </div>
                                    <div class="flex flex-col gap-1.5">
                                        <label class="text-sm">Number Color</label>
                                        <input type="color" data-numbering-field="color" value="${activeMap.numbering.color}" class="style-input w-full h-10 p-0 bg-gray-900 border-none rounded-lg cursor-pointer">
                                    </div>
                                    <div class="flex flex-col gap-1.5">
                                        <label id="font-size-label" class="text-sm">Font Size (${activeMap.numbering.fontSize}%)</label>
                                        <input type="range" data-numbering-field="fontSize" min="5" max="100" value="${activeMap.numbering.fontSize}" class="style-input w-full h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer">
                                    </div>
                                    <h3 class="pixel-designer-section-heading pixel-designer-section-heading--border text-lg font-semibold border-b-2 border-accent-semi pt-4 pb-2 mb-4" title="LED Pixel Map border outline style (solid, dashed, dotted)">LED Pixel Map Border Style</h3>
                                    <div class="flex flex-col gap-1.5">
                                        <label class="text-sm">LED Pixel Map Border Style</label>
                                        <select data-border-field="style" class="style-input bg-gray-900 border border-gray-600 rounded-lg px-3 py-2">
                                            <option value="solid" ${activeMap.border.style === 'solid' ? 'selected' : ''}>Solid</option>
                                            <option value="dashed" ${activeMap.border.style === 'dashed' ? 'selected' : ''}>Dashed</option>
                                            <option value="dotted" ${activeMap.border.style === 'dotted' ? 'selected' : ''}>Dotted</option>
                                        </select>
                                    </div>
                                    <div class="flex flex-col gap-1.5">
                                        <label class="text-sm">Border Color</label>
                                        <input type="color" data-border-field="color" value="${activeMap.border.color}" class="style-input w-full h-10 p-0 bg-gray-900 border-none rounded-lg cursor-pointer">
                                    </div>
                                    <div class="flex flex-col gap-1.5">
                                        <label id="border-thickness-label" class="text-sm">Thickness (${activeMap.border.thickness}px)</label>
                                        <input type="range" data-border-field="thickness" min="1" max="10" value="${activeMap.border.thickness}" class="style-input w-full h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer">
                                    </div>
                            </div>

                            <!-- Pixel Map Designer Presets (dropdown) -->
                            <div class="space-y-4 mt-4">
                                <h3 class="pixel-designer-section-heading pixel-designer-section-heading--presets text-lg font-semibold border-b-2 border-accent-semi pb-2 mb-4" title="Save and reuse styling (gradients, checker palettes, numbering, borders) without touching screen or panel specs.">Pixel Map Designer Presets</h3>
                                <div class="flex flex-col gap-2">
                                    <input id="designer-preset-name" type="text" placeholder="Preset name…" class="w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2 text-sm placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-accent" />
                                    <div class="flex gap-1 items-center">
                                        <select id="designer-preset-select" class="flex-1 bg-gray-900 border border-gray-600 rounded-lg px-3 py-2 text-sm">
                                            <option value="">-- Select Preset --</option>
                                            ${(state.designerPresets||[]).map(p => `<option value="${p.id}">${escapeHtml(p.name)}</option>`).join('')}
                                        </select>
                                        <button id="designer-preset-save" class="px-2 py-2 rounded bg-emerald-600 hover:bg-emerald-700 text-[10px] whitespace-nowrap" title="Save current settings as a new preset">Save</button>
                                        <button id="designer-preset-apply" class="px-2 py-2 rounded bg-sky-600 hover:bg-sky-700 text-[10px] whitespace-nowrap" title="Apply selected preset">Apply</button>
                                        <button id="designer-preset-delete" class="px-2 py-2 rounded bg-red-600 hover:bg-red-700 text-[10px] whitespace-nowrap" title="Delete selected preset">Del</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Right Column: Previews and Info -->
                        <div class="lg:col-span-2 space-y-6">
                             <div id="info-cards-container" class="grid grid-cols-2 md:grid-cols-3 gap-4">
                                <!-- Info cards will be populated by JS -->
                             </div>
                            <div class="bg-gray-900/50 p-4 rounded-xl shadow-lg pl-sticky-preview pl-sticky-preview-designer">
                                <div class="flex flex-wrap justify-between items-center mb-4 gap-2">
                                    <h3 class="pixel-designer-section-heading pixel-designer-section-heading--preview text-lg font-semibold">Live Preview: <span id="live-demo-map-name" class="text-white">${escapeHtml(activeMap.name)}</span></h3>
                                    <div class="flex items-center gap-2">
                                        <button id="designer-zoom-out-btn" class="btn-glow p-2 rounded-lg bg-gray-600 hover:bg-gray-700"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg></button>
                                        <button id="designer-zoom-in-btn" class="btn-glow p-2 rounded-lg bg-gray-600 hover:bg-gray-700"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg></button>
                                        <button id="designer-fit-btn" title="Fit to Screen" class="btn-glow p-2 rounded-lg bg-gray-600 hover:bg-gray-700"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8V4h4M20 8V4h-4M4 16v4h4M20 16v4h-4"></path></svg></button>
                                        <button id="designer-actual-btn" class="btn-glow px-3 py-2 text-xs font-semibold rounded-lg bg-gray-600 hover:bg-gray-700">Actual</button>
                                        <button id="designer-zoom-100-btn" class="btn-glow px-3 py-2 text-xs font-semibold rounded-lg bg-gray-600 hover:bg-gray-700">100%</button>
                                        <button id="send-to-canvas-btn" class="btn-glow flex items-center justify-center gap-2 px-3 py-2 text-sm font-semibold rounded-lg shadow-md bg-amber-600 hover:bg-amber-700">Send to Output</button>
                                        <button id="save-png-btn" class="btn-glow flex items-center justify-center gap-2 px-3 py-2 text-sm font-semibold rounded-lg shadow-md bg-emerald-600 hover:bg-emerald-700">Save PNG</button>
                                        <button id="save-all-pngs-btn" class="btn-glow flex items-center justify-center gap-2 px-3 py-2 text-sm font-semibold rounded-lg shadow-md bg-emerald-600 hover:bg-emerald-700">Save All PNGs</button>
                                        <label class="flex items-center gap-1 text-xs text-gray-300 cursor-pointer" title="Export PNG with transparent background"><input id="designer-transparent-png" type="checkbox" class="form-checkbox bg-gray-700"> Transparent</label>
                                    </div>
                                </div>
                                ${designerCombineStripHtml}
                                <div id="designer-preview-viewport" class="relative w-full h-[27rem] bg-gray-900 preview-grid rounded-lg p-4 overflow-auto">
                                    <div id="designer-preview-wrapper" style="transform-origin: top left;">
                                        <canvas id="designer-preview-canvas" class="block" style="image-rendering: pixelated;"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                 </div>
            `;
            
            // Bind critical controls first (so they work even if rendering below fails)
            document.querySelectorAll('.pixel-map-tab').forEach(tab => {
                tab.addEventListener('click', (e) => {
                    const closeBtn = e.target.closest('[data-action="delete-tab-map"]');
                    if (closeBtn) {
                        e.stopPropagation();
                        e.preventDefault();
                        const mapId = closeBtn.dataset.mapId;
                        if (typeof window.deletePixelMap === 'function') {
                            window.deletePixelMap(mapId);
                        } else if (typeof deletePixelMap === 'function') {
                            deletePixelMap(mapId);
                        }
                        return;
                    }
                    const mapTabScroller = e.currentTarget.closest('[data-map-tab-scroller]');
                    const mapTabScrollLeft = mapTabScroller ? mapTabScroller.scrollLeft : 0;
                    const dataId = e.currentTarget.dataset.mapId;
                    const match = project.pixelMaps.find(m => String(m.id) === String(dataId));
                    if (match) { project.activePixelMapId = match.id; }
                    renderPixelMapDesigner();
                    const nextMapTabScroller = document.querySelector('[data-map-tab-scroller]');
                    if (nextMapTabScroller) {
                        nextMapTabScroller.scrollLeft = mapTabScrollLeft;
                    }
                });
            });
            const addBtn = document.getElementById('add-pixel-map-btn'); if (addBtn) addBtn.addEventListener('click', addPixelMap);
            // Rename Map removed; inline Map Name field is used instead
            const delBtn = document.getElementById('delete-pixel-map-btn'); if (delBtn) delBtn.addEventListener('click', deletePixelMap);
            const dupBtn = document.getElementById('duplicate-pixel-map-btn'); if (dupBtn) dupBtn.addEventListener('click', duplicatePixelMap);

            const refreshDesignerPreview = () => {
                try { updateCalculationCards(calcs); } catch (e) { console.warn('updateCalculationCards failed', e); }
                const previewCanvas = document.getElementById('designer-preview-canvas');
                if (previewCanvas) {
                    try {
                        const composeStateLive = state.designerCompose || { mapIds: [], placement: 'right', gapPx: 0 };
                        const extraIds = Array.isArray(composeStateLive.mapIds) ? composeStateLive.mapIds : [];
                        const extraMaps = (project?.pixelMaps || []).filter(pm => extraIds.includes(String(pm.id)));
                        if (extraMaps.length) {
                            const maps = [activeMap, ...extraMaps].filter(Boolean).slice(0, 6);
                            composeVisualizerCanvasMulti(previewCanvas, maps, composeStateLive.placement || 'right', composeStateLive.gapPx || 0, { forceFullRes: false });
                        } else {
                            drawVisualizerCanvas(previewCanvas, activeMap);
                            // Enable click-to-paint panels in the Designer live preview (custom shapes / fine-tuning)
                            try {
                                const calcsLive = calculateLayout(activeMap) || {};
                                if (!calcsLive.isComposite) {
                                    if (previewCanvas._designerPaintHandler) {
                                        previewCanvas.removeEventListener('click', previewCanvas._designerPaintHandler);
                                    }
                                    const paintHandler = (ev) => {
                                        try { onVisualizerCanvasClick(ev); } catch(_) {}
                                        try { saveState(); } catch(_) {}
                                    };
                                    previewCanvas._designerPaintHandler = paintHandler;
                                    previewCanvas.addEventListener('click', paintHandler);
                                    previewCanvas.style.cursor = 'pointer';
                                    previewCanvas.title = 'Click a panel to toggle it on/off (custom shape)';
                                }
                            } catch(_) {}
                        }
                    } catch (e) { console.warn('drawVisualizerCanvas failed', e); }
                    // Ensure CSS size reflects current zoom; scrollbars handle navigation
                    if (previewCanvas.width && previewCanvas.height) {
                        const z = activeMap.zoom || 1;
                        previewCanvas.style.width = `${Math.round(previewCanvas.width * z)}px`;
                        previewCanvas.style.height = `${Math.round(previewCanvas.height * z)}px`;
                    }
                    if (state.visualizerState.autoFitPreview) try { fitDesignerPreviewToScreen(); } catch (e) { /* ignore */ }
                }
            };
            refreshDesignerPreview();
            try { setupDesignerFloatingPreview(); } catch (_) {}
            // Map name input handlers
            const mapNameInput = document.getElementById('map-name-input');
            if (mapNameInput) {
                const liveName = document.getElementById('live-demo-map-name');
                const activeTabBtn = document.querySelector('.pixel-map-tab[data-active="true"]');
                const primaryName = document.querySelector('#designer-combine-strip .combine-strip-primary b');
                const updateNameLabels = () => {
                    const name = mapNameInput.value || activeMap.name || '';
                    const tabLabel = activeTabBtn ? activeTabBtn.querySelector('.tab-label') : null;
                    for (const label of [liveName, tabLabel || activeTabBtn, primaryName]) {
                        if (label) label.textContent = name;
                    }
                };
                const commitName = () => {
                    const newName = (mapNameInput.value || '').trim();
                    if (!newName) {
                        showNotification('Map name cannot be empty.');
                        mapNameInput.value = activeMap.name || '';
                        updateNameLabels();
                        return;
                    }
                    mapNameInput.value = newName;
                    updateNameLabels();
                    if (newName !== activeMap.name) {
                        activeMap.name = newName;
                        persistProjects();
                        try {
                            const effectsContainer = document.getElementById('effects-content');
                            if (effectsContainer && effectsContainer.children.length) {
                                renderEffectsDetails();
                            }
                        } catch (error) { console.warn('Effects refresh after map rename failed', error); }
                        // Replacing the Designer during blur swallows the pending button/tab click.
                        if (mapNameInput.isConnected) refreshDesignerPreview();
                    }
                };
                mapNameInput.addEventListener('keydown', (e) => { if (e.key === 'Enter' && !e.isComposing) { e.preventDefault(); commitName(); } });
                mapNameInput.addEventListener('blur', commitName);
                mapNameInput.addEventListener('input', updateNameLabels);
            }

            document.querySelectorAll('.design-input, .unit-select').forEach(input => {
                input.addEventListener('input', handleInputChange);
                input.addEventListener('change', handleInputChange);
            });

            // ───── LED Wall Shape controls ─────
            const updateCircleDerivedNote = () => {
                const note = document.getElementById('circle-derived-note');
                if (!note) return;
                const sh = activeMap.shape || {};
                const val = parseFloat(sh.circleValue);
                if (!(val > 0)) { note.textContent = ''; return; }
                const mode = sh.circleMode || 'diameter';
                let diameter;
                if (mode === 'radius') diameter = val * 2;
                else if (mode === 'circumference') diameter = val / Math.PI;
                else diameter = val;
                diameter = Math.round(diameter * 1000) / 1000;
                const u = activeMap.screenDimensionsUnit || 'm';
                const radius = Math.round((diameter / 2) * 1000) / 1000;
                const circumference = Math.round(diameter * Math.PI * 1000) / 1000;
                note.textContent = `Wall size ${diameter}×${diameter} ${u}  ·  radius ${radius} ${u}  ·  circumference ${circumference} ${u}`;
            };
            const wallShapeSelect = document.getElementById('wall-shape-select');
            if (wallShapeSelect) {
                wallShapeSelect.addEventListener('change', (e) => {
                    if (!activeMap.shape || typeof activeMap.shape !== 'object') activeMap.shape = { type: 'rectangle', circleMode: 'diameter', circleValue: '' };
                    activeMap.shape.type = e.target.value;
                    if (activeMap.shape.type === 'circle') applyCircleSizing(activeMap);
                    applyShapeMask(activeMap);
                    saveState();
                    renderPixelMapDesigner();
                    try { redrawAffectedVisuals(); } catch (_) {}
                });
            }
            const circleModeSelect = document.getElementById('circle-mode-select');
            if (circleModeSelect) {
                circleModeSelect.addEventListener('change', (e) => {
                    if (!activeMap.shape) activeMap.shape = { type: 'circle' };
                    activeMap.shape.circleMode = e.target.value;
                    applyCircleSizing(activeMap);
                    applyShapeMask(activeMap);
                    saveState();
                    renderPixelMapDesigner();
                    try { redrawAffectedVisuals(); } catch (_) {}
                });
            }
            const circleValueInput = document.getElementById('circle-value-input');
            if (circleValueInput) {
                const applyCircleValue = (doFullRender) => {
                    if (!activeMap.shape) activeMap.shape = { type: 'circle' };
                    activeMap.shape.circleValue = circleValueInput.value;
                    applyCircleSizing(activeMap);
                    applyShapeMask(activeMap);
                    updateCircleDerivedNote();
                    // Keep the screen-size fields in sync without stealing focus
                    const wIn = document.querySelector('[data-field="screenWidthValue"]');
                    const hIn = document.querySelector('[data-field="screenHeightValue"]');
                    if (wIn) wIn.value = activeMap.screenWidthValue ?? '';
                    if (hIn) hIn.value = activeMap.screenHeightValue ?? '';
                    try { updateCalculationCards(calculateLayout(activeMap)); } catch (_) {}
                    state.visualizerState.autoFitPreview = true;
                    if (doFullRender) { saveState(); renderPixelMapDesigner(); }
                    try { redrawAffectedVisuals(); } catch (_) {}
                };
                circleValueInput.addEventListener('input', () => applyCircleValue(false));
                circleValueInput.addEventListener('change', () => applyCircleValue(true));
                updateCircleDerivedNote();
            }
            document.querySelectorAll('.visual-style-input').forEach(input => input.addEventListener('change', handleVisualStyleChange));
            document.querySelectorAll('.style-input').forEach(input => {
                input.addEventListener('input', handleStyleChange);
                input.addEventListener('change', handleStyleChange);
            });
            const gradPal = document.getElementById('gradient-palette'); if (gradPal) gradPal.addEventListener('change', handlePaletteChange);
            const panelPreset = document.getElementById('panel-res-preset'); if (panelPreset) panelPreset.addEventListener('change', handlePanelResPresetChange);
            const saveCustom = document.getElementById('save-custom-res-btn'); if (saveCustom) saveCustom.addEventListener('click', saveCustomPanelResolution);
            const panelSizePreset = document.getElementById('panel-size-preset'); if (panelSizePreset) panelSizePreset.addEventListener('change', handlePanelSizePresetChange);
            const savePanelSize = document.getElementById('save-panel-size-btn'); if (savePanelSize) savePanelSize.addEventListener('click', savePanelSizePreset);
            const checkerPal = document.getElementById('checker-palette'); if (checkerPal) checkerPal.addEventListener('change', handleCheckerPaletteChange);

            // Pixel Map Designer presets (dropdown) - save/apply/delete
            try {
                if (!Array.isArray(state.designerPresets)) {
                    try { state.designerPresets = JSON.parse(localStorage.getItem('pixellogic-designer-presets')||'[]') || []; } catch(_) { state.designerPresets = []; }
                }
                const designerSelect = document.getElementById('designer-preset-select');
                const designerApplyBtn = document.getElementById('designer-preset-apply');
                const designerSaveBtn = document.getElementById('designer-preset-save');
                const designerDeleteBtn = document.getElementById('designer-preset-delete');
                const persistDesigner = () => { try { localStorage.setItem('pixellogic-designer-presets', JSON.stringify(state.designerPresets)); } catch(_) {} };
                const DESIGNER_PRESET_FIELDS = Object.freeze([
                    'visualStyle',
                    'gradient',
                    'checkerColors',
                    'checkerPalette',
                    'numbering',
                    'border'
                ]);
                const snapshotDesigner = () => {
                    const sMap = JSON.parse(JSON.stringify(activeMap));
                    const payload = {};
                    DESIGNER_PRESET_FIELDS.forEach((field) => {
                        if (typeof sMap[field] !== 'undefined') {
                            payload[field] = sMap[field];
                        }
                    });
                    return payload;
                };
                if (designerSaveBtn) {
                    designerSaveBtn.addEventListener('click', () => {
                        const nameInput = document.getElementById('designer-preset-name');
                        const nm = (nameInput?.value || '').trim() || `Preset ${((state.designerPresets||[]).length + 1)}`;
                        const id = Date.now() + Math.random();
                        state.designerPresets.push({ id, name: nm, data: snapshotDesigner() });
                        persistDesigner();
                        if (nameInput) nameInput.value = '';
                        showNotification('Designer preset saved.');
                        renderPixelMapDesigner();
                    });
                }
                if (designerApplyBtn) {
                    designerApplyBtn.addEventListener('click', () => {
                        const selectedId = designerSelect?.value;
                        if (!selectedId) { showNotification('Select a preset first.'); return; }
                        const p = (state.designerPresets||[]).find(x => String(x.id) === String(selectedId));
                        if (p && p.data) {
                            const d = p.data;
                            DESIGNER_PRESET_FIELDS.forEach((field) => {
                                if (typeof d[field] !== 'undefined') {
                                    activeMap[field] = JSON.parse(JSON.stringify(d[field]));
                                }
                            });
                            saveState();
                            renderPixelMapDesigner();
                            try { redrawAffectedVisuals(); } catch(_) {}
                            showNotification(`Applied designer preset "${p.name}".`);
                        }
                    });
                }
                if (designerDeleteBtn) {
                    designerDeleteBtn.addEventListener('click', () => {
                        const selectedId = designerSelect?.value;
                        if (!selectedId) { showNotification('Select a preset first.'); return; }
                        const before = (state.designerPresets||[]).length;
                        state.designerPresets = (state.designerPresets||[]).filter(x => String(x.id) !== String(selectedId));
                        if ((state.designerPresets||[]).length !== before) {
                            persistDesigner();
                            showNotification('Designer preset deleted.');
                            renderPixelMapDesigner();
                        }
                    });
                }
            } catch(_) {}

            const sendToCanvasBtn = document.getElementById('send-to-canvas-btn'); if(sendToCanvasBtn) sendToCanvasBtn.addEventListener('click', sendVisualizerToCanvas);
                const savePngBtn = document.getElementById('save-png-btn'); if(savePngBtn) savePngBtn.addEventListener('click', () => exportVisualizer('png', 'designer-preview-canvas', activeMap.name, { transparent: !!document.getElementById('designer-transparent-png')?.checked }));
                const saveAllPngsBtn = document.getElementById('save-all-pngs-btn'); if (saveAllPngsBtn) saveAllPngsBtn.addEventListener('click', () => exportAllPixelMapsAsPNGs({ transparent: !!document.getElementById('designer-transparent-png')?.checked }));
            const compositeSourcesList = document.getElementById('composite-sources-list');
            if (compositeSourcesList) {
                compositeSourcesList.addEventListener('click', (e) => {
                    const id = e.target?.getAttribute && e.target.getAttribute('data-open-composite-source');
                    if (!id) return;
                    const src = project.pixelMaps.find(m => String(m.id) === String(id));
                    if (src) {
                        project.activePixelMapId = src.id;
                        renderPixelMapDesigner();
                    }
                });
            }
            const compositeRefreshBtn = document.getElementById('composite-refresh-btn');
            if (compositeRefreshBtn) {
                compositeRefreshBtn.addEventListener('click', () => {
                    if (!activeMap || !activeMap.composite || !activeMap.composite.enabled) return;
                    const comp = activeMap.composite;
                    const srcIds = Array.isArray(comp.sourceMapIds) ? comp.sourceMapIds.map(String) : [];
                    let srcMaps = [];
                    if (srcIds.length) {
                        srcMaps = (project.pixelMaps || []).filter(pm => srcIds.includes(String(pm.id)));
                    } else if (Array.isArray(comp.maps)) {
                        const nameList = comp.maps.map(m => String(m?.name || '')).filter(Boolean);
                        srcMaps = (project.pixelMaps || []).filter(pm => nameList.includes(String(pm.name || '')));
                    }
                    if (!srcMaps.length) {
                        showNotification('Source maps not found. Re-combine to rebuild sources.');
                        return;
                    }

                    const composedCanvas = document.createElement('canvas');
                    const maps = srcMaps.filter(Boolean).slice(0, 6);
                    const placement = comp.placement || 'right';
                    const gapPx = comp.gapPx || 0;
                    composeVisualizerCanvasMulti(composedCanvas, maps, placement, gapPx, { forceFullRes: true, ignorePhysicalScale: true });
                    const composedW = composedCanvas.width || 0;
                    const composedH = composedCanvas.height || 0;
                    if (!composedW || !composedH) {
                        showNotification('Failed to rebuild composite map.');
                        return;
                    }

                    const calcsList = maps.map(m => calculateLayout(m) || {});
                    const mapCalcs = maps.map((m, idx) => {
                        const c = calculateLayout(m) || {};
                        const totalPanels = (c.totalPanels > 0)
                            ? c.totalPanels
                            : (Array.isArray(m?.panels) ? m.panels.length : 0);
                        return {
                            id: m?.id,
                            name: m?.name || `Map ${idx + 1}`,
                            panelsHorizontally: Number.isFinite(c.panelsHorizontally) ? c.panelsHorizontally : null,
                            panelsVertically: Number.isFinite(c.panelsVertically) ? c.panelsVertically : null,
                            totalPanels,
                            totalResWidth: Number(c.totalResWidth) || 0,
                            totalResHeight: Number(c.totalResHeight) || 0,
                            screenWidthMm: Number(c.screenWidthMm) || 0,
                            screenHeightMm: Number(c.screenHeightMm) || 0,
                            panelWidthMm: Number(m?.panelWidthMm) || Number(c.panelWidthMm) || 0,
                            panelHeightMm: Number(m?.panelHeightMm) || Number(c.panelHeightMm) || 0,
                            panelResWidth: Number(m?.panelResWidth) || Number(c.panelResWidth) || 0,
                            panelResHeight: Number(m?.panelResHeight) || Number(c.panelResHeight) || 0
                        };
                    });
                    const widths = calcsList.map(c => c.screenWidthMm || 0).filter(v => v > 0);
                    const heights = calcsList.map(c => c.screenHeightMm || 0).filter(v => v > 0);
                    let screenWidthMm = widths[0] || 0;
                    let screenHeightMm = heights[0] || 0;
                    if (placement === 'left' || placement === 'right') {
                        screenWidthMm = widths.reduce((a,b)=>a+b,0);
                        screenHeightMm = heights.length ? Math.max(...heights) : 0;
                    } else {
                        screenWidthMm = widths.length ? Math.max(...widths) : 0;
                        screenHeightMm = heights.reduce((a,b)=>a+b,0);
                    }
                    const pitchMm = getCompositePitchMm({ composite: { enabled: true, maps } });
                    if (!(screenWidthMm > 0 && screenHeightMm > 0) && Number.isFinite(pitchMm) && pitchMm > 0) {
                        screenWidthMm = Math.round(pitchMm * composedW);
                        screenHeightMm = Math.round(pitchMm * composedH);
                    }
                    if (!(screenWidthMm > 0 && screenHeightMm > 0)) {
                        screenWidthMm = composedW;
                        screenHeightMm = composedH;
                    }

                    activeMap.screenDimensionsUnit = 'm';
                    activeMap.screenWidthValue = Math.round((screenWidthMm / 1000) * 1000) / 1000;
                    activeMap.screenHeightValue = Math.round((screenHeightMm / 1000) * 1000) / 1000;
                    activeMap.panelWidthMm = screenWidthMm;
                    activeMap.panelHeightMm = screenHeightMm;
                    activeMap.panelResWidth = composedW;
                    activeMap.panelResHeight = composedH;
                    activeMap.panels = [true];
                    activeMap.composite = Object.assign({}, comp, {
                        placement,
                        gapPx,
                        useRawPixels: true,
                        sourceMapIds: maps.map(m => m.id),
                        maps: maps.map(m => JSON.parse(JSON.stringify(m))),
                        primary: JSON.parse(JSON.stringify(maps[0])),
                        secondary: maps[1] ? JSON.parse(JSON.stringify(maps[1])) : null,
                        tertiary: maps[2] ? JSON.parse(JSON.stringify(maps[2])) : null,
                        mapCalcs,
                        composedWidthPx: composedW,
                        composedHeightPx: composedH,
                        screenWidthMm,
                        screenHeightMm
                    });

                    saveState();
                    renderPixelMapDesigner();
                    try { redrawAffectedVisuals(); } catch (_) {}
                    showNotification('Composite updated from sources.');
                });
            }
            const designerCombineSelect = document.getElementById('designer-combine-maps');
            if (designerCombineSelect) {
                designerCombineSelect.addEventListener('change', () => {
                    const selected = Array.from(designerCombineSelect.selectedOptions || []).map(o => String(o.value));
                    const limited = selected.slice(0, 5);
                    if (selected.length > 5) showNotification('Limit is 5 additional maps (total 6).');
                    state.designerCompose.mapIds = limited;
                    renderPixelMapDesigner();
                });
            }
            const designerPlacementSelect = document.getElementById('designer-compose-placement');
            if (designerPlacementSelect) {
                designerPlacementSelect.addEventListener('change', (e) => {
                    state.designerCompose.placement = e.target.value || 'right';
                    renderPixelMapDesigner();
                });
            }
            const designerMakeMapBtn = document.getElementById('designer-compose-create-btn');
            if (designerMakeMapBtn) {
                designerMakeMapBtn.addEventListener('click', () => {
                    const proj = state.projects.find(p => p.id === state.activeProjectId);
                    const composeStateLive = state.designerCompose || {};
                    const extraIds = Array.isArray(composeStateLive.mapIds) ? composeStateLive.mapIds : [];
                    const extraMaps = (proj?.pixelMaps || []).filter(pm => extraIds.includes(String(pm.id)));
                    const primaryMap = getActivePixelMap();
                    if (!primaryMap) return;

                    const isOverwrite = !!(primaryMap.composite && primaryMap.composite.enabled);
                    let maps = [];
                    if (isOverwrite) {
                        if (extraMaps.length) {
                            maps = extraMaps.filter(Boolean).slice(0, 6);
                        } else if (Array.isArray(primaryMap.composite.sourceMapIds)) {
                            const ids = primaryMap.composite.sourceMapIds.map(String);
                            maps = (proj?.pixelMaps || []).filter(pm => ids.includes(String(pm.id))).slice(0, 6);
                        } else if (Array.isArray(primaryMap.composite.maps)) {
                            const names = primaryMap.composite.maps.map(m => String(m?.name || '')).filter(Boolean);
                            maps = (proj?.pixelMaps || []).filter(pm => names.includes(String(pm.name || ''))).slice(0, 6);
                        }
                    } else {
                        if (!extraMaps.length) {
                            showNotification('Select at least one additional pixel map to combine.');
                            return;
                        }
                        maps = [primaryMap, ...extraMaps].filter(Boolean).slice(0, 6);
                    }
                    if (!maps.length) {
                        showNotification('Select at least one additional pixel map to combine.');
                        return;
                    }

                    // Build full-res composed canvas to capture pixel dimensions
                    const composedCanvas = document.createElement('canvas');
                    composeVisualizerCanvasMulti(composedCanvas, maps, composeStateLive.placement || 'right', composeStateLive.gapPx || 0, { forceFullRes: true, ignorePhysicalScale: true });
                    const composedW = composedCanvas.width || 0;
                    const composedH = composedCanvas.height || 0;
                    if (!composedW || !composedH) {
                        showNotification('Failed to build combined pixel map.');
                        return;
                    }

                    // Estimate physical size by combining screen sizes in mm
                    const calcsList = maps.map(m => calculateLayout(m) || {});
                    const widths = calcsList.map(c => c.screenWidthMm || 0).filter(v => v > 0);
                    const heights = calcsList.map(c => c.screenHeightMm || 0).filter(v => v > 0);
                    const placement = composeStateLive.placement || 'right';
                    let screenWidthMm = widths[0] || 0;
                    let screenHeightMm = heights[0] || 0;
                    if (placement === 'left' || placement === 'right') {
                        screenWidthMm = widths.reduce((a,b)=>a+b,0);
                        screenHeightMm = heights.length ? Math.max(...heights) : 0;
                    } else {
                        screenWidthMm = widths.length ? Math.max(...widths) : 0;
                        screenHeightMm = heights.reduce((a,b)=>a+b,0);
                    }
                    const pitchMm = getCompositePitchMm({ composite: { enabled: true, maps } });
                    if (!(screenWidthMm > 0 && screenHeightMm > 0) && Number.isFinite(pitchMm) && pitchMm > 0) {
                        screenWidthMm = Math.round(pitchMm * composedW);
                        screenHeightMm = Math.round(pitchMm * composedH);
                    }
                    if (!(screenWidthMm > 0 && screenHeightMm > 0)) {
                        // Fallback: infer mm from pixels (1px = 1mm) if sizes are unavailable
                        screenWidthMm = composedW;
                        screenHeightMm = composedH;
                    }

                    const shouldOverwrite = !!(primaryMap && primaryMap.composite && primaryMap.composite.enabled);
                    const targetMap = shouldOverwrite ? primaryMap : createNewPixelMapObject((proj.pixelMaps || []).length + 1);
                    const baseName = maps.map(m => (m && m.name) ? m.name : 'Map').join('_').replace(/\s+/g, '_');
                    if (!shouldOverwrite) targetMap.name = `Composite_${baseName}`;
                    targetMap.screenDimensionsUnit = 'm';
                    targetMap.screenWidthValue = Math.round((screenWidthMm / 1000) * 1000) / 1000;
                    targetMap.screenHeightValue = Math.round((screenHeightMm / 1000) * 1000) / 1000;
                    targetMap.panelWidthMm = screenWidthMm;
                    targetMap.panelHeightMm = screenHeightMm;
                    targetMap.panelResWidth = composedW;
                    targetMap.panelResHeight = composedH;
                    targetMap.panels = [true];
                    const mapCalcs = maps.map((m, idx) => {
                        const c = calculateLayout(m) || {};
                        const totalPanels = (c.totalPanels > 0)
                            ? c.totalPanels
                            : (Array.isArray(m?.panels) ? m.panels.length : 0);
                        return {
                            id: m?.id,
                            name: m?.name || `Map ${idx + 1}`,
                            panelsHorizontally: Number.isFinite(c.panelsHorizontally) ? c.panelsHorizontally : null,
                            panelsVertically: Number.isFinite(c.panelsVertically) ? c.panelsVertically : null,
                            totalPanels,
                            totalResWidth: Number(c.totalResWidth) || 0,
                            totalResHeight: Number(c.totalResHeight) || 0,
                            screenWidthMm: Number(c.screenWidthMm) || 0,
                            screenHeightMm: Number(c.screenHeightMm) || 0,
                            panelWidthMm: Number(m?.panelWidthMm) || Number(c.panelWidthMm) || 0,
                            panelHeightMm: Number(m?.panelHeightMm) || Number(c.panelHeightMm) || 0,
                            panelResWidth: Number(m?.panelResWidth) || Number(c.panelResWidth) || 0,
                            panelResHeight: Number(m?.panelResHeight) || Number(c.panelResHeight) || 0
                        };
                    });

                    targetMap.composite = {
                        enabled: true,
                        placement,
                        gapPx: composeStateLive.gapPx || 0,
                        useRawPixels: true,
                        sourceMapIds: maps.map(m => m.id),
                        maps: maps.map(m => JSON.parse(JSON.stringify(m))),
                        primary: JSON.parse(JSON.stringify(primaryMap)),
                        secondary: extraMaps[0] ? JSON.parse(JSON.stringify(extraMaps[0])) : null,
                        tertiary: extraMaps[1] ? JSON.parse(JSON.stringify(extraMaps[1])) : null,
                        mapCalcs,
                        composedWidthPx: composedW,
                        composedHeightPx: composedH,
                        screenWidthMm,
                        screenHeightMm
                    };

                    if (!shouldOverwrite) {
                        proj.pixelMaps.push(targetMap);
                        proj.activePixelMapId = targetMap.id;
                    }
                    saveState();
                    renderPixelMapDesigner();
                    showNotification(shouldOverwrite ? 'Composite pixel map updated.' : 'Composite pixel map created.');
                });
            }

            // New chip-based combine strip (replaces legacy multi-select + quick-combine row)
            bindCombineStrip({
                ctx: 'designer',
                composeState: state.designerCompose,
                onChange: () => renderPixelMapDesigner()
            });

            const designerQuickSecondary = document.getElementById('designer-quick-secondary');
            const designerQuickPlacement = document.getElementById('designer-quick-placement');
            const designerQuickBtn = document.getElementById('designer-quick-compose-btn');
            const syncDesignerQuickState = () => {
                const selectedId = designerQuickSecondary ? String(designerQuickSecondary.value || '') : '';
                state.designerCompose.mapIds = selectedId ? [selectedId] : [];
                state.designerCompose.placement = (designerQuickPlacement && designerQuickPlacement.value) ? designerQuickPlacement.value : (state.designerCompose.placement || 'right');
            };
            if (designerQuickSecondary) designerQuickSecondary.addEventListener('change', () => { syncDesignerQuickState(); renderPixelMapDesigner(); });
            if (designerQuickPlacement) designerQuickPlacement.addEventListener('change', () => { syncDesignerQuickState(); renderPixelMapDesigner(); });
            if (designerQuickBtn) {
                designerQuickBtn.addEventListener('click', () => {
                    syncDesignerQuickState();
                    if (!designerQuickSecondary || !designerQuickSecondary.value) {
                        showNotification('Select a secondary pixel map to combine.');
                        return;
                    }
                    if (designerMakeMapBtn) designerMakeMapBtn.click();
                });
            }

            const zoomIn = document.getElementById('designer-zoom-in-btn'); if (zoomIn) zoomIn.addEventListener('click', () => handleDesignerZoom(1.25));
            const zoomOut = document.getElementById('designer-zoom-out-btn'); if (zoomOut) zoomOut.addEventListener('click', () => handleDesignerZoom(0.8));
            const fitBtn = document.getElementById('designer-fit-btn'); if (fitBtn) fitBtn.addEventListener('click', () => fitDesignerPreviewToScreen(false, true)); // Keep forceRecalc=true for fit button
            const zoom100 = document.getElementById('designer-zoom-100-btn'); if (zoom100) zoom100.addEventListener('click', () => handleDesignerZoom(null, 1.0));
            const actualBtn = document.getElementById('designer-actual-btn'); if (actualBtn) actualBtn.addEventListener('click', () => fitDesignerPreviewToScreen(true, true));

            // Populate and set the panel resolution preset dropdown
            try { populatePanelResPresets(); } catch (e) { console.warn('populatePanelResPresets failed', e); }
            try { populatePanelSizePresets(); } catch (e) { console.warn('populatePanelSizePresets failed', e); }

            // Mixed Panel Grid removed
            // Populate synced LED Brand & Model selector in Pixel Designer
            try {
                const brandSelectEl = document.getElementById('designer-led-brand-select');
                const modelSelectEl = document.getElementById('designer-led-model-select');
                const openSheetsBtn = document.getElementById('designer-open-sheets-btn');
                if (openSheetsBtn) {
                    openSheetsBtn.addEventListener('click', () => switchTab('sheets'));
                }
                if (brandSelectEl && modelSelectEl && typeof getLedSheetsCatalog === 'function') {
                    const catalog = getLedSheetsCatalog();
                    const brands = [...new Set(catalog.map(d => d.brand))].sort();
                    const curBrand = activeMap.ledBrand || '';
                    brandSelectEl.innerHTML = `<option value="">-- Custom / Select Brand --</option>` +
                        brands.map(b => {
                            const pitches = [...new Set(catalog.filter(x => x.brand === b).map(x => x.pitchMm))].sort((a, z) => a - z);
                            const pText = pitches.length === 1 ? `P${pitches[0]}mm` : `P${pitches[0]}–P${pitches[pitches.length - 1]}mm`;
                            return `<option value="${escapeHtml(b)}" ${curBrand === b ? 'selected' : ''}>${escapeHtml(b)} (${pText})</option>`;
                        }).join('');

                    const populateDesignerModels = (selectedBrand) => {
                        const list = selectedBrand ? catalog.filter(c => c.brand === selectedBrand) : catalog;
                        modelSelectEl.innerHTML = `<option value="">-- Select Model (Pitch) --</option>` +
                            list.map(m => {
                                const val = `${m.brand}|||${m.model}`;
                                const isSel = (activeMap.ledBrand === m.brand && activeMap.ledModel === m.model);
                                const prefix = selectedBrand ? '' : `${m.brand} · `;
                                return `<option value="${escapeHtml(val)}" ${isSel ? 'selected' : ''}>${escapeHtml(prefix + m.model)} — P${m.pitchMm}mm (${m.panelWidthMm}×${m.panelHeightMm}mm)</option>`;
                            }).join('');
                    };
                    populateDesignerModels(curBrand);

                    brandSelectEl.addEventListener('change', (e) => {
                        const nextB = e.target.value || '';
                        activeMap.ledBrand = nextB;
                        const firstM = catalog.find(x => x.brand === nextB);
                        if (firstM) {
                            applyLedModelToMap(activeMap, firstM.brand, firstM.model);
                        } else {
                            activeMap.ledModel = '';
                        }
                        saveState();
                        renderPixelMapDesigner();
                        redrawAffectedVisuals();
                    });

                    modelSelectEl.addEventListener('change', (e) => {
                        const raw = e.target.value || '';
                        if (raw.includes('|||')) {
                            const [bName, mName] = raw.split('|||');
                            applyLedModelToMap(activeMap, bName, mName);
                            saveState();
                            renderPixelMapDesigner();
                            redrawAffectedVisuals();
                            showNotification(`Applied ${bName} ${mName} (P${activeMap.ledPitchMm}mm)`);
                        }
                    });
                }
            } catch (err) { console.warn('Designer LED catalog bind failed:', err); }
        };

        const composeVisualizerCanvas = (canvas, primaryMap, secondaryMap, placement, gapPx = 0, options = {}) => {
            if (!canvas || !primaryMap) return;
            const tempA = document.createElement('canvas');
            const tempB = document.createElement('canvas');
            const forceFullRes = !!(options && options.forceFullRes);
            let fixedScale = options && Number.isFinite(options.fixedScale) ? options.fixedScale : null;
            if (!forceFullRes && !Number.isFinite(fixedScale)) {
                try {
                    const cA = calculateLayout(primaryMap) || {};
                    const cB = secondaryMap ? (calculateLayout(secondaryMap) || {}) : {};
                    const fullPixelsMax = Math.max(1,
                        (cA.totalResWidth || 0) * (cA.totalResHeight || 0),
                        (cB.totalResWidth || 0) * (cB.totalResHeight || 0)
                    );
                    const userScale = Math.max(0.05, Math.min(1, (state.visualizerState?.previewScale ?? 1)));
                    const savedCapMp = (() => { try { return parseFloat(localStorage.getItem('pixi-logic-preview-cap-mp')); } catch(_) { return NaN; } })();
                    const capMp = Number.isFinite(savedCapMp) && savedCapMp > 0.25 ? savedCapMp : PixelLogicRendering.FULL_PREVIEW_MP;
                    fixedScale = PixelLogicRendering.previewScale(fullPixelsMax, 1, userScale, capMp);
                } catch (_) {
                    fixedScale = null;
                }
            }
            const renderOpts = Object.assign({}, options, Number.isFinite(fixedScale) ? { fixedScale } : {});
            drawVisualizerCanvas(tempA, primaryMap, renderOpts);
            if (secondaryMap) drawVisualizerCanvas(tempB, secondaryMap, renderOpts);
            const w1 = tempA.width || 0;
            const h1 = tempA.height || 0;
            const w2 = secondaryMap ? (tempB.width || 0) : 0;
            const h2 = secondaryMap ? (tempB.height || 0) : 0;
            const gap = Math.max(0, Number(gapPx) || 0);

            // Normalize composed sizes by physical screen dimensions so badges and visuals scale consistently
            let scaleA = 1;
            let scaleB = 1;
            if (secondaryMap) {
                try {
                    const cA = calculateLayout(primaryMap) || {};
                    const cB = calculateLayout(secondaryMap) || {};
                    const getPxPerMm = (c) => {
                        const vals = [];
                        if ((c.totalResWidth || 0) > 0 && (c.screenWidthMm || 0) > 0) vals.push(c.totalResWidth / c.screenWidthMm);
                        if ((c.totalResHeight || 0) > 0 && (c.screenHeightMm || 0) > 0) vals.push(c.totalResHeight / c.screenHeightMm);
                        if (!vals.length) return null;
                        return vals.reduce((a,b)=>a+b,0) / vals.length;
                    };
                    const pxPerMmA = getPxPerMm(cA);
                    const pxPerMmB = getPxPerMm(cB);
                    if (Number.isFinite(pxPerMmA) && pxPerMmA > 0 && Number.isFinite(pxPerMmB) && pxPerMmB > 0) {
                        scaleA = pxPerMmA > 0 ? (pxPerMmA / pxPerMmA) : 1;
                        scaleB = pxPerMmA / pxPerMmB;
                    }
                } catch (_) {}
            }

            const sW1 = Math.max(1, Math.round(w1 * scaleA));
            const sH1 = Math.max(1, Math.round(h1 * scaleA));
            const sW2 = secondaryMap ? Math.max(1, Math.round(w2 * scaleB)) : 0;
            const sH2 = secondaryMap ? Math.max(1, Math.round(h2 * scaleB)) : 0;

            let outW = sW1;
            let outH = sH1;
            let ax = 0, ay = 0, bx = 0, by = 0;
            if (secondaryMap) {
                if (placement === 'left' || placement === 'right') {
                    outW = sW1 + sW2 + gap;
                    outH = Math.max(sH1, sH2);
                    ay = Math.round((outH - sH1) / 2);
                    by = Math.round((outH - sH2) / 2);
                    if (placement === 'left') {
                        ax = sW2 + gap;
                        bx = 0;
                    } else {
                        ax = 0;
                        bx = sW1 + gap;
                    }
                } else {
                    outW = Math.max(sW1, sW2);
                    outH = sH1 + sH2 + gap;
                    // Align left edges so columns line up
                    ax = 0;
                    bx = 0;
                    if (placement === 'top') {
                        ay = sH2 + gap;
                        by = 0;
                    } else {
                        ay = 0;
                        by = sH1 + gap;
                    }
                }
            }

            canvas.width = Math.max(1, outW);
            canvas.height = Math.max(1, outH);
            const ctx = canvas.getContext('2d');
            if (!ctx) return;
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            // Paint a distinct canvas background so the defined size is visible (skip for transparent)
            const composeTransparent = !!(options && options.transparent);
            if (!composeTransparent) {
                ctx.save(); ctx.fillStyle = '#0f172a'; ctx.fillRect(0, 0, canvas.width, canvas.height);
            // Canvas boundary outline
            ctx.strokeStyle = 'rgba(57, 255, 20, 0.9)';
            ctx.lineWidth = Math.max(1, 2 / (zoom || 1));
            ctx.setLineDash([8 / (zoom || 1), 6 / (zoom || 1)]);
            ctx.strokeRect(0.5, 0.5, Math.max(0, canvas.width - 1), Math.max(0, canvas.height - 1));
            ctx.setLineDash([]);
            // Corner ticks for visibility at any zoom
            const tick = Math.max(12, Math.round(24 / (zoom || 1)));
            ctx.lineWidth = Math.max(1, 3 / (zoom || 1));
            ctx.strokeStyle = 'rgba(57, 255, 20, 1)';
            ctx.beginPath();
            // top-left
            ctx.moveTo(0.5, tick); ctx.lineTo(0.5, 0.5); ctx.lineTo(tick, 0.5);
            // top-right
            ctx.moveTo(canvas.width - tick - 0.5, 0.5); ctx.lineTo(canvas.width - 0.5, 0.5); ctx.lineTo(canvas.width - 0.5, tick);
            // bottom-left
            ctx.moveTo(0.5, canvas.height - tick - 0.5); ctx.lineTo(0.5, canvas.height - 0.5); ctx.lineTo(tick, canvas.height - 0.5);
            // bottom-right
            ctx.moveTo(canvas.width - tick - 0.5, canvas.height - 0.5); ctx.lineTo(canvas.width - 0.5, canvas.height - 0.5); ctx.lineTo(canvas.width - 0.5, canvas.height - tick - 0.5);
            ctx.stroke();
                ctx.restore(); }
            ctx.drawImage(tempA, ax, ay, sW1, sH1);
            if (secondaryMap) ctx.drawImage(tempB, bx, by, sW2, sH2);
        };

        // ── Combine Strip builder (shared by Designer + Visualizer) ──────
        const PLACEMENT_ICONS = {
            left:   '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>',
            right:  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>',
            top:    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg>',
            bottom: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg>'
        };
        const buildCombineStrip = ({ ctx, primaryName, otherMaps, selectedIds, placement, makeBtnId, hasExistingComposite }) => {
            const selected = (selectedIds || []).map(String);
            const limitReached = selected.length >= 5;
            const primaryLabel = primaryName ? escapeHtml(primaryName) : 'Active Map';
            const chipsHtml = (otherMaps || []).length
                ? (otherMaps || []).map(pm => {
                    const id = String(pm.id);
                    const isSel = selected.includes(id);
                    const disabled = !isSel && limitReached;
                    const safe = escapeHtml(pm.name || '');
                    return `<button type="button" class="combine-chip${isSel?' selected':''}${disabled?' disabled':''}" data-combine-ctx="${ctx}" data-map-id="${id}"${disabled?' aria-disabled="true"':''} title="${isSel?'Click to remove':disabled?'Limit: 5 additional maps':'Click to add to combine'}">${safe}</button>`;
                  }).join('')
                : '<span class="combine-empty">Create more pixel maps to combine them here.</span>';
            const placementBtns = ['left','right','top','bottom'].map(p => {
                const active = (placement || 'right') === p;
                return `<button type="button" class="placement-btn${active?' active':''}" data-combine-ctx="${ctx}" data-placement="${p}" title="Place secondary ${p} of primary" aria-label="Place ${p}" aria-pressed="${active?'true':'false'}">${PLACEMENT_ICONS[p]}</button>`;
            }).join('');
            const count = selected.length;
            const goLabel = hasExistingComposite
                ? (count ? `Update (${count + 1})` : 'Update Composite')
                : (count ? `Combine ${count + 1} maps` : 'Combine');
            const goDisabled = !hasExistingComposite && count === 0;
            const clearBtn = count > 0
                ? `<button type="button" class="combine-clear" data-combine-ctx="${ctx}" data-combine-clear="1" title="Clear selection">Clear</button>`
                : '';
            return `
                <div class="combine-strip" id="${ctx}-combine-strip">
                    <div class="combine-strip-header">
                        <span class="combine-strip-title">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                            Combine Maps
                        </span>
                        <span class="combine-strip-primary">Primary: <b>${primaryLabel}</b></span>
                        <span class="combine-strip-count${count?' has-selection':''}" id="${ctx}-combine-count">${count} additional selected${count?` · total ${count+1}`:''}</span>
                    </div>
                    <div class="combine-strip-body">
                        <div class="combine-chips" id="${ctx}-combine-chips">${chipsHtml}</div>
                        <div class="combine-placement" role="group" aria-label="Placement">${placementBtns}</div>
                        ${clearBtn}
                        <button id="${makeBtnId}" class="combine-go-btn" ${goDisabled?'disabled':''} title="Create a new composite pixel map from the selected maps">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                            ${goLabel}
                        </button>
                    </div>
                </div>
            `;
        };
        const bindCombineStrip = ({ ctx, composeState, onChange }) => {
            const root = document.getElementById(`${ctx}-combine-strip`);
            if (!root) return;
            root.addEventListener('click', (e) => {
                const chip = e.target.closest('.combine-chip');
                if (chip && chip.dataset.combineCtx === ctx) {
                    if (chip.classList.contains('disabled')) return;
                    const id = String(chip.dataset.mapId || '');
                    if (!id) return;
                    const ids = Array.isArray(composeState.mapIds) ? composeState.mapIds.map(String) : [];
                    const idx = ids.indexOf(id);
                    if (idx >= 0) { ids.splice(idx, 1); }
                    else {
                        if (ids.length >= 5) { showNotification('Limit is 5 additional maps (total 6).'); return; }
                        ids.push(id);
                    }
                    composeState.mapIds = ids;
                    if (typeof onChange === 'function') onChange();
                    return;
                }
                const pb = e.target.closest('.placement-btn');
                if (pb && pb.dataset.combineCtx === ctx) {
                    composeState.placement = pb.dataset.placement || 'right';
                    if (typeof onChange === 'function') onChange();
                    return;
                }
                const clear = e.target.closest('[data-combine-clear]');
                if (clear && clear.dataset.combineCtx === ctx) {
                    composeState.mapIds = [];
                    if (typeof onChange === 'function') onChange();
                    return;
                }
            });
        };

        const { calculateLayout, formatAspectRatio, getPanelPitchMm, getCompositePitchMm, composeVisualizerCanvasMulti, drawDetailsOverlays, drawVisualizerCanvas, drawLineWithArrows, drawPencilPolyline, drawCanvasDrawingsToContext, buildMaskPath, applyMaskClip } = PixelLogicMapRenderer.createRenderer({
            state,
            getActiveCanvas: () => getActiveCanvas(),
            get pixelLogicLogoImage() { return pixelLogicLogoImage; }
        });

        const renderVisualizer = () => {
            const activeMap = getActivePixelMap();
             if (!activeMap) {
                 mainContent.visualizer.innerHTML = `<div class="text-center p-8 bg-gray-800 rounded-lg"><p class="text-gray-500">Please select a Pixel Map in the Pixel Designer tab to view it here.</p></div>`;
                 return;
             }
             
             const calcs = calculateLayout(activeMap);
             let visualizerContent;
             if (calcs.totalResWidth > 0 && calcs.totalResHeight > 0) {
                 visualizerContent = `<canvas id="visualizer-canvas" class="block" style="image-rendering: pixelated;"></canvas>`;
             } else {
                 visualizerContent = `<p class="text-gray-500">The selected Pixel Map has no valid dimensions.</p>`;
             }

             const projectForViz = state.projects.find(p => p.id === state.activeProjectId);
             const thumbsHtml = (projectForViz?.pixelMaps || []).map(pm => `
                 <button data-thumb-id="${pm.id}" class="relative cursor-pointer min-w-[190px] max-w-[190px] p-2 rounded-lg border ${String(pm.id)===String(projectForViz.activePixelMapId)?'border-accent ring-1 ring-accent/40':'border-gray-700'} bg-gray-900 hover:border-accent transition-colors">
                    ${String(pm.id)===String(projectForViz.activePixelMapId) ? '<span class="absolute top-1 left-1 text-[10px] px-1.5 py-0.5 rounded bg-emerald-600/90 text-white">Active</span>' : ''}
                    <div class="text-xs text-gray-300 mb-2 truncate" title="${pm.name}">${pm.name}</div>
                    <div class="w-[174px] h-[108px] rounded bg-black/40 flex items-start justify-center overflow-hidden mx-auto">
                        <canvas id="thumb-canvas-${pm.id}" class="block" style="image-rendering: pixelated;"></canvas>
                    </div>
                 </button>
             `).join('');

             const composeState = state.visualizerState?.compose || { mapIds: [], secondaryMapId: null, tertiaryMapId: null, placement: 'right', gapPx: 0 };
             if (!Array.isArray(composeState.mapIds)) composeState.mapIds = [];
             try {
                 const legacyIds = [composeState.secondaryMapId, composeState.tertiaryMapId].filter(Boolean).map(String);
                 legacyIds.forEach(id => { if (!composeState.mapIds.includes(id)) composeState.mapIds.push(id); });
                 composeState.mapIds = composeState.mapIds.filter(id => String(id) !== String(projectForViz?.activePixelMapId));
             } catch (_) {}
             const visualizerOtherMaps = (projectForViz?.pixelMaps || [])
                 .filter(pm => String(pm.id) !== String(projectForViz?.activePixelMapId));
             const visualizerCombineStripHtml = buildCombineStrip({
                 ctx: 'visualizer',
                 primaryName: activeMap?.name || 'Active Map',
                 otherMaps: visualizerOtherMaps,
                 selectedIds: composeState.mapIds,
                 placement: composeState.placement || 'right',
                 makeBtnId: 'visualizer-compose-create-btn',
                 hasExistingComposite: !!(activeMap && activeMap.composite && activeMap.composite.enabled)
             });

             mainContent.visualizer.innerHTML = `
                 <div class="bg-gray-800 p-6 rounded-xl shadow-lg">
                       <div class="flex flex-col md:flex-row justify-between items-center mb-4 gap-4">
                           <h2 class="text-2xl font-bold">2D Visualizer: <span class="text-accent">${activeMap.name}</span></h2>
                      <div class="flex flex-wrap justify-center items-center gap-2">
                          <button id="visualizer-save-png-btn" class="btn-glow flex items-center justify-center gap-2 px-3 py-2 text-sm font-semibold rounded-lg shadow-md bg-emerald-600 hover:bg-emerald-700">Save PNG</button>
                          <button id="visualizer-save-jpg-btn" class="btn-glow flex items-center justify-center gap-2 px-3 py-2 text-sm font-semibold rounded-lg shadow-md bg-sky-600 hover:bg-sky-700">Save JPG</button>
                          <button id="visualizer-save-all-pngs-btn" class="btn-glow flex items-center justify-center gap-2 px-3 py-2 text-sm font-semibold rounded-lg shadow-md bg-emerald-600 hover:bg-emerald-700">Save All PNGs</button>
                          <label class="flex items-center gap-1 text-xs text-gray-300 cursor-pointer" title="Export PNG with transparent background"><input id="visualizer-transparent-png" type="checkbox" class="form-checkbox bg-gray-700"> Transparent</label>
                          <button id="visualizer-send-to-canvas-btn" class="btn-glow flex items-center justify-center gap-2 px-3 py-2 text-sm font-semibold rounded-lg shadow-md bg-amber-600 hover:bg-amber-700">Send to Output</button>
                          <button id="visualizer-fit-btn" title="Fit to Screen" class="btn-glow p-2 rounded-lg bg-gray-600 hover:bg-gray-700"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8V4h4M20 8V4h-4M4 16v4h4M20 16v4h-4"></path></svg></button>
                          <button id="visualizer-actual-btn" class="btn-glow px-3 py-2 text-xs font-semibold rounded-lg bg-gray-600 hover:bg-gray-700">Actual</button>
                                <button id="visualizer-zoom-100-btn" class="btn-glow px-3 py-2 text-xs font-semibold rounded-lg bg-gray-600 hover:bg-gray-700">100%</button>
                                <button id="visualizer-zoom-out-btn" class="btn-glow p-2 rounded-lg bg-gray-600 hover:bg-gray-700"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg></button>
                                <button id="visualizer-zoom-in-btn" class="btn-glow p-2 rounded-lg bg-gray-600 hover:bg-gray-700"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg></button>
                           </div>
                       </div>
                       ${visualizerCombineStripHtml}
                       <div id="visualizer-scroll-container" class="relative w-full h-[49.6vh] bg-gray-900 rounded-lg p-4 overflow-auto viz-grid-bg">
                            <!-- Rulers overlay -->
                            <canvas id="viz-ruler-top" class="absolute top-0 left-0 z-10 pointer-events-none"></canvas>
                            <canvas id="viz-ruler-left" class="absolute top-0 left-0 z-10 pointer-events-none"></canvas>
                            <div id="visualizer-wrapper">
                               ${visualizerContent}
                           </div>
                       </div>
                       <div class="mt-4">
                           <div class="text-sm text-gray-400 mb-2">All Pixel Maps in this Project</div>
                           <div id="visualizer-thumbs" class="flex gap-3 overflow-x-auto pb-2">
                               ${thumbsHtml || '<div class="text-xs text-gray-500">No other pixel maps yet.</div>'}
                           </div>
                       </div>
                 </div>`;
            
            // Draw the canvas content after the DOM is updated
            if (calcs.totalResWidth > 0) {
                const canvas = document.getElementById('visualizer-canvas');
                if (canvas) {
                    const composeStateLive = state.visualizerState?.compose || { mapIds: [], secondaryMapId: null, tertiaryMapId: null, placement: 'right', gapPx: 0 };
                    const extraIds = Array.isArray(composeStateLive.mapIds) ? composeStateLive.mapIds : [];
                    const extraMaps = (projectForViz?.pixelMaps || []).filter(pm => extraIds.includes(String(pm.id)));
                    if (extraMaps.length) {
                        const maps = [activeMap, ...extraMaps].filter(Boolean).slice(0, 6);
                        composeVisualizerCanvasMulti(canvas, maps, composeStateLive.placement, composeStateLive.gapPx, { forceFullRes: false });
                    } else {
                        drawVisualizerCanvas(canvas, activeMap);
                    }
                    canvas.addEventListener('click', onVisualizerCanvasClick);
                    // Ensure CSS size reflects underlying pixel buffer at current zoom
                    if (canvas.width && canvas.height) {
                        const z = state.visualizerState.zoom || 1;
                        canvas.style.width = `${Math.round(canvas.width * z)}px`;
                        canvas.style.height = `${Math.round(canvas.height * z)}px`;
                    }
                    if (state.visualizerState.autoFitPreview) fitVisualizerToScreen();
                }
            }

            document.getElementById('visualizer-zoom-in-btn').addEventListener('click', () => handleVisualizerZoom(1.1));
            document.getElementById('visualizer-zoom-out-btn').addEventListener('click', () => handleVisualizerZoom(0.9));
            document.getElementById('visualizer-fit-btn').addEventListener('click', () => fitVisualizerToScreen(true));
            document.getElementById('visualizer-zoom-100-btn').addEventListener('click', () => handleVisualizerZoom(null, 1));
            const vizActual = document.getElementById('visualizer-actual-btn'); if (vizActual) vizActual.addEventListener('click', () => handleVisualizerZoom(null, 1));
                    document.getElementById('visualizer-save-png-btn').addEventListener('click', () => exportVisualizer('png', 'visualizer-canvas', activeMap.name, { transparent: !!document.getElementById('visualizer-transparent-png')?.checked }));
                    document.getElementById('visualizer-save-jpg-btn').addEventListener('click', () => exportVisualizer('jpeg', 'visualizer-canvas', activeMap.name, { transparent: !!document.getElementById('visualizer-transparent-png')?.checked }));
                    const vizSaveAllPngsBtn = document.getElementById('visualizer-save-all-pngs-btn'); if (vizSaveAllPngsBtn) vizSaveAllPngsBtn.addEventListener('click', () => exportAllPixelMapsAsPNGs({ transparent: !!document.getElementById('visualizer-transparent-png')?.checked }));
            const sendBtn = document.getElementById('visualizer-send-to-canvas-btn');
            if (sendBtn) sendBtn.addEventListener('click', sendVisualizerToCanvas);
            // New chip-based combine strip (replaces legacy multi-select + quick-combine row)
            bindCombineStrip({
                ctx: 'visualizer',
                composeState: state.visualizerState.compose,
                onChange: () => renderVisualizer()
            });
            const combineSelect = document.getElementById('visualizer-combine-maps');
            if (combineSelect) {
                combineSelect.addEventListener('change', () => {
                    const selected = Array.from(combineSelect.selectedOptions || []).map(o => String(o.value));
                    const limited = selected.slice(0, 5);
                    if (selected.length > 5) showNotification('Limit is 5 additional maps (total 6).');
                    state.visualizerState.compose.mapIds = limited;
                    renderVisualizer();
                });
            }
            const placementSelect = document.getElementById('visualizer-compose-placement');
            if (placementSelect) {
                placementSelect.addEventListener('change', (e) => {
                    state.visualizerState.compose.placement = e.target.value || 'right';
                    renderVisualizer();
                });
            }
            const makeMapBtn = document.getElementById('visualizer-compose-create-btn');
            if (makeMapBtn) {
                makeMapBtn.addEventListener('click', () => {
                    const proj = state.projects.find(p => p.id === state.activeProjectId);
                    const composeStateLive = state.visualizerState?.compose || {};
                    const extraIds = Array.isArray(composeStateLive.mapIds) ? composeStateLive.mapIds : [];
                    const extraMaps = (proj?.pixelMaps || []).filter(pm => extraIds.includes(String(pm.id)));
                    const primaryMap = getActivePixelMap();
                    if (!primaryMap) return;

                    const isOverwrite = !!(primaryMap.composite && primaryMap.composite.enabled);
                    let maps = [];
                    if (isOverwrite) {
                        if (extraMaps.length) {
                            maps = extraMaps.filter(Boolean).slice(0, 6);
                        } else if (Array.isArray(primaryMap.composite.sourceMapIds)) {
                            const ids = primaryMap.composite.sourceMapIds.map(String);
                            maps = (proj?.pixelMaps || []).filter(pm => ids.includes(String(pm.id))).slice(0, 6);
                        } else if (Array.isArray(primaryMap.composite.maps)) {
                            const names = primaryMap.composite.maps.map(m => String(m?.name || '')).filter(Boolean);
                            maps = (proj?.pixelMaps || []).filter(pm => names.includes(String(pm.name || ''))).slice(0, 6);
                        }
                    } else {
                        if (!extraMaps.length) {
                            showNotification('Select at least one additional pixel map to combine.');
                            return;
                        }
                        maps = [primaryMap, ...extraMaps].filter(Boolean).slice(0, 6);
                    }
                    if (!maps.length) {
                        showNotification('Select at least one additional pixel map to combine.');
                        return;
                    }

                    // Build full-res composed canvas to capture pixel dimensions
                    const composedCanvas = document.createElement('canvas');
                    composeVisualizerCanvasMulti(composedCanvas, maps, composeStateLive.placement || 'right', composeStateLive.gapPx || 0, { forceFullRes: true, ignorePhysicalScale: true });
                    const composedW = composedCanvas.width || 0;
                    const composedH = composedCanvas.height || 0;
                    if (!composedW || !composedH) {
                        showNotification('Failed to build combined pixel map.');
                        return;
                    }

                    // Estimate physical size by combining screen sizes in mm
                    const calcsList = maps.map(m => calculateLayout(m) || {});
                    const widths = calcsList.map(c => c.screenWidthMm || 0).filter(v => v > 0);
                    const heights = calcsList.map(c => c.screenHeightMm || 0).filter(v => v > 0);
                    const placement = composeStateLive.placement || 'right';
                    let screenWidthMm = widths[0] || 0;
                    let screenHeightMm = heights[0] || 0;
                    if (placement === 'left' || placement === 'right') {
                        screenWidthMm = widths.reduce((a,b)=>a+b,0);
                        screenHeightMm = heights.length ? Math.max(...heights) : 0;
                    } else {
                        screenWidthMm = widths.length ? Math.max(...widths) : 0;
                        screenHeightMm = heights.reduce((a,b)=>a+b,0);
                    }
                    const pitchMm = getCompositePitchMm({ composite: { enabled: true, maps } });
                    if (!(screenWidthMm > 0 && screenHeightMm > 0) && Number.isFinite(pitchMm) && pitchMm > 0) {
                        screenWidthMm = Math.round(pitchMm * composedW);
                        screenHeightMm = Math.round(pitchMm * composedH);
                    }
                    if (!(screenWidthMm > 0 && screenHeightMm > 0)) {
                        // Fallback: infer mm from pixels (1px = 1mm) if sizes are unavailable
                        screenWidthMm = composedW;
                        screenHeightMm = composedH;
                    }

                    const shouldOverwrite = !!(primaryMap && primaryMap.composite && primaryMap.composite.enabled);
                    const targetMap = shouldOverwrite ? primaryMap : createNewPixelMapObject((proj.pixelMaps || []).length + 1);
                    const baseName = maps.map(m => (m && m.name) ? m.name : 'Map').join('_').replace(/\s+/g, '_');
                    if (!shouldOverwrite) targetMap.name = `Composite_${baseName}`;
                    targetMap.screenDimensionsUnit = 'm';
                    targetMap.screenWidthValue = Math.round((screenWidthMm / 1000) * 1000) / 1000;
                    targetMap.screenHeightValue = Math.round((screenHeightMm / 1000) * 1000) / 1000;
                    targetMap.panelWidthMm = screenWidthMm;
                    targetMap.panelHeightMm = screenHeightMm;
                    targetMap.panelResWidth = composedW;
                    targetMap.panelResHeight = composedH;
                    targetMap.panels = [true];
                    const mapCalcs = maps.map((m, idx) => {
                        const c = calculateLayout(m) || {};
                        const totalPanels = (c.totalPanels > 0)
                            ? c.totalPanels
                            : (Array.isArray(m?.panels) ? m.panels.length : 0);
                        return {
                            id: m?.id,
                            name: m?.name || `Map ${idx + 1}`,
                            panelsHorizontally: Number.isFinite(c.panelsHorizontally) ? c.panelsHorizontally : null,
                            panelsVertically: Number.isFinite(c.panelsVertically) ? c.panelsVertically : null,
                            totalPanels,
                            totalResWidth: Number(c.totalResWidth) || 0,
                            totalResHeight: Number(c.totalResHeight) || 0,
                            screenWidthMm: Number(c.screenWidthMm) || 0,
                            screenHeightMm: Number(c.screenHeightMm) || 0,
                            panelWidthMm: Number(m?.panelWidthMm) || Number(c.panelWidthMm) || 0,
                            panelHeightMm: Number(m?.panelHeightMm) || Number(c.panelHeightMm) || 0,
                            panelResWidth: Number(m?.panelResWidth) || Number(c.panelResWidth) || 0,
                            panelResHeight: Number(m?.panelResHeight) || Number(c.panelResHeight) || 0
                        };
                    });

                    targetMap.composite = {
                        enabled: true,
                        placement,
                        gapPx: composeStateLive.gapPx || 0,
                        useRawPixels: true,
                        sourceMapIds: maps.map(m => m.id),
                        maps: maps.map(m => JSON.parse(JSON.stringify(m))),
                        primary: JSON.parse(JSON.stringify(primaryMap)),
                        secondary: extraMaps[0] ? JSON.parse(JSON.stringify(extraMaps[0])) : null,
                        tertiary: extraMaps[1] ? JSON.parse(JSON.stringify(extraMaps[1])) : null,
                        mapCalcs,
                        composedWidthPx: composedW,
                        composedHeightPx: composedH,
                        screenWidthMm,
                        screenHeightMm
                    };

                    if (!shouldOverwrite) {
                        proj.pixelMaps.push(targetMap);
                        proj.activePixelMapId = targetMap.id;
                    }
                    saveState();
                    renderPixelMapDesigner();
                    renderVisualizer();
                    showNotification(shouldOverwrite ? 'Composite pixel map updated.' : 'Composite pixel map created.');
                });
            }

            const visualizerQuickSecondary = document.getElementById('visualizer-quick-secondary');
            const visualizerQuickPlacement = document.getElementById('visualizer-quick-placement');
            const visualizerQuickBtn = document.getElementById('visualizer-quick-compose-btn');
            const syncVisualizerQuickState = () => {
                const selectedId = visualizerQuickSecondary ? String(visualizerQuickSecondary.value || '') : '';
                state.visualizerState.compose.mapIds = selectedId ? [selectedId] : [];
                state.visualizerState.compose.placement = (visualizerQuickPlacement && visualizerQuickPlacement.value) ? visualizerQuickPlacement.value : (state.visualizerState.compose.placement || 'right');
            };
            if (visualizerQuickSecondary) visualizerQuickSecondary.addEventListener('change', () => { syncVisualizerQuickState(); renderVisualizer(); });
            if (visualizerQuickPlacement) visualizerQuickPlacement.addEventListener('change', () => { syncVisualizerQuickState(); renderVisualizer(); });
            if (visualizerQuickBtn) {
                visualizerQuickBtn.addEventListener('click', () => {
                    syncVisualizerQuickState();
                    if (!visualizerQuickSecondary || !visualizerQuickSecondary.value) {
                        showNotification('Select a secondary pixel map to combine.');
                        return;
                    }
                    if (makeMapBtn) makeMapBtn.click();
                });
            }
            // No dropdown selectors; selection is via clickable thumbnails below.

            // Visualizer rulers and scrollbars: draw rulers on scroll/resize/zoom
            try {
                const container = document.getElementById('visualizer-scroll-container');
                const drawVizRulers = () => {
                    const top = document.getElementById('viz-ruler-top');
                    const left = document.getElementById('viz-ruler-left');
                    const canvasEl = document.getElementById('visualizer-canvas');
                    if (!container || !top || !left) return;
                    const cs = getComputedStyle(container);
                    const padL = parseFloat(cs.paddingLeft) || 0;
                    const padT = parseFloat(cs.paddingTop) || 0;
                    // top ruler
                    top.width = container.clientWidth;
                    top.height = 24;
                    left.width = 24;
                    left.height = container.clientHeight;
                    const ctxTop = top.getContext('2d');
                    const ctxLeft = left.getContext('2d');
                    ctxTop.clearRect(0,0,top.width,top.height);
                    ctxLeft.clearRect(0,0,left.width,left.height);
                    ctxTop.fillStyle = '#1f2937'; ctxTop.fillRect(0,0,top.width,top.height);
                    ctxLeft.fillStyle = '#1f2937'; ctxLeft.fillRect(0,0,left.width,left.height);
                    ctxTop.fillStyle = '#9ca3af'; ctxTop.font = '10px Inter';
                    ctxLeft.fillStyle = '#9ca3af'; ctxLeft.font = '10px Inter';
                    const z = state.visualizerState.zoom || 1;
                    const startWX = Math.max(0, Math.floor((container.scrollLeft - padL) / z));
                    const endWX = Math.ceil((container.scrollLeft - padL + container.clientWidth) / z);
                    const startWY = Math.max(0, Math.floor((container.scrollTop - padT) / z));
                    const endWY = Math.ceil((container.scrollTop - padT + container.clientHeight) / z);
                    const interval = (z < 0.25 ? 500 : (z < 0.5 ? 200 : 100));
                    for (let wx = startWX - (startWX % (interval/10)); wx <= endWX; wx += interval/10) {
                        const sx = padL + wx * z - container.scrollLeft;
                        const mark = (wx % interval === 0) ? 10 : (wx % (interval/2) === 0 ? 6 : 3);
                        ctxTop.strokeStyle = (wx === 0) ? 'rgba(234, 179, 8, 0.7)' : '#9ca3af';
                        ctxTop.beginPath(); ctxTop.moveTo(sx, 24 - mark); ctxTop.lineTo(sx, 24); ctxTop.stroke();
                        if (wx % interval === 0) ctxTop.fillText(wx, sx + 2, 12);
                    }
                    for (let wy = startWY - (startWY % (interval/10)); wy <= endWY; wy += interval/10) {
                        const sy = padT + wy * z - container.scrollTop;
                        const mark = (wy % interval === 0) ? 10 : (wy % (interval/2) === 0 ? 6 : 3);
                        ctxLeft.strokeStyle = (wy === 0) ? 'rgba(234, 179, 8, 0.7)' : '#9ca3af';
                        ctxLeft.beginPath(); ctxLeft.moveTo(24 - mark, sy); ctxLeft.lineTo(24, sy); ctxLeft.stroke();
                        if (wy % interval === 0) {
                            ctxLeft.save(); ctxLeft.translate(12, sy + 8); ctxLeft.rotate(-Math.PI/2); ctxLeft.fillText(wy, 0, 0); ctxLeft.restore();
                        }
                    }
                };
                container.addEventListener('scroll', drawVizRulers);
                if (state.visualizerState._resizeHandler) window.removeEventListener('resize', state.visualizerState._resizeHandler);
                state.visualizerState._resizeHandler = drawVizRulers;
                window.addEventListener('resize', drawVizRulers);
                drawVizRulers();
            } catch(_) {}

            // Keyboard navigation: Left/Right arrow to cycle pixel maps
            try {
                const container = document.getElementById('visualizer-content');
                const proj = state.projects.find(p => p.id === state.activeProjectId);
                if (container && proj && proj.pixelMaps && proj.pixelMaps.length > 1) {
                    const keyHandler = (ev) => {
                        if (ev.key !== 'ArrowLeft' && ev.key !== 'ArrowRight') return;
                        const idx = proj.pixelMaps.findIndex(m => String(m.id) === String(proj.activePixelMapId));
                        if (idx === -1) return;
                        let nextIdx = idx + (ev.key === 'ArrowRight' ? 1 : -1);
                        if (nextIdx < 0) nextIdx = proj.pixelMaps.length - 1;
                        if (nextIdx >= proj.pixelMaps.length) nextIdx = 0;
                        proj.activePixelMapId = proj.pixelMaps[nextIdx].id;
                        saveState();
                        renderVisualizer();
                    };
                    // Attach on the document while Visualizer is active; remove on re-render by scoping to once
                    document.addEventListener('keydown', keyHandler, { once: true });
                    // Re-attach on next render automatically
                }
            } catch (e) { /* non-fatal */ }

            // Thumbnails: draw and wire up click to activate
            try {
                const proj = state.projects.find(p => p.id === state.activeProjectId);
                if (proj && Array.isArray(proj.pixelMaps)) {
                    proj.pixelMaps.forEach(pm => {
                        const c = document.getElementById(`thumb-canvas-${pm.id}`);
                        if (c) {
                            // Ensure parent has fixed size; draw scaled inside
                            try { drawVisualizerCanvas(c, pm); } catch (_) {}
                        }
                    });
                    // Event delegation: make any thumb click activate
                    const strip = document.getElementById('visualizer-thumbs');
                    if (strip) {
                        strip.addEventListener('click', (ev) => {
                            const el = ev.target.closest('[data-thumb-id]');
                            if (!el) return;
                            const id = el.getAttribute('data-thumb-id');
                            const match = proj.pixelMaps.find(pm => String(pm.id) === String(id));
                            if (!match) return;
                            proj.activePixelMapId = match.id; // preserve original type (number)
                            saveState();
                            renderVisualizer();
                        }, { once: false });
                    }
                }
            } catch (e) { console.warn('thumbs render error', e); }
        };

        let view3dRuntime = null;
        let view3dHistory = { projectId: '', undo: [], redo: [] };
        const render3DViewTabProfessional = (container, activeMap, activeProject) => {
            if (!state.view3dState || typeof state.view3dState !== 'object') state.view3dState = {};
            const s = state.view3dState;
            const mapPool = Array.isArray(activeProject?.pixelMaps) ? activeProject.pixelMaps : [activeMap];
            const allMapIds = mapPool.map((map) => String(map.id));
            s.composeMapIds = allMapIds;
            if (!s.toolMode) s.toolMode = 'orbit';
            if (!Number.isFinite(Number(s.rotX))) s.rotX = -12;
            if (!Number.isFinite(Number(s.rotY))) s.rotY = 28;
            if (!Number.isFinite(Number(s.panX))) s.panX = 0;
            if (!Number.isFinite(Number(s.distance))) s.distance = 9;
            if (typeof s.showGrid === 'undefined') s.showGrid = true;
            if (typeof s.showAxes === 'undefined') s.showAxes = true;
            if (typeof s.showUV === 'undefined') s.showUV = true;
            if (!Number.isFinite(Number(s.uvOpacity))) s.uvOpacity = 82;
            if (!Number.isFinite(Number(s.gridDensity))) s.gridDensity = 12;
            if (!Number.isFinite(Number(s.gridSizeM))) s.gridSizeM = 1;
            if (!/^#[0-9a-f]{6}$/i.test(String(s.backgroundTopColor || ''))) s.backgroundTopColor = '#050a14';
            if (!/^#[0-9a-f]{6}$/i.test(String(s.backgroundBottomColor || ''))) s.backgroundBottomColor = '#0d1425';
            if (!/^#[0-9a-f]{6}$/i.test(String(s.gridMinorColor || ''))) s.gridMinorColor = '#334155';
            if (!/^#[0-9a-f]{6}$/i.test(String(s.gridMajorColor || ''))) s.gridMajorColor = '#475569';
            if (!/^#[0-9a-f]{6}$/i.test(String(s.labelAccentColor || ''))) s.labelAccentColor = '#38bdf8';
            if (!Number.isFinite(Number(s.gridOpacity))) s.gridOpacity = 100;
            if (!Number.isFinite(Number(s.depthScale))) s.depthScale = 1;
            if (!Number.isFinite(Number(s.mapSnapGap))) s.mapSnapGap = 0;
            if (!s.mapSnapTargetId) s.mapSnapTargetId = '';
            if (!['left', 'center', 'right'].includes(s.mapSnapHorizontalAlign)) s.mapSnapHorizontalAlign = 'center';
            if (!['top', 'middle', 'bottom'].includes(s.mapSnapVerticalAlign)) s.mapSnapVerticalAlign = 'middle';
            if (typeof s.mapSnapTouchEdges !== 'boolean') s.mapSnapTouchEdges = true;
            if (typeof s.mapAutoSnap !== 'boolean') s.mapAutoSnap = true;
            if (!Number.isFinite(Number(s.mapAutoSnapRange))) s.mapAutoSnapRange = 0.35;
            if (!['start', 'center', 'end'].includes(s.mapArrangeAlign)) s.mapArrangeAlign = 'center';
            if (!Number.isFinite(Number(s.mapArrangeGap))) s.mapArrangeGap = 0;
            if (!s.selectedMapId) s.selectedMapId = '';
            if (!Array.isArray(s.savedCameraViews)) s.savedCameraViews = [];
            if (!Array.isArray(s.stageObjects)) s.stageObjects = [];
            if (!s.selectedStageObjectId) s.selectedStageObjectId = '';
            s.useUnity = false;

            const historyProjectId = String(activeProject?.id || state.activeProjectId || 'default');
            if (view3dHistory.projectId !== historyProjectId) {
                view3dHistory = { projectId: historyProjectId, undo: [], redo: [] };
            }
            const captureView3dScene = () => JSON.parse(JSON.stringify({
                mapTransforms: s.mapTransforms || {},
                stageObjects: s.stageObjects || [],
                selectedMapId: s.selectedMapId || '',
                selectedStageObjectId: s.selectedStageObjectId || '',
                mapArrangeAlign: s.mapArrangeAlign || 'center',
                mapArrangeGap: Number(s.mapArrangeGap) || 0,
                depthScale: Number(s.depthScale) || 1,
                rotX: Number(s.rotX) || 0,
                rotY: Number(s.rotY) || 0,
                panX: Number(s.panX) || 0,
                panY: Number(s.panY) || 0,
                distance: Number(s.distance) || 9
            }));
            const pushView3dHistory = () => {
                const snapshot = captureView3dScene();
                const serialized = JSON.stringify(snapshot);
                const previous = view3dHistory.undo[view3dHistory.undo.length - 1];
                if (!previous || JSON.stringify(previous) !== serialized) {
                    view3dHistory.undo.push(snapshot);
                    if (view3dHistory.undo.length > 50) view3dHistory.undo.shift();
                }
                view3dHistory.redo = [];
            };
            const restoreView3dScene = (snapshot) => {
                if (!snapshot) return;
                Object.assign(s, JSON.parse(JSON.stringify(snapshot)));
                persistProjects();
                render3DViewTab();
            };
            const undoView3dScene = () => {
                const snapshot = view3dHistory.undo.pop();
                if (!snapshot) return;
                view3dHistory.redo.push(captureView3dScene());
                restoreView3dScene(snapshot);
            };
            const redoView3dScene = () => {
                const snapshot = view3dHistory.redo.pop();
                if (!snapshot) return;
                view3dHistory.undo.push(captureView3dScene());
                restoreView3dScene(snapshot);
            };

            const maps = mapPool;

            const placement = String(s.composePlacement || 'right');
            const horizontal = placement === 'right' || placement === 'left';
            const dir = (placement === 'left' || placement === 'top') ? -1 : 1;
            const gapM = Math.max(0, Number(s.composeGapPx) || 0) / 1000;

            let cursor = 0;
            const mapRenderData = maps.map((m) => {
                const calcs = calculateLayout(m) || {};
                const widthM = Math.max(0.1, Number(calcs.screenWidthMm || 0) / 1000 || 0.1);
                const heightM = Math.max(0.1, Number(calcs.screenHeightMm || 0) / 1000 || 0.1);
                const key = String(m.id);
                if (!s.mapTransforms || typeof s.mapTransforms !== 'object') s.mapTransforms = {};
                if (!s.mapTransforms[key]) s.mapTransforms[key] = { x: 0, y: 0, z: 0, rotY: 0, rotX: 0, rotZ: 0, scale: 1 };
                if (s.mapTransforms[key].y === undefined) s.mapTransforms[key].y = 0;
                if (s.mapTransforms[key].rotX === undefined) s.mapTransforms[key].rotX = 0;
                if (s.mapTransforms[key].rotZ === undefined) s.mapTransforms[key].rotZ = 0;
                if (!Number.isFinite(Number(s.mapTransforms[key].rotY))) s.mapTransforms[key].rotY = 0;
                if (!Number.isFinite(Number(s.mapTransforms[key].scale))) s.mapTransforms[key].scale = 1;
                const baseX = horizontal ? (cursor + (widthM / 2)) * dir : 0;
                const baseY = horizontal ? 0 : -(cursor + (heightM / 2)) * dir;
                cursor += (horizontal ? widthM : heightM) + gapM;
                return { id: key, map: m, calcs, widthM, heightM, baseX, baseY, transform: s.mapTransforms[key] };
            });

            const totalSpanM = Math.max(0.1, cursor - gapM);
            mapRenderData.forEach((m) => {
                if (horizontal) m.baseX -= (totalSpanM / 2) * dir;
                else m.baseY += (totalSpanM / 2) * dir;
            });

            if (!s.selectedStageObjectId && !mapRenderData.some((m) => String(m.id) === String(s.selectedMapId || ''))) {
                s.selectedMapId = mapRenderData[0] ? String(mapRenderData[0].id) : '';
            }
            const getValidMapSnapTargetId = (selectedMapId, preferredTargetId) => {
                const preferred = mapRenderData.find((map) => String(map.id) === String(preferredTargetId || '') && String(map.id) !== String(selectedMapId || ''));
                if (preferred) return String(preferred.id);
                const fallback = mapRenderData.find((map) => String(map.id) !== String(selectedMapId || ''));
                return fallback ? String(fallback.id) : '';
            };
            s.mapSnapTargetId = getValidMapSnapTargetId(s.selectedMapId, s.mapSnapTargetId);
            const selectMapForSnapping = (mapId) => {
                const nextMapId = String(mapId || '');
                const previousMapId = String(s.selectedMapId || '');
                if (!nextMapId || nextMapId === previousMapId) return;
                s.selectedMapId = nextMapId;
                s.selectedStageObjectId = '';
                const preferredTargetId = String(s.mapSnapTargetId || '') === nextMapId ? previousMapId : s.mapSnapTargetId;
                s.mapSnapTargetId = getValidMapSnapTargetId(nextMapId, preferredTargetId);
            };

            const totalWidthM = horizontal
                ? mapRenderData.reduce((sum, m) => sum + m.widthM, 0) + Math.max(0, mapRenderData.length - 1) * gapM
                : Math.max(0.1, ...mapRenderData.map((m) => m.widthM));
            const totalHeightM = horizontal
                ? Math.max(0.1, ...mapRenderData.map((m) => m.heightM))
                : mapRenderData.reduce((sum, m) => sum + m.heightM, 0) + Math.max(0, mapRenderData.length - 1) * gapM;
            const baseDepthM = Math.max(0.08, Math.min(0.8, Math.min(totalWidthM, totalHeightM) * 0.08));
            const wallDepthM = baseDepthM * Math.max(0, Math.min(20, Number(s.depthScale) || 1));
            const floorY = -(totalHeightM / 2) - Math.max(0.12, totalHeightM * 0.2);
            const stageObjects = s.stageObjects.filter((object) => object && object.type === 'deck');
            stageObjects.forEach((object, index) => {
                if (!object.id) object.id = `deck-${Date.now()}-${index}`;
                if (!object.name) object.name = `Deck ${index + 1}`;
                if (!Number.isFinite(Number(object.width))) object.width = Math.max(4, totalWidthM + 2);
                if (!Number.isFinite(Number(object.depth))) object.depth = 4;
                if (!Number.isFinite(Number(object.height))) object.height = 1;
                if (!Number.isFinite(Number(object.x))) object.x = 0;
                if (!Number.isFinite(Number(object.y))) object.y = floorY + (Number(object.height) / 2);
                if (!Number.isFinite(Number(object.z))) object.z = 1.5;
                if (!Number.isFinite(Number(object.rotY))) object.rotY = 0;
                if (!Number.isFinite(Number(object.snapGap))) object.snapGap = 0;
                if (!object.snapMapId || !mapRenderData.some((map) => String(map.id) === String(object.snapMapId))) object.snapMapId = mapRenderData[0]?.id || '';
                if (!/^#[0-9a-f]{6}$/i.test(String(object.color || ''))) object.color = '#334155';
            });

            if (!Number.isFinite(Number(s.panY))) s.panY = 0;
            if (Number(s.cameraFramingVersion) !== 3) {
                s.panX = 0;
                s.panY = 0;
                s.distance = 9;
                s.cameraFramingVersion = 3;
            }

            const selectedMapName = (() => {
                const found = mapRenderData.find((m) => String(m.id) === String(s.selectedMapId || ''));
                return found ? (found.map.name || `Map ${found.id}`) : 'None';
            })();
            const snapTargetOptions = mapRenderData
                .filter((map) => String(map.id) !== String(s.selectedMapId || ''))
                .map((map) => `<option value="${escapeHtml(String(map.id))}" ${String(map.id) === String(s.mapSnapTargetId) ? 'selected' : ''}>${escapeHtml(map.map.name || `Map ${map.id}`)}</option>`)
                .join('');

            if (view3dRuntime && typeof view3dRuntime.dispose === 'function') {
                try { view3dRuntime.dispose(); } catch (_) {}
                view3dRuntime = null;
            }

            container.innerHTML = `
                <div class="bg-gray-800 p-6 rounded-xl shadow-lg">
                    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
                        <h2 class="text-2xl font-bold">3D View</h2>
                        <div class="text-xs text-gray-300">Professional controls: click select • Q/W/E/R tools • Hand tool to pan • drag to transform • wheel zoom</div>
                    </div>
                    <div class="grid grid-cols-1 xl:grid-cols-[1fr_330px] gap-4">
                        <div class="relative rounded-xl border border-gray-700 bg-gray-950/70 p-3" style="min-height:calc(64vh + 1.5rem);">
                            <canvas id="view3d-canvas" class="w-full rounded-lg bg-[#070b14]" style="height:100%;min-height:64vh;touch-action:none;"></canvas>
                            <!-- Canvas Toolbar (top-left) -->
                            <div class="absolute top-3 left-3 z-30 flex items-center gap-1 bg-gray-900/90 border border-gray-700 rounded-lg px-2 py-1.5">
                                <button type="button" id="view3d-undo" class="w-7 h-7 flex items-center justify-center rounded bg-gray-800 hover:bg-gray-700 text-gray-100 disabled:opacity-30 disabled:cursor-not-allowed" title="Undo (Ctrl+Z)" ${view3dHistory.undo.length ? '' : 'disabled'}>
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14 4 9l5-5M4 9h10a6 6 0 0 1 6 6v1"/></svg>
                                </button>
                                <button type="button" id="view3d-redo" class="w-7 h-7 flex items-center justify-center rounded bg-gray-800 hover:bg-gray-700 text-gray-100 disabled:opacity-30 disabled:cursor-not-allowed" title="Redo last undo (Ctrl+Y / Ctrl+Shift+Z)" aria-label="Redo last undo" ${view3dHistory.redo.length ? '' : 'disabled'}>
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 14 5-5-5-5m5 5H10a6 6 0 0 0-6 6v1"/></svg>
                                </button>
                                <button type="button" id="view3d-fit-scene" class="w-7 h-7 flex items-center justify-center rounded bg-gray-800 hover:bg-gray-700 text-gray-100" title="Fit entire scene">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 3H3v5m13-5h5v5M8 21H3v-5m13 5h5v-5"/></svg>
                                </button>
                                <div class="w-px h-5 bg-gray-600 mx-1"></div>
                                <button type="button" data-canvas-tool="orbit" class="view3d-canvas-tool text-[10px] rounded px-2 py-1 bg-cyan-700 text-white" title="Orbit Tool — Rotate the 3D view by dragging. Right-click or Shift+drag to pan. Shortcut: Q">
                                    <svg class="w-3.5 h-3.5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                                </button>
                                <button type="button" data-canvas-tool="pan" class="view3d-canvas-tool text-[10px] rounded px-2 py-1 bg-gray-800 hover:bg-gray-700 text-gray-100" title="Hand Tool — Drag to move the entire 3D interface horizontally or vertically.">
                                    <svg class="w-3.5 h-3.5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 13V5a2 2 0 1 1 4 0v6m0-5a2 2 0 1 1 4 0v5m0-3a2 2 0 1 1 4 0v5a6 6 0 0 1-6 6h-1.5a6 6 0 0 1-5.4-3.37L5 13a2 2 0 0 1 3-2v2Z"/></svg>
                                </button>
                                <button type="button" data-canvas-tool="move" class="view3d-canvas-tool text-[10px] rounded px-2 py-1 bg-gray-800 hover:bg-gray-700 text-gray-100" title="Move Tool — Click and drag a map or stage to reposition it in the scene. Use map gizmo arrows for axis-constrained movement. Shortcut: W">
                                    <svg class="w-3.5 h-3.5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 11l5-5m0 0l5 5m-5-5v12M5 19h14"/></svg>
                                </button>
                                <button type="button" data-canvas-tool="rotate" class="view3d-canvas-tool text-[10px] rounded px-2 py-1 bg-gray-800 hover:bg-gray-700 text-gray-100" title="Rotate Tool — Click a map then drag to rotate it. Use the gizmo ring for precise rotation. Shortcut: E">
                                    <svg class="w-3.5 h-3.5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9"/></svg>
                                </button>
                                <button type="button" data-canvas-tool="scale" class="view3d-canvas-tool text-[10px] rounded px-2 py-1 bg-gray-800 hover:bg-gray-700 text-gray-100" title="Scale Tool — Click a map then drag to resize it. Use gizmo handles for uniform scaling. Shortcut: R">
                                    <svg class="w-3.5 h-3.5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg>
                                </button>
                                <div class="w-px h-5 bg-gray-600 mx-1"></div>
                                <div class="flex items-center gap-1">
                                    <span class="text-[9px] text-gray-400">Grid</span>
                                    <select id="view3d-grid-size" class="bg-gray-800 border border-gray-600 rounded text-[10px] text-gray-100 px-1 py-0.5">
                                        <option value="0.5" ${(Number(s.gridSizeM) || 1) === 0.5 ? 'selected' : ''}>0.5m</option>
                                        <option value="1" ${(Number(s.gridSizeM) || 1) === 1 ? 'selected' : ''}>1m</option>
                                        <option value="2" ${(Number(s.gridSizeM) || 1) === 2 ? 'selected' : ''}>2m</option>
                                        <option value="5" ${(Number(s.gridSizeM) || 1) === 5 ? 'selected' : ''}>5m</option>
                                        <option value="10" ${(Number(s.gridSizeM) || 1) === 10 ? 'selected' : ''}>10m</option>
                                    </select>
                                </div>
                                <div class="w-px h-5 bg-gray-600 mx-1"></div>
                                <label class="flex items-center gap-1 text-[10px] text-gray-300 cursor-pointer" title="Toggle Grid">
                                    <input id="view3d-tb-grid" type="checkbox" ${s.showGrid ? 'checked' : ''} class="w-3 h-3 accent-cyan-400">Grid
                                </label>
                                <label class="flex items-center gap-1 text-[10px] text-gray-300 cursor-pointer" title="Toggle Axes">
                                    <input id="view3d-tb-axes" type="checkbox" ${s.showAxes ? 'checked' : ''} class="w-3 h-3 accent-cyan-400">Axes
                                </label>
                                <label class="flex items-center gap-1 text-[10px] text-gray-300 cursor-pointer" title="Toggle UV">
                                    <input id="view3d-tb-uv" type="checkbox" ${s.showUV ? 'checked' : ''} class="w-3 h-3 accent-cyan-400">UV
                                </label>
                            </div>
                            <!-- Pan D-pad (bottom-right corner of canvas) -->
                            <div class="absolute bottom-5 right-3 z-30 flex flex-col items-center gap-1" title="Pan canvas" style="opacity:0.9">
                                <button type="button" id="view3d-pan-up" class="bg-gray-800/90 hover:bg-gray-600 text-gray-200 rounded-lg w-10 h-10 flex items-center justify-center border border-gray-500" title="Pan Up">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7"/></svg>
                                </button>
                                <div class="flex gap-1">
                                    <button type="button" id="view3d-pan-left" class="bg-gray-800/90 hover:bg-gray-600 text-gray-200 rounded-lg w-10 h-10 flex items-center justify-center border border-gray-500" title="Pan Left">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
                                    </button>
                                    <button type="button" id="view3d-pan-reset" class="bg-gray-700/90 hover:bg-gray-500 text-gray-300 rounded-lg w-10 h-10 flex items-center justify-center border border-gray-500" title="Fit entire scene">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 3H3v5m13-5h5v5M8 21H3v-5m13 5h5v-5"/></svg>
                                    </button>
                                    <button type="button" id="view3d-pan-right" class="bg-gray-800/90 hover:bg-gray-600 text-gray-200 rounded-lg w-10 h-10 flex items-center justify-center border border-gray-500" title="Pan Right">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
                                    </button>
                                </div>
                                <button type="button" id="view3d-pan-down" class="bg-gray-800/90 hover:bg-gray-600 text-gray-200 rounded-lg w-10 h-10 flex items-center justify-center border border-gray-500" title="Pan Down">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
                                </button>
                            </div>
                            <!-- Perspective Dropdown (top-right, d3-style) -->
                            <div class="absolute top-3 right-3 z-30" id="view3d-persp-wrap">
                                <button type="button" id="view3d-persp-btn" class="flex items-center gap-2 bg-gray-900/90 border border-gray-700 rounded px-3 py-1.5 text-[11px] text-gray-100 hover:bg-gray-800 cursor-pointer select-none min-w-[130px] justify-between" style="backdrop-filter:blur(8px)">
                                    <span id="view3d-persp-label">Perspective</span>
                                    <svg class="w-3 h-3 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                                </button>
                                <div id="view3d-persp-menu" class="hidden absolute top-full right-0 mt-1 bg-gray-900/95 border border-gray-600 rounded-lg shadow-2xl min-w-[160px] py-1 z-50" style="backdrop-filter:blur(12px)">
                                    <button data-view="perspective" class="view3d-view-opt w-full text-left px-3 py-1.5 text-[11px] text-gray-100 hover:bg-cyan-700/40 transition-colors">Perspective</button>
                                    <div class="border-t border-gray-700 my-0.5 mx-2"></div>
                                    <button data-view="top" class="view3d-view-opt w-full text-left px-3 py-1.5 text-[11px] text-gray-100 hover:bg-cyan-700/40 transition-colors">Top</button>
                                    <button data-view="bottom" class="view3d-view-opt w-full text-left px-3 py-1.5 text-[11px] text-gray-100 hover:bg-cyan-700/40 transition-colors">Bottom</button>
                                    <button data-view="left" class="view3d-view-opt w-full text-left px-3 py-1.5 text-[11px] text-gray-100 hover:bg-cyan-700/40 transition-colors">Left</button>
                                    <button data-view="right" class="view3d-view-opt w-full text-left px-3 py-1.5 text-[11px] text-gray-100 hover:bg-cyan-700/40 transition-colors">Right</button>
                                    <button data-view="front" class="view3d-view-opt w-full text-left px-3 py-1.5 text-[11px] text-gray-100 hover:bg-cyan-700/40 transition-colors">Front</button>
                                    <button data-view="back" class="view3d-view-opt w-full text-left px-3 py-1.5 text-[11px] text-gray-100 hover:bg-cyan-700/40 transition-colors">Back</button>
                                    <div class="border-t border-gray-700 my-0.5 mx-2"></div>
                                    <button data-view="reset" class="view3d-view-opt w-full text-left px-3 py-1.5 text-[11px] text-gray-400 hover:bg-cyan-700/40 hover:text-gray-100 transition-colors">Reset Camera</button>
                                </div>
                            </div>
                        </div>
                        <div class="rounded-xl border border-gray-700 bg-gray-900/60 p-4 space-y-4">
                            <div class="flex items-center justify-between gap-2">
                                <div class="text-sm text-gray-200 font-semibold">Project Maps</div>
                                <span class="rounded bg-cyan-950 px-2 py-1 text-[11px] text-cyan-200">${mapPool.length} shown</span>
                            </div>
                            <div class="text-xs text-gray-300">Selected: <span id="view3d-selected-map" class="text-cyan-300">${escapeHtml(selectedMapName)}</span></div>
                            <div class="rounded-lg border border-gray-700 bg-gray-800/50 p-2 space-y-2">
                                <div class="text-xs font-semibold text-gray-200">Arrange All Maps</div>
                                <div class="grid grid-cols-[1fr_72px] gap-2">
                                    <label class="text-[10px] text-gray-400">Alignment
                                        <select id="view3d-arrange-align" class="mt-0.5 w-full bg-gray-900 border border-gray-600 rounded px-2 py-1.5 text-xs text-gray-50">
                                            <option value="start" ${s.mapArrangeAlign === 'start' ? 'selected' : ''}>Top / Left</option>
                                            <option value="center" ${s.mapArrangeAlign === 'center' ? 'selected' : ''}>Center</option>
                                            <option value="end" ${s.mapArrangeAlign === 'end' ? 'selected' : ''}>Bottom / Right</option>
                                        </select>
                                    </label>
                                    <label class="text-[10px] text-gray-400">Gap m<input id="view3d-arrange-gap" type="number" min="0" max="100" step="0.05" value="${Number(s.mapArrangeGap).toFixed(2)}" class="mt-0.5 w-full bg-gray-900 border border-gray-600 rounded px-1 py-1.5 text-xs text-gray-50"></label>
                                </div>
                                <div class="grid grid-cols-3 gap-1">
                                    <button class="view3d-arrange-all rounded bg-cyan-700 hover:bg-cyan-600 px-2 py-2 text-[11px] font-semibold text-white" data-layout="row" title="Pack all maps edge-to-edge in one horizontal row">Row</button>
                                    <button class="view3d-arrange-all rounded bg-cyan-700 hover:bg-cyan-600 px-2 py-2 text-[11px] font-semibold text-white" data-layout="stack" title="Pack all maps edge-to-edge in one vertical stack">Stack</button>
                                    <button class="view3d-arrange-all rounded bg-cyan-700 hover:bg-cyan-600 px-2 py-2 text-[11px] font-semibold text-white" data-layout="grid" title="Pack all maps into a compact grid">Grid</button>
                                </div>
                            </div>
                            <div class="rounded-lg border border-gray-700 bg-gray-800/50 p-2 space-y-2">
                                <div class="text-xs font-semibold text-gray-200">Place Selected Map</div>
                                ${snapTargetOptions ? `
                                    <select id="view3d-snap-target" class="w-full bg-gray-900 border border-gray-600 rounded px-2 py-1.5 text-xs text-gray-100" title="Map to place against">${snapTargetOptions}</select>
                                    <div class="grid grid-cols-4 gap-1">
                                        <button class="view3d-snap-map-side rounded bg-cyan-800 hover:bg-cyan-700 px-1 py-1.5 text-[10px] text-white" data-side="left">Left</button>
                                        <button class="view3d-snap-map-side rounded bg-cyan-800 hover:bg-cyan-700 px-1 py-1.5 text-[10px] text-white" data-side="right">Right</button>
                                        <button class="view3d-snap-map-side rounded bg-cyan-800 hover:bg-cyan-700 px-1 py-1.5 text-[10px] text-white" data-side="above">Above</button>
                                        <button class="view3d-snap-map-side rounded bg-cyan-800 hover:bg-cyan-700 px-1 py-1.5 text-[10px] text-white" data-side="below">Below</button>
                                    </div>
                                    <details class="text-[10px] text-gray-400">
                                        <summary class="cursor-pointer select-none hover:text-gray-200">Advanced</summary>
                                        <div class="mt-2 space-y-2">
                                            <div class="grid grid-cols-2 gap-2">
                                                <label>Horizontal<select id="view3d-snap-horizontal-align" class="mt-0.5 w-full bg-gray-900 border border-gray-600 rounded px-1 py-1 text-xs text-gray-50"><option value="left" ${s.mapSnapHorizontalAlign === 'left' ? 'selected' : ''}>Left</option><option value="center" ${s.mapSnapHorizontalAlign === 'center' ? 'selected' : ''}>Center</option><option value="right" ${s.mapSnapHorizontalAlign === 'right' ? 'selected' : ''}>Right</option></select></label>
                                                <label>Vertical<select id="view3d-snap-vertical-align" class="mt-0.5 w-full bg-gray-900 border border-gray-600 rounded px-1 py-1 text-xs text-gray-50"><option value="top" ${s.mapSnapVerticalAlign === 'top' ? 'selected' : ''}>Top</option><option value="middle" ${s.mapSnapVerticalAlign === 'middle' ? 'selected' : ''}>Middle</option><option value="bottom" ${s.mapSnapVerticalAlign === 'bottom' ? 'selected' : ''}>Bottom</option></select></label>
                                            </div>
                                            <label class="flex items-center gap-2"><input id="view3d-snap-touch-edges" type="checkbox" ${s.mapSnapTouchEdges ? 'checked' : ''} class="accent-cyan-400">Touch edges</label>
                                            <label class="flex items-center gap-2"><input id="view3d-auto-snap" type="checkbox" ${s.mapAutoSnap ? 'checked' : ''} class="accent-cyan-400">Magnetic movement</label>
                                            <div class="grid grid-cols-2 gap-2"><label>Gap m<input id="view3d-map-snap-gap" type="number" min="0" step="0.05" value="${Number(s.mapSnapGap).toFixed(2)}" ${s.mapSnapTouchEdges ? 'disabled' : ''} class="mt-0.5 w-full bg-gray-900 border border-gray-600 rounded px-1 py-1 text-xs text-gray-50 disabled:opacity-40"></label><label>Range m<input id="view3d-auto-snap-range" type="number" min="0.05" step="0.05" value="${Number(s.mapAutoSnapRange).toFixed(2)}" class="mt-0.5 w-full bg-gray-900 border border-gray-600 rounded px-1 py-1 text-xs text-gray-50"></label></div>
                                        </div>
                                    </details>` : '<div class="text-[10px] text-gray-500">Create another map to enable placement.</div>'}
                            </div>
                            <div class="border-t border-gray-700 pt-3">
                                <div class="text-sm text-gray-200 font-semibold mb-2">Map Controls</div>
                                <div id="view3d-map-controls" class="space-y-2 max-h-[260px] overflow-y-auto pr-1">
                                    ${mapRenderData.map((m) => {
                                        const t = s.mapTransforms[m.id] || { x: 0, y: 0, z: 0, rotY: 0, scale: 1 };
                                        const isSel = String(m.id) === String(s.selectedMapId || '');
                                        const calcs = m.calcs || {};
                                        const wM = (m.widthM * Math.max(0.2, Math.min(3, Number(t.scale) || 1))).toFixed(2);
                                        const hM = (m.heightM * Math.max(0.2, Math.min(3, Number(t.scale) || 1))).toFixed(2);
                                        return `<div class="rounded-lg p-2 ${isSel ? 'bg-cyan-900/40 border border-cyan-700' : 'bg-gray-800/60 border border-gray-700'} view3d-map-card cursor-pointer" data-mapid="${m.id}">
                                            <div class="flex items-center justify-between mb-1.5">
                                                <span class="text-sm font-semibold ${isSel ? 'text-cyan-200' : 'text-gray-100'}">${escapeHtml(m.map.name || 'Map ' + m.id)}</span>
                                                <span class="text-[11px] text-gray-300">${wM}m × ${hM}m</span>
                                            </div>
                                            <div class="grid grid-cols-5 gap-1.5">
                                                <div class="text-center">
                                                    <div class="text-[11px] font-medium text-gray-300 mb-0.5">X</div>
                                                    <input type="number" step="0.1" value="${(Number(t.x) || 0).toFixed(1)}" class="view3d-tf-input w-full bg-gray-900 border border-gray-600 rounded px-1 py-1 text-xs text-gray-50 text-center font-medium" data-mapid="${m.id}" data-field="x">
                                                </div>
                                                <div class="text-center">
                                                    <div class="text-[11px] font-medium text-gray-300 mb-0.5">Y</div>
                                                    <input type="number" step="0.1" value="${(Number(t.y) || 0).toFixed(1)}" class="view3d-tf-input w-full bg-gray-900 border border-gray-600 rounded px-1 py-1 text-xs text-gray-50 text-center font-medium" data-mapid="${m.id}" data-field="y">
                                                </div>
                                                <div class="text-center">
                                                    <div class="text-[11px] font-medium text-gray-300 mb-0.5">Z</div>
                                                    <input type="number" step="0.1" value="${(Number(t.z) || 0).toFixed(1)}" class="view3d-tf-input w-full bg-gray-900 border border-gray-600 rounded px-1 py-1 text-xs text-gray-50 text-center font-medium" data-mapid="${m.id}" data-field="z">
                                                </div>
                                                <div class="text-center">
                                                    <div class="text-[11px] font-medium text-gray-300 mb-0.5">Rot°</div>
                                                    <input type="number" step="5" value="${Math.round(Number(t.rotY) || 0)}" class="view3d-tf-input w-full bg-gray-900 border border-gray-600 rounded px-1 py-1 text-xs text-gray-50 text-center font-medium" data-mapid="${m.id}" data-field="rotY">
                                                </div>
                                                <div class="text-center">
                                                    <div class="text-[11px] font-medium text-gray-300 mb-0.5">Scale</div>
                                                    <input type="number" step="0.1" min="0.2" max="3" value="${(Number(t.scale) || 1).toFixed(1)}" class="view3d-tf-input w-full bg-gray-900 border border-gray-600 rounded px-1 py-1 text-xs text-gray-50 text-center font-medium" data-mapid="${m.id}" data-field="scale">
                                                </div>
                                            </div>
                                        </div>`;
                                    }).join('')}
                                </div>
                            </div>
                            <div class="border-t border-gray-700 pt-3 space-y-2">
                                <div class="flex items-center justify-between gap-2">
                                    <div class="text-sm text-gray-200 font-semibold">Stage Builder</div>
                                    <button id="view3d-add-deck" class="px-2 py-1 rounded bg-amber-600 hover:bg-amber-500 text-[11px] font-semibold text-white" title="Add a rectangular stage deck">+ Deck</button>
                                </div>
                                <div id="view3d-stage-list" class="space-y-2 max-h-[300px] overflow-y-auto pr-1">
                                    ${stageObjects.length ? stageObjects.map((object) => {
                                        const isSelected = String(object.id) === String(s.selectedStageObjectId || '');
                                        return `<div class="view3d-stage-card rounded-lg p-2 ${isSelected ? 'bg-amber-900/30 border border-amber-600' : 'bg-gray-800/60 border border-gray-700'}" data-stageid="${escapeHtml(String(object.id))}">
                                            <div class="flex items-center justify-between gap-2 mb-2">
                                                <span class="text-xs font-semibold ${isSelected ? 'text-amber-200' : 'text-gray-100'}">${escapeHtml(object.name)}</span>
                                                <div class="flex items-center gap-1">
                                                    <input type="color" value="${object.color}" class="view3d-stage-color w-6 h-6 bg-transparent border-0 cursor-pointer" data-stageid="${escapeHtml(String(object.id))}" title="Deck color">
                                                    <button class="view3d-delete-stage w-6 h-6 rounded bg-red-950/70 hover:bg-red-800 text-red-300" data-stageid="${escapeHtml(String(object.id))}" title="Delete deck">&times;</button>
                                                </div>
                                            </div>
                                            <div class="grid grid-cols-4 gap-1">
                                                ${[['width','W',0.1],['depth','D',0.1],['height','H',0.1],['rotY','Rot°',5],['x','X',0.1],['y','Y',0.1],['z','Z',0.1]].map(([field, label, step]) => `<label class="text-[9px] text-gray-400">${label}<input type="number" step="${step}" value="${Number(object[field]).toFixed(field === 'rotY' ? 0 : 1)}" class="view3d-stage-input mt-0.5 w-full bg-gray-900 border border-gray-600 rounded px-1 py-1 text-[10px] text-gray-50" data-stageid="${escapeHtml(String(object.id))}" data-field="${field}"></label>`).join('')}
                                            </div>
                                            <div class="mt-2 pt-2 border-t border-gray-700 space-y-1.5">
                                                <div class="grid grid-cols-[1fr_62px] gap-1">
                                                    <select class="view3d-snap-map bg-gray-900 border border-gray-600 rounded px-1 py-1 text-[10px] text-gray-100" data-stageid="${escapeHtml(String(object.id))}" title="LED wall used for snapping">
                                                        ${mapRenderData.map((map) => `<option value="${escapeHtml(String(map.id))}" ${String(map.id) === String(object.snapMapId) ? 'selected' : ''}>${escapeHtml(map.map.name || `Map ${map.id}`)}</option>`).join('')}
                                                    </select>
                                                    <label class="text-[9px] text-gray-400">Gap m<input type="number" min="0" max="10" step="0.05" value="${Number(object.snapGap).toFixed(2)}" class="view3d-snap-gap mt-0.5 w-full bg-gray-900 border border-gray-600 rounded px-1 py-1 text-[10px] text-gray-50" data-stageid="${escapeHtml(String(object.id))}"></label>
                                                </div>
                                                <div class="grid grid-cols-2 gap-1">
                                                    <button class="view3d-snap-stage px-2 py-1.5 rounded bg-cyan-700 hover:bg-cyan-600 text-[10px] font-semibold text-white" data-stageid="${escapeHtml(String(object.id))}" title="Place the deck directly below the selected LED wall">Snap Below LED</button>
                                                    <button class="view3d-match-stage px-2 py-1.5 rounded bg-amber-700 hover:bg-amber-600 text-[10px] font-semibold text-white" data-stageid="${escapeHtml(String(object.id))}" title="Match the deck width and align its back edge to the bottom of the selected LED wall">Span to LED Bottom</button>
                                                </div>
                                            </div>
                                        </div>`;
                                    }).join('') : '<div class="text-[10px] text-gray-500 italic">Add a deck to begin building the stage.</div>'}
                                </div>
                            </div>
                            <div class="border-t border-gray-700 pt-3 space-y-3">
                                <details>
                                    <summary class="cursor-pointer select-none text-sm font-semibold text-gray-200 hover:text-white">Appearance</summary>
                                    <div class="mt-3 space-y-3">
                                        <div class="grid grid-cols-2 gap-2">
                                            <label class="text-[10px] text-gray-400">Background top<input id="view3d-bg-top" type="color" value="${s.backgroundTopColor}" class="mt-1 w-full h-8 rounded bg-gray-900 border border-gray-600 cursor-pointer" title="Canvas background top color"></label>
                                            <label class="text-[10px] text-gray-400">Background bottom<input id="view3d-bg-bottom" type="color" value="${s.backgroundBottomColor}" class="mt-1 w-full h-8 rounded bg-gray-900 border border-gray-600 cursor-pointer" title="Canvas background bottom color"></label>
                                            <label class="text-[10px] text-gray-400">Minor grid<input id="view3d-grid-minor-color" type="color" value="${s.gridMinorColor}" class="mt-1 w-full h-8 rounded bg-gray-900 border border-gray-600 cursor-pointer" title="Minor grid line color"></label>
                                            <label class="text-[10px] text-gray-400">Major grid<input id="view3d-grid-major-color" type="color" value="${s.gridMajorColor}" class="mt-1 w-full h-8 rounded bg-gray-900 border border-gray-600 cursor-pointer" title="Major grid line color"></label>
                                            <label class="text-[10px] text-gray-400 col-span-2">Map label accent<input id="view3d-label-accent-color" type="color" value="${s.labelAccentColor}" class="mt-1 w-full h-8 rounded bg-gray-900 border border-gray-600 cursor-pointer" title="Map label border and detail color"></label>
                                        </div>
                                        <label class="block text-xs text-gray-300">Grid intensity: <span id="view3d-grid-opacity-val">${Math.round(Number(s.gridOpacity))}%</span></label>
                                        <input id="view3d-grid-opacity" type="range" min="0" max="150" step="5" value="${Number(s.gridOpacity)}" class="w-full accent-cyan-400">
                                        <button id="view3d-reset-appearance" type="button" class="w-full px-2 py-1.5 rounded bg-gray-800 hover:bg-gray-700 border border-gray-600 text-xs text-gray-200">Restore Appearance Defaults</button>
                                    </div>
                                </details>
                                <label class="block text-xs text-gray-300">UV Opacity: <span id="view3d-uv-opacity-val">${Math.round(Number(s.uvOpacity) || 82)}%</span></label>
                                <input id="view3d-uv-opacity" type="range" min="10" max="100" step="1" value="${Number(s.uvOpacity) || 82}" class="w-full accent-cyan-400">
                                <label class="block text-xs text-gray-300">Extrude Depth: <span id="view3d-depth-val">${(Number(s.depthScale) || 1).toFixed(1)}×</span></label>
                                <input id="view3d-depth-scale" type="range" min="0" max="20" step="0.5" value="${Number(s.depthScale) || 1}" class="w-full accent-cyan-400">
                            </div>
                            <button id="view3d-reset" class="w-full px-3 py-2 rounded-lg bg-gray-700 hover:bg-gray-600 text-sm text-white">Reset View</button>
                            <div class="grid grid-cols-2 gap-2">
                                <button id="view3d-save-png" class="px-3 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-sm font-semibold text-white" title="Export the current 3D view as a transparent-background PNG">Save PNG</button>
                                <button id="view3d-save-jpg" class="px-3 py-2 rounded-lg bg-sky-600 hover:bg-sky-500 text-sm font-semibold text-white" title="Export the current 3D view as a JPG image">Save JPG</button>
                            </div>
                            <div class="border-t border-gray-700 pt-3 space-y-2">
                                <div class="flex items-center justify-between">
                                    <div class="text-sm text-gray-200 font-semibold">Camera Views</div>
                                    <div class="flex items-center gap-1">
                                        ${(s.savedCameraViews||[]).length > 0 ? `<button id="view3d-clear-cams" class="text-[10px] px-2 py-1 bg-red-900/60 hover:bg-red-700 text-red-300 hover:text-white rounded transition-colors" title="Remove all saved camera views">Clear All</button>` : ''}
                                        <button id="view3d-save-cam" class="flex items-center gap-1 text-[10px] px-2 py-1 bg-cyan-700 hover:bg-cyan-600 text-white rounded transition-colors" title="Save current camera angle">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                            Save View
                                        </button>
                                    </div>
                                </div>
                                <div id="view3d-cam-views-list" class="space-y-1 max-h-[160px] overflow-y-auto pr-1">
                                    ${(s.savedCameraViews||[]).length===0
                                        ? '<div class="text-[10px] text-gray-500 italic">No saved views yet...</div>'
                                        : (s.savedCameraViews||[]).map((v,i)=>`<div class="flex items-center gap-1 group"><button class="view3d-recall-cam flex-1 text-left px-2 py-1.5 rounded bg-gray-800 hover:bg-cyan-800/60 text-[11px] text-gray-100 truncate" data-camidx="${i}"><span class="text-cyan-400 mr-1">&#9654;</span>${v.name.replace(/</g,'&lt;').replace(/>/g,'&gt;')}</button><button class="view3d-delete-cam p-1 rounded hover:bg-red-800/60 text-gray-400 hover:text-red-300 transition-all opacity-0 group-hover:opacity-100" data-camidx="${i}" title="Delete"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button></div>`).join('')
                                    }
                                </div>
                            </div>
                            <div class="text-xs text-gray-400 leading-relaxed">
                                Total: ${totalWidthM.toFixed(2)}m × ${totalHeightM.toFixed(2)}m • Maps: ${mapRenderData.length} • Panels: ${mapRenderData.reduce((s, m) => s + (m.calcs?.totalPanels || 0), 0)}
                            </div>
                        </div>
                    </div>
                </div>`;

            const canvas = document.getElementById('view3d-canvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            if (!ctx) return;

            const fitCanvas = () => {
                const dpr = window.devicePixelRatio || 1;
                const r = canvas.getBoundingClientRect();
                canvas.width = Math.max(1, Math.round(r.width * dpr));
                canvas.height = Math.max(1, Math.round(r.height * dpr));
                ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            };

            const uvTextureByMapId = new Map();
            mapRenderData.forEach((entry) => {
                try {
                    const textureCanvas = document.createElement('canvas');
                    const fixedScale = Math.max(0.15, Math.min(1.0, 2400 / Math.max(1, Number(entry.calcs?.totalResWidth) || 1)));
                    drawVisualizerCanvas(textureCanvas, entry.map, { fixedScale, suppressDetails: false });
                    const tCtx = textureCanvas.getContext('2d');
                    if (tCtx && textureCanvas.width > 0 && textureCanvas.height > 0) {
                        uvTextureByMapId.set(entry.id, {
                            canvas: textureCanvas,
                            width: textureCanvas.width,
                            height: textureCanvas.height,
                            data: tCtx.getImageData(0, 0, textureCanvas.width, textureCanvas.height).data
                        });
                    }
                } catch (_) {}
            });

            const degToRad = (deg) => deg * (Math.PI / 180);
            const lerpPoint3 = (a, b, t) => ({ x: a.x + ((b.x - a.x) * t), y: a.y + ((b.y - a.y) * t), z: a.z + ((b.z - a.z) * t) });
            const rotateYPoint = (p, angleDeg) => {
                const r = degToRad(Number(angleDeg) || 0);
                const c = Math.cos(r), sn = Math.sin(r);
                return { x: (p.x * c) + (p.z * sn), y: p.y, z: (-p.x * sn) + (p.z * c) };
            };
            const rotateXPoint = (p, angleDeg) => {
                const r = degToRad(Number(angleDeg) || 0);
                const c = Math.cos(r), sn = Math.sin(r);
                return { x: p.x, y: (p.y * c) - (p.z * sn), z: (p.y * sn) + (p.z * c) };
            };
            const rotateZPoint = (p, angleDeg) => {
                const r = degToRad(Number(angleDeg) || 0);
                const c = Math.cos(r), sn = Math.sin(r);
                return { x: (p.x * c) - (p.y * sn), y: (p.x * sn) + (p.y * c), z: p.z };
            };

            const buildMapGeometry = (m) => {
                const tx = Number(m.transform?.x) || 0;
                const ty = Number(m.transform?.y) || 0;
                const tz = Number(m.transform?.z) || 0;
                const rotY = Number(m.transform?.rotY) || 0;
                const rotX = Number(m.transform?.rotX) || 0;
                const rotZ = Number(m.transform?.rotZ) || 0;
                const scale = Math.max(0.2, Math.min(3, Number(m.transform?.scale) || 1));
                const center = { x: m.baseX + tx, y: m.baseY + ty, z: tz };
                const halfMapW = (m.widthM * scale) / 2;
                const halfMapH = (m.heightM * scale) / 2;
                // Front face at z=0, extrude goes behind (positive Z = further from camera)
                const localFront = [
                    { x: -halfMapW, y: halfMapH, z: 0 },
                    { x: halfMapW, y: halfMapH, z: 0 },
                    { x: halfMapW, y: -halfMapH, z: 0 },
                    { x: -halfMapW, y: -halfMapH, z: 0 }
                ];
                const localBack = [
                    { x: -halfMapW, y: halfMapH, z: wallDepthM },
                    { x: halfMapW, y: halfMapH, z: wallDepthM },
                    { x: halfMapW, y: -halfMapH, z: wallDepthM },
                    { x: -halfMapW, y: -halfMapH, z: wallDepthM }
                ];
                const toWorld = (pt) => {
                    let r = rotateYPoint(pt, rotY);
                    if (rotX) r = rotateXPoint(r, rotX);
                    if (rotZ) r = rotateZPoint(r, rotZ);
                    return { x: center.x + r.x, y: center.y + r.y, z: center.z + r.z };
                };
                return { front: localFront.map(toWorld), back: localBack.map(toWorld) };
            };

            const buildStageGeometry = (object) => {
                const halfW = Math.max(0.1, Number(object.width) || 1) / 2;
                const halfH = Math.max(0.05, Number(object.height) || 0.2) / 2;
                const halfD = Math.max(0.1, Number(object.depth) || 1) / 2;
                const center = { x: Number(object.x) || 0, y: Number(object.y) || 0, z: Number(object.z) || 0 };
                const local = [
                    { x: -halfW, y: halfH, z: -halfD }, { x: halfW, y: halfH, z: -halfD },
                    { x: halfW, y: -halfH, z: -halfD }, { x: -halfW, y: -halfH, z: -halfD },
                    { x: -halfW, y: halfH, z: halfD }, { x: halfW, y: halfH, z: halfD },
                    { x: halfW, y: -halfH, z: halfD }, { x: -halfW, y: -halfH, z: halfD }
                ];
                const points = local.map((point) => {
                    const rotated = rotateYPoint(point, Number(object.rotY) || 0);
                    return { x: center.x + rotated.x, y: center.y + rotated.y, z: center.z + rotated.z };
                });
                return { points, front: points.slice(0, 4), back: points.slice(4, 8) };
            };

            const shadeHexColor = (hex, amount) => {
                const value = parseInt(String(hex || '#334155').slice(1), 16);
                const clamp = (channel) => Math.max(0, Math.min(255, channel));
                const red = clamp((value >> 16) + amount);
                const green = clamp(((value >> 8) & 255) + amount);
                const blue = clamp((value & 255) + amount);
                return `rgb(${red}, ${green}, ${blue})`;
            };

            const sceneBoundsPoints = [];
            mapRenderData.forEach((map) => {
                const geometry = buildMapGeometry(map);
                sceneBoundsPoints.push(...geometry.front, ...geometry.back);
            });
            stageObjects.forEach((object) => sceneBoundsPoints.push(...buildStageGeometry(object).points));
            const sceneBounds = sceneBoundsPoints.reduce((bounds, point) => ({
                minX: Math.min(bounds.minX, point.x), maxX: Math.max(bounds.maxX, point.x),
                minY: Math.min(bounds.minY, point.y), maxY: Math.max(bounds.maxY, point.y),
                minZ: Math.min(bounds.minZ, point.z), maxZ: Math.max(bounds.maxZ, point.z)
            }), { minX: Infinity, maxX: -Infinity, minY: Infinity, maxY: -Infinity, minZ: Infinity, maxZ: -Infinity });
            const sceneCenter = {
                x: (sceneBounds.minX + sceneBounds.maxX) / 2,
                y: (sceneBounds.minY + sceneBounds.maxY) / 2,
                z: (sceneBounds.minZ + sceneBounds.maxZ) / 2
            };
            const modelRadius = Math.max(0.5, 0.5 * Math.sqrt(
                ((sceneBounds.maxX - sceneBounds.minX) ** 2) +
                ((sceneBounds.maxY - sceneBounds.minY) ** 2) +
                ((sceneBounds.maxZ - sceneBounds.minZ) ** 2)
            )) * 1.08;
            const MIN_ZOOM_DISTANCE = 0.75;
            const MAX_ZOOM_DISTANCE = 72;
            const PAN_LIMIT = 5000;
            const MAP_POSITION_LIMIT = 1000;
            // Fixed FOV perspective: zoom only changes camera distance, not field of view
            const FOV_DEG = 50;
            const FOV_RAD = degToRad(FOV_DEG);
            const getZoomFactor = () => {
                const raw = Math.max(MIN_ZOOM_DISTANCE, Math.min(MAX_ZOOM_DISTANCE, Number(s.distance) || 9));
                return raw / 9; // 1.0 at default, <1 zoomed in, >1 zoomed out
            };

            const rotatePoint = (x, y, z) => {
                const rx = degToRad(Number(s.rotX) || 0);
                const ry = degToRad(Number(s.rotY) || 0);
                let px = x - sceneCenter.x, py = y - sceneCenter.y, pz = z - sceneCenter.z;
                const cosy = Math.cos(ry), siny = Math.sin(ry);
                const nx1 = (px * cosy) + (pz * siny);
                const nz1 = (-px * siny) + (pz * cosy);
                px = nx1; pz = nz1;
                const cosx = Math.cos(rx), sinx = Math.sin(rx);
                const ny2 = (py * cosx) - (pz * sinx);
                const nz2 = (py * sinx) + (pz * cosx);
                py = ny2; pz = nz2;
                return { x: px, y: py, z: pz };
            };

            const getCameraDistance = () => {
                const viewportWidth = Math.max(1, canvas.clientWidth || 1);
                const viewportHeight = Math.max(1, canvas.clientHeight || 1);
                const viewScale = getViewScale(viewportWidth, viewportHeight);
                const focalLength = viewScale / (2 * Math.tan(FOV_RAD / 2));
                const horizontalLimit = viewportWidth * 0.43;
                const verticalLimit = viewportHeight * 0.38;
                const fittedDistance = sceneBoundsPoints.reduce((distance, point) => {
                    const rotated = rotatePoint(point.x, point.y, point.z);
                    const horizontalDistance = (Math.abs(rotated.x) * focalLength / horizontalLimit) - rotated.z;
                    const verticalDistance = (Math.abs(rotated.y) * focalLength / verticalLimit) - rotated.z;
                    return Math.max(distance, horizontalDistance, verticalDistance);
                }, modelRadius * 1.05);
                const nearestDistance = Math.max(modelRadius * 0.55, fittedDistance * 0.2);
                const zoomFactor = getZoomFactor();
                return zoomFactor < 1
                    ? nearestDistance + ((fittedDistance - nearestDistance) * zoomFactor)
                    : fittedDistance * zoomFactor;
            };

            const project = (p, viewScale, cx, cy) => {
                const camDist = getCameraDistance();
                const eyeZ = p.z + camDist;
                // Proper perspective: focalLength derived from fixed FOV
                const focalLength = viewScale / (2 * Math.tan(FOV_RAD / 2));
                const depth = Math.max(0.01, eyeZ);
                const scale = focalLength / depth;
                return {
                    x: cx + (p.x * scale) + (Number(s.panX) || 0),
                    y: cy - (p.y * scale) + (Number(s.panY) || 0)
                };
            };

            const getViewScale = (viewportW, viewportH) => {
                // viewScale = viewport size in pixels; project() converts world→screen via focalLength/depth
                return Math.min(viewportW, viewportH);
            };

            const drawLine3D = (a, b, viewScale, cx, cy, color, width = 1, alpha = 1) => {
                const pa = project(rotatePoint(a.x, a.y, a.z), viewScale, cx, cy);
                const pb = project(rotatePoint(b.x, b.y, b.z), viewScale, cx, cy);
                ctx.save();
                ctx.globalAlpha = alpha;
                ctx.strokeStyle = color;
                ctx.lineWidth = width;
                ctx.beginPath();
                ctx.moveTo(pa.x, pa.y);
                ctx.lineTo(pb.x, pb.y);
                ctx.stroke();
                ctx.restore();
            };

            const drawQuad3D = (p1, p2, p3, p4, viewScale, cx, cy, fillColor, strokeColor = null, strokeWidth = 1, alpha = 1) => {
                const a = project(rotatePoint(p1.x, p1.y, p1.z), viewScale, cx, cy);
                const b = project(rotatePoint(p2.x, p2.y, p2.z), viewScale, cx, cy);
                const c = project(rotatePoint(p3.x, p3.y, p3.z), viewScale, cx, cy);
                const d = project(rotatePoint(p4.x, p4.y, p4.z), viewScale, cx, cy);
                ctx.save();
                ctx.globalAlpha = alpha;
                if (fillColor) {
                    ctx.fillStyle = fillColor;
                    ctx.beginPath();
                    ctx.moveTo(a.x, a.y);
                    ctx.lineTo(b.x, b.y);
                    ctx.lineTo(c.x, c.y);
                    ctx.lineTo(d.x, d.y);
                    ctx.closePath();
                    ctx.fill();
                }
                if (strokeColor) {
                    ctx.strokeStyle = strokeColor;
                    ctx.lineWidth = strokeWidth;
                    ctx.beginPath();
                    ctx.moveTo(a.x, a.y);
                    ctx.lineTo(b.x, b.y);
                    ctx.lineTo(c.x, c.y);
                    ctx.lineTo(d.x, d.y);
                    ctx.closePath();
                    ctx.stroke();
                }
                ctx.restore();
            };

            const sampleUvColor = (texture, u, v) => {
                if (!texture || !texture.data || texture.width < 1 || texture.height < 1) return null;
                const x = Math.max(0, Math.min(texture.width - 1, Math.round(u * (texture.width - 1))));
                const y = Math.max(0, Math.min(texture.height - 1, Math.round(v * (texture.height - 1))));
                const idx = (y * texture.width + x) * 4;
                const data = texture.data;
                return `rgb(${data[idx] || 0}, ${data[idx + 1] || 0}, ${data[idx + 2] || 0})`;
            };

            const pointInPolygon2D = (pt, poly) => {
                let inside = false;
                for (let i = 0, j = poly.length - 1; i < poly.length; j = i++) {
                    const xi = poly[i].x, yi = poly[i].y, xj = poly[j].x, yj = poly[j].y;
                    const intersects = ((yi > pt.y) !== (yj > pt.y)) && (pt.x < (((xj - xi) * (pt.y - yi)) / ((yj - yi) || 1e-6)) + xi);
                    if (intersects) inside = !inside;
                }
                return inside;
            };

            const mapHitRegions = [];
            const stageHitRegions = [];
            const gizmoHitAreas = [];
            const mapGeomById = new Map();

            const drawScene = ({ hideHelpers = false } = {}) => {
                const w = canvas.clientWidth || 1;
                const h = canvas.clientHeight || 1;
                const bg = ctx.createLinearGradient(0, 0, 0, h);
                bg.addColorStop(0, s.backgroundTopColor);
                bg.addColorStop(1, s.backgroundBottomColor);
                ctx.fillStyle = bg;
                ctx.fillRect(0, 0, w, h);

                const cx = w / 2;
                const cy = h / 2;
                const fitPoints = [];
                mapGeomById.clear();
                mapRenderData.forEach((m) => {
                    const geom = buildMapGeometry(m);
                    mapGeomById.set(String(m.id), geom);
                    fitPoints.push(...geom.front, ...geom.back);
                });
                if (!fitPoints.length) fitPoints.push({ x: -1, y: 1, z: 1 }, { x: 1, y: 1, z: 1 }, { x: 1, y: -1, z: 1 }, { x: -1, y: -1, z: 1 });
                const viewScale = getViewScale(w, h);

                mapHitRegions.length = 0;
                stageHitRegions.length = 0;
                if (s.showGrid) {
                    const gridStep = Math.max(0.1, Number(s.gridSizeM) || 1);
                    const GRID_LINES = 14;
                    const halfSpan = GRID_LINES * gridStep;

                    // Hard scissor: clip all grid drawing to the lower 62% of the canvas.
                    // This is the only reliable way to prevent lines from shooting toward
                    // the vanishing point regardless of camera rotation angle.
                    const clipTop = h * 0.38;
                    ctx.save();
                    ctx.beginPath();
                    ctx.rect(0, clipTop, w, h - clipTop);
                    ctx.clip();

                    const batches = [
                        { color: s.gridMinorColor, baseAlpha: 0.18, width: 0.6, isMajor: false },
                        { color: s.gridMajorColor, baseAlpha: 0.38, width: 0.9, isMajor: true }
                    ];
                    batches.forEach((batch) => {
                        for (let i = -GRID_LINES; i <= GRID_LINES; i++) {
                            if (batch.isMajor ? (i % 5 !== 0) : (i % 5 === 0)) continue;
                            const distFrac = Math.abs(i) / GRID_LINES;
                            if (distFrac > 0.95) continue;
                            const fadedAlpha = batch.baseAlpha * (1 - distFrac * 0.85);
                            const pos = i * gridStep;
                            ctx.beginPath();
                            ctx.strokeStyle = batch.color;
                            ctx.globalAlpha = fadedAlpha * Math.max(0, Math.min(1.5, Number(s.gridOpacity) / 100));
                            ctx.lineWidth = batch.width;
                            const a1 = project(rotatePoint(pos, floorY, -halfSpan), viewScale, cx, cy);
                            const b1 = project(rotatePoint(pos, floorY, halfSpan), viewScale, cx, cy);
                            ctx.moveTo(Math.round(a1.x) + 0.5, Math.round(a1.y) + 0.5);
                            ctx.lineTo(Math.round(b1.x) + 0.5, Math.round(b1.y) + 0.5);
                            ctx.stroke();
                            ctx.beginPath();
                            ctx.strokeStyle = batch.color;
                            const a2 = project(rotatePoint(-halfSpan, floorY, pos), viewScale, cx, cy);
                            const b2 = project(rotatePoint(halfSpan, floorY, pos), viewScale, cx, cy);
                            ctx.moveTo(Math.round(a2.x) + 0.5, Math.round(a2.y) + 0.5);
                            ctx.lineTo(Math.round(b2.x) + 0.5, Math.round(b2.y) + 0.5);
                            ctx.stroke();
                        }
                    });
                    ctx.restore(); // release scissor clip
                    // Grid scale indicator
                    ctx.save();
                    ctx.font = '10px Inter, system-ui, sans-serif';
                    ctx.fillStyle = '#64748b';
                    ctx.textAlign = 'left';
                    ctx.textBaseline = 'bottom';
                    ctx.fillText(`Grid: ${gridStep}m`, 8, h - 6);
                    ctx.restore();
                }

                stageObjects.forEach((object) => {
                    const geometry = buildStageGeometry(object);
                    const p = geometry.points;
                    const isSelected = String(object.id) === String(s.selectedStageObjectId || '');
                    const projectedFaces = [
                        { points: [p[0], p[1], p[2], p[3]], color: shadeHexColor(object.color, -22) },
                        { points: [p[4], p[5], p[6], p[7]], color: shadeHexColor(object.color, -34) },
                        { points: [p[0], p[1], p[5], p[4]], color: shadeHexColor(object.color, 38), top: true },
                        { points: [p[1], p[2], p[6], p[5]], color: shadeHexColor(object.color, -8) },
                        { points: [p[2], p[3], p[7], p[6]], color: shadeHexColor(object.color, -28) },
                        { points: [p[3], p[0], p[4], p[7]], color: shadeHexColor(object.color, 8) }
                    ].map((face) => ({
                        ...face,
                        depth: face.points.reduce((sum, point) => sum + rotatePoint(point.x, point.y, point.z).z, 0) / 4
                    })).sort((a, b) => b.depth - a.depth);
                    projectedFaces.forEach((face) => drawQuad3D(face.points[0], face.points[1], face.points[2], face.points[3], viewScale, cx, cy, face.color, isSelected ? '#f59e0b' : '#64748b', isSelected ? 2 : 1, 1));
                    projectedFaces.forEach((face) => {
                        const points = face.points;
                        const poly = points.map((point) => project(rotatePoint(point.x, point.y, point.z), viewScale, cx, cy));
                        const depth = face.depth;
                        stageHitRegions.push({ id: String(object.id), poly, depth });
                    });
                    const topFace = projectedFaces.find((face) => face.top);
                    if (topFace) {
                        const top = topFace.points;
                        const depthDivisions = Math.max(1, Math.min(20, Math.round(Number(object.depth) || 1)));
                        const widthDivisions = Math.max(1, Math.min(30, Math.round(Number(object.width) || 1)));
                        for (let division = 1; division < depthDivisions; division++) {
                            const ratio = division / depthDivisions;
                            drawLine3D(lerpPoint3(top[0], top[3], ratio), lerpPoint3(top[1], top[2], ratio), viewScale, cx, cy, '#94a3b8', 0.7, 0.42);
                        }
                        for (let division = 1; division < widthDivisions; division++) {
                            const ratio = division / widthDivisions;
                            drawLine3D(lerpPoint3(top[0], top[1], ratio), lerpPoint3(top[3], top[2], ratio), viewScale, cx, cy, '#94a3b8', 0.65, 0.32);
                        }
                        drawLine3D(top[0], top[1], viewScale, cx, cy, '#e2e8f0', 1.4, 0.8);
                        drawLine3D(top[1], top[2], viewScale, cx, cy, '#cbd5e1', 1.2, 0.65);
                        drawLine3D(top[2], top[3], viewScale, cx, cy, '#64748b', 1.2, 0.65);
                        drawLine3D(top[3], top[0], viewScale, cx, cy, '#cbd5e1', 1.2, 0.65);
                    }
                    const frontBottomCenter = {
                        x: (p[2].x + p[3].x) / 2,
                        y: (p[2].y + p[3].y) / 2,
                        z: (p[2].z + p[3].z) / 2
                    };
                    const anchorPoint = project(rotatePoint(frontBottomCenter.x, frontBottomCenter.y, frontBottomCenter.z), viewScale, cx, cy);
                    const stageName = String(object.name || 'Stage');
                    const stageSize = `${Number(object.width).toFixed(1)}m W x ${Number(object.depth).toFixed(1)}m D x ${Number(object.height).toFixed(1)}m H`;
                    ctx.save();
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'top';
                    ctx.font = 'bold 12px Inter, system-ui, sans-serif';
                    const nameWidth = ctx.measureText(stageName).width;
                    ctx.font = '11px Inter, system-ui, sans-serif';
                    const sizeWidth = ctx.measureText(stageSize).width;
                    const boxWidth = Math.max(nameWidth, sizeWidth) + 16;
                    const boxHeight = 38;
                    const labelX = Math.max(boxWidth / 2 + 6, Math.min(w - boxWidth / 2 - 6, anchorPoint.x));
                    const labelY = Math.max(6, Math.min(h - boxHeight - 6, anchorPoint.y + 12));
                    ctx.strokeStyle = isSelected ? '#f59e0b' : '#64748b';
                    ctx.fillStyle = 'rgba(2,6,23,0.92)';
                    ctx.lineWidth = isSelected ? 2 : 1;
                    ctx.beginPath();
                    ctx.roundRect(labelX - boxWidth / 2, labelY, boxWidth, boxHeight, 4);
                    ctx.fill();
                    ctx.stroke();
                    ctx.font = 'bold 12px Inter, system-ui, sans-serif';
                    ctx.fillStyle = isSelected ? '#fbbf24' : '#f8fafc';
                    ctx.fillText(stageName, labelX, labelY + 5);
                    ctx.font = '11px Inter, system-ui, sans-serif';
                    ctx.fillStyle = '#cbd5e1';
                    ctx.fillText(stageSize, labelX, labelY + 21);
                    ctx.restore();
                });

                mapRenderData.forEach((m) => {
                    const geom = mapGeomById.get(String(m.id));
                    if (!geom) return;
                    const front = geom.front;
                    const back = geom.back;
                    const isSelected = String(m.id) === String(s.selectedMapId || '');
                    const frontProjected = front.map((p) => project(rotatePoint(p.x, p.y, p.z), viewScale, cx, cy));
                    const frontDepth = front.reduce((sum, p) => sum + rotatePoint(p.x, p.y, p.z).z, 0) / front.length;
                    mapHitRegions.push({ id: String(m.id), poly: frontProjected, depth: frontDepth });

                    const tex = uvTextureByMapId.get(String(m.id));
                    if (s.showUV && tex && tex.canvas) {
                        // High quality UV: drawImage with perspective-corrected affine strips
                        const alpha = Math.max(0.1, Math.min(1, (Number(s.uvOpacity) || 82) / 100));
                        const strips = 24;
                        const vStrips = 18;
                        const dpr = window.devicePixelRatio || 1;
                        ctx.save();
                        ctx.globalAlpha = alpha;
                        ctx.imageSmoothingEnabled = true;
                        ctx.imageSmoothingQuality = 'high';
                        for (let vy = 0; vy < vStrips; vy++) {
                            const vt0 = vy / vStrips;
                            const vt1 = (vy + 1) / vStrips;
                            const rowTopL = lerpPoint3(front[0], front[3], vt0);
                            const rowTopR = lerpPoint3(front[1], front[2], vt0);
                            const rowBotL = lerpPoint3(front[0], front[3], vt1);
                            const rowBotR = lerpPoint3(front[1], front[2], vt1);
                            for (let vx = 0; vx < strips; vx++) {
                                const ut0 = vx / strips;
                                const ut1 = (vx + 1) / strips;
                                const tl = lerpPoint3(rowTopL, rowTopR, ut0);
                                const tr = lerpPoint3(rowTopL, rowTopR, ut1);
                                const br = lerpPoint3(rowBotL, rowBotR, ut1);
                                const bl = lerpPoint3(rowBotL, rowBotR, ut0);
                                const pTL = project(rotatePoint(tl.x, tl.y, tl.z), viewScale, cx, cy);
                                const pTR = project(rotatePoint(tr.x, tr.y, tr.z), viewScale, cx, cy);
                                const pBR = project(rotatePoint(br.x, br.y, br.z), viewScale, cx, cy);
                                const pBL = project(rotatePoint(bl.x, bl.y, bl.z), viewScale, cx, cy);
                                const sx = Math.floor(ut0 * tex.width);
                                const sy = Math.floor(vt0 * tex.height);
                                const sw = Math.max(1, Math.ceil(ut1 * tex.width) - sx);
                                const sh = Math.max(1, Math.ceil(vt1 * tex.height) - sy);
                                ctx.save();
                                ctx.beginPath();
                                ctx.moveTo(pTL.x, pTL.y);
                                ctx.lineTo(pTR.x, pTR.y);
                                ctx.lineTo(pBR.x, pBR.y);
                                ctx.lineTo(pBL.x, pBL.y);
                                ctx.closePath();
                                ctx.clip();
                                // Affine transform accounting for DPR: canvas physical coords = CSS coords * dpr
                                const dxA = pTR.x - pTL.x, dyA = pTR.y - pTL.y;
                                const dxB = pBL.x - pTL.x, dyB = pBL.y - pTL.y;
                                ctx.setTransform(
                                    dxA / sw * dpr, dyA / sw * dpr,
                                    dxB / sh * dpr, dyB / sh * dpr,
                                    pTL.x * dpr, pTL.y * dpr
                                );
                                ctx.drawImage(tex.canvas, sx, sy, sw, sh, 0, 0, sw, sh);
                                ctx.restore();
                            }
                        }
                        ctx.restore();
                    } else if (s.showUV && tex) {
                        // Fallback: pixel-sample approach for when canvas is missing
                        const alpha = Math.max(0.1, Math.min(1, (Number(s.uvOpacity) || 82) / 100));
                        const uSteps = 24, vSteps = 16;
                        for (let yi = 0; yi < vSteps; yi++) {
                            const v0 = yi / vSteps, v1 = (yi + 1) / vSteps;
                            const lt = lerpPoint3(front[0], front[3], v0), rt = lerpPoint3(front[1], front[2], v0);
                            const lb = lerpPoint3(front[0], front[3], v1), rb = lerpPoint3(front[1], front[2], v1);
                            for (let xi = 0; xi < uSteps; xi++) {
                                const u0 = xi / uSteps, u1 = (xi + 1) / uSteps;
                                const color = sampleUvColor(tex, (u0 + u1) * 0.5, (v0 + v1) * 0.5) || '#1e293b';
                                drawQuad3D(lerpPoint3(lt, rt, u0), lerpPoint3(lt, rt, u1), lerpPoint3(lb, rb, u1), lerpPoint3(lb, rb, u0), viewScale, cx, cy, color, null, 0, alpha);
                            }
                        }
                    } else {
                        drawQuad3D(front[0], front[1], front[2], front[3], viewScale, cx, cy, '#0f172a', null, 0, 0.7);
                    }

                    drawQuad3D(back[0], back[1], back[2], back[3], viewScale, cx, cy, '#0a1324', null, 0, 0.35);
                    const edges = [[0, 1], [1, 2], [2, 3], [3, 0]];
                    edges.forEach(([a, b]) => drawLine3D(front[a], front[b], viewScale, cx, cy, '#7dd3fc', 2, 0.95));
                    edges.forEach(([a, b]) => drawLine3D(back[a], back[b], viewScale, cx, cy, '#334155', 1.4, 0.8));
                    for (let i = 0; i < 4; i++) drawLine3D(front[i], back[i], viewScale, cx, cy, '#475569', 1.3, 0.8);

                    if (isSelected) drawQuad3D(front[0], front[1], front[2], front[3], viewScale, cx, cy, null, '#f59e0b', 2.4, 1);

                    // Consolidated map details callout
                    const scale = Math.max(0.2, Math.min(3, Number(m.transform?.scale) || 1));
                    const mapW = (m.widthM * scale).toFixed(2);
                    const mapH = (m.heightM * scale).toFixed(2);
                    const topMid = project(rotatePoint(
                        (front[0].x + front[1].x) / 2,
                        (front[0].y + front[1].y) / 2 + 0.06,
                        (front[0].z + front[1].z) / 2
                    ), viewScale, cx, cy);
                    const nameLabel = String(m.map.name || `Map ${m.id}`);
                    const sizeLabel = `${mapW}m W x ${mapH}m H`;
                    const pixelLabel = `${Math.round(Number(m.calcs?.totalResWidth) || 0)} x ${Math.round(Number(m.calcs?.totalResHeight) || 0)} px`;
                    ctx.save();
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'top';
                    ctx.font = 'bold 12px Inter, system-ui, sans-serif';
                    const nameWidth = ctx.measureText(nameLabel).width;
                    ctx.font = '11px Inter, system-ui, sans-serif';
                    const sizeWidth = ctx.measureText(sizeLabel).width;
                    const pixelWidth = ctx.measureText(pixelLabel).width;
                    const boxWidth = Math.max(nameWidth, sizeWidth, pixelWidth) + 16;
                    const boxHeight = 52;
                    const labelX = Math.max(boxWidth / 2 + 6, Math.min(w - boxWidth / 2 - 6, topMid.x));
                    const labelY = Math.max(6, Math.min(h - boxHeight - 6, topMid.y - boxHeight - 10));
                    ctx.strokeStyle = isSelected ? '#f59e0b' : s.labelAccentColor;
                    ctx.fillStyle = 'rgba(2,6,23,0.92)';
                    ctx.lineWidth = isSelected ? 2 : 1;
                    ctx.beginPath();
                    ctx.roundRect(labelX - boxWidth / 2, labelY, boxWidth, boxHeight, 4);
                    ctx.fill();
                    ctx.stroke();
                    ctx.font = 'bold 12px Inter, system-ui, sans-serif';
                    ctx.fillStyle = isSelected ? '#fbbf24' : '#f8fafc';
                    ctx.fillText(nameLabel, labelX, labelY + 5);
                    ctx.font = '11px Inter, system-ui, sans-serif';
                    ctx.fillStyle = s.labelAccentColor;
                    ctx.fillText(sizeLabel, labelX, labelY + 21);
                    ctx.fillStyle = '#cbd5e1';
                    ctx.fillText(pixelLabel, labelX, labelY + 36);
                    ctx.restore();
                });

                // Draw distance lines: each object to its nearest neighbor (unique pairs only)
                if (mapRenderData.length > 1) {
                    ctx.save();
                    ctx.font = 'bold 10px Inter, system-ui, sans-serif';
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'bottom';

                    const drawMeasure = (p1, p2, label, color) => {
                        ctx.setLineDash([4, 4]);
                        ctx.strokeStyle = color; ctx.lineWidth = 1.2; ctx.globalAlpha = 0.7;
                        ctx.beginPath(); ctx.moveTo(p1.x, p1.y); ctx.lineTo(p2.x, p2.y); ctx.stroke();
                        ctx.setLineDash([]);
                        const mx = (p1.x + p2.x) / 2, my = (p1.y + p2.y) / 2;
                        const dm = ctx.measureText(label);
                        ctx.globalAlpha = 1;
                        ctx.fillStyle = 'rgba(0,0,0,0.8)';
                        ctx.fillRect(mx - dm.width / 2 - 5, my - 18, dm.width + 10, 17);
                        ctx.fillStyle = color;
                        ctx.fillText(label, mx, my - 3);
                    };

                    // Precompute 3D centers for all maps
                    const mapCenters = mapRenderData.map((m) => {
                        const g = mapGeomById.get(String(m.id));
                        const c = { x: 0, y: 0, z: 0 };
                        if (g) g.front.forEach(p => { c.x += p.x / 4; c.y += p.y / 4; c.z += p.z / 4; });
                        return { id: String(m.id), c, g };
                    });

                    // For each map find nearest neighbor; collect unique pairs by sorted id key
                    const drawnPairs = new Set();
                    mapCenters.forEach((a, ai) => {
                        let bestDist = Infinity, bestIdx = -1;
                        mapCenters.forEach((b, bi) => {
                            if (ai === bi) return;
                            const d = Math.sqrt((b.c.x-a.c.x)**2 + (b.c.y-a.c.y)**2 + (b.c.z-a.c.z)**2);
                            if (d < bestDist) { bestDist = d; bestIdx = bi; }
                        });
                        if (bestIdx === -1) return;
                        const pairKey = [ai, bestIdx].sort((x,y)=>x-y).join('-');
                        if (drawnPairs.has(pairKey)) return;
                        drawnPairs.add(pairKey);

                        const { c: cA, g: gA } = a;
                        const { c: cB, g: gB } = mapCenters[bestIdx];
                        if (!gA || !gB) return;

                        // --- Horizontal gap (XZ plane, yellow) ---
                        const hx = cB.x - cA.x, hz = cB.z - cA.z;
                        const hLen = Math.sqrt(hx * hx + hz * hz);
                        if (hLen > 0.05) {
                            const hDir = { x: hx / hLen, z: hz / hLen };
                            const prjAh = gA.front.map(p => ({ p, d: p.x * hDir.x + p.z * hDir.z })).sort((a, b) => b.d - a.d);
                            const edgeAh = { x: (prjAh[0].p.x + prjAh[1].p.x) / 2, y: (prjAh[0].p.y + prjAh[1].p.y) / 2, z: (prjAh[0].p.z + prjAh[1].p.z) / 2 };
                            const prjBh = gB.front.map(p => ({ p, d: p.x * hDir.x + p.z * hDir.z })).sort((a, b) => a.d - b.d);
                            const edgeBh = { x: (prjBh[0].p.x + prjBh[1].p.x) / 2, y: (prjBh[0].p.y + prjBh[1].p.y) / 2, z: (prjBh[0].p.z + prjBh[1].p.z) / 2 };
                            const hDist = Math.sqrt((edgeBh.x - edgeAh.x) ** 2 + (edgeBh.z - edgeAh.z) ** 2);
                            if (hDist > 0.01) {
                                const pA = project(rotatePoint(edgeAh.x, edgeAh.y, edgeAh.z), viewScale, cx, cy);
                                const pB = project(rotatePoint(edgeBh.x, edgeBh.y, edgeBh.z), viewScale, cx, cy);
                                drawMeasure(pA, pB, hDist.toFixed(2) + 'm', '#fbbf24');
                            }
                        }

                        // --- Vertical gap (Y axis, cyan) — only when a real clear gap exists ---
                        const vDiff = cB.y - cA.y;
                        if (Math.abs(vDiff) > 0.05) {
                            const lowerG = vDiff > 0 ? gA : gB;
                            const upperG = vDiff > 0 ? gB : gA;
                            const topLower = [...lowerG.front].sort((a, b) => b.y - a.y).slice(0, 2);
                            const topPt = { x: (topLower[0].x + topLower[1].x) / 2, y: (topLower[0].y + topLower[1].y) / 2, z: (topLower[0].z + topLower[1].z) / 2 };
                            const botUpper = [...upperG.front].sort((a, b) => a.y - b.y).slice(0, 2);
                            const botPt = { x: (botUpper[0].x + botUpper[1].x) / 2, y: (botUpper[0].y + botUpper[1].y) / 2, z: (botUpper[0].z + botUpper[1].z) / 2 };
                            const vGap = botPt.y - topPt.y;
                            if (vGap > 0.01) {
                                const pTop = project(rotatePoint(topPt.x, topPt.y, topPt.z), viewScale, cx, cy);
                                const pBot = project(rotatePoint(botPt.x, botPt.y, botPt.z), viewScale, cx, cy);
                                drawMeasure(pTop, pBot, vGap.toFixed(2) + 'm', '#67e8f9');
                            }
                        }
                    });
                    ctx.restore();
                }

                if (s.showAxes && !hideHelpers) {
                    const axisLen = Math.max(totalWidthM, totalHeightM, wallDepthM) * 0.9;
                    drawLine3D({ x: 0, y: 0, z: 0 }, { x: axisLen, y: 0, z: 0 }, viewScale, cx, cy, '#ef4444', 2.2, 0.95);
                    drawLine3D({ x: 0, y: 0, z: 0 }, { x: 0, y: axisLen, z: 0 }, viewScale, cx, cy, '#22c55e', 2.2, 0.95);
                    drawLine3D({ x: 0, y: 0, z: 0 }, { x: 0, y: 0, z: axisLen }, viewScale, cx, cy, '#3b82f6', 2.2, 0.95);
                    // Axis labels
                    const xEnd = project(rotatePoint(axisLen + 0.08, 0, 0), viewScale, cx, cy);
                    const yEnd = project(rotatePoint(0, axisLen + 0.08, 0), viewScale, cx, cy);
                    const zEnd = project(rotatePoint(0, 0, axisLen + 0.08), viewScale, cx, cy);
                    ctx.save();
                    ctx.font = 'bold 12px Inter, system-ui, sans-serif';
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'middle';
                    ctx.fillStyle = '#ef4444'; ctx.fillText('X', xEnd.x, xEnd.y);
                    ctx.fillStyle = '#22c55e'; ctx.fillText('Y', yEnd.x, yEnd.y);
                    ctx.fillStyle = '#3b82f6'; ctx.fillText('Z', zEnd.x, zEnd.y);
                    ctx.restore();
                }

                // Draw manipulation gizmo on selected map
                const selMap = mapRenderData.find((m) => String(m.id) === String(s.selectedMapId || ''));
                if (selMap && s.toolMode !== 'orbit' && !hideHelpers) {
                    const selGeom = mapGeomById.get(String(selMap.id));
                    if (selGeom) {
                        const cf = selGeom.front;
                        const gizCenter = {
                            x: (cf[0].x + cf[1].x + cf[2].x + cf[3].x) / 4,
                            y: (cf[0].y + cf[1].y + cf[2].y + cf[3].y) / 4,
                            z: (cf[0].z + cf[1].z + cf[2].z + cf[3].z) / 4
                        };
                        const gizScale = Math.max(selMap.widthM, selMap.heightM) * 0.4;
                        gizmoHitAreas.length = 0;
                        const gO = project(rotatePoint(gizCenter.x, gizCenter.y, gizCenter.z), viewScale, cx, cy);

                        if (s.toolMode === 'move') {
                            // Move arrows: X (red), Y (green), Z (blue)
                            const gXEnd = project(rotatePoint(gizCenter.x + gizScale, gizCenter.y, gizCenter.z), viewScale, cx, cy);
                            const gYEnd = project(rotatePoint(gizCenter.x, gizCenter.y + gizScale, gizCenter.z), viewScale, cx, cy);
                            const gZEnd = project(rotatePoint(gizCenter.x, gizCenter.y, gizCenter.z + gizScale), viewScale, cx, cy);
                            const drawArrow = (from, to, color, axis) => {
                                ctx.save();
                                ctx.strokeStyle = color; ctx.lineWidth = 3; ctx.globalAlpha = 0.9;
                                ctx.beginPath(); ctx.moveTo(from.x, from.y); ctx.lineTo(to.x, to.y); ctx.stroke();
                                // Arrowhead
                                const angle = Math.atan2(to.y - from.y, to.x - from.x);
                                ctx.fillStyle = color;
                                ctx.beginPath();
                                ctx.moveTo(to.x, to.y);
                                ctx.lineTo(to.x - 10 * Math.cos(angle - 0.4), to.y - 10 * Math.sin(angle - 0.4));
                                ctx.lineTo(to.x - 10 * Math.cos(angle + 0.4), to.y - 10 * Math.sin(angle + 0.4));
                                ctx.closePath(); ctx.fill();
                                // Axis label
                                ctx.font = 'bold 11px Inter, system-ui, sans-serif';
                                ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
                                ctx.fillStyle = color;
                                ctx.fillText(axis, to.x + 14 * Math.cos(angle), to.y + 14 * Math.sin(angle));
                                ctx.restore();
                                gizmoHitAreas.push({ axis, from, to, radius: 12 });
                            };
                            drawArrow(gO, gXEnd, '#ef4444', 'X');
                            drawArrow(gO, gYEnd, '#22c55e', 'Y');
                            drawArrow(gO, gZEnd, '#3b82f6', 'Z');
                            // Center square for free movement across the visible wall plane
                            const sqSize = 8;
                            ctx.save();
                            ctx.fillStyle = 'rgba(250,204,21,0.5)';
                            ctx.fillRect(gO.x - sqSize, gO.y - sqSize, sqSize * 2, sqSize * 2);
                            ctx.strokeStyle = '#facc15'; ctx.lineWidth = 1.5;
                            ctx.strokeRect(gO.x - sqSize, gO.y - sqSize, sqSize * 2, sqSize * 2);
                            ctx.restore();
                            gizmoHitAreas.push({ axis: 'XY', from: { x: gO.x - sqSize, y: gO.y - sqSize }, to: { x: gO.x + sqSize, y: gO.y + sqSize }, radius: sqSize, isRect: true });
                        } else if (s.toolMode === 'rotate') {
                            // 3-axis rotation rings like Blender: X=red (YZ plane), Y=green (XZ plane), Z=blue (XY plane)
                            const ringPoints = 48;
                            const drawRing = (color, axis, radiusMul, getWorldPt) => {
                                const r3d = gizScale * radiusMul;
                                // Sample one point to estimate screen ring radius for hit testing
                                const sampleW = getWorldPt(0, r3d);
                                const sampleP = project(rotatePoint(sampleW.x, sampleW.y, sampleW.z), viewScale, cx, cy);
                                const screenR = Math.max(10, Math.sqrt((sampleP.x - gO.x) ** 2 + (sampleP.y - gO.y) ** 2));
                                ctx.save();
                                ctx.strokeStyle = color; ctx.lineWidth = 2.5; ctx.globalAlpha = 0.85;
                                ctx.beginPath();
                                for (let ri = 0; ri <= ringPoints; ri++) {
                                    const a = (ri / ringPoints) * Math.PI * 2;
                                    const wp = getWorldPt(a, r3d);
                                    const rp = project(rotatePoint(wp.x, wp.y, wp.z), viewScale, cx, cy);
                                    if (ri === 0) ctx.moveTo(rp.x, rp.y); else ctx.lineTo(rp.x, rp.y);
                                }
                                ctx.stroke();
                                // Draw axis label near ring
                                ctx.font = 'bold 11px Inter, system-ui, sans-serif';
                                ctx.fillStyle = color; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
                                ctx.fillText(axis, sampleP.x + 10, sampleP.y - 10);
                                ctx.restore();
                                gizmoHitAreas.push({ axis: 'rot' + axis, center: gO, ringRadius: screenR, ringTolerance: 14 });
                            };
                            // X ring (red) — in YZ plane, rotates object around X axis
                            drawRing('#ef4444', 'X', 0.9, (a, r) => ({ x: gizCenter.x, y: gizCenter.y + Math.cos(a) * r, z: gizCenter.z + Math.sin(a) * r }));
                            // Y ring (green) — in XZ plane, rotates object around Y axis
                            drawRing('#22c55e', 'Y', 0.75, (a, r) => ({ x: gizCenter.x + Math.cos(a) * r, y: gizCenter.y, z: gizCenter.z + Math.sin(a) * r }));
                            // Z ring (blue) — in XY plane, rotates object around Z axis
                            drawRing('#3b82f6', 'Z', 0.6, (a, r) => ({ x: gizCenter.x + Math.cos(a) * r, y: gizCenter.y + Math.sin(a) * r, z: gizCenter.z }));
                        } else if (s.toolMode === 'scale') {
                            // Scale handles at corners
                            const corners = [cf[0], cf[1], cf[2], cf[3]];
                            const boxSize = 5;
                            corners.forEach((corner, ci) => {
                                const cp = project(rotatePoint(corner.x, corner.y, corner.z), viewScale, cx, cy);
                                ctx.save();
                                ctx.fillStyle = '#facc15'; ctx.globalAlpha = 0.9;
                                ctx.fillRect(cp.x - boxSize, cp.y - boxSize, boxSize * 2, boxSize * 2);
                                ctx.strokeStyle = '#fbbf24'; ctx.lineWidth = 1;
                                ctx.strokeRect(cp.x - boxSize, cp.y - boxSize, boxSize * 2, boxSize * 2);
                                ctx.restore();
                                gizmoHitAreas.push({ axis: 'scale', center: cp, radius: boxSize + 4, cornerIdx: ci });
                            });
                            // Center uniform scale handle
                            ctx.save();
                            ctx.fillStyle = 'rgba(250,204,21,0.4)';
                            ctx.strokeStyle = '#facc15'; ctx.lineWidth = 1.5;
                            const scBox = 7;
                            ctx.fillRect(gO.x - scBox, gO.y - scBox, scBox * 2, scBox * 2);
                            ctx.strokeRect(gO.x - scBox, gO.y - scBox, scBox * 2, scBox * 2);
                            ctx.restore();
                            gizmoHitAreas.push({ axis: 'scale', center: gO, radius: scBox + 4 });
                        }
                    }
                }
            };

            const setToolMode = (mode) => {
                const allowed = new Set(['orbit', 'pan', 'move', 'rotate', 'scale']);
                s.toolMode = allowed.has(mode) ? mode : 'orbit';
                container.querySelectorAll('.view3d-tool-btn').forEach((btn) => {
                    const active = String(btn.getAttribute('data-tool') || '') === String(s.toolMode);
                    btn.classList.toggle('bg-cyan-700', active);
                    btn.classList.toggle('hover:bg-cyan-600', active);
                    btn.classList.toggle('text-white', active);
                    btn.classList.toggle('bg-gray-800', !active);
                    btn.classList.toggle('hover:bg-gray-700', !active);
                    btn.classList.toggle('text-gray-100', !active);
                });
            };

            const getMapAtCanvasPoint = (clientX, clientY) => {
                const rect = canvas.getBoundingClientRect();
                const pt = { x: clientX - rect.left, y: clientY - rect.top };
                const hits = mapHitRegions.filter((h) => pointInPolygon2D(pt, h.poly));
                if (!hits.length) return null;
                hits.sort((a, b) => b.depth - a.depth);
                return hits[0].id;
            };

            const getStageAtCanvasPoint = (clientX, clientY) => {
                const rect = canvas.getBoundingClientRect();
                const point = { x: clientX - rect.left, y: clientY - rect.top };
                const hits = stageHitRegions.filter((hit) => pointInPolygon2D(point, hit.poly));
                if (!hits.length) return null;
                hits.sort((a, b) => b.depth - a.depth);
                return hits[0].id;
            };

            const ensureSelectedTransform = () => {
                const id = String(s.selectedMapId || '');
                if (!id) return null;
                if (!s.mapTransforms[id]) s.mapTransforms[id] = { x: 0, y: 0, z: 0, rotY: 0, rotX: 0, rotZ: 0, scale: 1 };
                if (s.mapTransforms[id].y === undefined) s.mapTransforms[id].y = 0;
                if (s.mapTransforms[id].rotX === undefined) s.mapTransforms[id].rotX = 0;
                if (s.mapTransforms[id].rotZ === undefined) s.mapTransforms[id].rotZ = 0;
                return s.mapTransforms[id];
            };

            const syncUi = () => {
                const setTxt = (id, value) => { const el = document.getElementById(id); if (el) el.textContent = value; };
                const setVal = (id, value) => { const el = document.getElementById(id); if (el) el.value = String(value); };
                const setChecked = (id, v) => { const el = document.getElementById(id); if (el) el.checked = !!v; };
                const selected = mapRenderData.find((m) => String(m.id) === String(s.selectedMapId || ''));
                setTxt('view3d-selected-map', selected ? (selected.map.name || `Map ${selected.id}`) : 'None');
                setVal('view3d-uv-opacity', Math.round(Number(s.uvOpacity) || 82));
                setVal('view3d-grid-density', Math.round(Number(s.gridDensity) || 12));
                setTxt('view3d-uv-opacity-val', `${Math.round(Number(s.uvOpacity) || 82)}%`);
                setTxt('view3d-grid-density-val', `${Math.round(Number(s.gridDensity) || 12)}`);
                setChecked('view3d-show-grid', s.showGrid);
                setChecked('view3d-show-axes', s.showAxes);
                setChecked('view3d-show-uv', s.showUV);
                // Also sync canvas toolbar toggles
                setChecked('view3d-tb-grid', s.showGrid);
                setChecked('view3d-tb-axes', s.showAxes);
                setChecked('view3d-tb-uv', s.showUV);
                setToolMode(s.toolMode || 'orbit');
                // Sync canvas toolbar tool buttons
                container.querySelectorAll('.view3d-canvas-tool').forEach((btn) => {
                    const tool = btn.getAttribute('data-canvas-tool') || '';
                    const active = tool === s.toolMode;
                    btn.className = `view3d-canvas-tool text-[10px] rounded px-2 py-1 ${active ? 'bg-cyan-700 text-white' : 'bg-gray-800 hover:bg-gray-700 text-gray-100'}`;
                });
                const selectedStageId = String(s.selectedStageObjectId || '');
                container.querySelectorAll('.view3d-stage-input').forEach((input) => {
                    if (String(input.getAttribute('data-stageid') || '') !== selectedStageId) return;
                    const object = stageObjects.find((item) => String(item.id) === selectedStageId);
                    const field = String(input.getAttribute('data-field') || '');
                    if (object && ['x', 'y', 'z'].includes(field)) input.value = Number(object[field] || 0).toFixed(1);
                });
            };

            fitCanvas();
            syncUi();

            let dragging = false;
            let dragMode = 'orbit';
            let dragAxis = ''; // 'X', 'Y', 'Z', 'XY', rotation axes, or 'scale'
            let startX = 0;
            let startY = 0;
            let dragHistoryCaptured = false;

            // --- Smooth camera animation state ---
            let targetDist = Number(s.distance) || 9;  // smooth zoom target
            let animRotX = NaN, animRotY = NaN;        // preset transition targets (NaN = not animating)
            let currentViewLabel = 'Perspective';
            const LERP_SPEED = 0.12;    // for view preset transitions
            const ZOOM_LERP = 0.18;     // for smooth zoom

            const getGizmoAtCanvasPoint = (clientX, clientY) => {
                const rect = canvas.getBoundingClientRect();
                const pt = { x: clientX - rect.left, y: clientY - rect.top };
                for (let i = gizmoHitAreas.length - 1; i >= 0; i--) {
                    const g = gizmoHitAreas[i];
                    if (g.isRect) {
                        if (pt.x >= g.from.x && pt.x <= g.to.x && pt.y >= g.from.y && pt.y <= g.to.y) return g;
                    } else if (g.from && g.to) {
                        // Line hit test: distance from point to line segment
                        const ax = g.from.x, ay = g.from.y, bx = g.to.x, by = g.to.y;
                        const lenSq = (bx - ax) ** 2 + (by - ay) ** 2;
                        let t = lenSq > 0 ? ((pt.x - ax) * (bx - ax) + (pt.y - ay) * (by - ay)) / lenSq : 0;
                        t = Math.max(0, Math.min(1, t));
                        const px = ax + t * (bx - ax), py = ay + t * (by - ay);
                        const dist = Math.sqrt((pt.x - px) ** 2 + (pt.y - py) ** 2);
                        if (dist <= g.radius) return g;
                    } else if (g.center && g.ringRadius !== undefined) {
                        const dist = Math.sqrt((pt.x - g.center.x) ** 2 + (pt.y - g.center.y) ** 2);
                        if (Math.abs(dist - g.ringRadius) <= g.ringTolerance) return g;
                    } else if (g.center) {
                        const dist = Math.sqrt((pt.x - g.center.x) ** 2 + (pt.y - g.center.y) ** 2);
                        if (dist <= g.radius) return g;
                    }
                }
                return null;
            };

            const onDown = (e) => {
                if (e.button !== 0 && e.button !== 2) return;
                dragging = true;
                startX = e.clientX;
                startY = e.clientY;
                dragAxis = '';
                dragHistoryCaptured = false;

                if (e.button === 0 && s.toolMode === 'pan') {
                    dragMode = 'pan';
                    syncUi();
                    return;
                }

                // Check gizmo hit first (only on left-click with a tool active)
                if (e.button === 0 && s.toolMode !== 'orbit' && s.selectedMapId) {
                    const gHit = getGizmoAtCanvasPoint(e.clientX, e.clientY);
                    if (gHit) {
                        dragAxis = gHit.axis || '';
                        if (dragAxis === 'X' || dragAxis === 'Y' || dragAxis === 'Z' || dragAxis === 'XY') {
                            dragMode = 'gizmo-move';
                        } else if (dragAxis === 'rotX' || dragAxis === 'rotY' || dragAxis === 'rotZ') {
                            dragMode = 'gizmo-rotate';
                        } else if (dragAxis === 'scale') {
                            dragMode = 'gizmo-scale';
                        }
                        syncUi();
                        return;
                    }
                }

                // Regular hit detection
                const pickedId = getMapAtCanvasPoint(e.clientX, e.clientY);
                if (pickedId) {
                    selectMapForSnapping(pickedId);
                    // If a tool is active, clicking on an object auto-enters that tool's drag mode
                    if (e.button === 0 && s.toolMode === 'move') { dragMode = 'move-map'; syncUi(); return; }
                    if (e.button === 0 && s.toolMode === 'rotate') { dragMode = 'rotate-map'; syncUi(); return; }
                    if (e.button === 0 && s.toolMode === 'scale') { dragMode = 'scale-map'; syncUi(); return; }
                } else {
                    const pickedStageId = getStageAtCanvasPoint(e.clientX, e.clientY);
                    if (pickedStageId) {
                        s.selectedStageObjectId = String(pickedStageId);
                        s.selectedMapId = '';
                        if (e.button === 0 && s.toolMode === 'move') {
                            dragMode = 'move-stage';
                            syncUi();
                            return;
                        }
                    }
                }
                if (e.button === 2 || e.shiftKey) dragMode = 'pan';
                else if (e.altKey || s.toolMode === 'orbit') dragMode = 'orbit';
                else dragMode = 'orbit';
                syncUi();
            };

            const onMove = (e) => {
                if (!dragging) return;
                const dx = e.clientX - startX;
                const dy = e.clientY - startY;
                startX = e.clientX;
                startY = e.clientY;
                const sceneDragModes = new Set(['gizmo-move', 'gizmo-rotate', 'gizmo-scale', 'move-map', 'move-stage', 'rotate-map', 'scale-map']);
                if (!dragHistoryCaptured && sceneDragModes.has(dragMode) && (dx !== 0 || dy !== 0)) {
                    pushView3dHistory();
                    dragHistoryCaptured = true;
                }

                if (dragMode === 'pan') {
                    s.panX = Math.max(-PAN_LIMIT, Math.min(PAN_LIMIT, (Number(s.panX) || 0) + dx));
                    s.panY = Math.max(-PAN_LIMIT, Math.min(PAN_LIMIT, (Number(s.panY) || 0) + dy));
                } else if (dragMode === 'gizmo-move') {
                    const t = ensureSelectedTransform();
                    if (t) {
                        const moveScale = Math.max(0.002, (Number(s.distance) || 9) * 0.0017);
                        const yaw = degToRad(Number(s.rotY) || 0);
                        if (dragAxis === 'X') {
                            t.x = Math.max(-MAP_POSITION_LIMIT, Math.min(MAP_POSITION_LIMIT, (Number(t.x) || 0) + dx * Math.cos(yaw) * moveScale));
                        } else if (dragAxis === 'Z') {
                            t.z = Math.max(-MAP_POSITION_LIMIT, Math.min(MAP_POSITION_LIMIT, (Number(t.z) || 0) + dx * Math.sin(yaw) * moveScale));
                        } else if (dragAxis === 'Y') {
                            // Y movement: drag up/down on screen moves object up/down in world
                            t.y = Math.max(-MAP_POSITION_LIMIT, Math.min(MAP_POSITION_LIMIT, (Number(t.y) || 0) - dy * moveScale));
                        } else {
                            t.x = Math.max(-MAP_POSITION_LIMIT, Math.min(MAP_POSITION_LIMIT, (Number(t.x) || 0) + dx * Math.cos(yaw) * moveScale));
                            t.z = Math.max(-MAP_POSITION_LIMIT, Math.min(MAP_POSITION_LIMIT, (Number(t.z) || 0) + dx * Math.sin(yaw) * moveScale));
                            t.y = Math.max(-MAP_POSITION_LIMIT, Math.min(MAP_POSITION_LIMIT, (Number(t.y) || 0) - dy * moveScale));
                        }
                    }
                } else if (dragMode === 'gizmo-rotate') {
                    const t = ensureSelectedTransform();
                    if (t) {
                        if (dragAxis === 'rotX') t.rotX = (Number(t.rotX) || 0) - (dy * 0.5);
                        else if (dragAxis === 'rotZ') t.rotZ = (Number(t.rotZ) || 0) + (dx * 0.5);
                        else t.rotY = (Number(t.rotY) || 0) + (dx * 0.5);
                    }
                } else if (dragMode === 'gizmo-scale') {
                    const t = ensureSelectedTransform();
                    if (t) {
                        const next = (Number(t.scale) || 1) * (1 - (dy * 0.01));
                        t.scale = Math.max(0.2, Math.min(3, next));
                    }
                } else if (dragMode === 'move-map') {
                    const t = ensureSelectedTransform();
                    if (t) {
                        const moveScale = Math.max(0.002, (Number(s.distance) || 9) * 0.0017);
                        const yaw = degToRad(Number(s.rotY) || 0);
                        t.x = Math.max(-MAP_POSITION_LIMIT, Math.min(MAP_POSITION_LIMIT, (Number(t.x) || 0) + (dx * Math.cos(yaw) * moveScale)));
                        t.z = Math.max(-MAP_POSITION_LIMIT, Math.min(MAP_POSITION_LIMIT, (Number(t.z) || 0) + (dx * Math.sin(yaw) * moveScale)));
                        t.y = Math.max(-MAP_POSITION_LIMIT, Math.min(MAP_POSITION_LIMIT, (Number(t.y) || 0) - (dy * moveScale)));
                    }
                } else if (dragMode === 'move-stage') {
                    const object = stageObjects.find((item) => String(item.id) === String(s.selectedStageObjectId || ''));
                    if (object) {
                        const moveScale = Math.max(0.002, (Number(s.distance) || 9) * 0.0017);
                        const yaw = degToRad(Number(s.rotY) || 0);
                        object.x = Math.max(-100, Math.min(100, (Number(object.x) || 0) + (dx * Math.cos(yaw) * moveScale)));
                        object.z = Math.max(-100, Math.min(100, (Number(object.z) || 0) + (dx * Math.sin(yaw) * moveScale)));
                        object.y = Math.max(-100, Math.min(100, (Number(object.y) || 0) - (dy * moveScale)));
                    }
                } else if (dragMode === 'rotate-map') {
                    const t = ensureSelectedTransform();
                    if (t) t.rotY = (Number(t.rotY) || 0) + (dx * 0.5);
                } else if (dragMode === 'scale-map') {
                    const t = ensureSelectedTransform();
                    if (t) {
                        const next = (Number(t.scale) || 1) * (1 - (dy * 0.01));
                        t.scale = Math.max(0.2, Math.min(3, next));
                    }
                } else {
                    s.rotY = (Number(s.rotY) || 0) + (dx * 0.24);
                    s.rotX = Math.max(-85, Math.min(85, (Number(s.rotX) || 0) - (dy * 0.24)));
                    // Cancel any preset animation during manual orbit
                    animRotX = NaN; animRotY = NaN;
                    currentViewLabel = 'Perspective';
                    const lbl = document.getElementById('view3d-persp-label');
                    if (lbl) lbl.textContent = 'Perspective';
                }
                syncUi();
            };

            const onUp = () => {
                const completedDragMode = dragMode;
                if (dragging && (completedDragMode === 'move-map' || completedDragMode === 'gizmo-move')) {
                    if (!tryAutoSnapSelectedMap()) persistProjects();
                } else if (dragging && completedDragMode === 'move-stage') {
                    persistProjects();
                }
                dragging = false;
                dragAxis = '';
                dragHistoryCaptured = false;
            };

            const onHover = (e) => {
                if (dragging) return;
                if (s.toolMode === 'pan') { canvas.style.cursor = 'grab'; return; }
                if (s.toolMode !== 'orbit' && s.selectedMapId) {
                    const gHit = getGizmoAtCanvasPoint(e.clientX, e.clientY);
                    if (gHit) { canvas.style.cursor = 'grab'; return; }
                }
                const pickedId = getMapAtCanvasPoint(e.clientX, e.clientY);
                const pickedStageId = pickedId ? null : getStageAtCanvasPoint(e.clientX, e.clientY);
                canvas.style.cursor = pickedStageId && s.toolMode === 'move' ? 'move' : (pickedId || pickedStageId ? 'pointer' : 'default');
            };

            const onWheel = (e) => {
                e.preventDefault();
                const delta = Math.max(-4, Math.min(4, Number(e.deltaY) / 100));
                targetDist = Math.max(MIN_ZOOM_DISTANCE, Math.min(MAX_ZOOM_DISTANCE, targetDist * Math.exp(delta * 0.16)));
                // Cancel any preset animation on manual zoom
                animRotX = NaN; animRotY = NaN;
            };

            canvas.addEventListener('mousedown', onDown);
            canvas.addEventListener('mousemove', onHover);
            window.addEventListener('mousemove', onMove);
            window.addEventListener('mouseup', onUp);
            canvas.addEventListener('wheel', onWheel, { passive: false });
            canvas.addEventListener('contextmenu', (e) => e.preventDefault());
            window.addEventListener('resize', fitCanvas);

            container.querySelectorAll('.view3d-tool-btn').forEach((btn) => {
                btn.addEventListener('mousedown', (e) => { e.preventDefault(); e.stopPropagation(); });
                btn.addEventListener('click', () => { setToolMode(String(btn.getAttribute('data-tool') || 'orbit')); syncUi(); });
            });

            // Canvas toolbar tool buttons
            container.querySelectorAll('.view3d-canvas-tool').forEach((btn) => {
                btn.addEventListener('mousedown', (e) => { e.preventDefault(); e.stopPropagation(); });
                btn.addEventListener('click', () => {
                    setToolMode(String(btn.getAttribute('data-canvas-tool') || 'orbit'));
                    syncCanvasToolbar();
                    syncUi();
                });
            });

            // Canvas toolbar grid size
            const gridSizeEl = document.getElementById('view3d-grid-size');
            if (gridSizeEl) gridSizeEl.addEventListener('change', () => { s.gridSizeM = Number(gridSizeEl.value) || 1; });

            // Canvas toolbar toggles
            const tbGridEl = document.getElementById('view3d-tb-grid');
            const tbAxesEl = document.getElementById('view3d-tb-axes');
            const tbUvEl = document.getElementById('view3d-tb-uv');
            if (tbGridEl) tbGridEl.addEventListener('change', () => { s.showGrid = !!tbGridEl.checked; syncUi(); });
            if (tbAxesEl) tbAxesEl.addEventListener('change', () => { s.showAxes = !!tbAxesEl.checked; syncUi(); });
            if (tbUvEl) tbUvEl.addEventListener('change', () => { s.showUV = !!tbUvEl.checked; syncUi(); });

            // Pan buttons
            const PAN_STEP = 10;
            const bindPan = (id, dx, dy) => {
                const el = document.getElementById(id);
                if (!el) return;
                let panInterval = null;
                let panTimeout = null;
                const doPan = () => {
                    s.panX = Math.max(-PAN_LIMIT, Math.min(PAN_LIMIT, (Number(s.panX) || 0) + dx));
                    s.panY = Math.max(-PAN_LIMIT, Math.min(PAN_LIMIT, (Number(s.panY) || 0) + dy));
                };
                const stopPan = () => { clearTimeout(panTimeout); clearInterval(panInterval); panTimeout = null; panInterval = null; };
                el.addEventListener('mousedown', (e) => {
                    e.preventDefault();
                    doPan();
                    // 380ms delay before auto-repeat starts — prevents multi-fire on a quick tap
                    panTimeout = setTimeout(() => { panInterval = setInterval(doPan, 80); }, 380);
                });
                el.addEventListener('mouseup', stopPan);
                el.addEventListener('mouseleave', stopPan);
            };
            bindPan('view3d-pan-left',  -PAN_STEP, 0);
            bindPan('view3d-pan-right',  PAN_STEP, 0);
            bindPan('view3d-pan-up',     0, -PAN_STEP);
            bindPan('view3d-pan-down',   0,  PAN_STEP);
            const panResetEl = document.getElementById('view3d-pan-reset');
            const fitSceneEl = document.getElementById('view3d-fit-scene');
            const fitScene = () => {
                pushView3dHistory();
                s.panX = 0;
                s.panY = 0;
                s.distance = 9;
                targetDist = 9;
                animRotX = NaN;
                animRotY = NaN;
                persistProjects();
                syncUi();
            };
            if (panResetEl) panResetEl.addEventListener('click', fitScene);
            if (fitSceneEl) fitSceneEl.addEventListener('click', fitScene);

            const syncCanvasToolbar = () => {
                container.querySelectorAll('.view3d-canvas-tool').forEach((btn) => {
                    const tool = btn.getAttribute('data-canvas-tool') || '';
                    const active = tool === s.toolMode;
                    btn.className = `view3d-canvas-tool text-[10px] rounded px-2 py-1 ${active ? 'bg-cyan-700 text-white' : 'bg-gray-800 hover:bg-gray-700 text-gray-100'}`;
                });
            };
            syncCanvasToolbar();

            const undoButton = document.getElementById('view3d-undo');
            const redoButton = document.getElementById('view3d-redo');
            if (undoButton) undoButton.addEventListener('click', undoView3dScene);
            if (redoButton) redoButton.addEventListener('click', redoView3dScene);

            const keydownHandler = (e) => {
                const key = String(e.key || '').toLowerCase();
                const editable = e.target && (e.target.matches?.('input, textarea, select') || e.target.isContentEditable);
                if (!editable && (e.ctrlKey || e.metaKey) && key === 'z') {
                    e.preventDefault();
                    if (e.shiftKey) redoView3dScene();
                    else undoView3dScene();
                } else if (!editable && (e.ctrlKey || e.metaKey) && key === 'y') {
                    e.preventDefault();
                    redoView3dScene();
                } else if (key === 'q') { setToolMode('orbit'); syncUi(); }
                else if (key === 'w') { setToolMode('move'); syncUi(); }
                else if (key === 'e') { setToolMode('rotate'); syncUi(); }
                else if (key === 'r') { setToolMode('scale'); syncUi(); }
                else if (key === 'escape') { s.selectedMapId = ''; syncUi(); }
            };
            window.addEventListener('keydown', keydownHandler);

            // --- Perspective dropdown (d3-style) ---
            const perspBtn = document.getElementById('view3d-persp-btn');
            const perspMenu = document.getElementById('view3d-persp-menu');
            let perspOpen = false;
            const closePerspMenu = () => { if (perspMenu) perspMenu.classList.add('hidden'); perspOpen = false; };
            if (perspBtn) {
                perspBtn.addEventListener('mousedown', (e) => { e.preventDefault(); e.stopPropagation(); });
                perspBtn.addEventListener('click', () => {
                    perspOpen = !perspOpen;
                    if (perspOpen) perspMenu.classList.remove('hidden');
                    else perspMenu.classList.add('hidden');
                });
            }
            // Close on outside click
            const onDocMouseDown = (e) => {
                if (perspOpen && perspBtn && !perspBtn.contains(e.target) && perspMenu && !perspMenu.contains(e.target)) closePerspMenu();
            };
            document.addEventListener('mousedown', onDocMouseDown);
            container.querySelectorAll('.view3d-view-opt').forEach((btn) => {
                btn.addEventListener('mousedown', (e) => { e.preventDefault(); e.stopPropagation(); });
                btn.addEventListener('click', () => {
                    const view = String(btn.getAttribute('data-view') || '').toLowerCase();
                    // Set transition targets for smooth animated transition
                    if (view === 'perspective') {
                        animRotX = -12; animRotY = 28;
                        currentViewLabel = 'Perspective';
                    } else if (view === 'front') {
                        animRotX = 0; animRotY = 0;
                        currentViewLabel = 'Front';
                    } else if (view === 'back') {
                        animRotX = 0; animRotY = 180;
                        currentViewLabel = 'Back';
                    } else if (view === 'left') {
                        animRotX = 0; animRotY = -90;
                        currentViewLabel = 'Left';
                    } else if (view === 'right') {
                        animRotX = 0; animRotY = 90;
                        currentViewLabel = 'Right';
                    } else if (view === 'top') {
                        animRotX = -89; animRotY = 0;
                        currentViewLabel = 'Top';
                    } else if (view === 'bottom') {
                        animRotX = 89; animRotY = 0;
                        currentViewLabel = 'Bottom';
                    } else if (view === 'reset') {
                        animRotX = -12; animRotY = 28;
                        targetDist = 9;
                        s.panX = 0;
                        s.panY = 0;
                        currentViewLabel = 'Perspective';
                    }
                    const lbl = document.getElementById('view3d-persp-label');
                    if (lbl) lbl.textContent = currentViewLabel;
                    closePerspMenu();
                });
            });

            const composePlacementEl = document.getElementById('view3d-compose-placement');
            const composeGapEl = document.getElementById('view3d-compose-gap');
            const rerenderWithLayout = () => {
                if (composePlacementEl) s.composePlacement = composePlacementEl.value || 'right';
                if (composeGapEl) s.composeGapPx = Math.max(0, Number(composeGapEl.value) || 0);
                render3DViewTab();
            };
            if (composePlacementEl) composePlacementEl.addEventListener('change', rerenderWithLayout);
            if (composeGapEl) composeGapEl.addEventListener('change', rerenderWithLayout);

            const arrangeAlignEl = document.getElementById('view3d-arrange-align');
            const arrangeGapEl = document.getElementById('view3d-arrange-gap');
            const arrangeAllMaps = (layout) => {
                if (!mapRenderData.length) return;
                pushView3dHistory();
                const align = arrangeAlignEl?.value || s.mapArrangeAlign || 'center';
                const gap = Math.max(0, Number(arrangeGapEl?.value) || 0);
                s.mapArrangeAlign = align;
                s.mapArrangeGap = gap;
                const entries = mapRenderData.map((map) => {
                    const scale = Math.max(0.2, Math.min(3, Number(map.transform.scale) || 1));
                    return { map, width: map.widthM * scale, height: map.heightM * scale };
                });
                const placements = new Map();
                if (layout === 'row') {
                    const totalWidth = entries.reduce((sum, entry) => sum + entry.width, 0) + Math.max(0, entries.length - 1) * gap;
                    const maxHeight = Math.max(...entries.map((entry) => entry.height));
                    let cursorX = -totalWidth / 2;
                    entries.forEach((entry) => {
                        const y = align === 'start'
                            ? (maxHeight - entry.height) / 2
                            : align === 'end' ? (entry.height - maxHeight) / 2 : 0;
                        placements.set(entry.map.id, { x: cursorX + (entry.width / 2), y });
                        cursorX += entry.width + gap;
                    });
                } else if (layout === 'stack') {
                    const totalHeight = entries.reduce((sum, entry) => sum + entry.height, 0) + Math.max(0, entries.length - 1) * gap;
                    const maxWidth = Math.max(...entries.map((entry) => entry.width));
                    let cursorY = totalHeight / 2;
                    entries.forEach((entry) => {
                        const x = align === 'start'
                            ? (entry.width - maxWidth) / 2
                            : align === 'end' ? (maxWidth - entry.width) / 2 : 0;
                        placements.set(entry.map.id, { x, y: cursorY - (entry.height / 2) });
                        cursorY -= entry.height + gap;
                    });
                } else {
                    const columnCount = Math.max(1, Math.ceil(Math.sqrt(entries.length)));
                    const rowCount = Math.ceil(entries.length / columnCount);
                    const columnWidths = Array(columnCount).fill(0);
                    const rowHeights = Array(rowCount).fill(0);
                    entries.forEach((entry, index) => {
                        const column = index % columnCount;
                        const row = Math.floor(index / columnCount);
                        columnWidths[column] = Math.max(columnWidths[column], entry.width);
                        rowHeights[row] = Math.max(rowHeights[row], entry.height);
                    });
                    const totalWidth = columnWidths.reduce((sum, width) => sum + width, 0) + Math.max(0, columnCount - 1) * gap;
                    const totalHeight = rowHeights.reduce((sum, height) => sum + height, 0) + Math.max(0, rowCount - 1) * gap;
                    const columnStarts = [];
                    const rowStarts = [];
                    let cursorX = -totalWidth / 2;
                    columnWidths.forEach((width, column) => {
                        columnStarts[column] = cursorX;
                        cursorX += width + gap;
                    });
                    let cursorY = totalHeight / 2;
                    rowHeights.forEach((height, row) => {
                        rowStarts[row] = cursorY;
                        cursorY -= height + gap;
                    });
                    entries.forEach((entry, index) => {
                        const column = index % columnCount;
                        const row = Math.floor(index / columnCount);
                        const cellWidth = columnWidths[column];
                        const cellHeight = rowHeights[row];
                        const x = columnStarts[column] + (align === 'start' ? entry.width / 2 : align === 'end' ? cellWidth - (entry.width / 2) : cellWidth / 2);
                        const y = rowStarts[row] - (align === 'start' ? entry.height / 2 : align === 'end' ? cellHeight - (entry.height / 2) : cellHeight / 2);
                        placements.set(entry.map.id, { x, y });
                    });
                }
                entries.forEach(({ map }) => {
                    const position = placements.get(map.id);
                    if (!position) return;
                    map.transform.x = position.x - map.baseX;
                    map.transform.y = position.y - map.baseY;
                    map.transform.z = 0;
                    map.transform.rotX = 0;
                    map.transform.rotY = 0;
                    map.transform.rotZ = 0;
                });
                s.panX = 0;
                s.panY = 0;
                s.distance = 9;
                persistProjects();
                render3DViewTab();
            };
            if (arrangeAlignEl) arrangeAlignEl.addEventListener('change', () => {
                s.mapArrangeAlign = arrangeAlignEl.value || 'center';
                persistProjects();
            });
            if (arrangeGapEl) arrangeGapEl.addEventListener('change', () => {
                s.mapArrangeGap = Math.max(0, Number(arrangeGapEl.value) || 0);
                persistProjects();
            });
            container.querySelectorAll('.view3d-arrange-all').forEach((button) => {
                button.addEventListener('click', () => arrangeAllMaps(String(button.getAttribute('data-layout') || 'row')));
            });

            const snapTargetEl = document.getElementById('view3d-snap-target');
            const mapSnapGapEl = document.getElementById('view3d-map-snap-gap');
            const snapTouchEdgesEl = document.getElementById('view3d-snap-touch-edges');
            const autoSnapEl = document.getElementById('view3d-auto-snap');
            const autoSnapRangeEl = document.getElementById('view3d-auto-snap-range');
            const snapHorizontalAlignEl = document.getElementById('view3d-snap-horizontal-align');
            const snapVerticalAlignEl = document.getElementById('view3d-snap-vertical-align');
            if (snapTargetEl) snapTargetEl.addEventListener('change', () => {
                s.mapSnapTargetId = getValidMapSnapTargetId(s.selectedMapId, snapTargetEl.value);
                persistProjects();
            });
            if (snapHorizontalAlignEl) snapHorizontalAlignEl.addEventListener('change', () => {
                s.mapSnapHorizontalAlign = snapHorizontalAlignEl.value || 'center';
                persistProjects();
            });
            if (snapVerticalAlignEl) snapVerticalAlignEl.addEventListener('change', () => {
                s.mapSnapVerticalAlign = snapVerticalAlignEl.value || 'middle';
                persistProjects();
            });
            if (snapTouchEdgesEl) snapTouchEdgesEl.addEventListener('change', () => {
                s.mapSnapTouchEdges = !!snapTouchEdgesEl.checked;
                if (mapSnapGapEl) mapSnapGapEl.disabled = s.mapSnapTouchEdges;
                persistProjects();
            });
            if (mapSnapGapEl) mapSnapGapEl.addEventListener('change', () => {
                s.mapSnapGap = Math.max(0, Number(mapSnapGapEl.value) || 0);
                persistProjects();
            });
            if (autoSnapEl) autoSnapEl.addEventListener('change', () => {
                s.mapAutoSnap = !!autoSnapEl.checked;
                persistProjects();
            });
            if (autoSnapRangeEl) autoSnapRangeEl.addEventListener('change', () => {
                s.mapAutoSnapRange = Math.max(0.05, Number(autoSnapRangeEl.value) || 0.35);
                persistProjects();
            });
            const snapSelectedMap = (side, recordHistory = true) => {
                const source = mapRenderData.find((map) => String(map.id) === String(s.selectedMapId || ''));
                s.mapSnapTargetId = getValidMapSnapTargetId(s.selectedMapId, s.mapSnapTargetId);
                const target = mapRenderData.find((map) => String(map.id) === String(s.mapSnapTargetId));
                if (!source || !target || source === target) return false;
                if (recordHistory) pushView3dHistory();
                const sourceTransform = source.transform;
                const targetTransform = target.transform;
                const sourceWidth = source.widthM * Math.max(0.2, Math.min(3, Number(sourceTransform.scale) || 1));
                const sourceHeight = source.heightM * Math.max(0.2, Math.min(3, Number(sourceTransform.scale) || 1));
                const targetWidth = target.widthM * Math.max(0.2, Math.min(3, Number(targetTransform.scale) || 1));
                const targetHeight = target.heightM * Math.max(0.2, Math.min(3, Number(targetTransform.scale) || 1));
                const targetX = target.baseX + (Number(targetTransform.x) || 0);
                const targetY = target.baseY + (Number(targetTransform.y) || 0);
                s.mapSnapGap = Math.max(0, Number(mapSnapGapEl?.value) || Number(s.mapSnapGap) || 0);
                const gap = s.mapSnapTouchEdges ? 0 : s.mapSnapGap;
                sourceTransform.rotX = Number(targetTransform.rotX) || 0;
                sourceTransform.rotY = Number(targetTransform.rotY) || 0;
                sourceTransform.rotZ = Number(targetTransform.rotZ) || 0;
                sourceTransform.z = Number(targetTransform.z) || 0;
                const horizontalAlign = snapHorizontalAlignEl?.value || s.mapSnapHorizontalAlign || 'center';
                const verticalAlign = snapVerticalAlignEl?.value || s.mapSnapVerticalAlign || 'middle';
                s.mapSnapHorizontalAlign = horizontalAlign;
                s.mapSnapVerticalAlign = verticalAlign;
                const horizontalOffset = horizontalAlign === 'left'
                    ? (sourceWidth - targetWidth) / 2
                    : horizontalAlign === 'right' ? (targetWidth - sourceWidth) / 2 : 0;
                const verticalOffset = verticalAlign === 'top'
                    ? (targetHeight - sourceHeight) / 2
                    : verticalAlign === 'bottom' ? (sourceHeight - targetHeight) / 2 : 0;
                let localOffset;
                if (side === 'left' || side === 'right') {
                    const direction = side === 'left' ? -1 : 1;
                    localOffset = { x: direction * ((targetWidth + sourceWidth) / 2 + gap), y: verticalOffset, z: 0 };
                } else {
                    const direction = side === 'below' ? -1 : 1;
                    localOffset = { x: horizontalOffset, y: direction * ((targetHeight + sourceHeight) / 2 + gap), z: 0 };
                }
                let worldOffset = rotateYPoint(localOffset, sourceTransform.rotY);
                if (sourceTransform.rotX) worldOffset = rotateXPoint(worldOffset, sourceTransform.rotX);
                if (sourceTransform.rotZ) worldOffset = rotateZPoint(worldOffset, sourceTransform.rotZ);
                sourceTransform.x = targetX + worldOffset.x - source.baseX;
                sourceTransform.y = targetY + worldOffset.y - source.baseY;
                sourceTransform.z = (Number(targetTransform.z) || 0) + worldOffset.z;
                persistProjects();
                render3DViewTab();
                return true;
            };
            const tryAutoSnapSelectedMap = () => {
                if (!s.mapAutoSnap) return false;
                const source = mapRenderData.find((map) => String(map.id) === String(s.selectedMapId || ''));
                if (!source) return false;
                const sourceTransform = source.transform;
                const sourceScale = Math.max(0.2, Math.min(3, Number(sourceTransform.scale) || 1));
                const sourceWidth = source.widthM * sourceScale;
                const sourceHeight = source.heightM * sourceScale;
                const sourceCenter = {
                    x: source.baseX + (Number(sourceTransform.x) || 0),
                    y: source.baseY + (Number(sourceTransform.y) || 0),
                    z: Number(sourceTransform.z) || 0
                };
                const threshold = Math.max(0.05, Number(s.mapAutoSnapRange) || 0.35);
                let best = null;
                mapRenderData.forEach((target) => {
                    if (String(target.id) === String(source.id)) return;
                    const targetTransform = target.transform;
                    const targetScale = Math.max(0.2, Math.min(3, Number(targetTransform.scale) || 1));
                    const targetWidth = target.widthM * targetScale;
                    const targetHeight = target.heightM * targetScale;
                    const targetCenter = {
                        x: target.baseX + (Number(targetTransform.x) || 0),
                        y: target.baseY + (Number(targetTransform.y) || 0),
                        z: Number(targetTransform.z) || 0
                    };
                    let delta = {
                        x: sourceCenter.x - targetCenter.x,
                        y: sourceCenter.y - targetCenter.y,
                        z: sourceCenter.z - targetCenter.z
                    };
                    if (targetTransform.rotZ) delta = rotateZPoint(delta, -Number(targetTransform.rotZ));
                    if (targetTransform.rotX) delta = rotateXPoint(delta, -Number(targetTransform.rotX));
                    if (targetTransform.rotY) delta = rotateYPoint(delta, -Number(targetTransform.rotY));
                    if (Math.abs(delta.z) > threshold * 2) return;
                    const horizontalAlignments = [
                        { value: 'left', offset: (sourceWidth - targetWidth) / 2 },
                        { value: 'center', offset: 0 },
                        { value: 'right', offset: (targetWidth - sourceWidth) / 2 }
                    ];
                    const verticalAlignments = [
                        { value: 'top', offset: (targetHeight - sourceHeight) / 2 },
                        { value: 'middle', offset: 0 },
                        { value: 'bottom', offset: (sourceHeight - targetHeight) / 2 }
                    ];
                    const nearestHorizontal = horizontalAlignments.reduce((a, b) => Math.abs(delta.x - a.offset) <= Math.abs(delta.x - b.offset) ? a : b);
                    const nearestVertical = verticalAlignments.reduce((a, b) => Math.abs(delta.y - a.offset) <= Math.abs(delta.y - b.offset) ? a : b);
                    const candidates = [
                        { side: 'left', edgeError: Math.abs(delta.x + ((targetWidth + sourceWidth) / 2)), align: nearestVertical, alignError: Math.abs(delta.y - nearestVertical.offset) },
                        { side: 'right', edgeError: Math.abs(delta.x - ((targetWidth + sourceWidth) / 2)), align: nearestVertical, alignError: Math.abs(delta.y - nearestVertical.offset) },
                        { side: 'above', edgeError: Math.abs(delta.y - ((targetHeight + sourceHeight) / 2)), align: nearestHorizontal, alignError: Math.abs(delta.x - nearestHorizontal.offset) },
                        { side: 'below', edgeError: Math.abs(delta.y + ((targetHeight + sourceHeight) / 2)), align: nearestHorizontal, alignError: Math.abs(delta.x - nearestHorizontal.offset) }
                    ];
                    candidates.forEach((candidate) => {
                        if (candidate.edgeError > threshold || candidate.alignError > threshold * 2) return;
                        const score = candidate.edgeError + candidate.alignError + Math.abs(delta.z);
                        if (!best || score < best.score) best = { ...candidate, score, targetId: String(target.id) };
                    });
                });
                if (!best) return false;
                s.mapSnapTargetId = best.targetId;
                if (best.side === 'left' || best.side === 'right') s.mapSnapVerticalAlign = best.align.value;
                else s.mapSnapHorizontalAlign = best.align.value;
                return snapSelectedMap(best.side, false);
            };
            container.querySelectorAll('.view3d-snap-map-side').forEach((button) => {
                button.addEventListener('click', () => snapSelectedMap(String(button.getAttribute('data-side') || 'right')));
            });

            const showGridEl = document.getElementById('view3d-show-grid');
            const showAxesEl = document.getElementById('view3d-show-axes');
            const showUvEl = document.getElementById('view3d-show-uv');
            const uvOpacityEl = document.getElementById('view3d-uv-opacity');
            const gridDensityEl = document.getElementById('view3d-grid-density');
            if (showGridEl) showGridEl.addEventListener('change', () => { s.showGrid = !!showGridEl.checked; syncUi(); });
            if (showAxesEl) showAxesEl.addEventListener('change', () => { s.showAxes = !!showAxesEl.checked; syncUi(); });
            if (showUvEl) showUvEl.addEventListener('change', () => { s.showUV = !!showUvEl.checked; syncUi(); });
            if (uvOpacityEl) uvOpacityEl.addEventListener('input', () => { s.uvOpacity = Number(uvOpacityEl.value) || 82; syncUi(); });
            if (gridDensityEl) gridDensityEl.addEventListener('input', () => { s.gridDensity = Number(gridDensityEl.value) || 12; syncUi(); });

            const appearanceDefaults = {
                backgroundTopColor: '#050a14',
                backgroundBottomColor: '#0d1425',
                gridMinorColor: '#334155',
                gridMajorColor: '#475569',
                labelAccentColor: '#38bdf8',
                gridOpacity: 100
            };
            const appearanceColorControls = [
                ['view3d-bg-top', 'backgroundTopColor'],
                ['view3d-bg-bottom', 'backgroundBottomColor'],
                ['view3d-grid-minor-color', 'gridMinorColor'],
                ['view3d-grid-major-color', 'gridMajorColor'],
                ['view3d-label-accent-color', 'labelAccentColor']
            ];
            appearanceColorControls.forEach(([id, stateKey]) => {
                const input = document.getElementById(id);
                if (!input) return;
                input.addEventListener('input', () => { s[stateKey] = input.value; });
                input.addEventListener('change', persistProjects);
            });
            const gridOpacityEl = document.getElementById('view3d-grid-opacity');
            const gridOpacityValueEl = document.getElementById('view3d-grid-opacity-val');
            if (gridOpacityEl) {
                gridOpacityEl.addEventListener('input', () => {
                    s.gridOpacity = Math.max(0, Math.min(150, Number(gridOpacityEl.value) || 0));
                    if (gridOpacityValueEl) gridOpacityValueEl.textContent = `${Math.round(s.gridOpacity)}%`;
                });
                gridOpacityEl.addEventListener('change', persistProjects);
            }
            const resetAppearanceEl = document.getElementById('view3d-reset-appearance');
            if (resetAppearanceEl) resetAppearanceEl.addEventListener('click', () => {
                Object.assign(s, appearanceDefaults);
                appearanceColorControls.forEach(([id, stateKey]) => {
                    const input = document.getElementById(id);
                    if (input) input.value = s[stateKey];
                });
                if (gridOpacityEl) gridOpacityEl.value = String(s.gridOpacity);
                if (gridOpacityValueEl) gridOpacityValueEl.textContent = `${s.gridOpacity}%`;
                persistProjects();
            });

            const addDeckBtn = document.getElementById('view3d-add-deck');
            const snapStageToMap = (object, matchWidth = false) => {
                if (!object) return false;
                const target = mapRenderData.find((map) => String(map.id) === String(object.snapMapId)) || mapRenderData[0];
                if (!target) return false;
                const geometry = buildMapGeometry(target);
                const bottomLeft = geometry.front[3];
                const bottomRight = geometry.front[2];
                const bottomCenter = {
                    x: (bottomLeft.x + bottomRight.x) / 2,
                    y: (bottomLeft.y + bottomRight.y) / 2,
                    z: (bottomLeft.z + bottomRight.z) / 2
                };
                const targetRotation = Number(target.transform?.rotY) || 0;
                const rotationRad = degToRad(targetRotation);
                const deckDepth = Math.max(0.2, Number(object.depth) || 1);
                const deckHeight = Math.max(0.1, Number(object.height) || 0.2);
                const gap = Math.max(0, Number(object.snapGap) || 0);
                object.x = bottomCenter.x - (Math.sin(rotationRad) * deckDepth / 2);
                object.y = bottomCenter.y - gap - (deckHeight / 2);
                object.z = bottomCenter.z - (Math.cos(rotationRad) * deckDepth / 2);
                object.rotY = targetRotation;
                object.snapMapId = target.id;
                if (matchWidth) object.width = Math.max(0.2, target.widthM * Math.max(0.2, Math.min(3, Number(target.transform?.scale) || 1)));
                return true;
            };
            if (addDeckBtn) addDeckBtn.addEventListener('click', () => {
                pushView3dHistory();
                const id = `deck-${Date.now()}`;
                s.stageObjects.push({
                    id,
                    type: 'deck',
                    name: `Deck ${s.stageObjects.length + 1}`,
                    width: Math.max(4, Math.ceil(totalWidthM + 2)),
                    depth: 4,
                    height: 1,
                    x: 0,
                    y: floorY + 0.5,
                    z: 1.5,
                    rotY: 0,
                    snapGap: 0,
                    snapMapId: mapRenderData[0]?.id || '',
                    color: '#334155'
                });
                s.selectedStageObjectId = id;
                s.selectedMapId = '';
                persistProjects();
                render3DViewTab();
            });
            container.querySelectorAll('.view3d-stage-card').forEach((card) => {
                card.addEventListener('click', (event) => {
                    if (event.target.closest('input, button')) return;
                    s.selectedStageObjectId = String(card.getAttribute('data-stageid') || '');
                    s.selectedMapId = '';
                    render3DViewTab();
                });
            });
            container.querySelectorAll('.view3d-delete-stage').forEach((button) => {
                button.addEventListener('click', () => {
                    const id = String(button.getAttribute('data-stageid') || '');
                    pushView3dHistory();
                    s.stageObjects = s.stageObjects.filter((object) => String(object.id) !== id);
                    if (String(s.selectedStageObjectId) === id) s.selectedStageObjectId = '';
                    persistProjects();
                    render3DViewTab();
                });
            });
            container.querySelectorAll('.view3d-stage-color').forEach((input) => {
                input.addEventListener('input', () => {
                    const object = s.stageObjects.find((item) => String(item.id) === String(input.getAttribute('data-stageid')));
                    if (object) object.color = input.value;
                });
                input.addEventListener('change', () => persistProjects());
            });
            container.querySelectorAll('.view3d-stage-input').forEach((input) => {
                input.addEventListener('change', () => {
                    const object = s.stageObjects.find((item) => String(item.id) === String(input.getAttribute('data-stageid')));
                    const field = String(input.getAttribute('data-field') || '');
                    if (!object || !field) return;
                    pushView3dHistory();
                    let value = Number(input.value) || 0;
                    if (field === 'width' || field === 'depth') value = Math.max(0.2, Math.min(100, value));
                    if (field === 'height') value = Math.max(0.1, Math.min(20, value));
                    if (field === 'x' || field === 'y' || field === 'z') value = Math.max(-100, Math.min(100, value));
                    if (field === 'rotY') value = Math.max(-360, Math.min(360, value));
                    object[field] = value;
                    persistProjects();
                    render3DViewTab();
                });
            });
            container.querySelectorAll('.view3d-snap-map').forEach((select) => {
                select.addEventListener('change', () => {
                    const object = s.stageObjects.find((item) => String(item.id) === String(select.getAttribute('data-stageid')));
                    if (!object) return;
                    object.snapMapId = select.value;
                    persistProjects();
                });
            });
            container.querySelectorAll('.view3d-snap-gap').forEach((input) => {
                input.addEventListener('change', () => {
                    const object = s.stageObjects.find((item) => String(item.id) === String(input.getAttribute('data-stageid')));
                    if (!object) return;
                    object.snapGap = Math.max(0, Math.min(10, Number(input.value) || 0));
                    input.value = Number(object.snapGap).toFixed(2);
                    persistProjects();
                });
            });
            container.querySelectorAll('.view3d-snap-stage').forEach((button) => {
                button.addEventListener('click', () => {
                    const object = s.stageObjects.find((item) => String(item.id) === String(button.getAttribute('data-stageid')));
                    if (object) pushView3dHistory();
                    if (!snapStageToMap(object, false)) return;
                    s.selectedStageObjectId = object.id;
                    s.selectedMapId = '';
                    persistProjects();
                    render3DViewTab();
                });
            });
            container.querySelectorAll('.view3d-match-stage').forEach((button) => {
                button.addEventListener('click', () => {
                    const object = s.stageObjects.find((item) => String(item.id) === String(button.getAttribute('data-stageid')));
                    if (object) pushView3dHistory();
                    if (!snapStageToMap(object, true)) return;
                    s.selectedStageObjectId = object.id;
                    s.selectedMapId = '';
                    persistProjects();
                    render3DViewTab();
                });
            });

            const depthScaleEl = document.getElementById('view3d-depth-scale');
            if (depthScaleEl) depthScaleEl.addEventListener('input', () => {
                s.depthScale = Number(depthScaleEl.value) || 1;
                const depthValEl = document.getElementById('view3d-depth-val');
                if (depthValEl) depthValEl.textContent = `${(Number(s.depthScale) || 1).toFixed(1)}\u00d7`;
                render3DViewTab();
            });

            const resetBtn = document.getElementById('view3d-reset');
            if (resetBtn) {
                resetBtn.addEventListener('click', () => {
                    pushView3dHistory();
                    s.rotX = -12;
                    s.rotY = 28;
                    s.panX = 0;
                    s.panY = 0;
                    s.distance = 9;
                    s.toolMode = 'orbit';
                    s.selectedMapId = mapRenderData[0] ? String(mapRenderData[0].id) : '';
                    Object.keys(s.mapTransforms || {}).forEach((key) => { s.mapTransforms[key] = { x: 0, y: 0, z: 0, rotY: 0, rotX: 0, rotZ: 0, scale: 1 }; });
                    syncUi();
                    render3DViewTab();
                });
            }

            // Save PNG / JPG of the current 3D view
            const exportView = (format) => {
                try {
                    const src = document.getElementById('view3d-canvas');
                    if (!src || !src.width || !src.height) { showNotification('3D view is not ready yet.'); return; }
                    drawScene({ hideHelpers: true });
                    const out = document.createElement('canvas');
                    out.width = src.width; out.height = src.height;
                    const octx = out.getContext('2d');
                    if (format === 'jpeg') { octx.fillStyle = '#070b14'; octx.fillRect(0, 0, out.width, out.height); }
                    octx.drawImage(src, 0, 0);
                    drawScene();
                    try { applyDemoWatermarkToCanvas(out); } catch(_) {}
                    const mime = format === 'jpeg' ? 'image/jpeg' : 'image/png';
                    const ext = format === 'jpeg' ? 'jpg' : 'png';
                    const quality = format === 'jpeg' ? 0.95 : undefined;
                    out.toBlob((blob) => {
                        if (!blob) { showNotification('Export failed.'); return; }
                        const url = URL.createObjectURL(blob);
                        const a = document.createElement('a');
                        const base = (activeMap?.name || '3d-view').replace(/[^a-z0-9_\-]+/gi, '_');
                        a.href = url; a.download = `${base}-3d.${ext}`;
                        document.body.appendChild(a); a.click();
                        setTimeout(() => { try { URL.revokeObjectURL(url); } catch(_) {}; a.remove(); }, 500);
                        showNotification(`Saved ${ext.toUpperCase()}.`);
                    }, mime, quality);
                } catch (e) {
                    console.warn('3D export failed', e);
                    showNotification('Export failed.');
                }
            };
            const savePngBtn3d = document.getElementById('view3d-save-png');
            const saveJpgBtn3d = document.getElementById('view3d-save-jpg');
            if (savePngBtn3d) savePngBtn3d.addEventListener('click', () => exportView('png'));
            if (saveJpgBtn3d) saveJpgBtn3d.addEventListener('click', () => exportView('jpeg'));

            // Camera view save/recall/delete
            const clearCamsBtn = document.getElementById('view3d-clear-cams');
            if (clearCamsBtn) clearCamsBtn.addEventListener('click', () => {
                if (!confirm('Remove all saved camera views?')) return;
                s.savedCameraViews = [];
                render3DViewTab();
            });
            const saveCamBtn = document.getElementById('view3d-save-cam');
            if (saveCamBtn) saveCamBtn.addEventListener('click', () => {
                showInputModal('Save Camera View', `View ${(s.savedCameraViews.length + 1)}`, (name) => {
                    if (!name || !name.trim()) return;
                    s.savedCameraViews.push({ name: name.trim(), rotX: Number(s.rotX)||0, rotY: Number(s.rotY)||0, panX: Number(s.panX)||0, panY: Number(s.panY)||0, distance: Number(s.distance)||9 });
                    persistProjects();
                    render3DViewTab();
                });
            });
            container.querySelectorAll('.view3d-recall-cam').forEach(btn => {
                btn.addEventListener('click', () => {
                    const idx = Number(btn.getAttribute('data-camidx'));
                    const v = (s.savedCameraViews||[])[idx];
                    if (!v) return;
                    s.rotX = v.rotX; s.rotY = v.rotY; s.panX = v.panX; s.panY = v.panY; s.distance = v.distance;
                });
            });
            container.querySelectorAll('.view3d-delete-cam').forEach(btn => {
                btn.addEventListener('click', () => {
                    const idx = Number(btn.getAttribute('data-camidx'));
                    s.savedCameraViews.splice(idx, 1);
                    persistProjects();
                    render3DViewTab();
                });
            });

            // Map card click to select
            container.querySelectorAll('.view3d-map-card').forEach((card) => {
                card.addEventListener('click', (e) => {
                    if (e.target.tagName === 'INPUT') return;
                    const mapId = card.getAttribute('data-mapid');
                    if (mapId) {
                        selectMapForSnapping(mapId);
                        syncUi();
                        render3DViewTab();
                    }
                });
            });

            // Per-map transform inputs
            container.querySelectorAll('.view3d-tf-input').forEach((inp) => {
                inp.addEventListener('change', () => {
                    const mapId = inp.getAttribute('data-mapid');
                    const field = inp.getAttribute('data-field');
                    if (!mapId || !field) return;
                    if (!s.mapTransforms[mapId]) s.mapTransforms[mapId] = { x: 0, y: 0, z: 0, rotY: 0, rotX: 0, rotZ: 0, scale: 1 };
                    pushView3dHistory();
                    let val = Number(inp.value) || 0;
                    if (field === 'scale') val = Math.max(0.2, Math.min(3, val));
                    if (field === 'x' || field === 'y' || field === 'z') val = Math.max(-MAP_POSITION_LIMIT, Math.min(MAP_POSITION_LIMIT, val));
                    if (field === 'rotX' || field === 'rotZ') val = Math.max(-180, Math.min(180, val));
                    s.mapTransforms[mapId][field] = val;
                    persistProjects();
                    syncUi();
                });
            });

            let rafId = 0;
            let lastRenderSignature = '';
            let lastSignatureCheckAt = 0;
            const IDLE_SIGNATURE_INTERVAL_MS = 100;
            const getRenderSignature = () => JSON.stringify([
                canvas.clientWidth,
                canvas.clientHeight,
                Number(s.rotX) || 0,
                Number(s.rotY) || 0,
                Number(s.panX) || 0,
                Number(s.panY) || 0,
                Number(s.distance) || 9,
                !!s.showGrid,
                !!s.showAxes,
                !!s.showUV,
                Number(s.uvOpacity) || 82,
                Number(s.gridSizeM) || 1,
                String(s.backgroundTopColor || ''),
                String(s.backgroundBottomColor || ''),
                String(s.gridMinorColor || ''),
                String(s.gridMajorColor || ''),
                String(s.labelAccentColor || ''),
                Number(s.gridOpacity) || 0,
                Number(s.depthScale) || 1,
                String(s.selectedMapId || ''),
                String(s.selectedStageObjectId || ''),
                String(s.toolMode || 'orbit'),
                s.mapTransforms || {},
                s.stageObjects || []
            ]);
            const tick = (timestamp) => {
                // --- Smooth animation updates ---
                // 1. Smooth zoom (lerp distance toward target)
                const curDist = Number(s.distance) || 9;
                const zoomAnimating = Math.abs(curDist - targetDist) > 0.01;
                if (zoomAnimating) {
                    s.distance = curDist + (targetDist - curDist) * ZOOM_LERP;
                } else {
                    s.distance = targetDist;
                }
                // 2. Smooth view preset transition
                const viewAnimating = !isNaN(animRotX) && !isNaN(animRotY);
                if (viewAnimating) {
                    const rx = Number(s.rotX) || 0;
                    const ry = Number(s.rotY) || 0;
                    // Find shortest rotation path for Y
                    let dRotY = animRotY - ry;
                    if (dRotY > 180) dRotY -= 360;
                    if (dRotY < -180) dRotY += 360;
                    const newRx = rx + (animRotX - rx) * LERP_SPEED;
                    const newRy = ry + dRotY * LERP_SPEED;
                    s.rotX = Math.max(-89, Math.min(89, newRx));
                    s.rotY = newRy;
                    // Check if close enough to stop
                    if (Math.abs(animRotX - newRx) < 0.1 && Math.abs(dRotY) < 0.1) {
                        s.rotX = animRotX; s.rotY = animRotY;
                        animRotX = NaN; animRotY = NaN;
                    }
                }
                const interactionActive = dragging || zoomAnimating || viewAnimating;
                if (interactionActive || timestamp - lastSignatureCheckAt >= IDLE_SIGNATURE_INTERVAL_MS) {
                    lastSignatureCheckAt = timestamp;
                    const renderSignature = getRenderSignature();
                    if (renderSignature !== lastRenderSignature) {
                        drawScene();
                        lastRenderSignature = renderSignature;
                    }
                }
                rafId = requestAnimationFrame(tick);
            };
            rafId = requestAnimationFrame(tick);

            view3dRuntime = {
                dispose: () => {
                    if (rafId) cancelAnimationFrame(rafId);
                    canvas.removeEventListener('mousedown', onDown);
                    canvas.removeEventListener('mousemove', onHover);
                    window.removeEventListener('mousemove', onMove);
                    window.removeEventListener('mouseup', onUp);
                    canvas.removeEventListener('wheel', onWheel);
                    window.removeEventListener('resize', fitCanvas);
                    window.removeEventListener('keydown', keydownHandler);
                    document.removeEventListener('mousedown', onDocMouseDown);
                }
            };
        };

        const render3DViewTab = () => {
            const container = mainContent.view3d;
            if (!container) return;
            let activeMap = getActivePixelMap();
            const activeProject = state.projects.find(p => String(p.id) === String(state.activeProjectId));
            if (!activeMap && activeProject && Array.isArray(activeProject.pixelMaps) && activeProject.pixelMaps.length > 0) {
                state.activePixelMapId = activeProject.pixelMaps[0].id;
                activeMap = activeProject.pixelMaps[0];
            }
            if (!activeMap) {
                if (view3dRuntime && typeof view3dRuntime.dispose === 'function') {
                    try { view3dRuntime.dispose(); } catch (_) {}
                    view3dRuntime = null;
                }
                container.innerHTML = `<div class="text-center p-8 bg-gray-800 rounded-lg"><p class="text-gray-500">Please create or select an LED Screen in Sheets or Pixel Designer first.</p></div>`;
                return;
            }

            if (window.View3DPro && typeof window.View3DPro.render === 'function') {
                if (view3dRuntime && typeof view3dRuntime.dispose === 'function') {
                    try { view3dRuntime.dispose(); } catch (_) {}
                    view3dRuntime = null;
                }
                view3dRuntime = window.View3DPro.render(container, activeMap, activeProject, {
                    state,
                    calculateLayout,
                    drawVisualizerCanvas,
                    persistProjects,
                    showNotification,
                    showInputModal,
                    applyDemoWatermarkToCanvas,
                    switchTab,
                    escapeHtml
                });
                return;
            }

            render3DViewTabProfessional(container, activeMap, activeProject);
            return;

        };

        /* Legacy 3D implementation removed.

            if (!state.view3dState || typeof state.view3dState !== 'object') {
                state.view3dState = {
                    rotX: 0,
                    rotY: 0,
                    rotZ: 0,
                    panX: 0,
                    panY: 0,
                    distance: 9,
                    autoRevolve: false,
                    revolveSpeed: 20,
                    showGrid: true,
                    showAxes: true,
                    showUV: true,
                    uvOpacity: 82,
                    gridDensity: 12,
                    useUnity: false,
                    unityLoaderUrl: 'unity-webgl/Build/build.loader.js',
                    unityDataUrl: 'unity-webgl/Build/build.data',
                    unityFrameworkUrl: 'unity-webgl/Build/build.framework.js',
                    unityCodeUrl: 'unity-webgl/Build/build.wasm',
                    composeMapIds: [String(activeMap.id)],
                    composePlacement: 'right',
                    composeGapPx: 0,
                    mapTransforms: {}
                };
            }

            if (typeof state.view3dState.showGrid === 'undefined') state.view3dState.showGrid = true;
            if (typeof state.view3dState.showAxes === 'undefined') state.view3dState.showAxes = true;
            if (typeof state.view3dState.showUV === 'undefined') state.view3dState.showUV = true;
            if (!Number.isFinite(state.view3dState.uvOpacity)) state.view3dState.uvOpacity = 82;
            if (!Number.isFinite(state.view3dState.gridDensity)) state.view3dState.gridDensity = 12;
            if (typeof state.view3dState.useUnity === 'undefined') state.view3dState.useUnity = false;
            if (!state.view3dState.unityLoaderUrl) state.view3dState.unityLoaderUrl = 'unity-webgl/Build/build.loader.js';
            if (!state.view3dState.unityDataUrl) state.view3dState.unityDataUrl = 'unity-webgl/Build/build.data';
            if (!state.view3dState.unityFrameworkUrl) state.view3dState.unityFrameworkUrl = 'unity-webgl/Build/build.framework.js';
            if (!state.view3dState.unityCodeUrl) state.view3dState.unityCodeUrl = 'unity-webgl/Build/build.wasm';
            if (!Array.isArray(state.view3dState.composeMapIds) || !state.view3dState.composeMapIds.length) state.view3dState.composeMapIds = [String(activeMap.id)];
            if (!state.view3dState.composePlacement) state.view3dState.composePlacement = 'right';
            if (!Number.isFinite(Number(state.view3dState.composeGapPx))) state.view3dState.composeGapPx = 0;
            if (!state.view3dState.mapTransforms || typeof state.view3dState.mapTransforms !== 'object') state.view3dState.mapTransforms = {};
            if (!state.view3dState.toolMode) state.view3dState.toolMode = 'orbit';
            if (!state.view3dState.selectedMapId) state.view3dState.selectedMapId = '';

            const mapPool = Array.isArray(activeProject?.pixelMaps) ? activeProject.pixelMaps : [activeMap];
            const mapById = new Map(mapPool.map(m => [String(m.id), m]));
            const selectedIdSet = new Set(state.view3dState.composeMapIds.map(String));
            if (!selectedIdSet.size) selectedIdSet.add(String(activeMap.id));
            const selectedMaps = mapPool.filter(m => selectedIdSet.has(String(m.id)));
            if (!selectedMaps.length) selectedMaps.push(activeMap);
            if (!selectedMaps.some(m => String(m.id) === String(activeMap.id))) selectedMaps.unshift(activeMap);

            const mapCalcsList = selectedMaps.map(m => ({ map: m, calcs: calculateLayout(m) || {} }));
            const placement = String(state.view3dState.composePlacement || 'right');
            const horizontal = placement === 'right' || placement === 'left';
            const dir = placement === 'left' || placement === 'top' ? -1 : 1;
            const gapM = Math.max(0, Number(state.view3dState.composeGapPx) || 0) / 1000;

            const mapRenderData = [];
            let cursor = 0;
            mapCalcsList.forEach((item) => {
                const widthM = Math.max(0.1, Number(item.calcs.screenWidthMm || 0) / 1000 || 0.1);
                const heightM = Math.max(0.1, Number(item.calcs.screenHeightMm || 0) / 1000 || 0.1);
                const key = String(item.map.id);
                if (!state.view3dState.mapTransforms[key]) state.view3dState.mapTransforms[key] = { x: 0, z: 0, rotY: 0, scale: 1 };
                if (!Number.isFinite(Number(state.view3dState.mapTransforms[key].rotY))) state.view3dState.mapTransforms[key].rotY = 0;
                if (!Number.isFinite(Number(state.view3dState.mapTransforms[key].scale))) state.view3dState.mapTransforms[key].scale = 1;
                const baseX = horizontal ? (cursor + widthM / 2) * dir : 0;
                const baseY = horizontal ? 0 : -(cursor + heightM / 2) * dir;
                mapRenderData.push({
                    id: key,
                    map: item.map,
                    calcs: item.calcs,
                    widthM,
                    heightM,
                    baseX,
                    baseY,
                    transform: state.view3dState.mapTransforms[key]
                });
                cursor += (horizontal ? widthM : heightM) + gapM;
            });

            const totalSpanM = Math.max(0.1, cursor - gapM);
            mapRenderData.forEach((m) => {
                if (horizontal) {
                    m.baseX -= (totalSpanM / 2) * dir;
                } else {
                    m.baseY += (totalSpanM / 2) * dir;
                }
            });

            if (!mapRenderData.some(m => String(m.id) === String(state.view3dState.selectedMapId || ''))) {
                state.view3dState.selectedMapId = mapRenderData[0] ? String(mapRenderData[0].id) : '';
            }

            const totalWidthM = horizontal
                ? mapRenderData.reduce((s, it) => s + it.widthM, 0) + Math.max(0, mapRenderData.length - 1) * gapM
                : Math.max(0.1, ...mapRenderData.map(it => it.widthM));
            const totalHeightM = horizontal
                ? Math.max(0.1, ...mapRenderData.map(it => it.heightM))
                : mapRenderData.reduce((s, it) => s + it.heightM, 0) + Math.max(0, mapRenderData.length - 1) * gapM;

            const calcs = calculateLayout(activeMap) || {};
            const wallWidthM = Math.max(0.1, totalWidthM || (Number(calcs.screenWidthMm || 0) / 1000));
            const wallHeightM = Math.max(0.1, totalHeightM || (Number(calcs.screenHeightMm || 0) / 1000));
            const panelCols = Math.max(1, Number(calcs.panelsHorizontally) || 1);
            const panelRows = Math.max(1, Number(calcs.panelsVertically) || 1);

            const composeOptionsHtml = mapPool.map((m) => {
                const sel = selectedIdSet.has(String(m.id)) ? 'selected' : '';
                return `<option value="${String(m.id)}" ${sel}>${escapeHtml(m.name || `Map ${m.id}`)}</option>`;
            }).join('');

            const selectedMapName = (() => {
                const found = mapRenderData.find(m => String(m.id) === String(state.view3dState.selectedMapId || ''));
                return found ? (found.map.name || `Map ${found.id}`) : 'None';
            })();

            if (view3dRuntime && typeof view3dRuntime.dispose === 'function') {
                try { view3dRuntime.dispose(); } catch (_) {}
                view3dRuntime = null;
            }

            container.innerHTML = `
                <div class="bg-gray-800 p-6 rounded-xl shadow-lg">
                    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
                        <h2 class="text-2xl font-bold">3D View: <span class="text-cyan-300">${escapeHtml(activeMap.name || 'Pixel Map')}</span></h2>
                        <div class="text-xs text-gray-300">Click object to select • W/E/R tools • Left-drag transform • Shift/Right-drag pan • Wheel zoom</div>
                    </div>
                    <div class="grid grid-cols-1 xl:grid-cols-[1fr_360px] gap-4">
                        <div class="relative rounded-xl border border-gray-700 bg-gray-950/70 p-3">
                            <canvas id="view3d-canvas" class="w-full h-[64vh] rounded-lg bg-[#070b14]" style="touch-action:none;"></canvas>
                            <div id="view3d-unity-host" class="hidden w-full h-[64vh] rounded-lg bg-black overflow-hidden"></div>
                            <div class="absolute top-3 right-3 z-20 bg-gray-900/90 border border-gray-700 rounded-lg p-2 w-[138px]">
                                <div class="text-[10px] text-gray-300 mb-1">View Cube</div>
                                <div class="grid grid-cols-3 gap-1">
                                    <button type="button" data-viewcube="top" class="text-[10px] rounded bg-gray-800 hover:bg-gray-700 text-gray-100 px-1 py-1">Top</button>
                                    <button type="button" data-viewcube="front" class="text-[10px] rounded bg-gray-800 hover:bg-gray-700 text-gray-100 px-1 py-1">Front</button>
                                    <button type="button" data-viewcube="right" class="text-[10px] rounded bg-gray-800 hover:bg-gray-700 text-gray-100 px-1 py-1">Right</button>
                                    <button type="button" data-viewcube="left" class="text-[10px] rounded bg-gray-800 hover:bg-gray-700 text-gray-100 px-1 py-1">Left</button>
                                    <button type="button" data-viewcube="back" class="text-[10px] rounded bg-gray-800 hover:bg-gray-700 text-gray-100 px-1 py-1">Back</button>
                                    <button type="button" data-viewcube="bottom" class="text-[10px] rounded bg-gray-800 hover:bg-gray-700 text-gray-100 px-1 py-1">Bottom</button>
                                </div>
                            </div>
                        </div>
                        <div class="rounded-xl border border-gray-700 bg-gray-900/60 p-4 space-y-4">
                            <div class="text-sm text-gray-200 font-semibold">Render Backend</div>
                            <div class="space-y-2">
                                <select id="view3d-backend" class="w-full bg-gray-900 border border-gray-700 rounded px-2 py-2 text-sm text-gray-100">
                                    <option value="native" ${state.view3dState.useUnity ? '' : 'selected'}>Native Canvas 3D</option>
                                    <option value="unity" ${state.view3dState.useUnity ? 'selected' : ''}>Unity WebGL</option>
                                </select>
                                <div id="view3d-unity-config" class="space-y-2 ${state.view3dState.useUnity ? '' : 'hidden'}">
                                    <input id="view3d-unity-loader" value="${escapeHtml(state.view3dState.unityLoaderUrl || '')}" class="w-full bg-gray-900 border border-gray-700 rounded px-2 py-1 text-xs text-gray-100" placeholder="unity-webgl/Build/*.loader.js">
                                    <input id="view3d-unity-data" value="${escapeHtml(state.view3dState.unityDataUrl || '')}" class="w-full bg-gray-900 border border-gray-700 rounded px-2 py-1 text-xs text-gray-100" placeholder="unity-webgl/Build/*.data">
                                    <input id="view3d-unity-framework" value="${escapeHtml(state.view3dState.unityFrameworkUrl || '')}" class="w-full bg-gray-900 border border-gray-700 rounded px-2 py-1 text-xs text-gray-100" placeholder="unity-webgl/Build/*.framework.js">
                                    <input id="view3d-unity-code" value="${escapeHtml(state.view3dState.unityCodeUrl || '')}" class="w-full bg-gray-900 border border-gray-700 rounded px-2 py-1 text-xs text-gray-100" placeholder="unity-webgl/Build/*.wasm">
                                    <button id="view3d-unity-load" class="w-full px-3 py-2 rounded-lg bg-cyan-700 hover:bg-cyan-600 text-xs text-white">Load Unity WebGL</button>
                                    <button id="view3d-unity-autodetect" class="w-full px-3 py-2 rounded-lg bg-sky-700 hover:bg-sky-600 text-xs text-white">Auto-detect Unity Build</button>
                                    <div id="view3d-unity-status" class="text-[11px] text-cyan-200/90 leading-relaxed">Set paths and click Load Unity WebGL.</div>
                                </div>
                            </div>
                            <div class="text-sm text-gray-200 font-semibold">3D Layout Composer</div>
                            <div class="space-y-2">
                                <select id="view3d-compose-maps" class="w-full bg-gray-900 border border-gray-700 rounded px-2 py-2 text-xs text-gray-100" multiple size="6" title="Select maps to compose in 3D UV layout">
                                    ${composeOptionsHtml}
                                </select>
                                <div class="grid grid-cols-2 gap-2">
                                    <select id="view3d-compose-placement" class="bg-gray-900 border border-gray-700 rounded px-2 py-2 text-xs text-gray-100">
                                        <option value="right" ${placement==='right'?'selected':''}>Right</option>
                                        <option value="left" ${placement==='left'?'selected':''}>Left</option>
                                        <option value="top" ${placement==='top'?'selected':''}>Top</option>
                                        <option value="bottom" ${placement==='bottom'?'selected':''}>Bottom</option>
                                    </select>
                                    <input id="view3d-compose-gap" type="number" min="0" max="2000" step="1" value="${Math.round(Number(state.view3dState.composeGapPx) || 0)}" class="bg-gray-900 border border-gray-700 rounded px-2 py-2 text-xs text-gray-100" placeholder="Gap px">
                                </div>
                            </div>
                            <div class="text-sm text-gray-200 font-semibold">Transform Tools</div>
                            <div class="space-y-2">
                                <div class="grid grid-cols-4 gap-2">
                                    <button type="button" id="view3d-tool-orbit" class="view3d-tool-btn px-2 py-2 rounded bg-gray-800 hover:bg-gray-700 text-xs text-gray-100" data-tool="orbit">Orbit (Q)</button>
                                    <button type="button" id="view3d-tool-move" class="view3d-tool-btn px-2 py-2 rounded bg-gray-800 hover:bg-gray-700 text-xs text-gray-100" data-tool="move">Move (W)</button>
                                    <button type="button" id="view3d-tool-rotate" class="view3d-tool-btn px-2 py-2 rounded bg-gray-800 hover:bg-gray-700 text-xs text-gray-100" data-tool="rotate">Rotate (E)</button>
                                    <button type="button" id="view3d-tool-scale" class="view3d-tool-btn px-2 py-2 rounded bg-gray-800 hover:bg-gray-700 text-xs text-gray-100" data-tool="scale">Scale (R)</button>
                                </div>
                                <div class="text-xs text-gray-300">Selected: <span id="view3d-selected-map" class="text-cyan-300">${escapeHtml(selectedMapName)}</span></div>
                            </div>
                            <div class="flex items-center gap-2 pt-1">
                                <label class="inline-flex items-center gap-2 text-xs text-gray-200">
                                    <input id="view3d-auto-revolve" type="checkbox" ${state.view3dState.autoRevolve ? 'checked' : ''} class="accent-cyan-400">
                                    Auto Revolve
                                </label>
                                <input id="view3d-revolve-speed" type="range" min="5" max="90" step="1" value="${Number(state.view3dState.revolveSpeed) || 20}" class="flex-1 accent-cyan-400">
                            </div>
                            <div class="border-t border-gray-700 pt-3 space-y-3">
                                <label class="inline-flex items-center gap-2 text-xs text-gray-200"><input id="view3d-show-grid" type="checkbox" ${state.view3dState.showGrid ? 'checked' : ''} class="accent-cyan-400">Depth Grid</label>
                                <label class="inline-flex items-center gap-2 text-xs text-gray-200"><input id="view3d-show-axes" type="checkbox" ${state.view3dState.showAxes ? 'checked' : ''} class="accent-cyan-400">X / Y / Z Axis</label>
                                <label class="inline-flex items-center gap-2 text-xs text-gray-200"><input id="view3d-show-uv" type="checkbox" ${state.view3dState.showUV ? 'checked' : ''} class="accent-cyan-400">UV Overlay (Pixel Map)</label>
                                <label class="block text-xs text-gray-300">UV Opacity: <span id="view3d-uv-opacity-val">${Math.round(Number(state.view3dState.uvOpacity) || 82)}%</span></label>
                                <input id="view3d-uv-opacity" type="range" min="10" max="100" step="1" value="${Number(state.view3dState.uvOpacity) || 82}" class="w-full accent-cyan-400">
                                <label class="block text-xs text-gray-300">Grid Density: <span id="view3d-grid-density-val">${Math.round(Number(state.view3dState.gridDensity) || 12)}</span></label>
                                <input id="view3d-grid-density" type="range" min="4" max="30" step="1" value="${Number(state.view3dState.gridDensity) || 12}" class="w-full accent-cyan-400">
                            </div>
                            <button id="view3d-reset" class="w-full px-3 py-2 rounded-lg bg-gray-700 hover:bg-gray-600 text-sm text-white">Reset View</button>
                            <div class="text-xs text-gray-400 leading-relaxed">Layout: ${wallWidthM.toFixed(2)}m × ${wallHeightM.toFixed(2)}m • Source Maps: ${selectedMaps.length} • Base Panels: ${panelCols} × ${panelRows}</div>
                        </div>
                    </div>
                </div>`;

            const canvas = document.getElementById('view3d-canvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            if (!ctx) return;
            const unityHost = document.getElementById('view3d-unity-host');

            const fitCanvas = () => {
                const dpr = window.devicePixelRatio || 1;
                const r = canvas.getBoundingClientRect();
                canvas.width = Math.max(1, Math.round(r.width * dpr));
                canvas.height = Math.max(1, Math.round(r.height * dpr));
                ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            };

            const s = state.view3dState;
            const wallDepthM = Math.max(0.08, Math.min(0.8, Math.min(wallWidthM, wallHeightM) * 0.08));
            const modelRadius = Math.max(0.5, Math.sqrt(((wallWidthM * 0.5) ** 2) + ((wallHeightM * 0.5) ** 2) + ((wallDepthM * 0.5) ** 2)));
            let unityInstance = null;
            let unityScriptEl = null;

            const setUnityStatus = (msg) => {
                const el = document.getElementById('view3d-unity-status');
                if (el) el.textContent = msg;
            };

            const setBackendUi = () => {
                const unityCfg = document.getElementById('view3d-unity-config');
                if (canvas) canvas.classList.toggle('hidden', !!s.useUnity);
                if (unityHost) unityHost.classList.toggle('hidden', !s.useUnity);
                if (unityCfg) unityCfg.classList.toggle('hidden', !s.useUnity);
            };

            const unloadUnityInstance = async () => {
                try {
                    if (unityInstance && typeof unityInstance.Quit === 'function') {
                        await unityInstance.Quit();
                    }
                } catch (_) {}
                unityInstance = null;
                if (unityHost) unityHost.innerHTML = '';
            };

            const loadScript = (src) => new Promise((resolve, reject) => {
                if (!src) {
                    reject(new Error('Missing Unity loader path'));
                    return;
                }
                if (unityScriptEl && unityScriptEl.getAttribute('src') === src) {
                    resolve();
                    return;
                }
                if (unityScriptEl && unityScriptEl.parentNode) {
                    try { unityScriptEl.parentNode.removeChild(unityScriptEl); } catch (_) {}
                    unityScriptEl = null;
                }
                const script = document.createElement('script');
                script.src = src;
                script.async = true;
                script.onload = () => { unityScriptEl = script; resolve(); };
                script.onerror = () => reject(new Error(`Failed to load Unity loader: ${src}`));
                document.head.appendChild(script);
            });

            const ensureUnityLoaded = async () => {
                setUnityStatus('Loading Unity loader...');
                await loadScript(String(s.unityLoaderUrl || '').trim());
                if (typeof window.createUnityInstance !== 'function') {
                    throw new Error('createUnityInstance is unavailable. Check loader path and Unity WebGL build files.');
                }
                if (!unityHost) throw new Error('Unity host element missing.');
                unityHost.innerHTML = '<canvas id="view3d-unity-canvas" style="width:100%;height:100%;display:block;background:#000"></canvas>';
                const unityCanvas = document.getElementById('view3d-unity-canvas');
                if (!unityCanvas) throw new Error('Unity canvas initialization failed.');
                const config = {
                    dataUrl: String(s.unityDataUrl || '').trim(),
                    frameworkUrl: String(s.unityFrameworkUrl || '').trim(),
                    codeUrl: String(s.unityCodeUrl || '').trim(),
                    streamingAssetsUrl: 'StreamingAssets',
                    companyName: 'Pixelogic',
                    productName: 'Pixelogic 3D',
                    productVersion: '1.0'
                };
                setUnityStatus('Initializing Unity runtime...');
                unityInstance = await window.createUnityInstance(unityCanvas, config, (progress) => {
                    const pct = Math.round((Number(progress) || 0) * 100);
                    setUnityStatus(`Unity loading ${pct}%`);
                });
                setUnityStatus('Unity loaded successfully.');
            };

            const uvTextureByMapId = new Map();
            mapRenderData.forEach((entry) => {
                try {
                    const textureCanvas = document.createElement('canvas');
                    const mapCalcs = entry.calcs || {};
                    const fixedScale = Math.max(0.08, Math.min(0.6, 700 / Math.max(1, Number(mapCalcs.totalResWidth) || 1)));
                    drawVisualizerCanvas(textureCanvas, entry.map, { fixedScale, suppressDetails: true });
                    const tCtx = textureCanvas.getContext('2d');
                    if (tCtx && textureCanvas.width > 0 && textureCanvas.height > 0) {
                        uvTextureByMapId.set(entry.id, {
                            width: textureCanvas.width,
                            height: textureCanvas.height,
                            data: tCtx.getImageData(0, 0, textureCanvas.width, textureCanvas.height).data
                        });
                    }
                } catch (_) {}
            });

            const degToRad = (deg) => deg * (Math.PI / 180);
            const mapHitRegions = [];
            const mapGeomById = new Map();

            const rotateYPoint = (p, angleDeg) => {
                const r = degToRad(Number(angleDeg) || 0);
                const c = Math.cos(r);
                const sn = Math.sin(r);
                return {
                    x: (p.x * c) + (p.z * sn),
                    y: p.y,
                    z: (-p.x * sn) + (p.z * c)
                };
            };

            const buildMapGeometry = (m) => {
                const tx = Number(m.transform?.x) || 0;
                const tz = Number(m.transform?.z) || 0;
                const rotY = Number(m.transform?.rotY) || 0;
                const scale = Math.max(0.2, Math.min(3, Number(m.transform?.scale) || 1));
                const center = { x: m.baseX + tx, y: m.baseY, z: tz };
                const halfMapW = (m.widthM * scale) / 2;
                const halfMapH = (m.heightM * scale) / 2;
                // Front face at z=0, extrude goes behind (positive Z = further from camera)
                const localFront = [
                    { x: -halfMapW, y: halfMapH, z: 0 },
                    { x: halfMapW, y: halfMapH, z: 0 },
                    { x: halfMapW, y: -halfMapH, z: 0 },
                    { x: -halfMapW, y: -halfMapH, z: 0 }
                ];
                const localBack = [
                    { x: -halfMapW, y: halfMapH, z: wallDepthM },
                    { x: halfMapW, y: halfMapH, z: wallDepthM },
                    { x: halfMapW, y: -halfMapH, z: wallDepthM },
                    { x: -halfMapW, y: -halfMapH, z: wallDepthM }
                ];
                const toWorld = (pt) => {
                    const rr = rotateYPoint(pt, rotY);
                    return { x: center.x + rr.x, y: center.y + rr.y, z: center.z + rr.z };
                };
                return {
                    center,
                    rotY,
                    scale,
                    front: localFront.map(toWorld),
                    back: localBack.map(toWorld)
                };
            };

            const lerpPoint3 = (a, b, t) => ({ x: a.x + ((b.x - a.x) * t), y: a.y + ((b.y - a.y) * t), z: a.z + ((b.z - a.z) * t) });

            const pointInPolygon2D = (pt, poly) => {
                let inside = false;
                for (let i = 0, j = poly.length - 1; i < poly.length; j = i++) {
                    const xi = poly[i].x;
                    const yi = poly[i].y;
                    const xj = poly[j].x;
                    const yj = poly[j].y;
                    const intersects = ((yi > pt.y) !== (yj > pt.y)) && (pt.x < (((xj - xi) * (pt.y - yi)) / ((yj - yi) || 1e-6)) + xi);
                    if (intersects) inside = !inside;
                }
                return inside;
            };
            const rotatePoint = (x, y, z) => {
                const rx = degToRad(Number(s.rotX) || 0);
                const ry = degToRad(Number(s.rotY) || 0);
                const rz = degToRad(Number(s.rotZ) || 0);

                let px = x, py = y, pz = z;
                const cosy = Math.cos(ry), siny = Math.sin(ry);
                const nx1 = px * cosy + pz * siny;
                const nz1 = -px * siny + pz * cosy;
                px = nx1;
                pz = nz1;

                const cosx = Math.cos(rx), sinx = Math.sin(rx);
                const ny2 = py * cosx - pz * sinx;
                const nz2 = py * sinx + pz * cosx;
                py = ny2;
                pz = nz2;

                const cosz = Math.cos(rz), sinz = Math.sin(rz);
                const nx3 = px * cosz - py * sinz;
                const ny3 = px * sinz + py * cosz;
                px = nx3;
                py = ny3;
                return { x: px, y: py, z: pz };
            };

            // Fixed FOV perspective: zoom only changes camera distance, not field of view
            const FOV_DEG = 50;
            const FOV_RAD = degToRad(FOV_DEG);
            const getZoomFactor = () => {
                const raw = Math.max(2, Math.min(18, Number(s.distance) || 9));
                return raw / 9;
            };
            const getCameraDistance = () => modelRadius * 2.8 * getZoomFactor();

            const project = (p, viewScale, cx, cy) => {
                const camDist = getCameraDistance();
                const eyeZ = p.z + camDist;
                const focalLength = viewScale / (2 * Math.tan(FOV_RAD / 2));
                const depth = Math.max(0.01, eyeZ);
                const scale = focalLength / depth;
                return {
                    x: cx + (p.x * scale) + (Number(s.panX) || 0),
                    y: cy - (p.y * scale) + (Number(s.panY) || 0)
                };
            };

            const getViewScale = (viewportW, viewportH) => {
                return Math.min(viewportW, viewportH);
            };

            const drawLine3D = (a, b, viewScale, cx, cy, color, width = 1, alpha = 1) => {
                const pa = project(rotatePoint(a.x, a.y, a.z), viewScale, cx, cy);
                const pb = project(rotatePoint(b.x, b.y, b.z), viewScale, cx, cy);
                ctx.save();
                ctx.globalAlpha = alpha;
                ctx.strokeStyle = color;
                ctx.lineWidth = width;
                ctx.beginPath();
                ctx.moveTo(pa.x, pa.y);
                ctx.lineTo(pb.x, pb.y);
                ctx.stroke();
                ctx.restore();
            };

            const drawQuad3D = (p1, p2, p3, p4, viewScale, cx, cy, fillColor, strokeColor = null, strokeWidth = 1, alpha = 1) => {
                const a = project(rotatePoint(p1.x, p1.y, p1.z), viewScale, cx, cy);
                const b = project(rotatePoint(p2.x, p2.y, p2.z), viewScale, cx, cy);
                const c = project(rotatePoint(p3.x, p3.y, p3.z), viewScale, cx, cy);
                const d = project(rotatePoint(p4.x, p4.y, p4.z), viewScale, cx, cy);
                ctx.save();
                ctx.globalAlpha = alpha;
                if (fillColor) {
                    ctx.fillStyle = fillColor;
                    ctx.beginPath();
                    ctx.moveTo(a.x, a.y);
                    ctx.lineTo(b.x, b.y);
                    ctx.lineTo(c.x, c.y);
                    ctx.lineTo(d.x, d.y);
                    ctx.closePath();
                    ctx.fill();
                }
                if (strokeColor) {
                    ctx.strokeStyle = strokeColor;
                    ctx.lineWidth = strokeWidth;
                    ctx.beginPath();
                    ctx.moveTo(a.x, a.y);
                    ctx.lineTo(b.x, b.y);
                    ctx.lineTo(c.x, c.y);
                    ctx.lineTo(d.x, d.y);
                    ctx.closePath();
                    ctx.stroke();
                }
                ctx.restore();
            };

            const sampleUvColor = (texture, u, v) => {
                if (!texture || !texture.data || texture.width < 1 || texture.height < 1) return null;
                const x = Math.max(0, Math.min(texture.width - 1, Math.round(u * (texture.width - 1))));
                const y = Math.max(0, Math.min(texture.height - 1, Math.round(v * (texture.height - 1))));
                const idx = (y * texture.width + x) * 4;
                const data = texture.data;
                const r = data[idx] || 0;
                const g = data[idx + 1] || 0;
                const b = data[idx + 2] || 0;
                return `rgb(${r}, ${g}, ${b})`;
            };

            const drawAxisLabel = (point, text, color, viewScale, cx, cy) => {
                const p = project(rotatePoint(point.x, point.y, point.z), viewScale, cx, cy);
                ctx.save();
                ctx.fillStyle = color;
                ctx.font = 'bold 12px Inter';
                ctx.fillText(text, p.x + 4, p.y - 4);
                ctx.restore();
            };

            const drawScene = () => {
                if (s.useUnity) return;
                const w = canvas.clientWidth || 1;
                const h = canvas.clientHeight || 1;
                const bg = ctx.createLinearGradient(0, 0, 0, h);
                bg.addColorStop(0, '#050a14');
                bg.addColorStop(1, '#0d1425');
                ctx.fillStyle = bg;
                ctx.fillRect(0, 0, w, h);

                const cx = w / 2;
                const cy = h / 2;
                const fitPoints = [];
                mapGeomById.clear();
                mapRenderData.forEach((m) => {
                    const geom = buildMapGeometry(m);
                    mapGeomById.set(String(m.id), geom);
                    fitPoints.push(...geom.front, ...geom.back);
                });
                if (!fitPoints.length) {
                    fitPoints.push(
                        { x: -0.5, y: 0.5, z: 0.25 },
                        { x: 0.5, y: 0.5, z: 0.25 },
                        { x: 0.5, y: -0.5, z: 0.25 },
                        { x: -0.5, y: -0.5, z: 0.25 }
                    );
                }
                const viewScale = getViewScale(w, h);

                const halfH = wallHeightM / 2;

                mapHitRegions.length = 0;

                if (s.showGrid) {
                    const floorY = -halfH - Math.max(0.12, wallHeightM * 0.2);
                    const span = Math.max(wallWidthM, wallHeightM) * 1.3;
                    const density = Math.max(4, Math.min(30, Math.round(Number(s.gridDensity) || 12)));
                    const step = Math.max(0.15, (span * 2) / (density * 2));
                    const lines = Math.min(80, Math.max(4, Math.ceil(span / step)));
                    for (let i = -lines; i <= lines; i++) {
                        const x = i * step;
                        const z = i * step;
                        drawLine3D({ x, y: floorY, z: -span }, { x, y: floorY, z: span }, viewScale, cx, cy, '#334155', 1, 0.48);
                        drawLine3D({ x: -span, y: floorY, z }, { x: span, y: floorY, z }, viewScale, cx, cy, '#334155', 1, 0.48);
                    }
                }

                mapRenderData.forEach((m) => {
                    const geom = mapGeomById.get(String(m.id)) || buildMapGeometry(m);
                    const front = geom.front;
                    const back = geom.back;
                    const isSelected = String(m.id) === String(s.selectedMapId || '');

                    const frontProjected = front.map((p) => project(rotatePoint(p.x, p.y, p.z), viewScale, cx, cy));
                    const frontDepth = front.reduce((sum, p) => sum + rotatePoint(p.x, p.y, p.z).z, 0) / front.length;
                    mapHitRegions.push({ id: String(m.id), poly: frontProjected, depth: frontDepth });

                    const tex = uvTextureByMapId.get(String(m.id));
                    if (s.showUV && tex) {
                        let uSteps = Math.max(8, Math.min(160, tex.width || 8));
                        let vSteps = Math.max(8, Math.min(160, tex.height || 8));
                        while ((uSteps * vSteps) > 5600) {
                            if (uSteps >= vSteps && uSteps > 8) uSteps -= 1;
                            else if (vSteps > 8) vSteps -= 1;
                            else break;
                        }
                        const uvAlpha = Math.max(0.1, Math.min(1, (Number(s.uvOpacity) || 82) / 100));
                        for (let yi = 0; yi < vSteps; yi++) {
                            const v0 = yi / vSteps;
                            const v1 = (yi + 1) / vSteps;
                            const leftTop = lerpPoint3(front[0], front[3], v0);
                            const rightTop = lerpPoint3(front[1], front[2], v0);
                            const leftBottom = lerpPoint3(front[0], front[3], v1);
                            const rightBottom = lerpPoint3(front[1], front[2], v1);
                            for (let xi = 0; xi < uSteps; xi++) {
                                const u0 = xi / uSteps;
                                const u1 = (xi + 1) / uSteps;
                                const p00 = lerpPoint3(leftTop, rightTop, u0);
                                const p10 = lerpPoint3(leftTop, rightTop, u1);
                                const p11 = lerpPoint3(leftBottom, rightBottom, u1);
                                const p01 = lerpPoint3(leftBottom, rightBottom, u0);
                                const color = sampleUvColor(tex, (u0 + u1) * 0.5, (v0 + v1) * 0.5) || '#1e293b';
                                drawQuad3D(
                                    p00,
                                    p10,
                                    p11,
                                    p01,
                                    viewScale,
                                    cx,
                                    cy,
                                    color,
                                    null,
                                    0,
                                    uvAlpha
                                );
                            }
                        }
                    } else {
                        drawQuad3D(front[0], front[1], front[2], front[3], viewScale, cx, cy, '#0f172a', null, 0, 0.65);
                    }

                    drawQuad3D(back[0], back[1], back[2], back[3], viewScale, cx, cy, '#0a1324', null, 0, 0.35);
                    const edges = [[0, 1], [1, 2], [2, 3], [3, 0]];
                    edges.forEach(([a, b]) => drawLine3D(front[a], front[b], viewScale, cx, cy, '#7dd3fc', 2, 0.95));
                    edges.forEach(([a, b]) => drawLine3D(back[a], back[b], viewScale, cx, cy, '#334155', 1.4, 0.8));
                    for (let i = 0; i < 4; i++) drawLine3D(front[i], back[i], viewScale, cx, cy, '#475569', 1.3, 0.78);

                    const perMapCols = Math.max(1, Number(m.calcs?.panelsHorizontally) || 1);
                    const perMapRows = Math.max(1, Number(m.calcs?.panelsVertically) || 1);
                    const maxGridLines = 180;
                    if (perMapCols > 1) {
                        const count = Math.min(perMapCols - 1, maxGridLines);
                        for (let i = 1; i <= count; i++) {
                            const t = i / perMapCols;
                            const top = lerpPoint3(front[0], front[1], t);
                            const bottom = lerpPoint3(front[3], front[2], t);
                            drawLine3D(top, bottom, viewScale, cx, cy, '#1e293b', 1, 0.85);
                        }
                    }
                    if (perMapRows > 1) {
                        const count = Math.min(perMapRows - 1, maxGridLines);
                        for (let i = 1; i <= count; i++) {
                            const t = i / perMapRows;
                            const left = lerpPoint3(front[0], front[3], t);
                            const right = lerpPoint3(front[1], front[2], t);
                            drawLine3D(left, right, viewScale, cx, cy, '#1e293b', 1, 0.85);
                        }
                    }

                    if (isSelected) {
                        drawQuad3D(front[0], front[1], front[2], front[3], viewScale, cx, cy, null, '#f59e0b', 2.2, 1);
                    }
                });

                if (s.showAxes) {
                    const axisLen = Math.max(wallWidthM, wallHeightM, wallDepthM) * 0.9;
                    drawLine3D({ x: 0, y: 0, z: 0 }, { x: axisLen, y: 0, z: 0 }, viewScale, cx, cy, '#ef4444', 2.4, 0.95);
                    drawLine3D({ x: 0, y: 0, z: 0 }, { x: 0, y: axisLen, z: 0 }, viewScale, cx, cy, '#22c55e', 2.4, 0.95);
                    drawLine3D({ x: 0, y: 0, z: 0 }, { x: 0, y: 0, z: axisLen }, viewScale, cx, cy, '#3b82f6', 2.4, 0.95);
                    drawAxisLabel({ x: axisLen, y: 0, z: 0 }, 'X', '#f87171', viewScale, cx, cy);
                    drawAxisLabel({ x: 0, y: axisLen, z: 0 }, 'Y', '#4ade80', viewScale, cx, cy);
                    drawAxisLabel({ x: 0, y: 0, z: axisLen }, 'Z', '#60a5fa', viewScale, cx, cy);
                }
            };

            fitCanvas();

            let dragging = false;
            let dragMode = 'rotate';
            let startX = 0;
            let startY = 0;
            let keydownHandler = null;

            const setToolMode = (mode) => {
                const allowed = new Set(['orbit', 'move', 'rotate', 'scale']);
                s.toolMode = allowed.has(mode) ? mode : 'orbit';
                const toolButtons = container.querySelectorAll('.view3d-tool-btn');
                toolButtons.forEach((btn) => {
                    const active = String(btn.getAttribute('data-tool') || '') === String(s.toolMode);
                    btn.classList.toggle('bg-cyan-700', active);
                    btn.classList.toggle('hover:bg-cyan-600', active);
                    btn.classList.toggle('text-white', active);
                    btn.classList.toggle('bg-gray-800', !active);
                    btn.classList.toggle('hover:bg-gray-700', !active);
                    btn.classList.toggle('text-gray-100', !active);
                });
            };

            const getMapAtCanvasPoint = (clientX, clientY) => {
                const rect = canvas.getBoundingClientRect();
                const pt = { x: clientX - rect.left, y: clientY - rect.top };
                const hits = mapHitRegions.filter((h) => pointInPolygon2D(pt, h.poly));
                if (!hits.length) return null;
                hits.sort((a, b) => b.depth - a.depth);
                return hits[0].id;
            };

            const ensureSelectedTransform = () => {
                const id = String(s.selectedMapId || '');
                if (!id) return null;
                if (!s.mapTransforms[id]) s.mapTransforms[id] = { x: 0, z: 0, rotY: 0, scale: 1 };
                if (!Number.isFinite(Number(s.mapTransforms[id].rotY))) s.mapTransforms[id].rotY = 0;
                if (!Number.isFinite(Number(s.mapTransforms[id].scale))) s.mapTransforms[id].scale = 1;
                return s.mapTransforms[id];
            };

            const onDown = (e) => {
                if (s.useUnity) return;
                dragging = true;
                const pickedMapId = getMapAtCanvasPoint(e.clientX, e.clientY);
                if (pickedMapId) s.selectedMapId = String(pickedMapId);

                if (e.button === 2 || e.shiftKey) {
                    dragMode = 'pan';
                } else if (e.altKey || s.toolMode === 'orbit') {
                    dragMode = 'orbit';
                } else if (s.toolMode === 'move' && s.selectedMapId) {
                    dragMode = 'move-map';
                } else if (s.toolMode === 'rotate' && s.selectedMapId) {
                    dragMode = 'rotate-map';
                } else if (s.toolMode === 'scale' && s.selectedMapId) {
                    dragMode = 'scale-map';
                } else {
                    dragMode = 'orbit';
                }
                startX = e.clientX;
                startY = e.clientY;
                syncControls();
            };
            const onMove = (e) => {
                if (!dragging) return;
                const dx = e.clientX - startX;
                const dy = e.clientY - startY;
                startX = e.clientX;
                startY = e.clientY;
                if (dragMode === 'pan') {
                    s.panX = Math.max(-500, Math.min(500, (Number(s.panX) || 0) + dx));
                    s.panY = Math.max(-500, Math.min(500, (Number(s.panY) || 0) + dy));
                } else if (dragMode === 'move-map') {
                    const t = ensureSelectedTransform();
                    if (t) {
                        const moveScale = Math.max(0.002, (Number(s.distance) || 9) * 0.0017);
                        const yaw = degToRad(Number(s.rotY) || 0);
                        const worldDx = (dx * Math.cos(yaw)) - (-dy * Math.sin(yaw));
                        const worldDz = (dx * Math.sin(yaw)) + (-dy * Math.cos(yaw));
                        t.x = Math.max(-30, Math.min(30, (Number(t.x) || 0) + (worldDx * moveScale)));
                        t.z = Math.max(-30, Math.min(30, (Number(t.z) || 0) + (worldDz * moveScale)));
                    }
                } else if (dragMode === 'rotate-map') {
                    const t = ensureSelectedTransform();
                    if (t) {
                        t.rotY = (Number(t.rotY) || 0) + (dx * 0.5);
                    }
                } else if (dragMode === 'scale-map') {
                    const t = ensureSelectedTransform();
                    if (t) {
                        const next = (Number(t.scale) || 1) * (1 - (dy * 0.01));
                        t.scale = Math.max(0.2, Math.min(3, next));
                    }
                } else {
                    s.rotY = (Number(s.rotY) || 0) + (dx * 0.4);
                    s.rotX = Math.max(-85, Math.min(85, (Number(s.rotX) || 0) - (dy * 0.35)));
                }
                syncControls();
            };
            const onUp = () => {
                dragging = false;
            };
            const onWheel = (e) => {
                if (s.useUnity) return;
                e.preventDefault();
                const delta = Math.sign(e.deltaY || 0);
                s.distance = Math.max(2, Math.min(18, (Number(s.distance) || 9) + delta * 0.35));
                syncControls();
            };
            const onContextMenu = (e) => e.preventDefault();

            canvas.addEventListener('mousedown', onDown);
            window.addEventListener('mousemove', onMove);
            window.addEventListener('mouseup', onUp);
            canvas.addEventListener('wheel', onWheel, { passive: false });
            canvas.addEventListener('contextmenu', onContextMenu);
            window.addEventListener('resize', fitCanvas);

            const bindSlider = (id, key, labelId, suffix = '') => {
                const input = document.getElementById(id);
                const label = document.getElementById(labelId);
                if (!input) return;
                input.addEventListener('input', () => {
                    s[key] = Number(input.value);
                    if (label) {
                        if (key === 'distance') label.textContent = `${Number(s[key]).toFixed(2)}${suffix}`;
                        else label.textContent = `${Math.round(Number(s[key]) || 0)}${suffix}`;
                    }
                });
            };

            bindSlider('view3d-uv-opacity', 'uvOpacity', 'view3d-uv-opacity-val', '%');
            bindSlider('view3d-grid-density', 'gridDensity', 'view3d-grid-density-val');

            const bindTextInput = (id, key) => {
                const el = document.getElementById(id);
                if (!el) return;
                el.addEventListener('input', () => { s[key] = String(el.value || '').trim(); });
            };
            bindTextInput('view3d-unity-loader', 'unityLoaderUrl');
            bindTextInput('view3d-unity-data', 'unityDataUrl');
            bindTextInput('view3d-unity-framework', 'unityFrameworkUrl');
            bindTextInput('view3d-unity-code', 'unityCodeUrl');

            const autoRevolveEl = document.getElementById('view3d-auto-revolve');
            const revolveSpeedEl = document.getElementById('view3d-revolve-speed');
            if (autoRevolveEl) autoRevolveEl.addEventListener('change', () => { s.autoRevolve = !!autoRevolveEl.checked; });
            if (revolveSpeedEl) revolveSpeedEl.addEventListener('input', () => { s.revolveSpeed = Number(revolveSpeedEl.value) || 20; });

            const showGridEl = document.getElementById('view3d-show-grid');
            const showAxesEl = document.getElementById('view3d-show-axes');
            const showUvEl = document.getElementById('view3d-show-uv');
            if (showGridEl) showGridEl.addEventListener('change', () => { s.showGrid = !!showGridEl.checked; });
            if (showAxesEl) showAxesEl.addEventListener('change', () => { s.showAxes = !!showAxesEl.checked; });
            if (showUvEl) showUvEl.addEventListener('change', () => { s.showUV = !!showUvEl.checked; });

            const composeMapsEl = document.getElementById('view3d-compose-maps');
            const composePlacementEl = document.getElementById('view3d-compose-placement');
            const composeGapEl = document.getElementById('view3d-compose-gap');
            const applyComposeAndRerender = () => {
                if (composeMapsEl) {
                    const ids = Array.from(composeMapsEl.selectedOptions || []).map(o => String(o.value)).filter(Boolean);
                    s.composeMapIds = ids.length ? ids : [String(activeMap.id)];
                }
                if (composePlacementEl) s.composePlacement = composePlacementEl.value || 'right';
                if (composeGapEl) s.composeGapPx = Math.max(0, Number(composeGapEl.value) || 0);
                render3DViewTab();
            };
            if (composeMapsEl) composeMapsEl.addEventListener('change', applyComposeAndRerender);
            if (composePlacementEl) composePlacementEl.addEventListener('change', applyComposeAndRerender);
            if (composeGapEl) composeGapEl.addEventListener('change', applyComposeAndRerender);

            const toolButtons = container.querySelectorAll('.view3d-tool-btn');
            toolButtons.forEach((btn) => {
                btn.addEventListener('mousedown', (e) => { e.preventDefault(); e.stopPropagation(); });
                btn.addEventListener('click', () => {
                    const mode = String(btn.getAttribute('data-tool') || 'orbit');
                    setToolMode(mode);
                    syncControls();
                });
            });

            keydownHandler = (e) => {
                if (s.useUnity) return;
                const key = String(e.key || '').toLowerCase();
                if (key === 'q') { setToolMode('orbit'); syncControls(); }
                else if (key === 'w') { setToolMode('move'); syncControls(); }
                else if (key === 'e') { setToolMode('rotate'); syncControls(); }
                else if (key === 'r') { setToolMode('scale'); syncControls(); }
                else if (key === 'escape') { s.selectedMapId = ''; syncControls(); }
            };
            window.addEventListener('keydown', keydownHandler);

            const viewCubeButtons = container.querySelectorAll('[data-viewcube]');
            viewCubeButtons.forEach((btn) => {
                btn.addEventListener('mousedown', (e) => { e.preventDefault(); e.stopPropagation(); });
                btn.addEventListener('click', () => {
                    const preset = String(btn.getAttribute('data-viewcube') || '').toLowerCase();
                    if (preset === 'front') { s.rotX = 0; s.rotY = 0; s.rotZ = 0; }
                    else if (preset === 'back') { s.rotX = 0; s.rotY = 180; s.rotZ = 0; }
                    else if (preset === 'left') { s.rotX = 0; s.rotY = -90; s.rotZ = 0; }
                    else if (preset === 'right') { s.rotX = 0; s.rotY = 90; s.rotZ = 0; }
                    else if (preset === 'top') { s.rotX = -90; s.rotY = 0; s.rotZ = 0; }
                    else if (preset === 'bottom') { s.rotX = 90; s.rotY = 0; s.rotZ = 0; }
                    s.autoRevolve = false;
                    s.panX = 0;
                    s.panY = 0;
                    syncControls();
                });
            });

            const backendEl = document.getElementById('view3d-backend');
            if (backendEl) {
                backendEl.addEventListener('change', async () => {
                    s.useUnity = backendEl.value === 'unity';
                    setBackendUi();
                    if (!s.useUnity) {
                        await unloadUnityInstance();
                        setUnityStatus('Unity disabled. Native Canvas 3D active.');
                        return;
                    }
                    try {
                        await ensureUnityLoaded();
                    } catch (error) {
                        s.useUnity = false;
                        setBackendUi();
                        setUnityStatus(`Unity load failed: ${(error && error.message) ? error.message : 'Unknown error'}`);
                    }
                });
            }

            const unityLoadBtn = document.getElementById('view3d-unity-load');
            if (unityLoadBtn) {
                unityLoadBtn.addEventListener('click', async () => {
                    try {
                        s.useUnity = true;
                        if (backendEl) backendEl.value = 'unity';
                        setBackendUi();
                        await unloadUnityInstance();
                        await ensureUnityLoaded();
                    } catch (error) {
                        setUnityStatus(`Unity load failed: ${(error && error.message) ? error.message : 'Unknown error'}`);
                    }
                });
            }

            const unityAutoBtn = document.getElementById('view3d-unity-autodetect');
            if (unityAutoBtn) {
                unityAutoBtn.addEventListener('click', async () => {
                    const prefixes = [
                        'unity-webgl/Build/build',
                        'unity-webgl/Build/WebGL',
                        'Build/build',
                        'Build/WebGL'
                    ];
                    let found = null;
                    for (const prefix of prefixes) {
                        try {
                            await loadScript(`${prefix}.loader.js`);
                            if (typeof window.createUnityInstance === 'function') {
                                found = {
                                    loader: `${prefix}.loader.js`,
                                    data: `${prefix}.data`,
                                    framework: `${prefix}.framework.js`,
                                    code: `${prefix}.wasm`
                                };
                                break;
                            }
                        } catch (_) {}
                    }
                    if (!found) {
                        setUnityStatus('Auto-detect failed. Keep manual paths or place build in unity-webgl/Build/ as build.*');
                        return;
                    }
                    s.unityLoaderUrl = found.loader;
                    s.unityDataUrl = found.data;
                    s.unityFrameworkUrl = found.framework;
                    s.unityCodeUrl = found.code;
                    const setInput = (id, v) => {
                        const el = document.getElementById(id);
                        if (el) el.value = v;
                    };
                    setInput('view3d-unity-loader', found.loader);
                    setInput('view3d-unity-data', found.data);
                    setInput('view3d-unity-framework', found.framework);
                    setInput('view3d-unity-code', found.code);
                    setUnityStatus(`Auto-detect set paths to ${found.loader}`);
                });
            }

            const resetBtn = document.getElementById('view3d-reset');
            if (resetBtn) {
                resetBtn.addEventListener('click', () => {
                    s.rotX = 0;
                    s.rotY = 0;
                    s.rotZ = 0;
                    s.panX = 0;
                    s.panY = 0;
                    s.distance = 9;
                    s.showGrid = true;
                    s.showAxes = true;
                    s.showUV = true;
                    s.uvOpacity = 82;
                    s.gridDensity = 12;
                    s.toolMode = 'orbit';
                    s.selectedMapId = mapRenderData[0] ? String(mapRenderData[0].id) : '';
                    Object.keys(s.mapTransforms || {}).forEach((key) => {
                        s.mapTransforms[key] = { x: 0, z: 0, rotY: 0, scale: 1 };
                    });
                    syncControls();
                    render3DViewTab();
                });
            }

            const syncControls = () => {
                const setVal = (id, value) => {
                    const el = document.getElementById(id);
                    if (el) el.value = String(value);
                };
                const setTxt = (id, value) => {
                    const el = document.getElementById(id);
                    if (el) el.textContent = value;
                };
                const setChecked = (id, value) => {
                    const el = document.getElementById(id);
                    if (el) el.checked = !!value;
                };
                setVal('view3d-uv-opacity', Math.round(Number(s.uvOpacity) || 82));
                setVal('view3d-grid-density', Math.round(Number(s.gridDensity) || 12));
                setTxt('view3d-uv-opacity-val', `${Math.round(Number(s.uvOpacity) || 82)}%`);
                setTxt('view3d-grid-density-val', `${Math.round(Number(s.gridDensity) || 12)}`);
                const selected = mapRenderData.find(m => String(m.id) === String(s.selectedMapId || ''));
                setTxt('view3d-selected-map', selected ? (selected.map.name || `Map ${selected.id}`) : 'None');
                setToolMode(s.toolMode || 'orbit');

                setChecked('view3d-show-grid', s.showGrid);
                setChecked('view3d-show-axes', s.showAxes);
                setChecked('view3d-show-uv', s.showUV);
                setChecked('view3d-auto-revolve', s.autoRevolve);
                const backend = document.getElementById('view3d-backend');
                if (backend) backend.value = s.useUnity ? 'unity' : 'native';
                setBackendUi();
            };

            let rafId = 0;
            let lastTs = performance.now();
            const tick = (ts) => {
                const dt = Math.max(0, (ts - lastTs) / 1000);
                lastTs = ts;
                if (s.autoRevolve) {
                    s.rotY = (Number(s.rotY) || 0) + ((Number(s.revolveSpeed) || 20) * dt);
                    if (s.rotY > 180) s.rotY -= 360;
                    syncControls();
                }
                drawScene();
                rafId = requestAnimationFrame(tick);
            };
            syncControls();
            if (s.useUnity) {
                ensureUnityLoaded().catch((error) => {
                    s.useUnity = false;
                    setBackendUi();
                    setUnityStatus(`Unity load failed: ${(error && error.message) ? error.message : 'Unknown error'}`);
                });
            }
            drawScene();
            rafId = requestAnimationFrame(tick);

            view3dRuntime = {
                dispose: () => {
                    if (rafId) cancelAnimationFrame(rafId);
                    try { unloadUnityInstance(); } catch (_) {}
                    canvas.removeEventListener('mousedown', onDown);
                    window.removeEventListener('mousemove', onMove);
                    window.removeEventListener('mouseup', onUp);
                    canvas.removeEventListener('wheel', onWheel);
                    canvas.removeEventListener('contextmenu', onContextMenu);
                    window.removeEventListener('resize', fitCanvas);
                    if (keydownHandler) window.removeEventListener('keydown', keydownHandler);
                }
            };
        };

        */

        const renderEffectsDetails = () => {
            const project = state.projects.find(p => p.id === state.activeProjectId);
            if (!project) {
                mainContent.effects.innerHTML = `<div class="text-center text-gray-500">Please select or create a project.</div>`;
                return;
            }
            if (typeof getGlobalAnnotationPresets === 'function') {
                getGlobalAnnotationPresets();
            }
            const activeMap = project.pixelMaps.find(m => m.id === project.activePixelMapId);
            if (!activeMap) {
                  mainContent.effects.innerHTML = `<div class="text-center text-gray-500">Please select a Pixel Map in Pixel Designer to edit its annotations.</div>`;
                return;
            }

            const { details } = activeMap;
            // Migrate legacy centerBadge fields into info.* on the fly for UI coherence
            try {
                if (details && details.centerBadge) {
                    const cb = details.centerBadge;
                    if (!details.info) details.info = {};
                    if (typeof details.info.badgeEnabled === 'undefined') details.info.badgeEnabled = !!cb.enabled;
                    if (typeof details.info.badgeSize === 'undefined' && typeof cb.size !== 'undefined') details.info.badgeSize = cb.size;
                    if (typeof details.info.badgeOpacity === 'undefined' && typeof cb.opacity !== 'undefined') details.info.badgeOpacity = cb.opacity;
                    if (typeof details.info.badgeShadow === 'undefined' && typeof cb.shadow !== 'undefined') details.info.badgeShadow = cb.shadow;
                    if (typeof details.info.badgeStroke === 'undefined' && typeof cb.stroke !== 'undefined') details.info.badgeStroke = cb.stroke;
                    if (typeof details.info.badgeStrokeWidth === 'undefined' && typeof cb.strokeWidth !== 'undefined') details.info.badgeStrokeWidth = cb.strokeWidth;
                }
            } catch (e) { /* non-fatal */ }

            if (!details.info) details.info = {};
            if (details.info.annotationPanelInitialized !== true) {
                details.info.position = 'bottom-right';
                details.info.fontFamily = 'Arial';
                details.info.fontSize = 45;
                details.info.showScreenName = true;
                details.info.showResolution = true;
                details.info.showAspectRatio = true;
                details.info.showBorder = true;
                details.info.bgTransparent = true;
                details.info.annotationPanelInitialized = true;
            }
            if (details.info.annotationFontPixelsInitialized !== true) {
                details.info.fontSize = 48;
                details.info.annotationFontPixelsInitialized = true;
            }
            details.info.enabled = true;
            details.info.badgeEnabled = false;
            details.info.displayMode = 'box';
            if (!details.info.position) details.info.position = 'bottom-right';
            if (!details.info.fontFamily || details.info.fontFamily === 'Inter') details.info.fontFamily = 'Arial';
            if (typeof details.info.fontSize !== 'number') details.info.fontSize = 45;
            if (!['auto', 'custom'].includes(details.info.fontSizeMode)) details.info.fontSizeMode = 'auto';
            if (typeof details.info.fontScale !== 'number') details.info.fontScale = 100;
            if (typeof details.info.showScreenName === 'undefined') details.info.showScreenName = true;
            if (typeof details.info.showResolution === 'undefined') details.info.showResolution = true;
            if (typeof details.info.showLedPitch === 'undefined') details.info.showLedPitch = true;
            if (typeof details.info.showAspectRatio === 'undefined') details.info.showAspectRatio = true;
            if (typeof details.info.showBorder === 'undefined') details.info.showBorder = true;
            if (typeof details.info.bgTransparent === 'undefined') details.info.bgTransparent = true;
            if (!details.info.backgroundColor) details.info.backgroundColor = '#000000';
            if (!details.info.orientation) details.info.orientation = 'normal';
            if (!details.circle) details.circle = {};
            if (!details.cross) details.cross = {};
            if (!details.cornerCircles) details.cornerCircles = {};
            details.circle.radius = 100;
            details.cornerCircles.radius = 8;
            if (!details.circle.style) details.circle.style = 'solid';
            if (!details.cross.style) details.cross.style = 'solid';
            if (!details.cornerCircles.style) details.cornerCircles.style = 'solid';
            if (typeof details.info.badgeShadowBlur === 'undefined') details.info.badgeShadowBlur = 20;
            if (typeof details.info.badgeShadowOffsetY === 'undefined') details.info.badgeShadowOffsetY = 12;
            if (typeof details.info.badgeGradientEnabled === 'undefined') details.info.badgeGradientEnabled = false;
            if (!details.info.badgeGradientColor1) details.info.badgeGradientColor1 = '#111827';
            if (!details.info.badgeGradientColor2) details.info.badgeGradientColor2 = '#374151';
            if (typeof details.info.badgeGradientAngle === 'undefined') details.info.badgeGradientAngle = 90;
            if (typeof details.info.badgeBorderGradientEnabled === 'undefined') details.info.badgeBorderGradientEnabled = false;
            if (!details.info.badgeBorderGradientColor1) details.info.badgeBorderGradientColor1 = '#93c5fd';
            if (!details.info.badgeBorderGradientColor2) details.info.badgeBorderGradientColor2 = '#a78bfa';
            if (typeof details.info.badgeBorderGradientAngle === 'undefined') details.info.badgeBorderGradientAngle = 90;
            if (!details.info.badge3dPreset) details.info.badge3dPreset = 'medium';
            if (typeof details.circle.gradientEnabled === 'undefined') details.circle.gradientEnabled = false;
            if (!details.circle.gradientColor1) details.circle.gradientColor1 = details.shared?.color || '#ffffff';
            if (!details.circle.gradientColor2) details.circle.gradientColor2 = '#60a5fa';
            if (typeof details.circle.gradientAngle === 'undefined') details.circle.gradientAngle = 90;
            if (typeof details.circle.shadowEnabled === 'undefined') details.circle.shadowEnabled = false;
            if (typeof details.circle.shadowBlur === 'undefined') details.circle.shadowBlur = 10;
            if (typeof details.circle.shadowOffsetY === 'undefined') details.circle.shadowOffsetY = 4;
            if (typeof details.cross.gradientEnabled === 'undefined') details.cross.gradientEnabled = false;
            if (!details.cross.gradientColor1) details.cross.gradientColor1 = details.shared?.color || '#ffffff';
            if (!details.cross.gradientColor2) details.cross.gradientColor2 = '#60a5fa';
            if (typeof details.cross.gradientAngle === 'undefined') details.cross.gradientAngle = 90;
            if (typeof details.cross.shadowEnabled === 'undefined') details.cross.shadowEnabled = false;
            if (typeof details.cross.shadowBlur === 'undefined') details.cross.shadowBlur = 10;
            if (typeof details.cross.shadowOffsetY === 'undefined') details.cross.shadowOffsetY = 4;
            if (typeof details.cornerCircles.gradientEnabled === 'undefined') details.cornerCircles.gradientEnabled = false;
            if (!details.cornerCircles.gradientColor1) details.cornerCircles.gradientColor1 = details.shared?.color || '#ffffff';
            if (!details.cornerCircles.gradientColor2) details.cornerCircles.gradientColor2 = '#60a5fa';
            if (typeof details.cornerCircles.gradientAngle === 'undefined') details.cornerCircles.gradientAngle = 90;
            if (typeof details.cornerCircles.shadowEnabled === 'undefined') details.cornerCircles.shadowEnabled = false;
            if (typeof details.cornerCircles.shadowBlur === 'undefined') details.cornerCircles.shadowBlur = 10;
            if (typeof details.cornerCircles.shadowOffsetY === 'undefined') details.cornerCircles.shadowOffsetY = 4;

            if (!details.info.fontFamily) details.info.fontFamily = 'Inter';
            const fontsForSelect = (() => {
                const base = getFontOptions();
                const set = new Set(base);
                if (details.info.fontFamily) set.add(details.info.fontFamily);
                return Array.from(set);
            })();
            const infoFontOptionsHtml = fontsForSelect.map((fontName) => {
                const isSelected = (details.info.fontFamily || 'Inter') === fontName;
                const safe = escapeHtml(fontName);
                return `<option value="${safe}" ${isSelected ? 'selected' : ''}>${safe}</option>`;
            }).join('');
            const lockedInfoName = escapeHtml(activeMap.name || 'Untitled Pixel Map');

            // Build thumbnails similar to Visualizer
            const thumbsHtml = (project.pixelMaps || []).map(pm => `
                <button data-thumb-id="${pm.id}" class="relative cursor-pointer min-w-[190px] max-w-[190px] p-2 rounded-lg border ${String(pm.id)===String(project.activePixelMapId)?'border-accent ring-1 ring-accent/40':'border-gray-700'} bg-gray-900 hover:border-accent transition-colors">
                    ${String(pm.id)===String(project.activePixelMapId) ? '<span class="absolute top-1 left-1 text-[10px] px-1.5 py-0.5 rounded bg-emerald-600/90 text-white">Active</span>' : ''}
                    <div class="text-xs text-gray-300 mb-2 truncate" title="${pm.name}">${pm.name}</div>
                    <div class="w-[174px] h-[108px] rounded bg-black/40 flex items-start justify-center overflow-hidden mx-auto">
                        <canvas id="effects-thumb-canvas-${pm.id}" class="block" style="image-rendering: pixelated;"></canvas>
                    </div>
                </button>
            `).join('');

            mainContent.effects.innerHTML = `
                <div class="annotations-shell rounded-lg shadow-lg">
                    <div class="annotations-workspace">
                    <div class="annotations-stage space-y-4">
                    <!-- Full-width Live Preview at top -->
                    <div class="border border-gray-700 rounded-lg p-4 pl-sticky-preview z-10 bg-gray-800/60 backdrop-blur">
                        <div class="flex items-center justify-between mb-3">
                            <h3 class="font-semibold text-accent">Live Preview</h3>
                            <div class="flex items-center gap-2 text-xs text-gray-300">
                                <button id="effects-zoom-out" class="px-2 py-1 rounded bg-gray-700 hover:bg-gray-600 border border-gray-600">-</button>
                                <button id="effects-zoom-in" class="px-2 py-1 rounded bg-gray-700 hover:bg-gray-600 border border-gray-600">+</button>
                                <span class="mx-2 text-gray-400">|</span>
                                <button id="effects-zoom-actual" class="px-2 py-1 rounded bg-gray-700 hover:bg-gray-600 border border-gray-600" title="Show at 1:1 pixel size">Actual Pixels</button>
                                <button id="effects-zoom-fit" class="px-2 py-1 rounded bg-gray-700 hover:bg-gray-600 border border-gray-600" title="Fit the preview to the viewport">Fit</button>
                                <button id="effects-zoom-100" class="px-2 py-1 rounded bg-gray-700 hover:bg-gray-600 border border-gray-600" title="Set zoom to 100%">100%</button>
                                <span class="mx-2 text-gray-400">|</span>
                                <span id="effects-zoom-label" class="min-w-[60px] inline-block text-right">100%</span>
                                <span class="mx-2 text-gray-400">|</span>
                                <div class="flex items-center gap-1" title="Preview quality scale (low = faster preview, export always full)">
                                    <label for="effects-preview-quality" class="text-gray-400">Quality</label>
                                    <input id="effects-preview-quality" type="range" min="5" max="100" value="100" class="w-24" />
                                    <span id="effects-preview-quality-label" class="text-gray-400">100%</span>
                                </div>
                                <span class="mx-2 text-gray-400">|</span>
                                <button id="effects-send-to-canvas-btn" class="btn-glow flex items-center justify-center gap-2 px-3 py-2 text-[11px] font-semibold rounded-lg shadow-md bg-amber-600 hover:bg-amber-700">Send to Canvas</button>
                                <span class="mx-2 text-gray-400">|</span>
                                <button id="effects-save-png-btn" class="btn-glow flex items-center justify-center gap-2 px-3 py-2 text-[11px] font-semibold rounded-lg shadow-md bg-emerald-600 hover:bg-emerald-700" title="Save as PNG">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                                    Save PNG
                                </button>
                                <label class="flex items-center gap-1 text-[11px] text-gray-300 cursor-pointer ml-1">
                                    <input id="effects-transparent-png" type="checkbox" class="accent-emerald-500" />
                                    Transparent
                                </label>
                            </div>
                        </div>
                        <div id="effects-preview-viewport" class="annotations-preview-viewport w-full bg-gray-900 preview-grid rounded-lg p-2 overflow-auto">
                            <div id="effects-preview-wrapper" style="transform-origin: top left;">
                                <canvas id="effects-preview-canvas" class="block" style="image-rendering: auto;"></canvas>
                            </div>
                        </div>
                    </div>

                    <!-- Full-width All Pixel Maps below preview -->
                    <div class="border border-gray-700 rounded-lg p-4">
                        <div class="text-sm text-gray-400 mb-2">All Pixel Maps in this Project</div>
                        <div id="effects-thumbs" class="flex gap-3 overflow-x-auto pb-2">
                            ${thumbsHtml || '<div class="text-xs text-gray-500">No pixel maps yet.</div>'}
                        </div>
                    </div>

                    </div>
                    <aside class="annotations-inspector">
                    <div class="annotations-inspector-header">
                        <h2 class="text-sm font-semibold text-gray-100">Annotation Parameters</h2>
                        <p class="mt-1 text-[10px] text-gray-400">${lockedInfoName}</p>
                    </div>

                    <!-- Compact inspector controls -->
                    <div class="annotations-controls-grid grid grid-cols-1 gap-3">

                        <!-- LEFT COLUMN: Effect Controls -->
                        <div class="space-y-6">

                            <!-- Project Information -->
                            <div class="annotation-section annotation-section-project bg-gray-900/50 border border-gray-700 rounded-xl p-5">
                                <div class="mb-4 border-b border-gray-700 pb-2">
                                    <h3 class="annotation-section-title text-sm font-semibold">Project</h3>
                                </div>
                                <div class="space-y-3">
                                    <div class="grid grid-cols-2"><div><label>Font</label><select data-details-field="info.fontFamily" class="details-input w-full bg-gray-900 border border-gray-600 text-sm">${infoFontOptionsHtml}</select></div></div>
                                    <div class="grid grid-cols-2"><div><label>Orientation</label><select data-details-field="info.orientation" class="details-input w-full bg-gray-900 border border-gray-600 text-sm"><option value="normal" ${details.info.orientation === 'normal' ? 'selected' : ''}>Normal</option><option value="90" ${details.info.orientation === '90' ? 'selected' : ''}>Rotate 90°</option><option value="180" ${details.info.orientation === '180' ? 'selected' : ''}>Rotate 180°</option><option value="270" ${details.info.orientation === '270' ? 'selected' : ''}>Rotate 270°</option></select></div></div>
                                    <div class="grid grid-cols-2 gap-2 items-end">
                                        <div><label>Sizing</label><select data-details-field="info.fontSizeMode" class="details-input w-full bg-gray-900 border border-gray-600 text-sm"><option value="auto" ${details.info.fontSizeMode === 'auto' ? 'selected' : ''}>Auto fit</option><option value="custom" ${details.info.fontSizeMode === 'custom' ? 'selected' : ''}>Custom px</option></select></div>
                                        <div><label id="info-font-scale-label">Auto Scale (${details.info.fontScale.toFixed(0)}%)</label><input type="range" min="50" max="200" step="5" value="${details.info.fontScale}" data-details-field="info.fontScale" class="details-input w-full" ${details.info.fontSizeMode === 'custom' ? 'disabled' : ''} /></div>
                                    </div>
                                    <div class="${details.info.fontSizeMode === 'auto' ? 'opacity-50' : ''}">
                                        <label id="info-font-size-label" class="mb-2 block">Custom Size (${details.info.fontSize.toFixed(0)} px)</label>
                                        <div class="flex items-center gap-2">
                                            <input id="info-font-size-range" type="range" min="12" max="300" step="1" value="${details.info.fontSize}" data-details-field="info.fontSize" class="details-input min-w-0 flex-1" ${details.info.fontSizeMode === 'auto' ? 'disabled' : ''} />
                                            <input id="info-font-size-number" type="number" min="12" max="300" step="1" value="${details.info.fontSize}" data-details-field="info.fontSize" class="details-input w-16 bg-gray-900 border border-gray-600 text-center" aria-label="Project information font size in pixels" ${details.info.fontSizeMode === 'auto' ? 'disabled' : ''} />
                                        </div>
                                        <p class="mt-1 text-[10px] text-gray-500">Sizing is saved for this pixel map.</p>
                                    </div>
                                    <div>
                                        <label class="mb-2 block">Position</label>
                                        <div class="annotation-button-grid">
                                            ${[['top-left','Top Left'],['top-right','Top Right'],['center','Center'],['bottom-left','Bottom Left'],['bottom-right','Bottom Right']].map(([value,label]) => `<button type="button" class="annotation-choice" data-details-choice="info.position" data-choice-value="${value}" aria-pressed="${details.info.position === value}">${label}</button>`).join('')}
                                        </div>
                                    </div>
                                    <div class="flex items-center justify-between"><label>Show Screen Name</label><input type="checkbox" data-details-field="info.showScreenName" class="details-input accent-sky-500" ${details.info.showScreenName ? 'checked' : ''}></div>
                                    <div class="flex items-center justify-between"><label>Show Resolution</label><input type="checkbox" data-details-field="info.showResolution" class="details-input accent-sky-500" ${details.info.showResolution ? 'checked' : ''}></div>
                                    <div class="flex items-center justify-between"><label>Show LED Pitch</label><input type="checkbox" data-details-field="info.showLedPitch" class="details-input accent-sky-500" ${details.info.showLedPitch ? 'checked' : ''}></div>
                                    <div class="flex items-center justify-between"><label>Show Aspect Ratio</label><input type="checkbox" data-details-field="info.showAspectRatio" class="details-input accent-sky-500" ${details.info.showAspectRatio ? 'checked' : ''}></div>
                                    <div class="flex items-center justify-between"><label>Show Border</label><input type="checkbox" data-details-field="info.showBorder" class="details-input accent-sky-500" ${details.info.showBorder ? 'checked' : ''}></div>
                                    <div class="grid grid-cols-2"><div><label>Background Color</label><input type="color" data-details-field="info.backgroundColor" value="${details.info.backgroundColor}" class="details-input w-full bg-gray-900 cursor-pointer"></div></div>
                                    <div class="flex items-center justify-between"><label>Transparent Background</label><input type="checkbox" data-details-field="info.bgTransparent" class="details-input accent-sky-500" ${details.info.bgTransparent ? 'checked' : ''}></div>
                                </div>
                            </div>

                            <!-- Overlays & Markers -->
                            <div class="annotation-section annotation-section-overlays bg-gray-900/50 border border-gray-700 rounded-xl p-5 space-y-5">
                                <h3 class="annotation-section-title text-sm font-semibold border-b border-gray-700 pb-2">Overlays &amp; Markers</h3>

                                <!-- One-click quick apply -->
                                <div class="annotation-action-grid">
                                    <button id="overlays-enable-all-btn" type="button" class="w-full px-3 py-2 text-xs font-semibold rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white" title="Turn on all overlays">Enable</button>
                                    <button id="overlays-disable-all-btn" type="button" class="w-full px-3 py-2 text-xs font-semibold rounded-lg bg-red-600 hover:bg-red-500 text-white" title="Turn off all overlays">Disable</button>
                                </div>

                                <div class="annotation-button-grid">
                                    <button type="button" class="annotation-choice" data-overlay-toggle="coords" aria-pressed="${!!details.coords?.enabled}">Coordinates</button>
                                    <button type="button" class="annotation-choice" data-overlay-toggle="circle" aria-pressed="${!!details.circle.enabled}">Full Circle</button>
                                    <button type="button" class="annotation-choice" id="markers-dotted-style" aria-pressed="${details.circle.style === 'dotted'}">Dotted Style</button>
                                    <button type="button" class="annotation-choice" data-overlay-toggle="cornerCircles" aria-pressed="${!!details.cornerCircles?.enabled}">Corner Circles</button>
                                    <button type="button" class="annotation-choice" data-overlay-toggle="cross" aria-pressed="${!!details.cross.enabled}">Center Cross</button>
                                    <button type="button" class="annotation-choice" data-overlay-toggle="corners" aria-pressed="${!!details.corners.enabled}">Corner Markers</button>
                                </div>
                                <div class="${(details.coords && details.coords.enabled) ? '' : 'opacity-50 pointer-events-none'}">
                                    <label id="coords-font-size-label" class="text-sm text-gray-300">Font Size (${(details.coords && typeof details.coords.fontSize === 'number' ? details.coords.fontSize : 100)}%)</label>
                                    <input type="range" data-details-field="coords.fontSize" min="20" max="300" value="${(details.coords && typeof details.coords.fontSize === 'number' ? details.coords.fontSize : 100)}" class="details-input w-full mt-1">
                                </div>

                                <div class="border-t border-gray-700/50"></div>

                                <!-- Marker Customization -->
                                <h4 class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Marker Customization</h4>
                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <label class="text-sm text-gray-300">Color</label>
                                        <input type="color" data-details-field="shared.color" value="${details.shared.color}" class="details-input w-full mt-1 h-10 p-0 bg-gray-900 rounded-lg cursor-pointer">
                                    </div>
                                    <div>
                                        <label id="shared-thickness-label" class="text-sm text-gray-300">Thickness (${details.shared.thickness}px)</label>
                                        <input type="range" data-details-field="shared.thickness" min="1" max="50" value="${details.shared.thickness}" class="details-input w-full mt-1">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- RIGHT COLUMN: Logo, Color Bars, Presets -->
                        <div class="space-y-6">

                            <!-- Logo Overlay -->
                            <div class="annotation-section annotation-section-logo annotation-collapsible ${state.ui?.annotationOpenSections?.logo ? '' : 'annotation-collapsed'} bg-gray-900/50 border border-gray-700 rounded-xl p-5" data-annotation-section="logo">
                                <div class="flex items-center justify-between mb-4">
                                    <h3 class="annotation-section-title text-sm font-semibold" data-annotation-section-toggle="logo" title="Open or close Logo Overlay settings">Logo Overlay</h3>
                                    <label class="relative inline-flex items-center cursor-pointer toggle-switch">
                                        <input type="checkbox" data-details-field="logo.enabled" class="sr-only peer" ${details.logo.enabled ? 'checked' : ''}>
                                        <div class="w-11 h-6 bg-gray-600 rounded-full block"></div><div class="absolute left-1 top-1 bg-white w-4 h-4 rounded-full dot"></div>
                                    </label>
                                </div>
                                <div class="flex items-center justify-between mb-4 rounded-lg border border-gray-700 bg-gray-900 px-3 py-2">
                                    <label class="text-sm text-gray-200" title="Add the PixelLogic logo to the bottom-right corner of this pixel map.">PixelLogic Logo <span class="text-xs text-gray-500">Bottom right</span></label>
                                    <label class="relative inline-flex items-center cursor-pointer toggle-switch">
                                        <input type="checkbox" data-details-field="logo.pixelLogicEnabled" class="sr-only peer" ${details.logo.pixelLogicEnabled ? 'checked' : ''}>
                                        <div class="w-11 h-6 bg-gray-600 rounded-full block"></div><div class="absolute left-1 top-1 bg-white w-4 h-4 rounded-full dot"></div>
                                    </label>
                                </div>
                                <div class="space-y-3 ${details.logo.enabled ? '' : 'opacity-50 pointer-events-none'}">
                                    <div class="flex items-center gap-2">
                                        <input type="file" id="logo-upload" data-details-field="logo.src" class="details-input file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-gray-600 file:text-gray-200 hover:file:bg-gray-700 flex-1 text-gray-400">
                                        <button id="logo-clear-btn" class="px-3 py-2 rounded bg-red-600 hover:bg-red-700 text-xs whitespace-nowrap" title="Remove the loaded logo">Clear</button>
                                    </div>
                                    <div class="grid grid-cols-3 gap-3">
                                        <div>
                                            <label class="text-sm text-gray-300">Position</label>
                                            <select data-details-field="logo.position" class="details-input w-full bg-gray-900 rounded-lg px-3 py-2 border border-gray-600 mt-1 text-sm">
                                                <option value="center" ${details.logo.position === 'center' ? 'selected' : ''}>Center</option>
                                                <option value="top-left" ${details.logo.position === 'top-left' ? 'selected' : ''}>Top Left</option>
                                                <option value="top-right" ${details.logo.position === 'top-right' ? 'selected' : ''}>Top Right</option>
                                                <option value="bottom-left" ${details.logo.position === 'bottom-left' ? 'selected' : ''}>Bottom Left</option>
                                                <option value="bottom-right" ${details.logo.position === 'bottom-right' ? 'selected' : ''}>Bottom Right</option>
                                            </select>
                                        </div>
                                        <div>
                                            <label id="logo-size-label" class="text-sm text-gray-300">Size (${details.logo.size}%)</label>
                                            <input type="range" data-details-field="logo.size" min="5" max="100" value="${details.logo.size}" class="details-input w-full mt-1">
                                        </div>
                                        <div>
                                            <label id="logo-opacity-label" class="text-sm text-gray-300">Opacity (${details.logo.opacity}%)</label>
                                            <input type="range" data-details-field="logo.opacity" min="0" max="100" value="${details.logo.opacity}" class="details-input w-full mt-1">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Color Bars -->
                            <div class="annotation-section annotation-section-color-bars annotation-collapsible ${state.ui?.annotationOpenSections?.colorBars ? '' : 'annotation-collapsed'} bg-gray-900/50 border border-gray-700 rounded-xl p-5" data-annotation-section="colorBars">
                                <div class="flex items-center justify-between mb-4">
                                    <h3 class="annotation-section-title text-sm font-semibold" data-annotation-section-toggle="colorBars" title="Open or close Color Bars settings">Color Bars</h3>
                                    <label class="relative inline-flex items-center cursor-pointer toggle-switch">
                                        <input type="checkbox" data-details-field="colorBars.enabled" class="sr-only peer" ${details.colorBars?.enabled ? 'checked' : ''}>
                                        <div class="w-11 h-6 bg-gray-600 rounded-full block"></div><div class="absolute left-1 top-1 bg-white w-4 h-4 rounded-full dot"></div>
                                    </label>
                                </div>
                                <div class="space-y-3 ${details.colorBars?.enabled ? '' : 'opacity-50 pointer-events-none'}">
                                    <div class="grid grid-cols-2 gap-3">
                                        <div>
                                            <label class="text-sm text-gray-300">Preset</label>
                                            <select class="details-input w-full bg-gray-900 rounded-lg px-3 py-2 border border-gray-600 mt-1 text-sm" data-details-field="colorBars.preset">
                                                <option value="smpte" ${details.colorBars?.preset === 'smpte' ? 'selected' : ''}>SMPTE</option>
                                                <option value="rgbw" ${details.colorBars?.preset === 'rgbw' ? 'selected' : ''}>RGBW</option>
                                                <option value="rgb" ${details.colorBars?.preset === 'rgb' ? 'selected' : ''}>RGB</option>
                                            </select>
                                        </div>
                                        <div>
                                            <label class="text-sm text-gray-300">Orientation</label>
                                            <select class="details-input w-full bg-gray-900 rounded-lg px-3 py-2 border border-gray-600 mt-1 text-sm" data-details-field="colorBars.orientation">
                                                <option value="horizontal" ${details.colorBars?.orientation === 'horizontal' ? 'selected' : ''}>Horizontal</option>
                                                <option value="vertical" ${details.colorBars?.orientation === 'vertical' ? 'selected' : ''}>Vertical</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="grid grid-cols-2 gap-3">
                                        <div>
                                            <label class="text-sm text-gray-300">Position</label>
                                            <select class="details-input w-full bg-gray-900 rounded-lg px-3 py-2 border border-gray-600 mt-1 text-sm" data-details-field="colorBars.position">
                                                <option value="full" ${details.colorBars?.position === 'full' ? 'selected' : ''}>Fill</option>
                                                <option value="center" ${details.colorBars?.position === 'center' ? 'selected' : ''}>Center</option>
                                                <option value="top" ${details.colorBars?.position === 'top' ? 'selected' : ''}>Top</option>
                                                <option value="bottom" ${details.colorBars?.position === 'bottom' ? 'selected' : ''}>Bottom</option>
                                                <option value="left" ${details.colorBars?.position === 'left' ? 'selected' : ''}>Left</option>
                                                <option value="right" ${details.colorBars?.position === 'right' ? 'selected' : ''}>Right</option>
                                                <option value="near-info" ${details.colorBars?.position === 'near-info' ? 'selected' : ''}>Near Info</option>
                                            </select>
                                        </div>
                                        <div>
                                            <label id="color-bars-height-label" class="text-sm text-gray-300">Thickness (${details.colorBars?.heightPercent ?? 30}%)</label>
                                            <input type="range" min="5" max="100" value="${details.colorBars?.heightPercent ?? 30}" data-details-field="colorBars.heightPercent" class="details-input w-full mt-1" />
                                        </div>
                                    </div>
                                    <div class="grid grid-cols-3 gap-3">
                                        <div>
                                            <label id="color-bars-length-label" class="text-sm text-gray-300">Length (${details.colorBars?.lengthPercent ?? 60}%)</label>
                                            <input type="range" min="10" max="100" value="${details.colorBars?.lengthPercent ?? 60}" data-details-field="colorBars.lengthPercent" class="details-input w-full mt-1" />
                                        </div>
                                        <div>
                                            <label id="color-bars-opacity-label" class="text-sm text-gray-300">Opacity (${details.colorBars?.opacity ?? 100}%)</label>
                                            <input type="range" min="0" max="100" value="${details.colorBars?.opacity ?? 100}" data-details-field="colorBars.opacity" class="details-input w-full mt-1" />
                                        </div>
                                        <div>
                                            <label id="color-bars-offset-x-label" class="text-sm text-gray-300">Offset X (${details.colorBars?.offsetXPercent ?? 0}%)</label>
                                            <input type="range" min="-100" max="100" value="${details.colorBars?.offsetXPercent ?? 0}" data-details-field="colorBars.offsetXPercent" class="details-input w-full mt-1" />
                                        </div>
                                    </div>
                                    <div>
                                        <label id="color-bars-offset-y-label" class="text-sm text-gray-300">Offset Y (${details.colorBars?.offsetYPercent ?? 0}%)</label>
                                        <input type="range" min="-100" max="100" value="${details.colorBars?.offsetYPercent ?? 0}" data-details-field="colorBars.offsetYPercent" class="details-input w-full mt-1" />
                                    </div>
                                </div>
                            </div>

                            <!-- Annotation Presets -->
                            <div class="annotation-section annotation-section-presets annotation-collapsible ${state.ui?.annotationOpenSections?.presets ? '' : 'annotation-collapsed'} bg-gray-900/50 border border-gray-700 rounded-xl p-5" data-annotation-section="presets">
                                <div class="flex items-center justify-between mb-4">
                                    <h3 class="annotation-section-title text-sm font-semibold" data-annotation-section-toggle="presets" title="Open or close Annotation Presets">Annotation Presets</h3>
                                    <button id="effects-preset-save" class="px-3 py-1.5 rounded bg-emerald-600 hover:bg-emerald-700 text-xs font-medium">Save Current</button>
                                </div>
                                <div class="space-y-3">
                                    <div class="flex items-center gap-2">
                                        <label class="text-xs text-gray-400 whitespace-nowrap">Active Preset:</label>
                                        <select id="effects-active-preset-select" class="bg-gray-900 border border-gray-600 rounded px-2 py-1 text-xs flex-1">
                                            <option value="">None</option>
                                            ${(state.effectsPresets||[]).map(p=>`<option value='${p.id}' ${String(state.ui?.activeEffectsPresetId)===String(p.id)?'selected':''}>${escapeHtml(p.name)}</option>`).join('')}
                                        </select>
                                        <button id="effects-active-preset-apply-btn" class="px-2 py-1 rounded bg-sky-600 hover:bg-sky-700 text-xs text-white" title="Apply selected preset to active map">Apply</button>
                                        <button id="effects-active-preset-apply-all-btn" class="px-2 py-1 rounded bg-amber-600 hover:bg-amber-700 text-xs text-white" title="Apply selected preset to all maps">All</button>
                                    </div>
                                    <input id="effects-preset-name" type="text" placeholder="Preset Name" class="w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-1.5 text-sm" />
                                    <div id="effects-presets-list" class="space-y-2 max-h-48 overflow-auto">
                                        ${(state.effectsPresets||[]).length ? state.effectsPresets.map(p=>`<div class='flex flex-col gap-1 bg-gray-900/60 border border-gray-700 rounded px-2 py-2'>
                                            <div class='flex items-center gap-2'>
                                                <span class='text-xs text-gray-300 font-medium truncate max-w-[140px]' title='${escapeHtml(p.name)}'>${escapeHtml(p.name)}</span>
                                                ${p.isDefault ? '<span class="text-[9px] px-1 py-0.5 rounded bg-gray-700 text-gray-400 font-normal">Default</span>' : ''}
                                                <button class='px-2 py-0.5 rounded bg-sky-600 hover:bg-sky-700 text-xs text-white' data-apply-preset='${p.id}'>Apply Active</button>
                                                <button class='px-2 py-0.5 rounded bg-amber-600 hover:bg-amber-700 text-xs text-white' data-apply-preset-all='${p.id}' title='Apply to all pixel maps'>All</button>
                                                <button class='px-2 py-0.5 rounded bg-red-600 hover:bg-red-700 text-xs text-white ml-auto' data-delete-preset='${p.id}'>Del</button>
                                            </div>
                                            <div class='flex items-center gap-2'>
                                                <select class='bg-gray-800 border border-gray-700 rounded px-2 py-1 text-xs flex-1' data-preset-target-select='${p.id}' title='Choose a pixel map to apply this preset to'>
                                                    ${(project.pixelMaps||[]).map(m=>`<option value='${m.id}' ${String(m.id)===String(project.activePixelMapId)?'selected':''}>${escapeHtml(m.name)}</option>`).join('')}
                                                </select>
                                                <button class='px-2 py-0.5 rounded bg-emerald-600 hover:bg-emerald-700 text-xs text-white' data-apply-preset-target='${p.id}' title='Apply to selected map'>Apply To</button>
                                            </div>
                                        </div>`).join('') : '<div class="text-xs text-gray-500">No presets saved yet.</div>'}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    </aside>
                    </div>
                </div>`;
            
            
            document.querySelectorAll('.details-input, .toggle-switch input').forEach(input => {
                const eventType = input.type === 'checkbox' || input.type === 'file' ? 'change' : 'input';
                input.addEventListener(eventType, handleDetailsChange);
            });
            document.querySelectorAll('[data-annotation-section-toggle]').forEach(toggle => {
                toggle.addEventListener('click', () => {
                    const key = toggle.dataset.annotationSectionToggle;
                    const section = toggle.closest('[data-annotation-section]');
                    if (!section) return;
                    const open = section.classList.contains('annotation-collapsed');
                    section.classList.toggle('annotation-collapsed', !open);
                    state.ui = state.ui || {};
                    state.ui.annotationOpenSections = state.ui.annotationOpenSections || {};
                    state.ui.annotationOpenSections[key] = open;
                    saveState();
                });
            });
            document.querySelectorAll('[data-details-choice]').forEach(button => {
                button.addEventListener('click', () => {
                    const [category, property] = button.dataset.detailsChoice.split('.');
                    setDetailsFieldForAllMaps(category, property, button.dataset.choiceValue);
                    document.querySelectorAll(`[data-details-choice="${button.dataset.detailsChoice}"]`).forEach(choice => {
                        choice.setAttribute('aria-pressed', String(choice === button));
                    });
                    saveState();
                    redrawAffectedVisuals();
                });
            });
            document.querySelectorAll('[data-overlay-toggle]').forEach(button => {
                button.addEventListener('click', () => {
                    const key = button.dataset.overlayToggle;
                    const overlay = activeMap.details[key] = activeMap.details[key] || {};
                    const enabled = !overlay.enabled;
                    (project.pixelMaps || []).forEach(map => {
                        map.details = map.details || {};
                        const target = map.details[key] = map.details[key] || {};
                        target.enabled = enabled;
                        if (key === 'circle') target.radius = 100;
                        if ((key === 'circle' || key === 'cross' || key === 'cornerCircles') && !target.style) target.style = 'solid';
                    });
                    synchronizeAnnotationDetails(activeMap);
                    button.setAttribute('aria-pressed', String(enabled));
                    saveState();
                    redrawAffectedVisuals();
                });
            });
            const dottedStyleBtn = document.getElementById('markers-dotted-style');
            if (dottedStyleBtn) {
                dottedStyleBtn.addEventListener('click', () => {
                    const dotted = dottedStyleBtn.getAttribute('aria-pressed') !== 'true';
                    const style = dotted ? 'dotted' : 'solid';
                    (project.pixelMaps || []).forEach(map => {
                        map.details = map.details || {};
                        ['circle', 'cross', 'cornerCircles'].forEach(key => {
                            const target = map.details[key] = map.details[key] || {};
                            target.style = style;
                            if (key === 'circle') target.radius = 100;
                        });
                    });
                    synchronizeAnnotationDetails(activeMap);
                    dottedStyleBtn.setAttribute('aria-pressed', String(dotted));
                    saveState();
                    redrawAffectedVisuals();
                });
            }
            // (Panel grid editor moved to Designer)

            // Wire Effects Presets controls
            try {
                const nameInput = document.getElementById('effects-preset-name');
                const saveBtn = document.getElementById('effects-preset-save');
                const listEl = document.getElementById('effects-presets-list');
                const activeSelect = document.getElementById('effects-active-preset-select');
                const applyActiveSelectBtn = document.getElementById('effects-active-preset-apply-btn');
                const applyAllSelectBtn = document.getElementById('effects-active-preset-apply-all-btn');

                const snapshot = () => {
                    // Save only effect-related fields to keep presets portable
                    const s = JSON.parse(JSON.stringify(activeMap));
                    return { details: s.details };
                };

                const applyToMap = (presetObj, mapObj) => {
                    if (!presetObj || !mapObj) return;
                    const d = presetObj.data || {};
                    if (typeof d.details !== 'undefined') {
                        mapObj.details = JSON.parse(JSON.stringify(d.details));
                    }
                };

                if (saveBtn) {
                    saveBtn.addEventListener('click', () => {
                        const currentPresets = (typeof getGlobalAnnotationPresets === 'function') ? getGlobalAnnotationPresets() : (state.effectsPresets || []);
                        const nm = (nameInput?.value || '').trim() || `Preset ${(currentPresets.length + 1)}`;
                        const id = 'preset_' + Date.now() + '_' + Math.floor(Math.random() * 10000);
                        currentPresets.push({ id, name: nm, data: snapshot() });
                        if (typeof saveGlobalAnnotationPresets === 'function') {
                            saveGlobalAnnotationPresets(currentPresets);
                        } else {
                            state.effectsPresets = currentPresets;
                            try { localStorage.setItem('pixellogic-effects-presets', JSON.stringify(currentPresets)); } catch(_) {}
                        }
                        if (nameInput) nameInput.value = '';
                        renderEffectsDetails();
                        redrawAffectedVisuals();
                        showNotification(`Preset "${nm}" saved.`);
                    });
                }

                if (applyActiveSelectBtn) {
                    applyActiveSelectBtn.addEventListener('click', () => {
                        const selectedId = activeSelect?.value;
                        if (!selectedId) {
                            showNotification('Please select a preset from the dropdown.');
                            return;
                        }
                        const p = (state.effectsPresets || []).find(x => String(x.id) === String(selectedId));
                        if (p) {
                            applyToMap(p, activeMap);
                            saveState();
                            renderEffectsDetails();
                            redrawAffectedVisuals();
                            showNotification(`Applied preset "${p.name}" to active map.`);
                        }
                    });
                }

                if (applyAllSelectBtn) {
                    applyAllSelectBtn.addEventListener('click', () => {
                        const selectedId = activeSelect?.value;
                        if (!selectedId) {
                            showNotification('Please select a preset from the dropdown.');
                            return;
                        }
                        const p = (state.effectsPresets || []).find(x => String(x.id) === String(selectedId));
                        if (p) {
                            const project = state.projects.find(pr => pr.id === state.activeProjectId);
                            (project?.pixelMaps || []).forEach(m => applyToMap(p, m));
                            saveState();
                            renderEffectsDetails();
                            redrawAffectedVisuals();
                            showNotification(`Applied preset "${p.name}" to all pixel maps.`);
                        }
                    });
                }

                if (activeSelect) {
                    activeSelect.addEventListener('change', (e) => {
                        const val = e.target.value;
                        state.ui = state.ui || {};
                        state.ui.activeEffectsPresetId = val || '';
                        try { localStorage.setItem('pixellogic-active-effects-preset', state.ui.activeEffectsPresetId); } catch (_) {}
                        try {
                            const canvas = document.getElementById('effects-preview-canvas');
                            if (canvas) drawVisualizerCanvas(canvas, activeMap);
                            (project.pixelMaps || []).forEach(pm => { const c = document.getElementById(`effects-thumb-canvas-${pm.id}`); if (c) drawVisualizerCanvas(c, pm); });
                        } catch (_) {}
                    });
                }

                if (listEl) {
                    listEl.addEventListener('click', (e) => {
                        const applyId = e.target?.getAttribute && e.target.getAttribute('data-apply-preset');
                        const applyTargetId = e.target?.getAttribute && e.target.getAttribute('data-apply-preset-target');
                        const applyAllId = e.target?.getAttribute && e.target.getAttribute('data-apply-preset-all');
                        const delId = e.target?.getAttribute && e.target.getAttribute('data-delete-preset');

                        if (applyId) {
                            const p = (state.effectsPresets || []).find(x => String(x.id) === String(applyId));
                            if (p) {
                                applyToMap(p, activeMap);
                                saveState();
                                renderEffectsDetails();
                                redrawAffectedVisuals();
                                showNotification(`Applied preset "${p.name}" to active map.`);
                            }
                        } else if (applyTargetId) {
                            const p = (state.effectsPresets || []).find(x => String(x.id) === String(applyTargetId));
                            if (p) {
                                const selectEl = listEl.querySelector(`select[data-preset-target-select='${p.id}']`);
                                const targetMapId = selectEl ? selectEl.value : null;
                                const project = state.projects.find(pr => pr.id === state.activeProjectId);
                                const targetMap = project?.pixelMaps?.find(m => String(m.id) === String(targetMapId));
                                if (targetMap) {
                                    applyToMap(p, targetMap);
                                    saveState();
                                    renderEffectsDetails();
                                    redrawAffectedVisuals();
                                    showNotification(`Applied preset "${p.name}" to ${targetMap.name}.`);
                                } else showNotification('Target map not found.');
                            }
                        } else if (applyAllId) {
                            const p = (state.effectsPresets || []).find(x => String(x.id) === String(applyAllId));
                            if (p) {
                                const project = state.projects.find(pr => pr.id === state.activeProjectId);
                                (project?.pixelMaps || []).forEach(m => applyToMap(p, m));
                                saveState();
                                renderEffectsDetails();
                                redrawAffectedVisuals();
                                showNotification(`Applied preset "${p.name}" to all pixel maps.`);
                            }
                        } else if (delId) {
                            recordDeletedAnnotationPresetId(delId);
                            if (typeof state !== 'undefined' && state) {
                                if (Array.isArray(state.effectsPresets)) {
                                    state.effectsPresets = state.effectsPresets.filter(x => String(x.id) !== String(delId));
                                }
                                if (Array.isArray(state.projects)) {
                                    state.projects.forEach(pr => {
                                        if (Array.isArray(pr.effectsPresets)) {
                                            pr.effectsPresets = pr.effectsPresets.filter(x => String(x.id) !== String(delId));
                                        }
                                    });
                                }
                            }
                            const currentPresets = (typeof getGlobalAnnotationPresets === 'function') ? getGlobalAnnotationPresets() : (state.effectsPresets || []);
                            const next = currentPresets.filter(x => String(x.id) !== String(delId));
                            if (typeof saveGlobalAnnotationPresets === 'function') {
                                saveGlobalAnnotationPresets(next);
                            } else {
                                state.effectsPresets = next;
                                try { localStorage.setItem('pixellogic-effects-presets', JSON.stringify(next)); } catch(_) {}
                            }
                            if (typeof persistProjects === 'function') persistProjects();
                            renderEffectsDetails();
                            showNotification('Preset deleted.');
                        }
                    });
                }
            } catch (_) {}
            // Wire Clear Logo button
            try {
                const clearLogoBtn = document.getElementById('logo-clear-btn');
                if (clearLogoBtn) {
                    clearLogoBtn.addEventListener('click', () => {
                        if (!activeMap) return;
                        (project.pixelMaps || []).forEach(map => {
                            map.details = map.details || {};
                            map.details.logo = map.details.logo || {};
                            map.details.logo.imageObject = null;
                            map.details.logo.src = null;
                        });
                        synchronizeAnnotationDetails(activeMap);
                        const fileInput = document.getElementById('logo-upload');
                        if (fileInput) fileInput.value = '';
                        redrawAffectedVisuals();
                        showNotification('Logo cleared.');
                    });
                }
            } catch(_) {}
            // Wire Quick Overlays Enable/Disable All
            try {
                const enableAllBtn = document.getElementById('overlays-enable-all-btn');
                const disableAllBtn = document.getElementById('overlays-disable-all-btn');
                const setAllOverlays = (on) => {
                    if (!activeMap) return;
                    (project.pixelMaps || []).forEach(map => {
                        const d = map.details = map.details || {};
                        d.coords = d.coords || {}; d.coords.enabled = on;
                        if (on && !(typeof d.coords.fontSize === 'number')) d.coords.fontSize = 100;
                        d.circle = d.circle || {}; d.circle.enabled = on; if (!d.circle.style) d.circle.style = 'solid'; d.circle.radius = 100;
                        d.cornerCircles = d.cornerCircles || {}; d.cornerCircles.enabled = on; if (!d.cornerCircles.style) d.cornerCircles.style = 'solid';
                        d.cornerCircles.radius = 8;
                        d.cross = d.cross || {}; d.cross.enabled = on; if (!d.cross.style) d.cross.style = 'solid';
                        d.corners = d.corners || {}; d.corners.enabled = on;
                        d.shared = d.shared || {};
                        if (on && !d.shared.color) d.shared.color = '#ffffff';
                        if (on && !(typeof d.shared.thickness === 'number')) d.shared.thickness = 5;
                    });
                    synchronizeAnnotationDetails(activeMap);
                    saveState();
                    renderEffectsDetails();
                    redrawAffectedVisuals();
                    showNotification(on ? 'All overlays enabled.' : 'All overlays disabled.');
                };
                if (enableAllBtn) enableAllBtn.addEventListener('click', () => setAllOverlays(true));
                if (disableAllBtn) disableAllBtn.addEventListener('click', () => setAllOverlays(false));
            } catch(_) {}
            // Initialize and apply zoom state + initial draw of the live preview
            try {
                // Ensure UI state bucket
                if (!state.ui) state.ui = {};

                const applyZoom = (scale, center = true) => {
                    const wrapper = document.getElementById('effects-preview-wrapper');
                    const label = document.getElementById('effects-zoom-label');
                    const s = Math.max(0.1, Math.min(8, scale));
                    state.ui.effectsPreviewScale = s;
                    const canvasEl = document.getElementById('effects-preview-canvas');
                    if (canvasEl) {
                        const baseW = canvasEl.width || 1;
                        const baseH = canvasEl.height || 1;
                        canvasEl.style.width = `${Math.round(baseW * s)}px`;
                        canvasEl.style.height = `${Math.round(baseH * s)}px`;
                    }
                    if (label) label.textContent = `${Math.round(s * 100)}%`;
                    saveState();
                };

                const hookZoomControls = () => {
                    const btnIn = document.getElementById('effects-zoom-in');
                    const btnOut = document.getElementById('effects-zoom-out');
                    const btnActual = document.getElementById('effects-zoom-actual');
                    const btnFit = document.getElementById('effects-zoom-fit');
                    const btn100 = document.getElementById('effects-zoom-100');
                    const btnSend = document.getElementById('effects-send-to-canvas-btn');
                    const viewport = document.getElementById('effects-preview-viewport');
                    // Recalculate fit on window resize so the top preview uses full space
                    if (viewport) {
                        if (state.ui._effectsResizeHandler) window.removeEventListener('resize', state.ui._effectsResizeHandler);
                        state.ui._effectsResizeHandler = () => {
                            try {
                                const vp = document.getElementById('effects-preview-viewport');
                                const canvasEl = document.getElementById('effects-preview-canvas');
                                if (!canvasEl || !vp) return;
                                const vw = vp.clientWidth;
                                const vh = vp.clientHeight;
                                const cw = canvasEl.clientWidth || canvasEl.width || 1;
                                const ch = canvasEl.clientHeight || canvasEl.height || 1;
                                const fitScale = Math.max(0.1, Math.min(8, Math.min(vw / cw, vh / ch)));
                                if (!Number.isFinite(state.ui.effectsPreviewScale) || state.ui.effectsPreviewScale > fitScale * 1.1) {
                                    applyZoom(fitScale);
                                }
                            } catch(_) {}
                        };
                        window.addEventListener('resize', state.ui._effectsResizeHandler);
                    }
                    if (btnIn) btnIn.addEventListener('click', () => applyZoom((state.ui.effectsPreviewScale || 1) * 1.25));
                    if (btnOut) btnOut.addEventListener('click', () => applyZoom((state.ui.effectsPreviewScale || 1) / 1.25));
                    if (btnActual) btnActual.addEventListener('click', () => applyZoom(1));
                    if (btnFit) btnFit.addEventListener('click', () => {
                        const viewport = document.getElementById('effects-preview-viewport');
                        const canvasEl = document.getElementById('effects-preview-canvas');
                        if (!viewport || !canvasEl) return;
                        const vw = viewport.clientWidth;
                        const vh = viewport.clientHeight;
                        const cw = canvasEl.clientWidth || canvasEl.width || 1;
                        const ch = canvasEl.clientHeight || canvasEl.height || 1;
                        const fitScale = Math.max(0.1, Math.min(8, Math.min(vw / cw, vh / ch)));
                        applyZoom(fitScale);
                    });
                    if (btn100) btn100.addEventListener('click', () => applyZoom(1));
                    if (btnSend) btnSend.addEventListener('click', () => {
                        try { sendVisualizerToCanvas(); } catch (e) { console.warn('send to canvas from effects failed', e); }
                    });
                    const btnSavePng = document.getElementById('effects-save-png-btn');
                    if (btnSavePng) btnSavePng.addEventListener('click', () => {
                        try { exportVisualizer('png', 'effects-preview-canvas', (activeMap.name || 'effects') + '-effects', { transparent: !!document.getElementById('effects-transparent-png')?.checked }); } catch (e) { console.warn('effects save PNG failed', e); }
                    });
                };

                // Draw preview first time
                const canvas = document.getElementById('effects-preview-canvas');
                if (canvas) {
                    drawVisualizerCanvas(canvas, activeMap);
                    // Ensure CSS size reflects the underlying pixel buffer for accurate 1:1
                    if (canvas.width && canvas.height) {
                        canvas.style.width = `${canvas.width}px`;
                        canvas.style.height = `${canvas.height}px`;
                    }
                    // Clicking on preview toggles tiles like Visualizer
                    try { canvas.addEventListener('click', onVisualizerCanvasClick); } catch(_) {}
                }
                // Hook preview quality slider
                try {
                    const slider = document.getElementById('effects-preview-quality');
                    const label = document.getElementById('effects-preview-quality-label');
                    if (slider) {
                        const init = Math.round((state.visualizerState?.previewScale || 1) * 100);
                        slider.value = String(init);
                        if (label) label.textContent = `${init}%`;
                        slider.addEventListener('input', () => {
                            const pct = Math.max(5, Math.min(100, parseInt(slider.value, 10) || 100));
                            state.visualizerState.previewScale = pct / 100;
                            try { localStorage.setItem('pixellogic-preview-scale', String(state.visualizerState.previewScale)); } catch(_) {}
                            if (label) label.textContent = `${pct}%`;
                            // Redraw preview and thumbnails at new scale
                            try { if (canvas) drawVisualizerCanvas(canvas, activeMap); } catch(_) {}
                            try { (project.pixelMaps||[]).forEach(pm => { const c=document.getElementById(`effects-thumb-canvas-${pm.id}`); if(c) drawVisualizerCanvas(c, pm); }); } catch(_) {}
                        });
                    }
                } catch(_) {}
                // Apply initial zoom: default to Fit if no persisted value
                let initialScale = state.ui.effectsPreviewScale;
                if (!(typeof initialScale === 'number' && isFinite(initialScale))) {
                    const viewport = document.getElementById('effects-preview-viewport');
                    const canvasEl = document.getElementById('effects-preview-canvas');
                    if (viewport && canvasEl) {
                        const vw = viewport.clientWidth;
                        const vh = viewport.clientHeight;
                        const cw = canvasEl.clientWidth || canvasEl.width || 1;
                        const ch = canvasEl.clientHeight || canvasEl.height || 1;
                        initialScale = Math.max(0.1, Math.min(8, Math.min(vw / cw, vh / ch)));
                    } else {
                        initialScale = 1;
                    }
                }
                applyZoom(initialScale);
                hookZoomControls();

                // Scrolling is handled by the viewport's overflow; no hand-tool panning here by design

                // Removed Logo/Markers tab system; markers now integrated under Coordinates Overlay.
            } catch(e) { console.warn('effects preview init failed', e); }

            // Thumbnails: draw and wire up click to activate
            try {
                if (project && Array.isArray(project.pixelMaps)) {
                    project.pixelMaps.forEach(pm => {
                        const c = document.getElementById(`effects-thumb-canvas-${pm.id}`);
                        if (c) {
                            try { drawVisualizerCanvas(c, pm); } catch (_) {}
                        }
                    });
                    const strip = document.getElementById('effects-thumbs');
                    if (strip) {
                        strip.addEventListener('click', (ev) => {
                            const el = ev.target.closest('[data-thumb-id]');
                            if (!el) return;
                            const id = el.getAttribute('data-thumb-id');
                            const match = project.pixelMaps.find(pm => String(pm.id) === String(id));
                            if (!match) return;
                            project.activePixelMapId = match.id;
                            saveState();
                            renderEffectsDetails();
                        }, { once: false });
                    }
                }
            } catch (e) { console.warn('effects thumbs render error', e); }
        };


        const renderCanvas = () => {
            const project = state.projects.find(p => p.id === state.activeProjectId);
            if (!project) {
                mainContent.canvas.innerHTML = `<div class="text-center text-gray-500">Please select or create a project.</div>`;
                return;
            }
            if (!project.canvases || project.canvases.length === 0) {
                 // Create a default canvas if none exist
                const firstCanvas = {id: Date.now(), name: 'Main Canvas', width: 3840, height: 2160, maps: []};
                project.canvases = [firstCanvas];
                project.activeCanvasId = firstCanvas.id;
            }
            
            const activeOutputMap = getActiveOutputMap();
            const activeCanvas = getActiveCanvas();
            if (!activeCanvas) {
                // This could happen if activeCanvasId is invalid, so select the first one.
                project.activeCanvasId = project.canvases[0].id;
                renderCanvas(); // Re-render with the new active canvas
                return;
            }

            const canvasTabsHtml = project.canvases.map(canvas => `
                <button data-canvas-id="${canvas.id}" title="Switch to Output Map: ${escapeHtml(canvas.name || 'Output Map')}" class="canvas-tab px-4 py-2 text-sm rounded-none ${canvas.id === project.activeCanvasId ? 'bg-gray-800 text-white' : 'bg-gray-700 text-gray-400 hover:bg-gray-600'}">
                    ${escapeHtml(canvas.name || 'Canvas')}
                </button>
            `).join('');
            const regionTabsHtml = activeOutputMap.regions.map((region, index) => `
                <div class="flex items-stretch">
                    <button data-region-id="${region.id}" title="Open ${region.name || `Canvas ${index + 1}`}" class="canvas-region-tab flex items-center gap-2 px-3 py-1.5 text-xs font-semibold rounded-none border ${region.id === activeOutputMap.activeRegionId ? 'border-emerald-400 bg-emerald-950/60 text-emerald-200' : 'border-gray-600 bg-gray-800 text-gray-400 hover:border-emerald-600 hover:text-gray-200'}">
                        <span class="inline-block w-3.5 h-2.5 border border-emerald-400"></span>
                        <span class="region-tab-name">${region.name || `Canvas ${index + 1}`}</span>
                        <span class="text-[10px] opacity-60">${region.width}×${region.height}</span>
                    </button>
                    <button data-save-region-id="${region.id}" class="canvas-region-save-btn flex items-center justify-center w-8 rounded-none border border-l-0 border-gray-600 bg-gray-700 text-gray-300 hover:bg-emerald-700 hover:text-white" title="Save ${region.name || `Canvas ${index + 1}`} as PNG" aria-label="Save ${region.name || `Canvas ${index + 1}`} as PNG">
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"></path><path d="m7 10 5 5 5-5"></path><path d="M5 21h14"></path></svg>
                    </button>
                </div>
            `).join('');
            const canvasWorkspaceFramesHtml = activeOutputMap.regions.map((region, index) => `
                <button type="button" data-workspace-region-id="${region.id}" class="canvas-workspace-frame ${region.id === activeOutputMap.activeRegionId ? 'is-active' : ''}" title="${region.id === activeOutputMap.activeRegionId ? 'Active canvas' : `Open ${region.name || `Canvas ${index + 1}`}`}">
                    ${region.id === activeOutputMap.activeRegionId ? '' : `<canvas class="canvas-workspace-preview" data-preview-region-id="${region.id}"></canvas>`}
                    <span class="canvas-workspace-label">
                        <span>${region.name || `Canvas ${index + 1}`}</span>
                        <span class="font-normal text-emerald-300/70">${region.width}×${region.height}</span>
                        <span class="font-normal text-gray-400">${region.maps?.length || 0} map${region.maps?.length === 1 ? '' : 's'}</span>
                    </span>
                </button>
            `).join('');

            const baseCanvasPresets = [
                { w: 1280, h: 720, label: 'HD (1280 × 720)' },
                { w: 1366, h: 768, label: 'WXGA (1366 × 768)' },
                { w: 1600, h: 900, label: 'HD+ (1600 × 900)' },
                { w: 1920, h: 1080, label: 'Full HD (1920 × 1080)' },
                { w: 1920, h: 1200, label: 'WUXGA (1920 × 1200)' },
                { w: 2560, h: 1440, label: 'QHD (2560 × 1440)' },
                { w: 2560, h: 1600, label: 'WQXGA (2560 × 1600)' },
                { w: 3440, h: 1440, label: 'UWQHD (3440 × 1440)' },
                { w: 3840, h: 2160, label: '4K UHD (3840 × 2160)' },
                { w: 4096, h: 2160, label: 'DCI 4K (4096 × 2160)' },
                { w: 5120, h: 1440, label: 'DQHD (5120 × 1440)' },
                { w: 5120, h: 2160, label: '5K2K (5120 × 2160)' },
                { w: 5120, h: 2880, label: '5K UHD (5120 × 2880)' },
                { w: 7680, h: 4320, label: '8K UHD (7680 × 4320)' },
                { w: 1080, h: 1920, label: 'Portrait FHD (1080 × 1920)' },
                { w: 2160, h: 3840, label: 'Portrait 4K (2160 × 3840)' }
            ];
            const savedCanvasPresets = getSavedCanvasSizePresets();
            const basePresetKeys = new Set(baseCanvasPresets.map(p => `${p.w}x${p.h}`));
            const mergedCanvasPresets = [
                ...baseCanvasPresets,
                ...savedCanvasPresets
                    .filter(p => !basePresetKeys.has(`${p.w}x${p.h}`))
                    .map(p => ({ w: p.w, h: p.h, label: `Saved (${p.w} × ${p.h})` }))
            ];
            const canvasPresetOptionsHtml = mergedCanvasPresets
                .map(p => `<option value="${p.w}x${p.h}">${p.label}</option>`)
                .join('') + '<option value="custom">Custom</option>';

            mainContent.canvas.innerHTML = `
                <div class="bg-gray-800 p-3 rounded-xl shadow-lg">
                    <div class="flex flex-wrap justify-between items-center mb-2 gap-2 border-b border-gray-700 pb-2">
                                 <div class="flex items-center gap-2">
                                     <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Output Map</span>
                            ${canvasTabsHtml}
                                     <button id="rename-output-map-btn" class="btn-glow px-3 py-1.5 text-sm rounded-md bg-gray-600 hover:bg-gray-700" title="Rename the selected Output Map">Rename</button>
                                     <button id="add-canvas-btn" class="btn-glow p-2 rounded-md bg-gray-600 hover:bg-gray-700" title="Add another Output Map">+</button>
                         </div>
                                <div class="flex items-center gap-2">
                                    <button id="export-canvas-png-btn" class="btn-glow flex items-center gap-1 px-3 py-1.5 text-xs font-semibold rounded-none bg-emerald-700 hover:bg-emerald-600 text-white" title="Export the Output Canvas as a transparent PNG">Save as PNG</button>
                                    <label class="flex items-center gap-1.5 text-xs text-gray-300 cursor-pointer whitespace-nowrap" title="Export PNG with transparent background"><input id="export-canvas-transparent" type="checkbox" class="form-checkbox bg-gray-700" checked> Transparent PNG</label>
                                    <button id="export-canvas-jpg-btn" class="btn-glow flex items-center gap-1 px-3 py-1.5 text-xs font-semibold rounded-none bg-sky-700 hover:bg-sky-600 text-white" title="Export the Output Canvas as a JPEG">Save as JPG</button>
                                    <span class="w-px h-5 bg-gray-600 mx-1 shrink-0"></span>
                                    <div class="inline-flex items-center gap-1.5 bg-gray-900 border border-gray-600 rounded-none p-1">
                                        <label for="export-canvas-pdf-scope" class="text-xs text-gray-400 pl-1 font-medium">PDF Scope:</label>
                                        <select id="export-canvas-pdf-scope" class="bg-gray-800 text-xs text-gray-200 px-2 py-1 border border-gray-700 rounded-none focus:outline-none cursor-pointer" title="Select which canvases to include in PDF">
                                            <option value="active">Active Canvas (1 Page)</option>
                                            <option value="current-output-map" selected>All Canvases (This Output Map)</option>
                                            <option value="all-output-maps">All Output Maps &amp; Canvases</option>
                                        </select>
                                        <button id="export-canvas-pdf-btn" class="btn-glow flex items-center gap-1.5 px-3 py-1 text-xs font-semibold rounded-none bg-rose-600 hover:bg-rose-700 text-white" title="Export chosen Canvases to a PDF file">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                                            Save as PDF
                                        </button>
                                    </div>
                                    <span class="w-px h-5 bg-gray-600 mx-1 shrink-0"></span>
                                    <button id="duplicate-canvas-btn" class="btn-glow px-3 py-1.5 text-xs font-semibold rounded-none bg-gray-700 hover:bg-gray-600 border border-gray-600" title="Create a copy of this Output Map">Duplicate Output Map</button>
                                    <button id="delete-canvas-btn" class="btn-glow px-3 py-1.5 text-xs font-semibold rounded-none bg-red-700 hover:bg-red-600 border border-red-500/50" title="Remove this Output Map (cannot be undone)">Delete Output Map</button>
                                </div>
                    </div>

                    <div class="flex flex-wrap items-center gap-2 pb-2 mb-1 border-b border-gray-700/50">
                        <span class="text-xs font-semibold text-emerald-400 uppercase tracking-wider shrink-0">Canvases in this Output Map</span>
                        ${regionTabsHtml}
                        <button id="add-region-btn" class="btn-glow px-2.5 py-1.5 text-sm rounded-md bg-emerald-700 hover:bg-emerald-600" title="Add a canvas inside this Output Map">+ Canvas</button>
                        <button id="duplicate-region-btn" class="btn-glow px-2.5 py-1.5 text-sm rounded-md bg-gray-700 hover:bg-gray-600" title="Duplicate the open canvas">Duplicate</button>
                        <button id="delete-region-btn" class="btn-glow px-2.5 py-1.5 text-sm rounded-md bg-red-800 hover:bg-red-700 disabled:opacity-40" ${activeOutputMap.regions.length <= 1 ? 'disabled' : ''} title="Delete the open canvas">Delete</button>
                        <span class="w-px h-5 bg-gray-600 mx-1"></span>
                        <label class="flex items-center gap-2 text-xs text-gray-300">Arrange
                            <select id="canvas-region-layout" class="bg-gray-700 border border-gray-600 rounded px-2 py-1 text-sm" title="Arrange canvases beside each other or from top to bottom">
                                <option value="horizontal" ${activeOutputMap.regionLayout === 'horizontal' ? 'selected' : ''}>Side by side</option>
                                <option value="vertical" ${activeOutputMap.regionLayout === 'vertical' ? 'selected' : ''}>Top to bottom</option>
                            </select>
                        </label>
                        <label class="flex items-center gap-2 text-xs text-gray-300">Gap
                            <input id="canvas-region-gap" type="number" min="20" step="1" value="${activeOutputMap.regionGap}" class="w-20 bg-gray-900 border border-gray-600 rounded px-2 py-1 text-sm" title="Gap between canvases; minimum 20 pixels">
                            <span class="text-gray-500">px</span>
                        </label>
                    </div>

                    <div class="flex flex-wrap items-center gap-2 pb-2 mb-1 border-b border-gray-700/50">
                        <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider shrink-0">Canvas:</span>
                        <input id="canvas-name-input" type="text" value="${activeCanvas.name}" class="w-44 bg-gray-900 border border-gray-600 rounded-lg px-2 py-1 text-sm font-semibold text-accent focus:outline-none focus:ring-2 focus:ring-accent/40" title="Rename the open canvas" />
                        <span class="w-px h-4 bg-gray-600 shrink-0"></span>
                        <select id="canvas-preset-select" class="bg-gray-700 border border-gray-600 rounded-lg px-2 py-1 text-sm" title="Choose a preset resolution or switch to Custom">${canvasPresetOptionsHtml}</select>
                        <div id="canvas-custom-size" class="flex items-center gap-1.5" title="Enter custom width and height in pixels">
                            <input type="text" id="canvas-custom-width" placeholder="W" class="w-20 bg-gray-900 border border-gray-600 rounded-lg px-2 py-1 text-sm" title="Canvas width (px). Supports expressions like 3840*2 or 7680/2">
                            <span class="text-gray-500 text-xs">×</span>
                            <input type="text" id="canvas-custom-height" placeholder="H" class="w-20 bg-gray-900 border border-gray-600 rounded-lg px-2 py-1 text-sm" title="Canvas height (px). Supports expressions like 2160/2 or 1080*2">
                            <button id="canvas-save-custom-size-btn" class="btn-glow px-2 py-1 text-xs rounded-md bg-gray-600 hover:bg-gray-700" title="Save this custom size for reuse in presets">Save Size</button>
                            <button id="canvas-delete-custom-size-btn" class="btn-glow px-2 py-1 text-xs rounded-md bg-red-700 hover:bg-red-600" title="Delete this size from saved presets">Delete</button>
                            <button id="canvas-clear-custom-sizes-btn" class="btn-glow px-2 py-1 text-xs rounded-md bg-red-900 hover:bg-red-800" title="Clear all saved custom sizes">Clear</button>
                        </div>
                    </div>
                    <div class="flex items-start mb-1">
                         <div class="flex flex-wrap items-center gap-2">
                            <button id="canvas-zoom-out-btn" class="btn-glow p-2 rounded-lg bg-gray-600 hover:bg-gray-700" title="Zoom out"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg></button>
                            <button id="canvas-zoom-in-btn" class="btn-glow p-2 rounded-lg bg-gray-600 hover:bg-gray-700" title="Zoom in"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg></button>
                            <button id="canvas-fit-btn" class="btn-glow p-2 rounded-lg bg-gray-600 hover:bg-gray-700" title="Fit to screen"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8V4h4M20 8V4h-4M4 16v4h4M20 16v4h-4"></path></svg></button>
                            <span class="mx-2 text-gray-500 hidden md:inline">|</span>
                            
                             <button id="delete-map-btn" class="btn-glow flex items-center justify-center gap-2 px-3 py-2 text-sm font-semibold rounded-lg shadow-md bg-red-600 hover:bg-red-700" title="Remove the selected map from this canvas">
                                 <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                 Delete Selected
                             </button>
                            <div class="flex items-center gap-2" title="Undo/Redo last deleted pixel map on this canvas">
                                <button id="undo-map-delete-btn" class="px-3 py-2 text-sm rounded-lg bg-gray-700 hover:bg-gray-600 disabled:opacity-40 disabled:cursor-not-allowed">Undo Delete</button>
                                <button id="redo-map-delete-btn" class="px-3 py-2 text-sm rounded-lg bg-gray-700 hover:bg-gray-600 disabled:opacity-40 disabled:cursor-not-allowed">Redo Delete</button>
                            </div>
                            <label class="flex items-center gap-2 cursor-pointer" title="Show a reference grid on the Output Canvas"><input type="checkbox" id="canvas-grid-toggle" class="form-checkbox bg-gray-700" ${state.canvasState.grid ? 'checked':''}> Grid</label>
                            <label class="flex items-center gap-2 cursor-pointer" title="Display rulers along the top and left edges"><input type="checkbox" id="canvas-rulers-toggle" class="form-checkbox bg-gray-700" ${state.canvasState.rulers ? 'checked':''}> Rulers</label>
                            <label class="flex items-center gap-2 cursor-pointer" title="Snap dragged maps to grid and edges"><input type="checkbox" id="canvas-snapping-toggle" class="form-checkbox bg-gray-700" ${state.canvasState.snapping ? 'checked':''}> Snapping</label>
                            <span class="w-px h-4 bg-gray-700 mx-1"></span>
                            <div class="flex items-center gap-1.5" title="Font size for map coordinate labels">
                                <label class="text-xs text-gray-400" for="coord-font-size">Coord Font</label>
                                <input id="coord-font-size" type="range" min="8" max="36" step="1" value="${state.canvasState.coordFontSize || 12}" class="w-20">
                                <span id="coord-font-size-val" class="text-xs text-gray-400">${state.canvasState.coordFontSize || 12}px</span>
                            </div>
                            <!-- Cropping controls for selected map -->
                            ${(function(){
                                const ac = getActiveCanvas();
                                const sel = ac?.maps?.find(m=>m.id===state.canvasState.selectedMapId);
                                const left = (sel?.cropLeft ?? sel?.sliceLeft) || 0; 
                                const right = (sel?.cropRight ?? sel?.sliceRight) || 0;
                                const top = (sel?.cropTop ?? 0); 
                                const bottom = (sel?.cropBottom ?? 0);
                                const pW = Math.max(1, sel?.panelResWidth || 128);
                                const pH = Math.max(1, sel?.panelResHeight || 128);
                                const lPanels = Math.floor(left / pW);
                                const rPanels = Math.floor(right / pW);
                                const tPanels = Math.floor(top / pH);
                                const bPanels = Math.floor(bottom / pH);
                                return `<div class=\"flex items-center gap-2\"> 
                                    <span class=\"text-xs font-semibold text-gray-300 uppercase tracking-wide\">Crop (Panels):</span>
                                    <label class=\"text-xs text-gray-400\">Left</label>
                                    <input type=\"text\" id=\"crop-panels-left-input\" class=\"w-14 bg-gray-900 border border-gray-600 rounded-none px-2 py-1 text-xs\" ${sel?`value=\"${lPanels}\"`:'value=\"0\" disabled'}>
                                    <label class=\"text-xs text-gray-400\">Right</label>
                                    <input type=\"text\" id=\"crop-panels-right-input\" class=\"w-14 bg-gray-900 border border-gray-600 rounded-none px-2 py-1 text-xs\" ${sel?`value=\"${rPanels}\"`:'value=\"0\" disabled'}>
                                    <label class=\"text-xs text-gray-400\">Top</label>
                                    <input type=\"text\" id=\"crop-panels-top-input\" class=\"w-14 bg-gray-900 border border-gray-600 rounded-none px-2 py-1 text-xs\" ${sel?`value=\"${tPanels}\"`:'value=\"0\" disabled'}>
                                    <label class=\"text-xs text-gray-400\">Bottom</label>
                                    <input type=\"text\" id=\"crop-panels-bottom-input\" class=\"w-14 bg-gray-900 border border-gray-600 rounded-none px-2 py-1 text-xs\" ${sel?`value=\"${bPanels}\"`:'value=\"0\" disabled'}>
                                </div>`;
                            })()}
                        </div>
                    </div>

                    <!-- Mask Tools Section (Square Engineering Style) -->
                    <div id="mask-tools" class="mt-1 mb-2 p-3 rounded-none bg-gray-900 border border-gray-700 shadow-md">
                        <button id="mask-tools-toggle" type="button" class="flex w-full items-center justify-between px-3 text-xs font-semibold uppercase tracking-wider text-purple-300 hover:text-white hover:bg-gray-800 rounded-none transition-colors" style="height:34px;margin:-0.75rem -0.75rem 0;padding:0 0.75rem" aria-expanded="${state.canvasState.maskToolsOpen ? 'true' : 'false'}" title="Open or close mask tools">
                            <span class="flex items-center gap-2">
                                <span class="inline-block w-3 h-3 border border-purple-400 bg-purple-900/50"></span>
                                <span>Masks & Apertures</span>
                            </span>
                            <span id="mask-tools-chevron" class="text-gray-400 transition-transform" style="transform:rotate(${state.canvasState.maskToolsOpen ? '180deg' : '0deg'})">&#9662;</span>
                        </button>

                        <div id="mask-tools-content" class="pt-3" style="display:${state.canvasState.maskToolsOpen ? 'block' : 'none'}">
                            <!-- Top Bar: Shapes, Smart Align, Views, Exports -->
                            <div class="flex flex-wrap items-center justify-between gap-3 pb-2.5 border-b border-gray-700/60">
                                <!-- Left: Shapes & Alignment -->
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="text-xs font-bold text-purple-300 uppercase tracking-wider shrink-0">Add Mask:</span>
                                    <div class="inline-flex border border-gray-600 bg-gray-800">
                                        <button id="mask-rect-btn" type="button" class="px-2.5 py-1 text-xs font-semibold text-gray-200 hover:text-white bg-gray-700 hover:bg-purple-600 rounded-none transition-colors" title="Draw rectangle mask (with optional corner radius)">□ Rect</button>
                                        <button id="mask-ellipse-btn" type="button" class="px-2.5 py-1 text-xs font-semibold text-gray-200 hover:text-white bg-gray-700 hover:bg-purple-600 rounded-none border-l border-gray-600 transition-colors" title="Draw ellipse mask">⬭ Ellipse</button>
                                        <button id="mask-polygon-btn" type="button" class="px-2.5 py-1 text-xs font-semibold text-gray-200 hover:text-white bg-gray-700 hover:bg-purple-600 rounded-none border-l border-gray-600 transition-colors" title="Draw custom polygon mask (click points, click 1st point to close)">△ Polygon</button>
                                    </div>

                                    <span class="w-px h-5 bg-gray-700 mx-1"></span>

                                    <span class="text-xs font-bold text-gray-400 uppercase tracking-wider shrink-0">Align:</span>
                                    <button id="mask-snap-wall-btn" type="button" class="px-2.5 py-1 text-xs font-medium bg-gray-800 hover:bg-gray-700 text-gray-200 hover:text-white border border-gray-600 rounded-none transition-colors" title="Snap selected mask to match selected LED screen / wall position and size">⊞ Snap to Screen</button>
                                    <button id="mask-snap-panel-btn" type="button" class="px-2.5 py-1 text-xs font-medium bg-gray-800 hover:bg-gray-700 text-gray-200 hover:text-white border border-gray-600 rounded-none transition-colors" title="Snap selected mask to cabinet / panel resolution grid">▦ Snap to Panels</button>
                                    <select id="mask-aspect-select" class="w-40 min-w-[150px] bg-gray-800 text-white border border-gray-600 px-2.5 py-1 text-xs font-medium rounded-none cursor-pointer" title="Conform selected mask to standard aspect ratio presets">
                                        <option value="">Aspect Presets...</option>
                                        <option value="16:9">16 : 9 Widescreen</option>
                                        <option value="21:9">21 : 9 Ultrawide</option>
                                        <option value="4:3">4 : 3 Classic</option>
                                        <option value="1:1">1 : 1 Square</option>
                                        <option value="full">Fit Full Canvas</option>
                                        <option value="center">Center in Canvas</option>
                                    </select>
                                </div>

                                <!-- Right: Global Display & Exports -->
                                <div class="flex flex-wrap items-center gap-2">
                                    <label class="flex items-center gap-1.5 text-xs text-gray-300 font-medium cursor-pointer select-none" title="Show or hide all mask overlays on the canvas">
                                        <input id="mask-show-toggle" type="checkbox" class="form-checkbox h-3.5 w-3.5 bg-gray-800 rounded-none border border-gray-600" ${state.canvasState.showMasks !== false ? 'checked' : ''}> Show Masks
                                    </label>
                                    <label class="flex items-center gap-1.5 text-xs text-gray-300 font-medium cursor-pointer select-none" title="Invert cutout clipping (keep content outside mask)">
                                        <input id="mask-invert-toggle" type="checkbox" class="form-checkbox h-3.5 w-3.5 bg-gray-800 rounded-none border border-gray-600"> Invert
                                    </label>
                                    <span class="w-px h-5 bg-gray-700 mx-1"></span>
                                    <button id="mask-export-with-btn" type="button" class="px-3 py-1 text-xs font-semibold bg-emerald-600 hover:bg-emerald-500 text-white border border-emerald-500 rounded-none shadow transition-colors" title="Export full canvas with mask overlays on top">⤓ Export with Mask</button>
                                    <button id="mask-export-only-btn" type="button" class="px-3 py-1 text-xs font-semibold bg-purple-600 hover:bg-purple-500 text-white border border-purple-500 rounded-none shadow transition-colors" title="Export LEDs clipped to mask as transparent PNG">✂ Export Cutout PNG</button>
                                </div>
                            </div>

                            <!-- Bottom Section: Selected Mask Properties (Left) + Layers List (Right) -->
                            <div class="flex flex-col xl:flex-row gap-3 pt-2.5">
                                <!-- Properties Card -->
                                <div id="mask-props-panel" class="flex-1 min-w-0 bg-gray-800/80 border border-gray-700 rounded-none p-2.5 flex flex-col gap-2.5">
                                    <div class="flex items-center justify-between pb-1.5 border-b border-gray-700/60">
                                        <div class="flex items-center gap-2">
                                            <span class="text-xs font-bold text-purple-300 uppercase tracking-wider">Selected Mask Properties</span>
                                            <span id="mask-selected-name-badge" class="px-2 py-0.5 text-xs font-mono bg-purple-950/80 text-purple-300 border border-purple-600/50">None</span>
                                        </div>
                                        <span id="mask-selected-hint" class="text-xs text-gray-400">Select a mask on canvas or in layer list to adjust</span>
                                    </div>

                                    <!-- Row A: Mode, Units, Coordinates & Dimensions -->
                                    <div class="flex flex-wrap items-center gap-3">
                                        <div class="flex items-center gap-1.5">
                                            <label class="text-xs font-semibold text-gray-300 uppercase tracking-wide">Mode:</label>
                                            <select id="mask-prop-mode" class="w-44 min-w-[160px] bg-gray-900 text-white border border-gray-600 rounded-none px-2.5 py-1 text-xs font-medium cursor-pointer" title="Mask Type: Blackout (opaque cover), Cutout (alpha punch-through), or Guide (non-export visual outline)">
                                                <option value="blackout">Blackout (Solid)</option>
                                                <option value="cutout">Alpha Cutout</option>
                                                <option value="guide">Scenic Guide</option>
                                            </select>
                                        </div>

                                        <span class="w-px h-5 bg-gray-700"></span>

                                        <div class="flex items-center gap-1.5">
                                            <label class="text-xs font-semibold text-gray-400 uppercase">Unit:</label>
                                            <select id="mask-unit-select" class="w-18 min-w-[65px] bg-gray-900 text-white border border-gray-600 rounded-none px-2 py-1 text-xs cursor-pointer">
                                                <option value="px" ${(state.canvasState.maskUnit||'px')==='px'?'selected':''}>px</option>
                                                <option value="mm" ${state.canvasState.maskUnit==='mm'?'selected':''}>mm</option>
                                                <option value="cm" ${state.canvasState.maskUnit==='cm'?'selected':''}>cm</option>
                                                <option value="m" ${state.canvasState.maskUnit==='m'?'selected':''}>m</option>
                                                <option value="ft" ${state.canvasState.maskUnit==='ft'?'selected':''}>ft</option>
                                                <option value="in" ${state.canvasState.maskUnit==='in'?'selected':''}>in</option>
                                            </select>
                                            <input id="mask-px-per-unit" type="number" min="0.01" step="0.1" value="${state.canvasState.maskPxPerUnit || 1}" class="w-16 bg-gray-900 text-white border border-gray-600 rounded-none px-2 py-1 text-xs font-mono" title="Pixels per unit">
                                        </div>

                                        <span class="w-px h-5 bg-gray-700"></span>

                                        <div class="flex items-center gap-2">
                                            <label class="flex items-center gap-1 text-xs text-gray-300 font-semibold" title="X Position (supports expressions like 100+20)">
                                                <span>X</span>
                                                <input id="mask-prop-x" type="text" inputmode="decimal" placeholder="0" class="w-20 bg-gray-900 text-white border border-gray-600 rounded-none px-2 py-1 text-xs font-mono">
                                            </label>
                                            <label class="flex items-center gap-1 text-xs text-gray-300 font-semibold" title="Y Position (supports expressions)">
                                                <span>Y</span>
                                                <input id="mask-prop-y" type="text" inputmode="decimal" placeholder="0" class="w-20 bg-gray-900 text-white border border-gray-600 rounded-none px-2 py-1 text-xs font-mono">
                                            </label>
                                            <label class="flex items-center gap-1 text-xs text-gray-300 font-semibold" title="Width (supports expressions like 1920/2)">
                                                <span>W</span>
                                                <input id="mask-prop-w" type="text" inputmode="decimal" placeholder="100" class="w-20 bg-gray-900 text-white border border-gray-600 rounded-none px-2 py-1 text-xs font-mono">
                                            </label>
                                            <label class="flex items-center gap-1 text-xs text-gray-300 font-semibold" title="Height (supports expressions)">
                                                <span>H</span>
                                                <input id="mask-prop-h" type="text" inputmode="decimal" placeholder="100" class="w-20 bg-gray-900 text-white border border-gray-600 rounded-none px-2 py-1 text-xs font-mono">
                                            </label>
                                        </div>
                                    </div>

                                    <!-- Row B: Shaping (Radius & Feather), Color & Opacity -->
                                    <div class="flex flex-wrap items-center gap-3 pt-1 border-t border-gray-700/40">
                                        <div class="flex items-center gap-1.5">
                                            <label class="text-xs font-semibold text-gray-300" title="Corner Radius in pixels (for rectangle masks)">Corner Radius:</label>
                                            <input id="mask-prop-radius" type="number" min="0" max="500" placeholder="0" class="w-18 bg-gray-900 text-white border border-gray-600 rounded-none px-2 py-1 text-xs font-mono">
                                            <span class="text-xs text-gray-400">px</span>
                                        </div>

                                        <span class="w-px h-5 bg-gray-700"></span>

                                        <div class="flex items-center gap-1.5">
                                            <label class="text-xs font-semibold text-gray-300" title="Edge Feather / Soft Edge blur in pixels">Edge Feather:</label>
                                            <input id="mask-prop-feather" type="number" min="0" max="100" placeholder="0" class="w-18 bg-gray-900 text-white border border-gray-600 rounded-none px-2 py-1 text-xs font-mono">
                                            <span class="text-xs text-gray-400">px</span>
                                        </div>

                                        <span class="w-px h-5 bg-gray-700"></span>

                                        <div class="flex items-center gap-2">
                                            <label class="text-xs font-semibold text-gray-300" title="Mask color">Fill Color:</label>
                                            <input id="mask-fill-color" type="color" value="#000000" class="w-7 h-7 p-0.5 bg-gray-900 border border-gray-600 rounded-none cursor-pointer" title="Fill color">
                                        </div>

                                        <div class="flex items-center gap-2">
                                            <label class="text-xs font-semibold text-gray-300" title="Mask opacity">Opacity:</label>
                                            <input id="mask-fill-opacity" type="range" min="0" max="100" value="100" class="w-24 accent-purple-500 cursor-pointer" title="Opacity">
                                            <span id="mask-fill-opacity-val" class="text-xs text-gray-300 font-mono w-10">100%</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Layers List Card (Right) -->
                                <div id="mask-list-panel" class="w-full xl:w-96 flex-shrink-0 bg-gray-800/80 border border-gray-700 rounded-none flex flex-col">
                                    <div class="flex items-center justify-between px-3 py-1.5 bg-gray-900 border-b border-gray-700">
                                        <div class="flex items-center gap-2">
                                            <span class="text-xs font-bold text-gray-200 uppercase tracking-wider">Mask Layers</span>
                                            <span id="mask-list-count" class="px-1.5 py-0.2 bg-purple-900 text-purple-200 text-xs font-mono border border-purple-500/50">0</span>
                                        </div>
                                        <div class="flex items-center gap-1.5">
                                            <button id="mask-duplicate-btn" type="button" class="px-2 py-0.5 text-xs font-medium bg-gray-700 hover:bg-gray-600 text-gray-200 border border-gray-600 rounded-none transition-colors disabled:opacity-40" disabled title="Duplicate selected mask">Duplicate</button>
                                            <button id="mask-delete-btn" type="button" class="px-2 py-0.5 text-xs font-medium bg-red-900/60 hover:bg-red-700 text-red-200 border border-red-700 rounded-none transition-colors disabled:opacity-40" disabled title="Delete selected mask">Delete</button>
                                            <button id="mask-clear-all-btn" type="button" class="px-2 py-0.5 text-xs font-medium bg-red-950/40 hover:bg-red-800 text-red-300 border border-red-800 rounded-none transition-colors" title="Clear all masks">Clear All</button>
                                        </div>
                                    </div>
                                    <div id="mask-list-body" class="overflow-y-auto p-1.5 flex flex-col gap-1" style="max-height:108px;min-height:76px"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="main-canvas-wrapper" class="w-full bg-gray-900 rounded-none overflow-auto relative" style="height:62vh">
                        <div id="canvas-regions-stage" class="absolute top-0 left-0">
                            ${canvasWorkspaceFramesHtml}
                        </div>
                        <canvas id="grid-canvas" class="absolute top-0 left-0 z-0 pointer-events-none"></canvas>
                        <canvas id="ruler-top" class="absolute top-0 left-0 z-10 pointer-events-none"></canvas>
                        <canvas id="ruler-left" class="absolute top-0 left-0 z-10 pointer-events-none"></canvas>
                        <div id="main-canvas-container" class="absolute top-0 left-0">
                            <canvas id="main-canvas"></canvas>
                            <canvas id="draw-overlay" class="absolute top-0 left-0"></canvas>
                        </div>
                    </div>
                </div>
            `;

            document.querySelectorAll('.canvas-tab').forEach(tab => {
                tab.addEventListener('click', (e) => {
                    project.activeCanvasId = parseInt(e.currentTarget.dataset.canvasId);
                    renderCanvas();
                });
            });
            document.querySelectorAll('.canvas-region-tab').forEach(tab => {
                tab.addEventListener('click', (e) => {
                    activeOutputMap.activeRegionId = parseInt(e.currentTarget.dataset.regionId);
                    state.canvasState.selectedMapId = null;
                    saveState();
                    renderCanvas();
                });
            });
            document.querySelectorAll('.canvas-region-save-btn').forEach(button => {
                button.addEventListener('click', (e) => {
                    const regionId = parseInt(e.currentTarget.dataset.saveRegionId);
                    const region = activeOutputMap.regions.find(item => item.id === regionId);
                    if (region) exportCanvas('png', region);
                });
            });
            document.querySelectorAll('.canvas-workspace-frame:not(.is-active)').forEach(frame => {
                frame.addEventListener('click', (e) => {
                    activeOutputMap.activeRegionId = parseInt(e.currentTarget.dataset.workspaceRegionId);
                    state.canvasState.selectedMapId = null;
                    saveState();
                    renderCanvas();
                });
            });
            const maskToolsToggle = document.getElementById('mask-tools-toggle');
            if (maskToolsToggle) maskToolsToggle.addEventListener('click', () => {
                state.canvasState.maskToolsOpen = !state.canvasState.maskToolsOpen;
                const content = document.getElementById('mask-tools-content');
                const chevron = document.getElementById('mask-tools-chevron');
                if (content) content.style.display = state.canvasState.maskToolsOpen ? 'block' : 'none';
                if (chevron) chevron.style.transform = state.canvasState.maskToolsOpen ? 'rotate(180deg)' : 'rotate(0deg)';
                maskToolsToggle.setAttribute('aria-expanded', String(state.canvasState.maskToolsOpen));
            });
            document.getElementById('rename-output-map-btn').addEventListener('click', () => renameItem('outputMap'));
            try {
            document.getElementById('add-canvas-btn').addEventListener('click', addCanvas);
            document.getElementById('delete-canvas-btn').addEventListener('click', deleteCanvas);
            const dupCanvasBtn = document.getElementById('duplicate-canvas-btn'); if (dupCanvasBtn) dupCanvasBtn.addEventListener('click', duplicateCanvas);
            document.getElementById('add-region-btn').addEventListener('click', addCanvasRegion);
            document.getElementById('duplicate-region-btn').addEventListener('click', duplicateCanvasRegion);
            document.getElementById('delete-region-btn').addEventListener('click', deleteCanvasRegion);
            document.getElementById('canvas-region-layout').addEventListener('change', (e) => {
                activeOutputMap.regionLayout = e.target.value === 'vertical' ? 'vertical' : 'horizontal';
                saveState();
                drawMainCanvas();
            });
            const regionGapInput = document.getElementById('canvas-region-gap');
            regionGapInput.addEventListener('change', () => {
                activeOutputMap.regionGap = Math.max(20, parseInt(regionGapInput.value, 10) || 20);
                regionGapInput.value = activeOutputMap.regionGap;
                saveState();
                drawMainCanvas();
            });
            document.getElementById('canvas-preset-select').addEventListener('change', handleCanvasPresetChange);
            document.getElementById('canvas-custom-width').addEventListener('change', handleCanvasCustomSizeChange);
            document.getElementById('canvas-custom-height').addEventListener('change', handleCanvasCustomSizeChange);
            document.getElementById('canvas-custom-width').addEventListener('keydown', (e) => { if (e.key === 'Enter') handleCanvasCustomSizeChange(); });
            document.getElementById('canvas-custom-height').addEventListener('keydown', (e) => { if (e.key === 'Enter') handleCanvasCustomSizeChange(); });
            const saveCustomSizeBtn = document.getElementById('canvas-save-custom-size-btn');
            if (saveCustomSizeBtn) saveCustomSizeBtn.addEventListener('click', saveCurrentCanvasCustomSize);
            const deleteCustomSizeBtn = document.getElementById('canvas-delete-custom-size-btn');
            if (deleteCustomSizeBtn) deleteCustomSizeBtn.addEventListener('click', deleteCurrentCanvasCustomSize);
            const clearCustomSizesBtn = document.getElementById('canvas-clear-custom-sizes-btn');
            if (clearCustomSizesBtn) clearCustomSizesBtn.addEventListener('click', clearAllCanvasCustomSizes);
            document.getElementById('export-canvas-png-btn').addEventListener('click', () => exportCanvas('png'));
            document.getElementById('export-canvas-jpg-btn').addEventListener('click', () => exportCanvas('jpeg'));
            { const pdfBtn = document.getElementById('export-canvas-pdf-btn'); if (pdfBtn) pdfBtn.addEventListener('click', () => exportCanvas('pdf')); }
            document.getElementById('canvas-zoom-in-btn').addEventListener('click', () => handleCanvasZoom(1.25));
            document.getElementById('canvas-zoom-out-btn').addEventListener('click', () => handleCanvasZoom(0.8));
            document.getElementById('canvas-fit-btn').addEventListener('click', fitCanvasToScreen);
            document.getElementById('delete-map-btn').addEventListener('click', deleteSelectedMapFromCanvas);
            } catch(_) {}
            // Map delete undo/redo buttons
            try {
                const undoMapBtn = document.getElementById('undo-map-delete-btn');
                const redoMapBtn = document.getElementById('redo-map-delete-btn');
                if (undoMapBtn) undoMapBtn.addEventListener('click', undoCanvasMapDelete);
                if (redoMapBtn) redoMapBtn.addEventListener('click', redoCanvasMapDelete);
                updateMapUndoRedoButtons();
            } catch(_) {}
            // Hook preview quality slider for Output Canvas
            try {
                const slider = document.getElementById('canvas-preview-quality');
                const label = document.getElementById('canvas-preview-quality-label');
                if (slider) {
                    const init = Math.round((state.visualizerState?.previewScale || 1) * 100);
                    slider.value = String(init);
                    if (label) label.textContent = `${init}%`;
                    slider.addEventListener('input', () => {
                        const pct = Math.max(5, Math.min(100, parseInt(slider.value, 10) || 100));
                        state.visualizerState = state.visualizerState || {};
                        state.visualizerState.previewScale = pct / 100;
                        try { localStorage.setItem('pixellogic-preview-scale', String(state.visualizerState.previewScale)); } catch(_) {}
                        if (label) label.textContent = `${pct}%`;
                        drawMainCanvas();
                    });
                }
            } catch(_) {}
            // Canvas name input -> updates the active nested canvas and its tab label
            const canvasNameInput = document.getElementById('canvas-name-input');
            if (canvasNameInput) {
                const commitCanvasRename = () => {
                    const project = state.projects.find(p => p.id === state.activeProjectId);
                    const ac = getActiveCanvas();
                    if (!project || !ac) return;
                    const val = (canvasNameInput.value || '').trim();
                    if (!val) { canvasNameInput.value = ac.name || ''; return; }
                    ac.name = val;
                    saveState();
                    const activeTabBtn = document.querySelector(`.canvas-region-tab[data-region-id="${ac.id}"] .region-tab-name`);
                    if (activeTabBtn) activeTabBtn.textContent = ac.name;
                    showNotification('Canvas renamed.');
                };
                canvasNameInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { commitCanvasRename(); canvasNameInput.blur(); } });
                canvasNameInput.addEventListener('blur', commitCanvasRename);
            }
            const cropLeftEl = document.getElementById('crop-left-input');
            const cropRightEl = document.getElementById('crop-right-input');
            const cropTopEl = document.getElementById('crop-top-input');
            const cropBottomEl = document.getElementById('crop-bottom-input');
            const cropPanelsLeftEl = document.getElementById('crop-panels-left-input');
            const cropPanelsRightEl = document.getElementById('crop-panels-right-input');
            const cropPanelsTopEl = document.getElementById('crop-panels-top-input');
            const cropPanelsBottomEl = document.getElementById('crop-panels-bottom-input');
            const evalExpr = (txt) => {
                if (typeof txt !== 'string') return NaN;
                // Normalize common symbols: x, × for multiply; ÷ for divide
                let s = txt.trim()
                    .replace(/[x×]/gi, '*')
                    .replace(/÷/g, '/');
                if (s === '') return NaN;
                // Allow only digits, operators, decimal point, spaces and parentheses
                if (!/^[0-9+\-*/().\s]+$/.test(s)) return NaN;
                try { return Math.floor(Function(`"use strict";return (${s})`)()); } catch(_) { return NaN; }
            };
            const handleCropChange = (commit = false) => {
                const ac = getActiveCanvas(); if(!ac) return;
                const sel = ac.maps?.find(m => String(m.id) === String(state.canvasState.selectedMapId));
                if (!sel) return;
                // Determine source pixel size to clamp accurately
                let sourceW = sel.width || 0;
                let sourceH = sel.height || 0;
                try {
                    const temp = document.createElement('canvas');
                    drawVisualizerCanvas(temp, sel, { forceFullRes: true });
                    if (temp && temp.width) sourceW = temp.width;
                    if (temp && temp.height) sourceH = temp.height;
                } catch(_){}
                const maxW = Math.max(1, Math.floor(sourceW));
                const maxH = Math.max(1, Math.floor(sourceH));
                const leftEval = evalExpr(cropLeftEl?.value ?? '');
                const rightEval = evalExpr(cropRightEl?.value ?? '');
                const topEval = evalExpr(cropTopEl?.value ?? '');
                const bottomEval = evalExpr(cropBottomEl?.value ?? '');
                // If editing (input) and expression is incomplete/invalid, don't coerce to 0 or overwrite UI/state
                if (!commit && (![leftEval, rightEval, topEval, bottomEval].every(v => isFinite(v)))) {
                    return;
                }
                // On commit, if invalid, also keep previous values (no update)
                if (commit && (![leftEval, rightEval, topEval, bottomEval].every(v => isFinite(v)))) {
                    return;
                }
                let left = leftEval; if (!isFinite(left)) left = 0;
                let right = rightEval; if (!isFinite(right)) right = 0;
                let top = topEval; if (!isFinite(top)) top = 0;
                let bottom = bottomEval; if (!isFinite(bottom)) bottom = 0;
                left = Math.max(0, left); right = Math.max(0, right); top = Math.max(0, top); bottom = Math.max(0, bottom);
                // Do not clamp inputs; allow large values (10+ digits). Rendering/export will clamp to source size safely.
                sel.cropLeft = left; sel.cropRight = right; sel.cropTop = top; sel.cropBottom = bottom;
                // Back-compat fields
                sel.sliceLeft = left; sel.sliceRight = right;
                if (cropLeftEl) cropLeftEl.value = left;
                if (cropRightEl) cropRightEl.value = right;
                if (cropTopEl) cropTopEl.value = top;
                if (cropBottomEl) cropBottomEl.value = bottom;
                // Keep panels fields in sync based on panel resolution
                const pW = Math.max(1, sel.panelResWidth || 128);
                const pH = Math.max(1, sel.panelResHeight || 128);
                if (cropPanelsLeftEl) cropPanelsLeftEl.value = Math.floor(left / pW);
                if (cropPanelsRightEl) cropPanelsRightEl.value = Math.floor(right / pW);
                if (cropPanelsTopEl) cropPanelsTopEl.value = Math.floor(top / pH);
                if (cropPanelsBottomEl) cropPanelsBottomEl.value = Math.floor(bottom / pH);
                drawMainCanvas();
            };
            const handlePanelCropChange = (commit = false) => {
                const ac = getActiveCanvas(); if(!ac) return;
                const sel = ac.maps?.find(m => String(m.id) === String(state.canvasState.selectedMapId));
                if (!sel) return;
                const pW = Math.max(1, sel.panelResWidth || 128);
                const pH = Math.max(1, sel.panelResHeight || 128);
                const lEval = evalExpr(cropPanelsLeftEl?.value ?? '');
                const rEval = evalExpr(cropPanelsRightEl?.value ?? '');
                const tEval = evalExpr(cropPanelsTopEl?.value ?? '');
                const bEval = evalExpr(cropPanelsBottomEl?.value ?? '');
                if (!commit && (![lEval, rEval, tEval, bEval].every(v => isFinite(v)))) return;
                if (commit && (![lEval, rEval, tEval, bEval].every(v => isFinite(v)))) return;
                let l = Math.max(0, isFinite(lEval) ? lEval : 0);
                let r = Math.max(0, isFinite(rEval) ? rEval : 0);
                let t = Math.max(0, isFinite(tEval) ? tEval : 0);
                let b = Math.max(0, isFinite(bEval) ? bEval : 0);
                const pxLeft = Math.floor(l * pW);
                const pxRight = Math.floor(r * pW);
                const pxTop = Math.floor(t * pH);
                const pxBottom = Math.floor(b * pH);
                sel.cropLeft = pxLeft; sel.cropRight = pxRight; sel.cropTop = pxTop; sel.cropBottom = pxBottom;
                sel.sliceLeft = pxLeft; sel.sliceRight = pxRight;
                if (cropLeftEl) cropLeftEl.value = pxLeft;
                if (cropRightEl) cropRightEl.value = pxRight;
                if (cropTopEl) cropTopEl.value = pxTop;
                if (cropBottomEl) cropBottomEl.value = pxBottom;
                if (cropPanelsLeftEl) cropPanelsLeftEl.value = l;
                if (cropPanelsRightEl) cropPanelsRightEl.value = r;
                if (cropPanelsTopEl) cropPanelsTopEl.value = t;
                if (cropPanelsBottomEl) cropPanelsBottomEl.value = b;
                drawMainCanvas();
            };
            [cropLeftEl, cropRightEl, cropTopEl, cropBottomEl].forEach(el => {
                if (!el) return;
                el.addEventListener('input', () => handleCropChange(false));
                el.addEventListener('blur', () => handleCropChange(true));
                el.addEventListener('keydown', (e) => { if (e.key === 'Enter') handleCropChange(true); });
            });
            [cropPanelsLeftEl, cropPanelsRightEl, cropPanelsTopEl, cropPanelsBottomEl].forEach(el => {
                if (!el) return;
                el.addEventListener('input', () => handlePanelCropChange(false));
                el.addEventListener('blur', () => handlePanelCropChange(true));
                el.addEventListener('keydown', (e) => { if (e.key === 'Enter') handlePanelCropChange(true); });
            });
             document.getElementById('canvas-grid-toggle').addEventListener('change', (e) => {
                state.canvasState.grid = e.target.checked;
                drawMainCanvas();
            });
            document.getElementById('canvas-rulers-toggle').addEventListener('change', (e) => {
                state.canvasState.rulers = e.target.checked;
                drawMainCanvas();
            });
            document.getElementById('canvas-snapping-toggle').addEventListener('change', (e) => {
                state.canvasState.snapping = e.target.checked;
            });
            // Manual drawing tools wiring
            try {
                const drawCfg = state.canvasState.drawing || {};
                // Coordinate font controls
                const coordFontEl = document.getElementById('coord-font-size');
                const coordFontVal = document.getElementById('coord-font-size-val');
                if (coordFontEl) {
                    coordFontEl.value = state.canvasState.coordFontSize || 12;
                    coordFontEl.addEventListener('input', (e) => {
                        const v = Math.max(8, Math.min(36, parseInt(e.target.value, 10) || 12));
                        state.canvasState.coordFontSize = v;
                        if (coordFontVal) coordFontVal.textContent = `${v}px`;
                        drawMainCanvas();
                    });
                }
                const btnToggle = document.getElementById('draw-mode-toggle');
                const colorEl = document.getElementById('draw-color');
                const multiColorEl = document.getElementById('draw-multicolor');
                const widthEl = document.getElementById('draw-width');
                const aStartEl = document.getElementById('draw-arrow-start');
                const aEndEl = document.getElementById('draw-arrow-end');
                const showLinesEl = document.getElementById('draw-show-lines');
                const snapWhileDrawingEl = document.getElementById('draw-snap-enabled');
                const snapDistEl = document.getElementById('draw-snap-threshold');
                const snapDistVal = document.getElementById('draw-snap-threshold-val');
                const undoBtn = document.getElementById('draw-undo');
                const redoBtn = document.getElementById('draw-redo');
                const clearBtn = document.getElementById('draw-clear');
                const selectToggleBtn = document.getElementById('select-mode-toggle');
                const deleteSelBtn = document.getElementById('draw-delete-selected');
                const updateUndoRedoButtons = () => {
                    try {
                        const ac = getActiveCanvas();
                        if (undoBtn) undoBtn.disabled = !(ac && Array.isArray(ac.drawings) && ac.drawings.length > 0);
                        if (redoBtn) redoBtn.disabled = !(ac && Array.isArray(ac.drawingsRedo) && ac.drawingsRedo.length > 0);
                    } catch(_) {}
                };
                const syncToggle = () => {
                    if (!btnToggle) return;
                    btnToggle.textContent = drawCfg.enabled ? 'On' : 'Off';
                    btnToggle.classList.toggle('bg-yellow-600', drawCfg.enabled);
                    btnToggle.classList.toggle('hover:bg-yellow-700', drawCfg.enabled);
                    btnToggle.classList.toggle('bg-gray-700', !drawCfg.enabled);
                    btnToggle.classList.toggle('hover:bg-gray-600', !drawCfg.enabled);
                };
                const syncSelectToggle = () => {
                    if (!selectToggleBtn) return;
                    const on = !!(state.canvasState.drawing && state.canvasState.drawing.selectEnabled);
                    selectToggleBtn.textContent = on ? 'On' : 'Off';
                    selectToggleBtn.classList.toggle('bg-yellow-600', on);
                    selectToggleBtn.classList.toggle('hover:bg-yellow-700', on);
                    selectToggleBtn.classList.toggle('bg-gray-700', !on);
                    selectToggleBtn.classList.toggle('hover:bg-gray-600', !on);
                };
                if (btnToggle) btnToggle.addEventListener('click', () => {
                    const ac = getActiveCanvas();
                    const hasMaps = !!(ac && Array.isArray(ac.maps) && ac.maps.length > 0);
                    if (!hasMaps) {
                        // Block enabling draw mode until there's a map
                        showNotification('Add a map to the Output Canvas to enable Draw Mode.');
                        return;
                    }
                    drawCfg.enabled = !drawCfg.enabled;
                    state.canvasState.drawing.enabled = drawCfg.enabled;
                    if (drawCfg.enabled) {
                        // Turning on draw mode turns off select mode
                        state.canvasState.drawing.selectEnabled = false;
                        syncSelectToggle();
                    }
                    syncToggle();
                });
                if (selectToggleBtn) selectToggleBtn.addEventListener('click', () => {
                    const ac = getActiveCanvas();
                    const hasMaps = !!(ac && Array.isArray(ac.maps) && ac.maps.length > 0);
                    if (!hasMaps) return;
                    state.canvasState.drawing.selectEnabled = !state.canvasState.drawing.selectEnabled;
                    if (state.canvasState.drawing.selectEnabled) {
                        // Turning on select turns off draw mode
                        drawCfg.enabled = false;
                        state.canvasState.drawing.enabled = false;
                        syncToggle();
                    }
                    syncSelectToggle();
                    // Clear preview when toggling select
                    state.canvasState.drawing.preview = null;
                    state.canvasState.drawing.previewPath = null;
                    // reset marquee when toggling
                    state.canvasState.drawing.marqueeSelecting = false;
                    state.canvasState.drawing.marqueeRect = null;
                    renderDrawOverlay();
                });
                if (deleteSelBtn) deleteSelBtn.addEventListener('click', () => {
                    const ac = getActiveCanvas();
                    const selIdx = state.canvasState.drawing?.selectedStrokeIndex;
                    const selMany = Array.isArray(state.canvasState.drawing?.selectedStrokeIndices) ? state.canvasState.drawing.selectedStrokeIndices.slice() : [];
                    if (!ac || !Array.isArray(ac.drawings)) return;
                    if (Array.isArray(selMany) && selMany.length > 0) {
                        // Delete multiple: sort descending to keep indices stable
                        selMany.sort((a,b) => b - a).forEach(i => {
                            if (i >= 0 && i < ac.drawings.length) ac.drawings.splice(i, 1);
                        });
                    } else if (typeof selIdx === 'number' && selIdx >= 0 && selIdx < ac.drawings.length) {
                        ac.drawings.splice(selIdx, 1);
                    } else {
                        return;
                    }
                    state.canvasState.drawing.selectedStrokeIndex = null;
                    state.canvasState.drawing.selectedStrokeIndices = [];
                    syncSelectionUIFromStroke();
                    renderDrawOverlay();
                    updateUndoRedoButtons();
                });
                if (colorEl) { colorEl.value = drawCfg.color || '#ff0000'; colorEl.addEventListener('input', e => {
                        const ac = getActiveCanvas();
                        const selIdx = state.canvasState.drawing?.selectedStrokeIndex;
                        const selMany = Array.isArray(state.canvasState.drawing?.selectedStrokeIndices) ? state.canvasState.drawing.selectedStrokeIndices : [];
                        if (ac && typeof selIdx === 'number' && ac.drawings && selIdx >= 0 && selIdx < ac.drawings.length) {
                            ac.drawings[selIdx].color = e.target.value;
                            renderDrawOverlay();
                        } else if (ac && Array.isArray(selMany) && selMany.length > 0) {
                            selMany.forEach(i => { if (i >= 0 && i < ac.drawings.length) ac.drawings[i].color = e.target.value; });
                            renderDrawOverlay();
                        } else {
                            state.canvasState.drawing.color = e.target.value;
                            renderDrawOverlay();
                        }
                    }); }
                if (widthEl) { widthEl.value = drawCfg.width || 5; widthEl.addEventListener('input', e => {
                        const v = Math.max(1, Math.min(50, parseInt(e.target.value, 10) || 1));
                        const ac = getActiveCanvas();
                        const selIdx = state.canvasState.drawing?.selectedStrokeIndex;
                        const selMany = Array.isArray(state.canvasState.drawing?.selectedStrokeIndices) ? state.canvasState.drawing.selectedStrokeIndices : [];
                        if (ac && Array.isArray(selMany) && selMany.length > 0) {
                            selMany.forEach(i => { if (i >= 0 && i < ac.drawings.length) ac.drawings[i].width = v; });
                            renderDrawOverlay();
                        } else if (ac && typeof selIdx === 'number' && ac.drawings && selIdx >= 0 && selIdx < ac.drawings.length) {
                            ac.drawings[selIdx].width = v;
                            renderDrawOverlay();
                        } else {
                            state.canvasState.drawing.width = v;
                            renderDrawOverlay();
                        }
                    }); }
                // Line style
                const styleEl = document.getElementById('draw-style');
                if (styleEl) {
                    styleEl.value = drawCfg.lineStyle || 'solid';
                    styleEl.addEventListener('change', e => {
                        const val = e.target.value;
                        const ac = getActiveCanvas();
                        const selIdx = state.canvasState.drawing?.selectedStrokeIndex;
                        const selMany = Array.isArray(state.canvasState.drawing?.selectedStrokeIndices) ? state.canvasState.drawing.selectedStrokeIndices : [];
                        if (ac && Array.isArray(ac.drawings)) {
                            // Build list of indices to update: multi-select if any, else single selection
                            const indices = (selMany && selMany.length > 0)
                                ? selMany.slice()
                                : (typeof selIdx === 'number' ? [selIdx] : []);
                            if (indices.length > 0) {
                                let anyChanged = false;
                                indices.forEach(i => {
                                    const s = ac.drawings[i];
                                    if (!s) return;
                                    if (val === 'pencil') {
                                        // Only apply to true pencil strokes
                                        if (Array.isArray(s.points) && s.points.length > 1) {
                                            s.lineStyle = 'pencil';
                                            anyChanged = true;
                                        }
                                    } else {
                                        // Only apply to straight lines; pencil strokes stay as pencil rendering
                                        if (!(Array.isArray(s.points) && s.points.length > 1)) {
                                            s.lineStyle = val;
                                            anyChanged = true;
                                        }
                                    }
                                });
                                if (!anyChanged) {
                                    // If nothing updated (e.g., selected only pencil strokes and chose dashed), keep control value but no change
                                    // No-op render still safe
                                }
                                renderDrawOverlay();
                            } else {
                                // No selection: update default draw style only
                                state.canvasState.drawing.lineStyle = val;
                            }
                        } else {
                            state.canvasState.drawing.lineStyle = val;
                        }
                    });
                }
                // Multicolor toggle
                if (multiColorEl) {
                    multiColorEl.checked = !!drawCfg.multiColor;
                    multiColorEl.addEventListener('change', e => {
                        state.canvasState.drawing.multiColor = !!e.target.checked;
                        renderDrawOverlay();
                    });
                }
                // Show/hide lines toggle
                if (showLinesEl) {
                    showLinesEl.checked = drawCfg.showLines !== false;
                    showLinesEl.addEventListener('change', e => {
                        state.canvasState.drawing.showLines = !!e.target.checked;
                        renderDrawOverlay();
                    });
                }
                // Snap while drawing toggle
                if (snapWhileDrawingEl) {
                    snapWhileDrawingEl.checked = !!drawCfg.snapEnabled;
                    snapWhileDrawingEl.addEventListener('change', (e) => {
                        state.canvasState.drawing.snapEnabled = !!e.target.checked;
                    });
                }
                // Snap distance slider (in screen pixels)
                if (snapDistEl) {
                    const initial = state.canvasState.drawSnapThreshold || 50;
                    snapDistEl.value = initial;
                    if (snapDistVal) snapDistVal.textContent = `${initial}px`;
                    snapDistEl.addEventListener('input', (e) => {
                        const v = Math.max(1, Math.min(400, parseInt(e.target.value, 10) || 50));
                        state.canvasState.drawSnapThreshold = v;
                        if (snapDistVal) snapDistVal.textContent = `${v}px`;
                        // Update preview snapping immediately
                        renderDrawOverlay();
                    });
                }
                // Zigzag controls removed for pencil mode
                if (aStartEl) {
                    aStartEl.checked = !!drawCfg.arrowStart;
                    aStartEl.addEventListener('change', e => {
                        const checked = !!e.target.checked;
                        const ac = getActiveCanvas();
                        const selIdx = state.canvasState.drawing?.selectedStrokeIndex;
                        const selMany = Array.isArray(state.canvasState.drawing?.selectedStrokeIndices)
                            ? state.canvasState.drawing.selectedStrokeIndices.slice()
                            : [];
                        if (ac && Array.isArray(selMany) && selMany.length > 0 && Array.isArray(ac.drawings)) {
                            selMany.forEach(i => { if (i >= 0 && i < ac.drawings.length) ac.drawings[i].arrowStart = checked; });
                            renderDrawOverlay();
                        } else if (ac && typeof selIdx === 'number' && ac.drawings && selIdx >= 0 && selIdx < ac.drawings.length) {
                            ac.drawings[selIdx].arrowStart = checked;
                            renderDrawOverlay();
                        } else {
                            state.canvasState.drawing.arrowStart = checked;
                            renderDrawOverlay();
                        }
                    });
                }
                if (aEndEl) {
                    aEndEl.checked = !!drawCfg.arrowEnd;
                    aEndEl.addEventListener('change', e => {
                        const checked = !!e.target.checked;
                        const ac = getActiveCanvas();
                        const selIdx = state.canvasState.drawing?.selectedStrokeIndex;
                        const selMany = Array.isArray(state.canvasState.drawing?.selectedStrokeIndices)
                            ? state.canvasState.drawing.selectedStrokeIndices.slice()
                            : [];
                        if (ac && Array.isArray(selMany) && selMany.length > 0 && Array.isArray(ac.drawings)) {
                            selMany.forEach(i => { if (i >= 0 && i < ac.drawings.length) ac.drawings[i].arrowEnd = checked; });
                            renderDrawOverlay();
                        } else if (ac && typeof selIdx === 'number' && ac.drawings && selIdx >= 0 && selIdx < ac.drawings.length) {
                            ac.drawings[selIdx].arrowEnd = checked;
                            renderDrawOverlay();
                        } else {
                            state.canvasState.drawing.arrowEnd = checked;
                            renderDrawOverlay();
                        }
                    });
                }
                // Arrow size
                const arrowSizeEl = document.getElementById('draw-arrow-size');
                const arrowSizeVal = document.getElementById('draw-arrow-size-val');
                if (arrowSizeEl) {
                    arrowSizeEl.value = drawCfg.arrowSize || 1.2;
                    arrowSizeEl.addEventListener('input', (e) => {
                        const v = Math.max(0.5, Math.min(3, parseFloat(e.target.value) || 1));
                        const ac = getActiveCanvas();
                        const selIdx = state.canvasState.drawing?.selectedStrokeIndex;
                        const selMany = Array.isArray(state.canvasState.drawing?.selectedStrokeIndices) ? state.canvasState.drawing.selectedStrokeIndices : [];
                        if (ac && Array.isArray(selMany) && selMany.length > 0) {
                            selMany.forEach(i => { if (i >= 0 && i < ac.drawings.length) ac.drawings[i].arrowSize = v; });
                            if (arrowSizeVal) arrowSizeVal.textContent = `x${v}`;
                            renderDrawOverlay();
                        } else if (ac && typeof selIdx === 'number' && ac.drawings && selIdx >= 0 && selIdx < ac.drawings.length) {
                            ac.drawings[selIdx].arrowSize = v;
                            if (arrowSizeVal) arrowSizeVal.textContent = `x${v}`;
                            renderDrawOverlay();
                        } else {
                            state.canvasState.drawing.arrowSize = v;
                            if (arrowSizeVal) arrowSizeVal.textContent = `x${v}`;
                            renderDrawOverlay();
                        }
                    });
                }
                if (undoBtn) undoBtn.addEventListener('click', () => {
                    const ac = getActiveCanvas();
                    if (!ac || !Array.isArray(ac.drawings) || ac.drawings.length === 0) return;
                    const popped = ac.drawings.pop();
                    ac.drawingsRedo = ac.drawingsRedo || [];
                    ac.drawingsRedo.push(popped);
                    renderDrawOverlay();
                    updateUndoRedoButtons();
                });
                if (redoBtn) redoBtn.addEventListener('click', () => {
                    const ac = getActiveCanvas();
                    if (!ac || !Array.isArray(ac.drawingsRedo) || ac.drawingsRedo.length === 0) return;
                    const stroke = ac.drawingsRedo.pop();
                    ac.drawings = ac.drawings || [];
                    ac.drawings.push(stroke);
                    renderDrawOverlay();
                    updateUndoRedoButtons();
                });
                if (clearBtn) clearBtn.addEventListener('click', () => { const ac = getActiveCanvas(); if (!ac) return; ac.drawings = []; ac.drawingsRedo = []; renderDrawOverlay(); updateUndoRedoButtons(); });
                // Disable drawing controls when no maps present
                const updateDrawingToolsAvailability = () => {
                    try {
                        const ac = getActiveCanvas();
                        const hasMaps = !!(ac && Array.isArray(ac.maps) && ac.maps.length > 0);
                        const tools = document.getElementById('drawing-tools');
                        if (tools) {
                            tools.classList.toggle('opacity-50', !hasMaps);
                            tools.classList.toggle('pointer-events-none', !hasMaps);
                        }
                        if (btnToggle) btnToggle.disabled = !hasMaps;
                        if (selectToggleBtn) selectToggleBtn.disabled = !hasMaps;
                        if (!hasMaps) {
                            // Ensure draw mode cannot remain on if maps were removed
                            drawCfg.enabled = false;
                            if (state.canvasState.drawing) state.canvasState.drawing.enabled = false;
                            syncToggle();
                            if (state.canvasState.drawing) state.canvasState.drawing.selectEnabled = false;
                            syncSelectToggle();
                            state.canvasState.drawing.selectedStrokeIndex = null;
                            state.canvasState.drawing.selectedStrokeIndices = [];
                            state.canvasState.drawing.marqueeSelecting = false;
                            state.canvasState.drawing.marqueeRect = null;
                            syncSelectionUIFromStroke();
                        }
                    } catch(_) {}
                };
                syncToggle();
                syncSelectToggle();
                syncSelectionUIFromStroke();
                updateDrawingToolsAvailability();
                updateUndoRedoButtons();
            } catch(_) {}
            
            // Set initial values
            const presetEl = document.getElementById('canvas-preset-select');
            const customW = document.getElementById('canvas-custom-width');
            const customH = document.getElementById('canvas-custom-height');
            const currentRes = `${activeCanvas.width}x${activeCanvas.height}`;
            if ([...presetEl.options].some(o => o.value === currentRes)) {
                presetEl.value = currentRes;
            } else {
                presetEl.value = 'custom';
            }
            customW.value = activeCanvas.width;
            customH.value = activeCanvas.height;
            handleCanvasPresetChange({target: presetEl}); // To show/hide custom inputs

            // Attach canvas interaction listeners (remove first to avoid duplicate handlers on re-render)
            const canvasWrapper = document.getElementById('main-canvas-wrapper');
            canvasWrapper.removeEventListener('mousedown', handleCanvasMouseDown);
            canvasWrapper.removeEventListener('mousemove', handleCanvasMouseMove);
            canvasWrapper.removeEventListener('mouseup', handleCanvasMouseUp);
            canvasWrapper.removeEventListener('mouseleave', handleCanvasMouseUp);
            canvasWrapper.removeEventListener('wheel', handleCanvasWheel);
            canvasWrapper.addEventListener('mousedown', handleCanvasMouseDown);
            canvasWrapper.addEventListener('mousemove', handleCanvasMouseMove);
            canvasWrapper.addEventListener('mouseup', handleCanvasMouseUp);
            canvasWrapper.addEventListener('mouseleave', handleCanvasMouseUp);
            canvasWrapper.addEventListener('wheel', handleCanvasWheel, { passive: false });
            // Polygon mask: double-click closes the polygon
            canvasWrapper.addEventListener("dblclick", (e) => {
                if (state.canvasState.maskMode !== "polygon") return;
                const pts = state.canvasState.maskPolygonPoints;
                if (pts.length >= 3) {
                    const ac = getActiveCanvas();
                    ac.masks = ac.masks || [];
                    const xs = pts.map(p => p.x), ys = pts.map(p => p.y);
                    const count = ac.masks.length + 1;
                    ac.masks.push({
                        id: Date.now(),
                        name: "Polygon " + count,
                        type: "polygon",
                        mode: document.getElementById("mask-prop-mode")?.value || "blackout",
                        points: JSON.parse(JSON.stringify(pts)),
                        x: Math.min(...xs), y: Math.min(...ys),
                        w: Math.max(...xs) - Math.min(...xs), h: Math.max(...ys) - Math.min(...ys),
                        feather: parseInt(document.getElementById("mask-prop-feather")?.value, 10) || 0,
                        visible: true,
                        locked: false,
                        color: document.getElementById("mask-fill-color")?.value || "#000000",
                        opacity: parseInt(document.getElementById("mask-fill-opacity")?.value || "100", 10)
                    });
                    state.canvasState.selectedMaskId = ac.masks[ac.masks.length - 1]?.id;
                    saveState();
                    updateMaskList();
                }
                state.canvasState.maskPolygonPoints = [];
                state.canvasState.maskMode = null;
                updateMaskModeButtons();
                drawMainCanvas();
            });




            // ====== Mask Tool Wiring ======
            const setMaskMode = (mode) => {
                const cs = state.canvasState;
                if (cs.maskMode === mode) { cs.maskMode = null; } else { cs.maskMode = mode; }
                cs.maskDrawing = false; cs.maskPreview = null; cs.maskPolygonPoints = [];
                if (cs.maskMode) { cs.drawing.enabled = false; cs.drawing.selectEnabled = false; }
                updateMaskModeButtons();
                renderCanvas();
            };

            const maskRectBtn = document.getElementById("mask-rect-btn");
            const maskEllipseBtn = document.getElementById("mask-ellipse-btn");
            const maskPolygonBtn = document.getElementById("mask-polygon-btn");
            const maskDeleteBtn = document.getElementById("mask-delete-btn");
            const maskClearAllBtn = document.getElementById("mask-clear-all-btn");
            const maskDuplicateBtn = document.getElementById("mask-duplicate-btn");
            const maskShowToggle = document.getElementById("mask-show-toggle");
            const maskInvertToggle = document.getElementById("mask-invert-toggle");
            const maskExportWithBtn = document.getElementById("mask-export-with-btn");
            const maskExportOnlyBtn = document.getElementById("mask-export-only-btn");
            const maskSnapWallBtn = document.getElementById("mask-snap-wall-btn");
            const maskSnapPanelBtn = document.getElementById("mask-snap-panel-btn");
            const maskAspectSelect = document.getElementById("mask-aspect-select");
            const maskPropMode = document.getElementById("mask-prop-mode");
            const maskPropRadius = document.getElementById("mask-prop-radius");
            const maskPropFeather = document.getElementById("mask-prop-feather");
            const maskFillColor = document.getElementById("mask-fill-color");
            const maskFillOpacity = document.getElementById("mask-fill-opacity");
            const maskFillOpacityVal = document.getElementById("mask-fill-opacity-val");
            const maskUnitSelect = document.getElementById("mask-unit-select");
            const maskPxPerUnit = document.getElementById("mask-px-per-unit");
            const maskPropsPanel = document.getElementById("mask-props-panel");
            const maskPropX = document.getElementById("mask-prop-x");
            const maskPropY = document.getElementById("mask-prop-y");
            const maskPropW = document.getElementById("mask-prop-w");
            const maskPropH = document.getElementById("mask-prop-h");

            // Sync selected mask properties to UI controls
            const syncMaskPropertiesToUI = () => {
                const ac = getActiveCanvas();
                const selId = state.canvasState.selectedMaskId;
                const mask = selId != null && ac?.masks?.find(m => String(m.id) === String(selId));
                
                const badge = document.getElementById("mask-selected-name-badge");
                const hint = document.getElementById("mask-selected-hint");
                if (badge) badge.textContent = mask ? (mask.name || "Selected Mask") : "None";
                if (hint) hint.textContent = mask ? `${mask.type.toUpperCase()} · ${mask.locked ? 'LOCKED' : 'ACTIVE'}` : "Select a mask on canvas or in layer list to adjust";

                [maskFillColor, maskFillOpacity, maskPropX, maskPropY, maskPropW, maskPropH, maskPropMode, maskPropRadius, maskPropFeather, maskSnapWallBtn, maskSnapPanelBtn, maskAspectSelect].forEach(control => {
                    if (control) {
                        control.disabled = !mask;
                        if (!mask) control.classList.add("opacity-40", "cursor-not-allowed");
                        else control.classList.remove("opacity-40", "cursor-not-allowed");
                    }
                });
                if (maskDeleteBtn) maskDeleteBtn.disabled = !mask;
                if (maskDuplicateBtn) maskDuplicateBtn.disabled = !mask;
                if (maskPropRadius) {
                    const canRadius = mask && mask.type === 'rect';
                    maskPropRadius.disabled = !canRadius;
                    if (!canRadius) maskPropRadius.classList.add("opacity-40", "cursor-not-allowed");
                    else maskPropRadius.classList.remove("opacity-40", "cursor-not-allowed");
                }

                if (!mask) {
                    if (typeof updateMaskList === "function") updateMaskList();
                    return;
                }
                if (maskFillColor) maskFillColor.value = mask.color || "#000000";
                if (maskFillOpacity) maskFillOpacity.value = mask.opacity != null ? mask.opacity : 100;
                if (maskFillOpacityVal) maskFillOpacityVal.textContent = (mask.opacity != null ? mask.opacity : 100) + "%";
                if (maskPropMode) maskPropMode.value = mask.mode || "blackout";
                if (maskPropRadius) maskPropRadius.value = mask.radius != null ? mask.radius : 0;
                if (maskPropFeather) maskPropFeather.value = mask.feather != null ? mask.feather : 0;

                const unit = state.canvasState.maskUnit || "px";
                const ppu = state.canvasState.maskPxPerUnit || 1;
                const toUnit = (px) => unit === "px" ? Math.round(px) : +(px / ppu).toFixed(2);
                if (maskPropX) maskPropX.value = toUnit(mask.x);
                if (maskPropY) maskPropY.value = toUnit(mask.y);
                if (maskPropW) maskPropW.value = toUnit(mask.w);
                if (maskPropH) maskPropH.value = toUnit(mask.h);

                if (typeof updateMaskList === "function") updateMaskList();
            };

            const updateMaskModeButtons = () => {
                const modeMap = { rect: maskRectBtn, ellipse: maskEllipseBtn, polygon: maskPolygonBtn };
                Object.entries(modeMap).forEach(([mode, btn]) => {
                    if (!btn) return;
                    if (state.canvasState.maskMode === mode) {
                        btn.classList.remove("bg-gray-700");
                        btn.classList.add("bg-purple-600", "ring-2", "ring-purple-400");
                    } else {
                        btn.classList.remove("bg-purple-600", "ring-2", "ring-purple-400");
                        btn.classList.add("bg-gray-700");
                    }
                });
            };

            if (maskRectBtn) maskRectBtn.addEventListener("click", () => setMaskMode("rect"));
            if (maskEllipseBtn) maskEllipseBtn.addEventListener("click", () => setMaskMode("ellipse"));
            if (maskPolygonBtn) maskPolygonBtn.addEventListener("click", () => setMaskMode("polygon"));

            if (maskDeleteBtn) maskDeleteBtn.addEventListener("click", () => {
                const ac = getActiveCanvas();
                if (!ac || !ac.masks) return;
                const idx = ac.masks.findIndex(m => String(m.id) === String(state.canvasState.selectedMaskId));
                if (idx >= 0) {
                    ac.masks.splice(idx, 1);
                    state.canvasState.selectedMaskId = null;
                    state.canvasState.maskMode = null;
                    state.canvasState.maskDrawing = false;
                    state.canvasState.maskPreview = null;
                    state.canvasState.maskStart = null;
                    state.canvasState.maskDragging = false;
                    state.canvasState.maskResizing = false;
                    updateMaskModeButtons();
                    syncMaskPropertiesToUI();
                    updateMaskList();
                    drawMainCanvas();
                    saveState();
                }
            });

            if (maskClearAllBtn) maskClearAllBtn.addEventListener("click", () => {
                const ac = getActiveCanvas();
                if (!ac || !ac.masks || ac.masks.length === 0) return;
                if (!confirm("Are you sure you want to remove all masks from this canvas?")) return;
                ac.masks = [];
                state.canvasState.selectedMaskId = null;
                state.canvasState.maskMode = null;
                state.canvasState.maskDrawing = false;
                state.canvasState.maskPreview = null;
                state.canvasState.maskStart = null;
                state.canvasState.maskDragging = false;
                state.canvasState.maskResizing = false;
                updateMaskModeButtons();
                syncMaskPropertiesToUI();
                updateMaskList();
                drawMainCanvas();
                saveState();
                showNotification("All masks cleared.");
            });

            if (maskDuplicateBtn) maskDuplicateBtn.addEventListener("click", () => {
                const ac = getActiveCanvas();
                if (!ac || !ac.masks) return;
                const mask = ac.masks.find(m => String(m.id) === String(state.canvasState.selectedMaskId));
                if (!mask) return;
                const clone = JSON.parse(JSON.stringify(mask));
                clone.id = Date.now();
                clone.name = (mask.name || "Mask") + " (Copy)";
                clone.x += 40;
                clone.y += 40;
                if (clone.type === "polygon" && clone.points) {
                    clone.points.forEach(pt => { pt.x += 40; pt.y += 40; });
                }
                ac.masks.push(clone);
                state.canvasState.selectedMaskId = clone.id;
                syncMaskPropertiesToUI();
                updateMaskList();
                drawMainCanvas();
                saveState();
                showNotification(`Duplicated "${clone.name}".`);
            });

            // Snap to Screen / Wall
            if (maskSnapWallBtn) maskSnapWallBtn.addEventListener("click", () => {
                const ac = getActiveCanvas();
                if (!ac || !ac.masks) return;
                const mask = ac.masks.find(m => String(m.id) === String(state.canvasState.selectedMaskId));
                if (!mask) { showNotification("Select a mask to snap to screen."); return; }
                if (mask.locked) { showNotification("Mask is locked. Unlock it first."); return; }
                let targetMap = (ac.maps || []).find(m => m.id === state.canvasState.selectedMapId);
                if (!targetMap) {
                    const centerX = mask.x + mask.w / 2, centerY = mask.y + mask.h / 2;
                    targetMap = (ac.maps || []).find(m => centerX >= m.x && centerX <= m.x + m.width && centerY >= m.y && centerY <= m.y + m.height);
                }
                if (!targetMap && ac.maps && ac.maps.length > 0) targetMap = ac.maps[0];
                if (!targetMap) { showNotification("No LED screens found on canvas to snap to."); return; }

                mask.x = targetMap.x;
                mask.y = targetMap.y;
                mask.w = targetMap.width;
                mask.h = targetMap.height;
                if (mask.type === "polygon") {
                    mask.points = [
                        { x: mask.x, y: mask.y },
                        { x: mask.x + mask.w, y: mask.y },
                        { x: mask.x + mask.w, y: mask.y + mask.h },
                        { x: mask.x, y: mask.y + mask.h }
                    ];
                }
                syncMaskPropertiesToUI();
                updateMaskList();
                drawMainCanvas();
                saveState();
                showNotification(`Snapped mask to ${targetMap.name || 'screen'} (${mask.w}×${mask.h} px).`);
            });

            // Snap to Panels
            if (maskSnapPanelBtn) maskSnapPanelBtn.addEventListener("click", () => {
                const ac = getActiveCanvas();
                if (!ac || !ac.masks) return;
                const mask = ac.masks.find(m => String(m.id) === String(state.canvasState.selectedMaskId));
                if (!mask) { showNotification("Select a mask to snap to panels."); return; }
                if (mask.locked) { showNotification("Mask is locked. Unlock it first."); return; }
                const grid = getMaskTileGrid(ac, mask);
                const pw = grid.x || 128;
                const ph = grid.y || 128;
                const originX = Number(grid.map?.x || 0);
                const originY = Number(grid.map?.y || 0);
                const nx = originX + Math.round((mask.x - originX) / pw) * pw;
                const ny = originY + Math.round((mask.y - originY) / ph) * ph;
                const nw = Math.max(pw, Math.round(mask.w / pw) * pw);
                const nh = Math.max(ph, Math.round(mask.h / ph) * ph);
                const dx = nx - mask.x;
                const dy = ny - mask.y;
                mask.x = nx;
                mask.y = ny;
                mask.w = nw;
                mask.h = nh;
                if (mask.type === "polygon" && mask.points) {
                    mask.points.forEach(pt => { pt.x += dx; pt.y += dy; });
                }
                syncMaskPropertiesToUI();
                updateMaskList();
                drawMainCanvas();
                saveState();
                showNotification(`Snapped mask to ${pw}×${ph} px panel grid.`);
            });

            // Aspect Presets
            if (maskAspectSelect) maskAspectSelect.addEventListener("change", (e) => {
                const preset = e.target.value;
                if (!preset) return;
                const ac = getActiveCanvas();
                if (!ac || !ac.masks) return;
                const mask = ac.masks.find(m => String(m.id) === String(state.canvasState.selectedMaskId));
                if (!mask) { showNotification("Select a mask first."); e.target.value = ""; return; }
                if (mask.locked) { showNotification("Mask is locked. Unlock it first."); e.target.value = ""; return; }
                const cW = ac.width || 1920;
                const cH = ac.height || 1080;

                if (preset === "full") {
                    mask.x = 0; mask.y = 0; mask.w = cW; mask.h = cH;
                } else if (preset === "center") {
                    mask.x = Math.round((cW - mask.w) / 2);
                    mask.y = Math.round((cH - mask.h) / 2);
                } else if (preset === "16:9") {
                    let newH = Math.round(mask.w / (16 / 9));
                    if (newH > cH) { newH = cH; mask.w = Math.round(newH * (16 / 9)); }
                    mask.h = newH;
                } else if (preset === "21:9") {
                    let newH = Math.round(mask.w / (21 / 9));
                    if (newH > cH) { newH = cH; mask.w = Math.round(newH * (21 / 9)); }
                    mask.h = newH;
                } else if (preset === "4:3") {
                    let newH = Math.round(mask.w / (4 / 3));
                    if (newH > cH) { newH = cH; mask.w = Math.round(newH * (4 / 3)); }
                    mask.h = newH;
                } else if (preset === "1:1") {
                    const side = Math.min(mask.w, mask.h, cW, cH);
                    mask.w = side; mask.h = side;
                }
                if (mask.type === "polygon" && mask.points) {
                    mask.points = [
                        { x: mask.x, y: mask.y },
                        { x: mask.x + mask.w, y: mask.y },
                        { x: mask.x + mask.w, y: mask.y + mask.h },
                        { x: mask.x, y: mask.y + mask.h }
                    ];
                }
                e.target.value = "";
                syncMaskPropertiesToUI();
                updateMaskList();
                drawMainCanvas();
                saveState();
            });

            // Mask Mode (blackout / cutout / guide)
            if (maskPropMode) maskPropMode.addEventListener("change", (e) => {
                const ac = getActiveCanvas();
                const mask = state.canvasState.selectedMaskId != null && ac?.masks?.find(m => String(m.id) === String(state.canvasState.selectedMaskId));
                if (mask) {
                    mask.mode = e.target.value;
                    drawMainCanvas();
                    saveState();
                    updateMaskList();
                }
            });

            // Mask Corner Radius
            if (maskPropRadius) maskPropRadius.addEventListener("change", (e) => {
                const ac = getActiveCanvas();
                const mask = state.canvasState.selectedMaskId != null && ac?.masks?.find(m => String(m.id) === String(state.canvasState.selectedMaskId));
                if (mask && mask.type === "rect") {
                    mask.radius = Math.max(0, parseInt(e.target.value, 10) || 0);
                    drawMainCanvas();
                    saveState();
                }
            });

            // Mask Feather
            if (maskPropFeather) maskPropFeather.addEventListener("change", (e) => {
                const ac = getActiveCanvas();
                const mask = state.canvasState.selectedMaskId != null && ac?.masks?.find(m => String(m.id) === String(state.canvasState.selectedMaskId));
                if (mask) {
                    mask.feather = Math.max(0, Math.min(100, parseInt(e.target.value, 10) || 0));
                    drawMainCanvas();
                    saveState();
                }
            });

            if (maskShowToggle) maskShowToggle.addEventListener("change", (e) => {
                state.canvasState.showMasks = e.target.checked;
                drawMainCanvas();
            });
            if (maskExportWithBtn) maskExportWithBtn.addEventListener("click", exportCanvasWithMask);
            if (maskExportOnlyBtn) maskExportOnlyBtn.addEventListener("click", exportMaskOnly);

            // Fill color: update selected mask in real-time
            if (maskFillColor) maskFillColor.addEventListener("input", (e) => {
                const ac = getActiveCanvas();
                const mask = state.canvasState.selectedMaskId != null && ac?.masks?.find(m => String(m.id) === String(state.canvasState.selectedMaskId));
                if (mask) { mask.color = e.target.value; drawMainCanvas(); saveState(); if (typeof updateMaskList === 'function') updateMaskList(); }
            });

            // Fill opacity: update selected mask in real-time
            if (maskFillOpacity) maskFillOpacity.addEventListener("input", (e) => {
                if (maskFillOpacityVal) maskFillOpacityVal.textContent = e.target.value + "%";
                const ac = getActiveCanvas();
                const mask = state.canvasState.selectedMaskId != null && ac?.masks?.find(m => String(m.id) === String(state.canvasState.selectedMaskId));
                if (mask) { mask.opacity = parseInt(e.target.value, 10); drawMainCanvas(); saveState(); }
            });

            // Unit selector
            if (maskUnitSelect) maskUnitSelect.addEventListener("change", (e) => {
                state.canvasState.maskUnit = e.target.value;
                if (maskPxPerUnit) maskPxPerUnit.disabled = e.target.value === "px";
                syncMaskPropertiesToUI();
                drawMainCanvas();
            });
            // px-per-unit
            if (maskPxPerUnit) {
                maskPxPerUnit.disabled = (state.canvasState.maskUnit || "px") === "px";
                maskPxPerUnit.addEventListener("change", (e) => {
                    const v = parseFloat(e.target.value);
                    if (v > 0) { state.canvasState.maskPxPerUnit = v; syncMaskPropertiesToUI(); drawMainCanvas(); }
                });
            }

            // Per-mask property inputs (X, Y, W, H) — arithmetic expressions are accepted.
            const maskPropInputHandler = (propId, field) => {
                const el = document.getElementById(propId);
                if (!el) return;
                el.addEventListener("change", (e) => {
                    const ac = getActiveCanvas();
                    const mask = state.canvasState.selectedMaskId != null && ac?.masks?.find(m => String(m.id) === String(state.canvasState.selectedMaskId));
                    if (!mask) return;
                    const unit = state.canvasState.maskUnit || "px";
                    const ppu = state.canvasState.maskPxPerUnit || 1;
                    const expression = String(e.target.value || '').trim().replace(/[x×]/gi, '*').replace(/÷/g, '/');
                    if (!expression || !/^[0-9+\-*/().\s]+$/.test(expression)) {
                        e.target.classList.add('border-red-500');
                        return;
                    }
                    let val;
                    try { val = Function(`"use strict"; return (${expression});`)(); } catch (_) { val = NaN; }
                    if (!Number.isFinite(val)) {
                        e.target.classList.add('border-red-500');
                        return;
                    }
                    if ((field === "w" || field === "h") && val <= 0) {
                        e.target.classList.add('border-red-500');
                        return;
                    }
                    e.target.classList.remove('border-red-500');
                    const pxVal = unit === "px" ? val : val * ppu;
                    if (mask.type === "polygon" && mask.points?.length > 0 && (field === "x" || field === "y")) {
                        const delta = pxVal - mask[field];
                        mask.points.forEach(pt => { pt[field] += delta; });
                    }
                    if (mask.type === "polygon" && mask.points?.length > 0 && (field === "w" || field === "h")) {
                        const oldVal = mask[field];
                        if (oldVal > 0) {
                            const scale = pxVal / oldVal;
                            const origin = field === "w" ? mask.x : mask.y;
                            const axis = field === "w" ? "x" : "y";
                            mask.points.forEach(pt => { pt[axis] = origin + (pt[axis] - origin) * scale; });
                        }
                    }
                    mask[field] = pxVal;
                    drawMainCanvas();
                    saveState();
                    syncMaskPropertiesToUI();
                });
            };
            maskPropInputHandler("mask-prop-x", "x");
            maskPropInputHandler("mask-prop-y", "y");
            maskPropInputHandler("mask-prop-w", "w");
            maskPropInputHandler("mask-prop-h", "h");

            // Highlight active mask mode button
            updateMaskModeButtons();
            // Enable/disable delete button + sync props
            if (maskDeleteBtn) maskDeleteBtn.disabled = !state.canvasState.selectedMaskId;
            syncMaskPropertiesToUI();
            updateMaskList();
            // ====== End Mask Tool Wiring ======

            drawMainCanvas();
            try { updateMapUndoRedoButtons(); } catch(_) {}
        };

        const renderPdfExport = () => {
            // Simple / Advanced UI mode
            const isSimpleExperience = appEdition === APP_EDITIONS.simple;
            if (isSimpleExperience || !state.pdfExport.uiMode) {
                state.pdfExport.uiMode = 'simple';
            }
            const isSimpleMode = state.pdfExport.uiMode === 'simple';
            // One mode system only: Simple drives gallery templates, Advanced uses fixed installed template.
            state.pdfExport.templateMode = isSimpleMode ? 'gallery' : 'custom';
            try { localStorage.setItem('pdfTemplateMode', state.pdfExport.templateMode); } catch(_) {}
            const _galleryTpl = (window.PixelLogicPdfTemplates && typeof window.PixelLogicPdfTemplates.getTemplateById === 'function')
                ? window.PixelLogicPdfTemplates.getTemplateById(state.pdfExport.galleryTemplateId)
                : null;
            const _tplOrientation = (_galleryTpl && _galleryTpl.orientation) ? _galleryTpl.orientation : 'both';
            if (isSimpleMode && _tplOrientation === 'landscape' && state.pdfExport.pageOrientation !== 'landscape') {
                state.pdfExport.pageOrientation = 'landscape';
                try { localStorage.setItem('pdfPageOrientation', 'landscape'); } catch(_) {}
            }
            const _effectiveOrientation = state.pdfExport.pageOrientation || 'landscape';
            if (!isSimpleMode) {
                if (state.pdfExport.templateOptOut) {
                    state.pdfExport.templateOptOut = false;
                    try { localStorage.setItem('pdfTemplateOptOut', 'false'); } catch(_) {}
                }
                if (state.pdfExport.exportWithoutTemplate) {
                    state.pdfExport.exportWithoutTemplate = false;
                    try { localStorage.setItem('pdfExportWithoutTemplate', 'false'); } catch(_) {}
                }
                if ((state.pdfExport.pageSize || '').toLowerCase() !== 'a3') {
                    state.pdfExport.pageSize = 'a3';
                    try { localStorage.setItem('pdfPageSize', 'a3'); } catch(_) {}
                }
                try { if (typeof loadInstalledTemplateIfAvailable === 'function') loadInstalledTemplateIfAvailable(); } catch(_) {}
            }
            // Which preset button should appear active
            const _activePresetKey = (state.pdfExport.deliverySpec || {}).mediaServer || '';

            const projectOptions = state.projects.map(p => `<option value="${p.id}" ${state.pdfExport.selectedProjectId == p.id ? 'selected' : ''}>${p.name}</option>`).join('');
            
            let mapNameInputs = '';
            const selectedProjectForPdf = state.projects.find(p => p.id == state.pdfExport.selectedProjectId);

            if (typeof state.pdfExport.previewPanelOpen !== 'boolean') state.pdfExport.previewPanelOpen = false;
            state.pdfExport.previewDirty = !!state.pdfExport.previewDirty;

            // PDF optimization persistence removed
            
            // Default Delivery Spec: load Resolume preset if nothing chosen yet
            try {
                const ds = state.pdfExport.deliverySpec || {};
                if (!ds.mediaServer) {
                    Object.assign(ds, {
                        mediaServer: 'Resolume',
                        format: 'QUICKTIME',
                        codecs: ['DXV3'],
                        codecsCustom: '',
                        codecsLink: 'https://resolume.com/download/file?file=Resolume_DXV_Codec_3_0_1_Installer.exe',
                        codecsLink2: '',
                        quality: '100%',
                        pixelAspectRatio: 'Square Pixels (1:1)',
                        fps: '25',
                        embeddedAudio: true,
                        embeddedAudioDetails: 'Stereo, Uncompressed, 16 Bit',
                        sampleRate: '48000 Hz',
                        unembeddedAudioFormat: 'Wav',
                        stillFrameFormat: 'PNG',
                        namingStructure: '"Bank Number"_"delivery"_"screen Name"_"resolution"_"version".Mov',
                        example: '001_intro-video_center-screen_1920x1080_v001.Mov',
                        comments: 'Media Servers Rely On File Names To Understand And Manage Updates On The Content. Please Make Sure The File Name Is Consistent And Use The Version Tag At The End Of The File.'
                    });
                    state.pdfExport.deliverySpec = ds;
                }
            } catch(_) {}

            if (selectedProjectForPdf && selectedProjectForPdf.pixelMaps.length > 0) {
                mapNameInputs = selectedProjectForPdf.pixelMaps.map(map => {
                    const currentName = state.pdfExport.mapNames[map.id] || map.name;
                    const refSrc = map.pdfRefImageSrc || '';
                    return `
                        <div class="space-y-1.5 border border-gray-700/60 rounded-lg px-3 py-2 bg-gray-900/60">
                            <div class="flex items-center gap-2">
                                <label class="text-sm text-gray-400 flex-shrink-0 w-24 truncate" title="Pixel Map name used in PDF">${map.name}:</label>
                                <input type="text" data-map-id="${map.id}" value="${currentName}" class="pdf-map-name-input w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-1 text-sm">
                            </div>
                            <div class="flex items-center gap-3 text-[10px] text-gray-400">
                                <div class="flex flex-col gap-1 flex-1 min-w-[180px]">
                                    <label class="text-xs text-gray-400">Reference Image (optional)</label>
                                    <input type="file" data-map-id="${map.id}" class="pdf-ref-upload w-full text-xs text-gray-400 file:mr-3 file:py-1.5 file:px-3 file:rounded-full file:border-0 file:font-semibold file:bg-gray-600 file:text-gray-200 hover:file:bg-gray-700" accept="image/*" />
                                </div>
                                ${refSrc
                                    ? `<button type="button" class="pdf-ref-clear px-2 py-0.5 rounded bg-gray-700 hover:bg-gray-600" data-map-id="${map.id}">Clear image</button>`
                                    : '<span class="opacity-70">No image set</span>'}
                            </div>
                        </div>
                    `;
                }).join('');
            }

            // Build manual-pairing UI rows
            let pairingRowsHtml = '';
            if (selectedProjectForPdf && selectedProjectForPdf.pixelMaps.length >= 2) {
                const pairs = Array.isArray(state.pdfExport.mapPairs) ? state.pdfExport.mapPairs : [];
                const mapOpts = (selectedId) => selectedProjectForPdf.pixelMaps.map(m => {
                    const lbl = escapeHtml(state.pdfExport.mapNames[m.id] || m.name);
                    return `<option value="${m.id}" ${String(selectedId) === String(m.id) ? 'selected' : ''}>${lbl}</option>`;
                }).join('');
                const noneOpt = (selectedId) => `<option value="" ${!selectedId ? 'selected' : ''}>-- none --</option>`;

                // Show one row per defined pair, plus one blank "add" row
                const pairRows = [...pairs, { id1: '', id2: '' }].map((pair, idx) => {
                    const isBlank = !pair.id1 && !pair.id2;
                    return `
                        <div class="flex items-center gap-2 pdf-pair-row" data-pair-idx="${idx}">
                            <span class="text-xs text-gray-400 flex-shrink-0 w-5 text-right">${isBlank ? '+' : (idx + 1)}</span>
                            <select class="pdf-pair-sel1 flex-1 bg-gray-900 border border-gray-600 rounded-lg px-2 py-1 text-sm" data-pair-idx="${idx}">
                                ${noneOpt(pair.id1)}${mapOpts(pair.id1)}
                            </select>
                            <span class="text-gray-400 text-xs flex-shrink-0">+</span>
                            <select class="pdf-pair-sel2 flex-1 bg-gray-900 border border-gray-600 rounded-lg px-2 py-1 text-sm" data-pair-idx="${idx}">
                                ${noneOpt(pair.id2)}${mapOpts(pair.id2)}
                            </select>
                            ${!isBlank ? `<button type="button" class="pdf-pair-remove flex-shrink-0 px-2 py-1 rounded bg-gray-700 hover:bg-red-700 text-xs" data-pair-idx="${idx}" title="Remove this pair">✕</button>` : '<span class="w-8"></span>'}
                        </div>
                    `;
                }).join('');

                pairingRowsHtml = pairRows;
            }

            const pixelMapCount = selectedProjectForPdf?.pixelMaps?.length || 0;
            const canvasCount = selectedProjectForPdf?.canvases?.length || 0;
            const selectedProjectName = selectedProjectForPdf?.name || 'No project selected';


              mainContent.pdf.innerHTML = `
                <div class="page-center pdf-export-shell" data-pdf-ui-mode="${state.pdfExport.uiMode}">
                    <style>
                    /* Legacy template editor is retired in the new layout */
                    .pdf-tab--areas { display: none !important; }
                    [data-pdf-ui-mode="simple"] .pdf-tab--template { display: none !important; }
                        /* Advanced uses fixed installed template (no chooser UI) */
                        [data-pdf-ui-mode="advanced"] .pdf-tab--gallery { display: none !important; }
                    /* Simple mode: hide advanced-only sections */
                        [data-pdf-ui-mode="simple"] .pdf-tab--coverage,
                        [data-pdf-ui-mode="simple"] .pdf-tab--maplabels,
                        [data-pdf-ui-mode="simple"] .pdf-tab--pairing,
                        [data-pdf-ui-mode="simple"] .pdf-tab--typography { display: none !important; }
                        /* Step number circles — visible only in simple mode */
                        .pdf-step-num { display:none; width:26px; height:26px; min-width:26px; border-radius:50%; background:var(--accent,#6366f1); color:#fff; font-size:12px; font-weight:700; align-items:center; justify-content:center; margin-top:3px; flex-shrink:0; }
                        [data-pdf-ui-mode="simple"] .pdf-step-num { display:inline-flex; }
                        /* UI mode toggle bar */
                        .pdf-ui-mode-bar { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px; background:rgba(15,23,42,0.65); border:1px solid rgba(148,163,184,0.14); border-radius:10px; padding:10px 16px; margin-bottom:16px; }
                        .pdf-ui-mode-grp { display:inline-flex; background:rgba(0,0,0,0.3); border:1px solid rgba(148,163,184,0.16); border-radius:8px; overflow:hidden; }
                        .pdf-ui-mode-grp button { padding:6px 18px; font-size:12px; font-weight:600; color:#94a3b8; background:transparent; border:none; cursor:pointer; transition:all .15s; }
                        .pdf-ui-mode-grp button.is-active { background:var(--accent,#6366f1); color:#fff; }
                        /* Delivery spec preset quick-pick buttons */
                        .pdf-ds-presets { display:flex; flex-wrap:wrap; gap:7px; align-items:center; padding:10px 0 2px; }
                        .pdf-ds-preset-btn { padding:5px 13px; font-size:11px; font-weight:600; border-radius:20px; border:1.5px solid rgba(148,163,184,0.22); background:rgba(30,41,59,0.7); color:#cbd5e1; cursor:pointer; transition:all .15s; white-space:nowrap; }
                        .pdf-ds-preset-btn:hover { border-color:rgba(99,102,241,0.6); color:#a5b4fc; background:rgba(99,102,241,0.1); }
                        .pdf-ds-preset-btn.is-active { border-color:var(--accent,#6366f1); color:#a5b4fc; background:rgba(99,102,241,0.18); }
                        .pl-template-gallery { display:grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 12px; }
                        .pl-template-card { background: rgba(15,23,42,0.6); border: 2px solid rgba(148,163,184,0.18); border-radius: 10px; padding: 14px; cursor: pointer; transition: all .15s ease; position:relative; }
                        .pl-template-card:hover { border-color: rgba(148,163,184,0.45); transform: translateY(-1px); }
                        .pl-template-card.is-selected { border-color: var(--accent, #6366f1); box-shadow: 0 0 0 3px rgba(99,102,241,0.18); }
                        .pl-template-thumb { height: 100px; border-radius: 6px; margin-bottom: 10px; background:#0b1325; border:1px solid rgba(148,163,184,0.25); padding:8px; box-sizing:border-box; }
                        .pl-template-thumb .thumb-canvas { position:relative; width:100%; height:100%; border-radius:4px; overflow:hidden; }
                        /* Template 1 – Minimal Pro: white page, hairline accent top, gray map, 2-col spec strip */
                        .pl-template-thumb.thumb-minimal .thumb-canvas { background:#f8fafc; }
                        .pl-template-thumb.thumb-minimal .tm-hairline { position:absolute; inset:0 0 auto 0; height:2px; background:var(--accent,#6366f1); }
                        .pl-template-thumb.thumb-minimal .tm-header { position:absolute; top:2px; left:0; right:0; height:16px; background:#f8fafc; border-bottom:1px solid #e2e8f0; }
                        .pl-template-thumb.thumb-minimal .tm-map { position:absolute; left:8px; right:8px; top:22px; bottom:18px; background:#dde3ec; border-radius:2px; }
                        .pl-template-thumb.thumb-minimal .tm-strip { position:absolute; left:8px; right:8px; bottom:4px; height:12px; border-top:1.5px solid var(--accent,#6366f1); background:#f1f5f9; }
                        /* Template 2 – Dark Mode: full dark navy throughout */
                        .pl-template-thumb.thumb-engineering .thumb-canvas { background:#0f172a; }
                        .pl-template-thumb.thumb-engineering .te-header { position:absolute; inset:0 0 auto 0; height:20px; background:#1e293b; border-bottom:2px solid var(--accent,#0ea5e9); }
                        .pl-template-thumb.thumb-engineering .te-map { position:absolute; left:0; right:30px; top:22px; bottom:14px; background:#111827; }
                        .pl-template-thumb.thumb-engineering .te-sidebar { position:absolute; right:0; top:22px; bottom:14px; width:28px; background:#1e293b; border-left:1px solid #334155; }
                        .pl-template-thumb.thumb-engineering .te-footer { position:absolute; inset:auto 0 0 0; height:12px; background:#1e293b; border-top:1px solid #334155; }
                        /* Template 3 – Coverage + Legend: accent left sidebar, white right, dark footer */
                        .pl-template-thumb.thumb-coverage .thumb-canvas { background:#ffffff; }
                        .pl-template-thumb.thumb-coverage .tc-sidebar { position:absolute; inset:0 auto 0 0; width:28%; background:var(--accent,#14b8a6); }
                        .pl-template-thumb.thumb-coverage .tc-map { position:absolute; left:28%; right:0; top:0; bottom:14px; background:#f8fafc; }
                        .pl-template-thumb.thumb-coverage .tc-footer { position:absolute; left:28%; right:0; bottom:0; height:12px; background:#0f172a; }
                        .pl-template-card .pl-tpl-name { font-size: 13px; font-weight: 700; color: #f1f5f9; margin-bottom: 4px; }
                        .pl-template-card .pl-tpl-desc { font-size: 11px; color: #94a3b8; line-height: 1.4; }
                        .pl-mode-toggle { display:inline-flex; background: rgba(15,23,42,0.6); border:1px solid rgba(148,163,184,0.2); border-radius: 8px; overflow: hidden; }
                        .pl-mode-toggle button { padding: 6px 14px; font-size: 12px; font-weight: 600; color: #94a3b8; background: transparent; border: none; cursor: pointer; }
                        .pl-mode-toggle button.is-active { background: var(--accent, #6366f1); color: #fff; }
                    </style>
                    <header class="pdf-hero card translucent p-6 overflow-hidden">
                        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                            <div class="space-y-2">
                                <p class="pdf-step-label">Document Suite</p>
                                <h2 class="section-title text-3xl">PDF Export Control Room</h2>
                                <p class="muted text-sm max-w-2xl">Generate a spec PDF, visually align template areas, and keep previews responsive with manual refresh.</p>
                            </div>
                            <div class="pdf-quick-metrics metrics-align-right">
                                <div class="metric">
                                    <span class="label">Project</span>
                                    <span class="value">${selectedProjectName}</span>
                                </div>
                                <div class="metric">
                                    <span class="label">Pixel Maps</span>
                                    <span class="value">${pixelMapCount}</span>
                                </div>
                                <div class="metric">
                                    <span class="label">Output Canvases</span>
                                    <span class="value">${canvasCount}</span>
                                </div>
                            </div>
                        </div>
                    </header>

                    <details id="pdf-rendering-guide" class="card p-5 text-sm text-gray-300">
                        <summary class="cursor-pointer font-semibold text-white">Preview quality, GPU acceleration &amp; export accuracy</summary>
                        <ul class="list-disc pl-5 mt-3 space-y-2">
                            <li><strong>Full / Lite:</strong> Full supports previews up to 8.3MP (native 3840 &times; 2160 at 100% quality); Lite caps previews at 1MP. Existing saved limits and the preview-quality slider still apply. Fractional panel edges and borders now scale correctly.</li>
                            <li><strong>Smoother editing:</strong> Output Maps reuse unchanged map images and combine rapid drag/zoom updates into animation frames. The bounded image cache avoids retaining unlimited pixel data; source edits refresh the image.</li>
                            <li><strong>Export accuracy:</strong> pixel-map pages, output canvases and mask exports render from full-resolution sources, independent of Full/Lite preview settings. Crops use native source pixels and annotation shadows remain intact. Advanced PDF artwork still uses print-aware encoding up to 300 DPI for its page placement; full-resolution source rendering does not mean an uncompressed PDF.</li>
                            <li><strong>Output Map names:</strong> use Rename beside the top-level Output Map tabs. Save or Enter persists the name; Cancel leaves it unchanged and blank names are rejected. Nested canvas names stay independent. PDF-only pixel-map name overrides do not rename the source map.</li>
                            <li><strong>External Output:</strong> use Win+P &gt; Extend and the desktop header button. New maps start at 100%; 1:1 is the default view. Fit never changes saved scale. Edit Mode supports multiple maps, Snap, whole-pixel W/H and Scale X/Y percentages. Keep aspect uses native proportions; enter 100% to restore exact native size. The top-right badge shows canvas resolution. Finish editing hides controls and guides. Saved layouts affect canvas exports; display options do not.</li>
                            <li><strong>External Save PNG:</strong> in the monitor's Edit Mode toolbar, Save PNG exports the full canvas resolution. Maps shift together to the top-left, preserving spacing, with exported X/Y coordinates on each map. Live placement stays unchanged. Drawings and masks shift with the maps; oversized layouts are clipped with a warning.</li>
                            <li><strong>Check the GPU:</strong> <button type="button" data-goto-tab="help" class="text-accent underline">Open Help</button>, then choose Check GPU in the desktop app. Acceleration may use an integrated GPU even when a dedicated card is available. Browser graphics are managed by the browser.</li>
                            <li><strong>Prefer a dedicated GPU on Windows:</strong> Settings &gt; System &gt; Display &gt; Graphics &gt; select Pixelogic &gt; Options &gt; High performance, then restart. Keep driver compatibility checks enabled. GPU acceleration improves rendering performance, not the accuracy of project dimensions.</li>
                        </ul>
                    </details>

                    <div class="pdf-ui-mode-bar">
                        <div class="flex items-center gap-3 flex-wrap">
                            <div class="pdf-ui-mode-grp" id="pdf-ui-mode-toggle">
                                <button type="button" data-ui-mode="simple" class="${isSimpleMode ? 'is-active' : ''}">&#9733; Simple</button>
                                ${isSimpleExperience ? '' : `<button type="button" data-ui-mode="advanced" class="${!isSimpleMode ? 'is-active' : ''}">&#9881; Advanced</button>`}
                            </div>
                            <span class="text-xs text-gray-400">${isSimpleMode ? 'Quick setup &mdash; pick a template, fill title block, set delivery spec, export.' : 'Full control &mdash; fixed installed A3 template with advanced pairing, typography, coverage, and delivery controls.'}</span>
                        </div>
                        ${!isSimpleMode ? '<span class="text-xs text-gray-500 italic">Switch to &#9733; Simple for a guided experience</span>' : ''}
                    </div>

                    <div class="pdf-export-columns">
                        <section class="pdf-column-primary space-y-6">
                            <div class="card p-5 space-y-5 pdf-step-card pdf-tab--gallery" data-collapsible="true">
                                <div class="pdf-collapsible-header" style="display:flex;gap:10px;align-items:flex-start;">
                                    <span class="pdf-step-num">1</span>
                                    <div>
                                        <p class="pdf-step-label" style="color:#a5b4fc;">Template</p>
                                        <h3 class="text-xl font-semibold text-white">Page Template &amp; Layout</h3>
                                        <p class="text-sm text-gray-400">Pick a built-in professional template, page size, and branding. No manual zone editing required.</p>
                                    </div>
                                </div>

                                <div class="flex items-center justify-between flex-wrap gap-3">
                                    <span class="text-xs px-2 py-1 rounded-md border border-indigo-400/40 bg-indigo-500/10 text-indigo-200">Template Gallery Workflow</span>
                                    <span class="text-xs text-gray-500">Curated templates for fast, consistent exports</span>
                                </div>

                                <div id="pdf-gallery-config" class="space-y-5">
                                    <!-- Page size + orientation + branding -->
                                    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
                                        <div>
                                            <label for="pdf-page-size" class="block text-sm font-medium text-gray-300 mb-2">Page Size</label>
                                            <select id="pdf-page-size" class="w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2">
                                                ${['a2','a3','a4','a5','letter','tabloid'].map(s => `<option value="${s}" ${state.pdfExport.pageSize === s ? 'selected' : ''}>${s.toUpperCase()}</option>`).join('')}
                                            </select>
                                        </div>
                                        <div>
                                            <label for="pdf-page-orientation" class="block text-sm font-medium text-gray-300 mb-2">Orientation</label>
                                            <select id="pdf-page-orientation" class="w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2" ${_tplOrientation === 'landscape' ? 'disabled' : ''}>
                                                <option value="landscape" ${_effectiveOrientation === 'landscape' ? 'selected' : ''}>Landscape</option>
                                                <option value="portrait" ${_effectiveOrientation === 'portrait' ? 'selected' : ''} ${_tplOrientation === 'landscape' ? 'disabled' : ''}>Portrait</option>
                                            </select>
                                            ${_tplOrientation === 'landscape' ? '<div class="mt-1 text-[10px] text-gray-500">This template is landscape-only to prevent clipping.</div>' : ''}
                                        </div>
                                        <div>
                                            <label for="pdf-accent-color" class="block text-sm font-medium text-gray-300 mb-2">Accent Color</label>
                                            <input type="color" id="pdf-accent-color" value="${state.pdfExport.accentColor || '#6366f1'}" class="w-full h-10 bg-gray-900 border border-gray-600 rounded-lg cursor-pointer"/>
                                        </div>
                                        <div>
                                            <label for="pdf-font-scale" class="block text-sm font-medium text-gray-300 mb-2">Text Size</label>
                                            <select id="pdf-font-scale" class="w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2">
                                                <option value="0.75" ${state.pdfExport.fontScale == 0.75 ? 'selected' : ''}>Small (75%)</option>
                                                <option value="1" ${(!state.pdfExport.fontScale || state.pdfExport.fontScale == 1) ? 'selected' : ''}>Normal (100%)</option>
                                                <option value="1.2" ${state.pdfExport.fontScale == 1.2 ? 'selected' : ''}>Large (120%)</option>
                                                <option value="1.4" ${state.pdfExport.fontScale == 1.4 ? 'selected' : ''}>X-Large (140%)</option>
                                                <option value="1.6" ${state.pdfExport.fontScale == 1.6 ? 'selected' : ''}>2X-Large (160%)</option>
                                            </select>
                                        </div>
                                        <div>
                                            <label for="pdf-logo-upload" class="block text-sm font-medium text-gray-300 mb-2">Logo (PNG)</label>
                                            <input type="file" id="pdf-logo-upload" accept="image/*" class="w-full text-xs text-gray-400 file:mr-2 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:font-semibold file:bg-gray-700 file:text-gray-200 hover:file:bg-gray-600"/>
                                            ${state.pdfExport.logoSrc ? `<div class="mt-2 flex items-center gap-2"><img src="${state.pdfExport.logoSrc}" style="max-height:30px;max-width:120px;object-fit:contain;background:#fff;padding:3px;border-radius:4px;"/><button type="button" id="pdf-logo-clear" class="text-xs text-red-400 hover:text-red-300">Remove</button></div>` : ''}
                                        </div>
                                    </div>

                                    <div class="text-xs text-gray-500 italic">Project info, client, venue, date, and revision come from the Title Block fields below and the Project Details card.</div>
                                </div>
                            </div>

                            <div class="card p-5 space-y-6 pdf-step-card pdf-tab--project" data-collapsible="true">
                                <div class="pdf-collapsible-header" style="display:flex;gap:10px;align-items:flex-start;">
                                    <span class="pdf-step-num">2</span>
                                    <div>
                                        <p class="pdf-step-label pdf-step-label--project">Project</p>
                                        <h3 class="text-xl font-semibold text-white">Project Details</h3>
                                        <p class="text-sm text-gray-400">Choose the project, document title, and base export filename.</p>
                                    </div>
                                </div>
                                <div class="grid gap-4 md:grid-cols-2">
                                    <div class="md:col-span-2">
                                        <label for="pdf-project-select" class="block text-sm font-medium text-gray-300 mb-2" title="Choose which project to generate the PDF for">Select Project</label>
                                        <select id="pdf-project-select" class="w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2">${projectOptions}</select>
                                    </div>
                                    <div>
                                        <label for="pdf-title-input" class="block text-sm font-medium text-gray-300 mb-2" title="Shown in the PDF header banner across pages">Document Title</label>
                                        <input type="text" id="pdf-title-input" value="${state.pdfExport.pdfTitle || ''}" placeholder="e.g., Main Show 2025" class="w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2">
                                    </div>
                                    <div>
                                        <label for="pdf-output-filename" class="block text-sm font-medium text-gray-300 mb-2" title="Base name for the downloaded file (extension is added automatically)">PDF File Name</label>
                                        <input type="text" id="pdf-output-filename" value="${state.pdfExport.outputFileName || ''}" placeholder="CANVASMAP_DETAILS" class="w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2">
                                    </div>
                                </div>
                            </div>

                            <div class="card p-5 space-y-6 pdf-step-card pdf-tab--coverage" data-collapsible="true">
                                <div class="pdf-collapsible-header">
                                    <p class="pdf-step-label pdf-step-label--coverage">Coverage</p>
                                    <h3 class="text-xl font-semibold text-white">Output Maps & Title Page Image</h3>
                                    <p class="text-sm text-gray-400">Control which canvases appear and optional hero imagery.</p>
                                </div>
                                <div class="space-y-4">
                                    <div>
                                        <label for="pdf-include-canvas" class="block text-sm font-medium text-gray-300 mb-1" title="Include Output Canvas pages in addition to Pixel Map pages">Include Output Map</label>
                                        <select id="pdf-include-canvas" class="w-full bg-gray-900 border border-gray-600 rounded-none px-3 py-2">
                                            <option value="none" ${state.pdfExport.includeCanvas === 'none' || !state.pdfExport.includeCanvas ? 'selected' : ''}>None</option>
                                            <option value="active" ${state.pdfExport.includeCanvas === 'active' ? 'selected' : ''}>Active (current canvas)</option>
                                            <option value="current-map" ${state.pdfExport.includeCanvas === 'current-map' ? 'selected' : ''}>All Canvases (Active Output Map)</option>
                                            <option value="specific" ${state.pdfExport.includeCanvas === 'specific' ? 'selected' : ''}>Specific Output Map(s)</option>
                                            <option value="all" ${state.pdfExport.includeCanvas === 'all' ? 'selected' : ''}>All Output Maps &amp; Canvases</option>
                                        </select>
                                        <p class="mt-1 text-xs text-gray-500">Canvas pages place two labeled canvases per page when available.</p>
                                    </div>
                                    <div id="pdf-canvas-select-wrap" class="${(state.pdfExport.includeCanvas === 'specific') ? '' : 'hidden'} space-y-2">
                                        <label for="pdf-canvas-select" class="block text-sm font-medium text-gray-300" title="Pick which Output Canvases to include when 'Specific Output' is selected">Select Output Map(s)</label>
                                        <select id="pdf-canvas-select" multiple size="5" class="w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2">
                                            ${(selectedProjectForPdf?.canvases || []).map(c => {
                                                const sel = (state.pdfExport.selectedCanvasIds||[]).map(String).includes(String(c.id)) ? 'selected' : '';
                                                return `<option value=\"${c.id}\" ${sel}>${escapeHtml(c.name || ('Canvas '+c.id))}</option>`;
                                            }).join('')}
                                        </select>
                                        <div id="pdf-canvas-thumbs" class="grid grid-cols-2 md:grid-cols-3 gap-2"></div>
                                    </div>
                                    <div class="grid gap-4 md:grid-cols-2">
                                        <div class="md:col-span-2">
                                            <label class="block text-sm font-medium text-gray-300 mb-2" title="Upload a cover image to display on the Title Page (optional)">Optional Title Page Image</label>
                                            <input type="file" id="cover-upload" accept="image/*" class="w-full text-sm text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:font-semibold file:bg-gray-600 file:text-gray-200 hover:file:bg-gray-700"/>
                                            ${state.pdfExport.coverImageSrc ? `<img src="${state.pdfExport.coverImageSrc}" class="mt-2 max-h-24 object-contain rounded"/>` : ''}
                                        </div>
                                        <label class="flex items-center gap-2 text-sm text-gray-300" title="Adds a cover/title page before the content pages">
                                            <input type="checkbox" id="pdf-include-title-page" ${state.pdfExport.includeTitlePage ? 'checked' : ''} />
                                            Include Title Page
                                        </label>
                                        <label class="flex items-center gap-2 text-sm text-gray-300" title="Show LED pixel pitch in the Details area on each page">
                                            <input type="checkbox" id="pdf-include-pitch" ${state.pdfExport.includePitchInDetails ? 'checked' : ''} />
                                            Include LED Pixel Pitch
                                        </label>
                                        <label class="flex items-center gap-2 text-sm text-gray-300 md:col-span-2" title="Adds the current 3D View snapshot as a page — visit the 3D View tab first to set your camera angle">
                                            <input type="checkbox" id="pdf-include-3d" ${state.pdfExport.include3dView ? 'checked' : ''} />
                                            Include 3D View Snapshot
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="${mapNameInputs ? '' : 'hidden'} card p-5 space-y-4 pdf-tab--maplabels" data-collapsible="true">
                                <div class="pdf-collapsible-header">
                                    <p class="pdf-step-label pdf-step-label--maplabels">Map Labels</p>
                                    <h3 class="text-xl font-semibold text-white">Reference Images - Pixel Maps Renaming</h3>
                                    <p class="text-sm text-gray-400">Rename maps just for the PDF and attach optional references.</p>
                                </div>
                                <div class="space-y-2 p-4 bg-gray-900/50 rounded-lg">${mapNameInputs}</div>
                            </div>

                            <div class="${pairingRowsHtml ? '' : 'hidden'} card p-5 space-y-4 pdf-tab--pairing" data-collapsible="true" id="pdf-pairing-card">
                                <div class="pdf-collapsible-header">
                                    <p class="pdf-step-label pdf-step-label--pairing">Pairing</p>
                                    <h3 class="text-xl font-semibold text-white">Page Pairing</h3>
                                    <p class="text-sm text-gray-400">Place two pixel maps side-by-side on the same page. Maps with equal resolution are paired automatically — use this to manually define or override pairs.</p>
                                </div>
                                <div id="pdf-pair-rows" class="space-y-2 p-3 bg-gray-900/50 rounded-lg">
                                    ${pairingRowsHtml}
                                </div>
                                <p class="text-xs text-gray-500">The last row (marked +) is the "add new pair" slot — just pick both maps. Each map can only appear in one pair.</p>
                            </div>

                            <div class="card p-5 space-y-4 pdf-tab--template" data-collapsible="true">
                                <div class="pdf-collapsible-header">
                                    <p class="pdf-step-label pdf-step-label--template">Advanced Template</p>
                                    <h3 class="text-xl font-semibold text-white">Custom PDF Template</h3>
                                    <p class="text-sm text-gray-400">Upload your own PDF artwork or use the embedded default template.</p>
                                </div>
                                <div class="space-y-2">
                                    <input type="file" id="template-upload" class="w-full text-sm text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:font-semibold file:bg-gray-600 file:text-gray-200 hover:file:bg-gray-700"/>
                                    <p class="text-xs text-gray-400">No artwork? Export still works — a clean fallback layout will be used automatically.</p>
                                    <div class="space-y-1 pt-1 text-sm text-gray-300">
                                        <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Active template</p>
                                        <label class="flex items-center gap-2" title="Use your uploaded PDF artwork">
                                            <input type="radio" name="pdf-template-choice" value="custom" ${!state.pdfExport.useDefaultTemplate && state.pdfExport.customTemplateSrc ? 'checked' : ''} ${state.pdfExport.customTemplateSrc ? '' : 'disabled'} />
                                            Use custom uploaded template
                                        </label>
                                        <label class="flex items-center gap-2" title="Use the embedded default PDF artwork">
                                            <input type="radio" name="pdf-template-choice" value="default" ${state.pdfExport.useDefaultTemplate || !state.pdfExport.customTemplateSrc ? 'checked' : ''} />
                                            Use embedded default template
                                        </label>
                                    </div>
                                    ${state.pdfExport.templateOptOut ? '<div class="text-xs text-amber-300 flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-amber-300"></span>Template-free mode active</div>' : ''}
                                </div>
                                <div id="template-preview-container" class="relative w-full h-96 bg-gray-900 rounded-lg flex items-center justify-center overflow-hidden border border-gray-800">
                                    <img id="template-preview" src="${state.pdfExport.templateSrc || ''}" class="max-w-full max-h-full object-contain select-none transition-opacity duration-200 ${state.pdfExport.templateSrc ? '' : 'opacity-0 pointer-events-none'}" />
                                    <div class="${state.pdfExport.templateSrc ? 'hidden' : 'flex'} absolute inset-0 flex-col items-center justify-center text-center px-6 text-gray-400 bg-gradient-to-b from-gray-900/40 to-gray-900/80">
                                        <p class="text-sm font-semibold">${state.pdfExport.templateOptOut ? 'Template-free mode enabled' : 'No template artwork loaded'}</p>
                                        <p class="text-xs text-gray-500 mt-1">Upload custom branding or continue with the fallback layout.</p>
                                    </div>
                                    <div id="pdf-placement-preview" class="absolute bg-sky-400/20 border-2 border-dashed border-sky-400/80" style="z-index:5"></div>
                                    <div id="pdf-map-area-outline" data-area="templateArea" class="absolute border-2 border-lime-400/95 bg-lime-300/15 cursor-move select-none" style="z-index:10"></div>
                                    <div id="pdf-title-area-preview" data-area="titleArea" class="absolute border-2 border-gray-300 bg-gray-200/70 cursor-move select-none" style="z-index:10"></div>
                                    <div id="pdf-details-area-preview" data-area="detailsArea" class="absolute border-2 border-gray-300 bg-gray-200/70 cursor-move select-none" style="z-index:10"></div>
                                    <div id="pdf-title-block-area-preview" data-area="titleBlockArea" class="absolute border-2 border-orange-400 bg-orange-300/30 cursor-move select-none" style="z-index:10"></div>
                                    <div id="pdf-ref-area-preview" data-area="refImageArea" class="absolute border-2 border-purple-400 bg-purple-300/25 cursor-move select-none" style="z-index:10"></div>
                                    <div id="pdf-template-area-label" class="absolute text-[10px] px-1 py-0.5 rounded bg-black/50 text-white pointer-events-none" style="z-index:15">Map Area</div>
                                    <div id="pdf-title-area-label" class="absolute text-[10px] px-1 py-0.5 rounded bg-black/50 text-white pointer-events-none" style="z-index:15">Title Area</div>
                                    <div id="pdf-details-area-label" class="absolute text-[10px] px-1 py-0.5 rounded bg-black/50 text-white pointer-events-none" style="z-index:15">Details Area</div>
                                    <div id="pdf-title-block-area-label" class="absolute text-[10px] px-1 py-0.5 rounded bg-black/50 text-white pointer-events-none" style="z-index:15">Title Block Area</div>
                                    <div id="pdf-ref-area-label" class="absolute text-[10px] px-1 py-0.5 rounded bg-black/50 text-white pointer-events-none" style="z-index:15">Ref Image Area</div>
                                    <div class="absolute top-2 right-2 flex gap-2 flex-wrap justify-end">
                                        <button id="reset-template-fit" class="px-2 py-1 rounded bg-gray-700 text-xs" title="Clear saved preview scale and refit to default height">Reset fit</button>
                                        <button id="clear-saved-template" class="px-2 py-1 rounded bg-gray-700 text-xs" title="Remove the template artwork and rely on the fallback layout">Remove template</button>
                                    </div>
                                </div>
                            </div>

                            <div id="template-areas-editor" class="card p-5 space-y-4 pdf-tab--areas" data-collapsible="true">
                                <div class="flex items-center justify-between pdf-collapsible-header">
                                    <div class="flex items-center gap-3">
                                        <div>
                                            <p class="pdf-step-label pdf-step-label--areas">Areas</p>
                                            <div class="text-sm text-gray-300" title="Position and size the Map, Title, Details, and Title Block regions on the template">Define Template Areas</div>
                                        </div>
                                        <span id="save-areas-status" class="text-xs text-green-400 hidden">Saved</span>
                                        <span id="areas-dirty-status" class="text-xs text-yellow-400 hidden">Unsaved changes</span>
                                        <span id="template-mode-badge" class="text-xs text-amber-300 ${state.pdfExport.templateSrc ? 'hidden' : ''}">Fallback layout active</span>
                                    </div>
                                    <div class="flex gap-2 text-xs flex-wrap justify-end">
                                        <button id="preset-map-left" class="px-2 py-1 rounded bg-gray-700" title="Quick preset: place Map Area to the left">Map: Left Panel</button>
                                        <button id="preset-title-top" class="px-2 py-1 rounded bg-gray-700" title="Quick preset: move Title Area to the top">Title: Top</button>
                                        <button id="preset-details-bottom" class="px-2 py-1 rounded bg-gray-700" title="Quick preset: move Details Area to the bottom">Details: Bottom</button>
                                        <button id="preset-screenshot-defaults" class="px-2 py-1 rounded bg-gray-700" title="Restore typical defaults used for screenshots">Screenshot Defaults</button>
                                        <button id="preset-title-block-right" class="px-2 py-1 rounded bg-gray-700" title="Quick preset: place Title Block on the right">Title Block: Right</button>
                                        <div class="hidden lg:block mx-2 border-l border-gray-700"></div>
                                        <button id="save-areas" class="px-2 py-1 rounded bg-accent/80 text-black font-semibold" title="Persist the current rectangles so they load next time">Save Areas</button>
                                        <button id="clear-saved-areas" class="px-2 py-1 rounded bg-gray-700" title="Remove saved rectangles from storage">Clear saved areas</button>
                                    </div>
                                </div>
                                <div class="p-3 rounded border border-gray-700/50 text-xs text-gray-300 bg-gray-900/40">
                                    Drag and resize the boxes on the template preview above. Hold Shift to lock aspect. These regions still control your PDF layout even when no artwork is loaded. When you're done positioning, click <span class="font-semibold">Save Areas</span>.
                                </div>
                            </div>

                            <div class="card p-5 space-y-4 pdf-tab--titleblock" data-collapsible="true">
                                <div class="pdf-collapsible-header" style="display:flex;gap:10px;align-items:flex-start;">
                                    <span class="pdf-step-num">3</span>
                                    <div>
                                        <p class="pdf-step-label pdf-step-label--titleblock">Title Block</p>
                                        <h3 class="text-xl font-semibold text-white">Title Block Details</h3>
                                        <p class="text-sm text-gray-400">Populate the right-hand info table that appears on every page.</p>
                                    </div>
                                </div>
                                <label class="inline-flex items-center gap-2 text-sm text-gray-300"><input type="checkbox" id="tb-show" ${state.pdfExport.showTitleBlock ? 'checked' : ''}> Include Title Block on PDF</label>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                    <label class="text-sm text-gray-300">Project name
                                        <input type="text" id="tb-projectName" value="${state.pdfExport.titleBlock.projectName || selectedProjectForPdf?.name || ''}" class="w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2">
                                    </label>
                                    <label class="text-sm text-gray-300">Project Date
                                        <input type="date" id="tb-projectDate" value="${state.pdfExport.titleBlock.projectDate || ''}" class="w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2">
                                    </label>
                                    <label class="text-sm text-gray-300">Venue
                                        <input type="text" id="tb-venue" value="${state.pdfExport.titleBlock.venue || selectedProjectForPdf?.venue || ''}" class="w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2">
                                    </label>
                                    <label class="text-sm text-gray-300">Sales
                                        <input type="text" id="tb-sales" value="${state.pdfExport.titleBlock.sales || selectedProjectForPdf?.salesperson || ''}" class="w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2">
                                    </label>
                                    <label class="text-sm text-gray-300">Client
                                        <input type="text" id="tb-client" value="${state.pdfExport.titleBlock.client || selectedProjectForPdf?.client || ''}" class="w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2">
                                    </label>
                                    <label class="text-sm text-gray-300">Page
                                        <input type="text" id="tb-page" value="${state.pdfExport.titleBlock.page || ''}" class="w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2" placeholder="e.g., 1">
                                    </label>
                                    <label class="text-sm text-gray-300">Drawn By
                                        <input type="text" id="tb-drawnBy" value="${state.pdfExport.titleBlock.drawnBy || ''}" class="w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2">
                                    </label>
                                    <label class="text-sm text-gray-300">Version
                                        <input type="text" id="tb-version" value="${state.pdfExport.titleBlock.version || ''}" class="w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2">
                                    </label>
                                </div>
                                <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                                    <label class="text-sm text-gray-300">Label Font Size
                                        <input type="number" min="5" max="16" step="1" id="tb-label-fs" value="${state.pdfExport.titleBlockStyle?.labelBaseFS ?? 8}" class="w-full bg-gray-900 border border-gray-700 rounded-lg px-3 py-2">
                                    </label>
                                    <label class="text-sm text-gray-300">Value Font Size
                                        <input type="number" min="6" max="18" step="1" id="tb-value-fs" value="${state.pdfExport.titleBlockStyle?.valueBaseFS ?? 9}" class="w-full bg-gray-900 border border-gray-700 rounded-lg px-3 py-2">
                                    </label>
                                    <label class="text-sm text-gray-300">Entry Gap
                                        <input type="number" min="0" max="10" step="1" id="tb-entry-gap" value="${state.pdfExport.titleBlockStyle?.entryGap ?? 4}" class="w-full bg-gray-900 border border-gray-700 rounded-lg px-3 py-2">
                                    </label>
                                </div>
                            </div>

                            <div class="card p-5 space-y-4 pdf-tab--typography" data-collapsible="true">
                                <div class="pdf-collapsible-header">
                                    <p class="pdf-step-label pdf-step-label--typography">Typography</p>
                                    <h3 class="text-xl font-semibold text-white">Typography - Template Artwork</h3>
                                    <p class="text-sm text-gray-400">Dial in the fonts used across banners, details, and delivery panels.</p>
                                </div>
                                <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                                    <label class="text-sm text-gray-300">Font Family
                                        <span class="ml-1 text-gray-400 cursor-help" title="System fonts are listed from Windows. PDF export uses core fonts; unsupported fonts will fall back to Helvetica.">ⓘ</span>
                                        <select id="pdf-font-family" class="w-full bg-gray-900 border border-gray-700 rounded-lg px-3 py-2">
                                            ${(() => {
                                                const current = String(state.pdfExport.textStyle?.fontFamily || 'helvetica').toLowerCase();
                                                const core = [
                                                    { value: 'helvetica', label: 'Helvetica' },
                                                    { value: 'times', label: 'Times' },
                                                    { value: 'courier', label: 'Courier' },
                                                    { value: 'arial', label: 'Arial (MS) → Helvetica' },
                                                    { value: 'timesnewroman', label: 'Times New Roman (MS) → Times' },
                                                    { value: 'couriernew', label: 'Courier New (MS) → Courier' }
                                                ];
                                                const coreHtml = core.map(o => `<option value="${o.value}" ${current === o.value ? 'selected' : ''}>${o.label}</option>`).join('');
                                                const coreSet = new Set(core.map(o => o.value));
                                                const sys = getFontOptions().filter(Boolean)
                                                    .map(name => String(name).trim())
                                                    .filter(name => !!name && !coreSet.has(name.toLowerCase()));
                                                const sysHtml = sys.map(name => {
                                                    const v = escapeHtml(name);
                                                    const selected = current === name.toLowerCase() ? 'selected' : '';
                                                    return `<option value="${v}" ${selected}>${v} (System)</option>`;
                                                }).join('');
                                                return coreHtml + (sysHtml ? `<optgroup label="System Fonts">${sysHtml}</optgroup>` : '');
                                            })()}
                                        </select>
                                    </label>
                                    <label class="text-sm text-gray-300">Title Banner Font Size
                                        <input type="number" min="8" max="48" step="1" id="pdf-banner-fs" value="${Number.isFinite(+state.pdfExport.textStyle?.bannerFS) && +state.pdfExport.textStyle.bannerFS > 0 ? state.pdfExport.textStyle.bannerFS : ''}" placeholder="Auto" class="w-full bg-gray-900 border border-gray-700 rounded-lg px-3 py-2">
                                    </label>
                                    <label class="text-sm text-gray-300">Details Block Font Size
                                        <span class="ml-1 text-gray-400 cursor-help" title="Default font size for the Details block; content may auto-shrink to fit the box.">ⓘ</span>
                                        <input type="number" min="6" max="72" step="1" id="pdf-details-fs" value="${state.pdfExport.textStyle?.detailsFS ?? 14}" class="w-full bg-gray-900 border border-gray-700 rounded-lg px-3 py-2">
                                        <label class="inline-flex items-center gap-2 mt-1"><input type="checkbox" id="pdf-details-fit" ${state.pdfExport.textStyle?.detailsFitToText ? 'checked' : ''}> Auto-fit details box height to content</label>
                                    </label>
                                </div>
                                <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                                    <label class="text-sm text-gray-300">Delivery Page Font Size
                                        <span class="ml-1 text-gray-400 cursor-help" title="Base font size for the Delivery page rows; will shrink if needed to fit the panel.">ⓘ</span>
                                        <input type="number" min="8" max="72" step="1" id="pdf-delivery-fs" value="${state.pdfExport.textStyle?.deliveryFS ?? 12}" class="w-full bg-gray-900 border border-gray-700 rounded-lg px-3 py-2">
                                    </label>
                                    <label class="text-sm text-gray-300">Title Banner Align (H)
                                        <span class="ml-1 text-gray-400 cursor-help" title="Horizontal alignment of banner text inside the Title Area across pages.">ⓘ</span>
                                        <select id="pdf-banner-align-h" class="w-full bg-gray-900 border border-gray-700 rounded-lg px-3 py-2">
                                            <option value="left" ${state.pdfExport.textStyle?.bannerAlignH === 'left' ? 'selected' : ''}>Left</option>
                                            <option value="center" ${!state.pdfExport.textStyle?.bannerAlignH || state.pdfExport.textStyle?.bannerAlignH === 'center' ? 'selected' : ''}>Center</option>
                                            <option value="right" ${state.pdfExport.textStyle?.bannerAlignH === 'right' ? 'selected' : ''}>Right</option>
                                        </select>
                                    </label>
                                    <label class="text-sm text-gray-300">Title Banner Align (V)
                                        <span class="ml-1 text-gray-400 cursor-help" title="Vertical alignment of banner text inside the Title Area across pages.">ⓘ</span>
                                        <select id="pdf-banner-align-v" class="w-full bg-gray-900 border border-gray-700 rounded-lg px-3 py-2">
                                            <option value="top" ${state.pdfExport.textStyle?.bannerAlignV === 'top' ? 'selected' : ''}>Top</option>
                                            <option value="middle" ${!state.pdfExport.textStyle?.bannerAlignV || state.pdfExport.textStyle?.bannerAlignV === 'middle' ? 'selected' : ''}>Middle</option>
                                            <option value="bottom" ${state.pdfExport.textStyle?.bannerAlignV === 'bottom' ? 'selected' : ''}>Bottom</option>
                                        </select>
                                    </label>
                                    <label class="flex items-center gap-2 text-sm text-gray-300 mt-1">
                                        <input type="checkbox" id="pdf-banner-include-mapname" ${state.pdfExport.textStyle?.includeMapNameInBanner ? 'checked' : ''} />
                                        Include Pixel Map name in banner
                                        <span class="ml-1 text-gray-400 cursor-help" title="Append the Pixel Map or Output Canvas name after the document title on map/canvas pages.">ⓘ</span>
                                    </label>
                                    <label class="flex items-center gap-2 text-sm text-gray-300 mt-1">
                                        <input type="checkbox" id="pdf-banner-fit" ${state.pdfExport.textStyle?.bannerFitToWidth ? 'checked' : ''} />
                                        Auto-fit banner text to title width
                                        <span class="ml-1 text-gray-400 cursor-help" title="Shrink the banner text so it never overflows the grey Title Area.">ⓘ</span>
                                    </label>
                                </div>
                            </div>
                        </section>

                        <aside class="pdf-column-secondary space-y-6">
                            <div class="card p-5 space-y-4 pdf-actions-card">
                                <div class="flex items-center justify-between gap-3 flex-wrap">
                                    <div>
                                        <p class="pdf-step-label">Action Center</p>
                                        <h3 class="text-lg font-semibold text-white">Preview - PPT and PDF Exports</h3>
                                    </div>
                                    <span class="text-xs text-gray-400 flex items-center gap-1" title="Use Refresh inside the preview panel after making changes">
                                        Manual refresh keeps previews lean
                                    </span>
                                </div>
                                <div class="pdf-actions-grid">
                                    <button id="sticky-preview-pdf-btn" class="btn-glow flex items-center justify-center gap-2 px-3 py-2 font-semibold rounded-lg shadow-md transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-gray-800 bg-gray-700 hover:bg-gray-600 focus:ring-gray-500" title="Render a quick inline preview without downloading">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z"/><circle cx="12" cy="12" r="3"/></svg>
                                        Preview
                                    </button>
                                    <button id="sticky-refresh-preview-btn" class="btn-glow flex items-center justify-center gap-2 px-3 py-2 font-semibold rounded-lg shadow-md transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-gray-800 bg-amber-600/90 hover:bg-amber-500 focus:ring-amber-400" title="Refresh the inline preview with the latest changes">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9A9 9 0 0 1 9 3.51a9 9 0 0 1 11.49 4.33M20.49 15A9 9 0 0 1 15 20.49 9 9 0 0 1 3.51 16.17"></path></svg>
                                        Refresh
                                    </button>
                                    <button id="sticky-generate-pdf-btn" class="btn-glow flex items-center justify-center gap-2 px-3 py-2 font-semibold rounded-lg shadow-md transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-gray-800 bg-rose-600 hover:bg-rose-700 focus:ring-rose-500" title="Generate and download the PDF">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                                        Export
                                    </button>
                                    <button id="sticky-generate-ppt-btn" class="btn-glow flex items-center justify-center gap-2 px-3 py-2 font-semibold rounded-lg shadow-md transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-gray-800 bg-indigo-600 hover:bg-indigo-700 focus:ring-indigo-500" title="Generate and download the PowerPoint">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="8" y1="13" x2="16" y2="13"></line><line x1="8" y1="17" x2="14" y2="17"></line></svg>
                                        Export PPTX
                                    </button>
                                    <button id="sticky-save-areas-btn" class="hidden px-3 py-2 rounded bg-accent/80 text-black font-semibold" title="Persist the current rectangles so they load next time">Save Areas</button>
                                </div>
                                <p class="text-xs text-gray-400 flex items-center gap-2">
                                    <span class="w-2 h-2 rounded-full bg-amber-400/80"></span>Refresh before exporting to capture recent edits.
                                </p>
                            </div>

                            <div class="card p-5 space-y-4 pdf-delivery-card">
                                <div class="flex items-center justify-between gap-3 rounded-xl border border-gray-600/80 bg-gray-900/60 px-4 py-2 shadow-sm shadow-black/40">
                                    <h3 class="text-lg font-semibold text-gray-300" title="Single‑panel summary that appears in the PDF; click Show to view or edit">Video Delivery Specifications</h3>
                                    <button id="delivery-section-toggle" class="${isSimpleMode ? 'hidden' : ''} px-3 py-1.5 rounded-full border border-gray-700 bg-gray-900/70 text-xs font-medium text-gray-200 hover:bg-gray-800 hover:border-gray-500 transition" type="button">Show</button>
                                </div>
                                <!-- Quick-pick preset buttons -->
                                <div class="pdf-ds-presets" id="pdf-delivery-presets-row">
                                    <span class="text-[10px] uppercase tracking-widest text-gray-500 pr-1">Quick&nbsp;pick:</span>
                                    <button type="button" class="pdf-ds-preset-btn${_activePresetKey==='Resolume'?' is-active':''}" data-preset="Resolume">Resolume</button>
                                    <button type="button" class="pdf-ds-preset-btn${_activePresetKey==='Disguise d3'?' is-active':''}" data-preset="Disguise d3">Disguise d3</button>
                                    <button type="button" class="pdf-ds-preset-btn${_activePresetKey==='Dataton Watchout 6'?' is-active':''}" data-preset="Dataton Watchout 6">Watchout 6</button>
                                    <button type="button" class="pdf-ds-preset-btn${_activePresetKey==='Dataton Watchout 7'?' is-active':''}" data-preset="Dataton Watchout 7">Watchout 7</button>
                                    <button type="button" class="pdf-ds-preset-btn${_activePresetKey==='Playback Pro'?' is-active':''}" data-preset="Playback Pro">Playback Pro</button>
                                    <button type="button" class="pdf-ds-preset-btn${_activePresetKey==='Green Hippo'?' is-active':''}" data-preset="Green Hippo">Green Hippo</button>
                                    <button type="button" class="pdf-ds-preset-btn${_activePresetKey==='Pixera'?' is-active':''}" data-preset="Pixera">Pixera</button>
                                </div>
                                <div id="delivery-section-body" class="space-y-3${isSimpleMode ? '' : ' hidden'}">
                            <!-- Professional summary card -->
                            <div class="rounded-xl border border-gray-700 bg-gradient-to-b from-gray-900/80 to-black/60 p-4 shadow-inner shadow-black/40 space-y-4">
                                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                                    <div>
                                        <div class="text-[11px] uppercase tracking-[0.18em] text-gray-400">Delivery Overview</div>
                                        <div class="text-xs text-gray-400">Single‑panel summary used on the PDF output.</div>
                                    </div>
                                    <button id="delivery-edit-toggle" class="self-start sm:self-auto px-3 py-1.5 rounded-full border border-gray-600/80 bg-gray-800/70 text-xs font-medium text-gray-100 hover:bg-gray-700/80 hover:border-gray-400 transition" title="Switch to editable form">Edit</button>
                                </div>

                                <!-- Video delivery -->
                                <div class="pt-3 border-t border-gray-800">
                                    <div class="text-[11px] font-semibold tracking-[0.18em] text-gray-400 uppercase mb-2">Video Delivery</div>
                                    <dl class="grid gap-x-6 gap-y-2 text-xs sm:text-sm sm:grid-cols-2">
                                        <div>
                                            <dt class="text-gray-400">Media Server</dt>
                                            <dd id="delivery-summary-media" class="mt-0.5 text-gray-100 font-semibold">${state.pdfExport.deliverySpec.mediaServer || 'N/A'}</dd>
                                        </div>
                                        <div>
                                            <dt class="text-gray-400">Format</dt>
                                            <dd id="delivery-summary-format" class="mt-0.5 text-gray-100 font-semibold">${state.pdfExport.deliverySpec.format || 'N/A'}</dd>
                                        </div>
                                        <div class="sm:col-span-2">
                                            <dt class="text-gray-400">Codec(s)</dt>
                                            <dd id="delivery-summary-codecs" class="mt-0.5 text-gray-100">${Array.isArray(state.pdfExport.deliverySpec.codecs) ? state.pdfExport.deliverySpec.codecs.join(', ') : (state.pdfExport.deliverySpec.codecs || 'N/A')}</dd>
                                        </div>
                                        <div class="sm:col-span-2">
                                            <dt class="text-gray-400">Download Link(s)</dt>
                                            <dd id="delivery-summary-links" class="mt-0.5 text-gray-100 space-y-1">
                                                ${state.pdfExport.deliverySpec.codecsLink ? `<div><a href="${state.pdfExport.deliverySpec.codecsLink}" class="text-accent underline">${state.pdfExport.deliverySpec.codecsLink}</a></div>` : ''}
                                                ${state.pdfExport.deliverySpec.codecsLink2 ? `<div><a href="${state.pdfExport.deliverySpec.codecsLink2}" class="text-accent underline">${state.pdfExport.deliverySpec.codecsLink2}</a></div>` : ''}
                                            </dd>
                                        </div>
                                        <div>
                                            <dt class="text-gray-400">Quality</dt>
                                            <dd id="delivery-summary-quality" class="mt-0.5 text-gray-100 font-semibold">${state.pdfExport.deliverySpec.quality || 'N/A'}</dd>
                                        </div>
                                        <div>
                                            <dt class="text-gray-400">Pixel Aspect Ratio</dt>
                                            <dd id="delivery-summary-par" class="mt-0.5 text-gray-100">${state.pdfExport.deliverySpec.pixelAspectRatio || 'N/A'}</dd>
                                        </div>
                                        <div>
                                            <dt class="text-gray-400">Frame Rate (FPS)</dt>
                                            <dd id="delivery-summary-fps" class="mt-0.5 text-gray-100">${state.pdfExport.deliverySpec.fps || 'N/A'}</dd>
                                        </div>
                                    </dl>
                                </div>

                                <!-- Audio delivery -->
                                <div class="pt-3 border-t border-gray-800">
                                    <div class="text-[11px] font-semibold tracking-[0.18em] text-gray-400 uppercase mb-2">Audio Delivery</div>
                                    <dl class="grid gap-x-6 gap-y-2 text-xs sm:text-sm sm:grid-cols-2">
                                        <div>
                                            <dt class="text-gray-400">Embedded Audio</dt>
                                            <dd id="delivery-summary-audio" class="mt-0.5 text-gray-100">${state.pdfExport.deliverySpec.embeddedAudio ? state.pdfExport.deliverySpec.embeddedAudioDetails || 'Yes' : 'No'}</dd>
                                        </div>
                                        <div>
                                            <dt class="text-gray-400">Sample Rate</dt>
                                            <dd id="delivery-summary-sample-rate" class="mt-0.5 text-gray-100">${state.pdfExport.deliverySpec.sampleRate || 'N/A'}</dd>
                                        </div>
                                        <div>
                                            <dt class="text-gray-400">Unembedded Audio Format</dt>
                                            <dd id="delivery-summary-unembedded" class="mt-0.5 text-gray-100">${state.pdfExport.deliverySpec.unembeddedAudioFormat || 'N/A'}</dd>
                                        </div>
                                    </dl>
                                </div>

                                <!-- Files & naming -->
                                <div class="pt-3 border-t border-gray-800">
                                    <div class="text-[11px] font-semibold tracking-[0.18em] text-gray-400 uppercase mb-2">Files & Naming</div>
                                    <dl class="grid gap-x-6 gap-y-2 text-xs sm:text-sm sm:grid-cols-2">
                                        <div>
                                            <dt class="text-gray-400">Still Frame Format</dt>
                                            <dd id="delivery-summary-still" class="mt-0.5 text-gray-100">${state.pdfExport.deliverySpec.stillFrameFormat || 'N/A'}</dd>
                                        </div>
                                        <div>
                                            <dt class="text-gray-400">Naming Structure</dt>
                                            <dd id="delivery-summary-naming" class="mt-0.5 text-gray-100">${state.pdfExport.deliverySpec.namingStructure || 'N/A'}</dd>
                                        </div>
                                        <div class="sm:col-span-2">
                                            <dt class="text-gray-400">Example Filename</dt>
                                            <dd id="delivery-summary-example" class="mt-0.5 font-mono text-[11px] text-gray-200">${state.pdfExport.deliverySpec.example || ''}</dd>
                                        </div>
                                    </dl>
                                </div>

                                <!-- Comments & validation -->
                                <div class="pt-3 border-t border-gray-800">
                                    <div class="text-[11px] font-semibold tracking-[0.18em] text-gray-400 uppercase mb-2">Comments & Validation</div>
                                    <div class="grid gap-4 md:grid-cols-2 text-xs sm:text-sm">
                                        <div>
                                            <div class="text-gray-400">Comments</div>
                                            <div id="delivery-summary-comments" class="mt-1 text-gray-100 whitespace-pre-wrap">${state.pdfExport.deliverySpec.comments || ''}</div>
                                        </div>
                                        <div>
                                            <div class="text-gray-400">Content Validation</div>
                                            <div id="delivery-summary-validation" class="mt-1 text-gray-100 font-semibold">${state.pdfExport.deliverySpec.contentValidationEmail || ''}</div>
                                            <div id="delivery-summary-validation-note" class="mt-1 text-gray-100 text-xs leading-snug">${state.pdfExport.deliverySpec.contentValidationNote || ''}</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Hidden editable form (shown when Edit is clicked) -->
                            <div id="delivery-edit-form" class="mt-3 delivery-edit-shell" hidden>
                                <div class="delivery-edit-header">
                                    <div class="delivery-overline">Edit Delivery Specification</div>
                                    <div class="delivery-subline">Update the values that appear in the PDF delivery panel.</div>
                                </div>

                                <div class="delivery-edit-grid">
                                    <section class="delivery-edit-panel">
                                        <div class="delivery-panel-title">Video Delivery</div>
                                        <div class="delivery-field">
                                            <label class="delivery-label">Media Server</label>
                                            <select id="delivery-media-server" class="delivery-input">
                                                <option value="Resolume" ${state.pdfExport.deliverySpec.mediaServer === 'Resolume' ? 'selected' : ''}>Resolume</option>
                                                <option value="Playback Pro" ${state.pdfExport.deliverySpec.mediaServer === 'Playback Pro' ? 'selected' : ''}>Playback Pro</option>
                                                <option value="Dataton Watchout 6" ${state.pdfExport.deliverySpec.mediaServer === 'Dataton Watchout 6' ? 'selected' : ''}>Dataton Watchout 6</option>
                                                <option value="Dataton Watchout 7" ${state.pdfExport.deliverySpec.mediaServer === 'Dataton Watchout 7' ? 'selected' : ''}>Dataton Watchout 7</option>
                                                <option value="Disguise d3" ${state.pdfExport.deliverySpec.mediaServer === 'Disguise d3' ? 'selected' : ''}>Disguise d3</option>
                                                <option value="Green Hippo" ${state.pdfExport.deliverySpec.mediaServer === 'Green Hippo' ? 'selected' : ''}>Green Hippo</option>
                                                <option value="Pixera" ${state.pdfExport.deliverySpec.mediaServer === 'Pixera' ? 'selected' : ''}>Pixera</option>
                                                <option value="Custom" ${state.pdfExport.deliverySpec.mediaServer === 'Custom' ? 'selected' : ''}>Custom</option>
                                            </select>
                                            <input type="text" id="delivery-media-server-custom" value="${state.pdfExport.deliverySpec.mediaServerCustom || ''}" class="delivery-input mt-2 ${state.pdfExport.deliverySpec.mediaServer === 'Custom' ? '' : 'hidden'}" placeholder="Enter custom media server">
                                        </div>

                                        <div class="delivery-field">
                                            <label class="delivery-label">Codec Links</label>
                                            <div class="delivery-field-stack">
                                                <input type="text" id="delivery-codecs-link" value="${state.pdfExport.deliverySpec.codecsLink}" class="delivery-input" placeholder="Primary download URL">
                                                <input type="text" id="delivery-codecs-link-2" value="${state.pdfExport.deliverySpec.codecsLink2}" class="delivery-input" placeholder="Additional URL (optional)">
                                            </div>
                                        </div>

                                        <div class="delivery-field-grid">
                                            <div class="delivery-field">
                                                <label class="delivery-label">Quality</label>
                                                <input type="text" id="delivery-quality" value="${state.pdfExport.deliverySpec.quality}" class="delivery-input" placeholder="e.g. ProRes 4444">
                                            </div>
                                            <div class="delivery-field">
                                                <label class="delivery-label">Pixel Aspect Ratio</label>
                                                <input type="text" id="delivery-par" value="${state.pdfExport.deliverySpec.pixelAspectRatio}" class="delivery-input" placeholder="e.g. 1.0 (square)">
                                            </div>
                                        </div>

                                        <div class="delivery-field">
                                            <label class="delivery-label">Frame Rate (FPS)</label>
                                            <select id="delivery-fps" class="delivery-input">
                                                <option value="24" ${state.pdfExport.deliverySpec.fps === '24' ? 'selected' : ''}>24</option>
                                                <option value="25" ${state.pdfExport.deliverySpec.fps === '25' ? 'selected' : ''}>25</option>
                                                <option value="30" ${state.pdfExport.deliverySpec.fps === '30' ? 'selected' : ''}>30</option>
                                                <option value="48" ${state.pdfExport.deliverySpec.fps === '48' ? 'selected' : ''}>48</option>
                                                <option value="50" ${state.pdfExport.deliverySpec.fps === '50' ? 'selected' : ''}>50</option>
                                                <option value="60" ${state.pdfExport.deliverySpec.fps === '60' ? 'selected' : ''}>60</option>
                                                <option value="120" ${state.pdfExport.deliverySpec.fps === '120' ? 'selected' : ''}>120</option>
                                            </select>
                                        </div>
                                    </section>

                                    <section class="delivery-edit-panel">
                                        <div class="delivery-panel-title">Audio & Files</div>
                                        <div class="delivery-toggle-stack">
                                            <label class="delivery-checkbox">
                                                <input type="checkbox" id="delivery-embedded-audio" ${state.pdfExport.deliverySpec.embeddedAudio ? 'checked' : ''}>
                                                <span>Embed Audio</span>
                                            </label>
                                        </div>
                                        <div class="delivery-field-grid">
                                            <div class="delivery-field">
                                                <label class="delivery-label">Sample Rate</label>
                                                <input type="text" id="delivery-sample-rate" value="${state.pdfExport.deliverySpec.sampleRate}" class="delivery-input" placeholder="e.g. 48 kHz">
                                            </div>
                                            <div class="delivery-field">
                                                <label class="delivery-label">Unembedded Audio Format</label>
                                                <input type="text" id="delivery-unembedded-format" value="${state.pdfExport.deliverySpec.unembeddedAudioFormat}" class="delivery-input" placeholder="e.g. WAV, stereo">
                                            </div>
                                        </div>

                                        <div class="delivery-field-grid">
                                            <div class="delivery-field">
                                                <label class="delivery-label">Still Frame Format</label>
                                                <input type="text" id="delivery-still-format" value="${state.pdfExport.deliverySpec.stillFrameFormat}" class="delivery-input" placeholder="e.g. PNG, 16-bit">
                                            </div>
                                            <div class="delivery-field">
                                                <label class="delivery-label">Naming Structure</label>
                                                <input type="text" id="delivery-naming" value="${state.pdfExport.deliverySpec.namingStructure}" class="delivery-input" placeholder="e.g. SHOW_SCREEN_v###">
                                            </div>
                                        </div>

                                        <div class="delivery-toggle-stack">
                                            <label class="delivery-checkbox">
                                                <input type="checkbox" id="delivery-include-validation-note" ${state.pdfExport.deliverySpec.showValidationNote ? 'checked' : ''}>
                                                <span>Include validation note in PDF</span>
                                            </label>
                                            <label class="delivery-checkbox">
                                                <input type="checkbox" id="delivery-show-panel-bg" ${state.pdfExport.deliverySpec.showPanelBackground ? 'checked' : ''}>
                                                <span>Show grey panel background</span>
                                            </label>
                                        </div>

                                        <div class="delivery-field">
                                            <label class="delivery-label">Content Validation Email (optional)</label>
                                            <input type="email" id="delivery-content-validation-email" value="${state.pdfExport.deliverySpec.contentValidationEmail || ''}" class="delivery-input" placeholder="name@company.com">
                                        </div>
                                        <div class="delivery-field">
                                            <label class="delivery-label">Content Validation Note</label>
                                            <input type="text" id="delivery-content-validation-note" value="${state.pdfExport.deliverySpec.contentValidationNote || ''}" class="delivery-input" placeholder="Short note or approval instructions">
                                        </div>
                                    </section>
                                </div>
                            </div>
                            </div>

                            <div id="pdf-preview-panel" class="card p-4 pdf-preview-card ${state.pdfExport.previewPanelOpen ? '' : 'hidden'}">
                                <div class="flex items-center justify-between mb-2">
                                    <div class="flex items-center gap-2 text-sm text-gray-300">
                                        PDF Preview
                                        <span id="pdf-preview-dirty" class="text-xs text-amber-300 ${state.pdfExport.previewDirty ? '' : 'hidden'}">Needs refresh</span>
                                    </div>
                                    <div class="flex gap-2">
                                        <button id="pdf-refresh-preview" class="px-2 py-1 rounded bg-accent/80 text-black text-xs font-semibold" title="Render the latest settings into the inline preview">Refresh</button>
                                        <button id="pdf-preview-close" class="px-2 py-1 rounded bg-gray-700 text-xs">Close</button>
                                    </div>
                                </div>
                                <div id="pdf-preview-pages" class="space-y-3 max-h-[60vh] overflow-auto"></div>
                            </div>
                        </aside>
                    </div>
                </div>
            `;

            document.getElementById('pdf-project-select').addEventListener('change', handlePdfProjectChange);
            document.getElementById('template-upload').addEventListener('change', handleTemplateUpload);

            // === Built-in Template Gallery: event bindings ============================
            const galleryGrid = document.getElementById('pdf-template-gallery-grid');
            if (galleryGrid) {
                galleryGrid.addEventListener('click', (e) => {
                    const card = e.target.closest('.pl-template-card');
                    if (!card) return;
                    const id = card.dataset.templateId;
                    if (!id) return;
                    state.pdfExport.galleryTemplateId = id;
                    state.pdfExport.templateMode = 'gallery';
                    try { localStorage.setItem('pdfGalleryTemplateId', id); } catch(_) {}
                    try { localStorage.setItem('pdfTemplateMode', 'gallery'); } catch(_) {}
                    galleryGrid.querySelectorAll('.pl-template-card').forEach(c => c.classList.toggle('is-selected', c.dataset.templateId === id));
                    schedulePdfLivePreview();
                });
            }
            const pageSizeEl = document.getElementById('pdf-page-size');
            if (pageSizeEl) pageSizeEl.addEventListener('change', (e) => {
                state.pdfExport.pageSize = e.target.value;
                try { localStorage.setItem('pdfPageSize', e.target.value); } catch(_) {}
                schedulePdfLivePreview();
            });
            const orientEl = document.getElementById('pdf-page-orientation');
            if (orientEl) orientEl.addEventListener('change', (e) => {
                const next = (_tplOrientation === 'landscape') ? 'landscape' : e.target.value;
                state.pdfExport.pageOrientation = next;
                if (e.target.value !== next) e.target.value = next;
                try { localStorage.setItem('pdfPageOrientation', next); } catch(_) {}
                schedulePdfLivePreview();
            });
            const accentEl = document.getElementById('pdf-accent-color');
            if (accentEl) accentEl.addEventListener('change', (e) => {
                state.pdfExport.accentColor = e.target.value;
                try { localStorage.setItem('pdfAccentColor', e.target.value); } catch(_) {}
                schedulePdfLivePreview();
            });
            const logoUpload = document.getElementById('pdf-logo-upload');
            if (logoUpload) logoUpload.addEventListener('change', (ev) => {
                const file = ev.target.files && ev.target.files[0];
                if (!file) return;
                const reader = new FileReader();
                reader.onload = (re) => {
                    const url = re.target.result;
                    state.pdfExport.logoSrc = url;
                    const img = new Image();
                    img.onload = () => { state.pdfExport.logoImage = img; renderPdfExport(); schedulePdfLivePreview(); };
                    img.src = url;
                    try { localStorage.setItem('pdfLogoSrc', url); } catch(_) {}
                };
                reader.readAsDataURL(file);
            });
            const logoClear = document.getElementById('pdf-logo-clear');
            if (logoClear) logoClear.addEventListener('click', () => {
                state.pdfExport.logoSrc = null;
                state.pdfExport.logoImage = null;
                try { localStorage.removeItem('pdfLogoSrc'); } catch(_) {}
                renderPdfExport();
                schedulePdfLivePreview();
            });
            const fontScaleEl = document.getElementById('pdf-font-scale');
            if (fontScaleEl) fontScaleEl.addEventListener('change', (e) => {
                const v = parseFloat(e.target.value) || 1;
                state.pdfExport.fontScale = v;
                try { localStorage.setItem('pdfFontScale', String(v)); } catch(_) {}
                schedulePdfLivePreview();
            });
            // === End gallery bindings ================================================

            const templateChoiceInputs = document.querySelectorAll('input[name="pdf-template-choice"]');
            templateChoiceInputs.forEach((input) => input.addEventListener('change', (e) => {
                state.pdfExport.useDefaultTemplate = e.target.value === 'default';
                try { localStorage.setItem('pdfUseDefaultTemplate', state.pdfExport.useDefaultTemplate ? 'true' : 'false'); } catch(_) {}
                if (state.pdfExport.useDefaultTemplate) showDefaultPdfTemplate();
                else showCustomPdfTemplate();
            }));
            // Collapsible Step cards in PDF Export
            try {
                const initPdfCollapsibles = () => {
                    const cards = Array.from(document.querySelectorAll('[data-collapsible="true"]'));
                    cards.forEach(card => {
                        if (card.dataset.collapseInit === '1') return;
                        const header = card.querySelector('.pdf-collapsible-header');
                        if (!header) return;
                        let body = card.querySelector('.pdf-collapsible-body');
                        if (!body) {
                            body = document.createElement('div');
                            body.className = 'pdf-collapsible-body';
                            const nodes = Array.from(card.children).filter(ch => ch !== header);
                            nodes.forEach(n => body.appendChild(n));
                            card.appendChild(body);
                        }
                        header.addEventListener('click', (e) => {
                            if (e.target.closest('button, input, select, textarea, a, label')) return;
                            const collapsed = card.classList.toggle('pdf-collapsible-collapsed');
                            header.setAttribute('aria-expanded', String(!collapsed));
                        });
                        header.setAttribute('role', 'button');
                        header.setAttribute('aria-expanded', 'true');
                        card.dataset.collapseInit = '1';
                    });
                };
                initPdfCollapsibles();
            } catch (_) {}
            // Sticky toolbar button bindings
            const stickyPrev = document.getElementById('sticky-preview-pdf-btn'); if (stickyPrev) stickyPrev.addEventListener('click', () => { state.pdfExport.previewPanelOpen = true; generatePdf('preview'); });
            const stickyRefresh = document.getElementById('sticky-refresh-preview-btn'); if (stickyRefresh) stickyRefresh.addEventListener('click', () => {
                state.pdfExport.previewPanelOpen = true;
                generatePdf('preview');
            });
            const stickyGen = document.getElementById('sticky-generate-pdf-btn'); if (stickyGen) stickyGen.addEventListener('click', () => generatePdf('save'));
            const stickyPpt = document.getElementById('sticky-generate-ppt-btn'); if (stickyPpt) stickyPpt.addEventListener('click', () => generatePptx());
            const stickySave = document.getElementById('sticky-save-areas-btn'); if (stickySave) stickySave.addEventListener('click', () => {
                const btn = document.getElementById('save-areas'); if (btn) { btn.click(); } else { showNotification('Open the Template Areas Editor to save areas.'); }
            });
            const restoreBtn = document.getElementById('restore-default-template');
            if (restoreBtn) restoreBtn.addEventListener('click', (e) => {
                e.preventDefault();
                if (state.pdfExport.templateIsCustom) {
                    showNotification('Your custom template is already active; it was kept.');
                    return;
                }
                try { localStorage.removeItem('pdfTemplateSrc'); } catch (_) {}
                const img = new Image();
                img.onload = () => {
                    state.pdfExport.templateImage = img;
                    state.pdfExport.templateSrc = DEFAULT_TEMPLATE_DATA_URI;
                    state.pdfExport.templateIsCustom = false;
                    state.pdfExport.templateOptOut = false;
                    try { localStorage.setItem('pdfTemplateOptOut', 'false'); } catch(_) {}
                    try { localStorage.setItem('pdfTemplateIsCustom', 'false'); } catch(_) {}
                    renderPdfExport();
                    showNotification('Restored default template.');
                    schedulePdfLivePreview();
                };
                img.src = DEFAULT_TEMPLATE_DATA_URI;
            });
            const clearBtn = document.getElementById('clear-saved-template');
            if (clearBtn) clearBtn.addEventListener('click', (e) => {
                e.preventDefault();
                try { localStorage.removeItem('pdfCustomTemplateSrc'); } catch (err) { console.warn('Failed to remove saved template', err); }
                try { localStorage.removeItem('pdfTemplateSrc'); } catch (_) {}
                state.pdfExport.customTemplateImage = null;
                state.pdfExport.customTemplateSrc = null;
                state.pdfExport.templateIsCustom = false;
                state.pdfExport.useDefaultTemplate = true;
                state.pdfExport.templateOptOut = false;
                try { localStorage.setItem('pdfUseDefaultTemplate', 'true'); } catch(_) {}
                try { localStorage.setItem('pdfTemplateOptOut', 'false'); } catch(_) {}
                try { localStorage.setItem('pdfTemplateIsCustom', 'false'); } catch(_) {}
                showDefaultPdfTemplate();
                showNotification('Custom template removed. The embedded default template is now active.');
            });
            const includeCanvasEl = document.getElementById('pdf-include-canvas');
            if (includeCanvasEl) includeCanvasEl.addEventListener('change', (e) => {
                state.pdfExport.includeCanvas = e.target.value;
                const wrap = document.getElementById('pdf-canvas-select-wrap');
                if (wrap) wrap.classList.toggle('hidden', state.pdfExport.includeCanvas !== 'specific');
                schedulePdfLivePreview();
            });
            const canvasSel = document.getElementById('pdf-canvas-select');
            const renderCanvasThumbs = () => {
                const wrap = document.getElementById('pdf-canvas-thumbs');
                if (!wrap) return;
                wrap.innerHTML = '';
                const proj = state.projects.find(p => p.id == state.pdfExport.selectedProjectId);
                const all = proj?.canvases || [];
                const selectedIds = (state.pdfExport.selectedCanvasIds || []).map(String);
                selectedIds.forEach(id => {
                    const obj = all.find(c => String(c.id) === id);
                    const cnv = captureProjectCanvasToCanvas(obj);
                    if (cnv) {
                        const url = cnv.toDataURL('image/jpeg', 0.6);
                        const div = document.createElement('div');
                        div.className = 'bg-gray-900 border border-gray-700 rounded p-1 flex flex-col items-center';
                        const img = document.createElement('img');
                        img.src = url;
                        img.className = 'w-full h-24 object-contain rounded';
                        const name = document.createElement('div');
                        name.className = 'mt-1 text-xs text-gray-300 truncate w-full text-center';
                        name.textContent = obj?.name || ('Canvas ' + id);
                        div.appendChild(img); div.appendChild(name);
                        wrap.appendChild(div);
                    }
                });
            };
            if (canvasSel) canvasSel.addEventListener('change', (e) => {
                const opts = Array.from(e.target.selectedOptions || []);
                state.pdfExport.selectedCanvasIds = opts.map(o => o.value);
                renderCanvasThumbs();
                schedulePdfLivePreview();
            });
            // Initial thumbs render
            renderCanvasThumbs();
            const titleChk = document.getElementById('pdf-include-title-page');
            if (titleChk) titleChk.addEventListener('change', (e) => { state.pdfExport.includeTitlePage = !!e.target.checked; schedulePdfLivePreview(); });
            const includePitchEl = document.getElementById('pdf-include-pitch');
            if (includePitchEl) includePitchEl.addEventListener('change', (e) => { state.pdfExport.includePitchInDetails = !!e.target.checked; schedulePdfLivePreview(); });
            const include3dEl = document.getElementById('pdf-include-3d');
            if (include3dEl) include3dEl.addEventListener('change', (e) => { state.pdfExport.include3dView = !!e.target.checked; schedulePdfLivePreview(); });
            const rasterDpiEl = document.getElementById('pdf-raster-dpi');
            if (rasterDpiEl) rasterDpiEl.addEventListener('input', (e) => { state.pdfExport.rasterizeDpi = Math.max(0, Math.round(Number(e.target.value)||0)); schedulePdfLivePreview(); });
            const rasterQualEl = document.getElementById('pdf-raster-quality');
            if (rasterQualEl) rasterQualEl.addEventListener('input', (e) => { let v = Number(e.target.value); if (!isFinite(v)) v = 0.6; v = Math.min(0.9, Math.max(0.3, v)); state.pdfExport.rasterizeJpegQuality = v; schedulePdfLivePreview(); });
            const coverIn = document.getElementById('cover-upload');
            if (coverIn) coverIn.addEventListener('change', (e) => {
                const f = e.target.files && e.target.files[0]; if (!f) return;
                const reader = new FileReader();
                reader.onload = (ev) => {
                    const url = ev.target.result;
                    const img = new Image();
                    img.onload = () => { state.pdfExport.coverImage = img; state.pdfExport.coverImageSrc = url; renderPdfExport(); };
                    img.src = url;
                };
                reader.readAsDataURL(f);
            });
            const closePrev = document.getElementById('pdf-preview-close'); if (closePrev) closePrev.addEventListener('click', () => {
                const panel = document.getElementById('pdf-preview-panel');
                if (panel) panel.classList.add('hidden');
                state.pdfExport.previewPanelOpen = false;
            });
            const refreshPrev = document.getElementById('pdf-refresh-preview');
            if (refreshPrev) refreshPrev.addEventListener('click', () => {
                state.pdfExport.previewPanelOpen = true;
                generatePdf('preview');
            });
            // Delivery spec now shows a single summary panel with optional Edit form



            // Delivery spec bindings
            const bindDeliveryInput = (id, key, isCheckbox = false) => {
                const el = document.getElementById(id);
                if (!el) return;
                const setState = (val) => { state.pdfExport.deliverySpec[key] = val; };
                el.addEventListener(isCheckbox ? 'change' : 'input', (e) => setState(isCheckbox ? e.target.checked : e.target.value));
            };
            bindDeliveryInput('delivery-media-server', 'mediaServer');
            // special handling for media server select + custom input
            const mediaSelect = document.getElementById('delivery-media-server');
            const mediaCustom = document.getElementById('delivery-media-server-custom');
            if (mediaSelect) {
                mediaSelect.addEventListener('change', (e) => {
                    const val = e.target.value;
                    state.pdfExport.deliverySpec.mediaServer = val;
                    if (val === 'Custom') {
                        mediaCustom.classList.remove('hidden');
                    } else {
                        mediaCustom.classList.add('hidden');
                    }
                    // Apply presets for known media servers
                    applyDeliveryPreset(val);
                    // refresh summary (renderPdfExport defines refreshDeliverySummary later; calling here at runtime after render will work)
                    if (typeof refreshDeliverySummary === 'function') {
                        try { refreshDeliverySummary(); } catch(e) { /* no-op if not yet defined */ }
                    }
                    try { schedulePdfLivePreview(); } catch(_){}
                });
            }
            if (mediaCustom) {
                mediaCustom.addEventListener('input', (e) => {
                    state.pdfExport.deliverySpec.mediaServerCustom = e.target.value;
                });
            }

            // Preset application for known media servers
            const deliveryPresets = {
                'Resolume': {
                    mediaServer: 'Resolume',
                    format: 'QUICKTIME',
                    codecs: ['DXV3'],
                    codecsCustom: '',
                    codecsLink: 'https://resolume.com/download/file?file=Resolume_DXV_Codec_3_0_1_Installer.exe',
                    codecsLink2: '',
                    quality: '100%',
                    pixelAspectRatio: 'Square Pixels (1:1)',
                    fps: '25',
                    embeddedAudio: true,
                    embeddedAudioDetails: 'Stereo, Uncompressed, 16 Bit',
                    sampleRate: '48000 Hz',
                    unembeddedAudioFormat: 'Wav',
                    stillFrameFormat: 'PNG',
                    namingStructure: '"Bank Number"_"delivery"_"screen Name"_"resolution"_"version".Mov',
                    example: '001_intro-video_center-screen_1920x1080_v001.Mov',
                    comments: 'Media Servers Rely On File Names To Understand And Manage Updates On The Content. Please Make Sure The File Name Is Consistent And Use The Version Tag At The End Of The File.'
                },
                'Playback Pro': {
                    mediaServer: 'Playback Pro',
                    format: 'QUICKTIME',
                    codecs: ['.MOV', 'H.264'],
                    codecsCustom: '',
                    quality: '100%',
                    pixelAspectRatio: 'Square Pixels (1:1)',
                    fps: '25',
                    embeddedAudio: true,
                    embeddedAudioDetails: 'Stereo, Uncompressed, 16 Bit',
                    sampleRate: '48000 Hz',
                    unembeddedAudioFormat: 'Wav',
                    stillFrameFormat: 'PNG',
                    namingStructure: '"Bank Number"_"delivery"_"screen Name"_"resolution"_"version".Mov',
                    example: '001_intro-video_center-screen_1920x1080_v001.Mov',
                    comments: 'Media Servers Rely On File Names To Understand And Manage Updates On The Content. Please Make Sure The File Name Is Consistent And Use The Version Tag At The End Of The File.'
                },
                'Dataton Watchout 6': {
                    mediaServer: 'Dataton Watchout 6',
                    format: 'QUICKTIME',
                    codecs: ['HAP'],
                    codecsCustom: '',
                    codecsLink: 'https://github.com/Vidvox/hap-qt-codec',
                    codecsLink2: '',
                    quality: '100%',
                    pixelAspectRatio: 'Square Pixels (1:1)',
                    fps: '25',
                    embeddedAudio: true,
                    embeddedAudioDetails: 'Stereo, Uncompressed, 16 Bit',
                    sampleRate: '48000 Hz',
                    unembeddedAudioFormat: 'Wav',
                    stillFrameFormat: 'PNG',
                    namingStructure: '"Bank Number"_"delivery"_"screen Name"_"resolution"_"version".Mov',
                    comments: 'Media Servers Rely On File Names To Understand And Manage Updates On The Content. Please Make Sure The File Name Is Consistent And Use The Version Tag At The End Of The File.'
                },
                'Dataton Watchout 7': {
                    mediaServer: 'Dataton Watchout 7',
                    format: 'QUICKTIME',
                    codecs: ['HAP','NOTCHLC'],
                    codecsCustom: '',
                    codecsLink: 'https://github.com/Vidvox/hap-qt-codec',
                    codecsLink2: 'https://notch.net/academy/NotchLC_download',
                    quality: '100%',
                    pixelAspectRatio: 'Square Pixels (1:1)',
                    fps: '25',
                    embeddedAudio: true,
                    embeddedAudioDetails: 'Stereo, Uncompressed, 16 Bit',
                    sampleRate: '48000 Hz',
                    unembeddedAudioFormat: 'Wav',
                    stillFrameFormat: 'PNG',
                    namingStructure: '"Bank Number"_"delivery"_"screen Name"_"resolution"_"version".Mov',
                    comments: 'Media Servers Rely On File Names To Understand And Manage Updates On The Content. Please Make Sure The File Name Is Consistent And Use The Version Tag At The End Of The File.'
                },
                'Disguise d3': {
                    mediaServer: 'Disguise d3',
                    format: 'QUICKTIME',
                    codecs: ['HAP','NOTCHLC'],
                    codecsCustom: '',
                    codecsLink: 'https://github.com/Vidvox/hap-qt-codec',
                    codecsLink2: 'https://notch.net/academy/NotchLC_download',
                    quality: '100%',
                    pixelAspectRatio: 'Square Pixels (1:1)',
                    fps: '25',
                    embeddedAudio: true,
                    embeddedAudioDetails: 'Stereo, Uncompressed, 16 Bit',
                    sampleRate: '48000 Hz',
                    unembeddedAudioFormat: 'Wav',
                    stillFrameFormat: 'PNG',
                    namingStructure: '"Bank Number"_"delivery"_"screen Name"_"resolution"_"version".Mov',
                    comments: 'Media Servers Rely On File Names To Understand And Manage Updates On The Content. Please Make Sure The File Name Is Consistent And Use The Version Tag At The End Of The File.'
                },
                'Green Hippo': {
                    mediaServer: 'Green Hippo',
                    format: 'QUICKTIME',
                    codecs: ['HAP','HAP Q','NOTCHLC'],
                    codecsCustom: '',
                    codecsLink: 'https://github.com/Vidvox/hap-qt-codec',
                    codecsLink2: 'https://notch.net/academy/NotchLC_download',
                    quality: 'High',
                    pixelAspectRatio: 'Square Pixels (1:1)',
                    fps: '25',
                    embeddedAudio: false,
                    embeddedAudioDetails: '',
                    sampleRate: '48000 Hz',
                    unembeddedAudioFormat: 'Wav',
                    stillFrameFormat: 'PNG',
                    namingStructure: '"Layer"_"resolution"_"version".mov',
                    example: 'layer-01_1920x1080_v001.mov',
                    comments: 'Hippotizer works best with HAP or NotchLC for GPU-accelerated playback. Deliver audio separately as WAV.'
                },
                'Pixera': {
                    mediaServer: 'Pixera',
                    format: 'QUICKTIME',
                    codecs: ['HAP','HAP Q'],
                    codecsCustom: '',
                    codecsLink: 'https://github.com/Vidvox/hap-qt-codec',
                    codecsLink2: 'https://pixera.one/',
                    quality: 'High',
                    pixelAspectRatio: 'Square Pixels (1:1)',
                    fps: '25',
                    embeddedAudio: true,
                    embeddedAudioDetails: 'Stereo, 24 Bit PCM',
                    sampleRate: '48000 Hz',
                    unembeddedAudioFormat: 'Wav',
                    stillFrameFormat: 'PNG',
                    namingStructure: '"SceneName"_"resolution"_"version".mov',
                    example: 'scene-01_1920x1080_v001.mov',
                    comments: 'Pixera supports HAP for GPU-optimised playback. Use consistent naming aligned with your Pixera timeline and resource library.'
                }
            };

            const applyDeliveryPreset = (name) => {
                const preset = deliveryPresets[name];
                if (!preset) return;
                const spec = state.pdfExport.deliverySpec;
                Object.assign(spec, preset);
                // Ensure link fields adhere strictly to the preset: clear missing ones
                if (!('codecsLink' in preset)) spec.codecsLink = '';
                if (!('codecsLink2' in preset)) spec.codecsLink2 = '';

                // Update UI fields if present
                const setIf = (id, value) => { const el = document.getElementById(id); if (el) el.value = value; };
                setIf('delivery-media-server', spec.mediaServer);
                setIf('delivery-codecs-link', spec.codecsLink);
                setIf('delivery-codecs-link-2', spec.codecsLink2 || '');
                setIf('delivery-quality', spec.quality);
                setIf('delivery-par', spec.pixelAspectRatio);
                setIf('delivery-fps', spec.fps);
                setIf('delivery-sample-rate', spec.sampleRate);
                setIf('delivery-unembedded-format', spec.unembeddedAudioFormat);
                setIf('delivery-still-format', spec.stillFrameFormat);
                setIf('delivery-naming', spec.namingStructure);
                setIf('delivery-codecs-custom', spec.codecsCustom || '');
                setIf('delivery-media-server-custom', spec.mediaServerCustom || '');
                setIf('delivery-codecs', '');
                // update multi-select codecs
                const codecsSelect = document.getElementById('delivery-codecs');
                if (codecsSelect && Array.isArray(spec.codecs)) {
                    Array.from(codecsSelect.options).forEach(opt => {
                        opt.selected = spec.codecs.includes(opt.value);
                    });
                }
                // update embedded audio checkbox
                const emb = document.getElementById('delivery-embedded-audio');
                if (emb) emb.checked = !!spec.embeddedAudio;

                // show/hide custom fields as needed
                const codecsCustomEl = document.getElementById('delivery-codecs-custom');
                if (codecsCustomEl) codecsCustomEl.classList.toggle('hidden', !(spec.codecs && spec.codecs.includes('Other')));
                const mediaCustomEl = document.getElementById('delivery-media-server-custom');
                if (mediaCustomEl) mediaCustomEl.classList.toggle('hidden', spec.mediaServer !== 'Custom');
            };
            // codecs multi-select + custom
            const codecsSelect = document.getElementById('delivery-codecs');
            const codecsCustom = document.getElementById('delivery-codecs-custom');
            if (codecsSelect) {
                const updateCodecsState = () => {
                    const selected = Array.from(codecsSelect.selectedOptions).map(o => o.value);
                    state.pdfExport.deliverySpec.codecs = selected;
                    if (selected.includes('Other')) {
                        codecsCustom.classList.remove('hidden');
                    } else {
                        codecsCustom.classList.add('hidden');
                    }
                };
                codecsSelect.addEventListener('change', updateCodecsState);
                // initialize
                updateCodecsState();
            }
            if (codecsCustom) {
                codecsCustom.addEventListener('input', (e) => {
                    state.pdfExport.deliverySpec.codecsCustom = e.target.value;
                });
            }
            bindDeliveryInput('delivery-codecs-link', 'codecsLink');
            bindDeliveryInput('delivery-codecs-link-2', 'codecsLink2');
            bindDeliveryInput('delivery-quality', 'quality');
            bindDeliveryInput('delivery-par', 'pixelAspectRatio');
            bindDeliveryInput('delivery-embedded-audio', 'embeddedAudio', true);
            bindDeliveryInput('delivery-sample-rate', 'sampleRate');
            bindDeliveryInput('delivery-unembedded-format', 'unembeddedAudioFormat');
            bindDeliveryInput('delivery-still-format', 'stillFrameFormat');
            bindDeliveryInput('delivery-naming', 'namingStructure');
            bindDeliveryInput('delivery-quality', 'quality');
            bindDeliveryInput('delivery-fps', 'fps');
            document.getElementById('pdf-title-input').addEventListener('input', (e) => { state.pdfExport.pdfTitle = e.target.value; schedulePdfLivePreview(); });
            document.querySelectorAll('.pdf-setting-input').forEach(input => {
                input.addEventListener('input', handlePdfSettingsChange);
            });
            // Auto-fit checkbox binding
            const autoFitChk = document.getElementById('pdf-auto-fit');
            if (autoFitChk) {
                autoFitChk.checked = !!state.pdfExport.autoFitPlacement;
                autoFitChk.addEventListener('change', (e) => {
                    state.pdfExport.autoFitPlacement = !!e.target.checked;
                    try { localStorage.setItem('pdfAutoFit', JSON.stringify(state.pdfExport.autoFitPlacement)); } catch (err) { /* ignore */ }
                    const controls = document.getElementById('pdf-placement-controls');
                    if (controls) controls.classList.toggle('hidden', state.pdfExport.autoFitPlacement);
                    const scaleWrap = document.getElementById('pdf-scale-wrapper');
                    if (scaleWrap) scaleWrap.classList.toggle('hidden', !state.pdfExport.autoFitPlacement);
                    updatePdfPreviewOverlay();
                    // re-render the PDF export panel to fully sync UI
                    renderPdfExport();
                });
            }
            const scaleInput = document.getElementById('pdf-map-scale');
            if (scaleInput) {
                scaleInput.addEventListener('input', (e) => {
                    const v = parseInt(e.target.value, 10) || 100;
                    state.pdfExport.mapScale = Math.min(200, Math.max(10, v));
                    const lbl = document.getElementById('pdf-scale-label'); if (lbl) lbl.textContent = `Scale (${state.pdfExport.mapScale}%)`;
                    updatePdfPreviewOverlay();
                });
            }
            // Offset inputs (only relevant for auto-fit mode)
            const offsetX = document.getElementById('pdf-offset-x');
            const offsetY = document.getElementById('pdf-offset-y');
            const clamp = (val, min, max) => Math.min(max, Math.max(min, val));
            if (offsetX) {
                offsetX.addEventListener('input', (e) => {
                    const v = clamp(parseInt(e.target.value, 10) || 0, -50, 50);
                    if (!state.pdfExport.mapOffset) state.pdfExport.mapOffset = { x: 0, y: 0 };
                    state.pdfExport.mapOffset.x = v;
                    const lbl = document.getElementById('pdf-offset-x-label'); if (lbl) lbl.textContent = `Offset X (${v}%)`;
                    updatePdfPreviewOverlay();
                });
            }
            if (offsetY) {
                offsetY.addEventListener('input', (e) => {
                    const v = clamp(parseInt(e.target.value, 10) || 0, -50, 50);
                    if (!state.pdfExport.mapOffset) state.pdfExport.mapOffset = { x: 0, y: 0 };
                    state.pdfExport.mapOffset.y = v;
                    const lbl = document.getElementById('pdf-offset-y-label'); if (lbl) lbl.textContent = `Offset Y (${v}%)`;
                    updatePdfPreviewOverlay();
                });
            }
            document.querySelectorAll('.pdf-map-name-input').forEach(input => {
                input.addEventListener('input', (e) => { handlePdfMapNameChange(e); schedulePdfLivePreview(); });
            });
            // Bind per-map reference image uploads
            document.querySelectorAll('.pdf-ref-upload').forEach(input => {
                input.addEventListener('change', (e) => {
                    const file = e.target.files && e.target.files[0];
                    if (!file) return;
                    const mapId = e.target.dataset.mapId;
                    const proj = state.projects.find(p => p.id == state.pdfExport.selectedProjectId);
                    if (!proj || !Array.isArray(proj.pixelMaps)) return;
                    const map = proj.pixelMaps.find(m => String(m.id) === String(mapId));
                    if (!map) return;
                    const reader = new FileReader();
                    reader.onload = (ev) => {
                        const src = ev.target && ev.target.result;
                        if (!src) return;
                        map.pdfRefImageSrc = src;
                        try { saveState(); } catch(_) {}
                        const img = new Image();
                        img.onload = () => {
                            map.__pdfRefImage = img;
                            renderPdfExport();
                            schedulePdfLivePreview();
                        };
                        img.src = src;
                    };
                    reader.readAsDataURL(file);
                });
            });
            document.querySelectorAll('.pdf-ref-clear').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const mapId = e.currentTarget.dataset.mapId;
                    const proj = state.projects.find(p => p.id == state.pdfExport.selectedProjectId);
                    if (!proj || !Array.isArray(proj.pixelMaps)) return;
                    const map = proj.pixelMaps.find(m => String(m.id) === String(mapId));
                    if (!map) return;
                    delete map.pdfRefImageSrc;
                    delete map.__pdfRefImage;
                    try { saveState(); } catch(_) {}
                    renderPdfExport();
                    schedulePdfLivePreview();
                });
            });

            // ── Manual pairing listeners ──────────────────────────────────────────
            const savePairsFromDOM = (doRerender) => {
                const rows = document.querySelectorAll('.pdf-pair-row');
                const pairs = [];
                rows.forEach((row) => {
                    const idx = row.dataset.pairIdx;
                    const sel1 = document.querySelector(`.pdf-pair-sel1[data-pair-idx="${idx}"]`);
                    const sel2 = document.querySelector(`.pdf-pair-sel2[data-pair-idx="${idx}"]`);
                    const id1 = sel1 ? sel1.value : '';
                    const id2 = sel2 ? sel2.value : '';
                    if (id1 && id2 && id1 !== id2) pairs.push({ id1, id2 });
                });
                state.pdfExport.mapPairs = pairs;
                try { saveState(); } catch(_) {}
                schedulePdfLivePreview();
                if (doRerender) renderPdfExport();
            };
            document.querySelectorAll('.pdf-pair-sel1, .pdf-pair-sel2').forEach(sel => {
                sel.addEventListener('change', (e) => {
                    const idx = e.target.dataset.pairIdx;
                    const sel1 = document.querySelector(`.pdf-pair-sel1[data-pair-idx="${idx}"]`);
                    const sel2 = document.querySelector(`.pdf-pair-sel2[data-pair-idx="${idx}"]`);
                    const bothFilled = sel1 && sel2 && sel1.value && sel2.value && sel1.value !== sel2.value;
                    // Only re-render when the pair is fully defined (avoids resetting partial selection)
                    savePairsFromDOM(!!bothFilled);
                });
            });
            document.querySelectorAll('.pdf-pair-remove').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const idx = Number(e.currentTarget.dataset.pairIdx);
                    const pairs = Array.isArray(state.pdfExport.mapPairs) ? state.pdfExport.mapPairs : [];
                    pairs.splice(idx, 1);
                    state.pdfExport.mapPairs = pairs;
                    try { saveState(); } catch(_) {}
                    schedulePdfLivePreview();
                    renderPdfExport();
                });
            });
            // ──────────────────────────────────────────────────────────────────────

            // Bind Template Areas inputs
            const bindAreaInputs = (prefix, targetObjKey, storageKey) => {
                const getEl = (id) => document.getElementById(id);
                const obj = state.pdfExport[targetObjKey];
                const apply = () => {
                    // Clamp sane values
                    const clamp = (v, min, max) => Math.max(min, Math.min(max, Number(v)));
                    const nx = clamp(getEl(`${prefix}-x`).value, 0, 100);
                    const ny = clamp(getEl(`${prefix}-y`).value, 0, 100);
                    const nw = clamp(getEl(`${prefix}-width`).value, 1, 100);
                    const nh = clamp(getEl(`${prefix}-height`).value, 1, 100);
                    obj.x = nx; obj.y = ny; obj.width = nw; obj.height = nh;
                    try { localStorage.setItem(storageKey, JSON.stringify(obj)); } catch (e) {}
                    updatePdfPreviewOverlay();
                    schedulePdfLivePreview();
                };
                ['x','y','width','height'].forEach(k => {
                    const el = getEl(`${prefix}-${k}`);
                    if (el) el.addEventListener('input', apply);
                });
            };
            bindAreaInputs('map-area', 'templateArea', 'pdfTemplateArea');
            bindAreaInputs('title-area', 'titleArea', 'pdfTitleArea');
            bindAreaInputs('details-area', 'detailsArea', 'pdfDetailsArea');
            bindAreaInputs('title-block-area', 'titleBlockArea', 'pdfTitleBlockArea');

            // Interactive drag/resize for template areas (stable percent-based deltas)
            const setupTemplateAreaEditor = () => {
                const container = document.getElementById('template-preview-container');
                const imgEl = document.getElementById('template-preview');
                if (!container || !imgEl) return;

                const setAreasDirty = (dirty) => {
                    state.pdfExport._areasDirty = !!dirty;
                    const d = document.getElementById('areas-dirty-status');
                    if (d) d.classList.toggle('hidden', !dirty);
                };

                const getImageRect = () => {
                    const containerW = container.clientWidth;
                    const containerH = container.clientHeight;
                    const nW = imgEl.naturalWidth || containerW;
                    const nH = imgEl.naturalHeight || containerH;
                    const scale = Math.min(containerW / nW, containerH / nH);
                    const dispW = nW * scale;
                    const dispH = nH * scale;
                    const offsetX = (containerW - dispW) / 2;
                    const offsetY = (containerH - dispH) / 2;
                    return { dispW, dispH, offsetX, offsetY };
                };

                const MIN_PCT = 1; // 1% min to avoid disappearing
                const round1 = (v) => Math.round(v * 10) / 10;
                const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));

                const areas = [
                    { key: 'templateArea', elId: 'pdf-map-area-outline', storage: 'pdfTemplateArea' },
                    { key: 'titleArea', elId: 'pdf-title-area-preview', storage: 'pdfTitleArea' },
                    { key: 'detailsArea', elId: 'pdf-details-area-preview', storage: 'pdfDetailsArea' },
                    { key: 'titleBlockArea', elId: 'pdf-title-block-area-preview', storage: 'pdfTitleBlockArea' },
                    { key: 'refImageArea', elId: 'pdf-ref-area-preview', storage: 'pdfRefImageArea' },
                ];

                const ensureHandles = (box) => {
                    if (!box || box.querySelector('.ta-handle')) return;
                    const mk = (dir, extra) => {
                        const h = document.createElement('div');
                        h.className = `ta-handle absolute w-2 h-2 bg-white border border-gray-700 rounded-full ${extra}`;
                        h.dataset.dir = dir;
                        h.style.zIndex = '20';
                        h.style.userSelect = 'none';
                        box.appendChild(h);
                    };
                    mk('nw','top-0 left-0 -translate-x-1 -translate-y-1 cursor-nwse-resize');
                    mk('ne','top-0 right-0 translate-x-1 -translate-y-1 cursor-nesw-resize');
                    mk('sw','bottom-0 left-0 -translate-x-1 translate-y-1 cursor-nesw-resize');
                    mk('se','bottom-0 right-0 translate-x-1 translate-y-1 cursor-nwse-resize');
                };

                const attach = ({ key, elId, storage }) => {
                    const box = document.getElementById(elId);
                    if (!box) return;
                    ensureHandles(box);

                    let dragging = false;
                    let resizing = false;
                    let dir = null;
                    let startMouse = { x: 0, y: 0 };
                    let startPct = { x: 0, y: 0, w: 0, h: 0 };
                    let imgRect = null;

                    const toPctDelta = (dx, dy) => ({
                        dxp: (dx / imgRect.dispW) * 100,
                        dyp: (dy / imgRect.dispH) * 100,
                    });

                    const applyState = (nx, ny, nw, nh) => {
                        const area = state.pdfExport[key];
                        area.x = round1(clamp(nx, 0, 100 - nw));
                        area.y = round1(clamp(ny, 0, 100 - nh));
                        area.width = round1(clamp(nw, MIN_PCT, 100 - area.x));
                        area.height = round1(clamp(nh, MIN_PCT, 100 - area.y));
                        updatePdfPreviewOverlay();
                        schedulePdfLivePreview();
                    };

                    const onMove = (e) => {
                        if (!dragging && !resizing) return;
                        e.preventDefault();
                        const dx = e.clientX - startMouse.x;
                        const dy = e.clientY - startMouse.y;
                        const { dxp, dyp } = toPctDelta(dx, dy);
                        if (dragging) {
                            let nx = startPct.x + dxp;
                            let ny = startPct.y + dyp;
                            applyState(nx, ny, startPct.w, startPct.h);
                        } else if (resizing) {
                            let nx = startPct.x;
                            let ny = startPct.y;
                            let nw = startPct.w;
                            let nh = startPct.h;
                            if (dir.includes('e')) nw = startPct.w + dxp;
                            if (dir.includes('s')) nh = startPct.h + dyp;
                            if (dir.includes('w')) { nw = startPct.w - dxp; nx = startPct.x + dxp; }
                            if (dir.includes('n')) { nh = startPct.h - dyp; ny = startPct.y + dyp; }
                            const keepAspect = e.shiftKey && startPct.w > 0 && startPct.h > 0;
                            if (keepAspect) {
                                const aspect = startPct.w / startPct.h;
                                if (dir === 'ne' || dir === 'se') nh = nw / aspect;
                                if (dir === 'nw' || dir === 'sw') nh = nw / aspect;
                            }
                            // Clamp min sizes
                            nw = Math.max(MIN_PCT, nw);
                            nh = Math.max(MIN_PCT, nh);
                            applyState(nx, ny, nw, nh);
                        }
                    };

                    const onUp = () => {
                        dragging = false; resizing = false; dir = null;
                        document.removeEventListener('mousemove', onMove);
                        document.removeEventListener('mouseup', onUp);
                        // mark as unsaved until user clicks Save
                        setAreasDirty(true);
                    };

                    box.addEventListener('mousedown', (e) => {
                        if (e.target && e.target.classList && e.target.classList.contains('ta-handle')) return; // handle has its own flow
                        e.preventDefault();
                        imgRect = getImageRect();
                        const a = state.pdfExport[key];
                        startPct = { x: a.x, y: a.y, w: a.width, h: a.height };
                        startMouse = { x: e.clientX, y: e.clientY };
                        dragging = true; resizing = false; dir = null;
                        document.addEventListener('mousemove', onMove);
                        document.addEventListener('mouseup', onUp);
                    });

                    box.querySelectorAll('.ta-handle').forEach(h => {
                        h.addEventListener('mousedown', (e) => {
                            e.stopPropagation();
                            e.preventDefault();
                            imgRect = getImageRect();
                            const a = state.pdfExport[key];
                            startPct = { x: a.x, y: a.y, w: a.width, h: a.height };
                            startMouse = { x: e.clientX, y: e.clientY };
                            dragging = false; resizing = true; dir = h.dataset.dir || 'se';
                            document.addEventListener('mousemove', onMove);
                            document.addEventListener('mouseup', onUp);
                        });
                    });
                };

                areas.forEach(attach);
            };
            // Initialize interactions after preview is laid out
            setupTemplateAreaEditor();

            // Preset buttons
            const setPreset = (key, val) => { Object.assign(state.pdfExport[key], val); renderPdfExport(); const d = document.getElementById('areas-dirty-status'); if (d) d.classList.remove('hidden'); state.pdfExport._areasDirty = true; };
            const pMap = document.getElementById('preset-map-left'); if (pMap) pMap.addEventListener('click', () => setPreset('templateArea', { x: 6, y: 14, width: 70, height: 58 }));
            const pTitle = document.getElementById('preset-title-top'); if (pTitle) pTitle.addEventListener('click', () => setPreset('titleArea', { x: 20, y: 5, width: 50, height: 8 }));
            const pDet = document.getElementById('preset-details-bottom'); if (pDet) pDet.addEventListener('click', () => setPreset('detailsArea', { x: 4, y: 80, width: 52, height: 16 }));
            const pTB = document.getElementById('preset-title-block-right'); if (pTB) pTB.addEventListener('click', () => setPreset('titleBlockArea', { x: 79, y: 18, width: 18, height: 76 }));
            const pSS = document.getElementById('preset-screenshot-defaults'); if (pSS) pSS.addEventListener('click', () => {
                setPreset('templateArea', { x: 3.8, y: 16, width: 81, height: 58 });
                setPreset('titleArea', { x: 21, y: 3.3, width: 50, height: 8 });
                setPreset('detailsArea', { x: 2, y: 81, width: 38, height: 16 });
                setPreset('titleBlockArea', { x: 87, y: 74, width: 11.2, height: 23 });
                setPreset('refImageArea', { x: 44, y: 81, width: 30, height: 16 });
            });
            // Save/Clear area definitions
            const showSaved = () => {
                const s = document.getElementById('save-areas-status');
                if (!s) return;
                s.classList.remove('hidden');
                setTimeout(() => s.classList.add('hidden'), 1400);
            };
            const btnSaveAreas = document.getElementById('save-areas');
            if (btnSaveAreas) btnSaveAreas.addEventListener('click', () => {
                try {
                    localStorage.setItem('pdfTemplateArea', JSON.stringify(state.pdfExport.templateArea));
                    localStorage.setItem('pdfTitleArea', JSON.stringify(state.pdfExport.titleArea));
                    localStorage.setItem('pdfDetailsArea', JSON.stringify(state.pdfExport.detailsArea));
                    localStorage.setItem('pdfTitleBlockArea', JSON.stringify(state.pdfExport.titleBlockArea));
                    localStorage.setItem('pdfRefImageArea', JSON.stringify(state.pdfExport.refImageArea));
                    // Persist current template preview scale to keep sizing stable on refresh
                    const container = document.getElementById('template-preview-container');
                    const imgEl = document.getElementById('template-preview');
                    if (container && imgEl && imgEl.naturalWidth && imgEl.naturalHeight) {
                        const containerW = container.clientWidth;
                        const containerH = container.clientHeight;
                        const s = Math.min(containerW / imgEl.naturalWidth, containerH / imgEl.naturalHeight);
                        if (isFinite(s) && s > 0) localStorage.setItem('pdfTemplateScale', String(s));
                    }
                } catch (_) {}
                // clear dirty; show saved
                state.pdfExport._areasDirty = false;
                const d = document.getElementById('areas-dirty-status'); if (d) d.classList.add('hidden');
                showSaved();
            });
            const btnClearAreas = document.getElementById('clear-saved-areas');
            if (btnClearAreas) btnClearAreas.addEventListener('click', () => {
                try {
                    localStorage.removeItem('pdfTemplateArea');
                    localStorage.removeItem('pdfTitleArea');
                    localStorage.removeItem('pdfDetailsArea');
                    localStorage.removeItem('pdfTitleBlockArea');
                    localStorage.removeItem('pdfRefImageArea');
                } catch (_) {}
                renderPdfExport();
            });
            // Ensure overlay updates after the image actually loads (naturalWidth/Height known)
            const previewImg = document.getElementById('template-preview');
            if (previewImg) {
                if (previewImg.complete) {
                    // Apply saved scale if present
                    try {
                        const savedScaleStr = localStorage.getItem('pdfTemplateScale');
                        const savedScale = savedScaleStr ? parseFloat(savedScaleStr) : null;
                        const container = document.getElementById('template-preview-container');
                        if (container && previewImg.naturalHeight && savedScale && savedScale > 0) {
                            container.style.height = Math.max(120, Math.round(previewImg.naturalHeight * savedScale)) + 'px';
                        }
                    } catch(_) {}
                    updatePdfPreviewOverlay();
                } else {
                    previewImg.addEventListener('load', () => {
                        try {
                            const savedScaleStr = localStorage.getItem('pdfTemplateScale');
                            const savedScale = savedScaleStr ? parseFloat(savedScaleStr) : null;
                            const container = document.getElementById('template-preview-container');
                            if (container && previewImg.naturalHeight && savedScale && savedScale > 0) {
                                container.style.height = Math.max(120, Math.round(previewImg.naturalHeight * savedScale)) + 'px';
                            }
                        } catch(_) {}
                        updatePdfPreviewOverlay();
                    }, { once: true });
                }
            } else {
                updatePdfPreviewOverlay();
            }
            // Reset fit handler clears saved scale and restores default height
            const btnResetFit = document.getElementById('reset-template-fit');
            if (btnResetFit) btnResetFit.addEventListener('click', () => {
                try { localStorage.removeItem('pdfTemplateScale'); } catch(_) {}
                const container = document.getElementById('template-preview-container');
                if (container) { container.style.height = ''; }
                updatePdfPreviewOverlay();
            });
            // Refresh delivery spec summary UI
            const refreshDeliverySummary = () => {
                const s = state.pdfExport.deliverySpec || {};
                const setText = (id, value) => { const el = document.getElementById(id); if (el) el.textContent = value || 'N/A'; };
                setText('delivery-summary-media', s.mediaServer === 'Custom' ? (s.mediaServerCustom || 'Custom') : (s.mediaServer || 'N/A'));
                setText('delivery-summary-format', s.format || 'N/A');
                const codecsEl = document.getElementById('delivery-summary-codecs'); if (codecsEl) codecsEl.textContent = Array.isArray(s.codecs) ? s.codecs.join(', ') : (s.codecs || 'N/A');
                const linksEl = document.getElementById('delivery-summary-links'); if (linksEl) {
                    linksEl.innerHTML = '';
                    if (s.codecsLink) linksEl.innerHTML += `<div><a href="${s.codecsLink}" class="text-accent underline">${s.codecsLink}</a></div>`;
                    if (s.codecsLink2) linksEl.innerHTML += `<div><a href="${s.codecsLink2}" class="text-accent underline">${s.codecsLink2}</a></div>`;
                }
                setText('delivery-summary-quality', s.quality || 'N/A');
                setText('delivery-summary-par', s.pixelAspectRatio || 'N/A');
                setText('delivery-summary-fps', s.fps || 'N/A');
                setText('delivery-summary-audio', s.embeddedAudio ? (s.embeddedAudioDetails || 'Yes') : 'No');
                setText('delivery-summary-sample-rate', s.sampleRate || 'N/A');
                setText('delivery-summary-unembedded', s.unembeddedAudioFormat || 'N/A');
                setText('delivery-summary-still', s.stillFrameFormat || 'N/A');
                setText('delivery-summary-naming', s.namingStructure || 'N/A');
                setText('delivery-summary-example', s.example || '');
                const commentsEl = document.getElementById('delivery-summary-comments'); if (commentsEl) commentsEl.textContent = s.comments || '';
                const noteEl = document.getElementById('delivery-summary-validation-note'); if (noteEl) noteEl.textContent = s.contentValidationNote || '';
                const valEl = document.getElementById('delivery-summary-validation'); if (valEl) valEl.textContent = s.contentValidationEmail || '';
            };

            // Section show/hide toggle
            const deliverySectionToggle = document.getElementById('delivery-section-toggle');
            const deliverySectionBody = document.getElementById('delivery-section-body');
            if (deliverySectionToggle && deliverySectionBody) {
                deliverySectionToggle.addEventListener('click', () => {
                    const isHidden = deliverySectionBody.classList.toggle('hidden');
                    deliverySectionToggle.textContent = isHidden ? 'Show' : 'Hide';
                    if (!isHidden) {
                        const editForm = document.getElementById('delivery-edit-form');
                        const editToggle = document.getElementById('delivery-edit-toggle');
                        if (editForm) editForm.hidden = true;
                        if (editToggle) {
                            editToggle.textContent = 'Edit';
                            editToggle.disabled = false;
                            editToggle.classList.remove('opacity-50', 'cursor-not-allowed');
                            editToggle.dataset.dirty = '0';
                        }
                    }
                });
            }

            // Edit toggle (inside section body)
            const editToggle = document.getElementById('delivery-edit-toggle');
            const editForm = document.getElementById('delivery-edit-form');
            if (editToggle && editForm) {
                const setDirty = (dirty) => {
                    editToggle.dataset.dirty = dirty ? '1' : '0';
                    editToggle.disabled = !dirty;
                    editToggle.classList.toggle('opacity-50', !dirty);
                    editToggle.classList.toggle('cursor-not-allowed', !dirty);
                };

                const markDirty = () => setDirty(true);
                editForm.querySelectorAll('input, select, textarea').forEach(el => {
                    el.addEventListener('input', markDirty);
                    el.addEventListener('change', markDirty);
                });

                editToggle.addEventListener('click', () => {
                    const isHidden = !!editForm.hidden;
                    if (isHidden) {
                        editForm.hidden = false;
                        editToggle.textContent = 'Save';
                        setDirty(false);
                    } else {
                        if (editToggle.disabled) return;
                        // on save, collect values from form inputs to state
                        const collect = (id, key, isCheckbox=false) => { const el = document.getElementById(id); if (!el) return; state.pdfExport.deliverySpec[key] = isCheckbox ? el.checked : el.value; };
                        collect('delivery-media-server', 'mediaServer');
                        collect('delivery-media-server-custom', 'mediaServerCustom');
                        collect('delivery-codecs-link', 'codecsLink');
                        collect('delivery-codecs-link-2', 'codecsLink2');
                        collect('delivery-quality', 'quality');
                        collect('delivery-par', 'pixelAspectRatio');
                        collect('delivery-fps', 'fps');
                        collect('delivery-embedded-audio', 'embeddedAudio', true);
                        collect('delivery-sample-rate', 'sampleRate');
                        collect('delivery-unembedded-format', 'unembeddedAudioFormat');
                        collect('delivery-still-format', 'stillFrameFormat');
                        collect('delivery-naming', 'namingStructure');
                        collect('delivery-include-validation-note', 'showValidationNote', true);
                        const showPanelBgEl = document.getElementById('delivery-show-panel-bg');
                        if (showPanelBgEl) state.pdfExport.deliverySpec.showPanelBackground = !!showPanelBgEl.checked;
                        // hide form
                        editForm.hidden = true;
                        editToggle.textContent = 'Edit';
                        editToggle.disabled = false;
                        editToggle.classList.remove('opacity-50', 'cursor-not-allowed');
                        // re-run apply preset if a preset was chosen to ensure consistent formatting
                        if (state.pdfExport.deliverySpec.mediaServer) applyDeliveryPreset(state.pdfExport.deliverySpec.mediaServer);
                        refreshDeliverySummary();
                        try { schedulePdfLivePreview(); } catch(_){ }
                    }
                });
            }

            // wire existing inputs so changes refresh the summary live
            ['delivery-codecs-link','delivery-codecs-link-2','delivery-quality','delivery-par','delivery-fps','delivery-sample-rate','delivery-unembedded-format','delivery-still-format','delivery-naming'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.addEventListener('input', () => { // small debounce could be added
                    // sync to state (many are already bound via bindDeliveryInput)
                    const keyMap = {
                        'delivery-codecs-link':'codecsLink','delivery-codecs-link-2':'codecsLink2','delivery-quality':'quality','delivery-par':'pixelAspectRatio','delivery-fps':'fps','delivery-sample-rate':'sampleRate','delivery-unembedded-format':'unembeddedAudioFormat','delivery-still-format':'stillFrameFormat','delivery-naming':'namingStructure'
                    };
                    const key = keyMap[id]; if (key) state.pdfExport.deliverySpec[key] = el.value;
                    refreshDeliverySummary();
                    try { schedulePdfLivePreview(); } catch(_){}
                });
            });
            // bind content validation email
            bindDeliveryInput('delivery-content-validation-email', 'contentValidationEmail');
            // bind content validation note
            bindDeliveryInput('delivery-content-validation-note', 'contentValidationNote');
            // bind include validation note flag
            const includeValChk = document.getElementById('delivery-include-validation-note');
            if (includeValChk) includeValChk.addEventListener('change', (e) => { state.pdfExport.deliverySpec.showValidationNote = !!e.target.checked; try { schedulePdfLivePreview(); } catch(_){} });
            // bind show panel background flag
            const showPanelBgChk = document.getElementById('delivery-show-panel-bg');
            if (showPanelBgChk) showPanelBgChk.addEventListener('change', (e) => { state.pdfExport.deliverySpec.showPanelBackground = !!e.target.checked; try { schedulePdfLivePreview(); } catch(_){} });

            // Title Block bindings
            const tbBind = (id, key) => {
                const el = document.getElementById(id);
                if (!el) return;
                const apply = () => {
                    state.pdfExport.titleBlock[key] = el.value;
                    try { localStorage.setItem('pdfTitleBlock', JSON.stringify(state.pdfExport.titleBlock)); } catch(_){}
                    try { schedulePdfLivePreview(); } catch(_){}
                };
                el.addEventListener('input', apply);
            };
            ['projectName','projectDate','venue','sales','client','page','drawnBy','version'].forEach(k => tbBind(`tb-${k}`, k));
            const tbShow = document.getElementById('tb-show');
            if (tbShow) tbShow.addEventListener('change', (e) => {
                state.pdfExport.showTitleBlock = !!e.target.checked;
                try { localStorage.setItem('pdfShowTitleBlock', JSON.stringify(state.pdfExport.showTitleBlock)); } catch(_){}
                // Update live preview if open
                try { schedulePdfLivePreview(); } catch(_){}
            });

            // Title Block style controls
            const tbs = state.pdfExport.titleBlockStyle || {};
            const bindTbs = (id, key, clampFn) => {
                const el = document.getElementById(id);
                if (!el) return;
                const apply = () => {
                    let v = parseInt(el.value, 10);
                    if (Number.isNaN(v)) return;
                    if (typeof clampFn === 'function') v = clampFn(v);
                    state.pdfExport.titleBlockStyle[key] = v;
                    try { localStorage.setItem('pdfTitleBlockStyle', JSON.stringify(state.pdfExport.titleBlockStyle)); } catch(_){}
                    // Update live preview if open
                    try { schedulePdfLivePreview(); } catch(_){}
                };
                el.addEventListener('input', apply);
                el.addEventListener('change', apply);
            };
            bindTbs('tb-label-fs', 'labelBaseFS', (v) => Math.max(5, Math.min(16, v)));
            bindTbs('tb-value-fs', 'valueBaseFS', (v) => Math.max(6, Math.min(18, v)));
            bindTbs('tb-entry-gap', 'entryGap', (v) => Math.max(0, Math.min(10, v)));

            // Global PDF Typography bindings
            const updatePreviewDirtyIndicator = () => {
                const badge = document.getElementById('pdf-preview-dirty');
                if (badge) badge.classList.toggle('hidden', !state.pdfExport.previewDirty);
            };
            const schedulePdfLivePreview = () => {
                state.pdfExport.previewDirty = true;
                updatePreviewDirtyIndicator();
            };

            const persistTextStyle = () => { try { localStorage.setItem('pdfTextStyle', JSON.stringify(state.pdfExport.textStyle || {})); } catch(_){} };            
            const fontSel = document.getElementById('pdf-font-family');
            if (fontSel) {
                fontSel.addEventListener('change', (e) => {
                    state.pdfExport.textStyle = state.pdfExport.textStyle || {};
                    state.pdfExport.textStyle.fontFamily = e.target.value || 'helvetica';
                    persistTextStyle();
                    schedulePdfLivePreview();
                });
            }
            const bannerFsEl = document.getElementById('pdf-banner-fs');
            if (bannerFsEl) {
                const apply = () => {
                    const vRaw = bannerFsEl.value;
                    const v = parseInt(vRaw, 10);
                    state.pdfExport.textStyle = state.pdfExport.textStyle || {};
                    if (Number.isFinite(v) && v > 0) state.pdfExport.textStyle.bannerFS = v; else state.pdfExport.textStyle.bannerFS = '';
                    persistTextStyle();
                };
                bannerFsEl.addEventListener('input', apply);
                bannerFsEl.addEventListener('change', apply);
            }
            const detailsFsEl = document.getElementById('pdf-details-fs');
            if (detailsFsEl) {
                const apply = () => {
                    let v = parseInt(detailsFsEl.value, 10);
                    if (!Number.isFinite(v)) v = 14;
                    v = Math.max(6, Math.min(72, v));
                    state.pdfExport.textStyle = state.pdfExport.textStyle || {};
                    state.pdfExport.textStyle.detailsFS = v;
                    detailsFsEl.value = String(v);
                    persistTextStyle();
                    schedulePdfLivePreview();
                };
                detailsFsEl.addEventListener('input', apply);
                detailsFsEl.addEventListener('change', apply);
            }
            const detailsFitEl = document.getElementById('pdf-details-fit');
            if (detailsFitEl) {
                const apply = () => {
                    state.pdfExport.textStyle = state.pdfExport.textStyle || {};
                    state.pdfExport.textStyle.detailsFitToText = !!detailsFitEl.checked;
                    persistTextStyle();
                    schedulePdfLivePreview();
                };
                detailsFitEl.addEventListener('change', apply);
            }
            const deliveryFsEl = document.getElementById('pdf-delivery-fs');
            if (deliveryFsEl) {
                const apply = () => {
                    let v = parseInt(deliveryFsEl.value, 10);
                    if (!Number.isFinite(v)) v = 12;
                    v = Math.max(8, Math.min(72, v));
                    state.pdfExport.textStyle = state.pdfExport.textStyle || {};
                    state.pdfExport.textStyle.deliveryFS = v;
                    deliveryFsEl.value = String(v);
                    persistTextStyle();
                    schedulePdfLivePreview();
                };
                deliveryFsEl.addEventListener('input', apply);
                deliveryFsEl.addEventListener('change', apply);
            }

            // Banner alignment bindings
            const alignH = document.getElementById('pdf-banner-align-h');
            if (alignH) {
                const apply = () => {
                    const v = (alignH.value || 'center');
                    state.pdfExport.textStyle = state.pdfExport.textStyle || {};
                    state.pdfExport.textStyle.bannerAlignH = ['left','center','right'].includes(v) ? v : 'center';
                    persistTextStyle();
                    schedulePdfLivePreview();
                };
                alignH.addEventListener('change', apply);
            }
            const alignV = document.getElementById('pdf-banner-align-v');
            if (alignV) {
                const apply = () => {
                    const v = (alignV.value || 'middle');
                    state.pdfExport.textStyle = state.pdfExport.textStyle || {};
                    state.pdfExport.textStyle.bannerAlignV = ['top','middle','bottom'].includes(v) ? v : 'middle';
                    persistTextStyle();
                    schedulePdfLivePreview();
                };
                alignV.addEventListener('change', apply);
            }
            const includeMapNameChk = document.getElementById('pdf-banner-include-mapname');
            if (includeMapNameChk) {
                includeMapNameChk.addEventListener('change', (e) => {
                    state.pdfExport.textStyle = state.pdfExport.textStyle || {};
                    state.pdfExport.textStyle.includeMapNameInBanner = !!e.target.checked;
                    persistTextStyle();
                    schedulePdfLivePreview();
                });
            }
            const fitChk = document.getElementById('pdf-banner-fit');
            if (fitChk) {
                fitChk.addEventListener('change', (e) => {
                    state.pdfExport.textStyle = state.pdfExport.textStyle || {};
                    state.pdfExport.textStyle.bannerFitToWidth = !!e.target.checked;
                    persistTextStyle();
                    schedulePdfLivePreview();
                });
            }
            

            // Bind output filename field
            const outNameEl = document.getElementById('pdf-output-filename');
            if (outNameEl) {
                const applyOut = () => { state.pdfExport.outputFileName = outNameEl.value; try { localStorage.setItem('pdfOutputFileName', state.pdfExport.outputFileName); } catch(_){} };
                outNameEl.addEventListener('input', applyOut);
            }

            // UI mode toggle (Simple / Advanced)
            const uiModeToggle = document.getElementById('pdf-ui-mode-toggle');
            if (uiModeToggle) {
                uiModeToggle.addEventListener('click', (e) => {
                    const btn = e.target.closest('button[data-ui-mode]');
                    if (!btn) return;
                    const m = btn.dataset.uiMode;
                    if (isSimpleExperience && m !== 'simple') return;
                    state.pdfExport.uiMode = m;
                    renderPdfExport();
                });
            }

            // Delivery spec preset quick-pick buttons
            const presetsRow = document.getElementById('pdf-delivery-presets-row');
            if (presetsRow) {
                presetsRow.addEventListener('click', (e) => {
                    const btn = e.target.closest('.pdf-ds-preset-btn');
                    if (!btn) return;
                    const key = btn.dataset.preset;
                    if (!key) return;
                    // Ensure delivery section is visible
                    const body = document.getElementById('delivery-section-body');
                    const togBtn = document.getElementById('delivery-section-toggle');
                    if (body) body.classList.remove('hidden');
                    if (togBtn) togBtn.textContent = 'Hide';
                    // Apply the preset data
                    applyDeliveryPreset(key);
                    // Update active highlight
                    presetsRow.querySelectorAll('.pdf-ds-preset-btn').forEach(b => b.classList.toggle('is-active', b.dataset.preset === key));
                    refreshDeliverySummary();
                    try { schedulePdfLivePreview(); } catch(_){}
                });
            }

            // initial refresh
            refreshDeliverySummary();
            updatePreviewDirtyIndicator();

            // PDF optimization bindings removed
        };

        // --- LOGIC & EVENT HANDLERS ---
        const activeTabColors = {
            sheets: {bg: 'bg-emerald-600', glow: 'active-sheets'},
            designer: {bg: 'bg-accent', glow: 'active-pixelmaps'},
            visualizer: {bg: 'bg-teal-600', glow: 'active-visualizer'},
            view3d: {bg: 'bg-cyan-600', glow: 'active-view3d'},
            effects: {bg: 'bg-pink-600', glow: 'active-effects'},
            canvas: {bg: 'bg-yellow-600', glow: 'active-canvas'},
            'led-patching': {bg: 'bg-orange-600', glow: 'active-canvas'},
            pdf: {bg: 'bg-orange-600', glow: 'active-pdf'},
            shows: {bg: 'bg-indigo-600', glow: 'active-shows'},
            'circular-led': {bg: 'bg-green-600', glow: 'active-pixelmaps'},
            'projector-test-pattern': {bg: 'bg-amber-600', glow: 'active-pixelmaps'},
            devices: {bg: 'bg-sky-600', glow: 'active-visualizer'},
            'utility-tools': {bg: 'bg-emerald-600', glow: 'active-effects'},
            'power-calc': {bg: 'bg-yellow-500', glow: 'active-pdf'},
            help: {bg: 'bg-violet-600', glow: 'active-effects'},
            'video-converter': {bg: 'bg-rose-600', glow: 'active-pdf'},
        };

        // Learn more jump targets and highlight system
        const HIGHLIGHT_TARGETS = {
            'designer': {
                'duplicate-map': '#duplicate-pixel-map-btn'
            },
            'effects': {
                'info-toggle': 'input[data-details-field="info.enabled"]',
                'info-font': 'input[data-details-field="info.fontSize"]',
                'coords-toggle': 'input[data-details-field="coords.enabled"]',
                'coords-font': 'input[data-details-field="coords.fontSize"]'
            },
            'canvas': {
                'duplicate-canvas': '#duplicate-canvas-btn'
            },
            'circular-led': {
                'dome-diameter': '#cl-D'
            },
            'pdf': {
                'pdf-live-preview': '#pdf-live-preview'
            },
            'visualizer': {
                'save-png': '#visualizer-save-png-btn'
            }
        };
        let pendingHighlight = null; // { tab, key }
        const applyPendingHighlight = (tabName) => {
            if (!pendingHighlight || pendingHighlight.tab !== tabName) return;
            const key = pendingHighlight.key;
            pendingHighlight = null; // consume
            try {
                const sel = (HIGHLIGHT_TARGETS[tabName] || {})[key];
                if (!sel) return;
                const root = mainContent[tabName];
                const el = root ? root.querySelector(sel) : null;
                if (!el) return;
                el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                try { el.focus({ preventScroll: true }); } catch(_){}
                el.classList.add('auto-highlight');
                setTimeout(() => el.classList.remove('auto-highlight'), 2400);
            } catch(_) { /* best effort */ }
        };

        const switchTab = (tabName) => {
            if (tabName === 'aspect-ratio-calculator' || tabName === 'timecode-generator') {
                tabName = 'utility-tools';
            }
            if (!getAllowedTabsForMode(currentAppMode).includes(tabName)) {
                if (ADVANCED_TABS.has(tabName) && appEdition === APP_EDITIONS.simple) {
                    try { showNotification('Switch to Advanced to use this tool'); } catch (_) {}
                }
                tabName = currentAppMode === APP_MODES.projection ? 'projector-test-pattern' : 'designer';
            }
            // Devices tab disabled in this version; redirect to Designer
            if (tabName === 'devices') {
                try { showNotification('Devices tab is disabled in this version'); } catch(_) {}
                tabName = 'designer';
            }
            if (tabName === 'saved') tabName = 'shows';

            if (tabName !== 'view3d' && view3dRuntime && typeof view3dRuntime.dispose === 'function') {
                try { view3dRuntime.dispose(); } catch (_) {}
                view3dRuntime = null;
            }
            state.activeTab = tabName;
            
            navTabs.forEach(tab => {
                const currentTabName = tab.dataset.tab;
                tab.classList.remove(...Object.values(activeTabColors).map(c => c.bg));
                tab.classList.remove(...Object.values(activeTabColors).map(c => c.glow));
                tab.classList.remove('text-white');
                tab.classList.add('text-gray-300');

                if (currentTabName !== 'designer') {
                    tab.style.backgroundColor = '';
                }

                if (currentTabName === tabName) {
                    const activeColor = activeTabColors[currentTabName];
                    if (currentTabName !== 'designer' && activeColor && activeColor.bg) {
                       tab.classList.add(activeColor.bg);
                    }
                    if (activeColor && activeColor.glow) {
                        tab.classList.add(activeColor.glow);
                    }
                    tab.classList.add('text-white');
                    tab.classList.remove('text-gray-300');
                }
            });

            Object.values(mainContent).forEach(contentEl => contentEl.classList.remove('active'));
            if (mainContent[tabName]) mainContent[tabName].classList.add('active');

            let renderSucceeded = true;
            try {
                switch(tabName) {
                    case 'sheets': renderSheetsTab(); break;
                    case 'designer': renderPixelMapDesigner(); break;
                    case 'visualizer': renderVisualizer(); break;
                    case 'view3d': render3DViewTab(); break;
                    case 'effects': renderEffectsDetails(); break;
                    case 'canvas': renderCanvas(); break;
                    case 'led-patching': renderLedPatchingTab(); break;
                    case 'pdf': renderPdfExport(); break;
                    case 'shows': renderShows(); break;
                    case 'circular-led': renderCircularLed(); break;
                    case 'devices': renderDevicesTab(); break;
                    case 'help': renderHelpTab(); break;
                    case 'utility-tools': renderUtilityToolsTab(); break;
                    case 'power-calc': renderPowerCalcTab(); break;
                    case 'video-converter': renderVideoConverterTab(); break;
                    case 'projector-test-pattern':
                        if (typeof renderProjectorTestPattern === 'function') renderProjectorTestPattern();
                        break;
                }
            } catch (error) {
                renderSucceeded = false;
                console.error(`Failed to render tab: ${tabName}`, error);
                if (tabName === 'view3d' && view3dRuntime && typeof view3dRuntime.dispose === 'function') {
                    try { view3dRuntime.dispose(); } catch (_) {}
                    view3dRuntime = null;
                }
                const failedPanel = mainContent[tabName];
                if (failedPanel) {
                    failedPanel.innerHTML = `
                        <div class="p-6 text-center border border-red-800 bg-red-950/30 rounded-lg">
                            <p class="text-sm font-semibold text-red-200">This view could not be rendered.</p>
                            <button type="button" class="tab-render-retry mt-3 px-3 py-1.5 rounded bg-red-700 hover:bg-red-600 text-sm text-white">Retry</button>
                        </div>`;
                    failedPanel.querySelector('.tab-render-retry')?.addEventListener('click', () => switchTab(tabName));
                }
                try { showNotification('The current view could not render. You can retry it.'); } catch (_) {}
            }

            // Apply any pending highlight after render
            if (renderSucceeded) setTimeout(() => applyPendingHighlight(tabName), 0);
        };

        const renderAiAutoMapTab = () => {
            return;

            const toMeters = (value, unit) => {
                const n = Number(value);
                if (!Number.isFinite(n) || n <= 0) return null;
                const u = String(unit || 'm').toLowerCase();
                const factor = { m: 1, cm: 0.01, mm: 0.001, ft: 0.3048, in: 0.0254 }[u] || 1;
                return n * factor;
            };

            const toMm = (value, unit) => {
                const n = Number(value);
                if (!Number.isFinite(n) || n <= 0) return null;
                const u = String(unit || 'mm').toLowerCase();
                if (u === 'mm') return n;
                if (u === 'cm') return n * 10;
                if (u === 'm') return n * 1000;
                if (u === 'ft') return n * 304.8;
                if (u === 'in') return n * 25.4;
                return n;
            };

            const parsePitchMm = (line, fallback) => {
                const m = String(line || '').match(/(?:\bp\s*|pitch\s*[:=]?\s*)(\d+(?:\.\d+)?)\s*(mm|cm|m)?\b/i)
                    || String(line || '').match(/(\d+(?:\.\d+)?)\s*(mm|cm|m)\s*pitch\b/i);
                if (!m) {
                    const ledM = String(line || '').match(/(?:\bled\b|pixel\s*pitch|module\s*pitch)[^\d]{0,8}(\d+(?:\.\d+)?)(?:\s*mm)?\b/i);
                    if (!ledM) return Number.isFinite(fallback) ? fallback : null;
                    const v = Number(ledM[1]);
                    if (Number.isFinite(v) && v > 0.5 && v < 20) return v;
                    return Number.isFinite(fallback) ? fallback : null;
                }
                const value = Number(m[1]);
                const unit = String(m[2] || 'mm').toLowerCase();
                if (!Number.isFinite(value) || value <= 0) return Number.isFinite(fallback) ? fallback : null;
                if (unit === 'mm') return value;
                if (unit === 'cm') return value * 10;
                if (unit === 'm') {
                    if (value < 20) return value;
                    return value * 1000;
                }
                return value;
            };

            const inferWallName = (line) => {
                const text = String(line || '').toLowerCase();
                if (/\bmain\b|\bcenter\b|\bmiddle\b/.test(text)) return 'Main Wall';
                if (/\bstage\s*left\b|\bhouse\s*left\b|\bleft\s*wing\b/.test(text)) return 'Stage Left Wall';
                if (/\bstage\s*right\b|\bhouse\s*right\b|\bright\s*wing\b/.test(text)) return 'Stage Right Wall';
                if (/\brear\b|\bback\b|\bupstage\b/.test(text)) return 'Rear Wall';
                if (/\bfront\b|\bdownstage\b/.test(text)) return 'Front Wall';
                if (/\bleft\b/.test(text)) return 'Left Wall';
                if (/\bright\b/.test(text)) return 'Right Wall';
                if (/\btop\b|\bupper\b/.test(text)) return 'Top Wall';
                if (/\bbottom\b|\blower\b/.test(text)) return 'Bottom Wall';
                return '';
            };

            const prettifyWallLabel = (value) => {
                return String(value || '')
                    .replace(/\bledwall\b/ig, 'LED Wall')
                    .replace(/\bled\s*wall\b/ig, 'LED Wall')
                    .replace(/\bvideo\s*wall\b/ig, 'Video Wall')
                    .replace(/\bscreen\b/ig, 'Screen')
                    .replace(/\bdisplay\b/ig, 'Display')
                    .replace(/\btotem\b/ig, 'Totem')
                    .replace(/\bfascia\b/ig, 'Fascia')
                    .replace(/\bbanner\b/ig, 'Banner')
                    .replace(/\bbackdrop\b/ig, 'Backdrop')
                    .replace(/\s+/g, ' ')
                    .trim();
            };

            const LED_VENDOR_PATTERN = /\b(unilumin|absen|besd|dicolor|gloshine|infiled|infled|jr\s*visual|jrvisual|clt|create\s*led|uniview|roe(?:\s*visual)?|leyard|novastar|nova|brompton|barco|sony|samsung|lg|hikvision|aoto|liantronics|yes\s*tech|yestech|szlightall|nationstar|ugm)\b/i;

            const normalizePdfOcrArtifacts = (value) => {
                return String(value || '')
                    .replace(/[×✕✖]/g, 'x')
                    .replace(/[хХ]/g, 'x')
                    .replace(/[–—]/g, '-')
                    .replace(/\b(\d{1,2})\s*,\s*(\d{1,2})\b/g, '$1.$2')
                    .replace(/\s+/g, ' ')
                    .trim();
            };

            const stripTrailingCountNoise = (value) => {
                let text = normalizePdfOcrArtifacts(value);
                if (!text) return '';

                const hasWallSize = /(\d+(?:\.\d+)?)\s*(m|meter|meters|metre|metres|cm|mm|ft|feet|in|inch|inches)\s*[x×]\s*(\d+(?:\.\d+)?)\s*(m|meter|meters|metre|metres|cm|mm|ft|feet|in|inch|inches)?/i.test(text);
                const hasPanelSize = /(\d{2,4})\s*[x×]\s*(\d{2,4})\s*(mm|cm|m)?\b/i.test(text);
                const hasSizeSignal = hasWallSize || hasPanelSize;

                if (text.includes('|')) {
                    const cells = text.split('|').map((s) => s.trim()).filter(Boolean);
                    const isCountCell = (cell) => /^(?:rental|qty|quantity|total|tot|nos?|no\.?|pcs?|panels?|cabinets?|modules?|tiles?)?\s*[:\-]?\s*\d{1,6}\s*(?:nos?|no\.?|pcs?|panels?|cabinets?|modules?|tiles?)?$/i.test(cell)
                        || /^\d{1,6}\s*(?:nos?|no\.?|pcs?|panels?|cabinets?|modules?|tiles?)?$/i.test(cell);
                    while (cells.length > 1 && isCountCell(cells[cells.length - 1])) {
                        cells.pop();
                    }
                    text = cells.join(' | ').trim();
                }

                let prev = '';
                while (text !== prev) {
                    prev = text;
                    text = text
                        .replace(/\s*(?:\||,|;)\s*(?:rental|qty|quantity|total|tot|nos?|no\.?|pcs?)\s*[:\-]?\s*\d{1,6}\s*$/i, '')
                        .replace(/\s*(?:\||,|;)\s*\d{1,6}\s*(?:nos?|no\.?|pcs?|panels?|cabinets?|modules?|tiles?)\s*$/i, '')
                        .replace(/\s*(?:\||,|;)\s*\d{1,6}\s*$/i, hasSizeSignal ? '' : '$&')
                        .trim();
                }

                if (hasSizeSignal) {
                    text = text
                        .replace(/\s+(?:rental|qty|quantity|total|tot|nos?|no\.?|pcs?)\s*[:\-]?\s*\d{1,6}\s*$/i, '')
                        .replace(/\s+\d{1,6}\s*(?:nos?|no\.?|pcs?|panels?|cabinets?|modules?|tiles?)\s*$/i, '')
                        .replace(/((?:\d{2,4}\s*[x×]\s*\d{2,4}(?:\s*(?:mm|cm|m))?).*?)\s+\d{1,6}\s*$/i, '$1')
                        .trim();
                }

                text = text
                    .replace(/^(?:rental|qty|quantity|total|tot)\s*[:\-]?\s*\d{1,6}\s*$/i, '')
                    .replace(/^(?:rental|qty|quantity|total|tot)\s*$/i, '')
                    .trim();

                return text;
            };

            const isCountNoiseLine = (value) => {
                const s = normalizePdfOcrArtifacts(value).toLowerCase();
                if (!s) return true;
                if (/^(?:rental|qty|quantity|total|tot|nos?|no\.?|pcs?)\s*[:\-]?\s*\d{1,6}\s*$/i.test(s)) return true;
                if (/^\d{1,6}\s*(?:nos?|no\.?|pcs?)?\s*$/i.test(s)) return true;
                if (/^(?:rental|qty|quantity|total|tot|nos?|no\.?|pcs?)\s*$/i.test(s)) return true;
                return false;
            };

            const normalizeBrandName = (value) => {
                const src = String(value || '').trim();
                if (!src) return '';
                const compact = src.toLowerCase().replace(/\s+/g, '');
                const map = {
                    'jrvisual': 'JR Visual',
                    'createled': 'Create LED',
                    'yestech': 'YesTech',
                    'infled': 'INFiLED',
                    'clt': 'CLT',
                    'besd': 'BESD',
                    'uniview': 'Uniview',
                    'ugm': 'UGM'
                };
                if (map[compact]) return map[compact];
                return src
                    .replace(/\s+/g, ' ')
                    .split(' ')
                    .map(p => p ? (p[0].toUpperCase() + p.slice(1).toLowerCase()) : p)
                    .join(' ')
                    .trim();
            };

            const extractBrandModelFromText = (value) => {
                const src = normalizePdfOcrArtifacts(value);
                const brandMatch = src.match(LED_VENDOR_PATTERN);
                const brand = brandMatch ? normalizeBrandName(String(brandMatch[1] || '').replace(/\s+/g, ' ').trim()) : '';
                let model = '';

                const modelExplicit = src.match(/\bmodel\b\s*[:=\-]?\s*([A-Za-z0-9][A-Za-z0-9 ._\/-]{1,48})/i);
                if (modelExplicit && modelExplicit[1]) {
                    model = String(modelExplicit[1]).trim();
                }

                if (!model && brand) {
                    const nearBrand = src.match(new RegExp(`\\b${brand}\\b\\s*[:=\\-]?\\s*([A-Za-z0-9][A-Za-z0-9 ._\\/-]{1,48})`, 'i'));
                    if (nearBrand && nearBrand[1]) {
                        model = String(nearBrand[1])
                            .split(/\b(?:pitch|pixel|panel|cabinet|resolution|res|size|dimensions?|screen|wall|display|brightness|refresh)\b/i)[0]
                            .trim();
                    }
                }

                model = model.replace(/[;,\s]+$/g, '').trim();
                if (model.length > 40) model = model.slice(0, 40).trim();
                return { brand, model };
            };

            const parseSpecLine = (rawLine, defaults) => {
                const line = String(rawLine || '').trim();
                if (!line) return null;
                if (isCountNoiseLine(line)) return null;
                const normalized = normalizePdfOcrArtifacts(line)
                    .replace(/×/g, 'x')
                    .replace(/(\d+(?:\.\d+)?)\s*m\s*[wW]\b/g, '$1m')
                    .replace(/(\d+(?:\.\d+)?)\s*m\s*[hH]\b/g, '$1m')
                    .replace(/(\d+(?:\.\d+)?)\s*cm\s*[wW]\b/g, '$1cm')
                    .replace(/(\d+(?:\.\d+)?)\s*cm\s*[hH]\b/g, '$1cm')
                    .replace(/(\d+(?:\.\d+)?)\s*ft\s*[wW]\b/g, '$1ft')
                    .replace(/(\d+(?:\.\d+)?)\s*ft\s*[hH]\b/g, '$1ft')
                    .replace(/(\d+(?:\.\d+)?)\s*in\s*[wW]\b/g, '$1in')
                    .replace(/(\d+(?:\.\d+)?)\s*in\s*[hH]\b/g, '$1in');
                const hasScreenContext = /\b(screen|led\s*wall|ledwall|video\s*wall|wall|display|overall|total|dimensions?|size|totem|fascia|banner|backdrop|header)\b/i.test(normalized);
                const hasVendorContext = LED_VENDOR_PATTERN.test(normalized);
                const vendorMeta = extractBrandModelFromText(normalized);
                const brand = vendorMeta.brand;
                const model = vendorMeta.model;

                let name = '';
                const colonAt = line.indexOf(':');
                if (colonAt > 0 && colonAt < 42) {
                    const leftPart = line.slice(0, colonAt).trim();
                    if (!/^(screen|wall|size|dimensions?|res|resolution|pitch)$/i.test(leftPart)) {
                        name = leftPart;
                    }
                }

                if (!name) {
                    const ledLabelMatch = line.match(/\b((?:main|center|middle|left|right|rear|back|front|upstage|downstage|stage\s*left|stage\s*right)?\s*(?:led\s*wall|ledwall|video\s*wall|screen(?:\s*\d+)?|display(?:\s*\d+)?|totem(?:\s*\d+)?|fascia|banner|backdrop))\b/i);
                    if (ledLabelMatch && ledLabelMatch[1]) {
                        const exactLabel = String(ledLabelMatch[1]).trim();
                        name = exactLabel.includes(' ') ? exactLabel : prettifyWallLabel(exactLabel);
                    }
                }

                if (!name) name = inferWallName(line);

                const panelCountMatch = normalized.match(/(\d{1,3})\s*[x]\s*(\d{1,3})\s*(?:panels?|cabinets?|tiles?|modules?)/i)
                    || normalized.match(/(?:panels?|cabinets?|tiles?|modules?)[^\d]{0,12}(\d{1,3})\s*[x]\s*(\d{1,3})/i)
                    || normalized.match(/(\d{1,3})\s*(?:wide|w|columns?)\s*(?:x|by)?\s*(\d{1,3})\s*(?:high|h|rows?)/i)
                    || normalized.match(/(\d{1,3})\s*w\s*(\d{1,3})\s*h\b/i)
                    || normalized.match(/(\d{1,3})\s*by\s*(\d{1,3})\s*(?:panels?|cabinets?|tiles?|modules?)?\b/i);
                const panelsWide = panelCountMatch ? Math.max(1, Number(panelCountMatch[1])) : null;
                const panelsHigh = panelCountMatch ? Math.max(1, Number(panelCountMatch[2])) : null;

                let panelSizeMatch = normalized.match(/(?:panel|cabinet|tile|module)[^\d]{0,24}(?:size|dimensions?|dim)?[^\d]{0,10}(\d+(?:\.\d+)?)\s*[x]\s*(\d+(?:\.\d+)?)(?:\s*(mm|cm|m|ft|in))?/i)
                    || normalized.match(/(\d+(?:\.\d+)?)\s*[x]\s*(\d+(?:\.\d+)?)\s*(mm|cm|m|ft|in)\s*(?:panel|cabinet|tile|module)/i)
                    || normalized.match(/panel\s*(\d+(?:\.\d+)?)\s*[x]\s*(\d+(?:\.\d+)?)(?:\s*(mm|cm|m|ft|in))?/i)
                    || normalized.match(/(?:panel|cabinet|tile|module)[^\d]{0,24}(\d{2,4})\s*[x]\s*(\d{2,4})(?!\s*(?:px|pixels?))/i);
                const bareDimMatch = normalized.match(/(\d+(?:\.\d+)?)\s*[x]\s*(\d+(?:\.\d+)?)\s*(mm|cm|m|ft|in)\b/i);
                if (!panelSizeMatch && bareDimMatch && (hasVendorContext || /\b(led|pitch|module|cabinet|panel)\b/i.test(normalized)) && !hasScreenContext) {
                    panelSizeMatch = bareDimMatch;
                }
                const hasExplicitPanelSize = !!panelSizeMatch;

                const panelResMatch = normalized.match(/(?:panel|module|cabinet|tile)?[^\d]{0,24}(?:pixel\s*size|panel\s*pixel\s*size|pixel\s*matrix|resolution|res|px|pixels?)[^\d]{0,14}(\d{2,5})\s*[x]\s*(\d{2,5})/i)
                    || normalized.match(/(?:panel|module|cabinet|tile)[^\d]{0,24}(?:pixel\s*size|resolution|res|pixels?)[^\d]{0,14}(\d{2,5})\s*[x]\s*(\d{2,5})/i)
                    || normalized.match(/(\d{2,5})\s*[x]\s*(\d{2,5})\s*(?:px|pixels?)\b/i);
                const hasExplicitPanelRes = !!panelResMatch;

                const pitchMm = parsePitchMm(normalized, defaults.pitchMm || null);
                const hasPitchValue = Number.isFinite(pitchMm) && pitchMm > 0;

                let screenWidthM = null;
                let screenHeightM = null;
                let hasExplicitScreenSize = false;
                const screenLabeled = normalized.match(/(?:screen|wall|display)[^\d]{0,20}(?:size|dimensions?|dim)?[^\d]{0,10}(\d+(?:\.\d+)?)\s*(mm|cm|m|ft|in)\s*[x]\s*(\d+(?:\.\d+)?)\s*(mm|cm|m|ft|in)?/i)
                    || normalized.match(/(?:screen|wall|display)[^\d]{0,20}(?:size|dimensions?|dim)?[^\d]{0,10}(\d+(?:\.\d+)?)\s*[x]\s*(\d+(?:\.\d+)?)\s*(mm|cm|m|ft|in)\b/i)
                    || normalized.match(/(?:overall|total)\s*(?:size|dimensions?)?[^\d]{0,10}(\d+(?:\.\d+)?)\s*(mm|cm|m|ft|in)\s*[x]\s*(\d+(?:\.\d+)?)\s*(mm|cm|m|ft|in)?/i)
                    || normalized.match(/(?:overall|total)\s*(?:size|dimensions?)?[^\d]{0,10}(\d+(?:\.\d+)?)\s*[x]\s*(\d+(?:\.\d+)?)\s*(mm|cm|m|ft|in)\b/i);
                if (screenLabeled) {
                    const v1 = screenLabeled[1];
                    const u1 = screenLabeled[2];
                    const v2 = screenLabeled[3];
                    const u2 = screenLabeled[4];

                    if (u1) {
                        screenWidthM = toMeters(v1, u1);
                        screenHeightM = toMeters(v2, u2 || u1);
                    } else if (u2) {
                        screenWidthM = toMeters(v1, u2);
                        screenHeightM = toMeters(v2, u2);
                    } else {
                        screenWidthM = null;
                        screenHeightM = null;
                    }
                    hasExplicitScreenSize = !!(screenWidthM && screenHeightM);
                } else {
                    const widthHeightPattern = normalized.match(/(?:width|w)\s*[:=]?\s*(\d+(?:\.\d+)?)\s*(mm|cm|m|ft|in)?[^\d]{0,20}(?:height|h)\s*[:=]?\s*(\d+(?:\.\d+)?)\s*(mm|cm|m|ft|in)?/i)
                        || normalized.match(/(\d+(?:\.\d+)?)\s*(mm|cm|m|ft|in)?\s*(?:w|width)\b[^\d]{0,20}(\d+(?:\.\d+)?)\s*(mm|cm|m|ft|in)?\s*(?:h|height)\b/i);
                    if (widthHeightPattern) {
                        const wVal = widthHeightPattern[1];
                        const wUnit = widthHeightPattern[2];
                        const hVal = widthHeightPattern[3];
                        const hUnit = widthHeightPattern[4];

                        if (wUnit || hUnit) {
                            const unit = wUnit || hUnit;
                            screenWidthM = toMeters(wVal, wUnit || unit);
                            screenHeightM = toMeters(hVal, hUnit || unit);
                            hasExplicitScreenSize = !!(screenWidthM && screenHeightM);
                        } else {
                            const wNum = Number(wVal);
                            const hNum = Number(hVal);
                            if (Number.isFinite(wNum) && Number.isFinite(hNum)) {
                                const maxVal = Math.max(wNum, hNum);
                                const inferredUnit = maxVal > 200 ? 'mm' : (maxVal > 20 ? 'cm' : 'm');
                                screenWidthM = toMeters(wNum, inferredUnit);
                                screenHeightM = toMeters(hNum, inferredUnit);
                                hasExplicitScreenSize = !!(screenWidthM && screenHeightM);
                            }
                        }
                    }

                    const genericDims = normalized.match(/(\d+(?:\.\d+)?)\s*(mm|cm|m|ft|in)\s*[x]\s*(\d+(?:\.\d+)?)\s*(mm|cm|m|ft|in)/i)
                        || normalized.match(/(\d+(?:\.\d+)?)\s*[x]\s*(\d+(?:\.\d+)?)\s*(mm|cm|m|ft|in)\b/i);
                    if (!hasExplicitScreenSize && genericDims) {
                        const looksLikePanelOnly = !hasScreenContext && panelSizeMatch && (hasVendorContext || /\b(led|pitch|module|cabinet|panel)\b/i.test(normalized));
                        if (looksLikePanelOnly) {
                            screenWidthM = null;
                            screenHeightM = null;
                        } else {
                        if (genericDims.length >= 5) {
                            screenWidthM = toMeters(genericDims[1], genericDims[2]);
                            screenHeightM = toMeters(genericDims[3], genericDims[4]);
                        } else {
                            const u = genericDims[3] || 'm';
                            screenWidthM = toMeters(genericDims[1], u);
                            screenHeightM = toMeters(genericDims[2], u);
                        }
                            hasExplicitScreenSize = !!(screenWidthM && screenHeightM);
                        }
                    }

                    if (!hasExplicitScreenSize && hasScreenContext) {
                        const unitlessScreenDims = normalized.match(/(\d+(?:\.\d+)?)\s*[x]\s*(\d+(?:\.\d+)?)/i);
                        const hasPixelContext = /\b(pixel|resolution|res|px|pixels?)\b/i.test(normalized);
                        const hasCountContext = /\b(rental|qty|quantity|total|tot|nos?|no\.?|pcs?)\b/i.test(normalized);
                        const hasStrongWallContext = /\b(screen|wall|display)\b/i.test(normalized) && /\b(size|dimensions?|width|height|w|h)\b/i.test(normalized);
                        if (unitlessScreenDims && !hasPixelContext && !hasCountContext && hasStrongWallContext) {
                            const w = Number(unitlessScreenDims[1]);
                            const h = Number(unitlessScreenDims[2]);
                            if (Number.isFinite(w) && Number.isFinite(h) && w >= 1 && h >= 1 && w <= 80 && h <= 40) {
                                screenWidthM = w;
                                screenHeightM = h;
                                hasExplicitScreenSize = true;
                            }
                        }
                    }
                }

                let panelWidthMm = hasExplicitPanelSize ? toMm(panelSizeMatch[1], panelSizeMatch[3] || 'mm') : (defaults.panelWidthMm || null);
                let panelHeightMm = hasExplicitPanelSize ? toMm(panelSizeMatch[2], panelSizeMatch[3] || 'mm') : (defaults.panelHeightMm || null);
                let panelResWidth = hasExplicitPanelRes ? Number(panelResMatch[1]) : null;
                let panelResHeight = hasExplicitPanelRes ? Number(panelResMatch[2]) : null;

                if (panelsWide && panelsHigh && panelWidthMm && panelHeightMm) {
                    screenWidthM = (panelsWide * panelWidthMm) / 1000;
                    screenHeightM = (panelsHigh * panelHeightMm) / 1000;
                    hasExplicitScreenSize = true;
                }

                if ((!panelWidthMm || !panelHeightMm) && panelsWide && panelsHigh && screenWidthM && screenHeightM) {
                    panelWidthMm = (screenWidthM * 1000) / panelsWide;
                    panelHeightMm = (screenHeightM * 1000) / panelsHigh;
                }

                if ((!panelWidthMm || !panelHeightMm) && hasPitchValue && panelResWidth && panelResHeight) {
                    panelWidthMm = panelResWidth * pitchMm;
                    panelHeightMm = panelResHeight * pitchMm;
                }

                // Derive panel pixel resolution from pitch whenever it is not explicitly present.
                if ((!hasExplicitPanelRes || !panelResWidth || !panelResHeight) && hasPitchValue && panelWidthMm && panelHeightMm) {
                    panelResWidth = Math.max(1, Math.round(panelWidthMm / pitchMm));
                    panelResHeight = Math.max(1, Math.round(panelHeightMm / pitchMm));
                }

                if ((!panelWidthMm || !panelHeightMm) && hasPitchValue && panelResWidth && panelResHeight) {
                    panelWidthMm = Math.max(1, panelResWidth * pitchMm);
                    panelHeightMm = Math.max(1, panelResHeight * pitchMm);
                }

                if ((!panelResWidth || !panelResHeight) && defaults.panelResWidth && defaults.panelResHeight) {
                    panelResWidth = defaults.panelResWidth;
                    panelResHeight = defaults.panelResHeight;
                }

                // Do not create unintended maps from defaults only; require explicit screen size or panel count.
                if (!hasExplicitScreenSize && !(panelsWide && panelsHigh)) return null;

                const suspiciousHugeScreen = hasExplicitScreenSize
                    && (screenWidthM > 80 || screenHeightM > 40)
                    && /\b(panel|pixel|resolution|res|px|pixels?)\b/i.test(normalized);
                if (suspiciousHugeScreen) return null;

                if (!panelWidthMm || !panelHeightMm || !panelResWidth || !panelResHeight || !screenWidthM || !screenHeightM) return null;

                const derivedPanelsWide = panelsWide || Math.max(1, Math.ceil((screenWidthM * 1000) / panelWidthMm));
                const derivedPanelsHigh = panelsHigh || Math.max(1, Math.ceil((screenHeightM * 1000) / panelHeightMm));

                return {
                    name,
                    brand,
                    model,
                    screenWidthM,
                    screenHeightM,
                    panelWidthMm,
                    panelHeightMm,
                    panelResWidth,
                    panelResHeight,
                    pitchMm: Number.isFinite(pitchMm) ? pitchMm : null,
                    panelsWide: derivedPanelsWide,
                    panelsHigh: derivedPanelsHigh,
                };
            };

            c.innerHTML = `
                <div style="max-width:1320px;margin:0 auto;padding:22px 18px;position:relative;min-height:680px;">

                    <div style="position:relative;z-index:2;background:rgba(15,23,42,.9);border:1px solid rgba(148,163,184,.24);border-radius:18px;box-shadow:0 18px 40px rgba(2,6,23,.46);padding:22px;">
                        <h2 style="font-size:30px;line-height:1.1;font-weight:700;color:#f8fafc;">Legacy Feature</h2>
                        <p style="margin-top:8px;color:#cbd5e1;font-size:15px;">Paste natural language specs to auto-generate Pixel Maps using the existing Pixel Designer engine. One map per line works best.</p>
                        <div id="ai-current-project" style="margin-top:10px;display:inline-flex;align-items:center;gap:8px;padding:6px 10px;border-radius:999px;background:rgba(30,41,59,.7);border:1px solid rgba(100,116,139,.45);color:#dbeafe;font-size:12px;">Current Project: Not selected</div>

                        <div style="display:grid;grid-template-columns:2fr 1fr;gap:14px;margin-top:16px;">
                            <div>
                                <label style="display:block;color:#cbd5e1;font-size:13px;margin-bottom:6px;">Specs Input</label>
                                <textarea id="ai-map-specs" rows="12" style="width:100%;padding:10px 12px;border-radius:10px;border:1px solid #334155;background:#0b1220;color:#e2e8f0;font-size:13px;line-height:1.45;" placeholder="Main Wall: 16x8 panels, panel 500x500mm, panel pixel size 192x192, pitch 2.6mm\nStage Left: screen 3m x 2m, P2.91, panel res 168x168\nStage Right: 12x6 cabinets, panel 500x500, 192x192px"></textarea>
                                <div style="display:flex;gap:10px;align-items:center;margin-top:10px;flex-wrap:wrap;">
                                    <button id="ai-map-read-pdf" style="padding:9px 14px;border:none;border-radius:8px;background:#0f766e;color:#ecfeff;font-weight:600;cursor:pointer;">Read Work Order PDF</button>
                                    <input id="ai-map-pdf-file" type="file" accept="application/pdf,.pdf" style="display:none;" />
                                    <button id="ai-map-gemini" style="padding:9px 14px;border:none;border-radius:8px;background:linear-gradient(135deg,#7c3aed,#0891b2);color:#ffffff;font-weight:700;cursor:pointer;">Extract with Gemini</button>
                                    <button id="ai-map-read-docx" style="padding:9px 14px;border:none;border-radius:8px;background:#0369a1;color:#ecfeff;font-weight:600;cursor:pointer;">Read DOCX</button>
                                    <input id="ai-map-docx-file" type="file" accept=".docx,application/vnd.openxmlformats-officedocument.wordprocessingml.document" style="display:none;" />
                                    <button id="ai-map-parse" style="padding:9px 14px;border:none;border-radius:8px;background:#334155;color:#f8fafc;font-weight:600;cursor:pointer;">Parse Specs</button>
                                    <button id="ai-map-generate" style="padding:9px 14px;border:none;border-radius:8px;background:linear-gradient(135deg,#8b5cf6,#06b6d4);color:#fff;font-weight:700;cursor:pointer;">Generate Pixel Maps</button>
                                    <span id="ai-map-msg" style="font-size:13px;color:#94a3b8;"></span>
                                </div>
                            </div>

                            <div style="display:flex;flex-direction:column;gap:10px;">
                                <div style="background:#0b1220;border:1px solid #334155;border-radius:10px;padding:10px;display:flex;flex-direction:column;gap:8px;">
                                    <div style="font-size:12px;color:#94a3b8;">Gemini API Key</div>
                                    <input id="ai-gemini-key" type="password" placeholder="Paste Gemini API key" style="padding:8px 10px;border-radius:8px;border:1px solid #334155;background:#111827;color:#e2e8f0;font-size:12px;" />
                                    <div style="display:flex;gap:6px;flex-wrap:wrap;">
                                        <button id="ai-gemini-save" type="button" style="padding:6px 10px;border:none;border-radius:7px;background:#2563eb;color:#ffffff;font-size:11px;font-weight:600;cursor:pointer;">Save Key</button>
                                        <button id="ai-gemini-test" type="button" style="padding:6px 10px;border:none;border-radius:7px;background:#0f766e;color:#ecfeff;font-size:11px;font-weight:600;cursor:pointer;">Test Key</button>
                                        <button id="ai-gemini-clear" type="button" style="padding:6px 10px;border:none;border-radius:7px;background:#991b1b;color:#fee2e2;font-size:11px;font-weight:600;cursor:pointer;">Clear Key</button>
                                    </div>
                                    <div id="ai-gemini-status" style="font-size:11px;color:#94a3b8;">Checking key status…</div>
                                </div>

                                <div style="background:#0b1220;border:1px solid #334155;border-radius:10px;padding:10px;">
                                    <div style="font-size:12px;color:#94a3b8;margin-bottom:6px;">Target Project</div>
                                    <div style="display:flex;align-items:flex-start;gap:8px;color:#e2e8f0;font-size:13px;line-height:1.45;">
                                        <span style="margin-top:2px;color:#34d399;">●</span>
                                        <span>Always uses the currently active project. Create/select your project in the <b>Projects</b> tab, then generate maps here.</span>
                                    </div>
                                </div>

                                <div style="background:#0b1220;border:1px solid #334155;border-radius:10px;padding:10px;display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                                    <div style="grid-column:1/-1;font-size:12px;color:#94a3b8;">Fallback Defaults</div>
                                    <input id="ai-default-screen-w" type="number" step="0.1" value="4" placeholder="Screen W (m)" style="padding:8px 10px;border-radius:8px;border:1px solid #334155;background:#111827;color:#e2e8f0;font-size:12px;" />
                                    <input id="ai-default-screen-h" type="number" step="0.1" value="2.5" placeholder="Screen H (m)" style="padding:8px 10px;border-radius:8px;border:1px solid #334155;background:#111827;color:#e2e8f0;font-size:12px;" />
                                    <input id="ai-default-panel-w" type="number" step="1" value="500" placeholder="Panel W (mm)" style="padding:8px 10px;border-radius:8px;border:1px solid #334155;background:#111827;color:#e2e8f0;font-size:12px;" />
                                    <input id="ai-default-panel-h" type="number" step="1" value="500" placeholder="Panel H (mm)" style="padding:8px 10px;border-radius:8px;border:1px solid #334155;background:#111827;color:#e2e8f0;font-size:12px;" />
                                    <input id="ai-default-pitch" type="number" step="0.1" value="3.9" placeholder="Pitch (mm)" style="padding:8px 10px;border-radius:8px;border:1px solid #334155;background:#111827;color:#e2e8f0;font-size:12px;" />
                                    <input id="ai-default-res" value="168x168" placeholder="Panel Res (WxH)" style="padding:8px 10px;border-radius:8px;border:1px solid #334155;background:#111827;color:#e2e8f0;font-size:12px;" />
                                </div>

                                <div style="background:#0b1220;border:1px solid #334155;border-radius:10px;padding:10px;display:flex;flex-direction:column;gap:8px;">
                                    <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;">
                                        <div style="font-size:12px;color:#94a3b8;">Loaded PDF Preview</div>
                                        <div style="display:flex;align-items:center;gap:6px;">
                                            <button id="ai-pdf-prev" type="button" style="padding:4px 8px;border:none;border-radius:6px;background:#1f2937;color:#e5e7eb;font-size:11px;cursor:pointer;">Prev</button>
                                            <span id="ai-pdf-page" style="font-size:11px;color:#94a3b8;min-width:66px;text-align:center;">0 / 0</span>
                                            <button id="ai-pdf-next" type="button" style="padding:4px 8px;border:none;border-radius:6px;background:#1f2937;color:#e5e7eb;font-size:11px;cursor:pointer;">Next</button>
                                        </div>
                                    </div>
                                    <div id="ai-pdf-preview-wrap" style="border:1px solid #334155;border-radius:8px;background:#111827;min-height:180px;display:flex;align-items:center;justify-content:center;padding:6px;overflow:auto;">
                                        <canvas id="ai-pdf-canvas" style="max-width:100%;height:auto;display:none;"></canvas>
                                        <div id="ai-pdf-empty" style="font-size:11px;color:#64748b;">No PDF loaded</div>
                                    </div>
                                    <button id="ai-map-run-ocr" type="button" style="padding:8px 10px;border:none;border-radius:8px;background:#7c3aed;color:#ffffff;font-size:12px;font-weight:600;cursor:pointer;">Run OCR (for image PDFs)</button>
                                    <textarea id="ai-map-pdf-raw" rows="5" placeholder="Extracted PDF text (editable). You can edit and then click ‘Extract Specs From Edited Text’." style="width:100%;padding:8px 10px;border-radius:8px;border:1px solid #334155;background:#111827;color:#cbd5e1;font-size:11px;line-height:1.4;"></textarea>
                                    <button id="ai-map-raw-to-specs" type="button" style="padding:8px 10px;border:none;border-radius:8px;background:#155e75;color:#ecfeff;font-size:12px;font-weight:600;cursor:pointer;">Extract Specs From Edited Text</button>
                                </div>
                            </div>
                        </div>

                        <div id="ai-map-segments" style="margin-top:10px;background:#0b1220;border:1px dashed #334155;border-radius:10px;padding:8px 10px;color:#94a3b8;font-size:11px;">Parsed Segments: none</div>
                        <div id="ai-map-debug" style="margin-top:10px;background:#0b1220;border:1px dashed #334155;border-radius:10px;padding:8px 10px;color:#94a3b8;font-size:11px;">Debug: load PDF/DOCX and parse to see matched candidates.</div>
                        <div id="ai-map-preview" style="margin-top:14px;background:#0b1220;border:1px solid #334155;border-radius:10px;padding:10px;color:#cbd5e1;font-size:12px;">No parsed maps yet.</div>
                    </div>
                </div>
            `;

            const specsEl = c.querySelector('#ai-map-specs');
            const readPdfBtn = c.querySelector('#ai-map-read-pdf');
            const pdfFileEl = c.querySelector('#ai-map-pdf-file');
            const geminiBtn = c.querySelector('#ai-map-gemini');
            const readDocxBtn = c.querySelector('#ai-map-read-docx');
            const docxFileEl = c.querySelector('#ai-map-docx-file');
            const parseBtn = c.querySelector('#ai-map-parse');
            const generateBtn = c.querySelector('#ai-map-generate');
            const msgEl = c.querySelector('#ai-map-msg');
            const segmentsEl = c.querySelector('#ai-map-segments');
            const debugEl = c.querySelector('#ai-map-debug');
            const previewEl = c.querySelector('#ai-map-preview');
            const pdfCanvas = c.querySelector('#ai-pdf-canvas');
            const pdfEmptyEl = c.querySelector('#ai-pdf-empty');
            const pdfPageEl = c.querySelector('#ai-pdf-page');
            const pdfPrevBtn = c.querySelector('#ai-pdf-prev');
            const pdfNextBtn = c.querySelector('#ai-pdf-next');
            const runOcrBtn = c.querySelector('#ai-map-run-ocr');
            const rawPdfTextEl = c.querySelector('#ai-map-pdf-raw');
            const rawToSpecsBtn = c.querySelector('#ai-map-raw-to-specs');
            const defaultScreenWEl = c.querySelector('#ai-default-screen-w');
            const defaultScreenHEl = c.querySelector('#ai-default-screen-h');
            const defaultPanelWEl = c.querySelector('#ai-default-panel-w');
            const defaultPanelHEl = c.querySelector('#ai-default-panel-h');
            const defaultPitchEl = c.querySelector('#ai-default-pitch');
            const defaultResEl = c.querySelector('#ai-default-res');
            const currentProjectEl = c.querySelector('#ai-current-project');
            const geminiKeyInputEl = c.querySelector('#ai-gemini-key');
            const geminiKeyStatusEl = c.querySelector('#ai-gemini-status');
            const geminiSaveBtn = c.querySelector('#ai-gemini-save');
            const geminiTestBtn = c.querySelector('#ai-gemini-test');
            const geminiClearBtn = c.querySelector('#ai-gemini-clear');
            let parsedSpecs = [];
            let loadedPdfFile = null;
            let loadedPdfDoc = null;
            let loadedPdfPage = 1;
            let loadedPdfPageCount = 0;
            let sessionGeminiApiKey = '';
            let aiDebugState = {
                totalLines: 0,
                sourceCandidates: 0,
                matchedCandidates: [],
                rejectedCandidates: [],
                brandsFound: []
            };
            const OCR_VERSION = '5.1.0';
            const OCR_ASSETS = {
                script: `https://cdn.jsdelivr.net/npm/tesseract.js@${OCR_VERSION}/dist/tesseract.min.js`,
                workerPath: `https://cdn.jsdelivr.net/npm/tesseract.js@${OCR_VERSION}/dist/worker.min.js`,
                corePath: `https://cdn.jsdelivr.net/npm/tesseract.js-core@${OCR_VERSION}/tesseract-core.wasm.js`,
                langPath: 'https://tessdata.projectnaptha.com/4.0.0',
            };

            const getCurrentProject = () => state.projects.find(p => String(p.id) === String(state.activeProjectId));

            const renderDebugPanel = () => {
                if (!debugEl) return;
                const dbg = aiDebugState || {};
                const matched = Array.isArray(dbg.matchedCandidates) ? dbg.matchedCandidates.slice(0, 8) : [];
                const rejected = Array.isArray(dbg.rejectedCandidates) ? dbg.rejectedCandidates.slice(0, 8) : [];
                const brands = Array.isArray(dbg.brandsFound) ? dbg.brandsFound : [];

                debugEl.innerHTML = `
                    <div style="display:flex;flex-wrap:wrap;gap:10px 14px;align-items:center;justify-content:space-between;">
                        <div style="display:flex;flex-wrap:wrap;gap:10px 14px;align-items:center;">
                            <span style="color:#e2e8f0;font-weight:600;">Debug</span>
                            <span>Lines: ${Number(dbg.totalLines) || 0}</span>
                            <span>Candidates: ${Number(dbg.sourceCandidates) || 0}</span>
                            <span>Matched: ${matched.length}</span>
                            <span>Rejected: ${rejected.length}</span>
                            <span>Brands: ${brands.length ? brands.map(escapeHtml).join(', ') : 'none'}</span>
                        </div>
                        <button id="ai-map-debug-copy" type="button" style="padding:4px 8px;border:none;border-radius:6px;background:#1f2937;color:#e5e7eb;font-size:11px;cursor:pointer;">Copy Debug</button>
                    </div>
                    <div style="margin-top:6px;color:#93c5fd;">Matched Samples: ${matched.length ? matched.map(escapeHtml).join('  |  ') : 'none'}</div>
                    <div style="margin-top:4px;color:#fca5a5;">Rejected Samples: ${rejected.length ? rejected.map(escapeHtml).join('  |  ') : 'none'}</div>
                `;

                const copyBtn = debugEl.querySelector('#ai-map-debug-copy');
                copyBtn?.addEventListener('click', async () => {
                    const payload = {
                        timestamp: new Date().toISOString(),
                        totalLines: Number(dbg.totalLines) || 0,
                        sourceCandidates: Number(dbg.sourceCandidates) || 0,
                        matchedCount: Array.isArray(dbg.matchedCandidates) ? dbg.matchedCandidates.length : 0,
                        rejectedCount: Array.isArray(dbg.rejectedCandidates) ? dbg.rejectedCandidates.length : 0,
                        brandsFound: Array.isArray(dbg.brandsFound) ? dbg.brandsFound : [],
                        matchedCandidates: Array.isArray(dbg.matchedCandidates) ? dbg.matchedCandidates : [],
                        rejectedCandidates: Array.isArray(dbg.rejectedCandidates) ? dbg.rejectedCandidates : []
                    };
                    const text = JSON.stringify(payload, null, 2);

                    let copied = false;
                    try {
                        if (navigator?.clipboard?.writeText) {
                            await navigator.clipboard.writeText(text);
                            copied = true;
                        }
                    } catch (_) {}

                    if (!copied) {
                        try {
                            const ta = document.createElement('textarea');
                            ta.value = text;
                            ta.style.position = 'fixed';
                            ta.style.left = '-9999px';
                            document.body.appendChild(ta);
                            ta.focus();
                            ta.select();
                            copied = document.execCommand('copy');
                            document.body.removeChild(ta);
                        } catch (_) {
                            copied = false;
                        }
                    }

                    if (msgEl) msgEl.textContent = copied ? 'Debug copied to clipboard.' : 'Unable to copy debug data.';
                });
            };

            const ensureDocxJs = async () => {
                try {
                    if (window.mammoth && typeof window.mammoth.extractRawText === 'function') return true;
                    const candidates = [
                        'https://cdn.jsdelivr.net/npm/mammoth@1.8.0/mammoth.browser.min.js',
                        'https://unpkg.com/mammoth@1.8.0/mammoth.browser.min.js'
                    ];
                    for (const src of candidates) {
                        const ok = await new Promise((resolve) => {
                            try {
                                const s = document.createElement('script');
                                s.src = src;
                                s.crossOrigin = 'anonymous';
                                s.onload = () => resolve(true);
                                s.onerror = () => resolve(false);
                                document.head.appendChild(s);
                            } catch (_) { resolve(false); }
                        });
                        if (ok && window.mammoth && typeof window.mammoth.extractRawText === 'function') return true;
                    }
                    return false;
                } catch (_) {
                    return false;
                }
            };

            const ensureOcrJs = async () => {
                try {
                    if (window.Tesseract && (typeof window.Tesseract.recognize === 'function' || typeof window.Tesseract.createWorker === 'function')) return true;
                    const isElectron = !!(window.process && process.versions && process.versions.electron);
                    const candidates = [
                        isElectron ? 'installed-resources/vendor/tesseract.min.js' : null,
                        'vendor/tesseract.min.js',
                        OCR_ASSETS.script,
                        `https://unpkg.com/tesseract.js@${OCR_VERSION}/dist/tesseract.min.js`
                    ].filter(Boolean);

                    for (const src of candidates) {
                        const ok = await new Promise((resolve) => {
                            try {
                                const s = document.createElement('script');
                                s.src = src;
                                s.crossOrigin = 'anonymous';
                                s.onload = () => resolve(true);
                                s.onerror = () => resolve(false);
                                document.head.appendChild(s);
                            } catch (_) { resolve(false); }
                        });
                        if (ok && window.Tesseract && (typeof window.Tesseract.recognize === 'function' || typeof window.Tesseract.createWorker === 'function')) return true;
                    }
                    return false;
                } catch (_) {
                    return false;
                }
            };

            const prepareCanvasForOcr = (inputCanvas) => {
                const srcW = inputCanvas.width || 0;
                const srcH = inputCanvas.height || 0;
                if (!(srcW > 0 && srcH > 0)) return inputCanvas;

                const maxPixels = 3_500_000;
                const scale = Math.min(1, Math.sqrt(maxPixels / (srcW * srcH)));
                const outW = Math.max(1, Math.round(srcW * scale));
                const outH = Math.max(1, Math.round(srcH * scale));
                const canvas = document.createElement('canvas');
                canvas.width = outW;
                canvas.height = outH;
                const ctx = canvas.getContext('2d');
                ctx.drawImage(inputCanvas, 0, 0, outW, outH);

                const img = ctx.getImageData(0, 0, outW, outH);
                const data = img.data;
                for (let i = 0; i < data.length; i += 4) {
                    const r = data[i];
                    const g = data[i + 1];
                    const b = data[i + 2];
                    let gray = Math.round(0.299 * r + 0.587 * g + 0.114 * b);
                    gray = gray > 165 ? 255 : (gray < 85 ? 0 : gray);
                    data[i] = gray;
                    data[i + 1] = gray;
                    data[i + 2] = gray;
                }
                ctx.putImageData(img, 0, 0);
                return canvas;
            };

            const runCanvasOcr = async (sourceCanvas) => {
                if (!sourceCanvas) return { text: '', error: 'No preview canvas available for OCR.' };
                const ocrReady = await ensureOcrJs();
                if (!ocrReady) return { text: '', error: 'OCR engine unavailable.' };
                try {
                    const prepared = prepareCanvasForOcr(sourceCanvas);
                    let result = null;
                    if (window.Tesseract && typeof window.Tesseract.recognize === 'function') {
                        result = await window.Tesseract.recognize(prepared, 'eng', {
                            logger: (m) => {
                                if (m && m.status === 'recognizing text' && Number.isFinite(m.progress)) {
                                    msgEl.textContent = `OCR preview page… ${Math.round(m.progress * 100)}%`;
                                }
                            }
                        });
                    }
                    const txt = String(result?.data?.text || '').trim();
                    if (!txt) return { text: '', error: 'No text recognized from preview page.' };
                    return { text: txt, error: '' };
                } catch (e) {
                    return { text: '', error: `Preview OCR failed: ${e?.message || 'Unknown error'}` };
                }
            };

            const renderLoadedPdfPage = async () => {
                try {
                    if (!loadedPdfDoc || !pdfCanvas || !pdfEmptyEl || !pdfPageEl) return;
                    const page = await loadedPdfDoc.getPage(loadedPdfPage);
                    const viewport = page.getViewport({ scale: 1.15 });
                    const ctx = pdfCanvas.getContext('2d');
                    pdfCanvas.width = Math.ceil(viewport.width);
                    pdfCanvas.height = Math.ceil(viewport.height);
                    await page.render({ canvasContext: ctx, viewport }).promise;
                    pdfCanvas.style.display = 'block';
                    pdfEmptyEl.style.display = 'none';
                    pdfPageEl.textContent = `${loadedPdfPage} / ${loadedPdfPageCount}`;
                } catch (error) {
                    console.warn('PDF preview render failed', error);
                    if (pdfEmptyEl) {
                        pdfEmptyEl.style.display = 'block';
                        pdfEmptyEl.textContent = 'Preview unavailable';
                    }
                    if (pdfCanvas) pdfCanvas.style.display = 'none';
                }
            };

            const loadPdfPreview = async (file) => {
                try {
                    const ready = await ensurePdfJs();
                    if (!ready) return false;
                    const buffer = await file.arrayBuffer();
                    loadedPdfDoc = await pdfjsLib.getDocument({ data: buffer, disableWorker: true }).promise;
                    loadedPdfPageCount = loadedPdfDoc.numPages || 0;
                    loadedPdfPage = 1;
                    await renderLoadedPdfPage();
                    return true;
                } catch (error) {
                    console.warn('loadPdfPreview failed', error);
                    loadedPdfDoc = null;
                    loadedPdfPageCount = 0;
                    loadedPdfPage = 1;
                    if (pdfPageEl) pdfPageEl.textContent = '0 / 0';
                    if (pdfCanvas) pdfCanvas.style.display = 'none';
                    if (pdfEmptyEl) {
                        pdfEmptyEl.style.display = 'block';
                        pdfEmptyEl.textContent = 'Failed to preview PDF';
                    }
                    return false;
                }
            };

            const renderCurrentProjectLabel = () => {
                if (!currentProjectEl) return;
                const project = getCurrentProject();
                if (!project) {
                    currentProjectEl.textContent = 'Current Project: Not selected';
                    currentProjectEl.style.color = '#fca5a5';
                    return;
                }
                currentProjectEl.textContent = `Current Project: ${project.name || 'Untitled Project'}`;
                currentProjectEl.style.color = '#dbeafe';
            };

            const refreshGeminiKeyStatus = async () => {
                if (!geminiKeyStatusEl) return;
                try {
                    if (!window.aiAutoMap || typeof window.aiAutoMap.getKeyStatus !== 'function') {
                        if (sessionGeminiApiKey) {
                            geminiKeyStatusEl.textContent = `Active: Session Key (${sessionGeminiApiKey.slice(0,4)}****${sessionGeminiApiKey.slice(-4)}) • secure save unavailable in current session`;
                            geminiKeyStatusEl.style.color = '#fde68a';
                        } else {
                            geminiKeyStatusEl.textContent = 'Secure key manager not loaded in this session. You can still use temporary session key.';
                            geminiKeyStatusEl.style.color = '#fca5a5';
                        }
                        return;
                    }
                    const res = await window.aiAutoMap.getKeyStatus();
                    if (!res?.ok) {
                        geminiKeyStatusEl.textContent = res?.error || 'Unable to read key status.';
                        geminiKeyStatusEl.style.color = '#fca5a5';
                        return;
                    }
                    const src = res.activeSource === 'stored' ? 'Saved Key' : (res.activeSource === 'env' ? 'Env Key' : 'None');
                    const enc = res.encryptionAvailable ? 'encrypted storage enabled' : 'encryption unavailable';
                    const preview = res.keyPreview ? ` (${res.keyPreview})` : '';
                    geminiKeyStatusEl.textContent = `Active: ${src}${preview} • ${enc}`;
                    geminiKeyStatusEl.style.color = res.activeSource === 'none' ? '#fca5a5' : '#86efac';
                } catch (error) {
                    geminiKeyStatusEl.textContent = `Status failed: ${error?.message || 'Unknown error'}`;
                    geminiKeyStatusEl.style.color = '#fca5a5';
                }
            };

            const getDefaults = () => {
                const resMatch = String(defaultResEl?.value || '').match(/(\d{2,5})\s*[x×]\s*(\d{2,5})/i);
                return {
                    screenWidthM: Math.max(0.1, Number(defaultScreenWEl?.value) || 4),
                    screenHeightM: Math.max(0.1, Number(defaultScreenHEl?.value) || 2.5),
                    panelWidthMm: Math.max(1, Number(defaultPanelWEl?.value) || 500),
                    panelHeightMm: Math.max(1, Number(defaultPanelHEl?.value) || 500),
                    pitchMm: Math.max(0.1, Number(defaultPitchEl?.value) || 3.9),
                    panelResWidth: resMatch ? Math.max(1, Number(resMatch[1])) : 128,
                    panelResHeight: resMatch ? Math.max(1, Number(resMatch[2])) : 128,
                };
            };

            const normalizePitchForKey = (v) => {
                const n = Number(v);
                if (!Number.isFinite(n)) return 0;
                return Math.round(n * 100) / 100;
            };

            const dedupeSpecs = (specs) => {
                const items = Array.isArray(specs) ? specs : [];
                if (!items.length) return [];
                const seen = new Set();
                const out = [];

                for (const spec of items) {
                    const w = Math.round((Number(spec.screenWidthM) || 0) * 100) / 100;
                    const h = Math.round((Number(spec.screenHeightM) || 0) * 100) / 100;
                    const pw = Math.round(Number(spec.panelWidthMm) || 0);
                    const ph = Math.round(Number(spec.panelHeightMm) || 0);
                    const rw = Math.round(Number(spec.panelResWidth) || 0);
                    const rh = Math.round(Number(spec.panelResHeight) || 0);
                    const pitch = normalizePitchForKey(spec.pitchMm);
                    const key = [w, h, pw, ph, rw, rh, pitch].join('|');
                    if (seen.has(key)) continue;
                    seen.add(key);
                    out.push(spec);
                }

                return out;
            };

            const decorateSpecNames = (specs) => {
                const items = Array.isArray(specs) ? specs : [];
                const used = new Map();
                return items.map((spec, index) => {
                    const raw = String(spec.name || '').trim();
                    const isGeneric = !raw || /^led\s*wall$/i.test(raw) || /^ai map\b/i.test(raw);
                    const dims = `${(Number(spec.screenWidthM) || 0).toFixed(2)}m x ${(Number(spec.screenHeightM) || 0).toFixed(2)}m`;
                    const pitchLabel = Number.isFinite(Number(spec.pitchMm)) ? ` P${Number(spec.pitchMm).toFixed(2)}` : '';
                    const brandLabel = String(spec.brand || '').trim();
                    const modelLabel = String(spec.model || '').trim();
                    const base = isGeneric
                        ? `${brandLabel ? `${brandLabel} ` : ''}${modelLabel ? `${modelLabel} ` : ''}LED Screen ${dims}${pitchLabel}`
                        : raw;
                    const n = (used.get(base) || 0) + 1;
                    used.set(base, n);
                    const unique = n === 1 ? base : `${base} ${n}`;
                    return { ...spec, name: unique || `AI Map ${String(index + 1).padStart(2, '0')}` };
                });
            };

            const detectMediaServer = (text) => {
                const t = String(text || '').toLowerCase();
                if (!t.trim()) return '';
                if (/\b(resolume|arena|avenue)\b/.test(t)) return 'Resolume';
                if (/\b(watchout|dataton\s*watchout|dataton)\b/.test(t)) {
                    if (/\bwatchout\s*7\b/.test(t)) return 'Dataton Watchout 7';
                    if (/\bwatchout\s*6\b/.test(t)) return 'Dataton Watchout 6';
                    return 'Dataton Watchout 7';
                }
                if (/\b(disguise|d3|gx\s*2c|vx\s*4|rx\s*ii|solo\s*pro)\b/.test(t)) return 'Disguise d3';
                return '';
            };

            const applyDetectedDeliverySpecPreset = (serverName) => {
                if (!serverName) return false;
                const ds = state.pdfExport && state.pdfExport.deliverySpec ? state.pdfExport.deliverySpec : null;
                if (!ds) return false;
                const presets = {
                    'Resolume': {
                        mediaServer: 'Resolume',
                        format: 'QUICKTIME',
                        codecs: ['DXV3'],
                        codecsCustom: '',
                        codecsLink: 'https://resolume.com/download/file?file=Resolume_DXV_Codec_3_0_1_Installer.exe',
                        codecsLink2: '',
                        quality: '100%',
                        pixelAspectRatio: 'Square Pixels (1:1)',
                        fps: '25',
                        embeddedAudio: true,
                        embeddedAudioDetails: 'Stereo, Uncompressed, 16 Bit',
                        sampleRate: '48000 Hz',
                        unembeddedAudioFormat: 'Wav',
                        stillFrameFormat: 'PNG',
                        namingStructure: '"Bank Number"_"delivery"_"screen Name"_"resolution"_"version".Mov',
                        example: '001_intro-video_center-screen_1920x1080_v001.Mov',
                        comments: 'Media Servers Rely On File Names To Understand And Manage Updates On The Content. Please Make Sure The File Name Is Consistent And Use The Version Tag At The End Of The File.'
                    },
                    'Dataton Watchout 6': {
                        mediaServer: 'Dataton Watchout 6',
                        format: 'QUICKTIME',
                        codecs: ['HAP'],
                        codecsCustom: '',
                        codecsLink: 'https://github.com/Vidvox/hap-qt-codec',
                        codecsLink2: '',
                        quality: '100%',
                        pixelAspectRatio: 'Square Pixels (1:1)',
                        fps: '25',
                        embeddedAudio: true,
                        embeddedAudioDetails: 'Stereo, Uncompressed, 16 Bit',
                        sampleRate: '48000 Hz',
                        unembeddedAudioFormat: 'Wav',
                        stillFrameFormat: 'PNG',
                        namingStructure: '"Bank Number"_"delivery"_"screen Name"_"resolution"_"version".Mov'
                    },
                    'Dataton Watchout 7': {
                        mediaServer: 'Dataton Watchout 7',
                        format: 'QUICKTIME',
                        codecs: ['HAP', 'NOTCHLC'],
                        codecsCustom: '',
                        codecsLink: 'https://github.com/Vidvox/hap-qt-codec',
                        codecsLink2: 'https://notch.net/academy/NotchLC_download',
                        quality: '100%',
                        pixelAspectRatio: 'Square Pixels (1:1)',
                        fps: '25',
                        embeddedAudio: true,
                        embeddedAudioDetails: 'Stereo, Uncompressed, 16 Bit',
                        sampleRate: '48000 Hz',
                        unembeddedAudioFormat: 'Wav',
                        stillFrameFormat: 'PNG',
                        namingStructure: '"Bank Number"_"delivery"_"screen Name"_"resolution"_"version".Mov'
                    },
                    'Disguise d3': {
                        mediaServer: 'Disguise d3',
                        format: 'QUICKTIME',
                        codecs: ['HAP', 'NOTCHLC'],
                        codecsCustom: '',
                        codecsLink: 'https://github.com/Vidvox/hap-qt-codec',
                        codecsLink2: 'https://notch.net/academy/NotchLC_download',
                        quality: '100%',
                        pixelAspectRatio: 'Square Pixels (1:1)',
                        fps: '25',
                        embeddedAudio: true,
                        embeddedAudioDetails: 'Stereo, Uncompressed, 16 Bit',
                        sampleRate: '48000 Hz',
                        unembeddedAudioFormat: 'Wav',
                        stillFrameFormat: 'PNG',
                        namingStructure: '"Bank Number"_"delivery"_"screen Name"_"resolution"_"version".Mov'
                    }
                };

                const p = presets[serverName];
                if (!p) return false;
                Object.assign(ds, p);
                return true;
            };

            const renderPreview = () => {
                if (!parsedSpecs.length) {
                    previewEl.innerHTML = 'No valid map lines parsed. Include at least one line with dimensions or rely on defaults.';
                    return;
                }
                previewEl.innerHTML = `
                    <div style="font-weight:700;color:#e2e8f0;margin-bottom:6px;">Parsed ${parsedSpecs.length} map${parsedSpecs.length > 1 ? 's' : ''}</div>
                    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:8px;">
                        ${parsedSpecs.map((item, idx) => {
                            const calcWide = Number(item.panelsWide) || Math.max(1, Math.ceil(((Number(item.screenWidthM) || 0) * 1000) / Math.max(1, Number(item.panelWidthMm) || 1)));
                            const calcHigh = Number(item.panelsHigh) || Math.max(1, Math.ceil(((Number(item.screenHeightM) || 0) * 1000) / Math.max(1, Number(item.panelHeightMm) || 1)));
                            const totalPanels = calcWide * calcHigh;
                            return `
                            <div style="padding:8px;border:1px solid #334155;border-radius:8px;background:#111827;">
                                <div style="font-weight:600;color:#f8fafc;">${escapeHtml(item.name || `Map ${idx + 1}`)}</div>
                                <div>${item.screenWidthM.toFixed(2)}m × ${item.screenHeightM.toFixed(2)}m</div>
                                <div>${calcWide} × ${calcHigh} panels (${totalPanels} total)</div>
                                <div>${item.brand ? `Brand ${escapeHtml(item.brand)}` : 'Brand: auto/none'}${item.model ? ` • Model ${escapeHtml(item.model)}` : ''}</div>
                                <div>Panel ${Math.round(item.panelWidthMm)}×${Math.round(item.panelHeightMm)}mm</div>
                                <div>Resolution ${item.panelResWidth}×${item.panelResHeight}</div>
                                <div>${item.pitchMm ? `Pitch ${item.pitchMm}mm` : 'Pitch: auto/fallback'}</div>
                            </div>
                        `;
                        }).join('')}
                    </div>
                `;
            };

            const splitIntoSegments = (line) => {
                const source = String(line || '').trim();
                if (!source) return [];

                const firstPass = source
                    .split(/\s*[;|]\s*/)
                    .map(s => s.trim())
                    .filter(Boolean);

                const labelOrWallStart = '(?:[A-Za-z][A-Za-z0-9 \\-]{1,24}:|main\\b|center\\b|middle\\b|stage\\s*left\\b|stage\\s*right\\b|left\\b|right\\b|rear\\b|back\\b|front\\b|top\\b|bottom\\b|wall\\s*\\d+\\b|map\\s*\\d+\\b)';
                const splitRegex = new RegExp(`,\\s*(?=${labelOrWallStart})`, 'i');

                const secondPass = [];
                for (const part of firstPass) {
                    const chunks = part.split(splitRegex).map(s => s.trim()).filter(Boolean);
                    secondPass.push(...chunks);
                }

                return secondPass.length ? secondPass : firstPass;
            };

            const extractStructuredLinesFromPdf = async (file) => {
                try {
                    const ready = await ensurePdfJs();
                    if (!ready) return [];
                    const buffer = await file.arrayBuffer();
                    const pdf = await pdfjsLib.getDocument({ data: buffer, disableWorker: true }).promise;
                    const allRows = [];

                    for (let pageNum = 1; pageNum <= pdf.numPages; pageNum++) {
                        const page = await pdf.getPage(pageNum);
                        const content = await page.getTextContent({ normalizeWhitespace: true, disableCombineTextItems: false });
                        const items = (content.items || [])
                            .map((item) => {
                                const text = String(item.str || '').replace(/\s+/g, ' ').trim();
                                const transform = item.transform || [];
                                const x = Number(transform[4]) || 0;
                                const y = Number(transform[5]) || 0;
                                const w = Number(item.width) || Math.max(1, text.length * 4);
                                const h = Number(item.height) || 8;
                                return { text, x, y, w, h };
                            })
                            .filter((item) => item.text);

                        if (!items.length) continue;

                        const sortedByY = [...items].sort((a, b) => b.y - a.y || a.x - b.x);
                        const rows = [];
                        for (const item of sortedByY) {
                            const tol = Math.max(2.4, (item.h || 8) * 0.55);
                            let row = rows.find((r) => Math.abs(r.y - item.y) <= tol);
                            if (!row) {
                                row = { y: item.y, items: [] };
                                rows.push(row);
                            }
                            row.items.push(item);
                        }

                        rows.sort((a, b) => b.y - a.y);
                        for (const row of rows) {
                            const rowItems = row.items.sort((a, b) => a.x - b.x);
                            const parts = [];
                            let prev = null;
                            for (const cell of rowItems) {
                                if (prev) {
                                    const gap = cell.x - (prev.x + prev.w);
                                    const avgChar = Math.max(3, (prev.w || 10) / Math.max(1, prev.text.length));
                                    if (gap > Math.max(20, avgChar * 3.6)) {
                                        parts.push(' | ');
                                    } else if (gap > Math.max(8, avgChar * 1.4)) {
                                        parts.push(' ');
                                    }
                                }
                                parts.push(cell.text);
                                prev = cell;
                            }
                            let rowText = parts.join('').replace(/\s+\|\s+/g, ' | ').replace(/\s+/g, ' ').trim();
                            rowText = stripTrailingCountNoise(rowText);
                            if (rowText) allRows.push(rowText);
                        }
                    }

                    return [...new Set(allRows)].filter((line) => line.length >= 3);
                } catch (error) {
                    console.warn('Advanced PDF extraction failed', error);
                    return [];
                }
            };

            const runPdfOcr = async (file) => {
                if (!file) return { text: '', pagesProcessed: 0, error: 'No file loaded.' };
                const ocrReady = await ensureOcrJs();
                if (!ocrReady) {
                    return { text: '', pagesProcessed: 0, error: 'OCR engine unavailable. Add internet or vendor/tesseract.min.js.' };
                }

                try {
                    const ready = await ensurePdfJs();
                    if (!ready) return { text: '', pagesProcessed: 0, error: 'PDF engine unavailable.' };
                    let pdf = loadedPdfDoc;
                    if (!pdf) {
                        const buffer = await file.arrayBuffer();
                        pdf = await pdfjsLib.getDocument({ data: buffer, disableWorker: true }).promise;
                    }
                    const maxPages = Math.min(pdf.numPages || 0, 20);
                    let out = '';
                    let pagesProcessed = 0;

                    let worker = null;
                    const tesseract = window.Tesseract;
                    try {
                        if (tesseract && typeof tesseract.createWorker === 'function') {
                            worker = await tesseract.createWorker('eng', 1, {
                                workerPath: OCR_ASSETS.workerPath,
                                corePath: OCR_ASSETS.corePath,
                                langPath: OCR_ASSETS.langPath,
                                logger: (m) => {
                                    if (m && m.status === 'recognizing text' && Number.isFinite(m.progress)) {
                                        const pct = Math.round(m.progress * 100);
                                        msgEl.textContent = `Running OCR… ${pct}%`;
                                    }
                                }
                            });
                        }
                    } catch (_) {
                        worker = null;
                    }

                    for (let pageNo = 1; pageNo <= maxPages; pageNo++) {
                        try {
                            msgEl.textContent = `Running OCR page ${pageNo}/${maxPages}…`;
                            const page = await pdf.getPage(pageNo);
                            const viewport = page.getViewport({ scale: 2.6 });
                            const canvas = document.createElement('canvas');
                            canvas.width = Math.ceil(viewport.width);
                            canvas.height = Math.ceil(viewport.height);
                            const ctx = canvas.getContext('2d');
                            await page.render({ canvasContext: ctx, viewport }).promise;

                            const prepared = prepareCanvasForOcr(canvas);
                            let result = null;
                            if (worker && typeof worker.recognize === 'function') {
                                result = await worker.recognize(prepared);
                            } else if (tesseract && typeof tesseract.recognize === 'function') {
                                result = await tesseract.recognize(prepared, 'eng', {
                                    workerPath: OCR_ASSETS.workerPath,
                                    corePath: OCR_ASSETS.corePath,
                                    langPath: OCR_ASSETS.langPath,
                                    logger: (m) => {
                                        if (m && m.status === 'recognizing text' && Number.isFinite(m.progress)) {
                                            const pct = Math.round(m.progress * 100);
                                            msgEl.textContent = `Running OCR page ${pageNo}/${maxPages}… ${pct}%`;
                                        }
                                    }
                                });
                            }
                            const txt = String(result?.data?.text || '').trim();
                            pagesProcessed += 1;
                            if (txt) out += `\n${txt}\n`;
                        } catch (pageErr) {
                            console.warn(`OCR page ${pageNo} failed`, pageErr);
                        }
                    }

                    try { if (worker && typeof worker.terminate === 'function') await worker.terminate(); } catch (_) {}

                    const finalText = out.trim();
                    if (!finalText) {
                        return {
                            text: '',
                            pagesProcessed,
                            error: pagesProcessed ? 'OCR ran, but no text was recognized. Try clearer scan or higher-contrast source.' : 'OCR could not process pages.'
                        };
                    }
                    return { text: finalText, pagesProcessed, error: '' };
                } catch (error) {
                    console.warn('runPdfOcr failed', error);
                    return { text: '', pagesProcessed: 0, error: `OCR failed: ${error?.message || 'Unknown error'}` };
                }
            };

            const extractSpecLinesFromPdfText = (pdfText, structuredRows = []) => {
                const text = String(pdfText || '').replace(/\r/g, '\n');
                if (!text.trim() && (!structuredRows || !structuredRows.length)) return [];

                const allLines = text
                    .split(/\n+/)
                    .map((s) => stripTrailingCountNoise(s))
                    .filter((s) => !isCountNoiseLine(s))
                    .filter(Boolean);
                const mergedLines = [
                    ...allLines,
                    ...((structuredRows || [])
                        .map((s) => stripTrailingCountNoise(String(s || '').trim()))
                        .filter((s) => !isCountNoiseLine(s))
                        .filter(Boolean))
                ];
                if (!mergedLines.length) return [];

                const isVideoHeading = (line) => /\b(video|video\s*section|video\s*wall|led\s*wall|screen\s*details?)\b/i.test(line);
                const isSectionBoundary = (line) => /^(audio|lighting|power|rigging|camera|crew|schedule|timeline|notes?|contacts?|deliverables?|network|staging|logistics|transport|hotel)\b/i.test(line);
                const videoAnchors = [];
                mergedLines.forEach((line, idx) => { if (isVideoHeading(line)) videoAnchors.push(idx); });

                const preferredLines = [];
                if (videoAnchors.length) {
                    const seen = new Set();
                    for (const startIdx of videoAnchors) {
                        const endLimit = Math.min(mergedLines.length, startIdx + 160);
                        for (let i = startIdx; i < endLimit; i++) {
                            const line = mergedLines[i];
                            if (i > startIdx && isSectionBoundary(line) && line.length <= 40) break;
                            if (!seen.has(i)) {
                                preferredLines.push(line);
                                seen.add(i);
                            }
                        }
                    }
                }

                const lines = (() => {
                    const combined = preferredLines.length ? [...preferredLines, ...mergedLines] : mergedLines;
                    const seen = new Set();
                    const out = [];
                    for (const line of combined) {
                        const key = String(line || '').trim().toLowerCase();
                        if (!key || seen.has(key)) continue;
                        seen.add(key);
                        out.push(String(line || '').trim());
                    }
                    return out;
                })();

                const extractStrictNearbySpecs = (inputLines) => {
                    const source = (Array.isArray(inputLines) ? inputLines : [])
                        .map((s) => stripTrailingCountNoise(s))
                        .filter((s) => !isCountNoiseLine(s))
                        .filter(Boolean);
                    const results = [];
                    const seen = new Set();

                    const wallSizeReGlobal = /(\d+(?:\.\d+)?)\s*(m|meter|meters|metre|metres|cm|mm|ft|feet|in|inch|inches)\s*[x×]\s*(\d+(?:\.\d+)?)\s*(m|meter|meters|metre|metres|cm|mm|ft|feet|in|inch|inches)?(?:\s*(?:h|ht|height))?/ig;
                    const panelLabeledRe = /(?:panel|cabinet|module|tile)[^\d]{0,24}(\d{2,4})\s*[x×]\s*(\d{2,4})(?:\s*(mm|cm|m))?/i;
                    const panelAnyRe = /(\d{2,4})\s*[x×]\s*(\d{2,4})\s*(mm|cm|m)\b/i;
                    const ledContextRe = /\b(led|wall|screen|display|cabinet|panel|module|video\s*wall)\b/i;

                    const unitToMeters = (value, unit) => {
                        const n = Number(value);
                        if (!Number.isFinite(n) || n <= 0) return null;
                        const u = String(unit || 'm').toLowerCase();
                        if (u === 'm' || u === 'meter' || u === 'meters' || u === 'metre' || u === 'metres') return n;
                        if (u === 'cm') return n / 100;
                        if (u === 'mm') return n / 1000;
                        if (u === 'ft' || u === 'feet') return n * 0.3048;
                        if (u === 'in' || u === 'inch' || u === 'inches') return n * 0.0254;
                        return n;
                    };

                    const normalizePanelToMm = (value, unit) => {
                        const n = Number(value);
                        if (!Number.isFinite(n) || n <= 0) return null;
                        const u = String(unit || '').toLowerCase();
                        if (u === 'mm') return n;
                        if (u === 'cm') return n * 10;
                        if (u === 'm') return n * 1000;
                        if (!u) {
                            if (n >= 80 && n <= 2200) return n;
                            return null;
                        }
                        return null;
                    };

                    const pickPanelNear = (centerIndex) => {
                        const tryIndices = [];
                        for (let d = 0; d <= 3; d++) {
                            tryIndices.push(centerIndex - d, centerIndex + d);
                        }
                        const uniqueIndices = [...new Set(tryIndices)].filter((i) => i >= 0 && i < source.length);
                        for (const idx of uniqueIndices) {
                            const ln = normalizePdfOcrArtifacts(source[idx]);
                            if (!ln || isCountNoiseLine(ln)) continue;

                            let m = ln.match(panelLabeledRe);
                            if (!m && /\b(panel|cabinet|module|tile|pitch|pixel|led)\b/i.test(ln)) {
                                m = ln.match(panelAnyRe);
                            }
                            if (!m) continue;

                            const pw = normalizePanelToMm(m[1], m[3]);
                            const ph = normalizePanelToMm(m[2], m[3]);
                            if (!pw || !ph) continue;
                            if (pw < 80 || ph < 80 || pw > 2200 || ph > 2200) continue;
                            return { w: pw, h: ph };
                        }
                        return null;
                    };

                    const dominantPanelFromDocument = (() => {
                        const freq = new Map();
                        for (const lnRaw of source) {
                            const ln = normalizePdfOcrArtifacts(lnRaw);
                            if (!ln || isCountNoiseLine(ln)) continue;
                            let m = ln.match(panelLabeledRe);
                            if (!m && /\b(panel|cabinet|module|tile|pitch|pixel|led)\b/i.test(ln)) m = ln.match(panelAnyRe);
                            if (!m) continue;
                            const pw = normalizePanelToMm(m[1], m[3]);
                            const ph = normalizePanelToMm(m[2], m[3]);
                            if (!pw || !ph) continue;
                            const rw = Math.round(pw);
                            const rh = Math.round(ph);
                            if (rw < 80 || rh < 80 || rw > 2200 || rh > 2200) continue;
                            const key = `${rw}x${rh}`;
                            freq.set(key, (freq.get(key) || 0) + 1);
                        }
                        let best = null;
                        let bestCount = 0;
                        for (const [k, c] of freq.entries()) {
                            if (c > bestCount) {
                                best = k;
                                bestCount = c;
                            }
                        }
                        if (!best) return null;
                        const mm = best.match(/^(\d+)x(\d+)$/);
                        if (!mm) return null;
                        return { w: Number(mm[1]), h: Number(mm[2]) };
                    })();

                    const extractQtyNear = (line, fromIndex) => {
                        const s = String(line || '');
                        const tail = s.slice(Math.max(0, fromIndex), Math.min(s.length, fromIndex + 80));
                        const q = tail.match(/(?:x|\*)\s*(\d{1,3})\s*(?:nos?|no\.?|pcs?|qty)\b/i)
                            || tail.match(/\b(\d{1,3})\s*(?:nos?|no\.?|pcs?|qty)\b/i);
                        if (!q) return 1;
                        const n = Number(q[1]);
                        return Number.isFinite(n) && n > 0 && n <= 100 ? Math.round(n) : 1;
                    };

                    const hasQtyMarker = (s) => /(?:x|\*)\s*\d{1,3}\s*(?:nos?|no\.?|pcs?|qty)\b/i.test(s) || /\b\d{1,3}\s*(?:nos?|no\.?|pcs?|qty)\b/i.test(s);

                    const pickContextName = (idx, fallbackBrand) => {
                        const centerLine = normalizePdfOcrArtifacts(source[idx] || '');
                        const prevLine = normalizePdfOcrArtifacts(source[idx - 1] || '');
                        const nextLine = normalizePdfOcrArtifacts(source[idx + 1] || '');
                        const name = inferWallName(centerLine) || inferWallName(prevLine) || inferWallName(nextLine);
                        return name || (fallbackBrand ? `${fallbackBrand} LED Wall` : 'LED Wall');
                    };

                    for (let i = 0; i < source.length; i++) {
                        const center = normalizePdfOcrArtifacts(source[i]);
                        if (!center || isCountNoiseLine(center)) continue;

                        const wallMatches = [...center.matchAll(wallSizeReGlobal)];
                        if (!wallMatches.length) continue;

                        const chosenPanel = pickPanelNear(i) || dominantPanelFromDocument;
                        if (!chosenPanel) continue;

                        const localBlob = [source[i - 1], source[i], source[i + 1]].filter(Boolean).join(' | ');
                        const brandMatches = [...normalizePdfOcrArtifacts(localBlob).matchAll(new RegExp(LED_VENDOR_PATTERN.source, 'ig'))];
                        const brand = brandMatches.length ? normalizeBrandName(brandMatches[0][1] || brandMatches[0][0]) : '';
                        const hasLedContext = ledContextRe.test(localBlob) || !!brand;
                        const qtyLike = hasQtyMarker(center);
                        if (!hasLedContext && !qtyLike) continue;

                        for (const wm of wallMatches) {
                            const wallWm = unitToMeters(wm[1], wm[2]);
                            const wallHm = unitToMeters(wm[3], wm[4] || wm[2]);
                            if (!wallWm || !wallHm) continue;
                            if (wallWm < 0.8 || wallHm < 0.5 || wallWm > 60 || wallHm > 30) continue;

                            const qty = extractQtyNear(center, wm.index || 0);
                            const guessedNameBase = pickContextName(i, brand);
                            const guessedName = qty > 1 ? `${guessedNameBase} x${qty}` : guessedNameBase;
                            const normalizedWallW = Math.round(wallWm * 1000) / 1000;
                            const normalizedWallH = Math.round(wallHm * 1000) / 1000;
                            const panelW = Math.round(chosenPanel.w);
                            const panelH = Math.round(chosenPanel.h);

                            const canonical = `${guessedName}: screen ${normalizedWallW}m x ${normalizedWallH}m, panel ${panelW}x${panelH}mm${brand ? `, brand ${brand}` : ''}`;
                            const key = `${normalizedWallW}|${normalizedWallH}|${panelW}|${panelH}|${brand.toLowerCase()}|${qty}`;
                            if (!seen.has(key)) {
                                seen.add(key);
                                results.push(canonical);
                            }
                        }
                    }

                    return results;
                };

                const hasDims = /(\d+(?:\.\d+)?)\s*(mm|cm|m|ft|in)\s*[wWhH]?\s*[x×]\s*(\d+(?:\.\d+)?)(?:\s*(mm|cm|m|ft|in))?\s*[wWhH]?/i;
                const hasPanelCount = /(\d{1,3})\s*(?:x|by)\s*(\d{1,3})\s*(?:panels?|cabinets?|tiles?|modules?)?/i;
                const hasWallWords = /\b(main|center|middle|left|right|rear|back|front|stage\s*left|stage\s*right|wall|screen|display|led)\b/i;
                const hasSpecWords = /\b(panel|cabinet|module|tile|pitch|pixel|resolution|res|px|mm)\b/i;
                const wallMarker = /\b(main|center|middle|left|right|rear|back|front|stage\s*left|stage\s*right|wall\s*\d+|screen\s*\d+|led\s*wall)\b/i;
                const hasScreenLikeDims = /(?:\bled\s*screen\b|\bscreen\b|\bwall\b|\bdisplay\b)?[^\d]{0,12}(\d+(?:\.\d+)?)\s*(mm|cm|m|ft|in)\s*[wWhH]?\s*[x×]\s*(\d+(?:\.\d+)?)\s*(mm|cm|m|ft|in)?\s*[wWhH]?/i;
                const vendorWords = LED_VENDOR_PATTERN;
                const videoWords = /\b(video|led\s*screen|led\s*wall|screen\s*surface|upstage|downstage|stage\s*left|stage\s*right)\b/i;
                const screenIntentWords = /\b(screen|led\s*wall|ledwall|video\s*wall|wall|display|totem|fascia|banner|backdrop|header|floor\s*led|side\s*wall|main\s*wall)\b/i;
                const panelIntentWords = /\b(panel|cabinet|module|tile|pitch|pixel\s*pitch|pixel\s*size|resolution|res|px|pixels?)\b/i;
                const isLikelyWallHeader = (line) => {
                    const s = String(line || '').trim();
                    if (!s || s.length > 80) return false;
                    if (isSectionBoundary(s)) return false;
                    const hasLabelWord = /\b(screen|led\s*wall|ledwall|video\s*wall|wall|display|totem|fascia|banner|backdrop|header)\b/i.test(s);
                    const isTitleLike = /^[A-Z0-9\s\-_/&]+:?$/.test(s) || /^[A-Z][\w\s\-_/&]{2,60}:$/.test(s);
                    const hasNoDim = !/(\d+(?:\.\d+)?)\s*(mm|cm|m|ft|in)?\s*[x×]\s*(\d+(?:\.\d+)?)/i.test(s);
                    return hasLabelWord && (isTitleLike || s.endsWith(':')) && hasNoDim;
                };

                const normalizeSpecText = (s) => stripTrailingCountNoise(String(s || ''))
                    .replace(/×/g, 'x')
                    .replace(/(\d+(?:\.\d+)?)\s*m\s*[wW]\b/g, '$1m')
                    .replace(/(\d+(?:\.\d+)?)\s*m\s*[hH]\b/g, '$1m')
                    .replace(/(\d+(?:\.\d+)?)\s*cm\s*[wW]\b/g, '$1cm')
                    .replace(/(\d+(?:\.\d+)?)\s*cm\s*[hH]\b/g, '$1cm')
                    .replace(/(\d+(?:\.\d+)?)\s*ft\s*[wW]\b/g, '$1ft')
                    .replace(/(\d+(?:\.\d+)?)\s*ft\s*[hH]\b/g, '$1ft')
                    .replace(/(\d+(?:\.\d+)?)\s*in\s*[wW]\b/g, '$1in')
                    .replace(/(\d+(?:\.\d+)?)\s*in\s*[hH]\b/g, '$1in')
                    .replace(/\s+/g, ' ')
                    .trim();

                const synthesizeNamedLedWallLines = () => {
                    const out = [];
                    const dimsRe = /(\d+(?:\.\d+)?)\s*(mm|cm|m|ft|in)\s*[wWhH]?\s*[x×]\s*(\d+(?:\.\d+)?)\s*(mm|cm|m|ft|in)?\s*[wWhH]?/i;
                    const detailsRe = /(pitch\s*[:=]?\s*\d+(?:\.\d+)?\s*mm?|\bP\s*\d+(?:\.\d+)?\b|panel\s*(?:pixel\s*size|res(?:olution)?)\s*[:=]?\s*\d{2,5}\s*[x×]\s*\d{2,5}|\d{2,5}\s*[x×]\s*\d{2,5}\s*(?:px|pixels?)|panel\s*\d+(?:\.\d+)?\s*[x×]\s*\d+(?:\.\d+)?\s*(?:mm|cm|m|ft|in))/i;

                    for (let i = 0; i < lines.length; i++) {
                        const lineA = String(lines[i] || '').trim();
                        if (!lineA) continue;

                        const labelMatch = lineA.match(/\b((?:main|center|middle|left|right|rear|back|front|upstage|downstage|stage\s*left|stage\s*right)?\s*(?:led\s*wall|ledwall|video\s*wall|screen(?:\s*\d+)?))\b/i);
                        if (!labelMatch || !labelMatch[1]) continue;

                        const label = prettifyWallLabel(labelMatch[1]);
                        let combined = lineA;
                        let hasDims = dimsRe.test(combined);

                        for (let j = i + 1; j <= Math.min(lines.length - 1, i + 4); j++) {
                            const lineB = String(lines[j] || '').trim();
                            if (!lineB) continue;
                            if (!hasDims && dimsRe.test(lineB)) {
                                combined += `, ${lineB}`;
                                hasDims = true;
                                continue;
                            }
                            if (detailsRe.test(lineB)) {
                                combined += `, ${lineB}`;
                            }
                        }

                        if (hasDims) {
                            out.push(`${label}: ${combined}`);
                        }
                    }

                    return out;
                };

                const synthesizeContextualBlocks = () => {
                    const out = [];
                    for (let i = 0; i < lines.length; i++) {
                        const center = String(lines[i] || '').trim();
                        if (!center) continue;

                        const centerRelevant = screenIntentWords.test(center)
                            || panelIntentWords.test(center)
                            || hasDims.test(center)
                            || hasPanelCount.test(center);
                        if (!centerRelevant) continue;

                        const start = Math.max(0, i - 1);
                        const end = Math.min(lines.length - 1, i + 3);
                        const blockLines = [];
                        for (let j = start; j <= end; j++) {
                            const ln = String(lines[j] || '').trim();
                            if (!ln) continue;
                            if (isSectionBoundary(ln) && j > i) break;
                            blockLines.push(ln);
                        }
                        if (!blockLines.length) continue;
                        const block = blockLines.join(', ');
                        if (!hasDims.test(block) && !hasPanelCount.test(block)) continue;
                        if (!screenIntentWords.test(block) && !panelIntentWords.test(block) && !videoWords.test(block)) continue;
                        out.push(block);
                    }
                    return out;
                };

                const synthesizeBrandLinkedBlocks = () => {
                    const out = [];
                    for (let i = 0; i < lines.length; i++) {
                        const line = String(lines[i] || '').trim();
                        if (!line || !vendorWords.test(line)) continue;

                        const block = [line];
                        let hasSizingSignal = hasDims.test(line) || hasPanelCount.test(line) || panelIntentWords.test(line);
                        for (let j = i + 1; j <= Math.min(lines.length - 1, i + 4); j++) {
                            const next = String(lines[j] || '').trim();
                            if (!next) continue;
                            if (isSectionBoundary(next) && next.length <= 40) break;
                            if (hasDims.test(next) || hasPanelCount.test(next) || panelIntentWords.test(next) || screenIntentWords.test(next)) {
                                block.push(next);
                                hasSizingSignal = true;
                            }
                        }

                        if (hasSizingSignal) out.push(block.join(', '));
                    }
                    return out;
                };

                const synthesizeHeaderDrivenBlocks = () => {
                    const out = [];
                    let currentHeader = '';

                    for (let i = 0; i < lines.length; i++) {
                        const line = String(lines[i] || '').trim();
                        if (!line) continue;

                        if (isLikelyWallHeader(line)) {
                            currentHeader = line.replace(/:\s*$/, '').trim();
                            continue;
                        }

                        if (!currentHeader) continue;
                        if (isSectionBoundary(line)) {
                            currentHeader = '';
                            continue;
                        }

                        const hasUsefulSpec = hasDims.test(line) || hasPanelCount.test(line) || panelIntentWords.test(line) || /\b(p\s*\d+(?:\.\d+)?|pitch)\b/i.test(line);
                        if (!hasUsefulSpec) continue;

                        let combined = line;
                        for (let j = i + 1; j <= Math.min(lines.length - 1, i + 2); j++) {
                            const next = String(lines[j] || '').trim();
                            if (!next) continue;
                            if (isLikelyWallHeader(next) || isSectionBoundary(next)) break;
                            if (hasDims.test(next) || hasPanelCount.test(next) || panelIntentWords.test(next) || /\b(p\s*\d+(?:\.\d+)?|pitch)\b/i.test(next)) {
                                combined += `, ${next}`;
                            }
                        }

                        out.push(`${currentHeader}: ${combined}`);
                    }

                    return out;
                };

                const candidateBlocks = [];
                let current = [];
                const pushCurrent = () => {
                    if (!current.length) return;
                    const block = current.join(', ');
                    if (block.length >= 12) candidateBlocks.push(block);
                    current = [];
                };

                for (const line of lines) {
                    const clean = line.trim();
                    if (!clean) continue;

                    const startsNew = wallMarker.test(clean) && current.length >= 2;
                    if (startsNew) pushCurrent();

                    current.push(clean);
                    if (current.length >= 10) pushCurrent();
                }
                pushCurrent();

                const synthesizeVideoBlocks = () => {
                    const synthesized = [];
                    const hasVideoScreen = (s) => /\b(video|led\s*screen|led\s*wall|screen)\b/i.test(s) && /(\d+(?:\.\d+)?)\s*(mm|cm|m|ft|in)\s*[wWhH]?\s*[x×]\s*(\d+(?:\.\d+)?)/i.test(s);
                    const hasModelPitchPanel = (s) => /\b(unilumin|absen|roe|infiled|leyard|ugm|st)\b/i.test(s) && /\bled\b[^\d]{0,8}\d+(?:\.\d+)?\b/i.test(s) && /(\d+(?:\.\d+)?)\s*[x×]\s*(\d+(?:\.\d+)?)\s*mm\b/i.test(s);

                    for (let i = 0; i < lines.length; i++) {
                        const a = String(lines[i] || '').trim();
                        if (!a) continue;
                        if (!hasVideoScreen(a)) continue;
                        for (let j = i + 1; j <= Math.min(lines.length - 1, i + 4); j++) {
                            const b = String(lines[j] || '').trim();
                            if (!b) continue;
                            if (hasModelPitchPanel(b)) {
                                synthesized.push(`${a}, ${b}`);
                                break;
                            }
                        }
                    }
                    return synthesized;
                };

                const sentenceBlocks = text.split(/[\.\n]+/).map(s => s.replace(/\s+/g, ' ').trim()).filter(Boolean);
                const tableLikeBlocks = (structuredRows || [])
                    .filter((row) => /\|/.test(row) && row.length >= 10)
                    .map((row) => row.split('|').map((c) => c.trim()).filter(Boolean).join(', '));
                const namedLedWallBlocks = synthesizeNamedLedWallLines();
                const videoBlocks = synthesizeVideoBlocks();
                const contextualBlocks = synthesizeContextualBlocks();
                const brandLinkedBlocks = synthesizeBrandLinkedBlocks();
                const headerBlocks = synthesizeHeaderDrivenBlocks();
                const sources = [...headerBlocks, ...brandLinkedBlocks, ...namedLedWallBlocks, ...contextualBlocks, ...videoBlocks, ...candidateBlocks, ...tableLikeBlocks, ...sentenceBlocks];
                const scored = [];

                const strictNearby = extractStrictNearbySpecs(lines);

                const scoreSource = (src) => {
                    let score = 0;
                    if (hasDims.test(src)) score += 4;
                    if (hasScreenLikeDims.test(src)) score += 4;
                    if (hasPanelCount.test(src)) score += 3;
                    if (videoWords.test(src)) score += 4;
                    if (hasWallWords.test(src)) score += 3;
                    if (hasSpecWords.test(src)) score += 3;
                    if (vendorWords.test(src)) score += 2;
                    if (/\bmodel\b\s*[:=\-]?\s*[A-Za-z0-9][A-Za-z0-9 ._\/-]{1,40}/i.test(src)) score += 2;
                    if (vendorWords.test(src) && /\b(screen|wall|display|panel|cabinet|pitch|resolution|res|px|pixels?)\b/i.test(src)) score += 2;
                    if (/\bled\s*\d(?:\.\d+)?\b/i.test(src)) score += 2;
                    if (/\b(?:unilumin|absen|roe|infiled|leyard).{0,28}\b(?:2\.6|2\.9|2\.97|3\.9|3\.91|4\.8)\b/i.test(src)) score += 3;
                    return score;
                };

                for (const srcRaw of sources) {
                    const src = normalizeSpecText(srcRaw);
                    if (src.length < 8 || src.length > 500) continue;
                    scored.push({ src, score: scoreSource(src) });
                }

                const brandsFoundSet = new Set();
                for (const line of lines) {
                    const m = String(line || '').toLowerCase().match(vendorWords);
                    if (m && m[1]) brandsFoundSet.add(String(m[1]).replace(/\s+/g, ' ').trim());
                }

                scored.sort((a, b) => b.score - a.score || b.src.length - a.src.length);
                const extracted = [];

                for (const entry of scored) {
                    const src = entry.src;
                    const looksRelevant = (hasDims.test(src) || hasPanelCount.test(src) || hasScreenLikeDims.test(src)) && (hasWallWords.test(src) || hasSpecWords.test(src) || /\bvideo\b/i.test(src));
                    if (!looksRelevant && entry.score < 7) continue;

                    const chunks = splitIntoSegments(src).map(s => s.trim()).filter(Boolean);
                    for (const chunk of chunks) {
                        const parsed = parseSpecLine(chunk, getDefaults());
                        if (parsed) {
                            extracted.push(chunk);
                            continue;
                        }

                        try {
                            const led = parseLedWallFromText(chunk);
                            if (led && (led.pitchMm || (led.panelResW && led.panelResH) || (led.cabinetWmm && led.cabinetHmm))) {
                                const name = (inferWallName(chunk) || 'LED Wall').trim();
                                const parts = [name + ':'];
                                if (led.cabinetWmm && led.cabinetHmm) parts.push(`panel ${Math.round(led.cabinetWmm)}x${Math.round(led.cabinetHmm)}mm`);
                                if (led.panelResW && led.panelResH) parts.push(`panel pixel size ${led.panelResW}x${led.panelResH}`);
                                if (led.pitchMm) parts.push(`pitch ${led.pitchMm}mm`);
                                extracted.push(parts.join(', '));
                            }
                        } catch (_) {}
                    }
                }

                const uniqueExtracted = [...new Set(extracted)].slice(0, 120);
                const strictUnique = [...new Set(strictNearby)].slice(0, 120);
                const hasSizeDrivenEvidence = (line) => {
                    const s = normalizePdfOcrArtifacts(line);
                    const wall = /(\d+(?:\.\d+)?)\s*(m|meter|meters|metre|metres|cm|mm|ft|feet|in|inch|inches)\s*[x×]\s*(\d+(?:\.\d+)?)\s*(m|meter|meters|metre|metres|cm|mm|ft|feet|in|inch|inches)?/i.test(s);
                    if (!wall) return false;
                    const panel = /(?:panel|cabinet|module|tile)[^\d]{0,24}(\d{2,4})\s*[x×]\s*(\d{2,4})(?:\s*(mm|cm|m))?/i.test(s)
                        || /(\d{2,4})\s*[x×]\s*(\d{2,4})\s*(mm|cm|m)\b/i.test(s)
                        || /\bpanel\s+\d{2,4}\s*[x×]\s*\d{2,4}\b/i.test(s);
                    return wall && panel;
                };

                const fallbackBySize = uniqueExtracted.filter(hasSizeDrivenEvidence);
                const finalExtracted = strictUnique.length
                    ? strictUnique
                    : [...new Set([
                        ...fallbackBySize,
                        ...uniqueExtracted.filter((line) => {
                            const s = stripTrailingCountNoise(line);
                            if (!s || isCountNoiseLine(s)) return false;
                            const hasWall = /(\d+(?:\.\d+)?)\s*(m|meter|meters|metre|metres|cm|mm|ft|feet|in|inch|inches)\s*[x×]\s*(\d+(?:\.\d+)?)\s*(m|meter|meters|metre|metres|cm|mm|ft|feet|in|inch|inches)?/i.test(s);
                            const hasContext = /\b(led|wall|screen|display|video|panel|cabinet|module|tile|nos?|qty)\b/i.test(s);
                            return hasWall && hasContext;
                        })
                    ])].slice(0, 120);
                const matchedSamples = finalExtracted.slice(0, 20);
                const matchedLower = new Set(matchedSamples.map(s => String(s || '').toLowerCase()));
                const rejectedSamples = scored
                    .map((x) => x.src)
                    .filter((src) => !matchedLower.has(String(src || '').toLowerCase()))
                    .slice(0, 20);

                aiDebugState = {
                    totalLines: lines.length,
                    sourceCandidates: scored.length,
                    matchedCandidates: matchedSamples,
                    rejectedCandidates: rejectedSamples,
                    brandsFound: Array.from(brandsFoundSet)
                };
                renderDebugPanel();

                return finalExtracted;
            };

            const parseAll = () => {
                renderCurrentProjectLabel();
                const defaults = getDefaults();
                const rawLines = String(specsEl?.value || '').split(/\r?\n/).map(s => s.trim()).filter(Boolean);

                const lines = rawLines.flatMap(splitIntoSegments).filter(Boolean);
                if (segmentsEl) {
                    if (!lines.length) {
                        segmentsEl.textContent = 'Parsed Segments: none';
                    } else {
                        const sample = lines.slice(0, 8).map((seg, i) => `${i + 1}. ${seg}`).join('  |  ');
                        const extra = lines.length > 8 ? `  |  +${lines.length - 8} more` : '';
                        segmentsEl.textContent = `Parsed Segments (${lines.length}): ${sample}${extra}`;
                    }
                }
                parsedSpecs = lines.map(line => parseSpecLine(line, defaults)).filter(Boolean);
                if (!lines.length) {
                    aiDebugState = {
                        totalLines: 0,
                        sourceCandidates: 0,
                        matchedCandidates: [],
                        rejectedCandidates: [],
                        brandsFound: []
                    };
                }
                if (!parsedSpecs.length && !lines.length) {
                    parsedSpecs = [
                        {
                            name: 'AI Map 01',
                            screenWidthM: defaults.screenWidthM,
                            screenHeightM: defaults.screenHeightM,
                            panelWidthMm: defaults.panelWidthMm,
                            panelHeightMm: defaults.panelHeightMm,
                            panelResWidth: defaults.panelResWidth,
                            panelResHeight: defaults.panelResHeight,
                            pitchMm: defaults.pitchMm,
                            panelsWide: null,
                            panelsHigh: null,
                        }
                    ];
                }

                const beforeCount = parsedSpecs.length;
                parsedSpecs = dedupeSpecs(parsedSpecs);
                const dedupedCount = parsedSpecs.length;
                parsedSpecs = decorateSpecNames(parsedSpecs);

                renderPreview();
                if (parsedSpecs.length) {
                    const removed = beforeCount > dedupedCount ? ` (${beforeCount - dedupedCount} duplicate${beforeCount - dedupedCount > 1 ? 's' : ''} merged)` : '';
                    msgEl.textContent = `Parsed ${parsedSpecs.length} map${parsedSpecs.length > 1 ? 's' : ''}${removed}.`;
                } else {
                    msgEl.textContent = 'No valid lines parsed.';
                }
                renderDebugPanel();
                return parsedSpecs;
            };

            const parseBrandModel = (value) => {
                const src = String(value || '').trim();
                if (!src) return { brand: '', model: '' };
                const parts = src.split(/\s+/).filter(Boolean);
                if (parts.length <= 1) return { brand: src, model: '' };
                return { brand: parts[0], model: parts.slice(1).join(' ') };
            };

            const applyGeminiMaps = (rows) => {
                const defaults = getDefaults();
                const items = Array.isArray(rows) ? rows : [];
                const mapped = items.map((row, idx) => {
                    const widthM = Math.max(0.1, Number(row?.physical_width_meters) || defaults.screenWidthM);
                    const heightM = Math.max(0.1, Number(row?.physical_height_meters) || defaults.screenHeightM);
                    const totalResW = Math.max(1, Number(row?.total_resolution_width) || 0);
                    const totalResH = Math.max(1, Number(row?.total_resolution_height) || 0);
                    const pitchMm = Number.isFinite(Number(row?.pixel_pitch_mm)) ? Math.max(0.1, Number(row.pixel_pitch_mm)) : defaults.pitchMm;
                    const bm = parseBrandModel(row?.led_brand_model || '');

                    const panelResW = Math.max(1, defaults.panelResWidth);
                    const panelResH = Math.max(1, defaults.panelResHeight);
                    const panelWmm = Math.max(1, defaults.panelWidthMm);
                    const panelHmm = Math.max(1, defaults.panelHeightMm);
                    const panelsWide = totalResW > 0 ? Math.max(1, Math.round(totalResW / panelResW)) : Math.max(1, Math.ceil((widthM * 1000) / panelWmm));
                    const panelsHigh = totalResH > 0 ? Math.max(1, Math.round(totalResH / panelResH)) : Math.max(1, Math.ceil((heightM * 1000) / panelHmm));

                    return {
                        name: String(row?.screen_name || `AI Map ${String(idx + 1).padStart(2, '0')}`).trim(),
                        brand: bm.brand,
                        model: bm.model,
                        screenWidthM: widthM,
                        screenHeightM: heightM,
                        panelWidthMm: panelWmm,
                        panelHeightMm: panelHmm,
                        panelResWidth: panelResW,
                        panelResHeight: panelResH,
                        pitchMm,
                        panelsWide,
                        panelsHigh,
                    };
                }).filter((x) => Number.isFinite(x.screenWidthM) && Number.isFinite(x.screenHeightM));

                parsedSpecs = decorateSpecNames(dedupeSpecs(mapped));
                if (parsedSpecs.length) {
                    specsEl.value = parsedSpecs.map((m) => `${m.name}: screen ${m.screenWidthM.toFixed(3)}m x ${m.screenHeightM.toFixed(3)}m, panel ${Math.round(m.panelWidthMm)}x${Math.round(m.panelHeightMm)}mm, panel pixel size ${m.panelResWidth}x${m.panelResHeight}, pitch ${Number(m.pitchMm).toFixed(2)}mm`).join('\n');
                }
                renderPreview();
                aiDebugState = {
                    totalLines: parsedSpecs.length,
                    sourceCandidates: parsedSpecs.length,
                    matchedCandidates: parsedSpecs.map((x) => x.name),
                    rejectedCandidates: [],
                    brandsFound: parsedSpecs.map((x) => x.brand).filter(Boolean)
                };
                renderDebugPanel();
                return parsedSpecs.length;
            };

            const applyToProject = (targetProject, specs, replaceAll = false) => {
                if (!targetProject || !Array.isArray(specs) || !specs.length) return 0;
                if (!Array.isArray(targetProject.pixelMaps)) targetProject.pixelMaps = [];
                if (replaceAll) targetProject.pixelMaps = [];

                for (const spec of specs) {
                    const map = createNewPixelMapObject(targetProject.pixelMaps.length + 1);
                    map.name = spec.name || formatPixelMapName(targetProject.pixelMaps.length + 1);
                    map.screenDimensionsUnit = 'm';
                    map.screenWidthValue = Math.round(spec.screenWidthM * 1000) / 1000;
                    map.screenHeightValue = Math.round(spec.screenHeightM * 1000) / 1000;
                    map.panelDimensionsUnit = 'mm';
                    map.panelWidthMm = Math.max(1, Number(spec.panelWidthMm) || 500);
                    map.panelHeightMm = Math.max(1, Number(spec.panelHeightMm) || 500);
                    map.panelResWidth = Math.max(1, Number(spec.panelResWidth) || 128);
                    map.panelResHeight = Math.max(1, Number(spec.panelResHeight) || 128);
                    if (Number.isFinite(spec.pitchMm)) map.pitchMm = Number(spec.pitchMm);

                    const derivedPanelsWide = Number(spec.panelsWide) || Math.max(1, Math.ceil((map.screenWidthValue * 1000) / map.panelWidthMm));
                    const derivedPanelsHigh = Number(spec.panelsHigh) || Math.max(1, Math.ceil((map.screenHeightValue * 1000) / map.panelHeightMm));
                    const inferredTotalPanels = Math.max(1, derivedPanelsWide * derivedPanelsHigh);

                    map.details = map.details || {};
                    map.details.info = {
                        ...(map.details.info || {}),
                        enabled: true,
                        position: 'top-left',
                        displayMode: 'box',
                        bgTransparent: false,
                        badgeIncludeMetrics: true,
                        lineSpacing: Number(map.details?.info?.lineSpacing) || 50,
                        fontSize: Math.max(40, Number(map.details?.info?.fontSize) || 52),
                        badgeText: `${map.name}\n${derivedPanelsWide}x${derivedPanelsHigh} panels (${inferredTotalPanels})`
                    };
                    map.details.coords = {
                        ...(map.details.coords || {}),
                        enabled: true,
                        fontSize: Number(map.details?.coords?.fontSize) || 100
                    };

                    map.panels = Array(inferredTotalPanels).fill(true);
                    targetProject.pixelMaps.push(map);
                }

                targetProject.activePixelMapId = targetProject.pixelMaps[targetProject.pixelMaps.length - 1]?.id || null;
                return specs.length;
            };

            readPdfBtn?.addEventListener('click', () => {
                if (!pdfFileEl) return;
                pdfFileEl.value = '';
                pdfFileEl.click();
            });

            geminiSaveBtn?.addEventListener('click', async () => {
                try {
                    const key = String(geminiKeyInputEl?.value || '').trim();
                    if (!key) {
                        msgEl.textContent = 'Enter API key first.';
                        return;
                    }
                    if (!window.aiAutoMap || typeof window.aiAutoMap.saveKey !== 'function') {
                        sessionGeminiApiKey = key;
                        if (geminiKeyInputEl) geminiKeyInputEl.value = '';
                        msgEl.textContent = 'Saved as temporary session key (works now, not persisted).';
                        await refreshGeminiKeyStatus();
                        return;
                    }
                    const res = await window.aiAutoMap.saveKey({ apiKey: key });
                    if (!res?.ok) {
                        msgEl.textContent = res?.error || 'Failed to save API key.';
                        return;
                    }
                    if (geminiKeyInputEl) geminiKeyInputEl.value = '';
                    msgEl.textContent = 'Gemini API key saved securely.';
                    await refreshGeminiKeyStatus();
                } catch (error) {
                    msgEl.textContent = `Save key failed: ${error?.message || 'Unknown error'}`;
                }
            });

            geminiTestBtn?.addEventListener('click', async () => {
                try {
                    if (!window.aiAutoMap || typeof window.aiAutoMap.testKey !== 'function') {
                        if (sessionGeminiApiKey) msgEl.textContent = 'Session key set. Click Extract with Gemini to validate live.';
                        else msgEl.textContent = 'No session key set. Paste key and click Save Key first.';
                        return;
                    }
                    msgEl.textContent = 'Testing Gemini key…';
                    const res = await window.aiAutoMap.testKey();
                    if (!res?.ok) {
                        msgEl.textContent = res?.error || 'Key test failed.';
                        await refreshGeminiKeyStatus();
                        return;
                    }
                    msgEl.textContent = `Gemini key OK (${res.model || 'model verified'}).`;
                    await refreshGeminiKeyStatus();
                } catch (error) {
                    msgEl.textContent = `Key test failed: ${error?.message || 'Unknown error'}`;
                }
            });

            geminiClearBtn?.addEventListener('click', async () => {
                try {
                    if (!window.aiAutoMap || typeof window.aiAutoMap.clearKey !== 'function') {
                        sessionGeminiApiKey = '';
                        if (geminiKeyInputEl) geminiKeyInputEl.value = '';
                        msgEl.textContent = 'Session key cleared.';
                        await refreshGeminiKeyStatus();
                        return;
                    }
                    const res = await window.aiAutoMap.clearKey();
                    if (!res?.ok) {
                        msgEl.textContent = res?.error || 'Failed to clear key.';
                        return;
                    }
                    if (geminiKeyInputEl) geminiKeyInputEl.value = '';
                    msgEl.textContent = 'Saved Gemini key cleared.';
                    await refreshGeminiKeyStatus();
                } catch (error) {
                    msgEl.textContent = `Clear key failed: ${error?.message || 'Unknown error'}`;
                }
            });

            geminiBtn?.addEventListener('click', async () => {
                try {
                    if (!loadedPdfFile) {
                        msgEl.textContent = 'Load a PDF first, then click Extract with Gemini.';
                        return;
                    }
                    if (!window.aiAutoMap || typeof window.aiAutoMap.extractPdfSpecs !== 'function') {
                        msgEl.textContent = 'Gemini bridge is unavailable. Restart the app.';
                        return;
                    }

                    msgEl.textContent = 'Uploading PDF to Gemini…';
                    const buf = await loadedPdfFile.arrayBuffer();
                    const bytes = Array.from(new Uint8Array(buf));

                    const res = await window.aiAutoMap.extractPdfSpecs({
                        fileName: loadedPdfFile.name,
                        fileBytes: bytes,
                        apiKey: sessionGeminiApiKey || undefined,
                    });

                    if (!res?.ok) {
                        msgEl.textContent = res?.error || 'Gemini extraction failed.';
                        return;
                    }

                    const count = applyGeminiMaps(res.data || []);
                    if (!count) {
                        msgEl.textContent = 'Gemini returned no usable LED maps for current defaults.';
                        return;
                    }
                    msgEl.textContent = `Gemini extracted ${count} map${count > 1 ? 's' : ''}. Review and click Generate Pixel Maps.`;
                } catch (error) {
                    console.warn('Gemini extract failed', error);
                    msgEl.textContent = `Gemini extract failed: ${error?.message || 'Unknown error'}`;
                }
            });

            pdfFileEl?.addEventListener('change', async () => {
                try {
                    const file = pdfFileEl.files && pdfFileEl.files[0];
                    if (!file) return;
                    loadedPdfFile = file;
                    msgEl.textContent = 'Reading PDF (advanced mode)…';
                    await loadPdfPreview(file);
                    const text = await extractPdfText(file);
                    const structuredRows = await extractStructuredLinesFromPdf(file);
                    const lines = extractSpecLinesFromPdfText(text, structuredRows);
                    if (rawPdfTextEl) rawPdfTextEl.value = text || '';
                    const detectedServer = detectMediaServer(`${text || ''}\n${(structuredRows || []).join('\n')}`);
                    if (detectedServer && applyDetectedDeliverySpecPreset(detectedServer)) {
                        showNotification(`Detected media server: ${detectedServer}. Delivery spec updated.`);
                    }
                    if (!lines.length) {
                        msgEl.textContent = 'No clear LED specs from text layer. Running deep OCR fallback…';
                        const ocrResult = await runPdfOcr(file);
                        let ocrText = String(ocrResult?.text || '').trim();

                        if (!ocrText) {
                            const previewFallback = await runCanvasOcr(pdfCanvas);
                            if (previewFallback.text) ocrText = previewFallback.text;
                        }

                        if (ocrText) {
                            const merged = [text, ocrText].filter(Boolean).join('\n\n');
                            if (rawPdfTextEl) rawPdfTextEl.value = merged;
                            const ocrLines = extractSpecLinesFromPdfText(merged, structuredRows);
                            if (ocrLines.length) {
                                specsEl.value = ocrLines.join('\n');
                                parseAll();
                                msgEl.textContent = `Deep OCR imported ${ocrLines.length} spec line${ocrLines.length > 1 ? 's' : ''}.`;
                                return;
                            }
                        }

                        const quickChars = String(text || '').replace(/\s+/g, '').length;
                        if (quickChars < 60) msgEl.textContent = 'Image-based PDF detected, but OCR did not find clear LED specs. Edit extracted text and run extraction.';
                        else msgEl.textContent = 'No usable LED wall specs found in PDF. Edit extracted text and run extraction.';
                        return;
                    }
                    specsEl.value = lines.join('\n');
                    parseAll();
                    const tableHit = structuredRows.length ? `, ${structuredRows.length} structured rows` : '';
                    msgEl.textContent = `Imported ${lines.length} spec line${lines.length > 1 ? 's' : ''} from PDF${tableHit}.`;
                } catch (error) {
                    console.warn('PDF import failed', error);
                    msgEl.textContent = 'Failed to read PDF.';
                }
            });

            readDocxBtn?.addEventListener('click', () => {
                if (!docxFileEl) return;
                docxFileEl.value = '';
                docxFileEl.click();
            });

            docxFileEl?.addEventListener('change', async () => {
                try {
                    const file = docxFileEl.files && docxFileEl.files[0];
                    if (!file) return;
                    msgEl.textContent = 'Reading DOCX…';
                    const ok = await ensureDocxJs();
                    if (!ok) {
                        msgEl.textContent = 'DOCX reader unavailable. Please check internet access.';
                        return;
                    }
                    const arr = await file.arrayBuffer();
                    const result = await window.mammoth.extractRawText({ arrayBuffer: arr });
                    const docxText = String(result?.value || '').trim();
                    if (rawPdfTextEl) rawPdfTextEl.value = docxText;
                    const detectedServer = detectMediaServer(docxText);
                    if (detectedServer && applyDetectedDeliverySpecPreset(detectedServer)) {
                        showNotification(`Detected media server: ${detectedServer}. Delivery spec updated.`);
                    }
                    if (!docxText) {
                        msgEl.textContent = 'DOCX loaded but no readable text found.';
                        return;
                    }
                    const lines = extractSpecLinesFromPdfText(docxText, []);
                    if (!lines.length) {
                        msgEl.textContent = 'DOCX text loaded. No LED specs auto-detected; edit text and extract.';
                        return;
                    }
                    specsEl.value = lines.join('\n');
                    parseAll();
                    msgEl.textContent = `DOCX imported. Found ${lines.length} spec line${lines.length > 1 ? 's' : ''}.`;
                } catch (e) {
                    console.warn('DOCX import failed', e);
                    msgEl.textContent = `DOCX read failed: ${e?.message || 'Unknown error'}`;
                }
            });

            runOcrBtn?.addEventListener('click', async () => {
                if (!loadedPdfFile) {
                    msgEl.textContent = 'Load a PDF first.';
                    return;
                }
                const ocrResult = await runPdfOcr(loadedPdfFile);
                let textForUse = String(ocrResult?.text || '').trim();
                let pagesProcessed = Number(ocrResult?.pagesProcessed || 0);

                if (!textForUse) {
                    const previewFallback = await runCanvasOcr(pdfCanvas);
                    if (previewFallback.text) {
                        textForUse = previewFallback.text;
                        pagesProcessed = Math.max(1, pagesProcessed);
                    } else {
                        msgEl.textContent = ocrResult?.error || previewFallback.error || 'OCR failed.';
                        return;
                    }
                }
                const existing = String(rawPdfTextEl?.value || '').trim();
                const mergedText = existing ? `${existing}\n\n${textForUse}` : textForUse;
                if (rawPdfTextEl) rawPdfTextEl.value = mergedText;
                const detectedServer = detectMediaServer(mergedText);
                if (detectedServer && applyDetectedDeliverySpecPreset(detectedServer)) {
                    showNotification(`Detected media server: ${detectedServer}. Delivery spec updated.`);
                }
                const lines = extractSpecLinesFromPdfText(mergedText, []);
                if (lines.length) {
                    specsEl.value = lines.join('\n');
                    parseAll();
                    msgEl.textContent = `OCR complete (${pagesProcessed} page${pagesProcessed > 1 ? 's' : ''}). Imported ${lines.length} spec line${lines.length > 1 ? 's' : ''}.`;
                } else {
                    msgEl.textContent = `OCR complete (${pagesProcessed} page${pagesProcessed > 1 ? 's' : ''}), but no LED specs matched. Edit OCR text and extract again.`;
                }
            });

            rawToSpecsBtn?.addEventListener('click', () => {
                const raw = String(rawPdfTextEl?.value || '').trim();
                if (!raw) {
                    msgEl.textContent = 'No extracted text to process.';
                    return;
                }
                const lines = extractSpecLinesFromPdfText(raw, []);
                if (!lines.length) {
                    msgEl.textContent = 'No LED wall specs found in edited text.';
                    return;
                }
                specsEl.value = lines.join('\n');
                parseAll();
                msgEl.textContent = `Extracted ${lines.length} spec line${lines.length > 1 ? 's' : ''} from edited text.`;
            });

            pdfPrevBtn?.addEventListener('click', async () => {
                if (!loadedPdfDoc || loadedPdfPage <= 1) return;
                loadedPdfPage -= 1;
                await renderLoadedPdfPage();
            });

            pdfNextBtn?.addEventListener('click', async () => {
                if (!loadedPdfDoc || loadedPdfPage >= loadedPdfPageCount) return;
                loadedPdfPage += 1;
                await renderLoadedPdfPage();
            });

            parseBtn?.addEventListener('click', () => parseAll());
            generateBtn?.addEventListener('click', () => {
                const specs = parseAll();
                if (!specs.length) {
                    msgEl.textContent = 'Nothing to generate. Add at least one valid spec line.';
                    return;
                }

                let project = getCurrentProject();
                if (!project) {
                    msgEl.textContent = 'No active project. Please create/select one from the Projects tab.';
                    showNotification('Select a project first (Projects tab).');
                    renderCurrentProjectLabel();
                    return;
                }

                const createdCount = applyToProject(project, specs, false);
                if (!createdCount) {
                    msgEl.textContent = 'Failed to create maps.';
                    return;
                }

                state.activeProjectId = project.id;
                state.pdfExport.selectedProjectId = project.id;
                persistProjects();
                renderCurrentProjectLabel();

                msgEl.textContent = `Created ${createdCount} map${createdCount > 1 ? 's' : ''} in "${project.name}".`;
                showNotification(`Created ${createdCount} map${createdCount > 1 ? 's' : ''}`);
                switchTab('designer');
            });

            renderPreview();
            renderCurrentProjectLabel();
            renderDebugPanel();
            refreshGeminiKeyStatus();
        };

        // ─── Video / Audio Converter Tab ─────────────────────────────────────────
        const renderVideoConverterTab = (() => {
            // --- State ---
            let vcState = {
                files: [],           // [{ path, name, probeResult }]
                outputDir: null,
                format: 'mp4',
                videoCodec: 'libx264',
                audioCodec: 'aac',
                videoBitrate: '8000k',
                audioBitrate: '320k',
                audioSampleRate: '48000',
                audioChannels: '2',
                resolution: '',
                fps: '',
                proResProfile: '3',
                jobs: [],            // [{ id, name, status, percent, outputPath, error }]
                progressUnsubscribe: null,
                customFfmpegPath: (() => { try { return localStorage.getItem('vc-custom-ffmpeg') || ''; } catch(_) { return ''; } })(),
                hapInstallStatus: null,  // null | 'checking' | 'ready' | 'not-installed' | 'downloading' | 'extracting' | 'error'
                hapDownloadPercent: 0,
                hapDownloadedMB: '0',
                hapTotalMB: '?',
                hapDownloadError: '',
            };

            const FORMAT_PRESETS = {
                // Standard video
                mp4:    { label: 'MP4 (H.264/AAC — universal)',         vcodec: 'libx264',    acodec: 'aac',        vbr: '8000k', abr: '320k', ext: 'mp4' },
                h265:   { label: 'MP4 (H.265/HEVC — smaller files)',    vcodec: 'libx265',    acodec: 'aac',        vbr: '5000k', abr: '320k', ext: 'mp4' },
                prores: { label: 'ProRes (MOV — editing/production)',   vcodec: 'prores_ks',  acodec: 'pcm_s16le',  vbr: '',      abr: '',     ext: 'mov' },
                dnxhd:  { label: 'DNxHD (MOV — Avid-compatible)',       vcodec: 'dnxhd',      acodec: 'pcm_s16le',  vbr: '185M',  abr: '',     ext: 'mov' },
                mov_h264:{ label: 'MOV (H.264 — QuickTime)',            vcodec: 'libx264',    acodec: 'aac',        vbr: '8000k', abr: '320k', ext: 'mov' },
                avi:    { label: 'AVI (legacy compatibility)',           vcodec: 'libxvid',    acodec: 'mp3',        vbr: '4000k', abr: '192k', ext: 'avi' },
                webm:   { label: 'WebM (VP9/Opus — web streaming)',     vcodec: 'libvpx-vp9', acodec: 'libopus',    vbr: '4000k', abr: '192k', ext: 'webm' },
                gif:    { label: 'Animated GIF',                        vcodec: 'gif',        acodec: null,         vbr: '',      abr: '',     ext: 'gif' },
                // HAP / Notch / DXV (require full FFmpeg build)
                hap:    { label: 'HAP (MOV — realtime VJ playback)',    vcodec: 'hap',        acodec: 'pcm_s16le',  vbr: '',      abr: '',     ext: 'mov', hapFormat: null,       needsHap: true },
                hap_q:  { label: 'HAP Q (MOV — high quality)',          vcodec: 'hap',        acodec: 'pcm_s16le',  vbr: '',      abr: '',     ext: 'mov', hapFormat: 'hap_q',    needsHap: true },
                hap_a:  { label: 'HAP Alpha (MOV — transparency)',      vcodec: 'hap',        acodec: 'pcm_s16le',  vbr: '',      abr: '',     ext: 'mov', hapFormat: 'hap_alpha', needsHap: true },
                notch:  { label: 'Notch Block (HAP Q — optimised)',     vcodec: 'hap',        acodec: 'pcm_s16le',  vbr: '',      abr: '',     ext: 'mov', hapFormat: 'hap_q',    needsHap: true, notch: true },
                notchlc:{ label: 'Notch LC (MOV — Notch lightweight)',   vcodec: 'notchlc',    acodec: 'pcm_s16le',  vbr: '',      abr: '',     ext: 'mov', needsHap: true, needsCustomEncoder: true },
                dxv:    { label: 'DXV (MOV — Resolume playback)',        vcodec: 'dxv',        acodec: 'pcm_s16le',  vbr: '',      abr: '',     ext: 'mov', needsHap: true },
                // Audio-only
                mp3:    { label: 'MP3 (audio only)',                    vcodec: 'none',       acodec: 'libmp3lame', vbr: '',      abr: '320k', ext: 'mp3' },
                wav:    { label: 'WAV (uncompressed PCM — broadcast)',  vcodec: 'none',       acodec: 'pcm_s24le',  vbr: '',      abr: '',     ext: 'wav' },
                aac:    { label: 'AAC (audio only)',                    vcodec: 'none',       acodec: 'aac',        vbr: '',      abr: '256k', ext: 'aac' },
                flac:   { label: 'FLAC (lossless audio)',               vcodec: 'none',       acodec: 'flac',       vbr: '',      abr: '',     ext: 'flac' },
            };

            const RESOLUTION_PRESETS = ['', '3840x2160', '1920x1080', '1280x720', '720x480', '640x360'];
            const FPS_PRESETS = ['', '60', '50', '30', '29.97', '25', '24', '23.976'];

            let progressUnsub = null;
            let hapDownloadUnsub = null;

            const checkHapInstall = async () => {
                vcState.hapInstallStatus = 'checking';
                render();
                try {
                    const result = await window.videoConverter?.checkFullFfmpeg?.();
                    vcState.hapInstallStatus = (result?.hasHap && result?.hasDxv) ? 'ready' : (result?.installed ? 'not-installed' : 'not-installed');
                } catch (_) {
                    vcState.hapInstallStatus = 'not-installed';
                }
                render();
            };

            const startHapDownload = async () => {
                vcState.hapInstallStatus = 'downloading';
                vcState.hapDownloadPercent = 0;
                vcState.hapDownloadError = '';
                render();

                // Listen for download progress
                if (hapDownloadUnsub) { try { hapDownloadUnsub(); } catch(_) {} }
                hapDownloadUnsub = window.videoConverter?.onFfmpegDownload?.((data) => {
                    if (data.type === 'progress') {
                        vcState.hapDownloadPercent = data.percent;
                        vcState.hapDownloadedMB = data.downloadedMB;
                        vcState.hapTotalMB = data.totalMB;
                        vcState.hapInstallStatus = 'downloading';
                    } else if (data.type === 'extracting') {
                        vcState.hapInstallStatus = 'extracting';
                    }
                    render();
                });

                const result = await window.videoConverter?.downloadFullFfmpeg?.();
                if (hapDownloadUnsub) { try { hapDownloadUnsub(); } catch(_) {} }

                if (result?.ok) {
                    vcState.hapInstallStatus = 'ready';
                } else {
                    vcState.hapInstallStatus = 'error';
                    vcState.hapDownloadError = result?.error || 'Unknown error';
                }
                render();
            };

            const render = () => {
                const c = mainContent['video-converter'];
                if (!c) return;

                const fmt = FORMAT_PRESETS[vcState.format] || FORMAT_PRESETS.mp4;
                const isAudioOnly = fmt.vcodec === 'none';
                const isHap = !!fmt.needsHap;

                // Auto-check HAP status when HAP format is selected
                if (isHap && vcState.hapInstallStatus === null) {
                    checkHapInstall();
                }

                c.innerHTML = `
                <div class="p-6 space-y-6">
                    <header class="bg-gray-800/70 border border-gray-700 rounded-xl p-6">
                        <div class="flex items-center justify-between flex-wrap gap-3">
                            <div class="flex items-center gap-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#fb7185" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="2"/><path d="m7 2 5 10 5-10"/><path d="M2 12h20"/></svg>
                                <h2 class="text-2xl font-bold text-white">Video &amp; Audio Converter</h2>
                            </div>
                            <span class="text-xs text-gray-400 bg-gray-700/60 px-2 py-1 rounded">Powered by FFmpeg</span>
                        </div>
                        <p class="text-gray-300 mt-1 text-sm">Convert video and audio files to any format — ProRes, DNxHD, H.264, HAP, HAP Q (Notch), WAV 48kHz/24-bit, and more.</p>
                    </header>

                    <!-- Step 1: Add files -->
                    <section class="bg-gray-800/70 border border-gray-700 rounded-xl p-5 space-y-3">
                        <div class="flex items-center justify-between flex-wrap gap-2">
                            <h3 class="text-lg font-semibold text-rose-300">1 — Source Files</h3>
                            <div class="flex gap-2">
                                <button id="vc-add-files" class="px-3 py-1.5 rounded bg-rose-600 hover:bg-rose-700 text-sm font-semibold text-white">+ Add Files</button>
                                <button id="vc-clear-files" class="px-3 py-1.5 rounded bg-gray-600 hover:bg-gray-500 text-sm text-white">Clear All</button>
                            </div>
                        </div>
                        ${vcState.files.length === 0 ? `
                        <div class="border-2 border-dashed border-gray-600 rounded-xl p-8 text-center text-gray-500 text-sm">
                            Click <span class="text-white font-semibold">+ Add Files</span> to select video or audio files.<br/>
                            Multiple files supported — all will be converted with the same settings.
                        </div>` : `
                        <div class="space-y-2 max-h-48 overflow-y-auto pr-1">
                            ${vcState.files.map((f, i) => `
                            <div class="flex items-center gap-3 bg-gray-900/60 rounded-lg px-3 py-2 text-sm">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fb7185" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z"/><polyline points="14 2 14 8 20 8"/></svg>
                                <span class="flex-1 text-gray-200 truncate" title="${f.path}">${f.name}</span>
                                ${f.probeResult ? `<span class="text-xs text-gray-500 shrink-0">${f.probeResult.format || ''} · ${f.probeResult.duration ? (f.probeResult.duration / 60).toFixed(1) + ' min' : ''}</span>` : '<span class="text-xs text-gray-500">probing…</span>'}
                                <button class="vc-remove-file text-gray-500 hover:text-rose-400" data-idx="${i}" title="Remove">✕</button>
                            </div>`).join('')}
                        </div>`}
                    </section>

                    <!-- Step 2: Output directory -->
                    <section class="bg-gray-800/70 border border-gray-700 rounded-xl p-5 space-y-3">
                        <h3 class="text-lg font-semibold text-rose-300">2 — Output Folder</h3>
                        <div class="flex items-center gap-3">
                            <div class="flex-1 bg-gray-900/60 rounded px-3 py-2 text-sm text-gray-300 truncate">
                                ${vcState.outputDir || '<span class="text-gray-500">No folder selected</span>'}
                            </div>
                            <button id="vc-pick-output" class="px-3 py-1.5 rounded bg-gray-600 hover:bg-gray-500 text-sm text-white shrink-0">Browse…</button>
                        </div>
                    </section>

                    <!-- Step 3: Format & settings -->
                    <section class="bg-gray-800/70 border border-gray-700 rounded-xl p-5 space-y-4">
                        <h3 class="text-lg font-semibold text-rose-300">3 — Format &amp; Settings</h3>

                        <!-- Format preset -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div class="space-y-1">
                                <label class="text-xs text-gray-400 uppercase tracking-wider">Output Format / Preset</label>
                                <select id="vc-format" class="w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-sm text-white">
                                    <optgroup label="— Standard Video —">
                                        ${Object.entries(FORMAT_PRESETS).filter(([,v])=>v.vcodec!=='none' && !v.needsHap).map(([k,v])=>`<option value="${k}" ${vcState.format===k?'selected':''}>${v.label}</option>`).join('')}
                                    </optgroup>
                                    <optgroup label="— HAP / Notch / DXV (requires full FFmpeg) —">
                                        ${Object.entries(FORMAT_PRESETS).filter(([,v])=>v.needsHap).map(([k,v])=>`<option value="${k}" ${vcState.format===k?'selected':''}>${v.label}${v.needsCustomEncoder?' ⚠ custom encoder':''}  </option>`).join('')}
                                    </optgroup>
                                    <optgroup label="— Audio Only —">
                                        ${Object.entries(FORMAT_PRESETS).filter(([,v])=>v.vcodec==='none').map(([k,v])=>`<option value="${k}" ${vcState.format===k?'selected':''}>${v.label}</option>`).join('')}
                                    </optgroup>
                                </select>
                            </div>
                            <div class="space-y-1">
                                <label class="text-xs text-gray-400 uppercase tracking-wider">Resolution Override</label>
                                <select id="vc-resolution" class="w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-sm text-white">
                                    ${RESOLUTION_PRESETS.map(r=>`<option value="${r}" ${vcState.resolution===r?'selected':''}>${r||'Keep original'}</option>`).join('')}
                                </select>
                            </div>
                            ${!isAudioOnly && !isHap ? `
                            <div class="space-y-1">
                                <label class="text-xs text-gray-400 uppercase tracking-wider">Video Bitrate</label>
                                <input id="vc-vbr" type="text" value="${vcState.videoBitrate}" placeholder="e.g. 8000k, 50M"
                                    class="w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-sm text-white"/>
                            </div>` : ''}
                            ${!isAudioOnly ? `
                            <div class="space-y-1">
                                <label class="text-xs text-gray-400 uppercase tracking-wider">Frame Rate Override</label>
                                <select id="vc-fps" class="w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-sm text-white">
                                    ${FPS_PRESETS.map(f=>`<option value="${f}" ${vcState.fps===f?'selected':''}>${f||'Keep original'}</option>`).join('')}
                                </select>
                            </div>` : ''}
                            ${vcState.format === 'prores' ? `
                            <div class="space-y-1 col-span-full">
                                <label class="text-xs text-gray-400 uppercase tracking-wider">ProRes Profile</label>
                                <select id="vc-prores" class="w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-sm text-white">
                                    <option value="0" ${vcState.proResProfile==='0'?'selected':''}>0 — ProRes 422 Proxy</option>
                                    <option value="1" ${vcState.proResProfile==='1'?'selected':''}>1 — ProRes 422 LT</option>
                                    <option value="2" ${vcState.proResProfile==='2'?'selected':''}>2 — ProRes 422</option>
                                    <option value="3" ${vcState.proResProfile==='3'?'selected':''}>3 — ProRes 422 HQ</option>
                                    <option value="4" ${vcState.proResProfile==='4'?'selected':''}>4 — ProRes 4444</option>
                                    <option value="5" ${vcState.proResProfile==='5'?'selected':''}>5 — ProRes 4444 XQ</option>
                                </select>
                            </div>` : ''}

                            <!-- Audio settings -->
                            <div class="space-y-1">
                                <label class="text-xs text-gray-400 uppercase tracking-wider">Audio Sample Rate</label>
                                <select id="vc-samplerate" class="w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-sm text-white">
                                    <option value="">Keep original</option>
                                    <option value="48000" ${vcState.audioSampleRate==='48000'?'selected':''}>48000 Hz (broadcast standard)</option>
                                    <option value="44100" ${vcState.audioSampleRate==='44100'?'selected':''}>44100 Hz</option>
                                    <option value="96000" ${vcState.audioSampleRate==='96000'?'selected':''}>96000 Hz</option>
                                </select>
                            </div>
                            <div class="space-y-1">
                                <label class="text-xs text-gray-400 uppercase tracking-wider">Audio Channels</label>
                                <select id="vc-channels" class="w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-sm text-white">
                                    <option value="">Keep original</option>
                                    <option value="1" ${vcState.audioChannels==='1'?'selected':''}>Mono (1ch)</option>
                                    <option value="2" ${vcState.audioChannels==='2'?'selected':''}>Stereo (2ch)</option>
                                    <option value="6" ${vcState.audioChannels==='6'?'selected':''}>5.1 Surround (6ch)</option>
                                    <option value="8" ${vcState.audioChannels==='8'?'selected':''}>7.1 Surround (8ch)</option>
                                </select>
                            </div>
                            ${!isAudioOnly && !isHap ? `
                            <div class="space-y-1">
                                <label class="text-xs text-gray-400 uppercase tracking-wider">Audio Bitrate (lossy codecs)</label>
                                <input id="vc-abr" type="text" value="${vcState.audioBitrate}" placeholder="e.g. 320k, 256k"
                                    class="w-full bg-gray-900 border border-gray-600 rounded px-3 py-2 text-sm text-white"/>
                            </div>` : ''}
                        </div>

                        <!-- HAP & Notch support section -->
                        ${isHap ? `
                        <div class="border border-amber-600/60 bg-amber-950/40 rounded-xl p-4 space-y-3">
                            <div class="flex items-start gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="${vcState.hapInstallStatus === 'ready' ? '#34d399' : '#fcd34d'}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                                <div class="flex-1">
                                    <p class="text-amber-200 text-sm font-semibold">HAP, Notch &amp; DXV Encoding</p>
                                    <p class="text-amber-200/70 text-xs mt-0.5">Requires a full FFmpeg build with snappy/HAP/DXV support.</p>
                                </div>
                                ${vcState.hapInstallStatus === 'ready' ? '<span class="text-xs bg-emerald-700 text-emerald-200 px-2 py-1 rounded font-semibold shrink-0">✓ Ready</span>' : ''}
                            </div>

                            ${vcState.hapInstallStatus === 'checking' ? `
                                <p class="text-sm text-amber-300 animate-pulse">Checking HAP support…</p>
                            ` : vcState.hapInstallStatus === 'ready' ? `
                                <p class="text-xs text-emerald-400">HAP, Notch &amp; DXV encoding is available. Full FFmpeg build detected.</p>
                                ${fmt.needsCustomEncoder ? '<p class="text-xs text-amber-400 mt-1">⚠ <strong>Notch LC</strong> requires a custom FFmpeg with the notchlc encoder — this is proprietary and not included in standard builds. Provide your own FFmpeg path below if you have one.</p>' : ''}
                            ` : vcState.hapInstallStatus === 'downloading' ? `
                                <div class="space-y-2">
                                    <p class="text-sm text-amber-300">Downloading full FFmpeg build…</p>
                                    <div class="w-full bg-gray-700/80 rounded-full h-3 overflow-hidden">
                                        <div class="bg-gradient-to-r from-amber-600 to-amber-400 h-3 rounded-full transition-all" style="width:${Math.max(vcState.hapDownloadPercent || 0, 2)}%"></div>
                                    </div>
                                    <p class="text-xs text-gray-400">${vcState.hapDownloadPercent}% — ${vcState.hapDownloadedMB || '0'} / ${vcState.hapTotalMB || '?'} MB</p>
                                </div>
                            ` : vcState.hapInstallStatus === 'extracting' ? `
                                <div class="space-y-2">
                                    <p class="text-sm text-amber-300 animate-pulse">Extracting FFmpeg… this may take a moment.</p>
                                    <div class="w-full bg-gray-700/80 rounded-full h-3 overflow-hidden">
                                        <div class="bg-gradient-to-r from-amber-600 to-amber-400 h-3 rounded-full animate-pulse" style="width:100%"></div>
                                    </div>
                                </div>
                            ` : vcState.hapInstallStatus === 'error' ? `
                                <div class="space-y-2">
                                    <p class="text-xs text-red-400">${vcState.hapDownloadError}</p>
                                    <button id="vc-download-ffmpeg" class="px-4 py-2 rounded bg-amber-700 hover:bg-amber-600 text-sm font-semibold text-white">↻ Retry Download</button>
                                </div>
                            ` : `
                                <div class="space-y-2">
                                    <p class="text-xs text-amber-200/60">HAP/DXV support is not installed. Click below to download a full FFmpeg build (~130 MB, one-time setup).</p>
                                    <button id="vc-download-ffmpeg" class="px-4 py-2 rounded bg-amber-700 hover:bg-amber-600 text-sm font-semibold text-white">↓ Install HAP, Notch &amp; DXV Support</button>
                                </div>
                            `}

                            <details class="text-xs">
                                <summary class="text-amber-300/60 cursor-pointer hover:text-amber-300">Advanced: Use custom FFmpeg path instead</summary>
                                <div class="mt-2 flex gap-2">
                                    <input id="vc-custom-ffmpeg" type="text" value="${vcState.customFfmpegPath || ''}" placeholder="C:\\path\\to\\ffmpeg.exe"
                                        class="flex-1 bg-gray-900 border border-amber-600/60 rounded px-3 py-2 text-sm text-white font-mono"/>
                                    <button id="vc-browse-ffmpeg" class="px-3 py-1.5 rounded bg-gray-600 hover:bg-gray-500 text-sm text-white shrink-0">Browse…</button>
                                </div>
                            </details>
                        </div>` : ''}

                        <!-- Quick-pick broadcast presets -->
                        <div class="border-t border-gray-700 pt-3 space-y-2">
                            <p class="text-xs text-gray-400 uppercase tracking-wider">Quick Broadcast Presets</p>
                            <div class="flex flex-wrap gap-2">
                                <button class="vc-quick-preset px-3 py-1.5 rounded bg-indigo-700 hover:bg-indigo-600 text-xs text-white font-semibold" data-preset="prores_hq_1080">ProRes HQ 1080p25</button>
                                <button class="vc-quick-preset px-3 py-1.5 rounded bg-indigo-700 hover:bg-indigo-600 text-xs text-white font-semibold" data-preset="prores_hq_1080_30">ProRes HQ 1080p30</button>
                                <button class="vc-quick-preset px-3 py-1.5 rounded bg-indigo-700 hover:bg-indigo-600 text-xs text-white font-semibold" data-preset="h264_1080_25">H.264 1080p25</button>
                                <button class="vc-quick-preset px-3 py-1.5 rounded bg-indigo-700 hover:bg-indigo-600 text-xs text-white font-semibold" data-preset="h264_4k_25">H.264 4K25</button>
                                <button class="vc-quick-preset px-3 py-1.5 rounded bg-rose-700 hover:bg-rose-600 text-xs text-white font-semibold" data-preset="hap_q_1080_25">Notch HAP Q 1080p25</button>
                                <button class="vc-quick-preset px-3 py-1.5 rounded bg-rose-700 hover:bg-rose-600 text-xs text-white font-semibold" data-preset="hap_q_1080_30">Notch HAP Q 1080p30</button>
                                <button class="vc-quick-preset px-3 py-1.5 rounded bg-orange-700 hover:bg-orange-600 text-xs text-white font-semibold" data-preset="hap_1080_25">HAP 1080p25</button>
                                <button class="vc-quick-preset px-3 py-1.5 rounded bg-purple-700 hover:bg-purple-600 text-xs text-white font-semibold" data-preset="dxv_1080_25">DXV 1080p25</button>
                                <button class="vc-quick-preset px-3 py-1.5 rounded bg-purple-700 hover:bg-purple-600 text-xs text-white font-semibold" data-preset="dxv_1080_30">DXV 1080p30</button>
                                <button class="vc-quick-preset px-3 py-1.5 rounded bg-sky-700 hover:bg-sky-600 text-xs text-white font-semibold" data-preset="wav_48_24">WAV 48kHz/24-bit</button>
                                <button class="vc-quick-preset px-3 py-1.5 rounded bg-sky-700 hover:bg-sky-600 text-xs text-white font-semibold" data-preset="mp3_320">MP3 320kbps</button>
                                <button class="vc-quick-preset px-3 py-1.5 rounded bg-sky-700 hover:bg-sky-600 text-xs text-white font-semibold" data-preset="aac_256">AAC 256kbps</button>
                            </div>
                        </div>
                    </section>

                    <!-- Step 4: Convert -->
                    <section class="bg-gray-800/70 border border-gray-700 rounded-xl p-5 space-y-3">
                        <div class="flex items-center justify-between flex-wrap gap-2">
                            <h3 class="text-lg font-semibold text-rose-300">4 — Convert</h3>
                            <button id="vc-start-all" class="px-5 py-2 rounded-lg bg-rose-600 hover:bg-rose-700 text-sm font-bold text-white disabled:opacity-40 disabled:cursor-not-allowed" ${(vcState.files.length === 0 || !vcState.outputDir) ? 'disabled' : ''}>
                                ▶ Start Conversion
                            </button>
                        </div>
                        ${vcState.files.length === 0 ? '<p class="text-xs text-gray-500">Add source files and select an output folder first.</p>' :
                          !vcState.outputDir ? '<p class="text-xs text-gray-500">Select an output folder to enable conversion.</p>' :
                          `<p class="text-xs text-gray-400">${vcState.files.length} file${vcState.files.length>1?'s':''} will be converted to <span class="text-white font-semibold">.${fmt.ext}</span> and saved to the output folder.</p>`}

                        <!-- Jobs list -->
                        ${vcState.jobs.length > 0 ? `
                        <div class="space-y-2 mt-2">
                            <div class="flex items-center justify-between">
                                <p class="text-xs text-gray-400 uppercase tracking-wider">Conversion Queue</p>
                                <button id="vc-clear-jobs" class="text-xs text-gray-500 hover:text-rose-400">Clear finished</button>
                            </div>
                            ${vcState.jobs.map(job => `
                            <div class="bg-gray-900/70 rounded-lg px-3 py-2 space-y-1">
                                <div class="flex items-center justify-between gap-2 text-sm">
                                    <span class="truncate text-gray-200 flex-1" title="${job.name}">${job.name}</span>
                                    <span class="shrink-0 text-xs px-2 py-0.5 rounded font-semibold ${
                                        job.status === 'done' ? 'bg-emerald-800 text-emerald-200' :
                                        job.status === 'error' ? 'bg-red-800 text-red-200' :
                                        job.status === 'cancelled' ? 'bg-gray-600 text-gray-300' :
                                        job.status === 'running' ? 'bg-sky-800 text-sky-200' :
                                        'bg-gray-700 text-gray-300'
                                    }">${job.status === 'running' ? (job.percent != null ? job.percent.toFixed(0)+'%' : 'starting…') : job.status}</span>
                                    ${job.status === 'running' ? `<button class="vc-cancel-job text-xs text-rose-400 hover:text-rose-200 shrink-0" data-jobid="${job.id}">Cancel</button>` : ''}
                                    ${job.status === 'done' ? `<button class="vc-open-folder text-xs text-sky-400 hover:text-sky-200 shrink-0" data-folder="${job.outputFolder}">📂 Open</button>` : ''}
                                </div>
                                <div class="w-full bg-gray-700/80 rounded-full h-3 mt-1 overflow-hidden">
                                    <div class="h-3 rounded-full transition-all duration-300 ${
                                        job.status === 'done' ? 'bg-emerald-500' :
                                        job.status === 'error' ? 'bg-red-500' :
                                        job.status === 'cancelled' ? 'bg-gray-500' :
                                        job.status === 'running' ? 'bg-gradient-to-r from-rose-600 to-rose-400' :
                                        'bg-gray-600'
                                    }" style="width:${
                                        job.status === 'done' ? 100 :
                                        job.status === 'error' || job.status === 'cancelled' ? 100 :
                                        Math.max(job.percent || 0, job.status === 'running' ? 2 : 0)
                                    }%"></div>
                                </div>
                                ${job.status === 'running' && job.timemark ? `<p class="text-xs text-gray-400 mt-0.5">Time: ${job.timemark}${job.currentFps ? ' · ' + job.currentFps + ' fps' : ''}</p>` : ''}
                                ${job.error ? `<p class="text-xs text-red-400 mt-0.5">${job.error}</p>` : ''}
                            </div>`).join('')}
                        </div>` : ''}
                    </section>
                </div>`;

                // ── Wire events ──────────────────────────────────────────────
                const byId = id => c.querySelector('#' + id);

                byId('vc-add-files')?.addEventListener('click', async (evt) => {
                    const btn = evt.currentTarget;
                    const origText = btn.textContent;
                    btn.textContent = 'Opening…';
                    btn.disabled = true;
                    try {
                        if (!window.videoConverter) throw new Error('videoConverter API not available — please restart the app.');
                        const paths = await window.videoConverter.pickFiles();
                        if (!paths || !paths.length) return;
                        for (const p of paths) {
                            if (vcState.files.find(f => f.path === p)) continue;
                            const entry = { path: p, name: p.split(/[\\/]/).pop(), probeResult: null };
                            vcState.files.push(entry);
                            window.videoConverter?.probe(p).then(res => {
                                if (res.ok) entry.probeResult = res;
                                render();
                            }).catch(() => {});
                        }
                        render();
                    } catch (err) {
                        alert('Could not open file picker:\n' + err.message);
                        btn.textContent = origText;
                        btn.disabled = false;
                    }
                });

                byId('vc-clear-files')?.addEventListener('click', () => {
                    vcState.files = [];
                    render();
                });

                c.querySelectorAll('.vc-remove-file').forEach(btn => {
                    btn.addEventListener('click', () => {
                        const idx = parseInt(btn.dataset.idx, 10);
                        vcState.files.splice(idx, 1);
                        render();
                    });
                });

                byId('vc-pick-output')?.addEventListener('click', async () => {
                    const dir = await window.videoConverter?.pickOutputDir();
                    if (dir) { vcState.outputDir = dir; render(); }
                });

                byId('vc-format')?.addEventListener('change', (e) => {
                    const preset = FORMAT_PRESETS[e.target.value];
                    if (!preset) return;
                    vcState.format      = e.target.value;
                    vcState.videoCodec  = preset.vcodec;
                    vcState.audioCodec  = preset.acodec;
                    vcState.videoBitrate = preset.vbr;
                    vcState.audioBitrate = preset.abr;
                    render();
                });

                byId('vc-resolution')?.addEventListener('change', e => { vcState.resolution = e.target.value; });
                byId('vc-fps')?.addEventListener('change', e => { vcState.fps = e.target.value; });
                byId('vc-vbr')?.addEventListener('input', e => { vcState.videoBitrate = e.target.value; });
                byId('vc-abr')?.addEventListener('input', e => { vcState.audioBitrate = e.target.value; });
                byId('vc-samplerate')?.addEventListener('change', e => { vcState.audioSampleRate = e.target.value; });
                byId('vc-channels')?.addEventListener('change', e => { vcState.audioChannels = e.target.value; });
                byId('vc-prores')?.addEventListener('change', e => { vcState.proResProfile = e.target.value; });

                // Quick presets
                c.querySelectorAll('.vc-quick-preset').forEach(btn => {
                    btn.addEventListener('click', () => {
                        const p = btn.dataset.preset;
                        const qp = {
                            prores_hq_1080:    { format:'prores',  fps:'25', resolution:'1920x1080', proResProfile:'3', audioSampleRate:'48000', audioChannels:'2' },
                            prores_hq_1080_30: { format:'prores',  fps:'30', resolution:'1920x1080', proResProfile:'3', audioSampleRate:'48000', audioChannels:'2' },
                            h264_1080_25:      { format:'mp4',     fps:'25', resolution:'1920x1080', videoBitrate:'8000k', audioBitrate:'320k', audioSampleRate:'48000', audioChannels:'2' },
                            h264_4k_25:        { format:'mp4',     fps:'25', resolution:'3840x2160', videoBitrate:'35000k', audioBitrate:'320k', audioSampleRate:'48000', audioChannels:'2' },
                            hap_q_1080_25:     { format:'hap_q',   fps:'25', resolution:'1920x1080', audioSampleRate:'48000', audioChannels:'2' },
                            hap_q_1080_30:     { format:'hap_q',   fps:'30', resolution:'1920x1080', audioSampleRate:'48000', audioChannels:'2' },
                            hap_1080_25:       { format:'hap',     fps:'25', resolution:'1920x1080', audioSampleRate:'48000', audioChannels:'2' },
                            dxv_1080_25:       { format:'dxv',     fps:'25', resolution:'1920x1080', audioSampleRate:'48000', audioChannels:'2' },
                            dxv_1080_30:       { format:'dxv',     fps:'30', resolution:'1920x1080', audioSampleRate:'48000', audioChannels:'2' },
                            wav_48_24:         { format:'wav',     audioSampleRate:'48000', audioChannels:'2' },
                            mp3_320:           { format:'mp3',     audioBitrate:'320k', audioSampleRate:'48000', audioChannels:'2' },
                            aac_256:           { format:'aac',     audioBitrate:'256k', audioSampleRate:'48000', audioChannels:'2' },
                        }[p];
                        if (!qp) return;
                        const preset = FORMAT_PRESETS[qp.format] || FORMAT_PRESETS.mp4;
                        vcState = {
                            ...vcState,
                            format: qp.format,
                            videoCodec: preset.vcodec,
                            audioCodec: preset.acodec,
                            videoBitrate: qp.videoBitrate || preset.vbr || vcState.videoBitrate,
                            audioBitrate: qp.audioBitrate || preset.abr || vcState.audioBitrate,
                            audioSampleRate: qp.audioSampleRate || vcState.audioSampleRate,
                            audioChannels: qp.audioChannels || vcState.audioChannels,
                            resolution: qp.resolution || '',
                            fps: qp.fps || '',
                            proResProfile: qp.proResProfile || vcState.proResProfile,
                        };
                        render();
                    });
                });

                // HAP / custom FFmpeg controls (only present when isHap format is selected)
                byId('vc-download-ffmpeg')?.addEventListener('click', () => startHapDownload());
                byId('vc-custom-ffmpeg')?.addEventListener('input', e => {
                    vcState.customFfmpegPath = e.target.value;
                    try { localStorage.setItem('vc-custom-ffmpeg', e.target.value); } catch(_) {}
                });
                byId('vc-browse-ffmpeg')?.addEventListener('click', async () => {
                    const p = await window.videoConverter?.pickFfmpeg?.();
                    if (p) {
                        vcState.customFfmpegPath = p;
                        try { localStorage.setItem('vc-custom-ffmpeg', p); } catch(_) {}
                        render();
                    }
                });

                // Start all conversions
                byId('vc-start-all')?.addEventListener('click', async () => {
                    if (!vcState.files.length || !vcState.outputDir) return;
                    const fmt = FORMAT_PRESETS[vcState.format] || FORMAT_PRESETS.mp4;
                    const isHapFmt = !!fmt.needsHap;

                    // Subscribe to progress events once (remove previous)
                    if (progressUnsub) { try { progressUnsub(); } catch(_) {} }
                    progressUnsub = window.videoConverter?.onProgress((data) => {
                        const job = vcState.jobs.find(j => j.id === data.jobId);
                        if (!job) return;
                        if (data.type === 'progress') {
                            job.percent = data.percent;
                            job.status = 'running';
                            job.timemark = data.timemark || null;
                            job.currentFps = data.currentFps || null;
                        } else if (data.type === 'done') {
                            job.status = 'done';
                            job.percent = 100;
                        } else if (data.type === 'error') {
                            job.status = 'error';
                            job.error = data.error;
                        }
                        render();
                    });

                    for (const file of vcState.files) {
                        const baseName = file.name.replace(/\.[^.]+$/, '');
                        const outName = `${baseName}_converted.${fmt.ext}`;
                        const jobEntry = { id: null, name: file.name, status: 'queued', percent: 0, outputPath: null, outputFolder: vcState.outputDir, error: null };
                        vcState.jobs.push(jobEntry);
                        render();

                        // Build extra output options for HAP sub-formats or DXV pixel format
                        let extraOpts = [];
                        if (isHapFmt && fmt.hapFormat) extraOpts.push('-format', fmt.hapFormat);
                        if (fmt.vcodec === 'dxv') extraOpts.push('-pix_fmt', 'rgba');

                        const result = await window.videoConverter?.start({
                            inputPath: file.path,
                            outputDir: vcState.outputDir,
                            outputFilename: outName,
                            format: fmt.ext,
                            videoCodec: fmt.vcodec === 'none' ? null : (fmt.vcodec || null),
                            audioCodec: fmt.acodec || null,
                            videoBitrate: vcState.videoBitrate || null,
                            audioBitrate: vcState.audioBitrate || null,
                            audioSampleRate: vcState.audioSampleRate || null,
                            audioChannels: vcState.audioChannels ? parseInt(vcState.audioChannels, 10) : null,
                            resolution: vcState.resolution || null,
                            fps: vcState.fps ? parseFloat(vcState.fps) : null,
                            proResProfile: vcState.format === 'prores' ? parseInt(vcState.proResProfile, 10) : null,
                            ffmpegPath: isHapFmt ? (vcState.customFfmpegPath || null) : null,
                            extraOutputOptions: extraOpts.length ? extraOpts : undefined,
                            totalDuration: file.probeResult?.duration || null,
                        });

                        if (result) {
                            jobEntry.id = result.jobId;
                            jobEntry.status = result.pending ? 'running' : (result.ok ? 'done' : 'error');
                            if (!result.ok) jobEntry.error = result.error;
                        }
                        render();
                    }
                });

                byId('vc-clear-jobs')?.addEventListener('click', () => {
                    vcState.jobs = vcState.jobs.filter(j => j.status === 'running');
                    render();
                });

                c.querySelectorAll('.vc-cancel-job').forEach(btn => {
                    btn.addEventListener('click', async () => {
                        const jid = btn.dataset.jobid;
                        await window.videoConverter?.cancel(jid);
                        const job = vcState.jobs.find(j => j.id === jid);
                        if (job) { job.status = 'cancelled'; job.error = 'Cancelled by user.'; }
                        render();
                    });
                });

                c.querySelectorAll('.vc-open-folder').forEach(btn => {
                    btn.addEventListener('click', () => {
                        window.videoConverter?.openFolder(btn.dataset.folder);
                    });
                });
            };

            return render;
        })();

