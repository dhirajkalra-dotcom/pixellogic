                                    <div class="min-w-0">
                                        <div class="text-[11px] text-slate-400 uppercase font-semibold tracking-wider">Total Tiles</div>
                                        <div class="text-xl font-bold text-violet-300 font-mono leading-tight">${sumTiles.toLocaleString()}</div>
                                        <div class="text-[10px] text-slate-400 truncate">${(sumPixels / 1e6).toFixed(2)} Megapixels</div>
                                    </div>
                                </div>

                                <div class="bg-slate-900/90 border border-emerald-500/30 rounded-xl p-3 shadow flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-lg bg-emerald-500/15 border border-emerald-500/30 flex items-center justify-center text-emerald-400 shrink-0 font-bold text-lg">
                                        📐
                                    </div>
                                    <div class="min-w-0">
                                        <div class="text-[11px] text-slate-400 uppercase font-semibold tracking-wider">Total Area</div>
                                        <div class="text-xl font-bold text-emerald-300 font-mono leading-tight">${sumAreaSqM.toFixed(2)} <span class="text-xs text-emerald-400 font-normal">m²</span></div>
                                        <div class="text-[10px] text-slate-400 truncate">${sumAreaSqFt.toFixed(1)} sq ft</div>
                                    </div>
                                </div>

                                <div class="bg-slate-900/90 border border-amber-500/30 rounded-xl p-3 shadow flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-lg bg-amber-500/15 border border-amber-500/30 flex items-center justify-center text-amber-400 shrink-0 font-bold text-lg">
                                        ⚡
                                    </div>
                                    <div class="min-w-0">
                                        <div class="text-[11px] text-slate-400 uppercase font-semibold tracking-wider">Power Consumed</div>
                                        <div class="text-xl font-bold text-amber-300 font-mono leading-tight">${sumKw.toFixed(2)} <span class="text-xs text-amber-400 font-normal">kW</span></div>
                                        <div class="text-[10px] text-slate-400 truncate">${Math.round(sumWatts).toLocaleString()} W (${sumAmps.toFixed(1)} A)</div>
                                    </div>
                                </div>

                                <div class="bg-slate-900/90 border border-rose-500/30 rounded-xl p-3 shadow flex items-center gap-3 col-span-2 sm:col-span-1">
                                    <div class="w-10 h-10 rounded-lg bg-rose-500/15 border border-rose-500/30 flex items-center justify-center text-rose-400 shrink-0 font-bold text-lg">
                                        🔌
                                    </div>
                                    <div class="min-w-0">
                                        <div class="text-[11px] text-slate-400 uppercase font-semibold tracking-wider">Service &amp; Breaker</div>
                                        <div class="text-xl font-bold text-yellow-400 font-mono leading-tight">${sumBreaker}A <span class="text-xs text-slate-300 font-normal">Mains</span></div>
                                        <div class="text-[10px] text-slate-400 truncate">${sumKva.toFixed(2)} kVA · ${sumPerPhaseAmps.toFixed(1)} A/Phase</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Master Section Title and Quick Actions Bar -->
                            <div class="flex items-center justify-between gap-3 flex-wrap bg-slate-900/80 border border-slate-800 rounded-xl px-4 py-2.5">
                                <div class="flex items-center gap-2">
                                    <span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 text-xs font-bold uppercase tracking-wider">
                                        Master LED Segregation
                                    </span>
                                    <span class="text-xs text-slate-300">
                                        Aggregated by Brand, Model, and Pitch in physical and electrical order
                                    </span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <button type="button" id="sheets-export-master-csv-btn" class="px-3 py-1.5 rounded-lg bg-emerald-600/90 hover:bg-emerald-500 text-white text-xs font-semibold flex items-center gap-1.5 shadow transition-colors cursor-pointer" title="Export Master Summary & Screen Breakdown as Excel CSV">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                                        <span>Export Master CSV (.csv)</span>
                                    </button>
                                    <button type="button" id="sheets-print-master-btn" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-600 text-slate-200 text-xs font-semibold flex items-center gap-1.5 shadow transition-colors cursor-pointer" title="Print Master Summary & Detailed Breakdown">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                                        <span>Print Report</span>
                                    </button>
                                </div>
                            </div>

                            <!-- Master Segregated Summary Table -->
                            <div class="overflow-x-auto rounded-xl border border-slate-700/80 bg-slate-950/80 shadow">
                                <table class="pl-excel-table w-full" id="pl-sheets-master-table">
                                    <thead>
                                        <tr class="pl-excel-col-letters">
                                            <th class="pl-excel-rownum">fx</th>
                                            <th>A</th><th>B</th><th>C</th><th>D</th><th>E</th><th>F</th><th>G</th><th>H</th><th>I</th><th>J</th><th>K</th><th>L</th><th>M</th><th>N</th>
                                        </tr>
                                        <tr class="pl-excel-group-headers">
                                            <th class="pl-excel-rownum">#</th>
                                            <th colspan="3" style="background:#112233;color:#38bdf8;">LED Brand &amp; Model Specifications</th>
                                            <th colspan="2" style="background:#162032;color:#94a3b8;">Cabinet Specs</th>
                                            <th colspan="2" style="background:#1c1d36;color:#a78bfa;">Total Panels &amp; Area</th>
                                            <th colspan="6" style="background:#2d1a1e;color:#fb7185;">Power Load &amp; Consumed (${sheetsState.voltage}V · ${sheetsState.phases}Ph · ${sheetsState.brightness === 'half' ? '50%' : '100%'})</th>
                                            <th colspan="1" style="background:#0f2922;color:#34d399;">Screens</th>
                                        </tr>
                                        <tr class="pl-excel-sub-headers">
                                            <th class="pl-excel-rownum">Row</th>
