    <!-- Notification Popup -->
    <div id="notification" class="fixed bottom-5 right-5 bg-indigo-600 text-white px-6 py-3 rounded-lg shadow-2xl" style="display: none;"></div>
    
    <script>
        // --- APPLICATION VERSION ---
    let APP_VERSION = '0.1.0';
        const APP_BUILD_DATE = new Date().toLocaleDateString();
        // Lightweight on-screen debug overlay (non-blocking) to catch packaged runtime issues
        (function setupDebugOverlay(){
            try {
                if (document.getElementById('debug-overlay')) return;
                const wrap = document.createElement('div');
                wrap.id = 'debug-overlay';
                wrap.style.position = 'fixed';
                // restore last position if any
                try {
                    const pos = JSON.parse(localStorage.getItem('pixi-logic-debug-pos') || '{}');
                    if (pos && typeof pos.x === 'number' && typeof pos.y === 'number') {
                        wrap.style.left = pos.x + 'px';
                        wrap.style.top = pos.y + 'px';
                    } else {
                        wrap.style.left = '8px';
                        wrap.style.bottom = '8px';
                    }
                } catch(_) { wrap.style.left = '8px'; wrap.style.bottom = '8px'; }
                wrap.style.zIndex = '9999';
                wrap.style.maxWidth = '40vw';
                wrap.style.maxHeight = '25vh';
                wrap.style.overflow = 'auto';
                wrap.style.pointerEvents = 'auto';
                wrap.style.font = '11px/1.3 monospace';
                wrap.style.color = '#9ca3af';
                wrap.style.background = 'rgba(17,24,39,0.6)';
                wrap.style.border = '1px solid rgba(75,85,99,0.6)';
                wrap.style.borderRadius = '6px';
                wrap.style.padding = '6px 8px';
                wrap.style.cursor = 'default';
                // header/drag handle
                const hdr = document.createElement('div');
                hdr.textContent = 'debug';
                hdr.style.fontWeight = '600';
                hdr.style.fontSize = '11px';
                hdr.style.marginBottom = '4px';
                hdr.style.color = '#e5e7eb';
                hdr.style.pointerEvents = 'auto';
                hdr.style.cursor = 'move';
                const hideBtn = document.createElement('button');
                hideBtn.textContent = '×';
                hideBtn.title = 'Hide';
                hideBtn.style.float = 'right';
                hideBtn.style.marginLeft = '6px';
                hideBtn.style.cursor = 'pointer';
                hideBtn.style.background = 'transparent';
                hideBtn.style.color = '#e5e7eb';
                hideBtn.style.border = 'none';
                hideBtn.style.fontSize = '12px';
                // visibility helpers (persisted)
                const setDebugVisible = (v) => {
                    wrap.style.display = v ? 'block' : 'none';
                    try { localStorage.setItem('pixi-logic-debug-visible', v ? '1' : '0'); } catch(_) {}
                };
                hideBtn.addEventListener('click', () => { setDebugVisible(false); });
                hdr.appendChild(hideBtn);
                const log = document.createElement('div');
                log.id = 'debug-log';
                log.style.pointerEvents = 'none';
                wrap.appendChild(log);
                wrap.insertBefore(hdr, log);
                document.body.appendChild(wrap);
                // default: hidden (still collects logs); allow persisted override
                try {
                    const pref = localStorage.getItem('pixi-logic-debug-visible');
                    setDebugVisible(pref === '1');
                } catch(_) { setDebugVisible(false); }
                // expose simple API for manual toggling
                window.showDebugOverlay = () => setDebugVisible(true);
                window.hideDebugOverlay = () => setDebugVisible(false);
                window.toggleDebugOverlay = () => setDebugVisible(wrap.style.display === 'none');
                // keyboard shortcut: Ctrl+Alt+D to toggle
                document.addEventListener('keydown', (e) => {
                    const key = (e.key || '').toLowerCase();
                    if (e.ctrlKey && e.altKey && key === 'd') {
                        e.preventDefault();
                        window.toggleDebugOverlay();
                    }
                });
                const push = (msg) => {
                    try {
                        const ts = new Date();
                        const pad = (n) => String(n).padStart(2,'0');
                        const t = `${pad(ts.getHours())}:${pad(ts.getMinutes())}:${pad(ts.getSeconds())}`;
                        const text = `[${t}] ${msg}`;
                        const el = document.getElementById('debug-log');
                        if (el) {
                            const line = document.createElement('div');
                            line.textContent = text;
                            el.appendChild(line);
                            while (el.childNodes.length > 30) el.removeChild(el.firstChild);
                            el.scrollTop = el.scrollHeight;
                        }
                        // Also mirror to console when the overlay is hidden
                        if (wrap && wrap.style && wrap.style.display === 'none' && typeof console !== 'undefined' && console.log) {
                            console.log(text);
                        }
                    } catch(_) {}
                };
                window.__debugPush = push;
                // simple dragging
                let dragging = false, startX = 0, startY = 0, baseLeft = 0, baseTop = 0;
                const onMove = (e) => {
                    if (!dragging) return;
                    const x = (e.clientX || 0) - startX + baseLeft;
                    const y = (e.clientY || 0) - startY + baseTop;
                    wrap.style.left = x + 'px';
                    wrap.style.top = y + 'px';
                };
                const onUp = () => {
                    if (!dragging) return;
                    dragging = false;
                    document.removeEventListener('mousemove', onMove);
                    document.removeEventListener('mouseup', onUp);
                    try { localStorage.setItem('pixi-logic-debug-pos', JSON.stringify({ x: wrap.offsetLeft, y: wrap.offsetTop })); } catch(_) {}
                };
                hdr.addEventListener('mousedown', (e) => {
                    dragging = true;
                    startX = e.clientX || 0;
                    startY = e.clientY || 0;
                    // compute base from current position
                    baseLeft = wrap.offsetLeft;
                    baseTop = wrap.offsetTop;
                    document.addEventListener('mousemove', onMove);
                    document.addEventListener('mouseup', onUp);
                });
                window.addEventListener('error', (e) => push(`error: ${e.message}`));
                window.addEventListener('unhandledrejection', (e) => push(`unhandled: ${e.reason && e.reason.message ? e.reason.message : e.reason}`));
                push('debug overlay ready');
            } catch(_) {}
        })();
        // Configure pdf.js worker (used by Devices tab import from PDF)
        try {
            if (window.pdfjsLib && pdfjsLib.GlobalWorkerOptions) {
                const v = window.pdfjsLib.version || '2.16.105';
                pdfjsLib.GlobalWorkerOptions.workerSrc = `https://cdnjs.cloudflare.com/ajax/libs/pdf.js/${v}/pdf.worker.min.js`;
            }
        } catch (_) { /* ignore */ }
        
        // Author social links (fixed)
        const AUTHOR_INSTAGRAM = 'https://www.instagram.com/dhirajkalra82';
        const AUTHOR_LINKEDIN = 'https://www.linkedin.com/in/dhirajkalra82';
        const AUTHOR_WEBSITE = 'https://www.pixelogic.co.in';
        const DEFAULT_INFO_FONT_OPTIONS = [
            'Arial',
            'Segoe UI',
            'Calibri',
            'Cambria',
            'Candara',
            'Consolas',
            'Corbel',
            'Franklin Gothic Medium',
            'Tahoma',
            'Trebuchet MS',
            'Verdana',
            'Bahnschrift',
            'Century Gothic',
            'Book Antiqua',
            'Palatino Linotype',
            'Lucida Sans Unicode',
            'Microsoft Sans Serif',
            'Impact',
            'Georgia',
            'Times New Roman',
            'Courier New',
            'Inter',
            'Roboto',
            'Open Sans',
            'Montserrat',
            'Poppins',
            'Lato'
        ];
        const FONT_CACHE_KEY = 'pixellogic-system-fonts';

        const sanitizeFontName = (fontName = '') => fontName.replace(/["']/g, '').trim();

        const PANEL_DIMENSION_UNITS = ['mm','cm','m','ft','in'];
        const PANEL_UNIT_FACTORS = {
            mm: 1,
            cm: 10,
            m: 1000,
            ft: 304.8,
            in: 25.4
        };
        const convertPanelUnitValueToMm = (value, unit = 'mm') => {
            const numeric = parseFloat(value);
            if (!isFinite(numeric)) return 0;
            const factor = PANEL_UNIT_FACTORS[unit] || 1;
            return numeric * factor;
        };
        const convertMmToPanelUnitValue = (mm, unit = 'mm') => {
            const numeric = parseFloat(mm);
            if (!isFinite(numeric)) return 0;
            const factor = PANEL_UNIT_FACTORS[unit] || 1;
            return numeric / factor;
        };
        const formatPanelUnitValueForInput = (mm, unit = 'mm') => {
            if (typeof mm !== 'number' || !isFinite(mm)) return '';
            const converted = convertMmToPanelUnitValue(mm, unit);
            const rounded = Math.round(converted * 1000) / 1000;
            return Number.isFinite(rounded) ? String(rounded) : '';
        };

        const escapeHtml = (str = '') => String(str).replace(/[&<>"']/g, (ch) => {
            switch (ch) {
                case '&': return '&amp;';
                case '<': return '&lt;';
                case '>': return '&gt;';
                case '"': return '&quot;';
                case "'": return '&#39;';
                default: return ch;
            }
        });

        // ── Demo mode detection & watermarking ──────────────────────────────────
        // demoControl is only exposed by the demo app's preload.js
        const IS_DEMO_MODE = typeof window.demoControl !== 'undefined';

        const applyDemoWatermarkToPDF = (doc) => {
            if (!IS_DEMO_MODE) return;
            try {
                const n = doc.getNumberOfPages ? doc.getNumberOfPages() : (doc.internal ? doc.internal.getNumberOfPages() : 1);
                for (let i = 1; i <= n; i++) {
                    try { doc.setPage(i); } catch(_) {}
                    const pw = doc.internal.pageSize.getWidth();
                    const ph = doc.internal.pageSize.getHeight();
                    doc.setFontSize(52);
                    doc.setTextColor(220, 90, 0);
                    const xs = [pw * 0.2, pw * 0.5, pw * 0.8];
                    const ys = [ph * 0.25, ph * 0.52, ph * 0.78];
                    for (const y of ys) {
                        for (const x of xs) {
                            try { doc.text('DEMO', x, y, { align: 'center' }); } catch(_) {}
                        }
                    }
                    try {
                        doc.setFontSize(8);
                        doc.setTextColor(180, 83, 9);
                        doc.text('DEMO VERSION \u2014 For evaluation use only \u2014 Not for commercial use',
                            pw * 0.5, ph - 7, { align: 'center' });
                    } catch(_) {}
                }
                doc.setTextColor(0, 0, 0);
            } catch(_) {}
        };

        const applyDemoWatermarkToCanvas = (canvas) => {
            if (!IS_DEMO_MODE) return;
            if (!canvas || canvas.width < 1 || canvas.height < 1) return;
            try {
                const ctx = canvas.getContext('2d');
                const w = canvas.width, h = canvas.height;
                const fs = Math.max(40, Math.min(Math.round(w / 6), 100));
                ctx.save();
                ctx.font = `bold ${fs}px Arial,sans-serif`;
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillStyle = 'rgba(220,90,0,1)';
                ctx.globalAlpha = 0.18;
                const cols = [0.25, 0.75];
                const rows = [0.3, 0.7];
                for (const row of rows) {
                    for (const col of cols) {
                        ctx.save();
                        ctx.translate(w * col, h * row);
                        ctx.rotate(-0.52);
                        ctx.fillText('DEMO', 0, 0);
                        ctx.restore();
                    }
                }
                ctx.restore();
                const bh = Math.max(28, Math.round(h * 0.05));
                ctx.globalAlpha = 0.92;
                ctx.fillStyle = '#b45309';
                ctx.fillRect(0, h - bh, w, bh);
                ctx.globalAlpha = 1;
                ctx.fillStyle = '#ffffff';
                const bf = Math.max(12, Math.round(bh * 0.52));
                ctx.font = `bold ${bf}px Arial,sans-serif`;
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText('DEMO VERSION \u2014 For evaluation use only', w / 2, h - bh / 2);
            } catch(_) {}
        };
        // ──────────────────────────────────────────────────────────────────────────

        const loadStoredFontOptions = () => {
            try {
                const cached = JSON.parse(localStorage.getItem(FONT_CACHE_KEY) || '[]');
                if (Array.isArray(cached) && cached.length) {
                    return cached.map(sanitizeFontName).filter(Boolean);
                }
            } catch (_) {}
            return [...DEFAULT_INFO_FONT_OPTIONS];
        };

        let availableFontOptions = loadStoredFontOptions();

        const getFontOptions = () => (Array.isArray(availableFontOptions) && availableFontOptions.length ? availableFontOptions : DEFAULT_INFO_FONT_OPTIONS);

        const persistFontOptions = (fonts) => {
            try { localStorage.setItem(FONT_CACHE_KEY, JSON.stringify(fonts)); } catch (_) {}
        };

        const mergeFontOptions = (incomingFonts) => {
            if (!Array.isArray(incomingFonts) || !incomingFonts.length) return null;
            const sanitized = incomingFonts.map(sanitizeFontName).filter(Boolean);
            if (!sanitized.length) return null;
            const installed = Array.from(new Set(sanitized)).sort((a, b) => a.localeCompare(b));
            return Array.from(new Set(DEFAULT_INFO_FONT_OPTIONS.concat(installed))).slice(0, 1000);
        };

        async function hydrateSystemFonts() {
            if (!window.systemFonts || typeof window.systemFonts.getFonts !== 'function') return;
            try {
                const fonts = await window.systemFonts.getFonts();
                const merged = mergeFontOptions(fonts);
                if (merged) {
                    const changed = JSON.stringify(availableFontOptions) !== JSON.stringify(merged);
                    availableFontOptions = merged;
                    persistFontOptions(availableFontOptions);
                    if (changed && state.activeTab === 'effects') {
                        renderEffectsDetails();
                    }
                }
            } catch (error) {
                console.warn('System font detection failed', error);
            }
        }
        // --- APPLICATION STATE ---
        let state = {
            activeTab: 'designer',
