                <!-- ── KEYBOARD SHORTCUTS REFERENCE MATRIX ────────────────────── -->
                <div style="background:rgba(14,18,28,0.9);border:1px solid rgba(251,191,36,0.22);border-left:4px solid #fbbf24;border-radius:12px;overflow:hidden;box-shadow:0 8px 30px rgba(0,0,0,0.35);">
                    <div style="padding:1.25rem 1.5rem 0.75rem;display:flex;align-items:center;gap:0.75rem;border-bottom:1px solid rgba(251,191,36,0.12);">
                        <div style="width:28px;height:28px;border-radius:8px;background:rgba(251,191,36,0.12);border:1px solid rgba(251,191,36,0.3);display:flex;align-items:center;justify-content:center;color:#fbbf24;">⌨</div>
