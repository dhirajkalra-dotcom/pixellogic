    <!-- Rename Project Modal (dedicated) -->
    <div id="rename-project-modal" class="fixed inset-0 bg-black/60 items-center justify-center z-50 flex" style="display: none;">
        <div class="bg-gray-800 rounded-xl shadow-2xl p-8 w-full max-w-md m-4 relative border border-gray-700">
            <h2 class="text-2xl font-bold mb-4">Rename Project</h2>
            <div class="space-y-2">
                <label for="rename-project-input" class="text-sm text-gray-300">New project name</label>
                <input id="rename-project-input" type="text" placeholder="Enter new project name" class="w-full bg-gray-900 border border-gray-700 rounded-lg px-3 py-2" />
            </div>
            <div class="flex justify-end gap-2 mt-6">
                <button id="rename-project-cancel" class="px-4 py-2 rounded-lg bg-gray-600 hover:bg-gray-700">Cancel</button>
                <button id="rename-project-save" class="px-4 py-2 rounded-lg bg-accent hover:bg-accent-dark">Save</button>
            </div>
