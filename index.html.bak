                    bannerAlignH: 'center', // left | center | right
                    bannerAlignV: 'middle',  // top | middle | bottom
                    // Include Pixel Map name after the document title inside page banner
                    includeMapNameInBanner: true,
                    // Scale banner font down so the composed title fits within the title area width
                    bannerFitToWidth: true
                },
