            effectsPresets: (() => { try { return JSON.parse(localStorage.getItem('pixellogic-effects-presets')) || []; } catch(_) { return []; } })(),
            // Pixel Map Designer presets (styling only: gradients, checker colors, numbering, border)
            designerPresets: (() => { try { return JSON.parse(localStorage.getItem('pixellogic-designer-presets')) || []; } catch(_) { return []; } })(),
            // Panel dimension presets (width/height mm + resolution)
            panelDimensionPresets: (() => { try { return JSON.parse(localStorage.getItem('pixellogic-panel-dimension-presets')) || []; } catch(_) { return []; } })(),
            hardware: {
