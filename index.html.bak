                                            <th style="min-width:115px;">Cabinet Size</th>
                                            <th style="min-width:105px;">Resolution</th>
                                            <th style="min-width:100px;">Total Tiles</th>
                                            <th style="min-width:110px;">Total Area (m²)</th>
                                            <th style="min-width:85px;">Load / Tile</th>
                                            <th style="min-width:110px;">Power (kW)</th>
                                            <th style="min-width:85px;">Current (A)</th>
                                            <th style="min-width:75px;">kVA</th>
                                            <th style="min-width:80px;">A / Phase</th>
                                            <th style="min-width:75px;">Breaker</th>
                                            <th style="min-width:210px;">Assigned Screens</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        ${masterCalcGroups.map((grp, i) => {
                                            return `
                                            <tr class="pl-excel-row hover:bg-slate-800/40 transition-colors">
                                                <td class="pl-excel-rownum">${i + 1}</td>
                                                <td class="px-3 py-2">
                                                    <span class="inline-block px-2 py-0.5 rounded bg-sky-500/20 text-sky-300 border border-sky-500/40 font-bold text-xs">
                                                        ${escapeHtml(grp.brand)}
                                                    </span>
                                                </td>
                                                <td class="px-3 py-2 font-semibold text-white">
                                                    ${escapeHtml(grp.model)}
                                                </td>
                                                <td class="pl-excel-readonly text-center font-bold text-cyan-300">
                                                    P${grp.pitchMm} mm
                                                </td>
                                                <td class="pl-excel-readonly text-center text-slate-300">
                                                    ${grp.panelW}×${grp.panelH} mm
                                                    <span class="text-[10px] text-slate-400 block">${grp.tileAreaSqM.toFixed(3)} m²/tile</span>
                                                </td>
                                                <td class="pl-excel-readonly text-center text-slate-300 font-mono">
                                                    ${grp.resW}×${grp.resH} px
                                                </td>
                                                <td class="pl-excel-readonly text-center">
                                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-violet-500/20 text-violet-200 border border-violet-500/40 font-mono font-bold text-xs">
                                                        ${grp.totalTiles}
                                                        <span class="text-[10px] text-violet-300/70 font-normal">(${grp.pctTiles}%)</span>
                                                    </span>
                                                </td>
                                                <td class="pl-excel-readonly text-center">
                                                    <span class="inline-block px-2.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 font-mono font-bold text-xs">
                                                        ${grp.totalAreaSqM.toFixed(2)} m²
                                                    </span>
                                                    <span class="text-[10px] text-slate-400 block font-mono">${grp.totalAreaSqFt.toFixed(1)} ft²</span>
                                                </td>
                                                <td class="pl-excel-readonly text-center">
                                                    <span class="font-mono text-slate-200 font-medium">${Math.round(grp.perTileWatts)} W</span>
                                                    <span class="text-[10px] text-slate-400 block font-mono">${grp.perTileAmps.toFixed(2)} A</span>
                                                </td>
                                                <td class="pl-excel-readonly text-center">
                                                    <span class="inline-block px-2.5 py-0.5 rounded bg-amber-500/20 text-amber-300 border border-amber-500/40 font-mono font-bold text-xs">
                                                        ${grp.totalKw.toFixed(2)} kW
                                                    </span>
                                                    <span class="text-[10px] text-slate-400 block font-mono">${Math.round(grp.totalWatts).toLocaleString()} W</span>
                                                </td>
                                                <td class="pl-excel-readonly text-center">
                                                    <span class="font-mono font-bold text-rose-300">${grp.totalAmps.toFixed(2)} A</span>
                                                </td>
                                                <td class="pl-excel-readonly text-center font-mono text-amber-200">
                                                    ${grp.totalKva.toFixed(2)}
                                                </td>
                                                <td class="pl-excel-readonly text-center font-mono text-orange-300">
                                                    ${grp.perPhaseAmps.toFixed(2)} A
                                                </td>
                                                <td class="pl-excel-readonly text-center">
                                                    <span class="inline-block px-2 py-0.5 rounded bg-yellow-500/20 text-yellow-300 border border-yellow-500/40 font-mono font-bold text-xs">
                                                        ${grp.breakerAmps} A
                                                    </span>
                                                </td>
                                                <td class="px-2.5 py-2">
                                                    <div class="flex flex-wrap gap-1 max-w-sm">
                                                        ${grp.screens.map(s => `
                                                            <button type="button" class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 text-[11px] transition-colors cursor-pointer" data-action="open-in-designer" data-map-id="${s.mapId}" title="Open ${escapeHtml(s.name)} in Pixel Designer">
                                                                <span class="text-white font-medium">${escapeHtml(s.name)}:</span>
                                                                <b class="text-violet-300 font-mono">${s.totalTiles}</b>
                                                                <span class="text-[10px] text-slate-400">tiles (${s.areaSqM.toFixed(1)}m²)</span>
                                                            </button>
                                                        `).join('')}
                                                    </div>
                                                </td>
                                            </tr>`;
                                        }).join('')}
                                    </tbody>
                                    <tfoot>
                                        <tr class="bg-slate-900/95 font-bold text-slate-100 border-t-2 border-emerald-500/60">
                                            <td class="pl-excel-rownum text-emerald-400 font-bold">Σ</td>
                                            <td colspan="3" class="px-3 py-2 text-left text-emerald-300">
                                                PROJECT GRAND TOTALS (${masterCalcGroups.length} LED Model${masterCalcGroups.length === 1 ? '' : 's'})
                                            </td>
                                            <td colspan="2" class="px-2 py-2 text-right text-slate-400 font-mono text-xs">Total Quantities:</td>
                                            <td class="px-2 py-2 text-center text-violet-300 font-mono text-sm">${sumTiles.toLocaleString()}</td>
                                            <td class="px-2 py-2 text-center text-emerald-300 font-mono text-sm">
                                                ${sumAreaSqM.toFixed(2)} m²
                                                <span class="text-[10px] text-slate-400 block font-normal">${sumAreaSqFt.toFixed(1)} ft²</span>
                                            </td>
                                            <td class="px-2 py-2 text-center text-slate-400 font-mono text-xs">Σ Consumed:</td>
                                            <td class="px-2 py-2 text-center text-amber-300 font-mono text-sm">
                                                ${sumKw.toFixed(2)} kW
                                                <span class="text-[10px] text-slate-400 block font-normal">${Math.round(sumWatts).toLocaleString()} W</span>
                                            </td>
                                            <td class="px-2 py-2 text-center text-rose-300 font-mono">${sumAmps.toFixed(2)} A</td>
                                            <td class="px-2 py-2 text-center text-amber-200 font-mono">${sumKva.toFixed(2)}</td>
                                            <td class="px-2 py-2 text-center text-orange-300 font-mono">${sumPerPhaseAmps.toFixed(2)} A</td>
                                            <td class="px-2 py-2 text-center text-yellow-400 font-mono">${sumBreaker} A</td>
                                            <td class="px-2 py-2 text-center text-xs text-slate-400 font-mono">
                                                ${rowsComputed.length} Active Screen${rowsComputed.length === 1 ? '' : 's'}
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>

                            <!-- Section 2: Segregated Breakdown Cards per Brand & Model -->
                            <div class="space-y-3 pt-2">
                                <div class="flex items-center justify-between">
                                    <div class="text-xs font-bold text-slate-300 uppercase tracking-wider flex items-center gap-2">
                                        <span>Detailed Screen Breakdowns Segregated by Model</span>
                                        <span class="text-[11px] px-2 py-0.5 rounded bg-slate-800 text-slate-400 border border-slate-700 font-normal">
                                            Individual screens using each LED model
                                        </span>
                                    </div>
                                </div>

                                <div class="grid grid-cols-1 gap-4">
                                    ${masterCalcGroups.map(grp => {
                                        return `
                                        <div class="bg-slate-900/90 border border-slate-700/80 rounded-xl overflow-hidden shadow-lg">
                                            <!-- Card Header -->
                                            <div class="bg-gradient-to-r from-slate-800/90 via-slate-900 to-slate-800/80 px-4 py-3 border-b border-slate-700/70 flex items-center justify-between gap-3 flex-wrap">
                                                <div class="flex items-center gap-2.5">
                                                    <span class="px-2.5 py-1 rounded bg-sky-500/20 text-sky-300 border border-sky-500/40 font-bold text-xs uppercase tracking-wider">
                                                        ${escapeHtml(grp.brand)}
                                                    </span>
                                                    <span class="text-sm font-bold text-white">
                                                        ${escapeHtml(grp.model)}
                                                    </span>
                                                    <span class="px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 border border-amber-500/40 font-mono font-bold text-xs">
                                                        P${grp.pitchMm} mm
                                                    </span>
                                                    <span class="text-xs text-slate-400 font-mono hidden sm:inline">
                                                        (${grp.panelW}×${grp.panelH} mm · ${grp.resW}×${grp.resH} px · ${grp.tileAreaSqM.toFixed(3)} m²/tile)
                                                    </span>
                                                </div>
                                                <div class="flex items-center gap-3 text-xs font-mono">
                                                    <span class="text-slate-300">Total Tiles: <strong class="text-violet-300 font-bold">${grp.totalTiles}</strong></span>
                                                    <span class="text-slate-300">Total Area: <strong class="text-emerald-300 font-bold">${grp.totalAreaSqM.toFixed(2)} m²</strong></span>
                                                    <span class="text-slate-300">Power: <strong class="text-amber-300 font-bold">${grp.totalKw.toFixed(2)} kW</strong> (${grp.totalAmps.toFixed(1)} A)</span>
                                                </div>
                                            </div>

                                            <!-- Card Body: Screens Table -->
                                            <div class="overflow-x-auto">
                                                <table class="w-full text-xs text-left text-slate-200">
                                                    <thead>
                                                        <tr class="bg-slate-950/70 text-slate-400 font-semibold border-b border-slate-800 text-[11px]">
                                                            <th class="px-3 py-2 w-10 text-center">#</th>
                                                            <th class="px-3 py-2">Screen Name</th>
                                                            <th class="px-3 py-2 text-center">Resolution</th>
                                                            <th class="px-3 py-2 text-center">Grid (Cols × Rows)</th>
                                                            <th class="px-3 py-2 text-center">Tiles Count</th>
                                                            <th class="px-3 py-2 text-center">Screen Size (W × H)</th>
                                                            <th class="px-3 py-2 text-center">Area (m²)</th>
                                                            <th class="px-3 py-2 text-center">Power Consumed</th>
                                                            <th class="px-3 py-2 text-center">Current</th>
                                                            <th class="px-3 py-2 text-center">Actions</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody class="divide-y divide-slate-800/60 font-mono">
                                                        ${grp.screens.map((s, sIdx) => {
                                                            return `
                                                            <tr class="hover:bg-slate-800/30 transition-colors">
                                                                <td class="px-3 py-2 text-center text-slate-500 font-semibold">${sIdx + 1}</td>
                                                                <td class="px-3 py-2 font-sans font-semibold text-white">
                                                                    ${escapeHtml(s.name)}
                                                                </td>
                                                                <td class="px-3 py-2 text-center text-slate-300">
                                                                    ${s.totalResW} × ${s.totalResH} px
                                                                </td>
                                                                <td class="px-3 py-2 text-center text-violet-300 font-bold">
                                                                    ${s.tilesW} × ${s.tilesH}
                                                                </td>
                                                                <td class="px-3 py-2 text-center text-violet-200 font-bold">
                                                                    ${s.totalTiles} tiles
                                                                </td>
                                                                <td class="px-3 py-2 text-center text-slate-300">
                                                                    ${(s.widthMm / 1000).toFixed(2)}m × ${(s.heightMm / 1000).toFixed(2)}m
                                                                </td>
                                                                <td class="px-3 py-2 text-center text-emerald-300 font-semibold">
                                                                    ${s.areaSqM.toFixed(2)} m²
                                                                </td>
                                                                <td class="px-3 py-2 text-center text-amber-300 font-semibold">
                                                                    ${s.totalKw.toFixed(2)} kW
                                                                    <span class="text-[10px] text-slate-400 block font-normal">${Math.round(s.totalWatts).toLocaleString()} W</span>
                                                                </td>
                                                                <td class="px-3 py-2 text-center text-rose-300">
                                                                    ${s.totalAmps.toFixed(2)} A
                                                                </td>
                                                                <td class="px-3 py-2 text-center font-sans">
                                                                    <div class="flex items-center justify-center gap-1.5">
                                                                        <button type="button" class="px-2 py-1 rounded bg-emerald-600/80 hover:bg-emerald-500 text-white text-[11px] font-semibold transition-colors cursor-pointer" data-action="open-in-designer" data-map-id="${s.mapId}" title="Open screen in Pixel Designer">
                                                                            Design →
                                                                        </button>
                                                                        <button type="button" class="px-2 py-1 rounded bg-cyan-600/80 hover:bg-cyan-500 text-white text-[11px] font-semibold transition-colors cursor-pointer" data-action="open-in-patching" data-map-id="${s.mapId}" title="Open screen in LED Patching">
                                                                            Patch
                                                                        </button>
                                                                        <button type="button" class="px-2 py-1 rounded bg-sky-600/80 hover:bg-sky-500 text-white text-[11px] font-semibold transition-colors cursor-pointer" data-action="open-in-drawings" data-map-id="${s.mapId}" title="Open CAD drawings for this screen">
                                                                            CAD
                                                                        </button>
                                                                    </div>
                                                                </td>
                                                            </tr>`;
                                                        }).join('')}
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>`;
                                    }).join('')}
                                </div>
                            </div>
                        </div>`;
                    };

                    const renderCatalogTableHtml = () => {
                        const q = String(sheetsState.catalogSearch || '').trim().toLowerCase();
                        const filtered = catalog.filter(item => {
                            if (sheetsState.catalogBrandFilter && sheetsState.catalogBrandFilter !== 'ALL' && item.brand !== sheetsState.catalogBrandFilter) return false;
                            if (q && !(item.brand.toLowerCase().includes(q) || item.model.toLowerCase().includes(q) || String(item.pitchMm).includes(q))) return false;
                            return true;
                        });
                        const activeMap = getActivePixelMap();
                        const activeMapName = activeMap ? activeMap.name : 'Active Screen';
                        const cabUnit = UNIT_META[sheetsState.catalogCabUnit] ? sheetsState.catalogCabUnit : 'mm';
                        const cabUnitMeta = UNIT_META[cabUnit];

                        return `
                        <table class="pl-excel-table" id="pl-sheets-catalog-table">
                            <thead>
                                <tr class="pl-excel-col-letters">
                                    <th class="pl-excel-rownum">#</th>
                                    <th>A</th><th>B</th><th>C</th><th>D</th><th>E</th><th>F</th><th>G</th><th>H</th><th>I</th><th>J</th><th>K</th>
                                </tr>
                                <tr class="pl-excel-sub-headers">
                                    <th class="pl-excel-rownum">Row</th>
                                    <th style="min-width:130px;">LED Brand</th>
                                    <th style="min-width:210px;">Model Name</th>
                                    <th style="min-width:85px;">Pixel Pitch</th>
                                    <th style="min-width:165px;">
                                        <div class="flex items-center justify-center gap-1">
                                            <span>Cabinet:</span>
                                            <select id="sheets-catalog-cab-unit-select" class="bg-slate-950 border border-emerald-500/40 rounded px-1.5 py-0.5 text-[11px] text-emerald-300 font-bold focus:outline-none cursor-pointer">
                                                ${Object.entries(UNIT_META).map(([k, v]) => `<option value="${k}" class="bg-slate-900 text-white" ${cabUnit === k ? 'selected' : ''}>${v.short}</option>`).join('')}
                                            </select>
                                        </div>
                                    </th>
                                    <th style="min-width:105px;">Cabinet (px)</th>
                                    <th style="min-width:90px;">100% White (A)</th>
                                    <th style="min-width:120px;">100% R / G / B (A)</th>
                                    <th style="min-width:90px;">50% White (A)</th>
                                    <th style="min-width:85px;">Standby (A)</th>
                                    <th style="min-width:110px;">Max Load / Tile</th>
                                    <th style="min-width:240px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${filtered.map((item, i) => {
                                    const fullW = item.full?.w != null ? item.full.w : null;
                                    const halfW = item.half?.w != null ? item.half.w : null;
                                    const stby = item.full?.s != null ? item.full.s : null;
                                    const maxWatts = fullW != null ? Math.round(fullW * (Number(sheetsState.voltage) || 230)) : null;
                                    const isCurrentOnActive = activeMap && activeMap.ledBrand === item.brand && activeMap.ledModel === item.model;
                                    const cabText = `${formatSheetUnitNum(item.panelWidthMm, cabUnit)} × ${formatSheetUnitNum(item.panelHeightMm, cabUnit)} ${cabUnit}`;
                                    return `
                                    <tr class="pl-excel-row ${isCurrentOnActive ? 'active-map-row' : ''}">
                                        <td class="pl-excel-rownum">${i + 1}</td>
                                        <td class="px-3 py-1.5 font-bold text-sky-300">
                                            ${escapeHtml(item.brand)}
                                            ${item.isCustom ? '<span class="ml-1 text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-normal">Custom</span>' : ''}
                                        </td>
                                        <td class="px-3 py-1.5 font-semibold text-white">${escapeHtml(item.model)}</td>
                                        <td class="pl-excel-readonly text-center text-cyan-300 font-bold">P${item.pitchMm} mm</td>
                                        <td class="pl-excel-readonly text-center ${cabUnitMeta.color} font-semibold">${cabText}</td>
                                        <td class="pl-excel-readonly text-center text-slate-200">${item.panelResWidth} × ${item.panelResHeight} px</td>
                                        <td class="pl-excel-readonly font-bold text-rose-300">${fullW != null ? fullW.toFixed(2) + ' A' : '—'}</td>
                                        <td class="pl-excel-readonly text-center text-xs text-slate-300">
                                            <span class="text-red-400">${item.full?.r ?? '—'}</span> /
                                            <span class="text-green-400">${item.full?.g ?? '—'}</span> /
                                            <span class="text-blue-400">${item.full?.b ?? '—'}</span>
                                        </td>
                                        <td class="pl-excel-readonly text-emerald-300">${halfW != null ? halfW.toFixed(2) + ' A' : '—'}</td>
                                        <td class="pl-excel-readonly text-slate-400">${stby != null ? stby.toFixed(2) + ' A' : '—'}</td>
                                        <td class="pl-excel-readonly font-semibold text-amber-300">${maxWatts != null ? maxWatts + ' W' : '—'}</td>
                                        <td class="px-2 py-1 text-center">
                                            <div class="flex items-center justify-center gap-1">
                                                <button type="button" class="px-2 py-1 rounded bg-emerald-600/85 hover:bg-emerald-500 text-white text-[11px] font-semibold" data-action="catalog-apply-active" data-brand="${escapeHtml(item.brand)}" data-model="${escapeHtml(item.model)}" title="Apply ${escapeHtml(item.brand)} ${escapeHtml(item.model)} to ${escapeHtml(activeMapName)}">
                                                    Apply
                                                </button>
                                                <button type="button" class="px-2 py-1 rounded bg-indigo-600/80 hover:bg-indigo-500 text-white text-[11px] font-semibold" data-action="catalog-add-screen" data-brand="${escapeHtml(item.brand)}" data-model="${escapeHtml(item.model)}" title="Create a new Screen in Pixel Designer using ${escapeHtml(item.brand)} ${escapeHtml(item.model)}">
                                                    + Screen
                                                </button>
                                                <button type="button" class="px-1.5 py-1 rounded bg-slate-700 hover:bg-slate-600 text-slate-200 text-[11px]" data-action="catalog-edit-model" data-brand="${escapeHtml(item.brand)}" data-model="${escapeHtml(item.model)}" title="Edit / Customize this LED model">
                                                    Edit
                                                </button>
                                                ${item.isCustom ? `
                                                <button type="button" class="px-1.5 py-1 rounded bg-rose-800/70 hover:bg-rose-600 text-rose-100 text-[11px]" data-action="catalog-delete-model" data-brand="${escapeHtml(item.brand)}" data-model="${escapeHtml(item.model)}" title="Delete Custom LED Model">
                                                    ×
                                                </button>` : ''}
                                            </div>
                                        </td>
                                    </tr>`;
                                }).join('')}
                            </tbody>
                        </table>`;
                    };

                    c.innerHTML = `
                    <div class="space-y-3">
                        <div class="pl-excel-wrap">
                            <!-- TOP Worksheet Tabs Bar (Easy switching at the very top) -->
                            <div class="pl-excel-sheettabs">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <button type="button" class="pl-excel-sheettab ${sheetsState.activeSheet === 'schedule' ? 'active' : ''}" data-sheet-tab="schedule">
                                        📊 Project LED Schedule (${rowsComputed.length} Screen${rowsComputed.length === 1 ? '' : 's'})
                                    </button>
                                    <button type="button" class="pl-excel-sheettab ${sheetsState.activeSheet === 'master_calculations' ? 'active' : ''}" data-sheet-tab="master_calculations">
                                        🧮 Master Calculations (${masterCalcGroups.length} LED Model${masterCalcGroups.length === 1 ? '' : 's'})
                                    </button>
                                    <button type="button" class="pl-excel-sheettab ${sheetsState.activeSheet === 'catalog' ? 'active' : ''}" data-sheet-tab="catalog">
                                        📋 All LED Brands &amp; Pitch Database (${catalog.length} Models)
                                    </button>
                                    <button type="button" class="pl-excel-sheettab ${sheetsState.activeSheet === 'drawings' ? 'active' : ''}" data-sheet-tab="drawings">
                                        📐 Engineering Drawings (8 CAD Sheets)
                                    </button>
                                    <button type="button" id="sheets-toggle-add-brand-btn" class="px-3 py-1.5 rounded-lg ${sheetsState.showAddBrandModal ? 'bg-emerald-500 text-slate-950' : 'bg-sky-600/90 hover:bg-sky-500 text-white'} text-xs font-bold flex items-center gap-1.5 shadow transition-colors">
                                        <span>+ Add New LED Brand / Model</span>
                                    </button>
                                </div>
                                <div class="text-xs text-slate-400 flex items-center gap-4 flex-wrap">
                                    <span>Active Screen: <strong class="text-emerald-300">${escapeHtml(getActivePixelMap()?.name || 'None')}</strong></span>
                                    <span>Σ Tiles: <strong class="text-white">${sumTiles}</strong></span>
                                    <span>Σ Area: <strong class="text-emerald-300">${sumAreaSqM.toFixed(2)} m²</strong> (${sumAreaSqFt.toFixed(1)} ft²)</span>
                                    <span>Σ Power: <strong class="text-amber-300">${sumKw.toFixed(2)} kW</strong> (${sumAmps.toFixed(1)} A)</span>
                                </div>
                            </div>

                            <!-- Collapsible Add / Edit New LED Brand & Model Panel -->
                            ${renderAddBrandPanelHtml()}

                            <!-- Excel Ribbon Toolbar -->
                            <div class="pl-excel-ribbon">
                                <div class="flex items-center gap-3 flex-wrap">
                                    <div class="flex items-center gap-2">
                                        <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 font-bold">
                                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="3" x2="9" y2="21"/><line x1="15" y1="3" x2="15" y2="21"/></svg>
                                        </span>
                                        <div>
                                            <div class="text-sm font-bold text-white flex items-center gap-2">
                                                LED Master Sheets
                                                <span class="text-[11px] px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-medium">Live Synced with Pixel Designer</span>
                                            </div>
                                            <div class="text-xs text-slate-400">
                                                Project: <span class="text-slate-200 font-semibold">${escapeHtml(activeProject.name || 'Untitled Project')}</span>
                                                · ${brands.length} LED Brands (${catalog.length} Models with Pitch &amp; Power Load)
                                                · Sizes in <span class="text-emerald-300">m, mm, cm, in, ft</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Electrical & Sheet Controls -->
                                <div class="flex items-center gap-2 flex-wrap">
                                    <div class="flex items-center gap-1.5 bg-slate-900/90 border border-slate-700/80 rounded-lg px-2.5 py-1 text-xs">
                                        <span class="text-slate-400">Voltage:</span>
                                        <select id="sheets-voltage-select" class="bg-transparent text-amber-300 font-semibold focus:outline-none">
                                            ${[110, 120, 200, 208, 220, 230, 240].map(v => `<option value="${v}" class="bg-slate-900" ${Number(sheetsState.voltage) === v ? 'selected' : ''}>${v}V</option>`).join('')}
                                        </select>
                                    </div>
                                    <div class="flex items-center gap-1.5 bg-slate-900/90 border border-slate-700/80 rounded-lg px-2.5 py-1 text-xs">
                                        <span class="text-slate-400">Supply:</span>
                                        <select id="sheets-phases-select" class="bg-transparent text-cyan-300 font-semibold focus:outline-none">
                                            <option value="3" class="bg-slate-900" ${Number(sheetsState.phases) === 3 ? 'selected' : ''}>3-Phase (L1/L2/L3)</option>
                                            <option value="1" class="bg-slate-900" ${Number(sheetsState.phases) === 1 ? 'selected' : ''}>1-Phase</option>
                                        </select>
                                    </div>
                                    <div class="flex items-center gap-1.5 bg-slate-900/90 border border-slate-700/80 rounded-lg px-2.5 py-1 text-xs">
                                        <span class="text-slate-400">Brightness:</span>
                                        <select id="sheets-brightness-select" class="bg-transparent text-emerald-300 font-semibold focus:outline-none">
                                            <option value="full" class="bg-slate-900" ${sheetsState.brightness === 'full' ? 'selected' : ''}>100% Full</option>
                                            <option value="half" class="bg-slate-900" ${sheetsState.brightness === 'half' ? 'selected' : ''}>50% Half</option>
                                        </select>
                                    </div>
                                    <div class="flex items-center gap-1.5 bg-slate-900/90 border border-slate-700/80 rounded-lg px-2.5 py-1 text-xs">
                                        <span class="text-slate-400">Load Mode:</span>
                                        <select id="sheets-scenario-select" class="bg-transparent text-rose-300 font-semibold focus:outline-none">
                                            <option value="w" class="bg-slate-900" ${sheetsState.scenario === 'w' ? 'selected' : ''}>Full White (Peak Max)</option>
                                            <option value="avg" class="bg-slate-900" ${sheetsState.scenario === 'avg' ? 'selected' : ''}>Dynamic Video Avg</option>
                                            <option value="r" class="bg-slate-900" ${sheetsState.scenario === 'r' ? 'selected' : ''}>Full Red</option>
                                            <option value="g" class="bg-slate-900" ${sheetsState.scenario === 'g' ? 'selected' : ''}>Full Green</option>
                                            <option value="b" class="bg-slate-900" ${sheetsState.scenario === 'b' ? 'selected' : ''}>Full Blue</option>
                                            <option value="s" class="bg-slate-900" ${sheetsState.scenario === 's' ? 'selected' : ''}>Standby</option>
                                        </select>
                                    </div>
                                    <button type="button" id="sheets-export-csv-btn" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-600 text-slate-200 text-xs font-semibold" title="Export Schedule as Excel CSV">
                                        Export CSV (.csv)
                                    </button>
                                    <button type="button" id="sheets-goto-designer-btn" class="px-3 py-1.5 rounded-lg bg-violet-600 hover:bg-violet-500 text-white text-xs font-semibold">
                                        Open Pixel Designer →
                                    </button>
                                </div>
                            </div>

                            <!-- Excel Formula Bar -->
                            <div class="pl-excel-formulabar">
                                <span class="pl-excel-cellref" id="sheets-cell-ref">${escapeHtml(sheetsState.selectedCellRef || 'A1')}</span>
                                <span class="text-slate-500 font-bold italic px-1">fx</span>
                                <span class="text-slate-300 truncate flex-1" id="sheets-cell-formula">${escapeHtml(sheetsState.selectedCellFormula || 'Click any cell to edit. Any change in m, mm, cm, in, ft, Tiles, or LED Brand/Pitch updates Pixel Designer live.')}</span>
                                ${sheetsState.activeSheet === 'catalog' ? `
                                <div class="flex items-center gap-2">
                                    <select id="sheets-catalog-brand-filter" class="bg-slate-900 border border-slate-700 rounded px-2 py-0.5 text-xs text-sky-300">
                                        <option value="ALL">All Brands (${brands.length})</option>
                                        ${brands.map(b => `<option value="${escapeHtml(b)}" ${sheetsState.catalogBrandFilter === b ? 'selected' : ''}>${escapeHtml(b)} (${brandPitchSummary[b]})</option>`).join('')}
                                    </select>
                                    <input type="text" id="sheets-catalog-search" placeholder="Search model or pitch..." value="${escapeHtml(sheetsState.catalogSearch || '')}" class="bg-slate-900 border border-slate-700 rounded px-2 py-0.5 text-xs text-white w-44" />
                                </div>
                                ` : sheetsState.activeSheet === 'master_calculations' ? `
                                <div class="flex items-center gap-2.5 shrink-0">
                                    <span class="text-xs text-violet-300 font-semibold">Live Master Summary: ${masterCalcGroups.length} LED Models · ${sumTiles} Tiles · ${sumAreaSqM.toFixed(2)} m² · ${sumKw.toFixed(2)} kW (${sumAmps.toFixed(1)} A)</span>
                                </div>
                                ` : `
                                <div class="flex items-center gap-3 shrink-0">
                                    <span class="text-xs text-emerald-400 font-semibold">Total Load: ${sumAmps.toFixed(1)} A · ${sumKw.toFixed(2)} kW · ${sumKva.toFixed(2)} kVA</span>
                                    <button type="button" data-action="add-screen-top" class="px-3 py-1 rounded-md bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold shadow-sm flex items-center gap-1 cursor-pointer">+ Add Screen</button>
                                </div>
                                `}
                            </div>

                            <!-- Main Spreadsheet Grid OR 8-Sheet CAD Engineering Drawings OR Master Calculations -->
                            ${sheetsState.activeSheet === 'drawings' && window.SheetsCadDrawings
                                ? `<div id="pl-cad-drawings-mount" class="p-2 bg-[#080c12]">${window.SheetsCadDrawings.renderDrawingsViewHtml(activeProject.name || 'Untitled Project', rowsComputed, sheetsState)}</div>`
                                : sheetsState.activeSheet === 'master_calculations'
                                    ? `<div class="pl-excel-grid-scroll">${renderMasterCalculationsTableHtml()}</div>`
                                    : `<div class="pl-excel-grid-scroll">${sheetsState.activeSheet === 'catalog' ? renderCatalogTableHtml() : renderScheduleTableHtml()}</div>`
                            }
                        </div>
                    </div>`;

                    // Wire up Add / Edit LED Brand & Model panel
                    const toggleAddBrandBtn = document.getElementById('sheets-toggle-add-brand-btn');
                    if (toggleAddBrandBtn) {
                        toggleAddBrandBtn.addEventListener('click', () => {
                            sheetsState.showAddBrandModal = !sheetsState.showAddBrandModal;
                            if (sheetsState.showAddBrandModal && (!sheetsState.newLedDraft || sheetsState.newLedDraft.isEditing)) {
                                sheetsState.newLedDraft = {
                                    brand: '', model: '', pitchMm: 2.6, panelWidthMm: 500, panelHeightMm: 500,
                                    panelResWidth: 192, panelResHeight: 192, maxWatts: 165, halfWatts: 95,
                                    fullW: 0.72, fullR: 0.48, fullG: 0.31, fullB: 0.25, fullS: 0.14, halfW: 0.41, isEditing: false
                                };
                            }
                            renderSheetsTab();
                        });
                    }
                    const closeAddBrandBtn = document.getElementById('sheets-close-add-brand-btn');
                    if (closeAddBrandBtn) {
                        closeAddBrandBtn.addEventListener('click', () => {
                            sheetsState.showAddBrandModal = false;
                            renderSheetsTab();
                        });
                    }

                    // Live auto-calculations inside Add New LED Brand panel
                    if (sheetsState.showAddBrandModal) {
                        const draft = sheetsState.newLedDraft;
                        const brandIn = document.getElementById('new-led-brand');
                        const modelIn = document.getElementById('new-led-model');
                        const pitchIn = document.getElementById('new-led-pitch');
                        const cabWIn = document.getElementById('new-led-cab-w');
                        const cabHIn = document.getElementById('new-led-cab-h');
                        const resWIn = document.getElementById('new-led-res-w');
                        const resHIn = document.getElementById('new-led-res-h');
                        const maxWIn = document.getElementById('new-led-max-watts');
                        const halfWIn = document.getElementById('new-led-half-watts');
                        const fullWAmpsIn = document.getElementById('new-led-full-w');
                        const fullRAmpsIn = document.getElementById('new-led-full-r');
                        const fullGAmpsIn = document.getElementById('new-led-full-g');
                        const fullBAmpsIn = document.getElementById('new-led-full-b');
                        const halfWAmpsIn = document.getElementById('new-led-half-w');
                        const fullSAmpsIn = document.getElementById('new-led-full-s');

                        const recalcResFromPitch = () => {
                            const p = parseFloat(pitchIn?.value) || 2.6;
                            const cw = parseFloat(cabWIn?.value) || 500;
                            const ch = parseFloat(cabHIn?.value) || 500;
                            if (p > 0) {
                                const rw = Math.max(8, Math.round(cw / p));
                                const rh = Math.max(8, Math.round(ch / p));
                                if (resWIn) resWIn.value = rw;
                                if (resHIn) resHIn.value = rh;
                                draft.pitchMm = p;
                                draft.panelWidthMm = cw;
                                draft.panelHeightMm = ch;
                                draft.panelResWidth = rw;
                                draft.panelResHeight = rh;
                            }
                        };
                        if (pitchIn) pitchIn.addEventListener('input', recalcResFromPitch);
                        if (cabWIn) cabWIn.addEventListener('input', recalcResFromPitch);
                        if (cabHIn) cabHIn.addEventListener('input', recalcResFromPitch);

                        c.querySelectorAll('[data-cab-preset]').forEach(btn => {
                            btn.addEventListener('click', () => {
                                const [w, h] = (btn.dataset.cabPreset || '500x500').split('x').map(Number);
                                if (cabWIn) cabWIn.value = w;
                                if (cabHIn) cabHIn.value = h;
                                recalcResFromPitch();
                            });
                        });

                        if (maxWIn) {
                            maxWIn.addEventListener('input', () => {
                                const watts = parseFloat(maxWIn.value);
                                const v = Number(sheetsState.voltage) || 230;
                                if (Number.isFinite(watts) && watts > 0) {
                                    const wAmps = Number((watts / v).toFixed(2));
                                    const halfWatts = Math.round(watts * 0.55);
                                    if (halfWIn) halfWIn.value = halfWatts;
                                    if (fullWAmpsIn) fullWAmpsIn.value = wAmps;
                                    if (fullRAmpsIn) fullRAmpsIn.value = Number((wAmps * 0.62).toFixed(2));
                                    if (fullGAmpsIn) fullGAmpsIn.value = Number((wAmps * 0.44).toFixed(2));
                                    if (fullBAmpsIn) fullBAmpsIn.value = Number((wAmps * 0.36).toFixed(2));
                                    if (halfWAmpsIn) halfWAmpsIn.value = Number((halfWatts / v).toFixed(2));
                                }
                            });
                        }
                        if (halfWIn) {
                            halfWIn.addEventListener('input', () => {
                                const hw = parseFloat(halfWIn.value);
                                const v = Number(sheetsState.voltage) || 230;
                                if (Number.isFinite(hw) && hw > 0 && halfWAmpsIn) {
                                    halfWAmpsIn.value = Number((hw / v).toFixed(2));
                                }
                            });
                        }

                        const handleSaveNewLed = (applyToActiveScreen = false) => {
                            const bName = String(brandIn?.value || '').trim().toUpperCase();
                            const mName = String(modelIn?.value || '').trim();
                            if (!bName || !mName) {
                                showNotification('Please enter both an LED Brand Name and a Model Name.');
                                return;
                            }
                            const pitchMm = Math.max(0.5, parseFloat(pitchIn?.value) || 2.6);
                            const panelWidthMm = Math.max(50, Math.round(parseFloat(cabWIn?.value) || 500));
                            const panelHeightMm = Math.max(50, Math.round(parseFloat(cabHIn?.value) || 500));
                            const panelResWidth = Math.max(8, Math.round(parseFloat(resWIn?.value) || Math.round(panelWidthMm / pitchMm)));
                            const panelResHeight = Math.max(8, Math.round(parseFloat(resHIn?.value) || Math.round(panelHeightMm / pitchMm)));

                            const fullW = Math.max(0.01, parseFloat(fullWAmpsIn?.value) || 0.7);
                            const fullR = Math.max(0, parseFloat(fullRAmpsIn?.value) || Number((fullW * 0.6).toFixed(2)));
                            const fullG = Math.max(0, parseFloat(fullGAmpsIn?.value) || Number((fullW * 0.45).toFixed(2)));
                            const fullB = Math.max(0, parseFloat(fullBAmpsIn?.value) || Number((fullW * 0.38).toFixed(2)));
                            const fullS = Math.max(0, parseFloat(fullSAmpsIn?.value) || 0.12);
                            const halfW = Math.max(0.01, parseFloat(halfWAmpsIn?.value) || Number((fullW * 0.56).toFixed(2)));

                            const newEntry = {
                                brand: bName,
                                model: mName,
                                pitchMm: Number(pitchMm.toFixed(2)),
                                panelWidthMm,
                                panelHeightMm,
                                panelResWidth,
                                panelResHeight,
                                full: { r: fullR, g: fullG, b: fullB, w: fullW, s: fullS },
                                half: {
                                    r: Number((fullR * 0.62).toFixed(2)),
                                    g: Number((fullG * 0.65).toFixed(2)),
                                    b: Number((fullB * 0.68).toFixed(2)),
                                    w: halfW,
                                    s: fullS
                                },
                                isCustom: true
                            };

                            const list = loadCustomLedCatalog();
                            const existingIdx = list.findIndex(x =>
                                String(x.brand).toUpperCase() === bName &&
                                String(x.model).toUpperCase() === mName.toUpperCase()
                            );
                            if (existingIdx >= 0) {
                                list[existingIdx] = newEntry;
                            } else {
                                list.push(newEntry);
                            }
                            saveCustomLedCatalog(list);

                            if (applyToActiveScreen) {
                                const targetMap = getActivePixelMap();
                                if (targetMap) {
                                    applyLedModelToMap(targetMap, bName, mName);
                                    saveState();
                                    redrawAffectedVisuals();
                                }
                            }

                            sheetsState.showAddBrandModal = false;
                            renderSheetsTab();
                            showNotification(applyToActiveScreen
                                ? `Saved ${bName} ${mName} (P${newEntry.pitchMm}mm) and applied to active screen!`
                                : `Saved ${bName} ${mName} (P${newEntry.pitchMm}mm) to LED Database!`);
                        };

                        const saveBtn = document.getElementById('sheets-save-new-led-btn');
                        if (saveBtn) saveBtn.addEventListener('click', () => handleSaveNewLed(false));
                        const saveApplyBtn = document.getElementById('sheets-save-apply-new-led-btn');
                        if (saveApplyBtn) saveApplyBtn.addEventListener('click', () => handleSaveNewLed(true));
                    }

                    // Wire up toolbar events
                    const voltSel = document.getElementById('sheets-voltage-select');
                    if (voltSel) voltSel.addEventListener('change', (e) => {
                        sheetsState.voltage = parseInt(e.target.value, 10) || 230;
                        renderSheetsTab();
                    });
                    const phaseSel = document.getElementById('sheets-phases-select');
                    if (phaseSel) phaseSel.addEventListener('change', (e) => {
                        sheetsState.phases = parseInt(e.target.value, 10) || 3;
                        renderSheetsTab();
                    });
                    const brightSel = document.getElementById('sheets-brightness-select');
                    if (brightSel) brightSel.addEventListener('change', (e) => {
                        sheetsState.brightness = e.target.value || 'full';
                        renderSheetsTab();
                    });
                    const scenSel = document.getElementById('sheets-scenario-select');
                    if (scenSel) scenSel.addEventListener('change', (e) => {
                        sheetsState.scenario = e.target.value || 'w';
                        renderSheetsTab();
                    });

                    const addScreenRow = (brandOpt, modelOpt) => {
                        const newMap = createNewPixelMapObject(activeProject.pixelMaps.length + 1);
                        if (brandOpt && modelOpt) {
                            applyLedModelToMap(newMap, brandOpt, modelOpt);
                            newMap.name = `${brandOpt} ${modelOpt}`;
                        } else {
                            // Default to first catalog model or current active map's brand/model
                            const curActive = getActivePixelMap();
                            if (curActive && curActive.ledBrand && curActive.ledModel) {
                                applyLedModelToMap(newMap, curActive.ledBrand, curActive.ledModel);
                            }
                        }
                        activeProject.pixelMaps.push(newMap);
                        activeProject.activePixelMapId = newMap.id;
                        saveState();
                        redrawAffectedVisuals();
                        renderSheetsTab();
                        showNotification(`Added "${newMap.name}" and synced with Pixel Designer.`);
                    };

                    const addBtn = document.getElementById('sheets-add-screen-btn');
                    if (addBtn) addBtn.addEventListener('click', () => addScreenRow());
                    const addFooterBtn = document.getElementById('sheets-add-row-footer-btn');
                    if (addFooterBtn) addFooterBtn.addEventListener('click', () => addScreenRow());

                    function exportMasterCalculationsCsv() {
                        const csvEscape = (v) => `"${String(v ?? '').replace(/"/g, '""')}"`;
                        const lines = [];

                        lines.push([`Pixelogic LED Master Calculations - Brand & Model Segregation`]);
                        lines.push([`Project:`, activeProject.name || 'Untitled Project']);
                        lines.push([`Mains Voltage:`, `${sheetsState.voltage} V`, `Supply Phases:`, `${sheetsState.phases}-Phase`, `Load Mode:`, `${sheetsState.scenario.toUpperCase()}`]);
                        lines.push([`Generated:`, new Date().toLocaleString()]);
                        lines.push([]);

                        lines.push([`--- SECTION 1: MASTER SUMMARY BY LED BRAND & MODEL ---`]);
                        const summaryHeaders = [
                            '#', 'Brand', 'Model Name', 'Pixel Pitch (mm)', 'Cabinet W (mm)', 'Cabinet H (mm)',
                            'Cabinet Res W (px)', 'Cabinet Res H (px)', 'Tile Area (m²)', 'Tile Area (sqft)',
                            'Total Tiles Used', 'Total Area (m²)', 'Total Area (sqft)',
                            'Load / Tile (A)', 'Load / Tile (W)', 'Total Power (W)', 'Total Power (kW)',
                            'Apparent Power (kVA)', 'Current / Phase (A)', 'Recommended Breaker (A)',
                            'Heat Dissipation (BTU/hr)', 'Screens Count', 'Participating Screens'
                        ];
                        lines.push(summaryHeaders.map(csvEscape).join(','));

                        masterCalcGroups.forEach((grp, idx) => {
                            const screensStr = grp.screens.map(s => `${s.name} (${s.totalTiles} tiles)`).join('; ');
                            lines.push([
                                idx + 1,
                                grp.brand,
                                grp.model,
                                grp.pitchMm,
                                grp.panelW,
                                grp.panelH,
                                grp.resW,
                                grp.resH,
                                grp.tileAreaSqM.toFixed(4),
                                grp.tileAreaSqFt.toFixed(3),
                                grp.totalTiles,
                                grp.totalAreaSqM.toFixed(3),
                                grp.totalAreaSqFt.toFixed(2),
                                grp.perTileAmps.toFixed(2),
                                Math.round(grp.perTileWatts),
                                Math.round(grp.totalWatts),
                                grp.totalKw.toFixed(2),
                                grp.totalKva.toFixed(2),
                                grp.perPhaseAmps.toFixed(2),
                                grp.breakerAmps,
                                grp.heatBtu,
                                grp.screens.length,
                                screensStr
                            ].map(csvEscape).join(','));
                        });

                        lines.push([
                            'TOTALS',
                            `${masterCalcGroups.length} Models`,
                            'ALL MODELS',
                            '—', '—', '—', '—', '—', '—', '—',
                            sumTiles,
                            sumAreaSqM.toFixed(3),
                            sumAreaSqFt.toFixed(2),
                            '—', '—',
                            Math.round(sumWatts),
                            sumKw.toFixed(2),
                            sumKva.toFixed(2),
                            sumPerPhaseAmps.toFixed(2),
                            sumBreaker,
                            Math.round(sumWatts * 3.412142),
                            rowsComputed.length,
                            `${rowsComputed.length} Total Screens`
                        ].map(csvEscape).join(','));

                        lines.push([]);
                        lines.push([`--- SECTION 2: SCREEN-BY-SCREEN BREAKDOWN SEGREGATED BY MODEL ---`]);
                        const screenHeaders = [
                            'Model Group', 'Brand', 'Model', 'Pitch (mm)', 'Screen Name',
                            'Grid W (tiles)', 'Grid H (tiles)', 'Screen Tiles',
                            'Width (m)', 'Height (m)', 'Resolution (px)', 'Screen Area (m²)',
                            'Screen Power (W)', 'Screen Power (kW)', 'Screen Current (A)'
                        ];
                        lines.push(screenHeaders.map(csvEscape).join(','));

                        masterCalcGroups.forEach((grp) => {
                            grp.screens.forEach(s => {
                                lines.push([
                                    `${grp.brand} ${grp.model} (P${grp.pitchMm}mm)`,
                                    grp.brand,
                                    grp.model,
                                    grp.pitchMm,
                                    s.name,
                                    s.tilesW,
                                    s.tilesH,
                                    s.totalTiles,
                                    (s.widthMm / 1000).toFixed(3),
                                    (s.heightMm / 1000).toFixed(3),
                                    `${s.totalResW}x${s.totalResH}`,
                                    s.areaSqM.toFixed(3),
                                    Math.round(s.totalWatts),
                                    s.totalKw.toFixed(2),
                                    s.totalAmps.toFixed(2)
                                ].map(csvEscape).join(','));
                            });
                        });

                        const blob = new Blob([lines.join('\r\n')], { type: 'text/csv;charset=utf-8;' });
                        const url = URL.createObjectURL(blob);
                        const a = document.createElement('a');
                        a.href = url;
                        a.download = `${(activeProject.name || 'pixellogic').replace(/[^a-z0-9-_]/gi, '_')}_master_calculations.csv`;
                        document.body.appendChild(a);
                        a.click();
                        document.body.removeChild(a);
                        URL.revokeObjectURL(url);
                        showNotification('Exported Master Calculations to CSV.');
                    }

                    function printMasterCalculations() {
                        const printWin = window.open('', '_blank', 'width=1200,height=900');
                        if (!printWin) {
                            window.print();
                            return;
                        }

                        const scenarioLabels = {
                            w: 'Full White (100% Peak Load)',
                            avg: 'Dynamic Video (Typical Average)',
                            r: 'Full Red Channel',
                            g: 'Full Green Channel',
                            b: 'Full Blue Channel',
                            s: 'Standby / Idle'
                        };
                        const loadModeText = scenarioLabels[sheetsState.scenario] || String(sheetsState.scenario || 'W').toUpperCase();
                        const brightnessText = sheetsState.brightness === 'half' ? '50% (Half Brightness)' : '100% (Full Brightness)';
                        const reportDate = new Date().toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' });
                        const reportTime = new Date().toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' });
                        const logoSrc = (state.pdfExport && state.pdfExport.logoSrc) || '';

                        const htmlContent = `<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>${escapeHtml(activeProject.name || 'Project')} — LED Master Calculations &amp; Specification Report</title>
    <style>
        @page {
            size: landscape;
            margin: 12mm 15mm;
        }
        *, *::before, *::after {
            box-sizing: border-box;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background: #ffffff;
            color: #0f172a;
            margin: 0;
            padding: 24px;
            font-size: 11px;
            line-height: 1.45;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        /* Top Action Bar (hidden during printing) */
        .no-print-bar {
            background: #0f172a;
            color: #ffffff;
            padding: 12px 20px;
            border-radius: 10px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 4px 14px rgba(0,0,0,0.18);
        }
        .no-print-btn {
            background: #10b981;
            color: #ffffff;
            border: none;
            padding: 8px 18px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: background 0.15s ease;
        }
        .no-print-btn:hover {
            background: #059669;
        }
        .no-print-close {
            background: #334155;
            color: #e2e8f0;
            border: none;
            padding: 8px 14px;
            border-radius: 6px;
            font-size: 12px;
            cursor: pointer;
        }
        .no-print-close:hover {
            background: #475569;
        }

        /* Header Letterhead */
        .doc-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 2.5px solid #0f172a;
            padding-bottom: 16px;
            margin-bottom: 20px;
        }
        .brand-section {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 6px;
        }
        .brand-logo-img {
            max-height: 48px;
            max-width: 160px;
            object-fit: contain;
        }
        .brand-badge {
            background: #0f172a;
            color: #38bdf8;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 4px 10px;
            border-radius: 4px;
            display: inline-block;
        }
        .doc-title {
            font-size: 20px;
            font-weight: 800;
            color: #0f172a;
            margin: 0 0 3px 0;
            letter-spacing: -0.02em;
        }
        .doc-subtitle {
            font-size: 11.5px;
            color: #64748b;
            font-weight: 500;
            margin: 0;
        }

        .meta-box {
            background: #f8fafc;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            padding: 10px 14px;
            min-width: 320px;
        }
        .meta-grid {
            display: grid;
            grid-template-columns: auto 1fr;
            row-gap: 4px;
            column-gap: 12px;
            font-size: 10.5px;
        }
        .meta-label {
            color: #64748b;
            font-weight: 600;
        }
        .meta-val {
            color: #0f172a;
            font-weight: 700;
            text-align: right;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        }

        /* KPI Executive Summary Cards */
        .kpi-container {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 12px;
            margin-bottom: 24px;
        }
        .kpi-card {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-top: 3.5px solid #0284c7;
            border-radius: 8px;
            padding: 10px 12px;
        }
        .kpi-card.purple { border-top-color: #8b5cf6; }
        .kpi-card.emerald { border-top-color: #10b981; }
        .kpi-card.amber { border-top-color: #f59e0b; }
        .kpi-card.rose { border-top-color: #f43f5e; }

        .kpi-label {
            font-size: 10px;
            text-transform: uppercase;
            font-weight: 700;
            color: #64748b;
            letter-spacing: 0.05em;
            margin-bottom: 3px;
        }
        .kpi-value {
            font-size: 18px;
            font-weight: 800;
            color: #0f172a;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            line-height: 1.2;
        }
        .kpi-sub {
            font-size: 10px;
            color: #64748b;
            margin-top: 3px;
            font-weight: 500;
        }

        /* Section Headings */
        .section-title {
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #0f172a;
            margin: 22px 0 10px 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1.5px solid #e2e8f0;
            padding-bottom: 6px;
        }
        .section-tag {
            font-size: 10px;
            font-weight: 600;
            color: #64748b;
            text-transform: none;
            letter-spacing: normal;
        }

        /* Tables */
        table.report-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 10.5px;
            margin-bottom: 18px;
            background: #ffffff;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            overflow: hidden;
        }
        table.report-table thead th {
            background: #0f172a;
            color: #f8fafc;
            padding: 7px 8px;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.03em;
            text-align: left;
            border-right: 1px solid rgba(255,255,255,0.12);
            white-space: nowrap;
        }
        table.report-table thead tr.group-row th {
            background: #1e293b;
            font-size: 9.5px;
            padding: 4px 8px;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: #94a3b8;
            border-bottom: 1px solid rgba(255,255,255,0.15);
        }
        table.report-table tbody td {
            padding: 7px 8px;
            border-bottom: 1px solid #e2e8f0;
            border-right: 1px solid #f1f5f9;
            color: #1e293b;
            vertical-align: middle;
        }
        table.report-table tbody tr:nth-child(even) {
            background: #f8fafc;
        }
        table.report-table tfoot td {
            background: #f1f5f9;
            color: #0f172a;
            font-weight: 800;
            padding: 8px 8px;
            border-top: 2.5px solid #0f172a;
            font-size: 11px;
        }

        .mono {
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        }
        .text-center { text-align: center !important; }
        .text-right { text-align: right !important; }

        /* Badges & Pills */
        .pill-brand {
            background: #e0f2fe;
            color: #0369a1;
            border: 1px solid #bae6fd;
            border-radius: 4px;
            padding: 2px 7px;
            font-weight: 700;
            font-size: 10px;
            display: inline-block;
        }
        .pill-pitch {
            background: #fef3c7;
            color: #92400e;
            border: 1px solid #fde68a;
            border-radius: 4px;
            padding: 2px 6px;
            font-weight: 700;
            font-size: 10px;
            display: inline-block;
        }
        .pill-tile {
            background: #ede9fe;
            color: #5b21b6;
            font-weight: 700;
            border-radius: 4px;
            padding: 2px 6px;
            display: inline-block;
        }
        .pill-area {
            background: #ecfdf5;
            color: #065f46;
            font-weight: 700;
            border-radius: 4px;
            padding: 2px 6px;
            display: inline-block;
        }
        .pill-power {
            background: #fffbeb;
            color: #92400e;
            font-weight: 700;
            border-radius: 4px;
            padding: 2px 6px;
            display: inline-block;
        }
        .pill-screen-tag {
            background: #f1f5f9;
            border: 1px solid #cbd5e1;
            color: #334155;
            border-radius: 4px;
            padding: 2px 6px;
            font-size: 10px;
            display: inline-block;
            margin: 1px 2px;
            white-space: nowrap;
        }

        /* Screen Breakdown Section */
        .model-card {
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            margin-bottom: 14px;
            overflow: hidden;
            page-break-inside: avoid;
        }
        .model-card-header {
            background: #f1f5f9;
            border-bottom: 1px solid #cbd5e1;
            padding: 8px 12px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 11px;
        }
        .model-card-header-left {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .model-card-header-right {
            display: flex;
            align-items: center;
            gap: 14px;
            color: #334155;
            font-weight: 600;
        }

        /* Notes & Signature Footer */
        .doc-footer {
            margin-top: 24px;
            border-top: 1.5px solid #cbd5e1;
            padding-top: 14px;
            display: flex;
            justify-content: space-between;
            gap: 20px;
            font-size: 10px;
            color: #64748b;
            page-break-inside: avoid;
        }
        .doc-notes {
            flex: 1;
            max-width: 600px;
        }
        .doc-notes ul {
            margin: 4px 0 0 16px;
            padding: 0;
        }
        .doc-notes li {
            margin-bottom: 3px;
        }
        .sign-box {
            display: flex;
            gap: 24px;
        }
        .sign-col {
            width: 140px;
            border-bottom: 1px solid #94a3b8;
            padding-bottom: 2px;
            text-align: center;
            font-weight: 600;
            color: #334155;
            margin-top: 24px;
        }
        .sign-label {
            font-size: 9px;
            color: #64748b;
            text-transform: uppercase;
            text-align: center;
            margin-top: 4px;
        }

        @media print {
            body {
                padding: 0;
            }
            .no-print-bar {
                display: none !important;
            }
        }
    </style>
</head>
<body>

    <!-- Non-printing Interactive Action Bar -->
    <div class="no-print-bar">
        <div style="display:flex;align-items:center;gap:12px;">
            <span style="font-weight:800;font-size:14px;letter-spacing:-0.01em;">Pixelogic Engineering Report</span>
            <span style="font-size:11px;color:#94a3b8;">· Ready for PDF export / direct print (Landscape A4/A3)</span>
        </div>
        <div style="display:flex;align-items:center;gap:10px;">
            <button type="button" class="no-print-btn" onclick="window.print()">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                Print / Save as PDF
            </button>
            <button type="button" class="no-print-close" onclick="window.close()">✕ Close</button>
        </div>
    </div>

    <!-- Executive Letterhead Header -->
    <div class="doc-header">
        <div>
            <div class="brand-section">
                ${logoSrc ? `<img src="${escapeHtml(logoSrc)}" class="brand-logo-img" alt="Logo" />` : `<span class="brand-badge">PIXELOGIC PRO</span>`}
            </div>
            <h1 class="doc-title">${escapeHtml(activeProject.name || 'Untitled Project')} — Master Calculations</h1>
            <p class="doc-subtitle">Aggregated LED Hardware Bill of Materials, Physical Surface Area &amp; Electrical Load Analysis</p>
        </div>

        <div class="meta-box">
            <div class="meta-grid">
                <span class="meta-label">Project:</span>
                <span class="meta-val">${escapeHtml(activeProject.name || 'Untitled Project')}</span>
                <span class="meta-label">Date Generated:</span>
                <span class="meta-val">${reportDate} · ${reportTime}</span>
                <span class="meta-label">Mains Supply:</span>
                <span class="meta-val">${sheetsState.voltage}V AC · ${sheetsState.phases}-Phase</span>
                <span class="meta-label">Load Mode:</span>
                <span class="meta-val">${loadModeText}</span>
                <span class="meta-label">Displays / Types:</span>
                <span class="meta-val">${rowsComputed.length} Screens · ${masterCalcGroups.length} LED Models</span>
            </div>
        </div>
    </div>

    <!-- Executive Summary KPI Metrics -->
    <div class="kpi-container">
        <div class="kpi-card">
            <div class="kpi-label">LED Models Used</div>
            <div class="kpi-value">${masterCalcGroups.length} <span style="font-size:12px;font-weight:600;color:#0284c7;">Types</span></div>
            <div class="kpi-sub">${rowsComputed.length} Active Screens</div>
        </div>
        <div class="kpi-card purple">
            <div class="kpi-label">Total Tile Count</div>
            <div class="kpi-value">${sumTiles.toLocaleString()}</div>
            <div class="kpi-sub">${(sumPixels / 1e6).toFixed(2)} Megapixels</div>
        </div>
        <div class="kpi-card emerald">
            <div class="kpi-label">Total Surface Area</div>
            <div class="kpi-value">${sumAreaSqM.toFixed(2)} <span style="font-size:12px;font-weight:600;color:#059669;">m²</span></div>
            <div class="kpi-sub">${sumAreaSqFt.toFixed(1)} sq ft</div>
        </div>
        <div class="kpi-card amber">
            <div class="kpi-label">Total Power Consumed</div>
            <div class="kpi-value">${sumKw.toFixed(2)} <span style="font-size:12px;font-weight:600;color:#d97706;">kW</span></div>
            <div class="kpi-sub">${Math.round(sumWatts).toLocaleString()} W (${sumAmps.toFixed(1)} A)</div>
        </div>
        <div class="kpi-card rose">
            <div class="kpi-label">Service &amp; Breaker</div>
            <div class="kpi-value">${sumBreaker}A <span style="font-size:12px;font-weight:600;color:#e11d48;">Mains</span></div>
            <div class="kpi-sub">${sumKva.toFixed(2)} kVA · ${sumPerPhaseAmps.toFixed(1)} A/Ph</div>
        </div>
    </div>

    <!-- Section 1: Master Specification Schedule Table -->
    <div class="section-title">
        <span>1. Master LED Hardware &amp; Electrical Schedule (Ordered by Brand &amp; Pitch)</span>
        <span class="section-tag">${masterCalcGroups.length} Distinct Hardware Groups Segregated</span>
    </div>

    <table class="report-table">
        <thead>
            <tr class="group-row">
                <th colspan="4" style="background:#0f172a;color:#38bdf8;">Hardware Specification</th>
                <th colspan="2" style="background:#1e293b;color:#94a3b8;">Cabinet Specs</th>
                <th colspan="2" style="background:#2e1065;color:#c084fc;">Quantities &amp; Dimensions</th>
                <th colspan="5" style="background:#450a0a;color:#fca5a5;">Electrical Consumption (${sheetsState.voltage}V · ${sheetsState.phases}Ph)</th>
                <th colspan="1" style="background:#064e3b;color:#6ee7b7;">Allocations</th>
            </tr>
            <tr>
                <th style="width:28px;" class="text-center">#</th>
                <th style="width:110px;">Brand</th>
                <th>Model Name</th>
                <th style="width:75px;" class="text-center">Pitch</th>
                <th style="width:95px;" class="text-center">Cabinet (mm)</th>
                <th style="width:90px;" class="text-center">Resolution</th>
                <th style="width:85px;" class="text-center">Total Tiles</th>
                <th style="width:115px;" class="text-center">Total Area</th>
                <th style="width:95px;" class="text-center">Load / Tile</th>
                <th style="width:105px;" class="text-center">Active Power</th>
                <th style="width:80px;" class="text-center">Current</th>
                <th style="width:75px;" class="text-center">kVA</th>
                <th style="width:75px;" class="text-center">Breaker</th>
                <th>Assigned Screens</th>
            </tr>
        </thead>
        <tbody>
            ${masterCalcGroups.map((grp, i) => `
            <tr>
                <td class="text-center mono" style="color:#64748b;font-weight:700;">${i + 1}</td>
                <td><span class="pill-brand">${escapeHtml(grp.brand)}</span></td>
                <td style="font-weight:700;color:#0f172a;">${escapeHtml(grp.model)}</td>
                <td class="text-center"><span class="pill-pitch">P${grp.pitchMm} mm</span></td>
                <td class="text-center mono text-slate-700">${grp.panelW}×${grp.panelH} mm</td>
                <td class="text-center mono text-slate-700">${grp.resW}×${grp.resH} px</td>
                <td class="text-center mono"><span class="pill-tile">${grp.totalTiles} <span style="font-size:9px;opacity:0.8;">(${grp.pctTiles}%)</span></span></td>
                <td class="text-center mono"><span class="pill-area">${grp.totalAreaSqM.toFixed(2)} m²</span><div style="font-size:9px;color:#64748b;margin-top:1px;">${grp.totalAreaSqFt.toFixed(1)} ft²</div></td>
                <td class="text-center mono">${Math.round(grp.perTileWatts)} W<div style="font-size:9px;color:#64748b;">${grp.perTileAmps.toFixed(2)} A</div></td>
                <td class="text-center mono"><span class="pill-power">${grp.totalKw.toFixed(2)} kW</span><div style="font-size:9px;color:#64748b;">${Math.round(grp.totalWatts).toLocaleString()} W</div></td>
                <td class="text-center mono" style="font-weight:700;color:#b91c1c;">${grp.totalAmps.toFixed(2)} A</td>
                <td class="text-center mono">${grp.totalKva.toFixed(2)}</td>
                <td class="text-center mono" style="font-weight:800;color:#92400e;">${grp.breakerAmps} A</td>
                <td>
                    ${grp.screens.map(s => `<span class="pill-screen-tag"><b>${escapeHtml(s.name)}:</b> ${s.totalTiles} tiles (${s.areaSqM.toFixed(1)}m²)</span>`).join('')}
                </td>
            </tr>
            `).join('')}
        </tbody>
        <tfoot>
            <tr>
                <td class="text-center mono">Σ</td>
                <td colspan="5">PROJECT GRAND TOTALS (${masterCalcGroups.length} LED Models · ${rowsComputed.length} Active Screens)</td>
                <td class="text-center mono" style="font-size:12px;color:#5b21b6;">${sumTiles.toLocaleString()}</td>
                <td class="text-center mono" style="font-size:12px;color:#065f46;">${sumAreaSqM.toFixed(2)} m²<div style="font-size:9px;font-weight:normal;color:#64748b;">${sumAreaSqFt.toFixed(1)} ft²</div></td>
                <td class="text-center mono" style="font-size:10px;color:#64748b;">Σ Load</td>
                <td class="text-center mono" style="font-size:12px;color:#92400e;">${sumKw.toFixed(2)} kW<div style="font-size:9px;font-weight:normal;color:#64748b;">${Math.round(sumWatts).toLocaleString()} W</div></td>
                <td class="text-center mono" style="font-size:12px;color:#b91c1c;">${sumAmps.toFixed(2)} A</td>
                <td class="text-center mono">${sumKva.toFixed(2)}</td>
                <td class="text-center mono" style="font-size:12px;color:#92400e;">${sumBreaker} A</td>
                <td style="font-size:10px;color:#475569;font-weight:600;">Service: ${sumBreaker}A Main Breaker (${sumPerPhaseAmps.toFixed(1)} A/Phase)</td>
            </tr>
        </tfoot>
    </table>

    <!-- Section 2: Detailed Screen Allocation Breakdown -->
    <div class="section-title">
        <span>2. Individual Screen Allocation &amp; Power Breakdown</span>
        <span class="section-tag">Screen Specifications Segregated by Model</span>
    </div>

    ${masterCalcGroups.map(grp => `
    <div class="model-card">
        <div class="model-card-header">
            <div class="model-card-header-left">
                <span class="pill-brand">${escapeHtml(grp.brand)}</span>
                <strong style="color:#0f172a;font-size:12px;">${escapeHtml(grp.model)}</strong>
                <span class="pill-pitch">P${grp.pitchMm} mm</span>
                <span style="color:#64748b;font-size:10px;">(${grp.panelW}×${grp.panelH} mm · ${grp.resW}×${grp.resH} px · ${grp.tileAreaSqM.toFixed(3)} m²/tile)</span>
            </div>
            <div class="model-card-header-right mono">
                <span>Group Tiles: <b style="color:#5b21b6;">${grp.totalTiles}</b></span>
                <span>Group Area: <b style="color:#065f46;">${grp.totalAreaSqM.toFixed(2)} m²</b> (${grp.totalAreaSqFt.toFixed(1)} ft²)</span>
                <span>Group Power: <b style="color:#92400e;">${grp.totalKw.toFixed(2)} kW</b> (${grp.totalAmps.toFixed(1)} A)</span>
            </div>
        </div>

        <table class="report-table" style="margin-bottom:0;border:none;">
            <thead>
                <tr style="background:#f8fafc;">
                    <th style="background:#f1f5f9;color:#475569;width:30px;" class="text-center">#</th>
                    <th style="background:#f1f5f9;color:#334155;">Display / Screen Name</th>
                    <th style="background:#f1f5f9;color:#334155;" class="text-center">Pixel Resolution</th>
                    <th style="background:#f1f5f9;color:#334155;" class="text-center">Grid Layout</th>
                    <th style="background:#f1f5f9;color:#334155;" class="text-center">Tile Count</th>
                    <th style="background:#f1f5f9;color:#334155;" class="text-center">Screen Size (W × H)</th>
                    <th style="background:#f1f5f9;color:#334155;" class="text-center">Display Area</th>
                    <th style="background:#f1f5f9;color:#334155;" class="text-center">Power Draw (W / kW)</th>
                    <th style="background:#f1f5f9;color:#334155;" class="text-center">Current</th>
                    <th style="background:#f1f5f9;color:#334155;" class="text-center">% of Model</th>
                </tr>
            </thead>
            <tbody>
                ${grp.screens.map((s, sIdx) => {
                    const pctOfModel = grp.totalTiles > 0 ? ((s.totalTiles / grp.totalTiles) * 100).toFixed(1) : '100';
                    return `
                    <tr>
                        <td class="text-center mono" style="color:#94a3b8;">${sIdx + 1}</td>
                        <td style="font-weight:700;color:#0f172a;">${escapeHtml(s.name)}</td>
                        <td class="text-center mono">${s.totalResW} × ${s.totalResH} px</td>
                        <td class="text-center mono" style="color:#5b21b6;font-weight:700;">${s.tilesW} × ${s.tilesH}</td>
                        <td class="text-center mono" style="font-weight:800;color:#5b21b6;">${s.totalTiles} tiles</td>
                        <td class="text-center mono">${(s.widthMm / 1000).toFixed(2)}m × ${(s.heightMm / 1000).toFixed(2)}m <span style="font-size:9px;color:#64748b;">(${formatSheetUnitNum(s.widthMm, 'ft')}×${formatSheetUnitNum(s.heightMm, 'ft')}ft)</span></td>
                        <td class="text-center mono" style="font-weight:700;color:#065f46;">${s.areaSqM.toFixed(2)} m²</td>
                        <td class="text-center mono"><b style="color:#92400e;">${s.totalKw.toFixed(2)} kW</b> <span style="font-size:9px;color:#64748b;">(${Math.round(s.totalWatts).toLocaleString()} W)</span></td>
                        <td class="text-center mono" style="font-weight:700;color:#b91c1c;">${s.totalAmps.toFixed(2)} A</td>
                        <td class="text-center mono" style="color:#64748b;">${pctOfModel}%</td>
                    </tr>
                    `;
                }).join('')}
            </tbody>
        </table>
    </div>
    `).join('')}

    <!-- Notes & Sign-off Footer -->
    <div class="doc-footer">
        <div class="doc-notes">
            <strong style="color:#334155;text-transform:uppercase;font-size:10px;letter-spacing:0.04em;">Engineering Notes &amp; Standards:</strong>
            <ul>
                <li>All electrical calculations are based on <strong>${sheetsState.voltage}V AC supply (${sheetsState.phases}-Phase)</strong> with an assumed standard power factor of 0.90.</li>
                <li>Load mode is configured to <strong>${loadModeText}</strong> at <strong>${brightnessText}</strong>.</li>
                <li>Recommended circuit breaker ratings incorporate a standard 25% continuous operation safety margin pursuant to IEC 60364 / NEC Article 645 guidelines.</li>
                <li>Physical raster coordinates and tile quantifications are directly synchronized with the live Pixelogic Designer visualizer.</li>
            </ul>
        </div>

        <div class="sign-box">
            <div>
                <div class="sign-col"></div>
                <div class="sign-label">Prepared By (Lead Engineer)</div>
            </div>
            <div>
                <div class="sign-col"></div>
                <div class="sign-label">Verified &amp; Approved By</div>
            </div>
            <div>
                <div class="sign-col">${reportDate}</div>
                <div class="sign-label">Approval Date</div>
            </div>
        </div>
    </div>

</body>
</html>`;

                        printWin.document.open();
                        printWin.document.write(htmlContent);
                        printWin.document.close();
                    }

                    const exportMasterTopBtn = document.getElementById('sheets-export-master-top-btn');
                    if (exportMasterTopBtn) exportMasterTopBtn.addEventListener('click', exportMasterCalculationsCsv);
                    const exportMasterCsvBtn = document.getElementById('sheets-export-master-csv-btn');
                    if (exportMasterCsvBtn) exportMasterCsvBtn.addEventListener('click', exportMasterCalculationsCsv);
                    const printMasterTopBtn = document.getElementById('sheets-print-master-top-btn');
                    if (printMasterTopBtn) printMasterTopBtn.addEventListener('click', printMasterCalculations);
                    const printMasterBtn = document.getElementById('sheets-print-master-btn');
                    if (printMasterBtn) printMasterBtn.addEventListener('click', printMasterCalculations);

                    const gotoDesignerBtn = document.getElementById('sheets-goto-designer-btn');
                    if (gotoDesignerBtn) gotoDesignerBtn.addEventListener('click', () => switchTab('designer'));

                    const exportCsvBtn = document.getElementById('sheets-export-csv-btn');
                    if (exportCsvBtn) {
                        exportCsvBtn.addEventListener('click', () => {
                            if (sheetsState.activeSheet === 'master_calculations') {
                                exportMasterCalculationsCsv();
                                return;
                            }
                            const headers = [
                                'Row', 'Screen Name', 'LED Brand', 'LED Model', 'Pitch (mm)',
                                'Cabinet W (mm)', 'Cabinet H (mm)', 'Cabinet Res W (px)', 'Cabinet Res H (px)',
                                'Tiles W', 'Tiles H', 'Total Tiles',
                                'Width (m)', 'Height (m)', 'Width (mm)', 'Height (mm)',
                                'Width (cm)', 'Height (cm)', 'Width (in)', 'Height (in)',
                                'Width (ft)', 'Height (ft)', 'Total Res W (px)', 'Total Res H (px)',
                                'Amps/Tile (A)', 'Total Amps (A)', 'Total Power (W)', 'Total Power (kW)',
                                'Apparent Power (kVA)', 'Amps/Phase (A)', 'Recommended Breaker (A)'
                            ];
                            const csvEscape = (v) => `"${String(v ?? '').replace(/"/g, '""')}"`;
                            const lines = [headers.map(csvEscape).join(',')];
                            rowsComputed.forEach(r => {
                                lines.push([
                                    r.idx + 1, r.map.name, r.ledBrand || 'Custom', r.ledModel || 'Custom', r.pitchMm,
                                    r.panelW, r.panelH, r.resW, r.resH,
                                    r.tilesW, r.tilesH, r.totalTiles,
                                    formatSheetUnitNum(r.widthMm, 'm'), formatSheetUnitNum(r.heightMm, 'm'),
                                    formatSheetUnitNum(r.widthMm, 'mm'), formatSheetUnitNum(r.heightMm, 'mm'),
                                    formatSheetUnitNum(r.widthMm, 'cm'), formatSheetUnitNum(r.heightMm, 'cm'),
                                    formatSheetUnitNum(r.widthMm, 'in'), formatSheetUnitNum(r.heightMm, 'in'),
                                    formatSheetUnitNum(r.widthMm, 'ft'), formatSheetUnitNum(r.heightMm, 'ft'),
                                    r.totalResW, r.totalResH,
                                    r.perTileAmps.toFixed(2), r.totalAmps.toFixed(2),
                                    Math.round(r.totalWatts), r.totalKw.toFixed(2),
                                    r.totalKva.toFixed(2), r.perPhaseAmps.toFixed(2), r.breakerAmps
                                ].map(csvEscape).join(','));
                            });
                            const blob = new Blob([lines.join('\r\n')], { type: 'text/csv;charset=utf-8;' });
                            const url = URL.createObjectURL(blob);
                            const a = document.createElement('a');
                            a.href = url;
                            a.download = `${(activeProject.name || 'pixellogic').replace(/[^a-z0-9-_]/gi, '_')}_led_sheet.csv`;
                            document.body.appendChild(a);
                            a.click();
                            document.body.removeChild(a);
                            URL.revokeObjectURL(url);
                            showNotification('Exported LED Sheet to CSV.');
                        });
                    }

                    // Top worksheet tabs
                    c.querySelectorAll('[data-sheet-tab]').forEach(btn => {
                        btn.addEventListener('click', () => {
                            sheetsState.activeSheet = btn.dataset.sheetTab || 'drawings';
                            renderSheetsTab();
                        });
                    });
                    if (sheetsState.activeSheet === 'drawings' && window.SheetsCadDrawings) {
                        const cadMount = document.getElementById('pl-cad-drawings-mount');
                        if (cadMount) {
                            window.SheetsCadDrawings.bindDrawingsEvents(cadMount, activeProject.name || 'Untitled Project', rowsComputed, sheetsState, renderSheetsTab);
                        }
                    }

                    // Catalog filters
                    const catBrandFilter = document.getElementById('sheets-catalog-brand-filter');
                    if (catBrandFilter) {
                        catBrandFilter.addEventListener('change', (e) => {
                            sheetsState.catalogBrandFilter = e.target.value || 'ALL';
                            renderSheetsTab();
                        });
                    }
                    const catSearch = document.getElementById('sheets-catalog-search');
                    if (catSearch) {
                        catSearch.addEventListener('input', (e) => {
                            sheetsState.catalogSearch = e.target.value || '';
                            const pos = e.target.selectionStart;
                            renderSheetsTab();
                            const nextInput = document.getElementById('sheets-catalog-search');
                            if (nextInput) {
                                nextInput.focus();
                                try { nextInput.setSelectionRange(pos, pos); } catch (_) {}
                            }
                        });
                    }

                    // Focus tracking for Excel Formula Bar
                    c.querySelectorAll('[data-cell]').forEach(el => {
                        el.addEventListener('focus', () => {
                            const ref = el.dataset.cell || 'A1';
                            const form = el.dataset.formula || '';
                            sheetsState.selectedCellRef = ref;
                            sheetsState.selectedCellFormula = `${form}  →  Value: ${el.value}`;
                            const refEl = document.getElementById('sheets-cell-ref');
                            const formEl = document.getElementById('sheets-cell-formula');
                            if (refEl) refEl.textContent = ref;
                            if (formEl) formEl.textContent = sheetsState.selectedCellFormula;
                        });
                    });

                    // Schedule cell change handlers (two-way sync with Pixel Designer)
                    c.querySelectorAll('[data-sheet-field]').forEach(el => {
                        el.addEventListener('change', () => {
                            const mapId = el.dataset.mapId;
                            const map = activeProject.pixelMaps.find(m => String(m.id) === String(mapId));
                            if (!map) return;
                            const field = el.dataset.sheetField;
                            if (field === 'name') {
                                map.name = el.value.trim() || 'Screen';
                            } else if (field === 'brand') {
                                const newBrand = el.value;
                                map.ledBrand = newBrand;
                                const firstModel = catalog.find(item => item.brand === newBrand);
                                if (firstModel) {
                                    applyLedModelToMap(map, firstModel.brand, firstModel.model);
                                } else {
                                    map.ledModel = '';
                                }
                            } else if (field === 'model') {
                                const raw = el.value || '';
                                if (raw.includes('|||')) {
                                    const [bName, mName] = raw.split('|||');
                                    applyLedModelToMap(map, bName, mName);
                                } else {
                                    map.ledModel = '';
                                }
                            }
                            activeProject.activePixelMapId = map.id;
                            saveState();
                            redrawAffectedVisuals();
                            renderSheetsTab();
                        });
                    });

                    // Tile count edits
                    c.querySelectorAll('[data-sheet-tiles]').forEach(el => {
                        el.addEventListener('change', () => {
                            const mapId = el.dataset.mapId;
                            const map = activeProject.pixelMaps.find(m => String(m.id) === String(mapId));
                            if (!map) return;
                            updateMapTilesCount(map, el.dataset.sheetTiles, el.value);
                            activeProject.activePixelMapId = map.id;
                            saveState();
                            redrawAffectedVisuals();
                            renderSheetsTab();
                        });
                    });

                    // Header & per-row unit selector dropdowns (m, mm, cm, in, ft)
                    const headerUnitSel = document.getElementById('sheets-header-unit-select');
                    if (headerUnitSel) {
                        headerUnitSel.addEventListener('change', (e) => {
                            const nextU = e.target.value || 'm';
                            sheetsState.sizeUnit = nextU;
                            activeProject.pixelMaps.forEach(m => { m.sheetRowUnit = nextU; });
                            saveState();
                            renderSheetsTab();
                        });
                    }
                    const catCabUnitSel = document.getElementById('sheets-catalog-cab-unit-select');
                    if (catCabUnitSel) {
                        catCabUnitSel.addEventListener('change', (e) => {
                            sheetsState.catalogCabUnit = e.target.value || 'mm';
                            renderSheetsTab();
                        });
                    }
                    c.querySelectorAll('[data-sheet-row-unit]').forEach(el => {
                        el.addEventListener('change', () => {
                            const mapId = el.dataset.mapId;
                            const map = activeProject.pixelMaps.find(m => String(m.id) === String(mapId));
                            if (!map) return;
                            map.sheetRowUnit = el.value || 'm';
                            saveState();
                            renderSheetsTab();
                        });
                    });

                    // Multi-unit size edits (m, mm, cm, in, ft)
                    c.querySelectorAll('[data-sheet-unit]').forEach(el => {
                        el.addEventListener('change', () => {
                            const mapId = el.dataset.mapId;
                            const map = activeProject.pixelMaps.find(m => String(m.id) === String(mapId));
                            if (!map) return;
                            updateMapDimensionInUnit(map, el.dataset.sheetAxis, el.value, el.dataset.sheetUnit);
                            activeProject.activePixelMapId = map.id;
                            saveState();
                            redrawAffectedVisuals();
                            renderSheetsTab();
                        });
                    });

                    // Row action buttons
                    c.querySelectorAll('[data-action]').forEach(btn => {
                        btn.addEventListener('click', () => {
                            const action = btn.dataset.action;
                            const mapId = btn.dataset.mapId;
                            const map = mapId ? activeProject.pixelMaps.find(m => String(m.id) === String(mapId)) : null;

                            if (action === 'add-screen-top') {
                                addScreenRow();
                                return;
                            } else if (action === 'activate-row' && map) {
                                activeProject.activePixelMapId = map.id;
                                saveState();
                                renderSheetsTab();
                            } else if (action === 'open-in-designer' && map) {
                                activeProject.activePixelMapId = map.id;
                                saveState();
                                switchTab('designer');
                            } else if (action === 'open-in-drawings' && map) {
                                activeProject.activePixelMapId = map.id;
                                sheetsState.drawingMapId = map.id;
                                sheetsState.activeSheet = 'drawings';
                                saveState();
                                renderSheetsTab();
                            } else if (action === 'open-in-patching' && map) {
                                activeProject.activePixelMapId = map.id;
                                saveState();
                                switchTab('led-patching');
                            } else if (action === 'open-in-power' && map) {
                                const calcs = calculateLayout(map) || {};
                                state.powerCalcState = state.powerCalcState || { brand: '', model: '', tiles: 100, voltage: 230, phases: 3, brightness: 'full' };
                                if (map.ledBrand) state.powerCalcState.brand = map.ledBrand;
                                if (map.ledModel) state.powerCalcState.model = map.ledModel;
                                state.powerCalcState.tiles = Math.max(1, Number(calcs.totalPanels) || 1);
                                state.powerCalcState.voltage = sheetsState.voltage;
                                state.powerCalcState.phases = sheetsState.phases;
                                state.powerCalcState.brightness = sheetsState.brightness;
                                switchTab('power-calc');
                            } else if (action === 'duplicate-row' && map) {
                                const copy = JSON.parse(JSON.stringify(map));
                                copy.id = Date.now() + Math.floor(Math.random() * 1000);
                                copy.name = `${map.name || 'Screen'} (Copy)`;
                                activeProject.pixelMaps.push(copy);
                                activeProject.activePixelMapId = copy.id;
                                saveState();
                                redrawAffectedVisuals();
                                renderSheetsTab();
                                showNotification(`Duplicated "${map.name}".`);
                            } else if (action === 'delete-row' && map) {
                                if (activeProject.pixelMaps.length <= 1) return;
                                activeProject.pixelMaps = activeProject.pixelMaps.filter(m => String(m.id) !== String(map.id));
                                if (String(activeProject.activePixelMapId) === String(map.id)) {
                                    activeProject.activePixelMapId = activeProject.pixelMaps[0].id;
                                }
                                saveState();
                                redrawAffectedVisuals();
                                renderSheetsTab();
                                showNotification(`Removed screen "${map.name}".`);
                            } else if (action === 'catalog-apply-active') {
                                const b = btn.dataset.brand;
                                const m = btn.dataset.model;
                                const targetMap = getActivePixelMap();
                                if (targetMap && b && m) {
                                    applyLedModelToMap(targetMap, b, m);
                                    saveState();
                                    redrawAffectedVisuals();
                                    sheetsState.activeSheet = 'schedule';
                                    renderSheetsTab();
                                    showNotification(`Applied ${b} ${m} to "${targetMap.name}".`);
                                }
                            } else if (action === 'catalog-add-screen') {
                                const b = btn.dataset.brand;
                                const m = btn.dataset.model;
                                if (b && m) {
                                    sheetsState.activeSheet = 'schedule';
                                    addScreenRow(b, m);
                                }
                            } else if (action === 'catalog-edit-model') {
                                const b = btn.dataset.brand;
                                const m = btn.dataset.model;
                                const item = catalog.find(x => x.brand === b && x.model === m);
                                if (item) {
                                    const v = Number(sheetsState.voltage) || 230;
                                    const fw = item.full?.w ?? 0.7;
                                    const hw = item.half?.w ?? Number((fw * 0.56).toFixed(2));
                                    sheetsState.newLedDraft = {
                                        brand: item.brand,
                                        model: item.model,
                                        pitchMm: item.pitchMm,
                                        panelWidthMm: item.panelWidthMm,
                                        panelHeightMm: item.panelHeightMm,
                                        panelResWidth: item.panelResWidth,
                                        panelResHeight: item.panelResHeight,
                                        maxWatts: Math.round(fw * v),
                                        halfWatts: Math.round(hw * v),
                                        fullW: fw,
                                        fullR: item.full?.r ?? Number((fw * 0.6).toFixed(2)),
                                        fullG: item.full?.g ?? Number((fw * 0.45).toFixed(2)),
                                        fullB: item.full?.b ?? Number((fw * 0.38).toFixed(2)),
                                        fullS: item.full?.s ?? 0.12,
                                        halfW: hw,
                                        isEditing: true
                                    };
                                    sheetsState.showAddBrandModal = true;
                                    renderSheetsTab();
                                }
                            } else if (action === 'catalog-delete-model') {
                                const b = btn.dataset.brand;
                                const m = btn.dataset.model;
                                const list = loadCustomLedCatalog().filter(x =>
                                    !(String(x.brand).toUpperCase() === String(b).toUpperCase() && String(x.model).toUpperCase() === String(m).toUpperCase())
                                );
                                saveCustomLedCatalog(list);
                                const idxInPower = LED_POWER_DATA.findIndex(x =>
                                    x.isCustom && String(x.brand).toUpperCase() === String(b).toUpperCase() && String(x.model).toUpperCase() === String(m).toUpperCase()
                                );
                                if (idxInPower >= 0) LED_POWER_DATA.splice(idxInPower, 1);
                                renderSheetsTab();
                                showNotification(`Deleted custom LED model ${b} ${m}.`);
                            }
                        });
                    });
                };

                const renderPowerCalcTab = () => {
                    const c = mainContent['power-calc'];
                    if (!c) return;

                    const pcState = state.powerCalcState = state.powerCalcState || {
                        brand: '', model: '', tiles: 100, voltage: 230, phases: 3, brightness: 'full'
                    };

                    try { if (typeof syncCustomLedsIntoPowerData === 'function') syncCustomLedsIntoPowerData(); } catch (_) {}
                    const brands = [...new Set(LED_POWER_DATA.map(d => d.brand))].sort();
                    const modelsForBrand = pcState.brand
                        ? LED_POWER_DATA.filter(d => d.brand === pcState.brand).map(d => d.model)
                        : [];
                    const entry = LED_POWER_DATA.find(d => d.brand === pcState.brand && d.model === pcState.model);
                    const rowData = entry ? (pcState.brightness === 'half' && entry.half ? entry.half : entry.full) : null;

                    const BREAKERS = [10,13,16,20,25,32,40,50,63,80,100,125,160,200];
                    const nextBreaker = (a) => BREAKERS.find(b => b >= a) || Math.ceil(a/10)*10;
                    const fmt = (v) => v != null ? v.toFixed(2) : '—';
                    const fmtW = (a, v) => (a != null && v != null) ? (a * v).toFixed(0) + ' W' : '—';

                    const tilesPerPhase = Math.ceil((pcState.tiles || 1) / (pcState.phases || 1));
                    const totalTiles = pcState.tiles || 0;

                    const calcRow = (key) => {
                        if (!rowData || rowData[key] == null) return { perTile: null, total: null, perPhase: null, totalW: null, perPhaseW: null };
                        const perTile = rowData[key];
                        const total = perTile * totalTiles;
                        const perPhase = perTile * tilesPerPhase;
                        return {
                            perTile,
                            total,
                            perPhase,
                            totalW: total * pcState.voltage,
                            perPhaseW: perPhase * pcState.voltage,
                            breaker: nextBreaker(perPhase * 1.25)
                        };
                    };

                    const scenarios = [
                        { key: 'r', label: 'Full Red',   color: 'text-red-400',   bg: 'bg-red-900/20',   border: 'border-red-800/40' },
                        { key: 'g', label: 'Full Green', color: 'text-green-400', bg: 'bg-green-900/20', border: 'border-green-800/40' },
                        { key: 'b', label: 'Full Blue',  color: 'text-blue-400',  bg: 'bg-blue-900/20',  border: 'border-blue-800/40' },
                        { key: 'w', label: 'Full White', color: 'text-white',     bg: 'bg-gray-700/30',  border: 'border-gray-600/40' },
                        { key: 's', label: 'Standby',    color: 'text-gray-400',  bg: 'bg-gray-800/30',  border: 'border-gray-700/40' },
                    ];

                    const worstCase = rowData ? Math.max(...['r','g','b','w'].map(k => rowData[k] || 0)) * totalTiles : 0;
                    const worstPerPhase = rowData ? Math.max(...['r','g','b','w'].map(k => rowData[k] || 0)) * tilesPerPhase : 0;
                    const worstBreaker = nextBreaker(worstPerPhase * 1.25);

                    const scenarioCards = scenarios.map(sc => {
                        const r = calcRow(sc.key);
                        return `
                        <div class="rounded-lg border ${sc.border} ${sc.bg} p-3 space-y-1">
                            <div class="text-xs font-semibold uppercase tracking-wide ${sc.color}">${sc.label}</div>
                            <div class="grid grid-cols-2 gap-x-4 text-xs text-gray-300">
                                <div class="text-gray-500">Per tile</div>
                                <div class="font-mono font-semibold">${fmt(r.perTile)} A</div>
                                <div class="text-gray-500">Total (${totalTiles} tiles)</div>
                                <div class="font-mono font-semibold">${fmt(r.total)} A &nbsp;<span class="text-gray-500 font-normal">${fmtW(r.total, pcState.voltage)}</span></div>
                                ${pcState.phases > 1 ? `
                                <div class="text-gray-500">Per phase (${tilesPerPhase} tiles)</div>
                                <div class="font-mono font-semibold">${fmt(r.perPhase)} A &nbsp;<span class="text-gray-500 font-normal">${fmtW(r.perPhase, pcState.voltage)}</span></div>
                                <div class="text-gray-500">Breaker / phase</div>
                                <div class="font-mono font-semibold text-amber-400">${r.perPhase != null ? worstBreaker + ' A' : '—'}</div>
                                ` : `
                                <div class="text-gray-500">Breaker</div>
                                <div class="font-mono font-semibold text-amber-400">${r.total != null ? nextBreaker(r.total * 1.25) + ' A' : '—'}</div>
                                `}
                            </div>
                        </div>`;
                    }).join('');

                    const phaseTable = pcState.phases > 1 && rowData ? (() => {
                        const keys = ['r','g','b','w','s'];
                        const labels = ['Red','Green','Blue','White','Standby'];
                        const phases = ['L1','L2','L3'].slice(0, pcState.phases);
                        const tilesEach = phases.map((_, i) => {
                            const base = Math.floor(totalTiles / pcState.phases);
                            return i < (totalTiles % pcState.phases) ? base + 1 : base;
                        });
                        return `
                        <div class="rounded-xl border border-white/10 bg-slate-900/40 p-4">
                            <div class="text-sm font-semibold text-slate-200 mb-3">Phase Distribution (${pcState.phases}-Phase)</div>
                            <div class="overflow-x-auto">
                                <table class="w-full text-xs border-collapse">
                                    <thead>
                                        <tr class="text-gray-400 border-b border-gray-700">
                                            <th class="text-left pb-2 pr-3">Phase</th>
                                            <th class="text-right pb-2 px-2">Tiles</th>
                                            ${labels.map(l=>`<th class="text-right pb-2 px-2">${l}</th>`).join('')}
                                            <th class="text-right pb-2 px-2">Breaker</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        ${phases.map((ph, i) => {
                                            const tph = tilesEach[i];
                                            const worstA = Math.max(...keys.slice(0,4).map(k => (rowData[k]||0) * tph));
                                            const brk = nextBreaker(worstA * 1.25);
                                            return `<tr class="border-b border-gray-800/60">
                                                <td class="py-1.5 pr-3 font-semibold text-cyan-400">${ph}</td>
                                                <td class="py-1.5 px-2 text-right text-gray-300">${tph}</td>
                                                ${keys.map(k => {
                                                    const a = rowData[k] != null ? (rowData[k] * tph).toFixed(2) : '—';
                                                    return `<td class="py-1.5 px-2 text-right font-mono text-gray-200">${a}${rowData[k]!=null?' A':''}</td>`;
                                                }).join('')}
                                                <td class="py-1.5 px-2 text-right font-mono font-semibold text-amber-400">${brk} A</td>
                                            </tr>`;
                                        }).join('')}
                                        <tr class="border-t border-gray-600 font-semibold">
                                            <td class="pt-2 pr-3 text-gray-300">TOTAL</td>
                                            <td class="pt-2 px-2 text-right text-gray-300">${totalTiles}</td>
                                            ${keys.map(k => {
                                                const a = rowData[k] != null ? (rowData[k] * totalTiles).toFixed(2) : '—';
                                                return `<td class="pt-2 px-2 text-right font-mono text-white">${a}${rowData[k]!=null?' A':''}</td>`;
                                            }).join('')}
                                            <td class="pt-2 px-2 text-right font-mono font-semibold text-amber-400">${nextBreaker(worstCase * 1.25 / pcState.phases)} A</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>`;
                    })() : '';

                    const summaryBlock = rowData ? (() => {
                        const wRow = calcRow('w');
                        const totalKW = (wRow.totalW / 1000).toFixed(2);
                        const totalKVA = ((wRow.totalW / 1000) / 0.9).toFixed(2);
                        return `
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                            <div class="rounded-lg bg-amber-500/10 border border-amber-500/30 p-3 text-center">
                                <div class="text-lg font-bold text-amber-400 font-mono">${fmt(wRow.total)} A</div>
                                <div class="text-[10px] text-gray-400 mt-0.5">Total (Full White)</div>
                            </div>
                            <div class="rounded-lg bg-cyan-500/10 border border-cyan-500/30 p-3 text-center">
                                <div class="text-lg font-bold text-cyan-400 font-mono">${totalKW} kW</div>
                                <div class="text-[10px] text-gray-400 mt-0.5">Active Power (White)</div>
                            </div>
                            <div class="rounded-lg bg-purple-500/10 border border-purple-500/30 p-3 text-center">
                                <div class="text-lg font-bold text-purple-400 font-mono">${totalKVA} kVA</div>
                                <div class="text-[10px] text-gray-400 mt-0.5">Apparent Power (PF 0.9)</div>
                            </div>
                            <div class="rounded-lg bg-green-500/10 border border-green-500/30 p-3 text-center">
                                <div class="text-lg font-bold text-green-400 font-mono">${worstBreaker} A</div>
                                <div class="text-[10px] text-gray-400 mt-0.5">Breaker / Phase (×1.25)</div>
                            </div>
                        </div>`;
                    })() : '';

                    c.innerHTML = `
                    <div class="max-w-5xl mx-auto space-y-4 pb-8">
                        <!-- Header -->
                        <div class="flex items-center justify-between gap-3 mb-1">
                            <div class="flex items-center gap-3">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                                <div>
                                    <h2 class="text-xl font-bold text-white">LED Power Calculator</h2>
                                    <p class="text-xs text-gray-400">Source: LED Test Report 2025 — per-tile measured Amp values at 100% and 50% brightness</p>
                                </div>
                            </div>
                            <button id="pc-export-pdf" class="px-4 py-2 rounded-lg bg-rose-700 hover:bg-rose-600 text-white text-xs font-semibold flex items-center gap-1.5 shadow" ${!entry ? 'disabled style="opacity:0.4;cursor:not-allowed"' : ''}>
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10,9 9,9 8,9"/></svg>
                                Export PDF
                            </button>
                        </div>

                        <!-- Configuration Panel -->
                        <div class="rounded-xl border border-white/10 bg-slate-900/40 p-4">
                            <div class="text-sm font-semibold text-slate-300 mb-3 uppercase tracking-wide">Configuration</div>
                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                                <div class="space-y-1">
                                    <label class="text-xs text-gray-400">Brand</label>
                                    <select id="pc-brand" class="w-full bg-gray-900 border border-gray-700 rounded-lg px-3 py-2 text-sm text-gray-100">
                                        <option value="">— Select Brand —</option>
                                        ${brands.map(b => `<option value="${b}" ${b === pcState.brand ? 'selected' : ''}>${b}</option>`).join('')}
                                    </select>
                                </div>
                                <div class="space-y-1">
                                    <label class="text-xs text-gray-400">Model</label>
                                    <select id="pc-model" class="w-full bg-gray-900 border border-gray-700 rounded-lg px-3 py-2 text-sm text-gray-100" ${!pcState.brand ? 'disabled' : ''}>
                                        <option value="">— Select Model —</option>
                                        ${modelsForBrand.map(m => `<option value="${m}" ${m === pcState.model ? 'selected' : ''}>${m}</option>`).join('')}
                                    </select>
                                </div>
                                <div class="space-y-1">
                                    <label class="text-xs text-gray-400">Brightness Level</label>
                                    <div class="flex rounded-lg overflow-hidden border border-gray-700">
                                        <button id="pc-br-full" class="flex-1 py-2 text-sm font-semibold transition-colors ${pcState.brightness === 'full' ? 'bg-amber-600 text-white' : 'bg-gray-900 text-gray-400 hover:bg-gray-800'}">100%</button>
                                        <button id="pc-br-half" class="flex-1 py-2 text-sm font-semibold transition-colors ${pcState.brightness === 'half' ? 'bg-amber-600 text-white' : 'bg-gray-900 text-gray-400 hover:bg-gray-800'}" ${entry && !entry.half ? 'disabled title="50% data not available for this model"' : ''}>50%</button>
                                    </div>
                                </div>
                                <div class="space-y-1">
                                    <label class="text-xs text-gray-400">Number of Tiles</label>
                                    <input id="pc-tiles" type="number" min="1" max="9999" value="${pcState.tiles}" class="w-full bg-gray-900 border border-gray-700 rounded-lg px-3 py-2 text-sm text-gray-100" />
                                </div>
                                <div class="space-y-1">
                                    <label class="text-xs text-gray-400">Supply Voltage (V)</label>
                                    <input id="pc-voltage" type="number" min="100" max="480" value="${pcState.voltage}" class="w-full bg-gray-900 border border-gray-700 rounded-lg px-3 py-2 text-sm text-gray-100" />
                                </div>
                                <div class="space-y-1">
                                    <label class="text-xs text-gray-400">Phase Configuration</label>
                                    <div class="flex rounded-lg overflow-hidden border border-gray-700">
                                        <button id="pc-ph-1" class="flex-1 py-2 text-sm font-semibold transition-colors ${pcState.phases === 1 ? 'bg-cyan-600 text-white' : 'bg-gray-900 text-gray-400 hover:bg-gray-800'}">1-Phase</button>
                                        <button id="pc-ph-3" class="flex-1 py-2 text-sm font-semibold transition-colors ${pcState.phases === 3 ? 'bg-cyan-600 text-white' : 'bg-gray-900 text-gray-400 hover:bg-gray-800'}">3-Phase</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        ${!entry ? `
                        <div class="rounded-xl border border-dashed border-gray-700 bg-gray-900/30 p-8 text-center text-gray-400">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 mx-auto mb-3 opacity-30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                            <p class="text-sm">Select a brand and model to calculate power consumption</p>
                        </div>
                        ` : `
                        <!-- Summary KPIs -->
                        ${summaryBlock}

                        <!-- Per-scenario breakdown -->
                        <div class="rounded-xl border border-white/10 bg-slate-900/40 p-4">
                            <div class="text-sm font-semibold text-slate-300 mb-3 uppercase tracking-wide">
                                Scenario Breakdown — ${entry.brand} ${entry.model} · ${pcState.brightness === 'half' ? '50%' : '100%'} brightness · ${totalTiles} tiles
                            </div>
                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-3">
                                ${scenarioCards}
                            </div>
                            <p class="text-[10px] text-gray-500 mt-3">Breaker sizes calculated with 1.25× safety factor. Values are measured per-tile from LED test bench at 230V AC.</p>
                        </div>

                        <!-- Phase distribution table -->
                        ${phaseTable}
                        `}

                        <!-- Data Source note -->
                        <div class="text-[10px] text-gray-600 text-center">Data: LED Test Report 2025 · ${LED_POWER_DATA.length} models across ${brands.length} brands · Measurements in Amperes per tile</div>
                    </div>`;

                    // Wire up controls
                    const rpc = () => renderPowerCalcTab();
                    const brandSel = c.querySelector('#pc-brand');
                    const modelSel = c.querySelector('#pc-model');
                    if (brandSel) brandSel.addEventListener('change', () => {
                        pcState.brand = brandSel.value;
                        pcState.model = '';
                        rpc();
                    });
                    if (modelSel) modelSel.addEventListener('change', () => {
                        pcState.model = modelSel.value;
                        rpc();
                    });
                    ['pc-br-full','pc-br-half'].forEach(id => {
                        const btn = c.querySelector('#' + id);
                        if (btn) btn.addEventListener('click', () => { pcState.brightness = id === 'pc-br-full' ? 'full' : 'half'; rpc(); });
                    });
                    ['pc-ph-1','pc-ph-3'].forEach(id => {
                        const btn = c.querySelector('#' + id);
                        if (btn) btn.addEventListener('click', () => { pcState.phases = id === 'pc-ph-1' ? 1 : 3; rpc(); });
                    });
                    const tilesInp = c.querySelector('#pc-tiles');
                    if (tilesInp) tilesInp.addEventListener('change', () => { pcState.tiles = Math.max(1, parseInt(tilesInp.value) || 1); rpc(); });
                    const voltInp = c.querySelector('#pc-voltage');
                    if (voltInp) voltInp.addEventListener('change', () => { pcState.voltage = Math.max(100, parseInt(voltInp.value) || 230); rpc(); });

                    // PDF export
                    const pdfBtn = c.querySelector('#pc-export-pdf');
                    if (pdfBtn) pdfBtn.addEventListener('click', () => {
                        if (!entry || !rowData) { return; }
                        if (!window.jspdf || !window.jspdf.jsPDF) { showNotification('PDF library not available'); return; }
                        const { jsPDF } = window.jspdf;
                        const doc = new jsPDF({ orientation: 'landscape', unit: 'pt', format: 'a4' });
                        const PW = doc.internal.pageSize.getWidth();
                        const PH = doc.internal.pageSize.getHeight();
                        const MG = 30;
                        const dateStr = new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

                        const drawH = (title, sub) => {
                            doc.setFillColor(7, 10, 22);
                            doc.rect(0, 0, PW, PH, 'F');
                            doc.setFillColor(4, 6, 16);
                            doc.rect(0, 0, PW, 42, 'F');
                            doc.setFont('helvetica', 'bold'); doc.setFontSize(13); doc.setTextColor(235, 240, 255);
                            doc.text(title, MG, 26);
                            doc.setFont('helvetica', 'normal'); doc.setFontSize(7.5); doc.setTextColor(130, 160, 200);
                            if (sub) {
                                const maxSubW = PW - MG * 2 - 90;
                                const trimSub = doc.splitTextToSize(sub, maxSubW)[0] || sub;
                                doc.text(trimSub, MG, 38);
                            }
                            doc.setFontSize(7.5); doc.setTextColor(90, 110, 140);
                            doc.text(dateStr, PW - MG, 20, { align: 'right' });
                            doc.text(`${entry.brand} ${entry.model}`, PW - MG, 31, { align: 'right' });
                        };
                        const hRule = (y) => { doc.setDrawColor(40,40,55); doc.setLineWidth(0.4); doc.line(MG, y, PW-MG, y); };
                        const secLbl = (text, x, y, rgb) => {
                            doc.setFillColor(...rgb); doc.rect(x, y, 3, 10, 'F');
                            doc.setFont('helvetica', 'bold'); doc.setFontSize(8.5); doc.setTextColor(220, 225, 235);
                            doc.text(text, x + 6, y + 9);
                        };

                        const BREAKERS_PDF = [10,13,16,20,25,32,40,50,63,80,100,125,160,200];
                        const nextBrk = (a) => BREAKERS_PDF.find(b => b >= a) || Math.ceil(a/10)*10;
                        const fmt2 = (v) => v != null ? v.toFixed(2) : 'N/A';
                        const totalTiles = pcState.tiles || 0;
                        const phases = pcState.phases || 1;
                        const voltage = pcState.voltage || 230;
                        const tilesPerPhase = Math.ceil(totalTiles / phases);
                        const scenKeys = ['r','g','b','w','s'];
                        const scenLabels = ['Full Red','Full Green','Full Blue','Full White','Standby'];
                        const scenColors = [[220,50,50],[50,205,80],[60,120,240],[220,220,220],[140,140,150]];
                        const worstA = Math.max(...['r','g','b','w'].map(k => rowData[k]||0)) * totalTiles;
                        const worstPerPhaseA = Math.max(...['r','g','b','w'].map(k => rowData[k]||0)) * tilesPerPhase;
                        const worstBreaker = nextBrk(worstPerPhaseA * 1.25);

                        // ── PAGE 1: Power Summary ──
                        drawH(
                            `LED Power Calculator - ${entry.brand} ${entry.model}`,
                            `${pcState.brightness === 'half' ? '50%' : '100%'} brightness | ${totalTiles} tiles | ${voltage}V | ${phases}-phase`
                        );

                        // KPI strip
                        const wRow = rowData.w != null ? rowData.w * totalTiles : null;
                        const kpiItems = [
                            { l: 'Brand', v: entry.brand, c: [80, 175, 255] },
                            { l: 'Model', v: entry.model, c: [0, 215, 145] },
                            { l: 'Total Tiles', v: String(totalTiles), c: [255, 175, 30] },
                            { l: 'Brightness', v: pcState.brightness === 'half' ? '50%' : '100%', c: [200, 140, 255] },
                            { l: 'Voltage', v: `${voltage}V`, c: [80, 215, 175] },
                            { l: 'Phases', v: `${phases}-ph`, c: [220, 120, 80] },
                        ];
                        const kpiWid = (PW - MG * 2) / kpiItems.length;
                        kpiItems.forEach((k, i) => {
                            const x = MG + i * kpiWid;
                            doc.setFillColor(12,18,35); doc.roundedRect(x+2, 44, kpiWid-4, 22, 2, 2, 'F');
                            doc.setFont('helvetica','bold'); doc.setFontSize(9); doc.setTextColor(...k.c);
                            doc.text(k.v, x + kpiWid/2, 53, { align: 'center' });
                            doc.setFont('helvetica','normal'); doc.setFontSize(6); doc.setTextColor(120,145,175);
                            doc.text(k.l, x + kpiWid/2, 62, { align: 'center' });
                        });

                        let py = 74;
                        hRule(py); py += 10;

                        // Summary KPI large cards
                        secLbl('Quick Summary (Full White Scenario)', MG, py, [255, 200, 0]);
                        py += 14;
                        const summCards = [
                            { l: 'Total Current (White)', v: wRow != null ? fmt2(wRow) + ' A' : 'N/A', c: [255,200,50] },
                            { l: 'Active Power (White)', v: wRow != null ? (wRow * voltage / 1000).toFixed(2) + ' kW' : 'N/A', c: [80,215,175] },
                            { l: 'Apparent Power (PF 0.9)', v: wRow != null ? (wRow * voltage / 900).toFixed(2) + ' kVA' : 'N/A', c: [160,100,255] },
                            { l: `Breaker / Phase (x1.25)`, v: `${worstBreaker} A`, c: [255,120,80] },
                        ];
                        const cardW = (PW - MG*2) / summCards.length;
                        summCards.forEach((card, i) => {
                            const x = MG + i * cardW;
                            doc.setFillColor(16,22,38); doc.roundedRect(x+3, py, cardW-6, 30, 3, 3, 'F');
                            doc.setFont('helvetica','bold'); doc.setFontSize(14); doc.setTextColor(...card.c);
                            doc.text(card.v, x + cardW/2, py+17, { align: 'center' });
                            doc.setFont('helvetica','normal'); doc.setFontSize(7); doc.setTextColor(130,155,180);
                            doc.text(card.l, x + cardW/2, py+27, { align: 'center' });
                        });
                        py += 40;
                        hRule(py); py += 10;

                        // Scenario breakdown table
                        secLbl('Scenario Breakdown', MG, py, [100, 145, 255]);
                        py += 22;
                        const sCols = [{ h:'Scenario',w:90 },{ h:'A/tile',w:70 },{ h:`Total A (${totalTiles} tiles)`,w:120 },{ h:`Total kW`,w:80 },{ h:`Breaker (single)`,w:110 },{ h:`Per Phase (${tilesPerPhase} tiles)`,w:120 },{ h:`Phase Breaker`,w:100 }];
                        const sTW = sCols.reduce((s,col)=>s+col.w,0);
                        doc.setFillColor(10,17,32); doc.rect(MG, py-8, sTW, 14, 'F');
                        doc.setFont('helvetica','bold'); doc.setFontSize(7); doc.setTextColor(70,190,165);
                        let shx = MG + 3; sCols.forEach(col => { doc.text(col.h, shx, py+1); shx += col.w; });
                        py += 21;
                        doc.setFont('helvetica','normal'); doc.setFontSize(7);
                        scenKeys.forEach((key, ki) => {
                            if (rowData[key] == null) return;
                            if (py > PH - 40) return;
                            const perTile = rowData[key];
                            const total = perTile * totalTiles;
                            const totalKW2 = (total * voltage / 1000).toFixed(2);
                            const brk = nextBrk(total * 1.25);
                            const perPhAmp = perTile * tilesPerPhase;
                            const phBrk = nextBrk(perPhAmp * 1.25);
                            doc.setFillColor(ki%2===0?12:17, ki%2===0?17:22, ki%2===0?32:38);
                            doc.rect(MG, py-8, sTW, 12, 'F');
                            const [sr,sg,sb] = scenColors[ki];
                            doc.setFillColor(sr,sg,sb); doc.rect(MG, py-8, 3, 12, 'F');
                            doc.setTextColor(215,215,215);
                            const sVals = [scenLabels[ki], fmt2(perTile)+' A', fmt2(total)+' A', totalKW2+' kW', brk+' A', fmt2(perPhAmp)+' A', phBrk+' A'];
                            let sdx = MG + 5; sCols.forEach((col,vi) => { doc.text(sVals[vi]||'', sdx, py); sdx += col.w; });
                            py += 12;
                        });

                        py += 8; hRule(py); py += 8;

                        // Phase distribution table (if 3-phase)
                        if (phases > 1 && py < PH - 80) {
                            secLbl(`Phase Distribution (${phases}-Phase)`, MG, py, [0, 215, 140]);
                            py += 22;
                            const phLabels = ['L1','L2','L3'].slice(0, phases);
                            const tilesEach = phLabels.map((_,i) => {
                                const base = Math.floor(totalTiles / phases);
                                return i < (totalTiles % phases) ? base + 1 : base;
                            });
                            const phCols2 = [{ h:'Phase',w:40 },{ h:'Tiles',w:45 },...scenLabels.map(l=>({ h:l,w:80 })),{ h:'Breaker',w:60 }];
                            const phTW = phCols2.reduce((s,col)=>s+col.w,0);
                            doc.setFillColor(10,17,32); doc.rect(MG, py-8, phTW, 14,'F');
                            doc.setFont('helvetica','bold'); doc.setFontSize(6.5); doc.setTextColor(70,190,165);
                            let phx = MG+3; phCols2.forEach(col => { doc.text(col.h, phx, py+1); phx += col.w; });
                            py += 21;
                            doc.setFont('helvetica','normal'); doc.setFontSize(6.5);
                            phLabels.forEach((ph, i) => {
                                if (py > PH - 30) return;
                                const tph = tilesEach[i];
                                const worstPhAA = Math.max(...['r','g','b','w'].map(k=>(rowData[k]||0)*tph));
                                const phBrkAA = nextBrk(worstPhAA * 1.25);
                                doc.setFillColor(i%2===0?12:17, i%2===0?17:22, i%2===0?32:38);
                                doc.rect(MG, py-8, phTW, 12,'F');
                                doc.setTextColor(80,215,175);
                                const phVals2 = [ph, String(tph), ...scenKeys.map(k => rowData[k]!=null ? fmt2(rowData[k]*tph)+' A':'N/A'), phBrkAA+' A'];
                                let pdx = MG+3; phCols2.forEach((col,vi) => { doc.text(phVals2[vi]||'', pdx, py); pdx += col.w; });
                                py += 12;
                            });
                            // totals row
                            doc.setFillColor(20,30,50); doc.rect(MG, py-8, phTW, 12,'F');
                            doc.setFont('helvetica','bold'); doc.setFontSize(6.5); doc.setTextColor(255,215,0);
                            const totVals = ['TOTAL', String(totalTiles), ...scenKeys.map(k => rowData[k]!=null ? fmt2(rowData[k]*totalTiles)+' A':'N/A'), nextBrk(worstA * 1.25 / phases)+' A'];
                            let tdx = MG+3; phCols2.forEach((col,vi) => { doc.text(totVals[vi]||'', tdx, py); tdx += col.w; });
                        }

                        // Specs reference block
                        if (py < PH - 60) {
                            py += 16; hRule(py); py += 8;
                            secLbl('Reference Data', MG, py, [150,100,255]);
                            py += 20;
                            const refRows = [
                                ['Brand', entry.brand, 'Model', entry.model],
                                ['Data Source', 'Pixelogic', 'Brightness Level', pcState.brightness === 'half' ? '50%' : '100%'],
                                ['Total Tiles', String(totalTiles), 'Supply Voltage', `${voltage}V`],
                                ['Phase Config', `${phases}-Phase`, 'Tiles per Phase', String(tilesPerPhase)],
                                ['Worst-case Total', fmt2(worstA)+' A', 'Worst Breaker/Phase', `${worstBreaker}A (x1.25)`],
                            ];
                            const refW = (PW - MG*2) / 4;
                            doc.setFont('helvetica','normal'); doc.setFontSize(7.5);
                            refRows.forEach((row, i) => {
                                const ly = py + i*13;
                                if (ly > PH - MG - 8) return;
                                doc.setFillColor(i%2===0?12:17, i%2===0?17:22, i%2===0?32:38);
                                doc.rect(MG, ly-7, PW-MG*2, 11,'F');
                                doc.setTextColor(110,140,175); doc.text(row[0], MG+3, ly);
                                doc.setTextColor(215,215,215); doc.text(row[1], MG+3+refW, ly);
                                doc.setTextColor(110,140,175); doc.text(row[2], MG+3+refW*2, ly);
                                doc.setTextColor(215,215,215); doc.text(row[3], MG+3+refW*3, ly);
                            });
                        }

                        // footer
                        doc.setFontSize(6.5); doc.setTextColor(80,90,110);
                        doc.text(`Generated by Pixelogic | ${dateStr} | Source: Pixelogic | Values are measured per-tile at rated brightness | Breakers at 1.25x safety factor`, MG, PH - 10);

                        applyDemoWatermarkToPDF(doc);
                        doc.save(`Power_Calc_${(entry.brand+'_'+entry.model).replace(/[\s/]+/g,'_')}_${Date.now()}.pdf`);
                    });
                };

                const renderAvEngineeringTab = () => {};

                const renderDevicesTab = () => {
                        ensureDevicesUiState();
                        const ui = state.ui.devices;
                        const db = state.devicesV2 || { version: 2, ledWalls: [], projectors: [] };
                        const active = ui.subTab === 'proj' ? 'proj' : 'led';

                        const list = active === 'led' ? (db.ledWalls || []) : (db.projectors || []);
                        const filter = (ui.filter || '').toLowerCase();
                        const filtered = filter ? list.filter(item => JSON.stringify(item).toLowerCase().includes(filter)) : list.slice();

                        const rows = filtered.map(item => `
                                <tr class="border-b border-gray-700">
                                    <td class="px-2 py-1 text-sm">${item.name || ''}</td>
                                    <td class="px-2 py-1 text-sm">${item.brand || ''}</td>
                                    <td class="px-2 py-1 text-sm">${item.model || ''}</td>
                                    <td class="px-2 py-1 text-sm">${active==='led' ? (item.pitchMm!=null? item.pitchMm+' mm':'' ) : (item.resolution || '')}</td>
                                    <td class="px-2 py-1 text-sm text-right">
                                        <button data-id="${item.id}" class="dev-edit px-2 py-1 bg-gray-700 hover:bg-gray-600 rounded text-xs">Edit</button>
                                        <button data-id="${item.id}" class="dev-del px-2 py-1 bg-red-600 hover:bg-red-700 rounded text-xs text-white">Delete</button>
                                    </td>
                                </tr>
                        `).join('') || `<tr><td class="px-2 py-3 text-center text-gray-400 text-sm" colspan="5">No entries yet</td></tr>`;

                        const c = mainContent.devices;
                        if (!c) return;
                        c.innerHTML = `
                                <div class="bg-gray-800 p-6 rounded-xl shadow-lg space-y-4">
                                    <div class="flex flex-wrap items-center justify-between gap-2">
                                        <h2 class="text-2xl font-bold">Devices Database <span class="text-xs align-middle text-gray-300 bg-gray-700/60 px-2 py-0.5 rounded">v2</span></h2>
                                        <div class="flex flex-wrap gap-2">
                                            <button id="dev-export" class="px-3 py-2 rounded bg-gray-700 hover:bg-gray-600 text-sm">Export JSON</button>
                                            <input id="dev-import-file" type="file" accept="application/json,.json" class="hidden" />
                                            <button id="dev-import" class="px-3 py-2 rounded bg-accent text-black text-sm">Import JSON</button>
                                        </div>
                                    </div>

                                    <div class="flex items-center gap-2">
                                        <button data-sub="led" class="subtab ${active==='led'?'bg-sky-600 text-white':'bg-gray-700 text-gray-200 hover:bg-gray-600'} px-3 py-1 rounded">LED Walls</button>
                                        <button data-sub="proj" class="subtab ${active==='proj'?'bg-sky-600 text-white':'bg-gray-700 text-gray-200 hover:bg-gray-600'} px-3 py-1 rounded">Projectors</button>
                                        <div class="ml-auto flex items-center gap-2">
                                            <input id="dev-filter" value="${ui.filter || ''}" placeholder="Search..." class="bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm" />
                                        </div>
                                    </div>

                                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
                                        <div class="lg:col-span-2 bg-gray-900/60 border border-gray-700 rounded-xl">
                                            <table class="w-full text-left">
                                                <thead><tr class="text-gray-300 text-sm border-b border-gray-700">
                                                    <th class="px-2 py-2">Name</th>
                                                    <th class="px-2 py-2">Brand</th>
                                                    <th class="px-2 py-2">Model</th>
                                                    <th class="px-2 py-2">${active==='led'?'Pixel Pitch / Res':'Resolution / Lumens'}</th>
                                                    <th class="px-2 py-2 text-right">Actions</th>
                                                </tr></thead>
                                                <tbody>${rows}</tbody>
                                            </table>
                                        </div>

                                        <div class="bg-gray-900/60 border border-gray-700 rounded-xl p-3 space-y-3">
                                            <div class="flex items-center justify-between">
                                                <h3 class="font-semibold text-accent text-lg">${ui.editingId ? 'Edit' : 'Add'} ${active==='led'?'LED Wall':'Projector'}</h3>
                                                ${ui.editingId ? '<button id="dev-cancel" class="text-xs px-2 py-1 rounded bg-gray-700 hover:bg-gray-600">Cancel</button>' : ''}
                                            </div>
                                            <div class="space-y-2">
                                                <input id="dev-name" placeholder="Name" class="w-full bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm" />
                                                <div class="grid grid-cols-2 gap-2">
                                                    <input id="dev-brand" placeholder="Brand" class="bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm" />
                                                    <input id="dev-model" placeholder="Model" class="bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm" />
                                                </div>
                                                                        ${active==='led' ? `
                                                    <div class="grid grid-cols-2 gap-2">
                                                        <input id="dev-pitch" placeholder="Pixel Pitch (mm)" type="number" step="0.01" class="bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm" />
                                                        <input id="dev-refresh" placeholder="Refresh (Hz)" type="number" step="1" class="bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm" />
                                                    </div>
                                                    <div class="grid grid-cols-2 gap-2">
                                                        <input id="dev-resw" placeholder="Panel Res W" type="number" step="1" class="bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm" />
                                                        <input id="dev-resh" placeholder="Panel Res H" type="number" step="1" class="bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm" />
                                                    </div>
                                                    <div class="grid grid-cols-2 gap-2">
                                                        <input id="dev-cabw" placeholder="Cabinet W (mm)" type="number" step="1" class="bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm" />
                                                        <input id="dev-cabh" placeholder="Cabinet H (mm)" type="number" step="1" class="bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm" />
                                                    </div>
                                                    <div class="grid grid-cols-2 gap-2">
                                                        <input id="dev-cabd" placeholder="Cabinet D (mm)" type="number" step="1" class="bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm" />
                                                        <select id="dev-curve" class="bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm">
                                                            <option value="flat" selected>Flat</option>
                                                            <option value="concave">Curved (Concave)</option>
                                                            <option value="convex">Curved (Convex)</option>
                                                            <option value="both">Curved (Concave & Convex)</option>
                                                        </select>
                                                    </div>
                                                                            <div class="grid grid-cols-2 gap-2">
                                                                                <input id="dev-weight-kg" placeholder="Cabinet Weight (kg)" type="number" step="0.01" class="bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm" />
                                                                                <input id="dev-nits" placeholder="Brightness (nits)" type="number" step="1" class="bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm" />
                                                                            </div>
                                                    <div class="grid grid-cols-2 gap-2">
                                                        <input id="dev-aspect-ratio" placeholder="Aspect Ratio (e.g., 16:9)" class="bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm" />
                                                        <input id="dev-view-distance" placeholder="Recommended Viewing Distance (m)" type="number" step="0.01" class="bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm" />
                                                    </div>
                                                    <div class="grid grid-cols-2 gap-2">
                                                        <select id="dev-usage" class="bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm">
                                                            <option value="">Usage</option>
                                                            <option value="indoor">Indoor</option>
                                                            <option value="outdoor">Outdoor</option>
                                                            <option value="both">Indoor/Outdoor</option>
                                                        </select>
                                                        <input id="dev-power-frequency" placeholder="Input Power Frequency (e.g., 50/60 Hz)" class="bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm" />
                                                    </div>
                                                                            <div class="grid grid-cols-2 gap-2">
                                                        <input id="dev-avg-power" placeholder="AVG Power (W)" type="number" step="1" class="bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm" />
                                                        <input id="dev-max-power" placeholder="MAX Power (W)" type="number" step="1" class="bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm" />
                                                                            </div>
                                                                            <div class="grid grid-cols-2 gap-2">
                                                        <input id="dev-framefreq" placeholder="Video Frame Rate (Hz)" type="number" step="1" class="bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm" />
                                                                                <input id="dev-input-voltage" placeholder="Input Voltage (e.g., AC 100–240V)" class="bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm" />
                                                                            </div>
                                                                            <input id="dev-input-power" placeholder="Input Power (text)" class="w-full bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm" />
                                                ` : `
                                                    <div class="grid grid-cols-2 gap-2">
                                                        <input id="dev-resolution" placeholder="Resolution (e.g., 1920x1200)" class="bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm" />
                                                        <input id="dev-lumens" placeholder="Brightness (lumens)" type="number" step="1" class="bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm" />
                                                    </div>
                                                    <input id="dev-technology" placeholder="Technology (e.g., 3LCD, DLP)" class="w-full bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm" />
                                                    <input id="dev-lens" placeholder="Lens" class="w-full bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm" />
                                                    <input id="dev-throw" placeholder="Throw Ratio (e.g., 1.2-2.1:1)" class="w-full bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm" />
                                                `}
                                                <textarea id="dev-notes" placeholder="Notes" rows="3" class="w-full bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm"></textarea>
                                                <button id="dev-save" class="w-full px-3 py-2 rounded ${active==='led'?'bg-sky-600 hover:bg-sky-700':'bg-sky-600 hover:bg-sky-700'} text-white">${ui.editingId ? 'Update' : 'Add'} ${active==='led'?'LED Wall':'Projector'}</button>
                                            </div>

                                            <div class="pt-3 border-t border-gray-700 space-y-2">
                                                <div class="text-sm text-gray-300 font-semibold">Import from PDF</div>
                                                <div class="grid grid-cols-1 gap-2">
                                                    <input id="dev-pdf-file" type="file" accept="application/pdf" class="w-full text-sm" />
                                                    <button id="dev-pdf-parse" class="px-3 py-2 rounded bg-gray-700 hover:bg-gray-600 text-sm">Parse and Prefill</button>
                                                    <div id="dev-pdf-summary" class="text-xs text-gray-300 bg-gray-900/70 border border-gray-700 rounded p-2 hidden"></div>
                                                    <details class="text-xs text-gray-400">
                                                        <summary class="cursor-pointer">Show last extracted text</summary>
                                                        <pre id="dev-pdf-text" class="whitespace-pre-wrap p-2 bg-gray-950 rounded border border-gray-800 max-h-40 overflow-auto"></pre>
                                                    </details>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                        `;

                        // Wire subtabs
                        c.querySelectorAll('.subtab').forEach(btn => btn.addEventListener('click', (e) => { state.ui.devices.subTab = e.currentTarget.getAttribute('data-sub'); state.ui.devices.editingId = null; renderDevicesTab(); }));
                        // Filter
                        const filterEl = document.getElementById('dev-filter'); if (filterEl) filterEl.addEventListener('input', (ev) => { state.ui.devices.filter = ev.target.value; renderDevicesTab(); });

                        // Export/Import JSON
                        const expBtn = document.getElementById('dev-export'); if (expBtn) expBtn.addEventListener('click', () => {
                                downloadJson({ version: 2, ledWalls: db.ledWalls || [], projectors: db.projectors || [] }, `devices_v2_${timestamp()}.json`);
                        });
                        const impBtn = document.getElementById('dev-import'); const impFile = document.getElementById('dev-import-file');
                        if (impBtn && impFile) {
                                impBtn.addEventListener('click', ()=> impFile.click());
                                impFile.addEventListener('change', (e) => {
                                        const f = e.target.files && e.target.files[0]; if (!f) return;
                                        const reader = new FileReader();
                                        reader.onload = (ev) => {
                                                try {
                                                        const json = JSON.parse(String(ev.target.result||'{}'));
                                                        if (!json || json.version !== 2) { showNotification('Invalid devices JSON (expect version 2)'); return; }
                                                        state.devicesV2 = { version: 2, ledWalls: Array.isArray(json.ledWalls)?json.ledWalls:[], projectors: Array.isArray(json.projectors)?json.projectors:[] };
                                                        persistDevices();
                                                        renderDevicesTab();
                                                        showNotification('Devices imported');
                                                } catch (err) { console.warn('Devices import failed', err); showNotification('Import failed'); }
                                                e.target.value = '';
                                        };
                                        reader.readAsText(f);
                                });
                        }

                        // Edit/Delete
                        c.querySelectorAll('.dev-edit').forEach(btn => btn.addEventListener('click', (ev) => {
                                const id = ev.currentTarget.getAttribute('data-id');
                                state.ui.devices.editingId = id;
                                renderDevicesTab();
                        }));
                        c.querySelectorAll('.dev-del').forEach(btn => btn.addEventListener('click', (ev) => {
                                const id = ev.currentTarget.getAttribute('data-id');
                                if (!id) return;
                                if (!confirm('Delete this entry?')) return;
                                if (active==='led') state.devicesV2.ledWalls = (state.devicesV2.ledWalls||[]).filter(x => String(x.id) !== String(id));
                                else state.devicesV2.projectors = (state.devicesV2.projectors||[]).filter(x => String(x.id) !== String(id));
                                persistDevices();
                                renderDevicesTab();
                        }));

                        // Prefill form if editing
                        const setVal = (id, v) => { const el = document.getElementById(id); if (el) el.value = (v ?? '') }; 
                        if (ui.editingId) {
                                const src = (active==='led' ? (db.ledWalls||[]) : (db.projectors||[])).find(x => String(x.id)===String(ui.editingId));
                                if (src) {
                                        setVal('dev-name', src.name);
                                        setVal('dev-brand', src.brand);
                                        setVal('dev-model', src.model);
                                        if (active==='led') {
                                                setVal('dev-pitch', src.pitchMm);
                                                setVal('dev-refresh', src.refreshHz);
                                                setVal('dev-resw', src.panelResW);
                                                setVal('dev-resh', src.panelResH);
                                                setVal('dev-cabw', src.cabinetWmm);
                                                setVal('dev-cabh', src.cabinetHmm);
                        setVal('dev-cabd', src.cabinetDmm);
                        const curveSel = document.getElementById('dev-curve'); if (curveSel) curveSel.value = src.curveType || 'flat';
                                                setVal('dev-nits', src.brightnessNits);
                                    setVal('dev-weight-kg', src.cabinetWeightKg);
                    setVal('dev-aspect-ratio', src.aspectRatio);
                    setVal('dev-view-distance', src.viewDistanceM);
                    const usageSel = document.getElementById('dev-usage'); if (usageSel) usageSel.value = src.usage || '';
                    setVal('dev-power-frequency', src.inputPowerFrequency);
                                    setVal('dev-avg-power', src.avgPowerW);
                                    setVal('dev-max-power', src.maxPowerW);
                                    setVal('dev-input-power', src.inputPower);
                                    setVal('dev-input-voltage', src.inputVoltage);
                                    setVal('dev-framefreq', src.frameFrequencyHz);
                                        } else {
                                                setVal('dev-resolution', src.resolution);
                                                setVal('dev-lumens', src.brightnessLumens);
                                                setVal('dev-technology', src.technology);
                                                setVal('dev-lens', src.lens);
                                                setVal('dev-throw', src.throwRatio);
                                        }
                                        setVal('dev-notes', src.notes);
                                        const cancelBtn = document.getElementById('dev-cancel'); if (cancelBtn) cancelBtn.addEventListener('click', () => { state.ui.devices.editingId = null; renderDevicesTab(); });
                                }
                        }

                        // Save/Add handler
                        const saveBtn = document.getElementById('dev-save');
                        if (saveBtn) saveBtn.addEventListener('click', () => {
                                const id = ui.editingId || (Date.now().toString(36) + Math.random().toString(36).slice(2,7));
                                if (active==='led') {
                                        const rec = {
                                                id,
                                                name: (document.getElementById('dev-name')?.value||'').trim(),
                                                brand: (document.getElementById('dev-brand')?.value||'').trim(),
                                                model: (document.getElementById('dev-model')?.value||'').trim(),
                                                pitchMm: _num(document.getElementById('dev-pitch')?.value),
                                                panelResW: _num(document.getElementById('dev-resw')?.value),
                                                panelResH: _num(document.getElementById('dev-resh')?.value),
                                                cabinetWmm: _num(document.getElementById('dev-cabw')?.value),
                                                cabinetHmm: _num(document.getElementById('dev-cabh')?.value),
                        cabinetDmm: _num(document.getElementById('dev-cabd')?.value),
                                                brightnessNits: _num(document.getElementById('dev-nits')?.value),
                                                refreshHz: _num(document.getElementById('dev-refresh')?.value),
                    curveType: (document.getElementById('dev-curve')?.value||'').trim(),
                                        cabinetWeightKg: _num(document.getElementById('dev-weight-kg')?.value),
                    aspectRatio: (document.getElementById('dev-aspect-ratio')?.value||'').trim(),
                    viewDistanceM: _num(document.getElementById('dev-view-distance')?.value),
                    usage: (document.getElementById('dev-usage')?.value||'').trim(),
                    inputPowerFrequency: (document.getElementById('dev-power-frequency')?.value||'').trim(),
                                        avgPowerW: _num(document.getElementById('dev-avg-power')?.value),
                                        maxPowerW: _num(document.getElementById('dev-max-power')?.value),
                                        inputPower: (document.getElementById('dev-input-power')?.value||'').trim(),
                                        inputVoltage: (document.getElementById('dev-input-voltage')?.value||'').trim(),
                                        frameFrequencyHz: _num(document.getElementById('dev-framefreq')?.value),
                                                notes: (document.getElementById('dev-notes')?.value||'').trim(),
                                        };
                                        const arr = state.devicesV2.ledWalls || (state.devicesV2.ledWalls = []);
                                        const idx = arr.findIndex(x => String(x.id)===String(id));
                                        if (idx>=0) arr[idx] = rec; else arr.push(rec);
                                } else {
                                        const rec = {
                                                id,
                                                name: (document.getElementById('dev-name')?.value||'').trim(),
                                                brand: (document.getElementById('dev-brand')?.value||'').trim(),
                                                model: (document.getElementById('dev-model')?.value||'').trim(),
                                                resolution: (document.getElementById('dev-resolution')?.value||'').trim(),
                                                brightnessLumens: _num(document.getElementById('dev-lumens')?.value),
                                                technology: (document.getElementById('dev-technology')?.value||'').trim(),
                                                lens: (document.getElementById('dev-lens')?.value||'').trim(),
                                                throwRatio: _num(document.getElementById('dev-throw')?.value),
                                                notes: (document.getElementById('dev-notes')?.value||'').trim(),
                                        };
                                        const arr = state.devicesV2.projectors || (state.devicesV2.projectors = []);
                                        const idx = arr.findIndex(x => String(x.id)===String(id));
                                        if (idx>=0) arr[idx] = rec; else arr.push(rec);
                                }
                                persistDevices();
                                state.ui.devices.editingId = null;
                                renderDevicesTab();
                                showNotification('Saved');
                        });

                        // PDF parse wiring
                        const pdfBtn = document.getElementById('dev-pdf-parse');
                        if (pdfBtn) pdfBtn.addEventListener('click', async () => {
                                const fileInput = document.getElementById('dev-pdf-file');
                                if (!fileInput || !fileInput.files || !fileInput.files[0]) { showNotification('Choose a PDF first'); return; }
                                const file = fileInput.files[0];
                                const text = await extractPdfText(file);
                                const pre = document.getElementById('dev-pdf-text'); if (pre) pre.textContent = text.slice(0, 20000);
                                try { if (window.__debugPush) window.__debugPush(`devices: pdf text length ${text ? text.length : 0}`); } catch(_) {}
                                if (!text) { showNotification('Could not read PDF'); return; }
                                if (text.replace(/\s+/g,'').length < 24) { showNotification('The PDF seems to have no selectable text (likely a scanned/image PDF).'); }
                                if (active==='led') {
                                    const hint = parseLedWallFromText(text);
                                    const set = (id, v) => { const el = document.getElementById(id); if (el && (v!==undefined && v!==null && v!=='')) el.value = String(v); };
                                    if (hint.brand || hint.model) {
                                        set('dev-brand', hint.brand); set('dev-model', hint.model);
                                    }
                                    set('dev-pitch', hint.pitchMm);
                                    set('dev-resw', hint.panelResW);
                                    set('dev-resh', hint.panelResH);
                                    set('dev-cabw', hint.cabinetWmm);
                                    set('dev-cabh', hint.cabinetHmm);
                                    set('dev-cabd', hint.cabinetDmm);
                                    set('dev-weight-kg', hint.cabinetWeightKg);
                                    const curveSel = document.getElementById('dev-curve'); if (curveSel && hint.curveType) curveSel.value = hint.curveType;
                                    set('dev-aspect-ratio', hint.aspectRatio);
                                    set('dev-view-distance', hint.viewDistanceM);
                                    const usageSel = document.getElementById('dev-usage'); if (usageSel && (hint.usage||'')!=='') usageSel.value = hint.usage;
                                    set('dev-power-frequency', hint.inputPowerFrequency);
                                    set('dev-avg-power', hint.avgPowerW);
                                    set('dev-max-power', hint.maxPowerW);
                                    set('dev-input-power', hint.inputPower);
                                    set('dev-input-voltage', hint.inputVoltage);
                                    set('dev-framefreq', hint.frameFrequencyHz);
                                    set('dev-nits', hint.brightnessNits);
                                    set('dev-refresh', hint.refreshHz);
                                    // Show summary in UI and highlight affected inputs
                                    const summary = [];
                                    if (hint.brand) summary.push(`Brand: ${hint.brand}`);
                                    if (hint.model) summary.push(`Model: ${hint.model}`);
                                    if (hint.pitchMm!=null) summary.push(`Pitch: ${hint.pitchMm} mm`);
                                    if (hint.panelResW && hint.panelResH) summary.push(`Panel Res: ${hint.panelResW}×${hint.panelResH}`);
                                    if (hint.cabinetWmm || hint.cabinetHmm || hint.cabinetDmm) summary.push(`Cabinet: ${hint.cabinetWmm||'?'}×${hint.cabinetHmm||'?'}×${hint.cabinetDmm||'?'} mm`);
                                    if (hint.cabinetWeightKg!=null) summary.push(`Weight: ${hint.cabinetWeightKg} kg`);
                                    if (hint.brightnessNits!=null) summary.push(`Brightness: ${hint.brightnessNits} nits`);
                                    if (hint.refreshHz!=null) summary.push(`Refresh: ${hint.refreshHz} Hz`);
                                    if (hint.frameFrequencyHz!=null) summary.push(`Video Frame: ${hint.frameFrequencyHz} Hz`);
                                    if (hint.aspectRatio) summary.push(`Aspect Ratio: ${hint.aspectRatio}`);
                                    if (hint.viewDistanceM!=null) summary.push(`View Distance: ${hint.viewDistanceM} m`);
                                    if (hint.usage) summary.push(`Usage: ${hint.usage}`);
                                    if (hint.inputVoltage) summary.push(`Voltage: ${hint.inputVoltage}`);
                                    if (hint.inputPower) summary.push(`Input Power: ${hint.inputPower}`);
                                    if (hint.inputPowerFrequency) summary.push(`Power Freq: ${hint.inputPowerFrequency}`);
                                    const sumEl = document.getElementById('dev-pdf-summary');
                                    if (sumEl) {
                                        sumEl.classList.remove('hidden');
                                        sumEl.innerHTML = summary.length ? ('Detected: ' + summary.join(' • ')) : 'No recognizable fields found. Try “Show last extracted text” to confirm contents.';
                                    }
                                    const idsToHighlight = ['dev-brand','dev-model','dev-pitch','dev-resw','dev-resh','dev-cabw','dev-cabh','dev-cabd','dev-weight-kg','dev-nits','dev-refresh','dev-framefreq','dev-aspect-ratio','dev-view-distance','dev-usage','dev-input-voltage','dev-input-power','dev-power-frequency'];
                                    idsToHighlight.forEach(id => { const el = document.getElementById(id); if (el) { el.classList.add('auto-highlight'); setTimeout(()=>el.classList.remove('auto-highlight'), 1200); }});
                                } else {
                                        const hint = parseProjectorFromText(text);
                                        const set = (id, v) => { const el = document.getElementById(id); if (el && (v!==undefined && v!==null && v!=='')) el.value = String(v); };
                                        if (hint.brand || hint.model) { set('dev-brand', hint.brand); set('dev-model', hint.model); }
                                        set('dev-resolution', hint.resolution);
                                        set('dev-lumens', hint.brightnessLumens);
                                        set('dev-technology', hint.technology);
                                        set('dev-lens', hint.lens);
                                        set('dev-throw', hint.throwRatio);
                                        const sumEl = document.getElementById('dev-pdf-summary');
                                        if (sumEl) {
                                            const summary = [];
                                            if (hint.brand) summary.push(`Brand: ${hint.brand}`);
                                            if (hint.model) summary.push(`Model: ${hint.model}`);
                                            if (hint.resolution) summary.push(`Res: ${hint.resolution}`);
                                            if (hint.brightnessLumens!=null) summary.push(`Lumens: ${hint.brightnessLumens}`);
                                            if (hint.technology) summary.push(`Tech: ${hint.technology}`);
                                            if (hint.lens) summary.push(`Lens: ${hint.lens}`);
                                            if (hint.throwRatio!=null) summary.push(`Throw: ${hint.throwRatio}:1`);
                                            sumEl.classList.remove('hidden');
                                            sumEl.innerHTML = summary.length ? ('Detected: ' + summary.join(' • ')) : 'No recognizable fields found. Try “Show last extracted text” to confirm contents.';
                                        }
                                        const idsToHighlight = ['dev-brand','dev-model','dev-resolution','dev-lumens','dev-technology','dev-lens','dev-throw'];
                                        idsToHighlight.forEach(id => { const el = document.getElementById(id); if (el) { el.classList.add('auto-highlight'); setTimeout(()=>el.classList.remove('auto-highlight'), 1200); }});
                                }
                                showNotification('PDF parsed — fields prefilled');
                        });
                };

    // Render the dedicated LED Patching tab: same patching controls, no Canvas Settings, no Draw Mode.
    window.PixelLogicPatchingBridge = {
        getCatalog: () => {
            try { return getLedSheetsCatalog(); } catch (_) { return []; }
        },
        getScreensSnapshot: () => {
            try {
                const activeProject = state.projects.find(p => p.id === state.activeProjectId) || state.projects[0];
                if (!activeProject) return { screens: [], activeIndex: 0 };
                if (!Array.isArray(activeProject.pixelMaps) || activeProject.pixelMaps.length === 0) {
                    const firstMap = createNewPixelMapObject(1);
                    activeProject.pixelMaps = [firstMap];
                    activeProject.activePixelMapId = firstMap.id;
                }
                const catalog = getLedSheetsCatalog();
                const voltage = (state.sheetsState && Number(state.sheetsState.voltage)) || 230;
                const brightness = (state.sheetsState && state.sheetsState.brightness) || 'full';

                const screens = activeProject.pixelMaps.map((map, idx) => {
                    const calcs = calculateLayout(map) || {};
                    const physW = Math.max(1, Number(map.panelWidthMm) || 500);
                    const physH = Math.max(1, Number(map.panelHeightMm) || 500);
                    const modW = Math.max(1, Number(map.panelResWidth) || 192);
                    const modH = Math.max(1, Number(map.panelResHeight) || 192);
                    const cols = Math.max(1, Number(calcs.panelsHorizontally) || Number(map.tilesWide) || 8);
                    const rows = Math.max(1, Number(calcs.panelsVertically) || Number(map.tilesHigh) || 5);

                    let ledBrand = map.ledBrand || '';
                    let ledModel = map.ledModel || '';
                    let spec = catalog.find(item => item.brand === ledBrand && item.model === ledModel);
                    if (!spec && !ledBrand && !ledModel) {
                        spec = catalog.find(item => item.panelWidthMm === physW && item.panelHeightMm === physH && Math.abs(item.panelResWidth - modW) <= 4);
                        if (spec) {
                            ledBrand = spec.brand;
                            ledModel = spec.model;
                            map.ledBrand = ledBrand;
                            map.ledModel = ledModel;
                        }
                    }
                    const pitchMm = spec ? spec.pitchMm : Number((physW / Math.max(1, modW)).toFixed(2));
                    const modeObj = spec ? ((brightness === 'half' && spec.half) ? spec.half : spec.full) : null;
                    const tileType = (physW === 500 && physH === 500) ? 'half-half' : ((physW === 500 && physH === 1000) ? 'half-one' : 'custom');
                    const fallbackAmps = tileType === 'half-one' ? 2.02 : 1.0;
                    const savedPatch = map.patchingConfig || {};
                    const mapVoltage = Number(savedPatch.voltage) || voltage;
                    const baseAmps230 = (modeObj && Number(modeObj.w) > 0) ? Number(modeObj.w) : fallbackAmps;
                    const tileAmps = Number(savedPatch.tileAmps) > 0 && !spec
                        ? Number(savedPatch.tileAmps)
                        : Number((baseAmps230 * (230 / mapVoltage)).toFixed(2));
                    const maxWatts = Math.round(tileAmps * mapVoltage);

                    return {
                        id: map.id || (idx + 1),
                        name: map.name || `Screen ${idx + 1}`,
                        ledBrand,
                        ledModel,
                        pitchMm,
                        cols,
                        rows,
                        modW,
                        modH,
                        physW,
                        physH,
                        tileType,
                        tileAmps,
                        maxWatts,
                        voltage: mapVoltage,
                        use80PercentRule: !!savedPatch.use80PercentRule,
                        conservative1G: !!savedPatch.conservative1G,
                        weight: savedPatch.weight ?? 7.5,
                        hz: savedPatch.hz ?? 60,
                        bit: savedPatch.bit ?? 8,
                        dataPattern: savedPatch.dataPattern || 'v-snake',
                        powerPattern: savedPatch.powerPattern || 'v-snake',
                        dataStartCorner: savedPatch.dataStartCorner || 'tl',
                        powerStartCorner: savedPatch.powerStartCorner || 'tl',
                        dataPackingMode: savedPatch.dataPackingMode || 'max-fill',
                        powerPackingMode: savedPatch.powerPackingMode || 'max-fill',
                        redundancyMode: !!savedPatch.redundancyMode,
                        dataRoutingMode: savedPatch.dataRoutingMode || 'auto',
                        powerRoutingMode: savedPatch.powerRoutingMode || 'auto',
                        manualDataPaths: Array.isArray(savedPatch.manualDataPaths) ? savedPatch.manualDataPaths : [],
                        manualPowerPaths: Array.isArray(savedPatch.manualPowerPaths) ? savedPatch.manualPowerPaths : [],
                        manualDataUndo: [],
                        manualDataRedo: [],
                        manualPowerUndo: [],
                        manualPowerRedo: [],
                        maxDataMods: savedPatch.maxDataMods ?? 60,
                        isAutoDataLimit: savedPatch.isAutoDataLimit !== undefined ? savedPatch.isAutoDataLimit : true,
                        maxPowerMods: savedPatch.maxPowerMods ?? 15,
                        isAutoPowerLimit: savedPatch.isAutoPowerLimit !== undefined ? savedPatch.isAutoPowerLimit : true,
                        circuitAmps: savedPatch.circuitAmps ?? 16,
                        selectedProcessorId: savedPatch.selectedProcessorId || 'mx40-pro',
                        selectedOutputCardId: savedPatch.selectedOutputCardId || null,
                        outputCardCount: savedPatch.outputCardCount ?? 1
                    };
                });

                const activeIdx = Math.max(0, screens.findIndex(s => String(s.id) === String(activeProject.activePixelMapId)));
                return { screens, activeIndex: activeIdx >= 0 ? activeIdx : 0 };
            } catch (e) {
                console.warn('PixelLogicPatchingBridge.getScreensSnapshot error:', e);
                return { screens: [], activeIndex: 0 };
            }
        },
        syncFromPatching: (patchingScreens, activeIndex) => {
            try {
                const activeProject = state.projects.find(p => p.id === state.activeProjectId) || state.projects[0];
                if (!activeProject || !Array.isArray(patchingScreens) || !patchingScreens.length) return;
                const catalog = getLedSheetsCatalog();

                const nextMaps = patchingScreens.map((ps, idx) => {
                    let map = (activeProject.pixelMaps || []).find(m => String(m.id) === String(ps.id));
                    if (!map) {
                        map = createNewPixelMapObject(idx + 1);
                        map.id = ps.id || (Date.now() + idx);
                    }
                    map.name = ps.name || `Screen ${idx + 1}`;
                    map.ledBrand = ps.ledBrand || '';
                    map.ledModel = ps.ledModel || '';

                    const spec = catalog.find(c => c.brand === map.ledBrand && c.model === map.ledModel);
                    const physW = Math.max(1, Number(ps.physW) || (spec ? spec.panelWidthMm : 500));
                    const physH = Math.max(1, Number(ps.physH) || (spec ? spec.panelHeightMm : 500));
                    const modW = Math.max(1, Number(ps.modW) || (spec ? spec.panelResWidth : 192));
                    const modH = Math.max(1, Number(ps.modH) || (spec ? spec.panelResHeight : 192));
                    const cols = Math.max(1, Number(ps.cols) || 1);
                    const rows = Math.max(1, Number(ps.rows) || 1);

                    map.ledPitchMm = spec ? spec.pitchMm : Number((physW / Math.max(1, modW)).toFixed(2));
                    map.panelWidthMm = physW;
                    map.panelHeightMm = physH;
                    map.panelDimensionsUnit = 'mm';
                    map.panelResWidth = modW;
                    map.panelResHeight = modH;
                    map.tilesWide = String(cols);
                    map.tilesHigh = String(rows);

                    const unit = map.screenDimensionsUnit || 'm';
                    const factor = SHEETS_UNIT_TO_MM[unit] || 1000;
                    map.screenWidthValue = Number(((cols * physW) / factor).toFixed(4));
                    map.screenHeightValue = Number(((rows * physH) / factor).toFixed(4));

                    map.patchingConfig = {
                        voltage: ps.voltage ?? 230,
                        tileAmps: ps.tileAmps ?? 1.0,
                        maxWatts: ps.maxWatts ?? 160,
                        use80PercentRule: !!ps.use80PercentRule,
                        conservative1G: !!ps.conservative1G,
                        weight: ps.weight ?? 7.5,
                        hz: ps.hz ?? 60,
                        bit: ps.bit ?? 8,
                        dataPattern: ps.dataPattern || 'v-snake',
                        powerPattern: ps.powerPattern || 'v-snake',
                        dataStartCorner: ps.dataStartCorner || 'tl',
                        powerStartCorner: ps.powerStartCorner || 'tl',
                        dataPackingMode: ps.dataPackingMode || 'max-fill',
                        powerPackingMode: ps.powerPackingMode || 'max-fill',
                        redundancyMode: !!ps.redundancyMode,
                        dataRoutingMode: ps.dataRoutingMode || 'auto',
                        powerRoutingMode: ps.powerRoutingMode || 'auto',
                        manualDataPaths: Array.isArray(ps.manualDataPaths) ? ps.manualDataPaths : [],
                        manualPowerPaths: Array.isArray(ps.manualPowerPaths) ? ps.manualPowerPaths : [],
                        maxDataMods: ps.maxDataMods ?? 60,
                        isAutoDataLimit: ps.isAutoDataLimit !== undefined ? ps.isAutoDataLimit : true,
                        maxPowerMods: ps.maxPowerMods ?? 15,
                        isAutoPowerLimit: ps.isAutoPowerLimit !== undefined ? ps.isAutoPowerLimit : true,
                        circuitAmps: ps.circuitAmps ?? 16,
                        selectedProcessorId: (ps.selectedProcessor && ps.selectedProcessor.id) || ps.selectedProcessorId || 'mx40-pro',
                        selectedOutputCardId: ps.selectedOutputCardId || null,
                        outputCardCount: ps.outputCardCount ?? 1
                    };
                    if (state.sheetsState && Number(ps.voltage) > 0) {
                        state.sheetsState.voltage = Number(ps.voltage);
                    }

                    try { applyShapeMask(map); } catch (_) {}
                    return map;
                });

                activeProject.pixelMaps = nextMaps;
                const targetActive = nextMaps[activeIndex] || nextMaps[0];
                if (targetActive) activeProject.activePixelMapId = targetActive.id;
                saveState();
                redrawAffectedVisuals();
            } catch (e) {
                console.warn('PixelLogicPatchingBridge.syncFromPatching error:', e);
            }
        },
        openSheetsTab: () => {
            try { switchTab('sheets'); } catch (_) {}
        },
        openDesignerTab: () => {
            try { switchTab('designer'); } catch (_) {}
        }
    };
    const renderLedPatchingTab = () => {
            const c = mainContent['led-patching'];
            if (!c) return;

            c.innerHTML = '<div id="lp-react-root" class="w-full h-[calc(100vh-160px)]"></div>';
            const mountEl = document.getElementById('lp-react-root');
            if (!mountEl || !window.SignalPatchingPro || typeof window.SignalPatchingPro.mount !== 'function') {
                c.innerHTML = '<div class="text-center text-gray-400 p-6">LED Patching module failed to load.</div>';
                return;
            }

            window.SignalPatchingPro.mount(mountEl);
            return;

            c.innerHTML = '<div id="lp-react-root" class="w-full h-[calc(100vh-160px)]"></div>';
            const rootEl = document.getElementById('lp-react-root');
            const ReactRef = window.React;
            const ReactDOMRef = window.ReactDOM;
            const htmRef = window.htm;

            if (!rootEl || !ReactRef || !ReactDOMRef || !htmRef || typeof ReactDOMRef.createRoot !== 'function') {
                c.innerHTML = '<div class="text-center text-gray-400 p-6">Feature removed.</div>';
                return;
            }

            const { useState, useMemo } = ReactRef;
            const html = htmRef.bind(ReactRef.createElement);

            const CABINET_TYPES = [
                { id: 'besd-xr-f1.5', name: 'BESD XR F1.5 - Flexible LED 1.56mm', w: 320, h: 320, size: 500, maxW: 160, weight: 7.5 },
                { id: 'absen-pl2.5', name: 'Absen PL2.5 Pro', w: 200, h: 200, size: 500, maxW: 140, weight: 8.2 },
                { id: 'roe-bp2', name: 'ROE Black Pearl 2', w: 176, h: 176, size: 500, maxW: 160, weight: 9.1 }
            ];

            const PATTERNS = [
                { id: 'v-snake', name: 'Vertical Snake' },
                { id: 'h-snake', name: 'Horizontal Snake' },
                { id: 'v-zigzag', name: 'Vertical ZigZag' },
                { id: 'h-zigzag', name: 'Horizontal ZigZag' }
            ];

            const App = () => {
                const [config, setConfig] = useState({
                    cols: 10,
                    rows: 6,
                    cabinet: CABINET_TYPES[0],
                    hz: 60,
                    bit: 8,
                    dataPattern: 'v-snake',
                    powerPattern: 'v-snake',
                    maxDataMods: 60,
                    maxPowerMods: 15
                });

                const [showPower, setShowPower] = useState(true);
                const [showData, setShowData] = useState(true);

                const totals = useMemo(() => {
                    const totalCabs = config.cols * config.rows;
                    const totalPx = totalCabs * config.cabinet.w * config.cabinet.h;
                    const totalW = totalCabs * config.cabinet.maxW;
                    const totalA = totalW / 230;
                    const bitFactor = config.bit === 8 ? 1 : 2;
                    const portLimit = Math.floor(655360 / ((config.hz / 60) * bitFactor));
                    const cabsPerPortLimit = Math.floor(portLimit / (config.cabinet.w * config.cabinet.h));
                    return { totalCabs, totalPx, totalW, totalA, cabsPerPortLimit };
                }, [config]);

                const generatePath = (type, limit) => {
                    const points = [];
                    const { cols, rows } = config;
                    const vertical = (type === 'v-snake' || type === 'v-zigzag');

                    if (vertical) {
                        for (let c = 0; c < cols; c++) {
                            const isReverse = c % 2 !== 0;
                            const rOrder = isReverse ? Array.from({ length: rows }, (_, i) => rows - 1 - i) : Array.from({ length: rows }, (_, i) => i);
                            rOrder.forEach((r) => points.push({ c, r }));
                        }
                    } else {
                        for (let r = 0; r < rows; r++) {
                            const isReverse = r % 2 !== 0;
                            const cOrder = isReverse ? Array.from({ length: cols }, (_, i) => cols - 1 - i) : Array.from({ length: cols }, (_, i) => i);
                            cOrder.forEach((c) => points.push({ c, r }));
                        }
                    }

                    const circuits = [];
                    const chunk = Math.max(1, Number(limit) || 1);
                    for (let i = 0; i < points.length; i += chunk) circuits.push(points.slice(i, i + chunk));
                    return circuits;
                };

                const dataPaths = useMemo(() => generatePath(config.dataPattern, config.maxDataMods), [config]);
                const powerPaths = useMemo(() => generatePath(config.powerPattern, config.maxPowerMods), [config]);

                const cabSize = 44;
                const padding = 30;
                const canvasW = config.cols * cabSize + (padding * 2);
                const canvasH = config.rows * cabSize + (padding * 2);

                const renderPath = (circuits, color, offset = 0) => circuits.map((circuit, cIdx) => {
                    let d = '';
                    circuit.forEach((pt, pIdx) => {
                        const x = padding + (pt.c * cabSize) + (cabSize / 2) + offset;
                        const y = padding + (pt.r * cabSize) + (cabSize / 2) + offset;
                        if (pIdx === 0) d += `M ${x} ${y}`;
                        else d += ` L ${x} ${y}`;
                    });

                    const startX = padding + (circuit[0].c * cabSize) + (cabSize / 2) + offset;
                    const startY = padding + (circuit[0].r * cabSize) + (cabSize / 2) + offset;
                    return html`
                        <g key=${`${color}-${cIdx}`}>
                            <path d=${d} fill="none" stroke=${color} strokeWidth="2.5" strokeLinejoin="round" strokeLinecap="round" opacity="0.85"></path>
                            <circle cx=${startX} cy=${startY} r="3.5" fill=${color}></circle>
                        </g>
                    `;
                });

                return html`
                    <div class="flex w-full h-full overflow-hidden" style=${{ background: '#0a0a0a', color: '#d1d5db' }}>
                        <aside class="w-72 border-r p-3 overflow-y-auto" style=${{ background: '#151515', borderColor: '#222' }}>
                            <div class="mb-3 p-3 rounded border" style=${{ background: '#1a1a1a', borderColor: '#2a2a2a' }}>
                                <h3 class="text-sm font-semibold text-white">${config.cabinet.name}</h3>
                                <div class="grid grid-cols-2 gap-y-1 text-[11px] mt-2">
                                    <span class="text-gray-400">Panels:</span><span>${config.cols} x ${config.rows}</span>
                                    <span class="text-gray-400">Total Px:</span><span>${(totals.totalPx / 1000000).toFixed(2)} M</span>
                                    <span class="text-gray-400">Power:</span><span>${totals.totalA.toFixed(1)} A</span>
                                </div>
                            </div>

                            <div class="space-y-3">
                                <div>
                                    <label class="text-[11px] text-gray-400">Cabinet</label>
                                    <select class="w-full mt-1 bg-gray-900 border border-gray-700 rounded px-2 py-1.5 text-xs" value=${config.cabinet.id} onChange=${(e) => {
                                        const next = CABINET_TYPES.find((x) => x.id === e.target.value) || CABINET_TYPES[0];
                                        setConfig({ ...config, cabinet: next });
                                    }}>
                                        ${CABINET_TYPES.map((cab) => html`<option key=${cab.id} value=${cab.id}>${cab.name}</option>`)}
                                    </select>
                                </div>
                                <div class="grid grid-cols-2 gap-2">
                                    <div>
                                        <label class="text-[11px] text-gray-400">Cols</label>
                                        <input type="number" min="1" class="w-full mt-1 bg-gray-900 border border-gray-700 rounded px-2 py-1.5 text-xs" value=${config.cols}
                                            onChange=${(e) => setConfig({ ...config, cols: Math.max(1, parseInt(e.target.value || '1', 10)) })} />
                                    </div>
                                    <div>
                                        <label class="text-[11px] text-gray-400">Rows</label>
                                        <input type="number" min="1" class="w-full mt-1 bg-gray-900 border border-gray-700 rounded px-2 py-1.5 text-xs" value=${config.rows}
                                            onChange=${(e) => setConfig({ ...config, rows: Math.max(1, parseInt(e.target.value || '1', 10)) })} />
                                    </div>
                                </div>

                                <div class="rounded border p-2" style=${{ borderColor: '#2a2a2a', background: '#1e1e1e' }}>
                                    <div class="text-[11px] text-cyan-300 font-semibold mb-2">Data Signal Config</div>
                                    <label class="text-[11px] text-gray-400">Pattern</label>
                                    <select class="w-full mt-1 bg-gray-900 border border-gray-700 rounded px-2 py-1.5 text-xs" value=${config.dataPattern} onChange=${(e) => setConfig({ ...config, dataPattern: e.target.value })}>
                                        ${PATTERNS.map((p) => html`<option key=${p.id} value=${p.id}>${p.name}</option>`)}
                                    </select>
                                    <label class="text-[11px] text-gray-400 mt-2 block">Max modules / port</label>
                                    <input type="number" min="1" class="w-full mt-1 bg-gray-900 border border-gray-700 rounded px-2 py-1.5 text-xs" value=${config.maxDataMods}
                                        onChange=${(e) => setConfig({ ...config, maxDataMods: Math.max(1, parseInt(e.target.value || '1', 10)) })} />
                                    ${config.maxDataMods > totals.cabsPerPortLimit ? html`<div class="text-[10px] text-red-400 mt-1">Bandwidth limit exceeded. Max: ${totals.cabsPerPortLimit}</div>` : null}
                                </div>

                                <div class="rounded border p-2" style=${{ borderColor: '#2a2a2a', background: '#1e1e1e' }}>
                                    <div class="text-[11px] text-rose-300 font-semibold mb-2">Power Wiring Config</div>
                                    <label class="text-[11px] text-gray-400">Pattern</label>
                                    <select class="w-full mt-1 bg-gray-900 border border-gray-700 rounded px-2 py-1.5 text-xs" value=${config.powerPattern} onChange=${(e) => setConfig({ ...config, powerPattern: e.target.value })}>
                                        ${PATTERNS.map((p) => html`<option key=${p.id} value=${p.id}>${p.name}</option>`)}
                                    </select>
                                    <label class="text-[11px] text-gray-400 mt-2 block">Max modules / circuit</label>
                                    <input type="number" min="1" class="w-full mt-1 bg-gray-900 border border-gray-700 rounded px-2 py-1.5 text-xs" value=${config.maxPowerMods}
                                        onChange=${(e) => setConfig({ ...config, maxPowerMods: Math.max(1, parseInt(e.target.value || '1', 10)) })} />
                                </div>
                            </div>
                        </aside>

                        <main class="flex-1 flex flex-col" style=${{ background: '#111' }}>
                            <div class="h-11 border-b px-3 flex items-center justify-between" style=${{ borderColor: '#222' }}>
                                <div class="flex gap-2">
                                    <button class="px-3 py-1 text-[10px] rounded border" onClick=${() => setShowData(!showData)} style=${showData ? { borderColor: '#3b82f6', color: '#60a5fa', background: 'rgba(30, 58, 138, 0.35)' } : { borderColor: '#333', color: '#6b7280', background: '#1a1a1a' }}>SHOW DATA</button>
                                    <button class="px-3 py-1 text-[10px] rounded border" onClick=${() => setShowPower(!showPower)} style=${showPower ? { borderColor: '#ef4444', color: '#f87171', background: 'rgba(127, 29, 29, 0.35)' } : { borderColor: '#333', color: '#6b7280', background: '#1a1a1a' }}>SHOW POWER</button>
                                </div>
                                <div class="text-[11px] text-gray-400">Connection Diagram Designer</div>
                            </div>

                            <div class="flex-1 overflow-auto p-8 flex items-center justify-center" style=${{ background: '#0f172a' }}>
                                <svg width=${canvasW} height=${canvasH} viewBox=${`0 0 ${canvasW} ${canvasH}`}>
                                    ${Array.from({ length: config.cols }).map((_, cIdx) =>
                                        Array.from({ length: config.rows }).map((_, rIdx) => html`
                                            <g key=${`cab-${cIdx}-${rIdx}`}>
                                                <rect x=${padding + cIdx * cabSize} y=${padding + rIdx * cabSize} width=${cabSize - 2} height=${cabSize - 2} fill="#1a1a1a" stroke="#2b2b2b"></rect>
                                                <text x=${padding + cIdx * cabSize + 4} y=${padding + rIdx * cabSize + 11} fill="#4b5563" fontSize="8">${cIdx},${rIdx}</text>
                                            </g>
                                        `)
                                    )}
                                    ${showPower ? renderPath(powerPaths, '#ff4757', 3) : null}
                                    ${showData ? renderPath(dataPaths, '#2e86de', -3) : null}
                                </svg>
                            </div>
                        </main>

                        <aside class="w-64 border-l p-3 overflow-y-auto" style=${{ background: '#151515', borderColor: '#222' }}>
                            <div class="text-xs font-semibold text-white mb-2">System Controllers</div>
                            <div class="rounded border p-2" style=${{ background: '#1e1e1e', borderColor: '#333' }}>
                                <div class="flex items-center justify-between text-xs mb-2">
                                    <span class="text-emerald-300 font-semibold">#1</span>
                                    <span>NovaStar MCTRL4K</span>
                                </div>
                                <div class="grid grid-cols-4 gap-1">
                                    ${Array.from({ length: 16 }).map((_, i) => html`
                                        <div key=${i} class="h-7 rounded border text-[10px] font-semibold flex items-center justify-center" style=${i < dataPaths.length ? { background: '#00ff88', color: '#111', borderColor: '#00ff88' } : { background: '#111', color: '#6b7280', borderColor: '#222' }}>${i + 1}</div>
                                    `)}
                                </div>
                                <div class="text-[10px] text-gray-400 mt-2">Usage: ${dataPaths.length} / 16</div>
                            </div>
                        </aside>
                    </div>
                `;
            };

            if (!window.__lpReactRoots) window.__lpReactRoots = new WeakMap();
            const priorRoot = window.__lpReactRoots.get(c);
            if (priorRoot && typeof priorRoot.unmount === 'function') {
                try { priorRoot.unmount(); } catch(_) {}
            }
            const root = ReactDOMRef.createRoot(rootEl);
            window.__lpReactRoots.set(c, root);
            root.render(html`<${App} />`);
            return;
            const project = state.projects.find(p => p.id === state.activeProjectId);
            if (!project) {
                c.innerHTML = `<div class="text-center text-gray-500">Please select or create a project.</div>`;
                return;
            }

            // Prefer maps on the active Output Canvas; fallback to active Designer map
            const ac = getActiveCanvas();
            const acMaps = (ac && Array.isArray(ac.maps)) ? ac.maps : [];
            if (!state.lpState) state.lpState = { selectedMapId: null };
            let currentMap = null;
            if (acMaps.length > 0) {
                const selId = state.lpState.selectedMapId;
                currentMap = acMaps.find(m => String(m.id) === String(selId)) || acMaps[0];
                state.lpState.selectedMapId = currentMap ? currentMap.id : null;
            } else {
                currentMap = getActivePixelMap();
                state.lpState.selectedMapId = currentMap ? currentMap.id : null;
            }
            const buildNovaStarModelOptions = (selectedModel = 'MCTRL4K') => {
                const safeSelected = (selectedModel && processorsDB[selectedModel]) ? selectedModel : 'MCTRL4K';
                const groups = Object.keys(novastarCatalog || {});
                if (!groups.length) {
                    return '<option value="MCTRL4K" selected>MCTRL4K</option>';
                }
                return groups.map(cat => {
                    const models = Array.isArray(novastarCatalog[cat]) ? novastarCatalog[cat] : [];
                    const options = models
                        .filter(model => !!processorsDB[model])
                        .map(model => `<option value="${model}" ${model === safeSelected ? 'selected' : ''}>${model}</option>`)
                        .join('');
                    return options ? `<optgroup label="${cat}">${options}</optgroup>` : '';
                }).join('');
            };
            const preferredModel = (state.lpState && state.lpState.selectedModel && processorsDB[state.lpState.selectedModel])
                ? state.lpState.selectedModel
                : 'MCTRL4K';
            const vizCanvasHtml = currentMap ? `<canvas id="lp-visualizer-canvas" class="max-w-full max-h-full" style="image-rendering: pixelated;"></canvas>` : `<div class="text-gray-500">Send a map to Output Canvas or select a Pixel Map in Pixel Designer to preview it here.</div>`;
            const mapCalcs = (() => {
                try { return currentMap ? (calculateLayout(currentMap) || null) : null; } catch (_) { return null; }
            })();
            const mapPixelsLabel = mapCalcs?.totalPixels ? Number(mapCalcs.totalPixels).toLocaleString() : '—';
            const mapSizeLabel = mapCalcs ? `${Math.round(mapCalcs.totalResWidth || 0)} × ${Math.round(mapCalcs.totalResHeight || 0)}` : '—';
            const mapPanelsLabel = mapCalcs ? `${Math.round(mapCalcs.panelsHorizontally || 0)} × ${Math.round(mapCalcs.panelsVertically || 0)}` : '—';

            c.innerHTML = `
                <div class="bg-[#0f1115] p-3 rounded-xl shadow-lg border border-gray-800">
                    <div class="flex items-center justify-between gap-3 mb-3">
                        <div class="flex items-center gap-3 text-sm">
                            <span class="text-gray-300 font-semibold">Connection Diagram Designer</span>
                            <div id="lp-map-tabs" class="flex gap-2 overflow-auto"></div>
                        </div>
                        <div class="flex items-center gap-2">
                            <button id="lp-led-export" class="px-3 py-1.5 rounded bg-sky-600 hover:bg-sky-700 text-xs font-semibold" disabled>Export CSV</button>
                            <button id="lp-led-export-pdf" class="px-3 py-1.5 rounded bg-rose-600 hover:bg-rose-700 text-xs font-semibold" disabled>Export PDF</button>
                            <button id="lp-led-save-png" class="px-3 py-1.5 rounded bg-indigo-600 hover:bg-indigo-700 text-xs font-semibold">Save PNG</button>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 xl:grid-cols-12 gap-3">
                        <div class="xl:col-span-3 bg-[#171a21] rounded-lg border border-gray-800 p-3 space-y-3">
                            <div class="text-[#00ff95] font-semibold text-sm">${escapeHtml(currentMap?.name || 'Screen_1')}</div>
                            <div class="text-[11px] text-gray-400 space-y-1 border-b border-gray-700 pb-2">
                                <div>Model: ${escapeHtml(currentMap?.ledModel || 'LED Wall')}</div>
                                <div>Panels: ${mapPanelsLabel}</div>
                                <div>Size: ${mapSizeLabel} px</div>
                                <div>Total Pixels: ${mapPixelsLabel}</div>
                            </div>

                            <div class="rounded border border-gray-700 bg-[#12151b] p-2 space-y-2">
                                <div class="text-xs font-semibold text-cyan-300">Data Signal Config</div>
                                <label class="block text-[11px] text-gray-400">Controller</label>
                                <select id="lp-led-model" class="w-full bg-gray-900 border border-gray-600 rounded px-2 py-1.5 text-xs">
                                    ${buildNovaStarModelOptions(preferredModel)}
                                </select>
                                <div class="grid grid-cols-2 gap-2">
                                    <div><label class="block text-[11px] text-gray-400">Units</label><input id="lp-led-units" type="number" min="1" value="1" class="w-full bg-gray-900 border border-gray-600 rounded px-2 py-1.5 text-xs" /></div>
                                    <div><label class="block text-[11px] text-gray-400">Ports</label><input id="lp-led-ports" type="number" min="1" value="16" class="w-full bg-gray-900 border border-gray-600 rounded px-2 py-1.5 text-xs" /></div>
                                </div>
                                <div class="grid grid-cols-2 gap-2">
                                    <div><label class="block text-[11px] text-gray-400">Refresh</label><select id="lp-led-refresh" class="w-full bg-gray-900 border border-gray-600 rounded px-2 py-1.5 text-xs"><option value="60" selected>60 Hz</option><option value="50">50 Hz</option></select></div>
                                    <div><label class="block text-[11px] text-gray-400">Bit</label><select id="lp-led-bit-depth" class="w-full bg-gray-900 border border-gray-600 rounded px-2 py-1.5 text-xs"><option value="8" selected>8-bit</option><option value="10">10-bit</option><option value="12">12-bit</option></select></div>
                                </div>
                                <label class="block text-[11px] text-gray-400">Capacity / Port (px)</label>
                                <input id="lp-led-capacity" type="number" min="1000" step="1000" value="650000" class="w-full bg-gray-900 border border-gray-600 rounded px-2 py-1.5 text-xs" />
                                <div class="grid grid-cols-2 gap-2">
                                    <div><label class="block text-[11px] text-gray-400">Max modules</label><input id="lp-led-max-panels-port" type="number" min="0" step="1" placeholder="60" class="w-full bg-gray-900 border border-gray-600 rounded px-2 py-1.5 text-xs" /></div>
                                    <div><label class="block text-[11px] text-gray-400">Patch mode</label><select id="lp-led-patch-mode" class="w-full bg-gray-900 border border-gray-600 rounded px-2 py-1.5 text-xs"><option value="auto" selected>Auto</option><option value="snake-h">Snake H</option><option value="snake-v">Snake V</option><option value="row">Row</option><option value="column">Column</option></select></div>
                                </div>
                                <div>
                                    <label class="block text-[11px] text-gray-400">Wiring Pattern</label>
                                    <div id="lp-led-wiring-grid" class="grid grid-cols-4 gap-1 select-none"></div>
                                </div>
                            </div>

                            <div class="rounded border border-gray-700 bg-[#12151b] p-2 space-y-2">
                                <div class="text-xs font-semibold text-amber-300">Power Wiring Config</div>
                                <div class="grid grid-cols-2 gap-2">
                                    <div><label class="block text-[11px] text-gray-400">Cabinet</label><select id="lp-led-cabinet" class="w-full bg-gray-900 border border-gray-600 rounded px-2 py-1.5 text-xs"><option value="P2.6_Indoor" selected>P2.6</option><option value="P3.9_Outdoor">P3.9</option><option value="custom">Custom</option></select></div>
                                    <div><label class="block text-[11px] text-gray-400">W / cab</label><input id="lp-led-cab-watts" type="number" min="50" step="5" value="160" class="w-full bg-gray-900 border border-gray-600 rounded px-2 py-1.5 text-xs" /></div>
                                </div>
                                <div class="grid grid-cols-3 gap-2">
                                    <div><label class="block text-[11px] text-gray-400">V</label><input id="lp-led-voltage" type="number" min="100" step="1" value="230" class="w-full bg-gray-900 border border-gray-600 rounded px-2 py-1.5 text-xs" /></div>
                                    <div><label class="block text-[11px] text-gray-400">A</label><input id="lp-led-breaker" type="number" min="1" step="1" value="16" class="w-full bg-gray-900 border border-gray-600 rounded px-2 py-1.5 text-xs" /></div>
                                    <div><label class="block text-[11px] text-gray-400">Safety</label><input id="lp-led-safety" type="number" min="0.5" max="0.95" step="0.01" value="0.8" class="w-full bg-gray-900 border border-gray-600 rounded px-2 py-1.5 text-xs" /></div>
                                </div>
                                <div class="grid grid-cols-3 gap-2 items-center">
                                    <div>
                                        <label class="block text-[11px] text-gray-400">Overlay</label>
                                        <input id="lp-led-overlay-color" type="color" value="#ff0000" class="w-9 h-8 p-0 bg-transparent border-none rounded" />
                                    </div>
                                    <div>
                                        <label class="block text-[11px] text-gray-400">Width</label>
                                        <input id="lp-led-overlay-width" type="range" min="1" max="16" step="1" value="5" class="w-full" />
                                    </div>
                                    <div>
                                        <label class="block text-[11px] text-gray-400">Style</label>
                                        <select id="lp-led-overlay-style" class="w-full bg-gray-900 border border-gray-600 rounded px-2 py-1.5 text-xs"><option value="solid">Solid</option><option value="dashed">Dashed</option><option value="dotted">Dotted</option></select>
                                    </div>
                                </div>
                                <button id="lp-led-generate" class="w-full px-3 py-2 rounded bg-emerald-600 hover:bg-emerald-700 text-xs font-semibold">Generate Patching</button>
                                <label class="flex items-center gap-2 text-[11px] text-gray-300"><input id="lp-led-show-overlay" type="checkbox" class="form-checkbox bg-gray-700" checked> Show overlay on Output Canvas</label>
                            </div>
                        </div>

                        <div class="xl:col-span-6 bg-[#11141a] rounded-lg border border-gray-800 p-3">
                            <div id="lp-preview-title" class="text-xs text-gray-400 mb-2">Screen Preview ${currentMap ? `— <span class='text-accent'>${currentMap.name}</span>` : ''}</div>
                            <div id="lp-visualizer-container" class="relative w-full h-[64vh] bg-black rounded border border-gray-700 p-3 flex items-start justify-center overflow-hidden">
                                <div id="lp-visualizer-wrapper">${vizCanvasHtml}</div>
                            </div>
                            <div class="mt-3 grid grid-cols-1 md:grid-cols-3 gap-2 text-xs">
                                <div id="lp-signal-summary" class="rounded border border-gray-700 bg-[#0f1217] px-2 py-1.5 text-gray-300">Signal: -</div>
                                <div id="lp-power-summary" class="rounded border border-gray-700 bg-[#0f1217] px-2 py-1.5 text-gray-300">Power: -</div>
                                <div id="lp-patch-summary" class="rounded border border-gray-700 bg-[#0f1217] px-2 py-1.5 text-gray-300">Patch: -</div>
                            </div>
                        </div>

                        <div class="xl:col-span-3 bg-[#171a21] rounded-lg border border-gray-800 p-3 space-y-3">
                            <div class="flex items-center justify-between">
                                <div class="text-xs font-semibold text-gray-200">System Controllers</div>
                                <button id="lp-add-controller" class="px-2 py-1 rounded bg-emerald-600 hover:bg-emerald-700 text-[11px]">+ Add</button>
                            </div>
                            <div id="lp-controller-panel" class="rounded border border-gray-700 bg-[#12151b] p-2 text-xs text-gray-300">
                                <div class="text-gray-500">No generated ports yet.</div>
                            </div>
                            <div class="rounded border border-gray-700 overflow-hidden">
                                <div class="px-2 py-1.5 text-[11px] text-gray-400 bg-[#0f1217]">Panels per Port</div>
                                <div class="max-h-40 overflow-auto">
                                    <table class="w-full text-[11px]"><thead class="bg-[#0f1217] text-gray-300 sticky top-0"><tr><th class="text-left px-2 py-1">U</th><th class="text-left px-2 py-1">P</th><th class="text-left px-2 py-1">Color</th><th class="text-left px-2 py-1">Map</th><th class="text-left px-2 py-1">Use%</th></tr></thead><tbody id="lp-port-usage-body" class="divide-y divide-gray-800 text-gray-200"></tbody></table>
                                </div>
                            </div>
                            <div class="rounded border border-gray-700 overflow-hidden">
                                <div class="px-2 py-1.5 text-[11px] text-gray-400 bg-[#0f1217]">Patch Preview</div>
                                <div class="max-h-40 overflow-auto">
                                    <table class="w-full text-[11px]"><thead class="bg-[#0f1217] text-gray-300 sticky top-0"><tr><th class="text-left px-2 py-1">U</th><th class="text-left px-2 py-1">P</th><th class="text-left px-2 py-1">C</th><th class="text-left px-2 py-1">Map</th><th class="text-left px-2 py-1">Seq</th></tr></thead><tbody id="lp-patch-table-body" class="divide-y divide-gray-800 text-gray-200"></tbody></table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <select id="lp-led-brand" class="hidden" disabled><option value="novastar" selected>NovaStar</option></select>
                </div>`;

            // Build wiring grid (clone if source exists, otherwise create a minimal grid here)
            try {
                const src = document.getElementById('led-wiring-grid');
                const dest = document.getElementById('lp-led-wiring-grid');
                if (dest) {
                    if (src) {
                        dest.innerHTML = src.innerHTML.replaceAll('name="led-wiring"', 'name="lp-led-wiring"');
                    } else {
                        const patterns = [
                            {code:'H-TL', label:'H TL'}, {code:'H-TR', label:'H TR'}, {code:'H-BL', label:'H BL'}, {code:'H-BR', label:'H BR'},
                            {code:'V-TL', label:'V TL'}, {code:'V-TR', label:'V TR'}, {code:'V-BL', label:'V BL'}, {code:'V-BR', label:'V BR'}
                        ];
                        dest.innerHTML = patterns.map(p => `
                            <label data-pattern="${p.code}" class="flex items-center justify-center gap-2 border border-gray-700 rounded px-2 py-1 text-xs cursor-pointer select-none">
                                <input type="radio" name="lp-led-wiring" value="${p.code}" class="sr-only">
                                <span class="text-gray-200">${p.label}</span>
                            </label>
                        `).join('');
                    }
                }
            } catch(_) {}

            // Build tabs for maps on the active Output Canvas (if any)
            try {
                const tabsEl = document.getElementById('lp-map-tabs');
                if (tabsEl) {
                    if (acMaps.length > 0) {
                        tabsEl.innerHTML = acMaps.map(m => `
                            <button data-map-id="${m.id}" class="px-3 py-1 text-xs rounded border border-gray-700 ${String(m.id)===String(state.lpState.selectedMapId)?'bg-emerald-600/20 text-emerald-300 border-emerald-600':'text-gray-300 hover:text-white hover:border-gray-500'}">${m.name || 'Map'}</button>
                        `).join('');
                        // Wire clicks to switch current map
                        tabsEl.querySelectorAll('button[data-map-id]').forEach(btn => {
                            btn.addEventListener('click', (e) => {
                                const id = e.currentTarget.getAttribute('data-map-id');
                                const found = acMaps.find(mm => String(mm.id) === String(id));
                                if (found && lpCanvas) {
                                    state.lpState.selectedMapId = found.id;
                                    currentMap = found;
                                    try { drawVisualizerCanvas(lpCanvas, currentMap); } catch(_) {}
                                    try { fitLpCanvas(); } catch(_) {}
                                    // Update tab highlight
                                    tabsEl.querySelectorAll('button[data-map-id]').forEach(b => b.classList.remove('bg-emerald-600/20','text-emerald-300','border-emerald-600'));
                                    e.currentTarget.classList.add('bg-emerald-600/20','text-emerald-300','border-emerald-600');
                                    // Update preview title
                                    try {
                                        const titleEl = document.getElementById('lp-preview-title');
                                        if (titleEl) titleEl.innerHTML = `Pixel Map Preview — <span class='text-accent'>${currentMap.name || 'Map'}</span>`;
                                    } catch(_) {}
                                    // Redraw overlay for new map
                                    try { drawLpSerpentineOverlay(); } catch(_) {}
                                }
                            });
                        });
                    } else {
                        tabsEl.innerHTML = `<span class="text-xs text-gray-500">No Output Canvas maps yet</span>`;
                    }
                }
            } catch(_) {}

            // Helper to fit LP canvas to the preview container (contain)
            const fitLpCanvas = () => {
                try {
                    const container = document.getElementById('lp-visualizer-container');
                    if (!lpCanvas || !container) return;
                    if (lpCanvas.width <= 0 || lpCanvas.height <= 0) return;
                    const cw = container.clientWidth || container.offsetWidth;
                    const ch = container.clientHeight || container.offsetHeight;
                    if (!cw || !ch) return;
                    const scale = Math.min(cw / lpCanvas.width, ch / lpCanvas.height);
                    lpCanvas.style.width = Math.round(lpCanvas.width * scale) + 'px';
                    lpCanvas.style.height = Math.round(lpCanvas.height * scale) + 'px';
                } catch(_) {}
            };

            // Draw the pixel map preview if available
            const lpCanvas = document.getElementById('lp-visualizer-canvas');
            try {
                if (currentMap && lpCanvas) {
                    drawVisualizerCanvas(lpCanvas, currentMap);
                    fitLpCanvas();
                }
            } catch(_) {}

            // Helper: draw serpentine overlay on the LP preview (independent of Output Canvas)
            const drawLpSerpentineOverlay = () => {
                if (!lpCanvas || !currentMap) return;
                const ctx = lpCanvas.getContext('2d');
                if (!ctx) return;
                // Re-draw base to avoid trail, then overlay
                try { drawVisualizerCanvas(lpCanvas, currentMap); } catch(_) {}
                try { fitLpCanvas(); } catch(_) {}
                const calcs = (typeof calculateLayout === 'function') ? calculateLayout(currentMap) : null;
                if (!calcs || !calcs.totalResWidth || !calcs.totalResHeight || !calcs.panelResWidth || !calcs.panelResHeight) return;
                const cols = Math.max(1, Math.floor(calcs.panelsHorizontally || (calcs.totalResWidth / calcs.panelResWidth)));
                const rows = Math.max(1, Math.floor(calcs.panelsVertically || (calcs.totalResHeight / calcs.panelResHeight)));
                const pW = Math.max(1, Math.floor(calcs.panelResWidth));
                const pH = Math.max(1, Math.floor(calcs.panelResHeight));
                const totalW = Math.max(1, Math.floor(calcs.totalResWidth));
                const totalH = Math.max(1, Math.floor(calcs.totalResHeight));

                // Style from LP controls
                const color = (document.getElementById('lp-led-overlay-color')?.value) || '#ff0000';
                const width = Math.max(1, parseInt(document.getElementById('lp-led-overlay-width')?.value || '5', 10) || 5);
                const style = (document.getElementById('lp-led-overlay-style')?.value) || 'solid';
                const pattern = (typeof getSelectedWiringPatternLP === 'function' ? getSelectedWiringPatternLP() : 'H-TL') || 'H-TL';

                ctx.save();
                ctx.strokeStyle = color;
                ctx.lineWidth = width;
                ctx.lineJoin = 'round';
                ctx.lineCap = 'round';
                if (style === 'dashed') ctx.setLineDash([Math.max(8, width*2), Math.max(6, width*1.5)]);
                else if (style === 'dotted') ctx.setLineDash([width, Math.max(6, width*2)]);

                const drawArrowHead = (x1, y1, x2, y2) => {
                    const headLen = Math.max(6, Math.round(width * 2));
                    const angle = Math.atan2(y2 - y1, x2 - x1);
                    ctx.beginPath();
                    ctx.moveTo(x2, y2);
                    ctx.lineTo(x2 - headLen * Math.cos(angle - Math.PI / 6), y2 - headLen * Math.sin(angle - Math.PI / 6));
                    ctx.moveTo(x2, y2);
                    ctx.lineTo(x2 - headLen * Math.cos(angle + Math.PI / 6), y2 - headLen * Math.sin(angle + Math.PI / 6));
                    ctx.stroke();
                };

                const isHoriz = pattern.startsWith('H-');
                const startCorner = pattern.slice(2); // TL | TR | BL | BR

                if (isHoriz) {
                    const topFirst = (startCorner === 'TL' || startCorner === 'TR');
                    const leftStart = (startCorner === 'TL' || startCorner === 'BL');
                    // Determine row traversal order
                    const rowOrder = [...Array(rows).keys()];
                    if (!topFirst) rowOrder.reverse();
                    rowOrder.forEach((rowAbsIdx, relIdx) => {
                        const y = rowAbsIdx * pH + pH/2;
                        const ltr = (relIdx % 2 === 0) ? leftStart : !leftStart;
                        const xStart = ltr ? (pW/2) : (totalW - pW/2);
                        const xEnd = ltr ? (totalW - pW/2) : (pW/2);
                        ctx.beginPath();
                        ctx.moveTo(xStart, y);
                        ctx.lineTo(xEnd, y);
                        ctx.stroke();
                        drawArrowHead(xStart, y, xEnd, y);
                        // Connector to next row
                        const nextRowAbs = rowOrder[relIdx + 1];
                        if (nextRowAbs != null) {
                            const y2 = nextRowAbs * pH + pH/2;
                            const xConn = xEnd; // continue from end of this row
                            ctx.beginPath();
                            ctx.moveTo(xConn, y);
                            ctx.lineTo(xConn, y2);
                            ctx.stroke();
                        }
                    });
                } else {
                    // Vertical serpentine
                    const leftFirst = (startCorner === 'TL' || startCorner === 'BL');
                    const topStart = (startCorner === 'TL' || startCorner === 'TR');
                    const colOrder = [...Array(cols).keys()];
                    if (!leftFirst) colOrder.reverse();
                    colOrder.forEach((colAbsIdx, relIdx) => {
                        const x = colAbsIdx * pW + pW/2;
                        const ttb = (relIdx % 2 === 0) ? topStart : !topStart;
                        const yStart = ttb ? (pH/2) : (totalH - pH/2);
                        const yEnd = ttb ? (totalH - pH/2) : (pH/2);
                        ctx.beginPath();
                        ctx.moveTo(x, yStart);
                        ctx.lineTo(x, yEnd);
                        ctx.stroke();
                        drawArrowHead(x, yStart, x, yEnd);
                        const nextColAbs = colOrder[relIdx + 1];
                        if (nextColAbs != null) {
                            const x2 = nextColAbs * pW + pW/2;
                            const yConn = yEnd;
                            ctx.beginPath();
                            ctx.moveTo(x, yConn);
                            ctx.lineTo(x2, yConn);
                            ctx.stroke();
                        }
                    });
                }

                // Per-port labels for current map if patch exists
                try {
                    const assignments = (ac && ac.processorPatch && Array.isArray(ac.processorPatch.assignments)) ? ac.processorPatch.assignments : [];
                    const mine = assignments.filter(a => String(a.mapId) === String(currentMap.id));
                    if (mine.length) {
                        ctx.save();
                        ctx.setLineDash([]);
                        ctx.lineWidth = 1;
                        const fs = Math.max(8, Math.round(Math.min(pW, pH) * 0.25));
                        ctx.font = `${fs}px Inter`;
                        mine.forEach(a => {
                            const text = `U${a.unit}-P${a.port}`;
                            const bx = Math.max(0, Math.min(totalW, Math.round(a.relX)));
                            const by = Math.max(0, Math.min(totalH, Math.round(a.relY)));
                            const bw = Math.max(0, Math.min(totalW - bx, Math.round(a.w)));
                            const bh = Math.max(0, Math.min(totalH - by, Math.round(a.h)));
                            const portColor = a.portColor || '#ffffff';
                            ctx.strokeStyle = portColor;
                            ctx.strokeRect(bx + 0.5, by + 0.5, Math.max(0, bw - 1), Math.max(0, bh - 1));
                            const pad = 2;
                            const tw = ctx.measureText(text).width + pad * 2;
                            const th = fs + pad * 2;
                            const cx = bx + bw / 2 - tw / 2;
                            const cy = by + bh / 2 - th / 2;
                            ctx.fillStyle = 'rgba(0,0,0,0.6)';
                            ctx.fillRect(cx, cy, tw, th);
                            ctx.fillStyle = portColor;
                            ctx.fillText(text, cx + pad, cy + th - pad - 2);
                        });
                        ctx.restore();
                    }
                } catch(_) {}

                ctx.restore();
            };

            // Wire up LED patching controls for this tab
            class PixelLogicEngine {
                constructor() {
                    this.cabinetLibrary = {
                        P2_6_Indoor: { key: 'P2.6_Indoor', width: 192, height: 192, maxWatts: 160 },
                        P3_9_Outdoor: { key: 'P3.9_Outdoor', width: 128, height: 128, maxWatts: 300 }
                    };
                }

                calculateSignal(cabW, cabH, refreshRate = 60, bitDepth = 8) {
                    const netBandwidth = 1000000000 * 0.95;
                    const bitsPerPixel = bitDepth * 3;
                    const maxPixelsPerPort = Math.floor(netBandwidth / (refreshRate * bitsPerPixel));
                    const cabPixels = cabW * cabH;
                    const maxCabsPerPort = Math.max(1, Math.floor(maxPixelsPerPort / Math.max(1, cabPixels)));
                    return { maxPixelsPerPort, maxCabsPerPort };
                }

                calculatePower(numCabs, maxWatts, voltage = 230, breakerAmps = 16, safetyMargin = 0.8) {
                    const totalMaxPower = numCabs * maxWatts;
                    const totalMaxAmps = totalMaxPower / Math.max(1, voltage);
                    const safeAmpsPerBreaker = Math.max(0.1, breakerAmps * safetyMargin);
                    const requiredCircuits = Math.max(1, Math.ceil(totalMaxAmps / safeAmpsPerBreaker));
                    const cabsPerCircuit = Math.max(1, Math.floor(numCabs / requiredCircuits));
                    return {
                        totalKW: (totalMaxPower / 1000).toFixed(2),
                        totalAmps: totalMaxAmps.toFixed(2),
                        requiredCircuits,
                        cabsPerCircuit
                    };
                }

                generatePatch(cols, rows, maxPerPort) {
                    const patchMap = [];
                    let currentPort = 1;
                    let portCount = 0;
                    for (let r = 0; r < rows; r++) {
                        const isReverse = r % 2 !== 0;
                        for (let c = 0; c < cols; c++) {
                            const actualCol = isReverse ? (cols - 1 - c) : c;
                            if (portCount >= maxPerPort) {
                                currentPort++;
                                portCount = 0;
                            }
                            patchMap.push({
                                port: currentPort,
                                cab: `[C:${actualCol}, R:${r}]`,
                                col: actualCol,
                                row: r,
                                sequence: portCount + 1
                            });
                            portCount++;
                        }
                    }
                    return patchMap;
                }
            }

            const engine = new PixelLogicEngine();
            const NOVASTAR_MODELS = Object.keys(processorsDB || {}).reduce((acc, key) => {
                const p = processorsDB[key] || {};
                if (!p || !p.model) return acc;
                acc[p.model] = {
                    portsPerUnit: Math.max(1, Number(p.ethernetPorts) || 6),
                    capacityPerPort: Math.max(100000, Number(p.perPortEstimate) || 650000)
                };
                return acc;
            }, {});
            const LP_PORT_COLORS = ['#ef4444', '#f59e0b', '#eab308', '#22c55e', '#14b8a6', '#06b6d4', '#3b82f6', '#6366f1', '#8b5cf6', '#ec4899', '#f43f5e', '#84cc16'];
            const getPortColor = (unit, port, portsPerUnit) => {
                const ports = Math.max(1, Number(portsPerUnit) || 1);
                const idx = ((Math.max(1, Number(unit) || 1) - 1) * ports) + (Math.max(1, Number(port) || 1) - 1);
                return LP_PORT_COLORS[idx % LP_PORT_COLORS.length];
            };

            const byId = (id) => document.getElementById(id);
            const modelEl = byId('lp-led-model');
            const unitsEl = byId('lp-led-units');
            const portsEl = byId('lp-led-ports');
            const capacityEl = byId('lp-led-capacity');
            const maxPanelsEl = byId('lp-led-max-panels-port');
            const refreshEl = byId('lp-led-refresh');
            const patchModeEl = byId('lp-led-patch-mode');
            const bitDepthEl = byId('lp-led-bit-depth');
            const cabinetEl = byId('lp-led-cabinet');
            const cabWattsEl = byId('lp-led-cab-watts');
            const voltageEl = byId('lp-led-voltage');
            const breakerEl = byId('lp-led-breaker');
            const safetyEl = byId('lp-led-safety');
            const genBtn = byId('lp-led-generate');
            const exportBtn = byId('lp-led-export');
            const savePngBtn = byId('lp-led-save-png');
            const signalSummaryEl = byId('lp-signal-summary');
            const powerSummaryEl = byId('lp-power-summary');
            const patchSummaryEl = byId('lp-patch-summary');
            const portUsageBodyEl = byId('lp-port-usage-body');
            const patchTableBodyEl = byId('lp-patch-table-body');
            const showOverlayEl = byId('lp-led-show-overlay');
            const colorEl = byId('lp-led-overlay-color');
            const widthEl = byId('lp-led-overlay-width');
            const styleEl = byId('lp-led-overlay-style');
            const wiringGridEl = byId('lp-led-wiring-grid');
            const controllerPanelEl = byId('lp-controller-panel');
            const addControllerBtn = byId('lp-add-controller');

            const renderControllerPanel = (assignments = [], units = 1, portsPerUnit = 16, capacityPerPort = 0) => {
                if (!controllerPanelEl) return;
                const unitCount = Math.max(1, Number(units) || 1);
                const ports = Math.max(1, Number(portsPerUnit) || 1);
                const byKey = new Map((assignments || []).map(a => [`${a.unit}:${a.port}`, a]));
                const cards = Array.from({ length: unitCount }, (_, idx) => {
                    const unit = idx + 1;
                    const portBtns = Array.from({ length: ports }, (_, pIdx) => {
                        const port = pIdx + 1;
                        const key = `${unit}:${port}`;
                        const item = byKey.get(key);
                        const active = !!item;
                        const c = (item && item.portColor) ? item.portColor : '#2b2f36';
                        const text = active ? '#0b1117' : '#9ca3af';
                        return `<div title="U${unit} P${port}${active ? ` • ${item.mapName || 'Map'}` : ''}" class="h-6 rounded text-[11px] font-semibold flex items-center justify-center border ${active ? 'border-black/30' : 'border-gray-700'}" style="background:${c}; color:${text};">${port}</div>`;
                    }).join('');
                    const used = (assignments || []).filter(a => Number(a.unit) === unit).length;
                    return `
                        <div class="rounded border border-gray-700 bg-[#0f1217] p-2 mb-2">
                            <div class="flex items-center justify-between text-[11px] mb-2">
                                <span class="text-emerald-300 font-semibold">#${unit}</span>
                                <span class="text-gray-400">NovaStar ${escapeHtml(modelEl?.value || 'Controller')}</span>
                            </div>
                            <div class="grid grid-cols-4 gap-1 mb-2">${portBtns}</div>
                            <div class="text-[11px] text-gray-500">Active: ${used} | Limit: ${(Number(capacityPerPort) || 0).toLocaleString()} px</div>
                        </div>
                    `;
                }).join('');
                controllerPanelEl.innerHTML = cards || '<div class="text-gray-500 text-xs">No generated ports yet.</div>';
            };

            const buildPatchOrder = (cols, rows, maxPerPort, wiringPattern, patchMode) => {
                const pattern = String(wiringPattern || 'H-TL');
                const startCorner = pattern.split('-')[1] || 'TL';
                const defaultHoriz = pattern.startsWith('H-');
                const mode = String(patchMode || 'auto');
                const isSnake = mode === 'auto' || mode === 'snake-h' || mode === 'snake-v';
                const horizontal = (mode === 'snake-h') ? true : (mode === 'snake-v') ? false : (mode === 'row') ? true : (mode === 'column') ? false : defaultHoriz;

                const topFirst = (startCorner === 'TL' || startCorner === 'TR');
                const leftFirst = (startCorner === 'TL' || startCorner === 'BL');
                const rowOrder = Array.from({ length: rows }, (_, i) => i);
                const colOrder = Array.from({ length: cols }, (_, i) => i);
                if (!topFirst) rowOrder.reverse();
                if (!leftFirst) colOrder.reverse();

                const ordered = [];
                if (horizontal) {
                    rowOrder.forEach((row, relRow) => {
                        const dynamicCols = [...colOrder];
                        if (isSnake && relRow % 2 === 1) dynamicCols.reverse();
                        dynamicCols.forEach(col => ordered.push({ col, row }));
                    });
                } else {
                    colOrder.forEach((col, relCol) => {
                        const dynamicRows = [...rowOrder];
                        if (isSnake && relCol % 2 === 1) dynamicRows.reverse();
                        dynamicRows.forEach(row => ordered.push({ col, row }));
                    });
                }

                const patchMap = [];
                let currentPort = 1;
                let portCount = 0;
                ordered.forEach((item) => {
                    if (portCount >= maxPerPort) {
                        currentPort += 1;
                        portCount = 0;
                    }
                    patchMap.push({
                        port: currentPort,
                        cab: `[C:${item.col}, R:${item.row}]`,
                        col: item.col,
                        row: item.row,
                        sequence: portCount + 1
                    });
                    portCount += 1;
                });
                return patchMap;
            };

            const setSelectedWiringPatternLP = (val) => {
                if (!wiringGridEl) return;
                wiringGridEl.querySelectorAll('input[name="lp-led-wiring"]').forEach(r => r.checked = (r.value === val));
                wiringGridEl.querySelectorAll('label[data-pattern]').forEach(lb => lb.classList.remove('ring-2','ring-emerald-500','border-emerald-500'));
                const sel = wiringGridEl.querySelector(`label[data-pattern="${val}"]`);
                if (sel) sel.classList.add('ring-2','ring-emerald-500','border-emerald-500');
            };
            const getSelectedWiringPatternLP = () => {
                const r = wiringGridEl?.querySelector('input[name="lp-led-wiring"]:checked');
                return r ? r.value : 'H-TL';
            };
            if (wiringGridEl) wiringGridEl.querySelectorAll('input[name="lp-led-wiring"]').forEach(r => r.addEventListener('change', () => setSelectedWiringPatternLP(getSelectedWiringPatternLP())));
            setSelectedWiringPatternLP(getSelectedWiringPatternLP() || 'H-TL');

            const applyCabinetPreset = () => {
                const key = cabinetEl?.value || 'P2.6_Indoor';
                const presetsByKey = {
                    'P2.6_Indoor': engine.cabinetLibrary.P2_6_Indoor,
                    'P3.9_Outdoor': engine.cabinetLibrary.P3_9_Outdoor
                };
                const preset = presetsByKey[key];
                if (preset && cabWattsEl) cabWattsEl.value = String(preset.maxWatts);
                if (cabWattsEl) cabWattsEl.disabled = key !== 'custom';
            };

            const applyDefaults = () => {
                const preset = NOVASTAR_MODELS[modelEl?.value || 'MCTRL4K'];
                if (preset) {
                    if (portsEl) { portsEl.value = String(preset.portsPerUnit); portsEl.disabled = true; }
                    if (capacityEl) capacityEl.value = String(preset.capacityPerPort);
                } else { if (portsEl) portsEl.disabled = false; }
                if (state.lpState) state.lpState.selectedModel = modelEl?.value || 'MCTRL4K';
            };
            if (modelEl) modelEl.addEventListener('change', () => { applyDefaults(); drawLpSerpentineOverlay(); scheduleAutoRegenerateLP(); });
            if (cabinetEl) cabinetEl.addEventListener('change', applyCabinetPreset);
            applyDefaults();
            applyCabinetPreset();

            const generateLP = ({ silent = false } = {}) => {
                const ac = getActiveCanvas();
                if (!ac) { showNotification('Add at least one Output Canvas and send your map to it first.'); return; }
                const maps = Array.isArray(ac.maps) ? ac.maps : [];
                if (maps.length === 0) { showNotification('No maps on Output Canvas. Use Visualizer → Send to Output.'); return; }
                const activeProject = state.projects.find(p => p.id === state.activeProjectId);
                const projectMaps = Array.isArray(activeProject?.pixelMaps) ? activeProject.pixelMaps : [];
                const resolveSignalMap = (canvasMap) => {
                    if (!canvasMap) return null;
                    const srcId = canvasMap.sourceMapId;
                    if (srcId == null) return canvasMap;
                    const found = projectMaps.find(pm => String(pm.id) === String(srcId));
                    return found || canvasMap;
                };

                const units = Math.max(1, parseInt(unitsEl.value||'1', 10) || 1);
                const preset = NOVASTAR_MODELS[modelEl?.value || 'MCTRL4K'];
                const portsPerUnit = preset ? preset.portsPerUnit : Math.max(1, parseInt(portsEl.value||'16', 10) || 16);
                if (portsEl) { portsEl.value = String(portsPerUnit); portsEl.disabled = !!preset; }
                const capacityPerPort = Math.max(1000, parseInt(capacityEl.value||'650000', 10) || (preset?.capacityPerPort || 650000));
                const maxPanelsPerPortRaw = parseInt(maxPanelsEl?.value || '0', 10);
                const maxPanelsPerPort = isNaN(maxPanelsPerPortRaw) ? 0 : Math.max(0, maxPanelsPerPortRaw);
                const hz = refreshEl ? parseInt(refreshEl.value, 10) : 60;
                const patchMode = patchModeEl?.value || 'auto';
                const bitDepth = Math.max(8, parseInt(bitDepthEl?.value || '8', 10) || 8);
                const hzPanelsLimit = (hz === 50) ? 48 : 40;
                const voltage = Math.max(1, Number(voltageEl?.value || 230));
                const breakerAmps = Math.max(1, Number(breakerEl?.value || 16));
                const safetyMargin = Math.max(0.5, Math.min(0.95, Number(safetyEl?.value || 0.8)));
                const cabinetMaxWatts = Math.max(50, Number(cabWattsEl?.value || 160));

                const totalPorts = units * portsPerUnit;
                const assignments = [];
                const patchRows = [];
                let globalPortIdx = 1;
                const takePort = () => { const idx = globalPortIdx++; return { unit: Math.floor((idx - 1) / portsPerUnit) + 1, port: ((idx - 1) % portsPerUnit) + 1 }; };
                const getCalcs = (map) => { try { return (typeof calculateLayout === 'function') ? calculateLayout(map) : null; } catch(_) { return null; } };
                const portsExhausted = () => globalPortIdx > totalPorts;
                let totalAssignedCabinets = 0;
                let firstSignal = null;

                maps.forEach(m => {
                    if (portsExhausted()) return;
                    const signalMap = resolveSignalMap(m) || m;
                    const calcs = getCalcs(signalMap) || {};
                    const pW = Math.max(1, Math.floor(signalMap.panelResWidth || calcs.panelResWidth || 128));
                    const pH = Math.max(1, Math.floor(signalMap.panelResHeight || calcs.panelResHeight || 128));
                    const panelsX = Math.max(0, Math.floor(calcs.panelsHorizontally || 0));
                    const panelsY = Math.max(0, Math.floor(calcs.panelsVertically || 0));
                    const panelPixels = pW * pH;
                    const pixelBasedLimit = Math.floor(capacityPerPort / panelPixels);
                    if (pixelBasedLimit <= 0) { showNotification('A panel exceeds per-port pixel capacity.'); return; }
                    const effectivePanelsPerPort = Math.max(1, Math.min(pixelBasedLimit, hzPanelsLimit, (maxPanelsPerPort > 0 ? maxPanelsPerPort : Infinity)));
                    const sL = Math.max(0, Math.floor(m.cropLeft ?? m.sliceLeft ?? 0));
                    const sR = Math.max(0, Math.floor(m.cropRight ?? m.sliceRight ?? 0));
                    const sT = Math.max(0, Math.floor(m.cropTop ?? 0));
                    const sB = Math.max(0, Math.floor(m.cropBottom ?? 0));
                    const offColsLeft = Math.min(panelsX, Math.ceil(sL / pW));
                    const offColsRight = Math.min(panelsX - offColsLeft, Math.ceil(sR / pW));
                    const offRowsTop = Math.min(panelsY, Math.ceil(sT / pH));
                    const offRowsBottom = Math.min(panelsY - offRowsTop, Math.ceil(sB / pH));
                    const availCols = Math.max(0, panelsX - offColsLeft - offColsRight);
                    const availRows = Math.max(0, panelsY - offRowsTop - offRowsBottom);
                    if (availCols === 0 || availRows === 0) return;
                    const baseRelX = offColsLeft * pW - sL;
                    const baseRelY = offRowsTop * pH - sT;

                    const signal = engine.calculateSignal(pW, pH, hz, bitDepth);
                    if (!firstSignal) firstSignal = signal;
                    const modelLimit = Math.max(1, Math.floor(capacityPerPort / Math.max(1, pW * pH)));
                    const perPortLimit = Math.max(1, Math.min(signal.maxCabsPerPort, modelLimit, hzPanelsLimit, (maxPanelsPerPort > 0 ? maxPanelsPerPort : Infinity)));
                    const localPatch = buildPatchOrder(availCols, availRows, perPortLimit, getSelectedWiringPatternLP(), patchMode);
                    const localPortSet = Array.from(new Set(localPatch.map(row => row.port))).sort((a, b) => a - b);

                    localPortSet.forEach((localPort) => {
                        if (portsExhausted()) return;
                        const group = localPatch.filter(item => item.port === localPort);
                        if (!group.length) return;
                        const global = takePort();
                        const portColor = getPortColor(global.unit, global.port, portsPerUnit);
                        const minCol = Math.min(...group.map(g => g.col));
                        const maxCol = Math.max(...group.map(g => g.col));
                        const minRow = Math.min(...group.map(g => g.row));
                        const maxRow = Math.max(...group.map(g => g.row));
                        const relX = baseRelX + (minCol * pW);
                        const relY = baseRelY + (minRow * pH);
                        const w = (maxCol - minCol + 1) * pW;
                        const h = (maxRow - minRow + 1) * pH;
                        assignments.push({ unit: global.unit, port: global.port, portColor, mapId: m.id, mapName: m.name || 'Map', sourceMapId: signalMap.id, sourceMapName: signalMap.name || m.name || 'Map', relX, relY, w, h, cabinetsOnPort: group.length, cabinetsPerPortLimit: perPortLimit });

                        group.forEach((item) => {
                            totalAssignedCabinets += 1;
                            patchRows.push({
                                unit: global.unit,
                                port: global.port,
                                portColor,
                                mapName: m.name || 'Map',
                                sourceMapName: signalMap.name || m.name || 'Map',
                                cabinet: item.cab,
                                sequence: item.sequence,
                                mapId: m.id
                            });
                        });
                    });
                });

                const power = engine.calculatePower(totalAssignedCabinets, cabinetMaxWatts, voltage, breakerAmps, safetyMargin);
                if (signalSummaryEl) {
                    const cabsPerPort = firstSignal ? firstSignal.maxCabsPerPort : 0;
                    const usedLimits = assignments.map(a => Number(a.cabinetsPerPortLimit) || 0).filter(v => v > 0);
                    const minUsed = usedLimits.length ? Math.min(...usedLimits) : 0;
                    signalSummaryEl.textContent = `Signal: ${cabsPerPort} theoretical • ${minUsed || 0} effective cabs/port • ${capacityPerPort.toLocaleString()} px/port model cap`;
                }
                if (powerSummaryEl) {
                    powerSummaryEl.textContent = `Power: ${power.totalKW} kW • ${power.totalAmps} A • ${power.requiredCircuits} circuits @ ${breakerAmps}A (${Math.round(safetyMargin * 100)}%)`;
                }
                if (patchSummaryEl) {
                    const avg = assignments.length ? (totalAssignedCabinets / assignments.length) : 0;
                    patchSummaryEl.textContent = `Patch: ${totalAssignedCabinets} cabinets assigned • ${assignments.length} used ports / ${totalPorts} available • Avg ${avg.toFixed(1)} panels/port`;
                }
                if (portUsageBodyEl) {
                    portUsageBodyEl.innerHTML = assignments.length
                        ? assignments.map(a => {
                            const used = Number(a.cabinetsOnPort) || 0;
                            const limit = Math.max(1, Number(a.cabinetsPerPortLimit) || 1);
                            const pct = Math.max(0, Math.min(999, (used * 100) / limit));
                            const swatch = `<span class="inline-block w-3 h-3 rounded-full border border-white/20" style="background:${a.portColor || '#ffffff'}"></span>`;
                            return `<tr><td class="px-2 py-1">${a.unit}</td><td class="px-2 py-1">${a.port}</td><td class="px-2 py-1">${swatch}</td><td class="px-2 py-1">${escapeHtml(a.mapName || 'Map')}</td><td class="px-2 py-1">${pct.toFixed(0)}%</td></tr>`;
                        }).join('')
                        : '<tr><td class="px-2 py-2 text-gray-500" colspan="5">No panel usage data yet.</td></tr>';
                }
                if (patchTableBodyEl) {
                    const topRows = patchRows.slice(0, 200);
                    patchTableBodyEl.innerHTML = topRows.length
                        ? topRows.map(r => {
                            const swatch = `<span class="inline-block w-3 h-3 rounded-full border border-white/20" style="background:${r.portColor || '#ffffff'}"></span>`;
                            return `<tr><td class="px-2 py-1">${r.unit}</td><td class="px-2 py-1">${r.port}</td><td class="px-2 py-1">${swatch}</td><td class="px-2 py-1">${escapeHtml(r.mapName || 'Map')}</td><td class="px-2 py-1">${r.sequence}</td></tr>`;
                        }).join('')
                        : '<tr><td class="px-2 py-2 text-gray-500" colspan="5">No patch rows generated.</td></tr>';
                }

                const cfg = {
                    brand: 'novastar',
                    model: modelEl?.value || 'MCTRL4K',
                    units,
                    portsPerUnit,
                    capacityPerPort,
                    maxPanelsPerPort,
                    refreshHz: hz,
                    bitDepth,
                    cabinetMaxWatts,
                    voltage,
                    breakerAmps,
                    safetyMargin
                };
                const ac2 = getActiveCanvas();
                ac2.processorConfig = cfg;
                const overlayStyle = { color: colorEl?.value || '#ff0000', width: parseInt(widthEl?.value || '5', 10) || 5, lineStyle: styleEl?.value || 'solid', wiringPattern: getSelectedWiringPatternLP() || 'H-TL', arrowStart: false, arrowEnd: true, arrowSize: 1.2 };
                ac2.processorPatch = { assignments, patchRows, showOverlay: !!showOverlayEl?.checked, overlayStyle, powerSummary: power };
                renderControllerPanel(assignments, units, portsPerUnit, capacityPerPort);
                persistProjects();
                if (exportBtn) exportBtn.disabled = assignments.length === 0;
                const lpPdfBtn = document.getElementById('lp-led-export-pdf');
                if (lpPdfBtn) lpPdfBtn.disabled = assignments.length === 0;
                if (!silent) {
                    showNotification(assignments.length ? 'NovaStar patching generated from Output Canvas maps.' : 'No ports assigned. Increase units/ports.');
                }
            };
            let lpRegenTimer = null;
            const scheduleAutoRegenerateLP = () => {
                if (lpRegenTimer) clearTimeout(lpRegenTimer);
                lpRegenTimer = setTimeout(() => {
                    try {
                        generateLP({ silent: true });
                        drawLpSerpentineOverlay();
                        renderCanvas();
                    } catch (_) {}
                }, 180);
            };
            if (genBtn) genBtn.addEventListener('click', () => {
                try { if (showOverlayEl) showOverlayEl.checked = true; } catch(_) {}
                generateLP();
                drawLpSerpentineOverlay();
                try { renderCanvas(); } catch(_) {}
            });
            if (addControllerBtn) addControllerBtn.addEventListener('click', () => {
                const current = Math.max(1, parseInt(unitsEl?.value || '1', 10) || 1);
                if (unitsEl) unitsEl.value = String(current + 1);
                scheduleAutoRegenerateLP();
            });
            if (exportBtn) exportBtn.addEventListener('click', () => {
                try {
                    const ac = getActiveCanvas();
                    const rows = ac?.processorPatch?.patchRows || [];
                    if (!rows.length) { showNotification('Nothing to export yet.'); return; }
                    const header = ['Unit','Port','PortColor','Map','Cabinet','Sequence'];
                    const csvEsc = (v) => {
                        const s = String(v == null ? '' : v);
                        return /[,"\n\r]/.test(s) ? '"' + s.replace(/"/g,'""') + '"' : s;
                    };
                    const csv = [header.join(',')].concat(rows.map(r => [r.unit, r.port, r.portColor || '', r.mapName, r.cabinet, r.sequence].map(csvEsc).join(','))).join('\n');
                    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a'); a.href = url; a.download = `novastar_patch_${(getActiveCanvas().processorConfig?.model || 'controller')}_${Date.now()}.csv`; document.body.appendChild(a); a.click(); document.body.removeChild(a); URL.revokeObjectURL(url);
                } catch (e) { console.warn('CSV export failed', e); }
            });

            const lpPdfBtnEl = document.getElementById('lp-led-export-pdf');
            if (lpPdfBtnEl) lpPdfBtnEl.addEventListener('click', () => exportLpPatchPdf());
        if (showOverlayEl) showOverlayEl.addEventListener('change', (e) => {
            const ac = getActiveCanvas();
            if (!ac) return;
            ac.processorPatch = ac.processorPatch || {};
            ac.processorPatch.showOverlay = !!e.target.checked;
            persistProjects();
            scheduleAutoRegenerateLP();
        });

        // Live overlay redraw on LP controls
        if (colorEl) colorEl.addEventListener('input', () => { drawLpSerpentineOverlay(); scheduleAutoRegenerateLP(); });
        if (widthEl) widthEl.addEventListener('input', () => { drawLpSerpentineOverlay(); scheduleAutoRegenerateLP(); });
        if (styleEl) styleEl.addEventListener('change', () => { drawLpSerpentineOverlay(); scheduleAutoRegenerateLP(); });
        if (wiringGridEl) wiringGridEl.addEventListener('change', () => { drawLpSerpentineOverlay(); scheduleAutoRegenerateLP(); });
        const regenInputs = [unitsEl, portsEl, capacityEl, maxPanelsEl, refreshEl, patchModeEl, bitDepthEl, cabinetEl, cabWattsEl, voltageEl, breakerEl, safetyEl];
        regenInputs.forEach(el => {
            if (!el) return;
            const evt = (el.tagName === 'SELECT') ? 'change' : 'input';
            el.addEventListener(evt, () => scheduleAutoRegenerateLP());
            if (evt !== 'change') el.addEventListener('change', () => scheduleAutoRegenerateLP());
        });

        try {
            const existing = (ac && ac.processorPatch && Array.isArray(ac.processorPatch.assignments)) ? ac.processorPatch.assignments : [];
            const cfg = (ac && ac.processorConfig) ? ac.processorConfig : {};
            renderControllerPanel(existing, Number(cfg.units) || Number(unitsEl?.value || 1), Number(cfg.portsPerUnit) || Number(portsEl?.value || 16), Number(cfg.capacityPerPort) || Number(capacityEl?.value || 0));
        } catch (_) {}
        // Refit on resize to keep image fitting the preview box
        try {
            if (state.lpState && !state.lpState.resizeBound) {
                window.addEventListener('resize', () => {
                    try { fitLpCanvas(); } catch(_) {}
                    try { drawLpSerpentineOverlay(); } catch(_) {}
                });
                state.lpState.resizeBound = true;
            }
        } catch(_) {}

        // Save PNG of the current LP preview (base + overlay)
        if (savePngBtn) savePngBtn.addEventListener('click', () => {
            try {
                if (!lpCanvas || !currentMap) { showNotification('Nothing to save yet.'); return; }
                // Ensure latest overlay is drawn
                try { drawLpSerpentineOverlay(); } catch(_) {}
                try { applyDemoWatermarkToCanvas(lpCanvas); } catch(_) {}
                lpCanvas.toBlob((blob) => {
                    if (!blob) { showNotification('PNG export failed.'); return; }
                    const a = document.createElement('a');
                    const url = URL.createObjectURL(blob);
                    a.href = url;
                    const safeName = (currentMap.name || 'map').toString().replace(/[^a-z0-9_\-]+/gi, '_');
                    a.download = `led_patching_${safeName}_${Date.now()}.png`;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    URL.revokeObjectURL(url);
                }, 'image/png');
            } catch (e) {
                console.warn('Save PNG failed', e);
                showNotification('Save PNG failed');
            }
        });

        // Initial overlay draw
        drawLpSerpentineOverlay();
    };


        // Ensure Shows UI is interactive (closes overlays, enables pointer events, focuses input)
        const unlockShowsUi = () => {
            try { if (window.__debugPush) window.__debugPush('unlockShowsUi()'); } catch(_) {}
            try { if (document.activeElement && document.activeElement.blur) document.activeElement.blur(); } catch(_) {}
            try { if (typeof closeAboutModal === 'function') closeAboutModal(); } catch(_) {}
            try { if (typeof closeHelpModal === 'function') closeHelpModal(); } catch(_) {}
            try { const rm = document.getElementById('rename-project-modal'); if (rm) rm.style.display = 'none'; } catch(_) {}
            try { const im = document.getElementById('input-modal'); if (im) im.style.display = 'none'; } catch(_) {}
            try { const pd = document.getElementById('processors-db-modal'); if (pd) pd.remove(); } catch(_) {}
            try { if (mainContent && mainContent.shows) mainContent.shows.style.pointerEvents = 'auto'; } catch(_) {}
            try { document.body.style.pointerEvents = 'auto'; } catch(_) {}
            try { const sel = window.getSelection && window.getSelection(); if (sel && sel.removeAllRanges) sel.removeAllRanges(); } catch(_) {}
            try { const ni = document.getElementById('shows-new-project-name'); if (ni) { ni.disabled = false; ni.readOnly = false; ni.focus(); } } catch(_) {}
        };

        // Force a repaint/reflow on the Shows container to clear any transient overlay capture
        const forceRepaintShows = () => {
            try {
                const el = mainContent && mainContent.shows;
                if (!el) return;
                const prev = el.style.display;
                el.style.display = 'none';
                // force reflow
                void el.offsetHeight; // eslint-disable-line no-unused-expressions
                el.style.display = prev || '';
            } catch(_) {}
        };

        const renderShows = () => {
            try { if (window.__debugPush) window.__debugPush('renderShows()'); } catch(_) {}
            // Ensure status defaults exist
            (state.projects || []).forEach(p => { if (!p.status) p.status = 'draft'; });
            const project = state.projects.find(p => p.id === state.activeProjectId);
            const projectName = project ? project.name : '—';
            const draftProjects = (state.projects || []).filter(p => p.status !== 'saved');
            const savedProjects = (state.projects || []).filter(p => p.status === 'saved');
            const total = draftProjects.length;
            // Proactively close any lingering modals/backdrops that might trap focus or block clicks
            unlockShowsUi();

            const getSavedProjectColor = (projectId) => {
                const n = Math.abs(Number(projectId) || 1);
                const hue = (n * 53) % 360;
                return {
                    border: `hsl(${hue} 76% 58%)`,
                    glow: `hsla(${hue}, 80%, 60%, 0.16)`,
                    dot: `hsl(${hue} 78% 62%)`
                };
            };

            state.ui = state.ui || {};
            const existingSelection = new Set(Array.isArray(state.ui.savedSelectedProjectIds) ? state.ui.savedSelectedProjectIds : []);
            const savedIdSet = new Set(savedProjects.map(p => p.id));
            const selectedIds = new Set([...existingSelection].filter((id) => savedIdSet.has(id)));
            state.ui.savedSelectedProjectIds = [...selectedIds];
            const allSelected = savedProjects.length > 0 && selectedIds.size === savedProjects.length;

            mainContent.shows.innerHTML = `
                <div class="flex items-center justify-between bg-gray-800 px-6 py-4 rounded-t-xl shadow-lg">
                    <h2 class="text-2xl font-bold text-accent">Projects</h2>
                    <div class="text-sm text-gray-400">Active Project: <span class="text-white">${projectName}</span></div>
                </div>
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-0" style="min-height:60vh;">
                    <!-- LEFT: New / Draft Shows -->
                    <div id="shows-left-panel" class="bg-gray-800 p-5 space-y-5 border-r border-gray-700 overflow-y-auto" style="max-height:80vh;">
                        <div class="flex items-center gap-3">
                            <h3 class="text-lg font-semibold text-indigo-400">New Projects</h3>
                            <span class="text-xs px-2 py-0.5 rounded-full bg-indigo-900 text-indigo-300">${total}</span>
                            <label class="inline-flex items-center gap-2 text-xs text-gray-400 select-none">
                                <input id="project-autosave-toggle" type="checkbox" class="accent-indigo-500" ${isProjectAutosaveEnabled() ? 'checked' : ''} />
                                Auto-save every 3 min
                            </label>
                        </div>

                        <div class="space-y-2">
                            <div class="flex flex-wrap gap-2 items-center">
                                <input id="shows-new-project-name" type="text" placeholder="Enter project name" class="flex-1 min-w-[180px] bg-gray-900 border border-gray-700 rounded px-3 py-2 text-sm" />
                                <button id="shows-create-project" class="px-3 py-2 rounded bg-accent text-black text-sm">Create</button>
                            </div>
                            <p class="text-xs text-gray-500">Creates a new project with a default pixel map and output canvas.</p>
                        </div>

                        <div class="space-y-3">
                            <div class="divide-y divide-gray-700 rounded-lg overflow-hidden border border-gray-700">
                                ${draftProjects.map(p => `
                                    <div class="project-row p-3 bg-gray-900" data-id="${p.id}">
                                        <div class="flex items-center justify-between">
                                            <div>
                                                <div class="font-semibold">${p.name}</div>
                                                <div class="text-xs text-gray-400">ID: ${p.id} ${p.savedAt ? '• Saved: ' + new Date(p.savedAt).toLocaleString() : ''}</div>
                                            </div>
                                            <div class="flex gap-2">
                                                <button data-id="${p.id}" class="shows-rename px-2 py-1 rounded bg-gray-700 text-sm">Rename</button>
                                                <button data-id="${p.id}" class="shows-delete px-2 py-1 rounded bg-red-600 hover:bg-red-700 text-sm text-white">Delete</button>
                                            </div>
                                        </div>

                                        <div class="mt-3 grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
                                            <div class="md:col-span-2">
                                                <label class="block text-gray-400 mb-1">Project Name</label>
                                                <input type="text" data-field="name" value="${p.name || ''}" placeholder="e.g., Main Event" class="w-full bg-gray-800 border border-gray-700 rounded px-2 py-1" />
                                            </div>
                                            <div class="grid grid-cols-2 gap-2">
                                                <div>
                                                    <label class="block text-gray-400 mb-1">Date</label>
                                                    <input type="date" data-field="eventDate" value="${p.eventDate || ''}" class="w-full bg-gray-800 border border-gray-700 rounded px-2 py-1" />
                                                </div>
                                                <div>
                                                    <label class="block text-gray-400 mb-1">Time</label>
                                                    <input type="time" data-field="eventTime" value="${p.eventTime || ''}" class="w-full bg-gray-800 border border-gray-700 rounded px-2 py-1" />
                                                </div>
                                            </div>
                                            <div class="grid grid-cols-1 gap-2">
                                                <div>
                                                    <label class="block text-gray-400 mb-1">Location</label>
                                                    <input type="text" data-field="location" value="${p.location || ''}" placeholder="e.g., New York, NY" class="w-full bg-gray-800 border border-gray-700 rounded px-2 py-1" />
                                                </div>
                                            </div>
                                            <div>
                                                <label class="block text-gray-400 mb-1">Salesperson</label>
                                                <input type="text" data-field="salesperson" value="${p.salesperson || ''}" placeholder="e.g., Jane Doe" class="w-full bg-gray-800 border border-gray-700 rounded px-2 py-1" />
                                            </div>
                                            <div>
                                                <label class="block text-gray-400 mb-1">Venue</label>
                                                <input type="text" data-field="venue" value="${p.venue || ''}" placeholder="e.g., Madison Square Garden" class="w-full bg-gray-800 border border-gray-700 rounded px-2 py-1" />
                                            </div>
                                            <div class="md:col-span-2 flex flex-wrap gap-2 justify-end">
                                                <button data-id="${p.id}" class="shows-save-project px-3 py-1 rounded bg-accent text-black">Save</button>
                                                <button data-id="${p.id}" class="shows-close-project px-3 py-1 rounded bg-emerald-600 hover:bg-emerald-700 text-white">Close &amp; Archive</button>
                                            </div>
                                        </div>
                                    </div>
                                `).join('')}
                            </div>
                            ${total === 0 ? '<div class="text-sm text-gray-400 p-3">No draft projects. Create a new project above or reopen one from saved.</div>' : ''}
                        </div>

                        <div class="space-y-2 pt-2 border-t border-gray-700">
                            <h4 class="text-sm font-semibold text-gray-300">Backup & Restore</h4>
                            <div class="flex flex-wrap gap-2">
                                <button id="export-projects-all" class="px-3 py-1 rounded bg-gray-700 hover:bg-gray-600 text-sm">Export All</button>
                                <button id="export-project-current" class="px-3 py-1 rounded bg-gray-700 hover:bg-gray-600 text-sm">Export Current</button>
                                <input id="import-projects-file" type="file" accept="application/json,.json" class="hidden" />
                                <button id="import-projects-merge" class="px-3 py-1 rounded bg-accent text-black text-sm">Import (Merge)</button>
                                <button id="import-projects-replace" class="px-3 py-1 rounded bg-red-600 hover:bg-red-700 text-white text-sm">Import (Replace All)</button>
                            </div>
                            <p class="text-xs text-gray-500">Export a JSON backup of your projects and import later.</p>
                        </div>
                    </div>

                    <!-- RIGHT: Saved Projects -->
                    <div id="shows-right-panel" class="bg-gray-800 p-5 space-y-5 overflow-y-auto" style="max-height:80vh;">
                        <div class="flex items-center justify-between gap-3 flex-wrap">
                            <div class="flex items-center gap-3">
                                <h3 class="text-lg font-semibold text-emerald-400">Saved Projects</h3>
                                <span class="text-xs px-2 py-0.5 rounded-full bg-emerald-900 text-emerald-300">${savedProjects.length}</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <label class="inline-flex items-center gap-2 text-sm text-gray-300 select-none">
                                    <input id="saved-select-all" type="checkbox" class="accent-emerald-500" ${allSelected ? 'checked' : ''} ${savedProjects.length ? '' : 'disabled'} />
                                    Select all
                                </label>
                                <button id="saved-delete-selected" class="px-2 py-1 rounded bg-red-700 hover:bg-red-800 text-sm text-white disabled:opacity-50 disabled:cursor-not-allowed" ${selectedIds.size ? '' : 'disabled'}>Delete Selected (${selectedIds.size})</button>
                            </div>
                        </div>
                        <div class="divide-y divide-gray-700 rounded-lg overflow-hidden border border-gray-700">
                            ${savedProjects.map(p => {
                                const accent = getSavedProjectColor(p.id);
                                return `
                                <div class="project-row saved-project-row p-3 bg-gray-900" data-id="${p.id}" style="border-left:4px solid ${accent.border}; box-shadow: inset 0 0 0 1px ${accent.glow}; background: linear-gradient(90deg, ${accent.glow} 0%, rgba(17,24,39,0.95) 20%);">
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-start gap-3">
                                            <input type="checkbox" class="saved-select mt-1 accent-emerald-500" data-id="${p.id}" ${selectedIds.has(p.id) ? 'checked' : ''} />
                                            <div>
                                            <div class="font-semibold flex items-center gap-2"><span style="display:inline-block;width:8px;height:8px;border-radius:999px;background:${accent.dot};"></span>${p.name}</div>
                                            <div class="text-xs text-gray-400">ID: ${p.id} ${p.savedAt ? '• Saved: ' + new Date(p.savedAt).toLocaleString() : ''}</div>
                                            </div>
                                        </div>
                                        <div class="flex gap-2">
                                            <button data-id="${p.id}" class="saved-reopen px-2 py-1 rounded bg-indigo-600 hover:bg-indigo-700 text-white text-sm">Reopen</button>
                                            <button data-id="${p.id}" class="saved-delete px-2 py-1 rounded bg-red-600 hover:bg-red-700 text-sm text-white">Delete</button>
                                        </div>
                                    </div>
                                    <div class="mt-3 text-sm text-gray-300 grid grid-cols-1 md:grid-cols-2 gap-2">
                                        <div><span class="text-gray-400">Date/Time:</span> ${p.eventDate || '—'}${p.eventTime ? ' ' + p.eventTime : ''}</div>
                                        <div><span class="text-gray-400">Location:</span> ${p.location || '—'}</div>
                                        <div><span class="text-gray-400">Salesperson:</span> ${p.salesperson || '—'}</div>
                                        <div><span class="text-gray-400">Venue:</span> ${p.venue || '—'}</div>
                                    </div>
                                </div>
                            `;}).join('')}
                        </div>
                        ${savedProjects.length === 0 ? '<div class="text-sm text-gray-400 p-3">No saved projects yet. Mark a project as saved from the left panel.</div>' : ''}
                    </div>
                </div>
            `;
            // Ensure the container can receive pointer events and the input is focused
            unlockShowsUi();
            // double RAF to allow layout settle then unlock once more
            requestAnimationFrame(() => requestAnimationFrame(() => { unlockShowsUi(); }));

            // Create New Project wiring
            const nameInput = document.getElementById('shows-new-project-name');
            const createBtn = document.getElementById('shows-create-project');
            const doCreate = () => {
                try {
                    const name = (nameInput?.value || '').trim();
                    if (!name) { showNotification('Please enter a project name'); return; }
                    createNewProjectByName(name);
                    // Reset input for quick entry of another project
                    if (nameInput) nameInput.value = '';
                    renderShows();
                    showNotification(`Project "${name}" created`);
                } catch (err) {
                    console.warn('Create project failed', err);
                    showNotification('Could not create project');
                }
            };
            if (createBtn) {
                // Ensure button is enabled after any prior modal/actions
                try { createBtn.disabled = false; } catch(_) {}
                createBtn.addEventListener('click', doCreate);
            }
            if (nameInput) {
                try { nameInput.disabled = false; nameInput.readOnly = false; } catch(_) {}
                nameInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); doCreate(); } });
                // Focus input to keep the flow after re-render
                setTimeout(() => { try { nameInput.focus(); if (window.__debugPush) window.__debugPush('focused shows-new-project-name'); } catch(_) {} }, 0);
            }

            const autosaveToggle = document.getElementById('project-autosave-toggle');
            autosaveToggle?.addEventListener('change', (ev) => {
                setProjectAutosaveEnabled(ev.currentTarget.checked);
                showNotification(`Auto-save ${ev.currentTarget.checked ? 'enabled' : 'disabled'}`);
            });

            // Wire backup buttons
            const exportAllBtn = document.getElementById('export-projects-all');
            const exportCurrentBtn = document.getElementById('export-project-current');
            const importFileInput = document.getElementById('import-projects-file');
            const importMergeBtn = document.getElementById('import-projects-merge');
            const importReplaceBtn = document.getElementById('import-projects-replace');

            if (exportAllBtn) exportAllBtn.addEventListener('click', () => exportProjects('all'));
            if (exportCurrentBtn) exportCurrentBtn.addEventListener('click', () => exportProjects('current'));
            const openFileDialog = () => { if (importFileInput) importFileInput.click(); };
            if (importMergeBtn) importMergeBtn.addEventListener('click', () => { importMergeBtn.dataset.mode = 'merge'; openFileDialog(); });
            if (importReplaceBtn) importReplaceBtn.addEventListener('click', () => {
                importReplaceBtn.dataset.mode = 'replace';
                const proceed = window.confirm('This will replace ALL existing projects with those from the file. Continue?');
                if (!proceed) return;
                openFileDialog();
            });
            if (importFileInput) importFileInput.addEventListener('change', (e) => {
                const file = e.target.files && e.target.files[0];
                if (!file) return;
                const mode = (importReplaceBtn && importReplaceBtn.dataset.mode === 'replace') ? 'replace' : 'merge';
                const reader = new FileReader();
                reader.onload = (ev) => {
                    try {
                        const json = JSON.parse(String(ev.target.result || '{}'));
                        importProjectsFromObject(json, mode);
                        renderShows();
                    } catch (err) {
                        console.warn('Invalid JSON selected for import', err);
                        showNotification('Invalid JSON file');
                    } finally {
                        e.target.value = '';
                        if (importReplaceBtn) delete importReplaceBtn.dataset.mode;
                    }
                };
                reader.readAsText(file);
            });

            // Project list handlers (Activate/Export removed as requested)
            mainContent.shows.querySelectorAll('.shows-rename').forEach(btn => btn.addEventListener('click', (ev) => {
                const id = parseInt(ev.currentTarget.getAttribute('data-id'));
                const proj = (state.projects || []).find(p => p.id === id);
                if (!proj) return;
                openRenameProjectModal(proj);
            }));
            mainContent.shows.querySelectorAll('.shows-delete').forEach(btn => btn.addEventListener('click', async (ev) => {
                try {
                    const id = parseInt(ev.currentTarget.getAttribute('data-id'));
                    if (Number.isNaN(id)) return;
                    const proj = (state.projects || []).find(p => p.id === id);
                    const ok = await showConfirm(`Delete project "${proj?.name || 'this project'}"? This cannot be undone.`, 'Delete', 'Cancel');
                    if (!ok) return;
                    if (deleteProjectById(id)) {
                        // Defer re-render to next tick to avoid any transient locks
                        setTimeout(() => {
                            forceRepaintShows();
                            renderShows();
                            unlockShowsUi();
                            setTimeout(unlockShowsUi, 50);
                            setTimeout(unlockShowsUi, 250);
                        }, 0);
                    }
                } catch (err) {
                    console.warn('Delete project failed', err);
                    showNotification('Could not delete project');
                }
            }));

            // Helper to read and apply details from a project row
            const applyDetailsFromRow = (rowEl, proj) => {
                if (!rowEl || !proj) return;
                const read = (selector) => rowEl.querySelector(selector)?.value || '';
                const nameVal = (rowEl.querySelector('input[data-field="name"]')?.value || '').trim();
                if (nameVal) proj.name = nameVal; // keep previous name if emptied
                proj.eventDate = read('input[data-field="eventDate"]');
                proj.eventTime = read('input[data-field="eventTime"]');
                proj.location = read('input[data-field="location"]');
                proj.salesperson = read('input[data-field="salesperson"]');
                proj.venue = read('input[data-field="venue"]');
            };

            // Save project details without moving the active project out of the editable list.
            mainContent.shows.querySelectorAll('.shows-save-project').forEach(btn => btn.addEventListener('click', (ev) => {
                const id = parseInt(ev.currentTarget.getAttribute('data-id'));
                const proj = (state.projects || []).find(p => p.id === id);
                if (!proj) return;
                const row = mainContent.shows.querySelector(`.project-row[data-id="${id}"]`);
                if (!row) return;
                applyDetailsFromRow(row, proj);
                proj.savedAt = new Date().toISOString();
                persistProjects();
                showNotification(`"${proj.name}" saved`);
            }));

            mainContent.shows.querySelectorAll('.shows-close-project').forEach(btn => btn.addEventListener('click', async (ev) => {
                const id = parseInt(ev.currentTarget.getAttribute('data-id'));
                const proj = (state.projects || []).find(p => p.id === id);
                if (!proj) return;
                const row = mainContent.shows.querySelector(`.project-row[data-id="${id}"]`);
                if (row) applyDetailsFromRow(row, proj);
                const shouldArchive = await showConfirm(`Close and archive "${proj.name}"? You can reopen it later from Saved Projects.`, 'Close & Archive', 'Cancel');
                if (!shouldArchive) return;
                proj.status = 'saved';
                proj.savedAt = new Date().toISOString();
                persistProjects();
                showNotification(`"${proj.name}" archived`);
                renderShows();
            }));

            // Auto-persist changes to details on change/blur so values aren't lost
            const handleFieldPersist = (e) => {
                const input = e.target;
                if (!(input instanceof HTMLInputElement)) return;
                if (!input.matches('input[data-field]')) return;
                const row = input.closest('.project-row');
                const id = parseInt(row?.getAttribute('data-id'));
                const proj = (state.projects || []).find(p => p.id === id);
                if (!proj) return;
                const field = input.getAttribute('data-field');
                if (!field) return;
                if (field === 'name') {
                    const v = (input.value || '').trim();
                    if (!v) {
                        // prevent empty project name; revert input to current value
                        input.value = proj.name || '';
                        showNotification('Project name cannot be empty');
                        return;
                    }
                    proj.name = v;
                    // also update the header text in this row immediately
                    const header = row.querySelector('.font-semibold');
                    if (header) header.textContent = v;
                } else {
                    proj[field] = input.value || '';
                }
                persistProjects();
            };
            // Delegate to container to handle all rows' inputs; bind once to avoid stacking listeners
            if (!state.ui.showsHandlersBound) {
                mainContent.shows.addEventListener('change', handleFieldPersist);
                mainContent.shows.addEventListener('blur', handleFieldPersist, true);
                state.ui.showsHandlersBound = true;
            }

            // ---- Saved Shows panel wiring (right side) ----
            const savedPanel = document.getElementById('shows-right-panel');
            if (!savedPanel) return;

            const updateSavedSelectionUi = () => {
                const ids = new Set(Array.isArray(state.ui.savedSelectedProjectIds) ? state.ui.savedSelectedProjectIds : []);
                const rows = savedPanel.querySelectorAll('.saved-select');
                rows.forEach((cb) => {
                    const id = parseInt(cb.getAttribute('data-id'));
                    cb.checked = ids.has(id);
                });
                const allCb = savedPanel.querySelector('#saved-select-all');
                if (allCb) {
                    const total = rows.length;
                    const selected = ids.size;
                    allCb.checked = total > 0 && selected === total;
                    allCb.indeterminate = selected > 0 && selected < total;
                }
                const deleteBtn = savedPanel.querySelector('#saved-delete-selected');
                if (deleteBtn) {
                    deleteBtn.disabled = ids.size === 0;
                    deleteBtn.textContent = `Delete Selected (${ids.size})`;
                }
            };

            const selectAllEl = savedPanel.querySelector('#saved-select-all');
            selectAllEl?.addEventListener('change', (ev) => {
                const shouldSelect = !!ev.currentTarget.checked;
                state.ui.savedSelectedProjectIds = shouldSelect ? savedProjects.map(p => p.id) : [];
                updateSavedSelectionUi();
            });

            savedPanel.querySelectorAll('.saved-select').forEach(cb => cb.addEventListener('change', (ev) => {
                const id = parseInt(ev.currentTarget.getAttribute('data-id'));
                if (Number.isNaN(id)) return;
                const ids = new Set(Array.isArray(state.ui.savedSelectedProjectIds) ? state.ui.savedSelectedProjectIds : []);
                if (ev.currentTarget.checked) ids.add(id); else ids.delete(id);
                state.ui.savedSelectedProjectIds = [...ids];
                updateSavedSelectionUi();
            }));

            const deleteSelectedBtn = savedPanel.querySelector('#saved-delete-selected');
            deleteSelectedBtn?.addEventListener('click', async () => {
                const ids = [...new Set(Array.isArray(state.ui.savedSelectedProjectIds) ? state.ui.savedSelectedProjectIds : [])];
                if (!ids.length) return;
                const ok = await showConfirm(`Delete ${ids.length} selected project${ids.length > 1 ? 's' : ''}? This cannot be undone.`, 'Delete', 'Cancel');
                if (!ok) return;
                let deleted = 0;
                for (const id of ids) {
                    if (deleteProjectById(id)) deleted += 1;
                }
                state.ui.savedSelectedProjectIds = [];
                if (deleted) showNotification(`Deleted ${deleted} project${deleted > 1 ? 's' : ''}`);
                renderShows();
            });

            updateSavedSelectionUi();

            // Wire saved actions
            savedPanel.querySelectorAll('.saved-reopen').forEach(btn => btn.addEventListener('click', (ev) => {
                const id = parseInt(ev.currentTarget.getAttribute('data-id'));
                const proj = (state.projects || []).find(p => p.id === id);
                if (!proj) return;
                proj.status = 'draft';
                state.ui.savedSelectedProjectIds = (state.ui.savedSelectedProjectIds || []).filter((x) => x !== id);
                state.activeProjectId = proj.id;
                state.pdfExport.selectedProjectId = proj.id;
                persistProjects();
                showNotification(`Reopened "${proj.name}"`);
                switchTab('designer');
            }));
            savedPanel.querySelectorAll('.saved-delete').forEach(btn => btn.addEventListener('click', async (ev) => {
                const id = parseInt(ev.currentTarget.getAttribute('data-id'));
                if (Number.isNaN(id)) return;
                const proj = (state.projects || []).find(p => p.id === id);
                const ok = await showConfirm(`Delete project "${proj?.name || 'this project'}"? This cannot be undone.`, 'Delete', 'Cancel');
                if (!ok) return;
                if (deleteProjectById(id)) {
                    setTimeout(() => { renderShows(); }, 0);
                }
            }));
        };

        // Keep renderSaved as alias for backward compat
        const renderSaved = () => { renderShows(); };

        // Circular LED calculator with visual ring preview
        const renderCircularLed = () => {
            const project = state.projects.find(p => p.id === state.activeProjectId);
            const projectName = project ? project.name : '—';
            const host = mainContent['circular-led'];
            if (!host) return;

            host.innerHTML = `
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <div class="bg-gray-800 p-6 rounded-xl shadow-lg space-y-4">
                        <div class="flex items-center justify-between">
                            <h2 class="text-2xl font-bold text-accent">Circular LED Calculator</h2>
                            <div class="text-sm text-gray-400">Project: ${projectName}</div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                            <label class="text-xs text-gray-400">Outer diameter D
                                <div class="flex items-center gap-2 mt-1">
                                    <input id="cl-D" type="number" step="0.001" value="2.0" class="flex-1 bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm"/>
                                    <select id="cl-D-unit" class="w-20 bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm">
                                        <option value="m" selected>m</option>
                                        <option value="mm">mm</option>
                                    </select>
                                </div>
                            </label>
                            <label class="text-xs text-gray-400">Inner diameter d (optional)
                                <div class="flex items-center gap-2 mt-1">
                                    <input id="cl-d" type="number" step="0.001" value="0" class="flex-1 bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm"/>
                                    <select id="cl-d-unit" class="w-20 bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm">
                                        <option value="m" selected>m</option>
                                        <option value="mm">mm</option>
                                    </select>
                                </div>
                            </label>
                            <label class="text-xs text-gray-400">Pixel pitch p (mm)
                                <input id="cl-pitch" type="number" step="0.01" value="2.5" class="mt-1 w-full bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm"/>
                            </label>
                            <div class="grid grid-cols-2 gap-2">
                                <label class="text-xs text-gray-400">Panel width Wp (mm)
                                    <input id="cl-mod-w" type="number" step="1" value="500" class="mt-1 w-full bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm"/>
                                </label>
                                <label class="text-xs text-gray-400">Panel height Hp (mm)
                                    <input id="cl-mod-h" type="number" step="1" value="500" class="mt-1 w-full bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm"/>
                                </label>
                            </div>
                            <div class="grid grid-cols-2 gap-2">
                                <label class="text-xs text-gray-400">Panel pixels Px (W)
                                    <input id="cl-mod-px-w" type="number" step="1" value="128" class="mt-1 w-full bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm"/>
                                </label>
                                <label class="text-xs text-gray-400">Panel pixels Py (H)
                                    <input id="cl-mod-px-h" type="number" step="1" value="128" class="mt-1 w-full bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm"/>
                                </label>
                            </div>
                            <label class="text-xs text-gray-400">Power density Pd (W/m²)
                                <input id="cl-power-density" type="number" step="1" value="450" class="mt-1 w-full bg-gray-900 border border-gray-700 rounded px-2 py-1 text-sm"/>
                            </label>
                            <div class="flex items-center gap-4 text-sm text-gray-300 pt-2 flex-wrap">
                                <label class="inline-flex items-center gap-2"><input id="cl-show-modules" type="checkbox" class="h-4 w-4 rounded border-gray-600 bg-gray-800"/> Show panel divisions</label>
                                <label class="inline-flex items-center gap-2"><input id="cl-show-measure" type="checkbox" class="h-4 w-4 rounded border-gray-600 bg-gray-800" checked/> Show circle measurements</label>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs">
                            <div class="bg-gray-900 border border-gray-700 rounded px-3 py-2">
                                <div class="text-gray-400">Radius R</div>
                                <div id="cl-radius" class="text-gray-100 mt-1">—</div>
                            </div>
                            <div class="bg-gray-900 border border-gray-700 rounded px-3 py-2">
                                <div class="text-gray-400">Diameter D</div>
                                <div id="cl-diameter" class="text-gray-100 mt-1">—</div>
                            </div>
                            <div class="bg-gray-900 border border-gray-700 rounded px-3 py-2">
                                <div class="text-gray-400">Circumference C</div>
                                <div id="cl-circ" class="text-gray-100 mt-1">—</div>
                            </div>
                            <div class="bg-gray-900 border border-gray-700 rounded px-3 py-2">
                                <div class="text-gray-400">Inner circumference</div>
                                <div id="cl-inner-circ" class="text-gray-100 mt-1">—</div>
                            </div>
                            <div class="bg-gray-900 border border-gray-700 rounded px-3 py-2">
                                <div class="text-gray-400">Inner radius</div>
                                <div id="cl-inner-radius" class="text-gray-100 mt-1">—</div>
                            </div>
                            <div class="bg-gray-900 border border-gray-700 rounded px-3 py-2">
                                <div class="text-gray-400">Inner diameter</div>
                                <div id="cl-inner-diameter" class="text-gray-100 mt-1">—</div>
                            </div>
                            <div class="bg-gray-900 border border-gray-700 rounded px-3 py-2">
                                <div class="text-gray-400">Pixels around N0 (ceil)</div>
                                <div id="cl-Nh" class="text-gray-100 mt-1">—</div>
                            </div>
                            <div class="bg-gray-900 border border-gray-700 rounded px-3 py-2">
                                <div class="text-gray-400">Pixels vertical (full D) N9 (ceil)</div>
                                <div id="cl-Nv" class="text-gray-100 mt-1">—</div>
                            </div>
                            <div class="bg-gray-900 border border-gray-700 rounded px-3 py-2">
                                <div class="text-gray-400">Radial pixels if ring (D-d)/p</div>
                                <div id="cl-Nv-ring" class="text-gray-100 mt-1">—</div>
                            </div>
                            <div class="bg-gray-900 border border-gray-700 rounded px-3 py-2 md:col-span-2">
                                <div class="text-gray-400">Total pixels (using ring if d>0)</div>
                                <div id="cl-total-px" class="text-gray-100 mt-1">—</div>
                            </div>
                            <div class="bg-gray-900 border border-gray-700 rounded px-3 py-2">
                                <div class="text-gray-400">Panels around (phys)</div>
                                <div id="cl-mods-h-phys" class="text-gray-100 mt-1">—</div>
                            </div>
                            <div class="bg-gray-900 border border-gray-700 rounded px-3 py-2">
                                <div class="text-gray-400">Angle between panels (phys)</div>
                                <div id="cl-angle-per" class="text-gray-100 mt-1">—</div>
                            </div>
                            <div class="bg-gray-900 border border-gray-700 rounded px-3 py-2">
                                <div class="text-gray-400">Panels vertical (phys)</div>
                                <div id="cl-mods-v-phys" class="text-gray-100 mt-1">—</div>
                            </div>
                            <div class="bg-gray-900 border border-gray-700 rounded px-3 py-2">
                                <div class="text-gray-400">Panels around (by pixels)</div>
                                <div id="cl-mods-h-px" class="text-gray-100 mt-1">—</div>
                            </div>
                            <div class="bg-gray-900 border border-gray-700 rounded px-3 py-2">
                                <div class="text-gray-400">Panels vertical (by pixels)</div>
                                <div id="cl-mods-v-px" class="text-gray-100 mt-1">—</div>
                            </div>
                            <div class="bg-gray-900 border border-gray-700 rounded px-3 py-2 md:col-span-2">
                                <div class="text-gray-400">Total panels</div>
                                <div id="cl-total-mods" class="text-gray-100 mt-1">—</div>
                            </div>
                            <div class="bg-gray-900 border border-gray-700 rounded px-3 py-2">
                                <div class="text-gray-400">Area (outer/ring)</div>
                                <div id="cl-area" class="text-gray-100 mt-1">—</div>
                            </div>
                            <div class="bg-gray-900 border border-gray-700 rounded px-3 py-2">
                                <div class="text-gray-400">Power estimate</div>
                                <div id="cl-power" class="text-gray-100 mt-1">—</div>
                            </div>
                            <div class="bg-gray-900 border border-gray-700 rounded px-3 py-2 md:col-span-2">
                                <div class="text-gray-400">Recommended closest viewing distance</div>
                                <div id="cl-viewing" class="text-gray-100 mt-1">—</div>
                            </div>
                        </div>
                    </div>

                    <div class="bg-gray-800 p-6 rounded-xl shadow-lg">
                        <canvas id="cl-preview" class="w-full h-[520px] bg-gray-900 rounded" style="display:block; image-rendering: pixelated;"></canvas>
                    </div>
                </div>
            `;

            const g = (id) => document.getElementById(id);
            const out = (id, v) => { const el = g(id); if (el) el.textContent = v; };

            // compute + draw
            const update = () => {
                // inputs
                let D = Number(g('cl-D')?.value) || 0; const Du = g('cl-D-unit')?.value || 'm';
                let d = Number(g('cl-d')?.value) || 0; const du = g('cl-d-unit')?.value || 'm';
                if (Du === 'mm') D /= 1000; // convert to meters
                if (du === 'mm') d /= 1000;
                d = Math.min(d, D); if (d < 0) d = 0;
                const pitch_mm = Math.max(0.1, Number(g('cl-pitch')?.value) || 1);
                const Wm_mm = Math.max(1, Number(g('cl-mod-w')?.value) || 320);
                const Hm_mm = Math.max(1, Number(g('cl-mod-h')?.value) || 160);
                const Px = Math.max(1, Math.floor(Number(g('cl-mod-px-w')?.value) || 0));
                const Py = Math.max(1, Math.floor(Number(g('cl-mod-px-h')?.value) || 0));
                const Pd = Math.max(1, Number(g('cl-power-density')?.value) || 450);
                const showModules = !!g('cl-show-modules')?.checked;

                // geometry
                const R = Math.max(0, D/2);
                const C_m = Math.PI * D; // meters
                const C_mm = C_m * 1000;
                const innerC_m = d > 0 ? Math.PI * d : 0;

                // pixel counts
                const D_mm = D * 1000;
                const d_mm = d * 1000;
                const Nh = Math.ceil(C_mm / pitch_mm);
                const Nv_full = Math.ceil(D_mm / pitch_mm);
                const Nv_ring = d > 0 ? Math.ceil(Math.max(0, (D_mm - d_mm)) / pitch_mm) : 0;
                const N_vertical = d > 0 ? Nv_ring : Nv_full;
                const N_total = Nh * N_vertical;

                // modules (physical)
                const mods_h_phys = Math.max(0, Math.ceil(C_mm / Wm_mm));
                const modSpan_mm = d > 0 ? (D_mm - d_mm) : D_mm;
                const mods_v_phys = Math.max(0, Math.ceil(modSpan_mm / Hm_mm));

                // modules (by pixels)
                const mods_h_px = Px > 0 ? Math.ceil(Nh / Px) : 0;
                const mods_v_px = Py > 0 ? Math.ceil(N_vertical / Py) : 0;

                // choose a total modules to display (prefer pixel-based if set)
                const totalModsPhys = mods_h_phys && mods_v_phys ? mods_h_phys * mods_v_phys : 0;
                const totalModsPx = mods_h_px && mods_v_px ? mods_h_px * mods_v_px : 0;
                const totalModsOut = totalModsPx || totalModsPhys;

                // area and power
                const outerArea = Math.PI * Math.pow(D/2, 2);
                const ringArea = d > 0 ? Math.PI * (Math.pow(D/2,2) - Math.pow(d/2,2)) : outerArea;
                const powerW = ringArea * Pd;

                // outputs
                out('cl-radius', `${R.toFixed(3)} m`);
                out('cl-diameter', `${D.toFixed(3)} m (${(D*1000).toFixed(0)} mm)`);
                out('cl-circ', `${C_m.toFixed(3)} m (${C_mm.toFixed(0)} mm)`);
                out('cl-inner-circ', d>0 ? `${innerC_m.toFixed(3)} m` : '—');
                out('cl-inner-radius', d>0 ? `${(d/2).toFixed(3)} m` : '—');
                out('cl-inner-diameter', d>0 ? `${d.toFixed(3)} m (${(d*1000).toFixed(0)} mm)` : '—');
                out('cl-Nh', `${Nh.toLocaleString()} px`);
                out('cl-Nv', `${Nv_full.toLocaleString()} px`);
                out('cl-Nv-ring', d>0 ? `${Nv_ring.toLocaleString()} px` : '—');
                out('cl-total-px', `${N_total.toLocaleString()} px`);
                out('cl-mods-h-phys', mods_h_phys ? `${mods_h_phys.toLocaleString()}` : '—');
                // Angle per panel from physical width around the outer circle: theta = 2*asin((Wm/1000)/(2*R)) in radians
                let anglePerDeg = '—';
                if (R > 0 && Wm_mm > 0 && (Wm_mm/1000) < 2*R) {
                    const theta = 2 * Math.asin((Wm_mm/1000) / (2*R));
                    anglePerDeg = (theta * 180/Math.PI).toFixed(2) + '°';
                }
                out('cl-angle-per', anglePerDeg);
                out('cl-mods-v-phys', mods_v_phys ? `${mods_v_phys.toLocaleString()}` : '—');
                out('cl-mods-h-px', mods_h_px ? `${mods_h_px.toLocaleString()}` : '—');
                out('cl-mods-v-px', mods_v_px ? `${mods_v_px.toLocaleString()}` : '—');
                out('cl-total-mods', totalModsOut ? `${totalModsOut.toLocaleString()} (phys: ${totalModsPhys.toLocaleString()} | px: ${totalModsPx.toLocaleString()})` : '—');
                out('cl-area', d>0 ? `${ringArea.toFixed(3)} m² (outer ${outerArea.toFixed(3)} m²)` : `${outerArea.toFixed(3)} m²`);
                const minView = 0.3 * (pitch_mm / 1.0) / 1000; // meters
                out('cl-power', `${powerW.toFixed(0)} W @ ${Pd} W/m²`);
                out('cl-viewing', `≈ ${minView.toFixed(2)} m (rule: 0.3 × pitch_mm)`);

                // draw
                const canvas = g('cl-preview');
                if (!canvas) return;
                const ctx = canvas.getContext('2d');
                const rect = canvas.getBoundingClientRect();
                const w = Math.max(320, Math.floor(rect.width));
                const h = Math.max(320, Math.floor(rect.height));
                if (canvas.width !== w || canvas.height !== h) { canvas.width = w; canvas.height = h; }
                ctx.clearRect(0,0,w,h);

                const pad = 30;
                // scale to fit outer diameter
                const outerRadiusPx = Math.min((w - pad*2), (h - pad*2)) / 2;
                const scale = D > 0 ? outerRadiusPx / (D/2) : 1; // px per meter
                const innerRadiusPx = d > 0 ? (d/2) * scale : 0;

                const cx = w/2, cy = h/2;
                // background ring
                ctx.fillStyle = '#0b1220';
                ctx.fillRect(0,0,w,h);

                // outer circle
                ctx.strokeStyle = '#60a5fa';
                ctx.lineWidth = 2;
                ctx.beginPath();
                ctx.arc(cx, cy, outerRadiusPx, 0, Math.PI*2);
                ctx.stroke();

                // inner circle (if ring)
                if (d > 0) {
                    ctx.strokeStyle = '#334155';
                    ctx.lineWidth = 2;
                    ctx.beginPath();
                    ctx.arc(cx, cy, innerRadiusPx, 0, Math.PI*2);
                    ctx.stroke();
                    // fill ring lightly
                    const grad = ctx.createRadialGradient(cx,cy,innerRadiusPx, cx,cy,outerRadiusPx);
                    grad.addColorStop(0, 'rgba(59,130,246,0.10)');
                    grad.addColorStop(1, 'rgba(59,130,246,0.25)');
                    ctx.fillStyle = grad;
                    ctx.beginPath();
                    ctx.arc(cx, cy, outerRadiusPx, 0, Math.PI*2);
                    ctx.arc(cx, cy, innerRadiusPx, 0, Math.PI*2, true);
                    ctx.closePath();
                    ctx.fill();
                } else {
                    // filled disc
                    const grad = ctx.createRadialGradient(cx,cy,outerRadiusPx*0.1, cx,cy,outerRadiusPx);
                    grad.addColorStop(0, 'rgba(59,130,246,0.20)');
                    grad.addColorStop(1, 'rgba(59,130,246,0.35)');
                    ctx.fillStyle = grad;
                    ctx.beginPath();
                    ctx.arc(cx, cy, outerRadiusPx, 0, Math.PI*2);
                    ctx.fill();
                }

                if (showModules) {
                    // radial divisions (modules around based on physical size)
                    const around = Math.max(0, mods_h_phys);
                    if (around > 1) {
                        ctx.strokeStyle = '#93c5fd';
                        ctx.lineWidth = 1;
                        for (let k=0;k<around;k++) {
                            const a = (k/around) * Math.PI*2;
                            const x1 = cx + (innerRadiusPx>0?innerRadiusPx:0) * Math.cos(a);
                            const y1 = cy + (innerRadiusPx>0?innerRadiusPx:0) * Math.sin(a);
                            const x2 = cx + outerRadiusPx * Math.cos(a);
                            const y2 = cy + outerRadiusPx * Math.sin(a);
                            ctx.beginPath();
                            ctx.moveTo(x1,y1);
                            ctx.lineTo(x2,y2);
                            ctx.stroke();
                        }
                        // visualize angle between two adjacent panels on the outer edge
                        if (around >= 3) {
                            const a1 = 0;
                            const a2 = (1/around) * Math.PI*2;
                            const rArc = innerRadiusPx>0 ? innerRadiusPx + (outerRadiusPx-innerRadiusPx)*0.9 : outerRadiusPx*0.9;
                            ctx.strokeStyle = '#22c55e';
                            ctx.lineWidth = 2;
                            ctx.beginPath();
                            ctx.arc(cx, cy, rArc, a1, a2);
                            ctx.stroke();
                            // label at arc midpoint
                            const amid = (a1+a2)/2;
                            const tx = cx + (rArc+12) * Math.cos(amid);
                            const ty = cy + (rArc+12) * Math.sin(amid);
                            ctx.fillStyle = '#22c55e';
                            ctx.font = '12px monospace';
                            ctx.textAlign = 'center';
                            // compute same angle as above for label (deg)
                            let anglePer = 0;
                            if (R > 0 && Wm_mm > 0 && (Wm_mm/1000) < 2*R) {
                                anglePer = 2 * Math.asin((Wm_mm/1000) / (2*R)) * 180/Math.PI;
                            } else {
                                anglePer = 360/around;
                            }
                            ctx.fillText(`${anglePer.toFixed(2)}°`, tx, ty);
                        }
                        // numeric labels for each panel (limit to avoid clutter)
                        if (around <= 96) {
                            const rLabel = innerRadiusPx>0 ? (innerRadiusPx + (outerRadiusPx-innerRadiusPx)*0.55) : (outerRadiusPx*0.82);
                            ctx.fillStyle = '#e5e7eb';
                            ctx.strokeStyle = 'rgba(0,0,0,0.5)';
                            ctx.lineWidth = 3;
                            ctx.font = '11px monospace';
                            ctx.textAlign = 'center';
                            for (let k=0;k<around;k++) {
                                const aMid = ((k+0.5)/around) * Math.PI*2;
                                const tx = cx + rLabel * Math.cos(aMid);
                                const ty = cy + rLabel * Math.sin(aMid) + 3; // slight vertical offset
                                // outline for contrast
                                ctx.save();
                                ctx.miterLimit = 2;
                                ctx.lineJoin = 'round';
                                ctx.strokeText(String(k+1), tx, ty);
                                ctx.fillText(String(k+1), tx, ty);
                                ctx.restore();
                            }
                        }
                    }
                    // concentric rings (vertical modules by physical height)
                    const bands = Math.max(0, mods_v_phys);
                    if (bands > 1) {
                        ctx.strokeStyle = '#64748b';
                        ctx.lineWidth = 1;
                        const bandThicknessPx = (Hm_mm/1000) * scale;
                        for (let i=1;i<bands;i++) {
                            const r = outerRadiusPx - i*bandThicknessPx;
                            if (r <= innerRadiusPx + 1) break;
                            ctx.beginPath();
                            ctx.arc(cx, cy, r, 0, Math.PI*2);
                            ctx.stroke();
                        }
                        // summary label for counts
                        ctx.fillStyle = '#cbd5e1';
                        ctx.font = '12px monospace';
                        ctx.textAlign = 'center';
                        ctx.fillText(`${around} around × ${bands} vertical (by ${Math.round(Wm_mm)}×${Math.round(Hm_mm)} mm)`, cx, h - 8);
                    }
                }

                // measurement overlays (C, D, R) similar to the reference — for outer and inner when present
                const showMeasure = !!g('cl-show-measure')?.checked;
                if (showMeasure) {
                    ctx.save();
                    ctx.strokeStyle = '#22c55e';
                    ctx.fillStyle = '#22c55e';
                    ctx.lineWidth = 2;
                    ctx.setLineDash([4,3]);
                    // dotted circles: outer and inner (if any)
                    ctx.beginPath();
                    ctx.arc(cx, cy, outerRadiusPx*0.96, 0, Math.PI*2);
                    ctx.stroke();
                    if (d > 0) {
                        ctx.beginPath();
                        ctx.arc(cx, cy, Math.max(2, innerRadiusPx*0.96), 0, Math.PI*2);
                        ctx.stroke();
                    }
                    ctx.setLineDash([]);

                    // diameter lines (horizontal), offset slightly to avoid overlap
                    ctx.beginPath();
                    ctx.moveTo(cx - outerRadiusPx*0.95, cy);
                    ctx.lineTo(cx + outerRadiusPx*0.95, cy);
                    ctx.stroke();
                    ctx.font = '12px monospace';
                    ctx.textAlign = 'center';
                    ctx.fillText(`D: ${D.toFixed(2)} m`, cx, cy - 6);
                    if (d > 0) {
                        ctx.beginPath();
                        ctx.moveTo(cx - innerRadiusPx*0.95, cy + 14);
                        ctx.lineTo(cx + innerRadiusPx*0.95, cy + 14);
                        ctx.stroke();
                        ctx.fillText(`d: ${d.toFixed(2)} m`, cx, cy + 10);
                    }

                    // radius lines (to the right), offset for inner
                    ctx.beginPath();
                    ctx.moveTo(cx, cy);
                    ctx.lineTo(cx + outerRadiusPx*0.95, cy);
                    ctx.stroke();
                    ctx.fillText(`R: ${(D/2).toFixed(2)} m`, cx + outerRadiusPx*0.5, cy - 8);
                    if (d > 0) {
                        ctx.beginPath();
                        ctx.moveTo(cx, cy + 14);
                        ctx.lineTo(cx + innerRadiusPx*0.95, cy + 14);
                        ctx.stroke();
                        ctx.fillText(`r: ${(d/2).toFixed(2)} m`, cx + innerRadiusPx*0.5, cy + 6);
                    }

                    // circumference labels near top for both
                    ctx.textAlign = 'center';
                    ctx.fillText(`C: ${(Math.PI*D).toFixed(2)} m`, cx, cy - outerRadiusPx + 16);
                    if (d > 0) ctx.fillText(`c: ${(Math.PI*d).toFixed(2)} m`, cx, cy - innerRadiusPx + 16);
                    ctx.restore();
                }
                // labels
                ctx.fillStyle = '#d1d5db';
                ctx.font = '12px monospace';
                ctx.textAlign = 'center';
                ctx.fillText(`${(D).toFixed(2)} m outer D`, cx, pad + 12);
                if (d > 0) ctx.fillText(`${(d).toFixed(2)} m inner d`, cx, h - pad + 12);
            };

            // wire inputs
            ['cl-D','cl-D-unit','cl-d','cl-d-unit','cl-pitch','cl-mod-w','cl-mod-h','cl-mod-px-w','cl-mod-px-h','cl-power-density','cl-show-modules','cl-show-measure']
                .forEach(id => { const el = g(id); if (!el) return; el.addEventListener('input', update); el.addEventListener('change', update); });

            // initial
            setTimeout(update, 0);
        };

    const renderLedPatching = () => {
            // Restored manual arrow patching UI with processor management and capacity warnings
            const project = state.projects.find(p => p.id === state.activeProjectId);
            const activeMap = getActivePixelMap();

            mainContent.ledPatching.innerHTML = `
                <div class="bg-gray-800 p-6 rounded-xl shadow-lg grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <div class="col-span-1">
                        <div class="flex flex-col h-full gap-4">
                            <div class="flex items-center justify-between">
                                <h2 class="text-2xl font-bold text-accent">LED Patching</h2>
                                <div class="text-sm text-gray-400">Project: ${state.projects.find(p=>p.id===state.activeProjectId)?.name || '—'}</div>
                            </div>

                            <div class="bg-gray-900 rounded-lg p-4 space-y-4">
                                <h3 class="font-semibold text-accent">Processors</h3>
                                <div class="flex gap-2">
                                    <select id="novastar-processor-select" class="bg-gray-900 border border-gray-600 rounded-lg px-3 py-2 text-sm w-full">
                                        <option value="">-- Select a model to add --</option>
                                        ${Object.keys(novastarCatalog).map(cat => `
                                            <optgroup label="${cat}">
                                                ${novastarCatalog[cat].map(m => `<option value="${m}">${m}</option>`).join('')}
                                            </optgroup>
                                        `).join('')}
                                    </select>
                                    <button id="add-novastar-processor" class="px-3 py-2 rounded bg-accent text-black text-sm">Add</button>
                                </div>

                                <div id="processors-list" class="space-y-2 text-sm"></div>

                                <div id="processors-summary" class="text-sm text-gray-300"></div>

                                <div class="flex gap-2">
                                    <button id="review-processors-db" class="px-3 py-2 rounded bg-gray-700 text-sm">Review DB</button>
                                    <button id="auto-calc-processors" class="px-3 py-2 rounded bg-accent text-black text-sm">Auto-calc</button>
                                </div>
                            </div>

                            <div class="bg-gray-900 rounded-lg p-4 space-y-3">
                                <h3 class="font-semibold text-accent">Allocation & Exports</h3>
                                <div id="capacity-warnings" class="text-sm text-yellow-300"></div>
                                <div class="flex items-center gap-2">
                                    <label class="text-sm text-gray-400">Pixels per CAT6:</label>
                                    <input id="pixels-per-cable" type="number" value="${state.pdfExport && state.pdfExport.pixelsPerCable ? state.pdfExport.pixelsPerCable : 65536}" class="w-32 bg-gray-900 border border-gray-600 rounded px-2 py-1 text-sm text-gray-200" />
                                </div>
                                <div class="flex gap-2">
                                    <button id="export-alloc-csv" class="px-3 py-1 rounded bg-gray-700 text-sm">Export Alloc CSV</button>
                                    <button id="export-alloc-pdf" class="px-3 py-1 rounded bg-accent text-black text-sm">Export Alloc PDF</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-span-2">
                        <div class="bg-gray-900 rounded-lg p-4 h-full flex flex-col gap-3">
                            <div class="flex items-center justify-between">
                                <h3 class="text-xl font-semibold text-accent">Preview</h3>
                                <div class="flex items-center gap-2">
                                    <button id="toggle-arrow-mode" class="px-3 py-2 rounded bg-accent text-black text-sm">Add Arrow</button>
                                    <button id="clear-patches" class="px-3 py-2 rounded bg-gray-700 text-sm">Clear</button>
                                    <button id="auto-patch-arrows" class="px-3 py-2 rounded bg-accent text-black text-sm">Auto Patch</button>
                                    <button id="export-overlay-png" class="px-3 py-2 rounded bg-accent text-black text-sm">Overlay PNG</button>
                                    <button id="export-summary-png" class="px-3 py-2 rounded bg-gray-700 text-sm">Summary PNG</button>
                                </div>
                            </div>

                            <div class="flex-1 bg-black rounded overflow-hidden relative">
                                <canvas id="legacy-feature-canvas" style="display:block; width:100%; height:80vh; image-rendering: pixelated;"></canvas>
                                <div id="led-patch-overlay" class="absolute inset-0 pointer-events-auto"></div>
                            </div>

                            <div class="text-sm text-gray-400">Tip: Use Auto Patch to generate arrows, or Add Arrow to draw manually.</div>
                        </div>
                    </div>
                </div>
            `;

            // ensure patches storage
            if (!state.pdfExport.ledPatching) state.pdfExport.ledPatching = { patches: [] };
            if (!Array.isArray(state.pdfExport.ledPatching.patches)) state.pdfExport.ledPatching.patches = [];

            const selectEl = document.getElementById('novastar-processor-select');
            const addBtn = document.getElementById('add-novastar-processor');
            const reviewBtn = document.getElementById('review-processors-db');
            const processorsList = document.getElementById('processors-list');
            const summaryEl = document.getElementById('processors-summary');
            const previewCanvas = document.getElementById('legacy-feature-canvas');
            const overlay = document.getElementById('led-patch-overlay');
            const toggleArrowBtn = document.getElementById('toggle-arrow-mode');
            const clearBtn = document.getElementById('clear-patches');
            const warningsEl = document.getElementById('capacity-warnings');

            // draw active map into the preview canvas
            if (previewCanvas && activeMap) {
                try { drawVisualizerCanvas(previewCanvas, activeMap); } catch (e) { console.warn('drawVisualizerCanvas error', e); }
            }

            const renderProcessorsList = () => {
                processorsList.innerHTML = '';
                const procs = state.hardware && state.hardware.processors ? state.hardware.processors : [];
                procs.forEach(p => {
                    const info = processorsDB[p.model] || {};
                    const total = p.pixels || info.totalPixels || null;
                    const perPort = info.perPortEstimate || null;
                    const el = document.createElement('div');
                    el.className = 'bg-gray-800 p-2 rounded flex items-center justify-between';
                    el.innerHTML = `<div class="text-sm text-gray-200">${p.model} <span class="text-xs text-gray-400">${total ? ` — ${total.toLocaleString()} px` : ''}${perPort ? ` | per-port: ${perPort.toLocaleString()}` : ''}</span>
                                            <div class="text-xs text-gray-400 mt-1" data-breakdown-id="${p.id}"></div>
                                        </div>
                                        <div class="flex gap-2">
                                            <button data-id="${p.id}" class="remove-proc px-2 py-1 rounded bg-red-600 text-xs">Remove</button>
                                        </div>`;
                    processorsList.appendChild(el);
                });
                // summary
                const calcs = calculateLayout(activeMap) || {};
                const mapPixels = calcs.totalPixels || 0;
                const totalCapacity = (state.hardware.processors || []).reduce((s, pr) => s + (pr.pixels || (processorsDB[pr.model] && processorsDB[pr.model].totalPixels) || 0), 0);
                summaryEl.innerHTML = `Total map pixels: <strong>${mapPixels ? mapPixels.toLocaleString() : 'N/A'}</strong><br/>Total processors capacity: <strong>${totalCapacity ? totalCapacity.toLocaleString() : 'N/A'}</strong>`;

                // capacity warnings
                warningsEl.innerHTML = '';
                if (mapPixels && totalCapacity && totalCapacity < mapPixels) {
                    warningsEl.innerHTML = `<div class="text-sm text-red-400">Warning: total processor capacity is less than map pixels. You will not be able to drive the full map. (${totalCapacity.toLocaleString()} < ${mapPixels.toLocaleString()})</div>`;
                }

                // per-port allocation simulation and per-processor breakdown
                const sim = simulatePerPortAllocation(state.hardware.processors || [], mapPixels || 0);
                (sim || []).forEach(procSim => {
                    const el = processorsList.querySelector(`[data-breakdown-id="${procSim.id}"]`);
                    if (!el) return;
                    // build small inline bars (text based)
                    const portInfo = procSim.ports.map((v, idx) => {
                        const warn = procSim.perPortLimit && v > procSim.perPortLimit ? '⚠️' : '';
                        return `Port ${idx+1}: ${v.toLocaleString()} ${warn}`;
                    }).join(' | ');
                    el.textContent = portInfo;
                });

                // wire remove buttons
                const removeBtns = processorsList.querySelectorAll('.remove-proc');
                removeBtns.forEach(b => b.addEventListener('click', (ev) => {
                    const id = b.getAttribute('data-id');
                    const idx = state.hardware.processors.findIndex(pp => pp.id === id);
                    if (idx > -1) state.hardware.processors.splice(idx, 1);
                    renderLedPatching();
                }));
            };

        // Block-based per-port allocation: distribute in blocks of size `blockSize` for faster, representative mapping
        // Returns array [{ id, model, perPortLimit, ports: [usage,...] }]
        const simulatePerPortAllocation = (processors, totalPixels, blockSize = 1024) => {
            if (!processors || processors.length === 0) return [];
            // Build pool of ports
            const portPool = [];
            processors.forEach(p => {
                const info = processorsDB[p.model] || {};
                const perPortLimit = info.perPortEstimate || Math.floor((p.pixels || info.totalPixels || 65536) / (info.ethernetPorts || 1));
                const ethernetPorts = info.ethernetPorts || Math.max(1, Math.floor((p.pixels || info.totalPixels || 65536) / (perPortLimit || 1)));
                const procEntry = { id: p.id, model: p.model, perPortLimit, ethernetPorts, ports: new Array(ethernetPorts).fill(0) };
                for (let i=0;i<ethernetPorts;i++) portPool.push({ procEntry, portIndex: i });
            });

            if (portPool.length === 0) return [];

            let remaining = totalPixels;
            // allocate in blocks to reduce iterations
            const blocks = Math.max(1, Math.ceil(remaining / blockSize));
            let blockIdx = 0;
            while (remaining > 0 && blockIdx < blocks) {
                const slot = portPool[blockIdx % portPool.length];
                const alloc = Math.min(blockSize, remaining);
                slot.procEntry.ports[slot.portIndex] += alloc;
                remaining -= alloc;
                blockIdx++;
            }

            // aggregate
            const resultMap = new Map();
            portPool.forEach(p => {
                const id = p.procEntry.id;
                if (!resultMap.has(id)) resultMap.set(id, { id, model: p.procEntry.model, perPortLimit: p.procEntry.perPortLimit, ports: [...p.procEntry.ports] });
            });
            return Array.from(resultMap.values());
    };

            // Add processor
            if (addBtn && selectEl) {
                addBtn.addEventListener('click', () => {
                    const model = selectEl.value;
                    if (!model) { showNotification('Select a processor model first'); return; }
                    const id = `proc-${Date.now()}`;
                    const info = processorsDB[model] || {};
                    const pixels = info.totalPixels || 65536;
                    state.hardware.processors.push({ id, model, pixels });
                    showNotification(`Added ${model}`);
                    renderLedPatching();
                });
            }

            if (reviewBtn) reviewBtn.addEventListener('click', () => renderProcessorsDbReview());
            const pixelsPerCableInput = document.getElementById('pixels-per-cable');
            const exportOverlayBtn = document.getElementById('export-overlay-png');
            const exportSummaryBtn = document.getElementById('export-summary-png');
            const autoCalcBtn = document.getElementById('auto-calc-processors');
            const autoPatchBtn = document.getElementById('auto-patch-arrows');
            const exportAllocCsvBtn = document.getElementById('export-alloc-csv');

            if (exportOverlayBtn) exportOverlayBtn.addEventListener('click', () => exportOverlayAsPng());
            if (exportSummaryBtn) exportSummaryBtn.addEventListener('click', () => exportPatchSummaryAsPng());
            if (autoCalcBtn) autoCalcBtn.addEventListener('click', () => runAutoCalcProcessors());
            if (autoPatchBtn) autoPatchBtn.addEventListener('click', () => runAutoArrowPatching());
            if (exportAllocCsvBtn) exportAllocCsvBtn.addEventListener('click', () => exportPerPortCsv());
            if (pixelsPerCableInput) pixelsPerCableInput.addEventListener('change', () => { try { state.pdfExport.pixelsPerCable = Number(pixelsPerCableInput.value) || 65536; } catch(e){} });

            // Rendering arrows as SVG over the overlay
            const renderArrows = () => {
                if (!overlay || !previewCanvas) return;
                // Use the visible/displayed size (bounding rect) so SVG coords map directly to screen pixels
                const rect = previewCanvas.getBoundingClientRect();
                const w = rect.width || previewCanvas.width || 1;
                const h = rect.height || previewCanvas.height || 1;
                // ensure overlay sits on top visually
                try { overlay.style.zIndex = 50; } catch (e) {}

                const patches = state.pdfExport.ledPatching.patches || [];
                // SVG set to fill the overlay div; use viewBox in the same pixel space as the rect
                const svgParts = [`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${w} ${h}" preserveAspectRatio="none" width="${w}" height="${h}" style="display:block; width:100%; height:100%; pointer-events:none;">`,
                    `<defs><marker id="arrowhead" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto"><polygon points="0 0, 10 3.5, 0 7" fill="#f59e0b" /></marker></defs>`];

                patches.filter(p => p.mapId == (activeMap && activeMap.id)).forEach((p, idx) => {
                    // Use explicit null/undefined checks so valid 0 coords are preserved
                    const nx1 = (p.x1 != null) ? p.x1 : p.x;
                    const ny1 = (p.y1 != null) ? p.y1 : p.y;
                    const nx2 = (p.x2 != null) ? p.x2 : p.x;
                    const ny2 = (p.y2 != null) ? p.y2 : p.y;
                    const x1 = (Number(nx1) || 0) * w;
                    const y1 = (Number(ny1) || 0) * h;
                    const x2 = (Number(nx2) || 0) * w;
                    const y2 = (Number(ny2) || 0) * h;
                    // determine color: overloaded if flagged
                    const overloaded = !!p.overloaded;
                    const stroke = overloaded ? '#ef4444' : '#f59e0b';
                    svgParts.push(`<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="${stroke}" stroke-width="4" marker-end="url(#arrowhead)"/>`);
                    // label with port and count near mid point
                    const label = p.processorId ? `P:${p.processorModel || ''} Port:${p.portIndex != null ? p.portIndex+1 : ''} (${p.count || 1})` : `${p.count || 1}`;
                    const labelColor = overloaded ? '#ffdddd' : '#f59e0b';
                    const midX = (x1 + x2) / 2;
                    const midY = (y1 + y2) / 2 - 8;
                    svgParts.push(`<text x="${midX}" y="${midY}" fill="${labelColor}" font-size="12" text-anchor="middle">${label}</text>`);
                });
                // Render tile markers (if panel details exist on patches)
                try {
                    const calcs = (activeMap && calculateLayout(activeMap)) || null;
                    if (calcs && calcs.totalResWidth && activeMap && activeMap.panelResWidth) {
                        // tile display size in SVG pixel space
                        const tileW = (activeMap.panelResWidth / calcs.totalResWidth) * w;
                        const tileH = (activeMap.panelResHeight / calcs.totalResHeight) * h;
                        const maxMarker = Math.min(Math.max(6, Math.min(tileW, tileH) * 0.25), 18);
                        patches.filter(p => p.mapId == (activeMap && activeMap.id)).forEach((p) => {
                            if (p.panelIndex == null) return;
                            const cx = (Number(p.x2 || p.x) || 0) * w;
                            const cy = (Number(p.y2 || p.y) || 0) * h;
                            let fill = '#10b981'; // green = assigned
                            if (p.portStatus === 'portFull') fill = '#f59e0b';
                            if (p.portStatus === 'unassigned' || p.overloaded) fill = '#ef4444';
                            const strokeCol = '#111827';
                            const title = `Tile ${p.panelX},${p.panelY} - ${p.portStatus || (p.overloaded ? 'overloaded' : 'assigned')}${p.processorModel ? ' (' + p.processorModel + ' p' + (p.portIndex!=null? (p.portIndex+1):'') + ')': ''}`;
                            svgParts.push(`<circle cx="${cx}" cy="${cy}" r="${maxMarker}" fill="${fill}" stroke="${strokeCol}" stroke-width="1.5"><title>${title}</title></circle>`);
                        });
                        // Legend (small) in the top-left corner
                        const legendX = 8;
                        const legendY = 12;
                        svgParts.push(`<rect x="${legendX-6}" y="${legendY-10}" width="120" height="36" rx="4" fill="rgba(17,24,39,0.6)" stroke="rgba(255,255,255,0.04)"/>`);
                        svgParts.push(`<circle cx="${legendX+6}" cy="${legendY+4}" r="6" fill="#10b981" stroke="#111827" stroke-width="1"/>`);
                        svgParts.push(`<text x="${legendX+20}" y="${legendY+7}" fill="#d1fae5" font-size="10">Assigned</text>`);
                        svgParts.push(`<circle cx="${legendX+6}" cy="${legendY+20}" r="6" fill="#f59e0b" stroke="#111827" stroke-width="1"/>`);
                        svgParts.push(`<text x="${legendX+20}" y="${legendY+23}" fill="#fff7ed" font-size="10">Port Full</text>`);
                        svgParts.push(`<circle cx="${legendX+80}" cy="${legendY+20}" r="6" fill="#ef4444" stroke="#111827" stroke-width="1"/>`);
                        svgParts.push(`<text x="${legendX+94}" y="${legendY+23}" fill="#ffebee" font-size="10">Unassigned</text>`);
                    }
                } catch (e) { /* non-fatal */ }
                svgParts.push('</svg>');
                overlay.innerHTML = svgParts.join('');
            };

            // Arrow creation mode
            let arrowMode = false;
            let tempStart = null;
            if (toggleArrowBtn) {
                toggleArrowBtn.addEventListener('click', () => {
                    arrowMode = !arrowMode;
                    toggleArrowBtn.textContent = arrowMode ? 'Exit Arrow Mode' : 'Add Arrow';
                    tempStart = null;
                });
            }

            if (previewCanvas && overlay) {
                overlay.addEventListener('click', (ev) => {
                    if (!arrowMode) return;
                    const rect = previewCanvas.getBoundingClientRect();
                    const scaleX = previewCanvas.width / rect.width;
                    const scaleY = previewCanvas.height / rect.height;
                    const x = (ev.clientX - rect.left) * scaleX;
                    const y = (ev.clientY - rect.top) * scaleY;
                    const nx = Math.max(0, Math.min(1, x / (previewCanvas.width || rect.width)));
                    const ny = Math.max(0, Math.min(1, y / (previewCanvas.height || rect.height)));
                    if (!tempStart) {
                        tempStart = { x: nx, y: ny };
                        showNotification('Start point set — click end point to finish the arrow.');
                    } else {
                        const patch = { id: 'patch-' + Date.now(), mapId: activeMap ? activeMap.id : null, x1: tempStart.x, y1: tempStart.y, x2: nx, y2: ny, count: 1 };
                        state.pdfExport.ledPatching.patches.push(patch);
                        tempStart = null;
                        renderArrows();
                        showNotification('Arrow added');
                    }
                });
            }

            if (clearBtn) {
                clearBtn.addEventListener('click', () => {
                    state.pdfExport.ledPatching.patches = [];
                    renderArrows();
                    showNotification('Patches cleared');
                });
            }

            renderProcessorsList();
            renderArrows();
        };

                // Create arrow patches automatically by assigning tiles (panels) to processor ports.
                // This does a tile-by-tile assignment: each panel (tile) is either assigned to a port that has
                // enough per-port capacity (in pixels) or marked overloaded/unassigned. When a port reaches
                // its limit, subsequent tiles will be assigned elsewhere and tiles assigned at the moment a port
                // becomes full will be flagged so the UI can draw a different color/symbol.
                const runAutoArrowPatching = () => {
                    const activeMap = getActivePixelMap();
                    if (!activeMap) { showNotification('No active pixel map selected'); return; }
                    const calcs = calculateLayout(activeMap) || {};
                    if (!calcs.totalResWidth) { showNotification('Active map has no pixel calculation'); return; }

                    // Clear existing patches for this map
                    state.pdfExport.ledPatching.patches = state.pdfExport.ledPatching.patches.filter(p => p.mapId != activeMap.id);

                    const panelPixels = (activeMap.panelResWidth || 0) * (activeMap.panelResHeight || 0);
                    if (!panelPixels) { showNotification('Panel resolution missing (cannot assign tiles)'); return; }

                    // Build a flat list of ports with their remaining capacity
                    const ports = [];
                    state.hardware.processors = state.hardware.processors || [];
                    state.hardware.processors.forEach((proc, procIdx) => {
                        const info = processorsDB[proc.model] || {};
                        const perPortEstimate = info.perPortEstimate || Math.floor((proc.pixels || info.totalPixels || 65536) / (info.ethernetPorts || 1));
                        const ethernetPorts = info.ethernetPorts || Math.max(1, Math.floor((proc.pixels || info.totalPixels || 65536) / (perPortEstimate || 1)));
                        for (let pi = 0; pi < ethernetPorts; pi++) {
                            ports.push({ procId: proc.id, procModel: proc.model, procIdx, portIndex: pi, capacity: perPortEstimate, remaining: perPortEstimate, assignedPanels: [], full: false });
                        }
                    });

                    // Helper: find first port with enough remaining capacity for one full panel
                    const findPortForPanel = () => {
                        for (let i = 0; i < ports.length; i++) {
                            if (!ports[i].full && ports[i].remaining >= panelPixels) return ports[i];
                        }
                        return null;
                    };

                    // Iterate through tiles (panels) left-to-right, top-to-bottom and assign each tile to a port
                    let tileIndex = 0;
                    for (let y = 0; y < calcs.panelsVertically; y++) {
                        for (let x = 0; x < calcs.panelsHorizontally; x++) {
                            const posX = x * activeMap.panelResWidth;
                            const posY = y * activeMap.panelResHeight;
                            const centerX = posX + activeMap.panelResWidth / 2;
                            const centerY = posY + activeMap.panelResHeight / 2;
                            const nx = centerX / calcs.totalResWidth;
                            const ny = centerY / calcs.totalResHeight;

                            const port = findPortForPanel();
                            if (port) {
                                // Assign tile to this port
                                port.assignedPanels.push(tileIndex);
                                port.remaining -= panelPixels;
                                if (port.remaining < panelPixels) port.full = true; // becomes full (no more whole tiles)
                                const startX = 0.03; // near left edge where processors are visually located
                                // stagger startY by processor/port index so arrows don't overlap exactly
                                const totalPorts = ports.length || 1;
                                const globalPortIndex = port.procIdx * (processorsDB[port.procModel]?.ethernetPorts || 1) + port.portIndex;
                                const startY = 0.08 + 0.8 * (globalPortIndex / Math.max(1, totalPorts - 1));
                                const status = port.full ? 'portFull' : 'assigned';
                                const patch = {
                                    id: `auto-patch-${Date.now()}-${tileIndex}`,
                                    mapId: activeMap.id,
                                    x1: startX,
                                    y1: startY,
                                    x2: nx,
                                    y2: ny,
                                    count: 1,
                                    processorId: port.procId,
                                    processorModel: port.procModel,
                                    portIndex: port.portIndex,
                                    portStatus: status,
                                    panelIndex: tileIndex,
                                    panelX: x,
                                    panelY: y,
                                    panelPixels: panelPixels,
                                    overloaded: false
                                };
                                state.pdfExport.ledPatching.patches.push(patch);
                            } else {
                                // No port available for this tile -> mark overloaded/unassigned
                                const startX = 0.03;
                                const startY = 0.5; // default
                                const patch = {
                                    id: `auto-patch-unassigned-${Date.now()}-${tileIndex}`,
                                    mapId: activeMap.id,
                                    x1: startX,
                                    y1: startY,
                                    x2: nx,
                                    y2: ny,
                                    count: 1,
                                    processorId: null,
                                    processorModel: null,
                                    portIndex: null,
                                    portStatus: 'unassigned',
                                    panelIndex: tileIndex,
                                    panelX: x,
                                    panelY: y,
                                    panelPixels: panelPixels,
                                    overloaded: true
                                };
                                state.pdfExport.ledPatching.patches.push(patch);
                            }
                            tileIndex++;
                        }
                    }

                    renderLedPatching();
                    showNotification('Auto patching complete (tile-by-tile assignment)');
                };

        // Export per-port allocation as CSV
        const exportPerPortCsv = () => {
            const activeMap = getActivePixelMap();
            const calcs = calculateLayout(activeMap) || {};
            const totalPixels = calcs.totalPixels || 0;
            const sim = simulatePerPortAllocation(state.hardware.processors || [], totalPixels || 0);
            const rows = [['processorId','model','portIndex','portUsage','perPortLimit','overloaded']];
            sim.forEach(proc => {
                proc.ports.forEach((usage, idx) => {
                    rows.push([proc.id, proc.model, idx+1, usage, proc.perPortLimit || '', (proc.perPortLimit && usage > proc.perPortLimit) ? 'TRUE' : 'FALSE']);
                });
            });
            const csv = rows.map(r => r.map(c => typeof c === 'string' && c.includes(',') ? `"${c}"` : c).join(',')).join('\n');
            const blob = new Blob([csv], { type: 'text/csv' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a'); a.href = url; a.download = 'per-port-allocation.csv'; a.click();
            URL.revokeObjectURL(url);
            showNotification('Per-port allocation CSV exported');
        };

        // ── Signal Patching — 2-page PDF export ──────────────────────────────────
        // Page 1: Data / Signal patching (canvas snapshot + port assignment table)
        // Page 2: Power patching (circuit distribution + per-circuit details + summary)
        const exportLpPatchPdf = async () => {
            if (!window.jspdf || !window.jspdf.jsPDF) { showNotification('PDF library not available'); return; }
            const ac = getActiveCanvas();
            const patch = ac && ac.processorPatch ? ac.processorPatch : {};
            const cfg = ac && ac.processorConfig ? ac.processorConfig : {};
            const assignments = Array.isArray(patch.assignments) ? patch.assignments : [];
            const patchRows = Array.isArray(patch.patchRows) ? patch.patchRows : [];
            const power = patch.powerSummary || {};

            if (!assignments.length) { showNotification('Generate patching first.'); return; }

            const jsPDF = window.jspdf.jsPDF;
            const doc = new jsPDF({ orientation: 'landscape', unit: 'pt', format: 'a4' });
            const PW = doc.internal.pageSize.getWidth();   // 841.89
            const PH = doc.internal.pageSize.getHeight();  // 595.28
            const MARGIN = 36;
            const COL1 = MARGIN;

            const projectName = (() => { try { const p = getActiveProject(); return (p && p.name) ? p.name : 'Project'; } catch(_){ return 'Project'; } })();
            const mapName = (() => {
                try {
                    const id = state.lpState && state.lpState.selectedMapId;
                    const ac2 = getActiveCanvas();
                    const maps = (ac2 && Array.isArray(ac2.pixelMaps)) ? ac2.pixelMaps : (state.currentProject && Array.isArray(state.currentProject.pixelMaps) ? state.currentProject.pixelMaps : []);
                    const m = maps.find(mm => String(mm.id) === String(id)) || maps[0];
                    return m ? (m.name || 'Map') : 'Map';
                } catch(_){ return 'Map'; }
            })();

            const dateStr = new Date().toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' });

            // ── helpers ──────────────────────────────────────────────────────────
            const drawPageHeader = (title, subtitle, bgDark = '#111827') => {
                // header band
                doc.setFillColor(15, 23, 42);
                doc.rect(0, 0, PW, 44, 'F');
                doc.setTextColor(255, 255, 255);
                doc.setFont('helvetica', 'bold');
                doc.setFontSize(14);
                doc.text(title, MARGIN, 28);
                doc.setFont('helvetica', 'normal');
                doc.setFontSize(9);
                doc.setTextColor(150, 180, 210);
                doc.text(subtitle, MARGIN, 40);
                // right-side date + project
                doc.setFontSize(8);
                doc.setTextColor(120, 140, 160);
                doc.text(dateStr, PW - MARGIN, 22, { align: 'right' });
                doc.text(projectName, PW - MARGIN, 33, { align: 'right' });
                doc.setTextColor(0, 0, 0);
            };

            const drawSectionLabel = (text, x, y, color = [0, 180, 120]) => {
                doc.setFillColor(...color);
                doc.rect(x, y, 3, 10, 'F');
                doc.setFont('helvetica', 'bold');
                doc.setFontSize(9);
                doc.setTextColor(30, 30, 30);
                doc.text(text, x + 7, y + 9);
            };

            const hLine = (y, alpha = 40) => {
                doc.setDrawColor(alpha, alpha, alpha);
                doc.setLineWidth(0.5);
                doc.line(MARGIN, y, PW - MARGIN, y);
            };

            // ════════════════════════════════════════════════════════════════════
            // PAGE 1 — DATA / SIGNAL PATCHING
            // ════════════════════════════════════════════════════════════════════
            drawPageHeader(
                `LED Patching — Data Routing  |  ${escapeHtml(mapName)}`,
                `Controller: ${cfg.model || 'NovaStar'} · ${cfg.units || 1} unit(s) · ${cfg.portsPerUnit || 16} ports/unit · ${(cfg.capacityPerPort || 0).toLocaleString()} px/port · ${cfg.refreshHz || 60} Hz · ${cfg.bitDepth || 8}-bit`
            );

            // ── KPI strip ────────────────────────────────────────────────────────
            const kpiBoxes = [
                { label: 'Controller', val: cfg.model || '—' },
                { label: 'Units', val: String(cfg.units || '—') },
                { label: 'Total Ports', val: String((cfg.units || 1) * (cfg.portsPerUnit || 16)) },
                { label: 'Used Ports', val: String(assignments.length) },
                { label: 'Total Panels', val: String(patchRows.length) },
                { label: 'Capacity/Port', val: cfg.capacityPerPort ? (cfg.capacityPerPort / 1000).toFixed(0) + 'k px' : '—' },
            ];
            const kpiY = 52;
            const kpiW = (PW - MARGIN * 2) / kpiBoxes.length;
            kpiBoxes.forEach((k, i) => {
                const x = MARGIN + i * kpiW;
                doc.setFillColor(20, 30, 50);
                doc.roundedRect(x + 2, kpiY, kpiW - 4, 26, 2, 2, 'F');
                doc.setFont('helvetica', 'bold');
                doc.setFontSize(12);
                doc.setTextColor(0, 220, 150);
                doc.text(k.val, x + kpiW / 2, kpiY + 13, { align: 'center' });
                doc.setFont('helvetica', 'normal');
                doc.setFontSize(7);
                doc.setTextColor(140, 160, 180);
                doc.text(k.label, x + kpiW / 2, kpiY + 23, { align: 'center' });
            });

            let currentY = kpiY + 34;

            // ── Canvas snapshot ───────────────────────────────────────────────────
            const lpCanvasEl = document.getElementById('lp-visualizer-canvas');
            if (lpCanvasEl && lpCanvasEl.width > 0) {
                try {
                    drawLpSerpentineOverlay();
                    const snapDataUrl = lpCanvasEl.toDataURL('image/png');
                    const snapMaxH = Math.round(PH * 0.42);
                    const snapMaxW = Math.round((PW - MARGIN * 2) * 0.56);
                    const ratio = lpCanvasEl.width / lpCanvasEl.height;
                    let snapW = snapMaxW;
                    let snapH = Math.round(snapW / ratio);
                    if (snapH > snapMaxH) { snapH = snapMaxH; snapW = Math.round(snapH * ratio); }
                    drawSectionLabel('Preview (Data Patching Overlay)', COL1, currentY);
                    doc.addImage(snapDataUrl, 'PNG', COL1, currentY + 13, snapW, snapH);
                    // port assignment table to the right of canvas
                    const tableX = COL1 + snapW + 12;
                    const tableW = PW - MARGIN - tableX;
                    if (tableW > 60) {
                        drawSectionLabel('Port Assignment', tableX, currentY, [59, 130, 246]);
                        let ty = currentY + 15;
                        // header row
                        doc.setFillColor(20, 30, 50);
                        doc.rect(tableX, ty, tableW, 12, 'F');
                        doc.setFont('helvetica', 'bold');
                        doc.setFontSize(7);
                        doc.setTextColor(100, 200, 180);
                        const cols = [['U', 0.1], ['P', 0.1], ['Map', 0.4], ['Cabs', 0.2], ['Lim', 0.2]];
                        let cx = tableX + 2;
                        cols.forEach(([h, frac]) => {
                            doc.text(h, cx, ty + 9);
                            cx += tableW * frac;
                        });
                        ty += 13;
                        doc.setFont('helvetica', 'normal');
                        doc.setFontSize(6.5);
                        assignments.forEach((a, idx) => {
                            if (ty > PH - MARGIN) return;
                            doc.setFillColor(idx % 2 === 0 ? 18 : 24, idx % 2 === 0 ? 24 : 30, idx % 2 === 0 ? 40 : 48);
                            doc.rect(tableX, ty - 7, tableW, 10, 'F');
                            // colour dot
                            const pc = a.portColor || '#888888';
                            const r = parseInt(pc.slice(1,3), 16) || 100;
                            const g = parseInt(pc.slice(3,5), 16) || 100;
                            const b = parseInt(pc.slice(5,7), 16) || 100;
                            doc.setFillColor(r, g, b);
                            doc.circle(tableX + 3, ty - 2, 2.5, 'F');
                            doc.setTextColor(220, 220, 220);
                            let dx = tableX + 7;
                            const vals = [String(a.unit), String(a.port), (a.mapName || '').slice(0, 12), String(a.cabinetsOnPort || '—'), String(a.cabinetsPerPortLimit || '—')];
                            cols.forEach(([, frac], ci) => {
                                doc.text(vals[ci] || '', dx, ty + 1);
                                dx += tableW * frac;
                            });
                            ty += 10;
                        });
                    }
                    currentY += snapH + 15;
                } catch (e) { console.warn('LP PDF snapshot failed', e); currentY += 10; }
            }

            // ── Patch sequence table (bottom strip) ──────────────────────────────
            if (patchRows.length > 0 && currentY < PH - 80) {
                hLine(currentY);
                currentY += 6;
                drawSectionLabel('Patch Sequence (first 60 entries)', COL1, currentY, [234, 179, 8]);
                currentY += 14;
                const colW = [20, 20, 90, 20, 30]; // U P Map Cabinet Seq
                const headers = ['U', 'P', 'Map', 'Cab', 'Seq#'];
                // header
                doc.setFillColor(20, 30, 50);
                doc.rect(COL1, currentY - 8, PW - MARGIN * 2, 11, 'F');
                doc.setFont('helvetica', 'bold');
                doc.setFontSize(7); doc.setTextColor(100, 200, 180);
                let hx = COL1 + 2;
                headers.forEach((h, i) => { doc.text(h, hx, currentY); hx += colW[i]; });
                currentY += 5;
                doc.setFont('helvetica', 'normal');
                doc.setFontSize(6.5);
                const visibleRows = patchRows.slice(0, 60);
                visibleRows.forEach((r, idx) => {
                    if (currentY > PH - MARGIN) return;
                    doc.setFillColor(idx % 2 === 0 ? 18 : 24, idx % 2 === 0 ? 24 : 30, idx % 2 === 0 ? 40 : 48);
                    doc.rect(COL1, currentY - 6, PW - MARGIN * 2, 9, 'F');
                    doc.setTextColor(200, 200, 200);
                    let rx = COL1 + 2;
                    const vals = [String(r.unit || ''), String(r.port || ''), (r.mapName || '').slice(0, 20), String(r.cabinet || '').slice(0, 14), String(r.sequence || '')];
                    vals.forEach((v, i) => { doc.text(v, rx, currentY); rx += colW[i]; });
                    currentY += 9;
                });
                if (patchRows.length > 60) {
                    doc.setFontSize(7); doc.setTextColor(120, 120, 120);
                    doc.text(`… and ${patchRows.length - 60} more rows (export CSV for full list)`, COL1, currentY + 4);
                }
            }

            // ════════════════════════════════════════════════════════════════════
            // PAGE 2 — POWER PATCHING
            // ════════════════════════════════════════════════════════════════════
            doc.addPage();
            drawPageHeader(
                `LED Patching — Power Distribution  |  ${escapeHtml(mapName)}`,
                `Cabinet: ${cfg.cabinetType || 'LED Cabinet'} · ${cfg.cabinetMaxWatts || '—'} W/cab · ${cfg.voltage || 230} V · ${cfg.breakerAmps || 16} A breaker · ${Math.round((cfg.safetyMargin || 0.8) * 100)}% safety`
            );

            const totalCabinets = patchRows.length;
            const cabMaxW = Number(cfg.cabinetMaxWatts) || 160;
            const voltage = Number(cfg.voltage) || 230;
            const breakerAmps = Number(cfg.breakerAmps) || 16;
            const safetyMargin = Number(cfg.safetyMargin) || 0.8;
            const totalMaxKW = ((totalCabinets * cabMaxW) / 1000);
            const totalMaxAmps = (totalCabinets * cabMaxW) / Math.max(1, voltage);
            const safeAmpsPerBreaker = breakerAmps * safetyMargin;
            const requiredCircuits = Math.max(1, Math.ceil(totalMaxAmps / safeAmpsPerBreaker));
            const cabsPerCircuit = Math.max(1, Math.floor(totalCabinets / requiredCircuits));
            const leftoverCabs = totalCabinets - (cabsPerCircuit * requiredCircuits);

            // ── Power KPI strip ──────────────────────────────────────────────────
            const pkpiBoxes = [
                { label: 'Total Panels', val: String(totalCabinets), color: [0, 200, 140] },
                { label: 'W / Panel', val: `${cabMaxW} W`, color: [240, 150, 40] },
                { label: 'Total Max Power', val: `${totalMaxKW.toFixed(2)} kW`, color: [240, 70, 70] },
                { label: 'Total Max Amps', val: `${totalMaxAmps.toFixed(1)} A`, color: [200, 80, 255] },
                { label: 'Circuits Required', val: String(requiredCircuits), color: [50, 180, 255] },
                { label: 'Panels / Circuit', val: `${cabsPerCircuit}${leftoverCabs > 0 ? ` (+${leftoverCabs})` : ''}`, color: [100, 220, 100] },
            ];
            const pkpiY = 52;
            const pkpiW = (PW - MARGIN * 2) / pkpiBoxes.length;
            pkpiBoxes.forEach((k, i) => {
                const x = MARGIN + i * pkpiW;
                doc.setFillColor(20, 30, 50);
                doc.roundedRect(x + 2, pkpiY, pkpiW - 4, 26, 2, 2, 'F');
                doc.setFont('helvetica', 'bold');
                doc.setFontSize(11);
                doc.setTextColor(...k.color);
                doc.text(k.val, x + pkpiW / 2, pkpiY + 13, { align: 'center' });
                doc.setFont('helvetica', 'normal');
                doc.setFontSize(7);
                doc.setTextColor(140, 160, 180);
                doc.text(k.label, x + pkpiW / 2, pkpiY + 23, { align: 'center' });
            });

            let py = pkpiY + 34;
            hLine(py);
            py += 10;

            // ── Per-circuit breakdown table ──────────────────────────────────────
            drawSectionLabel('Power Circuit Breakdown', COL1, py, [240, 100, 60]);
            py += 16;

            // table header
            const pcols = [
                { h: 'Circuit', w: 50 },
                { h: 'Panels', w: 45 },
                { h: 'Power (kW)', w: 65 },
                { h: 'Current (A)', w: 65 },
                { h: 'Breaker (A)', w: 65 },
                { h: 'Safe Load', w: 55 },
                { h: 'Panel Sequence', w: 180 },
            ];
            const totalColW = pcols.reduce((s, c) => s + c.w, 0);

            doc.setFillColor(15, 25, 45);
            doc.rect(COL1, py - 8, totalColW, 12, 'F');
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(7.5);
            doc.setTextColor(80, 200, 180);
            let hx2 = COL1 + 3;
            pcols.forEach(col => { doc.text(col.h, hx2, py); hx2 += col.w; });
            py += 5;

            doc.setFont('helvetica', 'normal');
            doc.setFontSize(7);

            // Distribute patchRows across circuits
            // Build per-circuit array sorted by port assignment order
            const orderedCabs = [...patchRows].sort((a, b) => {
                const portA = (a.unit - 1) * 100 + a.port;
                const portB = (b.unit - 1) * 100 + b.port;
                return portA - portB || a.sequence - b.sequence;
            });

            for (let ci = 0; ci < requiredCircuits; ci++) {
                if (py > PH - 50) {
                    doc.addPage();
                    drawPageHeader(`Power Distribution (continued)  |  ${escapeHtml(mapName)}`, '');
                    py = 55;
                }
                const startIdx = ci * cabsPerCircuit;
                const endIdx = startIdx + cabsPerCircuit + (ci < leftoverCabs ? 1 : 0);
                const circuitCabs = orderedCabs.slice(startIdx, endIdx);
                const numCabs = circuitCabs.length;
                const circKW = (numCabs * cabMaxW / 1000).toFixed(3);
                const circAmps = (numCabs * cabMaxW / voltage).toFixed(2);
                const overloaded = parseFloat(circAmps) > safeAmpsPerBreaker;
                const safeLoad = Math.round((parseFloat(circAmps) / safeAmpsPerBreaker) * 100) + '%';

                // row background
                const rowH = 12;
                doc.setFillColor(ci % 2 === 0 ? 16 : 22, ci % 2 === 0 ? 22 : 28, ci % 2 === 0 ? 38 : 44);
                doc.rect(COL1, py - 7, totalColW, rowH, 'F');

                // circuit coloured left strip
                const stripColors = [[239,68,68],[245,158,11],[234,179,8],[34,197,94],[20,184,166],[6,182,212],[59,130,246],[99,102,241],[139,92,246],[236,72,153]];
                const sc = stripColors[ci % stripColors.length];
                doc.setFillColor(...sc);
                doc.rect(COL1, py - 7, 3, rowH, 'F');

                doc.setTextColor(overloaded ? 255 : 220, overloaded ? 60 : 220, overloaded ? 60 : 220);
                const seqSummary = circuitCabs.slice(0, 6).map(c => `U${c.unit}P${c.port}#${c.sequence}`).join(', ') + (circuitCabs.length > 6 ? ` +${circuitCabs.length - 6}` : '');
                const vals2 = [
                    `C${ci + 1}`,
                    String(numCabs),
                    circKW + ' kW',
                    circAmps + ' A',
                    `${breakerAmps} A`,
                    safeLoad,
                    seqSummary,
                ];
                let dx2 = COL1 + 5;
                pcols.forEach((col, ci2) => {
                    doc.text(vals2[ci2], dx2, py);
                    dx2 += col.w;
                });
                py += rowH;
            }

            py += 6;
            hLine(py);
            py += 10;

            // ── Power wiring diagram (visual grid) ───────────────────────────────
            if (py < PH - 120) {
                drawSectionLabel('Power Wiring Diagram', COL1, py, [240, 100, 60]);
                py += 14;

                const diagW = PW - MARGIN * 2;
                const cellSize = Math.max(10, Math.min(28, Math.floor(diagW / Math.max(1, Math.ceil(totalCabinets / requiredCircuits)))));
                const circuitColors = [[239,68,68],[245,158,11],[234,179,8],[34,197,94],[20,184,166],[6,182,212],[59,130,246],[99,102,241],[139,92,246],[236,72,153]];

                // Draw circuit rows
                let rowY = py;
                for (let ci = 0; ci < requiredCircuits; ci++) {
                    if (rowY > PH - 40) break;
                    const startIdx = ci * cabsPerCircuit;
                    const endIdx = startIdx + cabsPerCircuit + (ci < leftoverCabs ? 1 : 0);
                    const circuitCabs = orderedCabs.slice(startIdx, endIdx);
                    const cc = circuitColors[ci % circuitColors.length];

                    // Circuit label
                    doc.setFont('helvetica', 'bold');
                    doc.setFontSize(7);
                    doc.setTextColor(...cc);
                    doc.text(`C${ci + 1}`, COL1, rowY + cellSize * 0.6);

                    let bx = COL1 + 18;
                    // draw power line
                    doc.setDrawColor(...cc);
                    doc.setLineWidth(1.5);
                    doc.line(bx - 2, rowY + cellSize / 2, bx + Math.min(circuitCabs.length, 30) * cellSize - 2, rowY + cellSize / 2);

                    // draw cabinet boxes
                    circuitCabs.slice(0, 30).forEach((cab, idx) => {
                        if (bx + cellSize > PW - MARGIN) return;
                        doc.setFillColor(...cc.map(v => Math.min(255, v + 40)));
                        doc.setDrawColor(...cc);
                        doc.setLineWidth(0.5);
                        doc.roundedRect(bx, rowY, cellSize - 1, cellSize, 1, 1, 'FD');
                        doc.setFont('helvetica', 'normal');
                        doc.setFontSize(5);
                        doc.setTextColor(10, 10, 10);
                        const lbl = `U${cab.unit}P${cab.port}`;
                        doc.text(lbl, bx + (cellSize - 1) / 2, rowY + cellSize * 0.45, { align: 'center' });
                        doc.text(`#${cab.sequence}`, bx + (cellSize - 1) / 2, rowY + cellSize * 0.78, { align: 'center' });
                        bx += cellSize;
                    });
                    if (circuitCabs.length > 30) {
                        doc.setFont('helvetica', 'italic');
                        doc.setFontSize(6);
                        doc.setTextColor(140, 140, 140);
                        doc.text(`+${circuitCabs.length - 30} more`, bx + 2, rowY + cellSize * 0.6);
                    }
                    rowY += cellSize + 4;
                }

                py = rowY + 6;
                hLine(py);
                py += 10;
            }

            // ── Specifications block ──────────────────────────────────────────────
            if (py < PH - 70) {
                drawSectionLabel('Power Specifications', COL1, py, [100, 150, 255]);
                py += 14;
                const specRows = [
                    ['Cabinet Model', cfg.cabinetType || 'LED Cabinet', 'Max Power per Cabinet', `${cabMaxW} W`],
                    ['Supply Voltage', `${voltage} V AC`, 'Breaker Rating', `${breakerAmps} A`],
                    ['Safety Margin', `${Math.round(safetyMargin * 100)}%`, 'Safe Load per Breaker', `${safeAmpsPerBreaker.toFixed(1)} A`],
                    ['Total Panels', String(totalCabinets), 'Total Active Power', `${totalMaxKW.toFixed(2)} kW`],
                    ['Total Current', `${totalMaxAmps.toFixed(1)} A`, 'Circuits Required', String(requiredCircuits)],
                    ['Panels per Circuit', String(cabsPerCircuit), 'kW per Circuit', `${(cabsPerCircuit * cabMaxW / 1000).toFixed(3)} kW`],
                ];
                const specColW = (PW - MARGIN * 2) / 4;
                doc.setFont('helvetica', 'normal');
                doc.setFontSize(7.5);
                specRows.forEach((row, i) => {
                    const sx = COL1;
                    const ly = py + i * 14;
                    if (ly > PH - MARGIN) return;
                    doc.setFillColor(i % 2 === 0 ? 18 : 24, i % 2 === 0 ? 24 : 30, i % 2 === 0 ? 40 : 48);
                    doc.rect(sx, ly - 7, PW - MARGIN * 2, 11, 'F');
                    doc.setTextColor(120, 150, 180); doc.text(row[0], sx + 3, ly);
                    doc.setTextColor(220, 220, 220); doc.text(row[1], sx + 3 + specColW, ly);
                    doc.setTextColor(120, 150, 180); doc.text(row[2], sx + 3 + specColW * 2, ly);
                    doc.setTextColor(220, 220, 220); doc.text(row[3], sx + 3 + specColW * 3, ly);
                });
                py += specRows.length * 14 + 6;
            }

            // ── Footer note ───────────────────────────────────────────────────────
            doc.setFontSize(7);
            doc.setTextColor(100, 100, 100);
            doc.text(
                `Generated by Pixelogic · ${dateStr} · Power figures are maximums at rated wattage — actual consumption will be lower. Verify with site electrician.`,
                MARGIN, PH - 10
            );

            applyDemoWatermarkToPDF(doc);
            doc.save(`signal_patching_${(cfg.model || 'controller').replace(/\s+/g, '_')}_${Date.now()}.pdf`);
            showNotification('LED Patching PDF exported (2 pages: Data + Power)');
        };
        const exportOverlayAsPng = async () => {
            const canvas = document.getElementById('legacy-feature-canvas');
            const overlay = document.getElementById('led-patch-overlay');
            if (!canvas) { showNotification('No preview canvas available'); return; }

            // Render canvas to an offscreen canvas and draw SVG overlay on top
            try {
                const w = canvas.width;
                const h = canvas.height;
                const out = document.createElement('canvas');
                out.width = w; out.height = h;
                const ctx = out.getContext('2d');
                // draw the preview canvas
                ctx.drawImage(canvas, 0, 0, w, h);
                // draw SVG overlay by serializing and drawing as image
                if (overlay && overlay.innerHTML.trim()) {
                    const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${w}" height="${h}">` + overlay.innerHTML + `</svg>`;
                    const img = new Image();
                    const svgBlob = new Blob([svg], { type: 'image/svg+xml;charset=utf-8' });
                    const url = URL.createObjectURL(svgBlob);
                    await new Promise((res, rej) => {
                        img.onload = () => { ctx.drawImage(img, 0, 0, w, h); URL.revokeObjectURL(url); res(); };
                        img.onerror = (e) => { URL.revokeObjectURL(url); rej(e); };
                        img.src = url;
                    });
                }
                // download
                applyDemoWatermarkToCanvas(out);
                const dataUrl = out.toDataURL('image/png');
                const a = document.createElement('a'); a.href = dataUrl; a.download = 'led-patch-overlay.png'; a.click();
                showNotification('Overlay exported as PNG');
            } catch (e) {
                console.warn('exportOverlayAsPng error', e);
                showNotification('Failed to export overlay');
            }
        };

        // Export a summary image (text summary of patches + counts)
        const exportPatchSummaryAsPng = () => {
            const patches = state.pdfExport.ledPatching.patches || [];
            const activeMap = getActivePixelMap();
            const lines = [`Patch Summary - ${activeMap ? activeMap.name : 'No Map'}`, ''];
            patches.filter(p => p.mapId == (activeMap && activeMap.id)).forEach((p, i) => {
                lines.push(`${i+1}. From (${(p.x1||p.x).toFixed(2)}, ${(p.y1||p.y).toFixed(2)}) -> (${(p.x2||p.x).toFixed(2)}, ${(p.y2||p.y).toFixed(2)})  Count: ${p.count || 1}`);
            });

            // create a canvas and draw text
            const out = document.createElement('canvas');
            const width = 1000; const lineHeight = 22; const height = Math.max(200, lines.length * lineHeight + 40);
            out.width = width; out.height = height;
            const ctx = out.getContext('2d');
            ctx.fillStyle = '#0f172a'; ctx.fillRect(0, 0, width, height);
            ctx.fillStyle = '#f8fafc'; ctx.font = '16px Inter, Arial';
            lines.forEach((ln, i) => ctx.fillText(ln, 20, 30 + i * lineHeight));

            applyDemoWatermarkToCanvas(out);
            const dataUrl = out.toDataURL('image/png');
            const a = document.createElement('a'); a.href = dataUrl; a.download = 'led-patch-summary.png'; a.click();
            showNotification('Patch summary exported as PNG');
        };

        // Auto-calc a processors recommendation: greedy fill by model choices in processorsDB
        const runAutoCalcProcessors = () => {
            const activeMap = getActivePixelMap();
            const calcs = calculateLayout(activeMap) || {};
            const need = calcs.totalPixels || 0;
            if (!need) { showNotification('Active map has no pixel calculation'); return; }

            // Build candidate list from processorsDB, sorted by totalPixels desc
            const candidates = Object.keys(processorsDB).map(k => ({ model: k, info: processorsDB[k] })).filter(c => c.info && c.info.totalPixels).sort((a,b) => (b.info.totalPixels || 0) - (a.info.totalPixels || 0));
            if (candidates.length === 0) { showNotification('No processors with totalPixels in DB'); return; }

            let remaining = need;
            const result = [];
            for (const c of candidates) {
                const cap = c.info.totalPixels;
                // how many units of this model would we need at most
                const neededUnits = Math.floor(remaining / cap);
                if (neededUnits > 0) {
                    result.push({ model: c.model, count: neededUnits, perUnit: cap });
                    remaining -= neededUnits * cap;
                }
            }
            // if still remaining, pick smallest candidate that can accept the remainder
            if (remaining > 0) {
                const fit = candidates.find(c => c.info.totalPixels >= remaining);
                if (fit) result.push({ model: fit.model, count: 1, perUnit: fit.info.totalPixels });
                else {
                    // otherwise add one smallest unit available
                    const smallest = candidates[candidates.length-1];
                    result.push({ model: smallest.model, count: 1, perUnit: smallest.info.totalPixels });
                }
            }

            // present result in UI (if present)
            const outEl = document.getElementById('auto-calc-result');
            if (outEl) {
                outEl.innerHTML = `<div class="bg-gray-800 p-2 rounded text-sm">Recommendation: ${result.map(r => `${r.count}× ${r.model}`).join(', ')} <button id="apply-auto-calc" class="ml-3 px-2 py-1 rounded bg-accent text-black text-sm">Apply</button></div>`;
                const applyBtn = document.getElementById('apply-auto-calc');
                if (applyBtn) applyBtn.addEventListener('click', () => {
                    // append recommended processors
                    result.forEach(r => {
                        for (let i=0;i<r.count;i++) {
                            const id = `proc-${Date.now()}-${Math.random().toString(36).substring(2,8)}`;
                            const info = processorsDB[r.model] || {};
                            state.hardware.processors.push({ id, model: r.model, pixels: info.totalPixels || 65536 });
                        }
                    });
                    showNotification('Auto-calculated processors applied');
                    renderLedPatching();
                });
            }
        };

        // Merge saved processorsDB from localStorage if present (allow user edits to persist)
        try {
            const saved = localStorage.getItem('processorsDB');
            if (saved) {
                const parsed = JSON.parse(saved);
                if (parsed && typeof parsed === 'object') {
                    // shallow-merge: prefer saved values when present
                    Object.keys(parsed).forEach(k => { processorsDB[k] = Object.assign({}, processorsDB[k] || {}, parsed[k]); });
                }
            }
        } catch (e) { console.warn('Could not load processorsDB from localStorage', e); }

        // Render a simple modal to review/edit processorsDB entries
        const renderProcessorsDbReview = () => {
            const rows = Object.keys(processorsDB).map(key => {
                const p = processorsDB[key] || {};
                return `
                    <tr data-key="${key}" class="border-b border-gray-700">
                        <td class="px-2 py-1 text-sm text-gray-200">${p.model || key}</td>
                        <td class="px-2 py-1"><input data-field="totalPixels" type="number" value="${p.totalPixels || ''}" class="w-32 bg-gray-800 text-sm text-gray-200 border border-gray-700 rounded px-2 py-1"/></td>
                        <td class="px-2 py-1"><input data-field="ethernetPorts" type="number" value="${p.ethernetPorts || ''}" class="w-24 bg-gray-800 text-sm text-gray-200 border border-gray-700 rounded px-2 py-1"/></td>
                        <td class="px-2 py-1"><input data-field="optPorts" type="number" value="${p.optPorts || ''}" class="w-24 bg-gray-800 text-sm text-gray-200 border border-gray-700 rounded px-2 py-1"/></td>
                        <td class="px-2 py-1"><input data-field="perPortEstimate" type="number" value="${p.perPortEstimate || ''}" class="w-32 bg-gray-800 text-sm text-gray-200 border border-gray-700 rounded px-2 py-1"/></td>
                        <td class="px-2 py-1 text-xs text-gray-400">${p.source ? `<a href="${p.source}" target="_blank" class="underline">spec</a>` : ''}</td>
                    </tr>
                `;
            }).join('');

            const modalHtml = `
                <div id="processors-db-modal" class="fixed inset-0 flex items-center justify-center z-50">
                    <div class="absolute inset-0 bg-black bg-opacity-60"></div>
                    <div class="bg-gray-800 rounded-lg p-4 max-w-4xl w-full z-60">
                        <div class="flex justify-between items-center mb-3">
                            <h3 class="text-lg font-semibold">Review processors DB</h3>
                            <div class="flex gap-2">
                                <button id="processors-db-cancel" class="px-3 py-1 rounded bg-gray-700 text-sm">Cancel</button>
                                <button id="processors-db-save" class="px-3 py-1 rounded bg-accent text-black text-sm">Save</button>
                            </div>
                        </div>
                        <div class="text-sm text-gray-400 mb-2">Edit values and click "Auto-calc" to compute per-port estimate from totalPixels and ethernetPorts.</div>
                        <div class="overflow-auto max-h-80">
                            <table class="w-full text-left text-sm">
                                <thead class="text-xs text-gray-400 border-b border-gray-700">
                                    <tr>
                                        <th class="px-2 py-1">Model</th>
                                        <th class="px-2 py-1">Total Pixels</th>
                                        <th class="px-2 py-1">Ethernet Ports</th>
                                        <th class="px-2 py-1">Optical Ports</th>
                                        <th class="px-2 py-1">Per-Port Est.</th>
                                        <th class="px-2 py-1">Actions</th>
                                        <th class="px-2 py-1">Source</th>
                                    </tr>
                                </thead>
                                <tbody class="text-gray-200">${rows}</tbody>
                            </table>
                        </div>
                    </div>
                </div>
            `;

            // append modal to body
            const container = document.createElement('div');
            container.innerHTML = modalHtml;
            document.body.appendChild(container);

            const modal = document.getElementById('processors-db-modal');
            const saveBtn = document.getElementById('processors-db-save');
            const cancelBtn = document.getElementById('processors-db-cancel');

            cancelBtn.addEventListener('click', () => { modal.remove(); });

            // Inline action handlers: Auto-calc per-row and validation
            modal.querySelectorAll('tbody tr').forEach(r => {
                const key = r.getAttribute('data-key');
                const autoBtn = document.createElement('button');
                autoBtn.textContent = 'Auto-calc';
                autoBtn.className = 'px-2 py-1 rounded bg-gray-700 text-xs text-white';
                const actionsCell = r.querySelector('td:last-child').previousElementSibling;
                if (actionsCell) actionsCell.appendChild(autoBtn);

                autoBtn.addEventListener('click', () => {
                    const totalInput = r.querySelector('input[data-field="totalPixels"]');
                    const ethInput = r.querySelector('input[data-field="ethernetPorts"]');
                    const perPortInput = r.querySelector('input[data-field="perPortEstimate"]');
                    const total = Number(totalInput.value) || 0;
                    const eth = Number(ethInput.value) || 0;
                    if (total > 0 && eth > 0) {
                        perPortInput.value = Math.floor(total / eth);
                        perPortInput.classList.remove('border-red-500');
                    } else {
                        showNotification('Provide totalPixels and ethernetPorts to auto-calc');
                    }
                });

                // simple inline validation on change
                r.querySelectorAll('input').forEach(inp => {
                    inp.addEventListener('input', () => {
                        const val = inp.value;
                        if (val !== '' && (!/^-?\d+$/.test(val) || Number(val) < 0)) {
                            inp.classList.add('border-red-500');
                        } else {
                            inp.classList.remove('border-red-500');
                        }
                    });
                });
            });

            saveBtn.addEventListener('click', () => {
                // Validate before saving
                let valid = true;
                const rows = modal.querySelectorAll('tbody tr');
                rows.forEach(r => {
                    const key = r.getAttribute('data-key');
                    if (!key) return;
                    const obj = processorsDB[key] || {};
                    ['totalPixels','ethernetPorts','optPorts','perPortEstimate'].forEach(field => {
                        const input = r.querySelector(`input[data-field="${field}"]`);
                        let val = input ? input.value.trim() : '';
                        if (val === '') { obj[field] = null; return; }
                        if (!/^-?\d+$/.test(val) || Number(val) < 0) { valid = false; input.classList.add('border-red-500'); }
                        else { obj[field] = Number(val); input.classList.remove('border-red-500'); }
                    });
                    processorsDB[key] = obj;
                });
                if (!valid) { showNotification('Fix validation errors before saving'); return; }
                // persist
                try { localStorage.setItem('processorsDB', JSON.stringify(processorsDB)); showNotification('processorsDB saved'); } catch (e) { console.warn('Could not save processorsDB', e); showNotification('Could not save processorsDB'); }
                modal.remove();
            });
        };

    const formatPixelMapName = (number) => `Pixel Map_${String(number).padStart(2, '0')}`;
    const formatOutputCanvasName = (number) => `Output Canvas_${String(number).padStart(2, '0')}`;

    const createNewPixelMapObject = (number) => {
            const mapId = Date.now() + Math.random();
            // Sensible defaults so a brand-new map is immediately visible
            const map = {
                id: mapId,
                name: formatPixelMapName(number),
                zoom: 1,
                // Default screen and panel specs (2m x 2m, 500mm tiles at 128x128)
                    screenWidthValue: 2,
                    screenHeightValue: 2,
                screenDimensionsUnit: 'm',
                panelWidthMm: 500,
                panelHeightMm: 500,
                panelDimensionsUnit: 'mm',
                panelResWidth: 128,
                panelResHeight: 128,
                // Edge strip removed
                panels: [],
                // Wall shape: rectangle (default) or a masked shape (circle/ellipse/triangle/diamond/hexagon/cross/custom)
                shape: { type: 'rectangle', circleMode: 'diameter', circleValue: '' },
                visualStyle: 'checker',
                gradient: { type: 'linear', palette: 'Custom', angle: 90, colors: ['#6366f1', '#ec4899'] },
                checkerColors: ['#4b5563', '#1f2937'],
                checkerPalette: 'Classic',
                numbering: { style: 'sequential', color: '#ffffff', fontSize: 25 },
                border: { color: 'rgba(255, 255, 255, 0.2)', thickness: 2, style: 'solid' },
                details: {
                    // Defaults: no personal details; info overlay disabled
                    info: { enabled: true, position: 'bottom-right', orientation: 'normal', fontSizeMode: 'auto', fontScale: 100, fontSize: 48, lineSpacing: 100, bgTransparent: true, backgroundColor: '#000000', fontFamily: 'Arial', displayMode: 'box', annotationPanelInitialized: true, annotationFontPixelsInitialized: true, showScreenName: true, showResolution: true, showLedPitch: true, showAspectRatio: true, showBorder: true, badgeEnabled: false, badgeSize: 30, badgeOpacity: 80, badgeFillColor: '#000000', badgeShadow: true, badgeShadowBlur: 20, badgeShadowOffsetY: 12, badgeStroke: true, badgeStrokeWidth: 3, badgeTextScale: 50, badgeLineSpacing: 50, badgeIncludeMetrics: false, badgeText: '', badgeGradientEnabled: false, badgeGradientColor1: '#111827', badgeGradientColor2: '#374151', badgeGradientAngle: 90, badgeBorderGradientEnabled: false, badgeBorderGradientColor1: '#93c5fd', badgeBorderGradientColor2: '#a78bfa', badgeBorderGradientAngle: 90, badge3dPreset: 'medium' },
                    circle: { enabled: false, radius: 100, style: 'solid', gradientEnabled: false, gradientColor1: '#ffffff', gradientColor2: '#60a5fa', gradientAngle: 90, shadowEnabled: false, shadowBlur: 10, shadowOffsetY: 4 },
                    cross: { enabled: false, style: 'solid', gradientEnabled: false, gradientColor1: '#ffffff', gradientColor2: '#60a5fa', gradientAngle: 90, shadowEnabled: false, shadowBlur: 10, shadowOffsetY: 4 },
                    corners: { enabled: false },
                    cornerCircles: { enabled: false, radius: 8, style: 'solid', gradientEnabled: false, gradientColor1: '#ffffff', gradientColor2: '#60a5fa', gradientAngle: 90, shadowEnabled: false, shadowBlur: 10, shadowOffsetY: 4 },
                    coords: { enabled: false, fontSize: 100 },
                    colorBars: { enabled: false, preset: 'smpte', orientation: 'horizontal', position: 'center', heightPercent: 30, lengthPercent: 60, opacity: 100, offsetXPercent: 0, offsetYPercent: 0 },
                    logo: { enabled: false, pixelLogicEnabled: false, src: null, imageObject: null, position: 'center', size: 50, opacity: 100 },
                    shared: { color: '#ffffff', thickness: 5 }
                }
            };
            // Pre-initialize panels to all enabled using current specs
            try {
                const calcs = typeof calculateLayout === 'function' ? calculateLayout(map) : null;
                map.panels = Array((calcs && calcs.totalPanels) || 0).fill(true);
            } catch (e) { /* fallback to empty panels if calc not available yet */ }
            return map;
        };

        const saveProject = () => {
            const project = state.projects.find(p => p.id === state.activeProjectId);
            if (project) {
                project.savedAt = new Date().toISOString();
                // A deep copy is needed for saving to local storage or a database in a real app
                showNotification(`Project "${project.name}" saved!`);
                persistProjects();
            }
        };

        const loadProject = (id) => {
            state.activeProjectId = id;
            state.pdfExport.selectedProjectId = id;
            persistProjects();

        };

        // Create a new project with a given name and sensible defaults
        const createNewProjectByName = (name) => {
            const now = new Date().toISOString();
            // Create a default pixel map
            const map = createNewPixelMapObject(1);
            Object.assign(map, {
                id: Date.now() + Math.random(),
                name: formatPixelMapName(1),
                screenWidthValue: 2,
                screenHeightValue: 2,
                screenDimensionsUnit: 'm',
                tilesWide: 4,
                tilesHigh: 4,
                panelWidthMm: 500,
                panelHeightMm: 500,
                panelDimensionsUnit: 'mm',
                panelResWidth: 128,
                panelResHeight: 128,
                details: {
                    ...map.details,
                    // Default to pixel map details only; no personal contact info
                    info: { ...map.details.info, enabled: true, position: 'top-left', fontSize: 50, bgTransparent: false, fontFamily: 'Inter' },
                },
            });
            const calcs = calculateLayout(map);
            map.panels = Array(calcs.totalPanels || 0).fill(true);

            // Default canvas
            const firstCanvas = {
                id: Date.now() + 2,
                name: formatOutputCanvasName(1),
                width: 3840,
                height: 2160,
                maps: []
            };

            // Compose project
            const newProject = {
                id: Date.now() + Math.floor(Math.random() * 100000),
                name: name || `Show ${((state.projects||[]).length + 1)}`,
                createdAt: now,
                savedAt: now,
                status: 'draft',
                eventDate: '',
                eventTime: '',
                location: '',
                salesperson: '',
                client: '',
                venue: '',
                pixelMaps: [map],
                activePixelMapId: map.id,
                canvases: [firstCanvas],
                activeCanvasId: firstCanvas.id
            };

            state.projects = state.projects || [];
            state.projects.push(newProject);
            state.activeProjectId = newProject.id;
            state.pdfExport.selectedProjectId = newProject.id;
            newProject.effectsPresets = (typeof getGlobalAnnotationPresets === 'function' ? getGlobalAnnotationPresets() : []);
            persistProjects();
            return newProject;
        };

        // Delete a project by id with confirmation and safe active selection fallback
        const deleteProjectById = (id) => {
            try { if (window.__debugPush) window.__debugPush(`deleteProjectById(${id}) called`); } catch(_) {}
            const idx = (state.projects || []).findIndex(p => p.id === id);
            if (idx === -1) { showNotification('Project not found'); return false; }
            const proj = state.projects[idx];

            state.projects.splice(idx, 1);

            if (state.activeProjectId === id) {
                state.activeProjectId = state.projects[0]?.id ?? null;
            }
            if (!state.projects.some(p => p.id === state.pdfExport.selectedProjectId)) {
                state.pdfExport.selectedProjectId = state.activeProjectId || (state.projects[0]?.id ?? null);
            }

            try { persistProjects(); } catch(e) { if (window.__debugPush) window.__debugPush(`persistProjects error: ${e.message}`); }
            showNotification(`Project "${proj.name}" deleted`);
            try { if (window.__debugPush) window.__debugPush(`after delete: projects=${(state.projects||[]).length}, active=${state.activeProjectId}`); } catch(_) {}
            return true;
        };

        // Helper: open the dedicated Rename Project modal reliably
        const openRenameProjectModal = (proj) => {
            if (!proj) return;
            const modal = document.getElementById('rename-project-modal');
            const input = document.getElementById('rename-project-input');
            const saveBtn = document.getElementById('rename-project-save');
            const cancelBtn = document.getElementById('rename-project-cancel');
            if (!modal || !input || !saveBtn || !cancelBtn) { console.warn('Rename modal elements missing'); return; }

            // Show modal
            try { modal.classList.add('flex'); } catch (e) {}
            modal.style.display = 'flex';
            input.value = proj.name || '';
            setTimeout(() => { try { input.focus(); input.select(); } catch(e){} }, 0);

            let onKeyDownHandler = null;
            const cleanup = () => {
                modal.style.display = 'none';
                // Remove one-off listeners by replacing nodes
                const s2 = saveBtn.cloneNode(true);
                const c2 = cancelBtn.cloneNode(true);
                saveBtn.replaceWith(s2);
                cancelBtn.replaceWith(c2);
                // Detach keydown handler from input if attached
                if (onKeyDownHandler) {
                    try { input.removeEventListener('keydown', onKeyDownHandler); } catch (_) {}
                    onKeyDownHandler = null;
                }
            };

            const onSave = () => {
                const val = (input.value || '').trim();
                if (!val) { showNotification('Project name cannot be empty'); return; }
                proj.name = val;
                persistProjects();
                try {
                    if (state.activeTab === 'shows') renderShows();
                    else if (state.activeTab === 'saved') renderShows();
                } catch(e) {}
                cleanup();
                showNotification('Project renamed');
            };
            const onCancel = () => cleanup();

            // Re-acquire new references after clone to attach fresh listeners
            const newSave = document.getElementById('rename-project-save');
            const newCancel = document.getElementById('rename-project-cancel');
            if (newSave) newSave.addEventListener('click', onSave, { once: true });
            if (newCancel) newCancel.addEventListener('click', onCancel, { once: true });
            // Keep Enter-to-save active for the entire modal session
            onKeyDownHandler = (e) => {
                if (e.key === 'Enter') { e.preventDefault(); onSave(); }
            };
            try { input.addEventListener('keydown', onKeyDownHandler); } catch (_) {}
        };

        const fitDesignerPreviewToScreen = (isOneToOne = false, forceRecalc = false) => {
            const container = document.getElementById('designer-preview-viewport');
            const canvas = document.getElementById('designer-preview-canvas');
            const activeMap = getActivePixelMap();

            if (!container || !canvas || !activeMap) return;
            if (canvas.width === 0 || canvas.height === 0) return;
            if (state.visualizerState.autoFitPreview === false && !forceRecalc) return;

            const cs = getComputedStyle(container);
            const padX = (parseFloat(cs.paddingLeft) || 0) + (parseFloat(cs.paddingRight) || 0);
            const padY = (parseFloat(cs.paddingTop) || 0) + (parseFloat(cs.paddingBottom) || 0);
            const containerWidth = Math.max(0, container.clientWidth - padX);
            const containerHeight = Math.max(0, container.clientHeight - padY);

            const scaleX = containerWidth / canvas.width;
            const scaleY = containerHeight / canvas.height;
            let newZoom = Math.min(scaleX, scaleY) * 0.98; // slight padding
            if (isOneToOne) newZoom = 1.0;

            activeMap.zoom = Math.max(0.1, Math.min(10, newZoom));
            // Apply CSS sizing; scrollbars handle navigation
            const z = activeMap.zoom || 1;
            canvas.style.width = `${Math.round(canvas.width * z)}px`;
            canvas.style.height = `${Math.round(canvas.height * z)}px`;
            state.visualizerState.autoFitPreview = false; // Reset after fitting
        };

        const handleDesignerZoom = (factor, absoluteZoom = null) => {
            const activeMap = getActivePixelMap();
            if (!activeMap) return;

            if (absoluteZoom !== null) {
                activeMap.zoom = absoluteZoom;
            } else {
                activeMap.zoom = Math.max(0.1, Math.min(10, (activeMap.zoom || 1) * factor));
            }

            const canvas = document.getElementById('designer-preview-canvas');
            if (canvas && canvas.width && canvas.height) {
                const z = activeMap.zoom || 1;
                canvas.style.width = `${Math.round(canvas.width * z)}px`;
                canvas.style.height = `${Math.round(canvas.height * z)}px`;
            }
            state.visualizerState.autoFitPreview = false; // User is manually zooming
        };

        const handleInputChange = (e) => {
            const project = state.projects.find(p => p.id === state.activeProjectId);
            if (!project) return;
            const activeMap = project.pixelMaps.find(m => m.id === project.activePixelMapId);
            if (!activeMap) return;

            const field = e.target.dataset.field;
            let value = e.target.value;

            // Handle math expressions on change (e.g., when user blurs input)
            if (e.type === 'change' && typeof value === 'string' && (value.includes('*') || value.includes('/'))) {
                try {
                    const evaluate = (str) => {
                        // Basic security: only allow numbers, operators, and whitespace.
                        if (!/^[0-9\s\.\*\/\-]+$/.test(str)) return NaN;
                        return new Function(`return ${str}`)();
                    };
                    const result = evaluate(value);
                    if (!isNaN(result)) {
                        value = result;
                        e.target.value = value;
                    }
                } catch (err) {
                     console.error("Invalid expression:", value);
                     value = parseFloat(value) || 0;
                }
            }
            
            if (!field) { return; }
            if (field === 'screenDimensionsUnit') {
                const oldUnit = activeMap.screenDimensionsUnit;
                const newUnit = value;
                const toMeters = { m: 1, cm: 0.01, mm: 0.001, ft: 0.3048, in: 0.0254 };
                const fromMeters = { m: 1, cm: 100, mm: 1000, ft: 3.28084, in: 39.3701 };
                
                const widthInMeters = (parseFloat(activeMap.screenWidthValue) || 0) * toMeters[oldUnit];
                const heightInMeters = (parseFloat(activeMap.screenHeightValue) || 0) * toMeters[oldUnit];
                
                activeMap.screenWidthValue = parseFloat((widthInMeters * fromMeters[newUnit]).toFixed(2));
                activeMap.screenHeightValue = parseFloat((heightInMeters * fromMeters[newUnit]).toFixed(2));
                activeMap.screenDimensionsUnit = newUnit;
                // Re-render the whole designer to update input values correctly
                renderPixelMapDesigner(); 
            } else if (field === 'panelDimensionsUnit') {
                activeMap.panelDimensionsUnit = value;
                renderPixelMapDesigner();
            } else {
                // Support nested fields in future (placeholder)
                const setNested = (obj, path, v) => {
                    const parts = path.split('.');
                    const last = parts.pop();
                    let cur = obj;
                    parts.forEach(p => { if (!cur[p] || typeof cur[p] !== 'object') cur[p] = {}; cur = cur[p]; });
                    cur[last] = v;
                };
                let v;
                if (e.target.type === 'checkbox') v = !!e.target.checked;
                else if (e.target.type === 'text') {
                    // Allow math expressions for numeric text fields
                    if (typeof value === 'string' && (value.includes('*') || value.includes('/'))) {
                        try {
                            if (/^[0-9\s\.+\-*\/]+$/.test(value)) {
                                // eslint-disable-next-line no-new-func
                                const calc = new Function(`return (${value})`);
                                const r = calc();
                                if (!isNaN(r)) { value = r; e.target.value = r; }
                            }
                        } catch(_) {}
                    }
                    // parseFloat if numeric-ish, else keep string (for now all relevant are numeric)
                    const num = parseFloat(value);
                    v = isNaN(num) ? value : num;
                } else v = parseFloat(value) || value;

                if (field === 'panelWidthMm' || field === 'panelHeightMm') {
                    const unit = activeMap.panelDimensionsUnit || 'mm';
                    const numericValue = parseFloat(value);
                    v = isNaN(numericValue) ? 0 : convertPanelUnitValueToMm(numericValue, unit);
                }

                if (field.includes('.')) setNested(activeMap, field, v);
                else activeMap[field] = v;
            }

            if (field === 'screenWidthValue' || field === 'screenHeightValue') {
                const unitMm = { m: 1000, cm: 10, mm: 1, ft: 304.8, in: 25.4 }[activeMap.screenDimensionsUnit || 'm'] || 1000;
                if (field === 'screenWidthValue') {
                    activeMap.tilesWide = Math.max(1, Math.round((Number(activeMap.screenWidthValue) || 0) * unitMm / (Number(activeMap.panelWidthMm) || 500)));
                    const tilesWideInput = document.querySelector('[data-field="tilesWide"]');
                    if (tilesWideInput) tilesWideInput.value = activeMap.tilesWide;
                } else {
                    activeMap.tilesHigh = Math.max(1, Math.round((Number(activeMap.screenHeightValue) || 0) * unitMm / (Number(activeMap.panelHeightMm) || 500)));
                    const tilesHighInput = document.querySelector('[data-field="tilesHigh"]');
                    if (tilesHighInput) tilesHighInput.value = activeMap.tilesHigh;
                }
            } else if (field === 'tilesWide' || field === 'tilesHigh' || field === 'panelWidthMm' || field === 'panelHeightMm') {
                const unitMm = { m: 1000, cm: 10, mm: 1, ft: 304.8, in: 25.4 }[activeMap.screenDimensionsUnit || 'm'] || 1000;
                const tilesWide = Math.max(1, Math.round(Number(activeMap.tilesWide) || ((Number(activeMap.screenWidthValue) || 0) * unitMm / (Number(activeMap.panelWidthMm) || 500))));
                const tilesHigh = Math.max(1, Math.round(Number(activeMap.tilesHigh) || ((Number(activeMap.screenHeightValue) || 0) * unitMm / (Number(activeMap.panelHeightMm) || 500))));
                const panelWidthMm = Number(activeMap.panelWidthMm) || 0;
                const panelHeightMm = Number(activeMap.panelHeightMm) || 0;
                if (tilesWide > 0 && tilesHigh > 0 && panelWidthMm > 0 && panelHeightMm > 0) {
                    activeMap.tilesWide = tilesWide;
                    activeMap.tilesHigh = tilesHigh;
                    activeMap.screenWidthValue = Math.round((tilesWide * panelWidthMm / unitMm) * 1000) / 1000;
                    activeMap.screenHeightValue = Math.round((tilesHigh * panelHeightMm / unitMm) * 1000) / 1000;
                    const widthInput = document.querySelector('[data-field="screenWidthValue"]');
                    const heightInput = document.querySelector('[data-field="screenHeightValue"]');
                    if (widthInput) widthInput.value = activeMap.screenWidthValue;
                    if (heightInput) heightInput.value = activeMap.screenHeightValue;
                }
            }
            
            const calcs = calculateLayout(activeMap);
            if (field.startsWith('screen') || field.startsWith('panel')) { 
                applyShapeMask(activeMap);
            }
            updateCalculationCards(calcs);
            state.visualizerState.autoFitPreview = true; // Force a refit on next draw
            
            redrawAffectedVisuals();
        };
        
        const handleVisualStyleChange = (e) => {
            const activeMap = getActivePixelMap();
            if (!activeMap) return;
            activeMap.visualStyle = e.target.value;
            saveState();
            renderPixelMapDesigner(); // Re-render to show/hide controls
            redrawAffectedVisuals();
        };

        const handleStyleChange = (e) => {
            const activeMap = getActivePixelMap();
            if (!activeMap) return;

            const { gradientField, checkerField, numberingField, borderField } = e.target.dataset;
            const value = e.target.value;

            if (gradientField) {
                if(gradientField === 'type') {
                    activeMap.gradient.type = value;
                    document.getElementById('gradient-angle-control').style.display = value === 'linear' ? 'block' : 'none';
                }
                else if (gradientField === 'color1') activeMap.gradient.colors[0] = value;
                else if (gradientField === 'color2') activeMap.gradient.colors[1] = value;
                else if (gradientField === 'angle') {
                    activeMap.gradient.angle = value;
                    const angleLabel = document.getElementById('gradient-angle-label');
                    if(angleLabel) angleLabel.textContent = `Angle (${value}°)`;
                }
                if(gradientField.startsWith('color')) {
                    activeMap.gradient.palette = 'Custom';
                    document.getElementById('gradient-palette').value = 'Custom';
                }
            }
            if (checkerField) {
                if (checkerField === 'color1') activeMap.checkerColors[0] = value;
                else if (checkerField === 'color2') activeMap.checkerColors[1] = value;
                activeMap.checkerPalette = 'Custom';
                document.getElementById('checker-palette').value = 'Custom';
            }
            if (numberingField) {
                activeMap.numbering[numberingField] = value;
                if (numberingField === 'fontSize') {
                    const label = document.getElementById('font-size-label');
                    if(label) label.textContent = `Font Size (${value}%)`;
                }
            }
            if (borderField) {
                activeMap.border[borderField] = value;
                if (borderField === 'thickness') {
                    const label = document.getElementById('border-thickness-label');
                    if(label) label.textContent = `Thickness (${value}px)`;
                }
            }
            
            saveState();
            redrawAffectedVisuals();
        };

        const handlePaletteChange = (e) => {
            const activeMap = getActivePixelMap();
            if (!activeMap) return;
            const paletteName = e.target.value;
            activeMap.gradient.palette = paletteName;
            const saved = (() => { try { return JSON.parse(localStorage.getItem('pixi-logic-gradient-palettes')) || []; } catch(_) { return []; } })();
            const builtInGrad = [
                { name: 'Sunrise', colors: ['#ff9a9e', '#fad0c4'], type: 'linear', angle: 90 },
                { name: 'Ocean', colors: ['#a1c4fd', '#c2e9fb'], type: 'linear', angle: 90 },
                { name: 'Passion', colors: ['#fa709a', '#fee140'], type: 'linear', angle: 90 },
                { name: 'Forest', colors: ['#43e97b', '#38f9d7'], type: 'linear', angle: 90 },
                { name: 'Amethyst', colors: ['#9d50bb', '#6e48aa'], type: 'linear', angle: 90 },
            ];
            const gradientPalettes = [ { name: 'Custom', colors: activeMap.gradient.colors, type: activeMap.gradient.type, angle: activeMap.gradient.angle }, ...builtInGrad, ...saved ];
            const selectedPalette = gradientPalettes.find(p => p.name === paletteName);
            if (selectedPalette && paletteName !== 'Custom') {
                activeMap.gradient.colors = [...(selectedPalette.colors || ['#ffffff','#000000'])];
                if (selectedPalette.type) activeMap.gradient.type = selectedPalette.type;
                if (typeof selectedPalette.angle === 'number') activeMap.gradient.angle = selectedPalette.angle;
                renderPixelMapDesigner();
            }
            saveState();
            redrawAffectedVisuals();
        };
        
        const handleCheckerPaletteChange = (e) => {
            const activeMap = getActivePixelMap();
            if (!activeMap) return;
            const paletteName = e.target.value;
            activeMap.checkerPalette = paletteName;
            const saved = (() => { try { return JSON.parse(localStorage.getItem('pixi-logic-checker-palettes')) || []; } catch(_) { return []; } })();
            const builtInChecker = [
                { name: 'Classic', colors: ['#4b5563', '#1f2937'] },
                { name: 'Monochrome', colors: ['#ffffff', '#000000'] },
                { name: 'Earth', colors: ['#a16207', '#422006'] },
                { name: 'Oceanic', colors: ['#0c4a6e', '#082f49'] },
                { name: '100% Colour', colors: ['#ffffff', '#000000'] },
                { name: '50% Colour', colors: ['#bdbdbd', '#1f1f1f'] },
                { name: '25% Colour', colors: ['#8c8c8c', '#1a1a1a'] },
                { name: 'Full H Colour Sweep', colors: ['#ff4d4d', '#4d79ff'] },
                { name: 'Full V Colour Sweep', colors: ['#4dff88', '#4d79ff'] },
                { name: 'Full RGB', colors: ['#ff0000', '#00ff00'] },
                { name: '50% RGB', colors: ['#ff8080', '#80ff80'] },
                { name: '25% RGB', colors: ['#ffb3b3', '#b3ffb3'] },
                { name: 'Full CMY', colors: ['#00ffff', '#ff00ff'] },
                { name: '50% CMY', colors: ['#80ffff', '#ff80ff'] },
                { name: '25% CMY', colors: ['#b3ffff', '#ffb3ff'] },
                { name: 'Rainbow', colors: ['#ff0000', '#8a00ff'] },
                { name: 'Fruit', colors: ['#ff7a00', '#ff2d55'] },
                { name: 'Search', colors: ['#00b3ff', '#003b6f'] },
                { name: 'Glazed', colors: ['#ffe29a', '#ffa99f'] },
                { name: 'Union', colors: ['#1d4ed8', '#ef4444'] },
                { name: 'TCT', colors: ['#a855f7', '#22c55e'] },
                { name: 'Connected', colors: ['#00d4ff', '#005b9a'] },
                { name: 'Freedom', colors: ['#2563eb', '#f97316'] },
                { name: 'Freedom Flag', colors: ['#1d4ed8', '#ffffff'] },
                { name: 'White', colors: ['#ffffff', '#f2f2f2'] },
                { name: 'Gray', colors: ['#9ca3af', '#4b5563'] },
                { name: 'Black', colors: ['#111827', '#000000'] },
                { name: 'Transparent', colors: ['#000000', '#000000'] },
                { name: 'Black/White', colors: ['#000000', '#ffffff'] },
                { name: 'Light Gray/Dark Gray', colors: ['#d1d5db', '#374151'] },
                { name: 'Grayscale V', colors: ['#111827', '#e5e7eb'] },
                { name: 'Grayscale H', colors: ['#e5e7eb', '#111827'] },
                { name: 'Reduced/Full Check', colors: ['#3b82f6', '#1e293b'] },
                { name: 'Full Red', colors: ['#ff0000', '#7f0000'] },
                { name: 'Red', colors: ['#ef4444', '#7f1d1d'] },
                { name: 'Red/Gray', colors: ['#ef4444', '#6b7280'] },
                { name: 'Alt Red', colors: ['#f97316', '#ef4444'] },
                { name: 'Full Green', colors: ['#00ff00', '#007f00'] },
                { name: 'Green', colors: ['#22c55e', '#166534'] },
                { name: 'Green/Gray', colors: ['#22c55e', '#6b7280'] },
                { name: 'Alt Green', colors: ['#84cc16', '#22c55e'] },
                { name: 'Full Blue', colors: ['#0000ff', '#00007f'] },
                { name: 'Blue', colors: ['#3b82f6', '#1e3a8a'] },
                { name: 'Blue/Gray', colors: ['#3b82f6', '#6b7280'] },
                { name: 'Alt Blue', colors: ['#06b6d4', '#3b82f6'] },
                { name: 'Full Red/Green', colors: ['#ff0000', '#00ff00'] },
                { name: 'Full Green/Blue', colors: ['#00ff00', '#0000ff'] },
                { name: 'Full Blue/Red', colors: ['#0000ff', '#ff0000'] },
                { name: 'Red/Green', colors: ['#ef4444', '#22c55e'] },
                { name: 'Green/Blue', colors: ['#22c55e', '#3b82f6'] },
                { name: 'Blue/Red', colors: ['#3b82f6', '#ef4444'] },
                { name: 'Yellow', colors: ['#facc15', '#ca8a04'] },
                { name: 'Yellow/Gray', colors: ['#facc15', '#6b7280'] },
                { name: 'Cyan', colors: ['#22d3ee', '#0e7490'] },
                { name: 'Cyan/Gray', colors: ['#22d3ee', '#6b7280'] },
                { name: 'Magenta', colors: ['#d946ef', '#7e22ce'] },
                { name: 'Magenta/Gray', colors: ['#d946ef', '#6b7280'] },
                { name: 'Orange', colors: ['#f97316', '#9a3412'] },
                { name: 'Orange/Gray', colors: ['#f97316', '#6b7280'] },
                { name: 'Aqua', colors: ['#22d3ee', '#14b8a6'] },
                { name: 'Aqua/Gray', colors: ['#22d3ee', '#6b7280'] },
                { name: 'Purple', colors: ['#8b5cf6', '#4c1d95'] },
                { name: 'Purple/Gray', colors: ['#8b5cf6', '#6b7280'] },
            ];
            const checkerPalettes = [ { name: 'Custom', colors: activeMap.checkerColors }, ...builtInChecker, ...saved ];
            const selectedPalette = checkerPalettes.find(p => p.name === paletteName);
            if (selectedPalette && paletteName !== 'Custom') {
                activeMap.checkerColors = [...(selectedPalette.colors || ['#ffffff','#000000'])];
                renderPixelMapDesigner();
            }
            saveState();
            redrawAffectedVisuals();
        };

        const getPanelSizePresets = () => {
            try {
                const stored = JSON.parse(localStorage.getItem('pixellogic-panel-dimension-presets') || '[]');
                return Array.isArray(stored) ? stored : [];
            } catch (_) {
                return [];
            }
        };

        const persistPanelSizePresets = (presets) => {
            try {
                localStorage.setItem('pixellogic-panel-dimension-presets', JSON.stringify(presets));
                state.panelDimensionPresets = presets;
            } catch (_) {}
        };

        const populatePanelSizePresets = () => {
            const activeMap = getActivePixelMap();
            const selectEl = document.getElementById('panel-size-preset');
            if (!activeMap || !selectEl) return;

            const presets = getPanelSizePresets();
            selectEl.innerHTML = '<option value="">-- Select Saved Size --</option>' + presets.map(p =>
                `<option value="${p.id}">${escapeHtml(p.text || `${p.widthMm} x ${p.heightMm} mm`)}</option>`
            ).join('');
        };

        const handlePanelSizePresetChange = (e) => {
            const activeMap = getActivePixelMap();
            if (!activeMap || !e.target.value) return;

            const preset = getPanelSizePresets().find(p => String(p.id) === String(e.target.value));
            if (!preset) return;
            activeMap.panelWidthMm = Number(preset.widthMm);
            activeMap.panelHeightMm = Number(preset.heightMm);
            saveState();
            renderPixelMapDesigner();
        };

        const savePanelSizePreset = () => {
            const activeMap = getActivePixelMap();
            if (!activeMap) return;

            const widthMm = Number(activeMap.panelWidthMm);
            const heightMm = Number(activeMap.panelHeightMm);
            if (!(widthMm > 0) || !(heightMm > 0)) {
                showNotification('Invalid panel size to save.');
                return;
            }

            const presets = getPanelSizePresets();
            if (presets.some(p => Number(p.widthMm) === widthMm && Number(p.heightMm) === heightMm)) {
                showNotification('This panel size is already saved.');
                return;
            }

            const id = Date.now() + Math.random();
            presets.push({
                id,
                text: `${widthMm} x ${heightMm} mm (Custom)`,
                widthMm,
                heightMm
            });
            persistPanelSizePresets(presets);
            showNotification(`Saved ${widthMm} x ${heightMm} mm panel size.`);
            populatePanelSizePresets();
        };

        const populatePanelResPresets = () => {
            const activeMap = getActivePixelMap();
            if (!activeMap) return;

            const getCustomPresets = () => {
                try {
                    return JSON.parse(localStorage.getItem('pixi-logic-custom-panel-res')) || [];
                } catch (e) {
                    return [];
                }
            };

            const presets = [
                { text: 'Custom', value: 'custom' },
                { text: '128 x 128', value: '128x128' },
                { text: '192 x 192', value: '192x192' },
                { text: '256 x 256', value: '256x256' },
                ...getCustomPresets(),
                { text: '168 x 168', value: '168x168' },
                { text: '128 x 256 (Vertical)', value: '128x256' },
            ];

            const selectEl = document.getElementById('panel-res-preset');
            const currentRes = `${activeMap.panelResWidth}x${activeMap.panelResHeight}`;
            const matchingPreset = presets.find(p => p.value === currentRes);
            selectEl.innerHTML = presets.map(p => `<option value="${p.value}">${p.text}</option>`).join('');

            if (matchingPreset) {
                selectEl.value = matchingPreset.value;
            } else {
                selectEl.value = 'custom';
            }
            if (selectEl.value === 'custom') {
                document.getElementById('save-custom-res-btn').classList.remove('hidden');
            }
        };

        const handlePanelResPresetChange = (e) => {
            const activeMap = getActivePixelMap();
            if (!activeMap) return;

            const value = e.target.value;
            if (value === 'custom') {
                document.getElementById('save-custom-res-btn').classList.remove('hidden');
                return;
            }

            document.getElementById('save-custom-res-btn').classList.add('hidden');

            const [width, height] = value.split('x').map(Number);
            activeMap.panelResWidth = width;
            activeMap.panelResHeight = height;
            saveState();
            renderPixelMapDesigner(); // Re-render to update the input fields
        };

        const saveCustomPanelResolution = () => {
            const activeMap = getActivePixelMap();
            if (!activeMap) return;

            const width = parseInt(activeMap.panelResWidth, 10);
            const height = parseInt(activeMap.panelResHeight, 10);

            if (!width || !height || width <= 0 || height <= 0) {
                showNotification("Invalid custom resolution to save.");
                return;
            }

            const getCustomPresets = () => {
                try {
                    return JSON.parse(localStorage.getItem('pixi-logic-custom-panel-res')) || [];
                } catch (e) {
                    return [];
                }
            };

            const customPresets = getCustomPresets();
            const newValue = `${width}x${height}`;
            if (customPresets.some(p => p.value === newValue)) {
                showNotification("This resolution is already saved.");
                return;
            }

            customPresets.push({ text: `${width} x ${height} (Custom)`, value: newValue });
            localStorage.setItem('pixi-logic-custom-panel-res', JSON.stringify(customPresets));
            showNotification(`Saved ${newValue} to presets.`);
            renderPixelMapDesigner(); // Re-render to update the dropdown
        };

        const synchronizeAnnotationDetails = (sourceMap) => {
            const project = state.projects.find(p => String(p.id) === String(state.activeProjectId));
            if (!sourceMap?.details || !project) return;
            state.ui = state.ui || {};
            state.ui.activeEffectsPresetId = '';
            try { localStorage.setItem('pixellogic-active-effects-preset', ''); } catch (_) {}
            const logoImage = sourceMap.details.logo?.imageObject || null;
            (project.pixelMaps || []).forEach(map => {
                if (String(map.id) === String(sourceMap.id)) return;
                map.details = JSON.parse(JSON.stringify(sourceMap.details));
                if (map.details.logo) map.details.logo.imageObject = logoImage;
            });
        };

        const setDetailsFieldForAllMaps = (category, property, value) => {
            const activeMap = getActivePixelMap();
            if (!activeMap) return;
            activeMap.details = activeMap.details || {};
            activeMap.details[category] = activeMap.details[category] || {};
            activeMap.details[category][property] = value;
            if (category === 'info' && ['fontSizeMode', 'fontScale', 'fontSize'].includes(property)) return;
            synchronizeAnnotationDetails(activeMap);
        };

        const handleDetailsChange = (e) => {
            const activeMap = getActivePixelMap();
            if (!activeMap) return;

            const field = e.target.dataset.detailsField;
            if (!field) return; 
            const [category, property] = field.split('.');

            if (e.target.type === 'file') {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = (event) => {
                        const imageUrl = event.target.result;
                        const image = new Image();
                        image.onload = () => {
                            const project = state.projects.find(p => String(p.id) === String(state.activeProjectId));
                            (project?.pixelMaps || []).forEach(map => {
                                map.details = map.details || {};
                                map.details.logo = map.details.logo || {};
                                map.details.logo.imageObject = image;
                                map.details.logo.src = imageUrl;
                            });
                            synchronizeAnnotationDetails(activeMap);
                            redrawAffectedVisuals();
                        };
                        image.onerror = () => {
                            showNotification("Error loading logo image.");
                            activeMap.details.logo.imageObject = null;
                            activeMap.details.logo.src = null;
                            redrawAffectedVisuals();
                        };
                        image.src = imageUrl;
                    };
                    reader.readAsDataURL(file);
                }
                return;
            }

            let value;
            if (e.target.type === 'checkbox') {
                value = e.target.checked;
            } else if (e.target.type === 'range' || e.target.type === 'number') {
                value = parseFloat(e.target.value);
            } else {
                value = e.target.value;
            }
            
            setDetailsFieldForAllMaps(category, property, value);
            // Keep displayMode and badgeEnabled in sync for backward compatibility
            if (field === 'info.displayMode') {
                if (!activeMap.details.info) activeMap.details.info = {};
                activeMap.details.info.badgeEnabled = (value === 'badge');
            }

            // Direct DOM update for slider labels to avoid re-rendering
            if (e.target.type === 'range') {
                switch(field) {
                    case 'info.fontSize':
                        document.getElementById('info-font-size-label').textContent = `Custom Size (${value} px)`;
                        document.querySelectorAll('[data-details-field="info.fontSize"]').forEach(control => {
                            if (control !== e.target) control.value = value;
                        });
                        break;
                    case 'info.fontScale':
                        document.getElementById('info-font-scale-label').textContent = `Auto Scale (${value}%)`;
                        break;
                    case 'info.lineSpacing':
                        const ils = document.getElementById('info-line-spacing-label'); if (ils) ils.textContent = `Line Spacing (${value}%)`;
                        break;
                    case 'info.badgeTextScale':
                        const bts = document.getElementById('center-badge-textsize-label'); if (bts) bts.textContent = `Text Size (${value}%)`;
                        break;
                    case 'info.badgeLineSpacing':
                        const bls = document.getElementById('center-badge-linespacing-label'); if (bls) bls.textContent = `Line Spacing (${value}%)`;
                        break;
                    case 'coords.fontSize':
                        const cfs = document.getElementById('coords-font-size-label'); if (cfs) cfs.textContent = `Font Size (${value}%)`;
                        break;
                    case 'logo.size':
                        document.getElementById('logo-size-label').textContent = `Size (${value}%)`;
                        break;
                    case 'logo.opacity':
                        document.getElementById('logo-opacity-label').textContent = `Opacity (${value}%)`;
                        break;
                    case 'shared.thickness':
                        document.getElementById('shared-thickness-label').textContent = `Circle / Cross Thickness (${value}px)`;
                        break;
                    case 'circle.radius':
                        document.getElementById('circle-radius-label').textContent = `Circle Radius (${value}%)`;
                        break;
                    case 'cornerCircles.radius':
                        const cc = document.getElementById('corner-circles-radius-label'); if (cc) cc.textContent = `Radius (${value}%)`;
                        break;
                    case 'info.badgeSize':
                        const cblBadge = document.getElementById('center-badge-size-label'); if (cblBadge) cblBadge.textContent = `Size (${value}%)`;
                        break;
                    case 'info.badgeOpacity':
                        const cbo2 = document.getElementById('center-badge-opacity-label'); if (cbo2) cbo2.textContent = `Opacity (${value}%)`;
                        break;
                    case 'info.badgeGradientAngle':
                        const bga = document.getElementById('center-badge-gradient-angle-label'); if (bga) bga.textContent = `Gradient Angle (${value}°)`;
                        break;
                    case 'info.badgeBorderGradientAngle':
                        const bbga = document.getElementById('center-badge-border-gradient-angle-label'); if (bbga) bbga.textContent = `Border Gradient Angle (${value}°)`;
                        break;
                    case 'info.badgeShadowBlur':
                        const bsb = document.getElementById('center-badge-shadow-blur-label'); if (bsb) bsb.textContent = `Shadow Blur (${value}px)`;
                        break;
                    case 'info.badgeShadowOffsetY':
                        const bso = document.getElementById('center-badge-shadow-offset-label'); if (bso) bso.textContent = `Shadow Offset Y (${value}px)`;
                        break;
                    case 'colorBars.heightPercent':
                        const cbh = document.getElementById('color-bars-height-label'); if (cbh) cbh.textContent = `Bar Thickness (${value}%)`;
                        break;
                    case 'colorBars.lengthPercent':
                        const cblBars = document.getElementById('color-bars-length-label'); if (cblBars) cblBars.textContent = `Bar Length (${value}%)`;
                        break;
                    case 'colorBars.opacity':
                        const cbo = document.getElementById('color-bars-opacity-label'); if (cbo) cbo.textContent = `Opacity (${value}%)`;
                        break;
                    case 'colorBars.offsetXPercent':
                        const cbx = document.getElementById('color-bars-offset-x-label'); if (cbx) cbx.textContent = `Offset X (${value}%)`;
                        break;
                    case 'colorBars.offsetYPercent':
                        const cby = document.getElementById('color-bars-offset-y-label'); if (cby) cby.textContent = `Offset Y (${value}%)`;
                        break;
                    case 'circle.gradientAngle':
                        const cga = document.getElementById('center-circle-gradient-angle-label'); if (cga) cga.textContent = `Gradient Angle (${value}°)`;
                        break;
                    case 'circle.shadowBlur':
                        const csb = document.getElementById('center-circle-shadow-blur-label'); if (csb) csb.textContent = `Shadow Blur (${value}px)`;
                        break;
                    case 'circle.shadowOffsetY':
                        const cso = document.getElementById('center-circle-shadow-offset-label'); if (cso) cso.textContent = `Shadow Offset Y (${value}px)`;
                        break;
                    case 'cornerCircles.gradientAngle':
                        const ccga = document.getElementById('corner-circles-gradient-angle-label'); if (ccga) ccga.textContent = `Gradient Angle (${value}°)`;
                        break;
                    case 'cornerCircles.shadowBlur':
                        const ccsb = document.getElementById('corner-circles-shadow-blur-label'); if (ccsb) ccsb.textContent = `Shadow Blur (${value}px)`;
                        break;
                    case 'cornerCircles.shadowOffsetY':
                        const ccso = document.getElementById('corner-circles-shadow-offset-label'); if (ccso) ccso.textContent = `Shadow Offset Y (${value}px)`;
                        break;
                    case 'cross.gradientAngle':
                        const xga = document.getElementById('center-cross-gradient-angle-label'); if (xga) xga.textContent = `Gradient Angle (${value}°)`;
                        break;
                    case 'cross.shadowBlur':
                        const xsb = document.getElementById('center-cross-shadow-blur-label'); if (xsb) xsb.textContent = `Shadow Blur (${value}px)`;
                        break;
                    case 'cross.shadowOffsetY':
                        const xso = document.getElementById('center-cross-shadow-offset-label'); if (xso) xso.textContent = `Shadow Offset Y (${value}px)`;
                        break;
                }
            }

            if (e.target.type === 'checkbox' || field === 'info.fontSizeMode') {
                renderEffectsDetails();
            }
            redrawAffectedVisuals();
        };

        const redrawAffectedVisuals = () => {
            const activeMap = getActivePixelMap();
            if(!activeMap) return;
            // Update the designer preview
            const previewCanvas = document.getElementById('designer-preview-canvas');
            if(previewCanvas) {
                drawVisualizerCanvas(previewCanvas, activeMap); // Redraw the canvas first
                fitDesignerPreviewToScreen(); // Then, fit the preview to its container
            }
            // Update the Effects live preview if visible
            const effectsCanvas = document.getElementById('effects-preview-canvas');
            if (effectsCanvas) {
                try { drawVisualizerCanvas(effectsCanvas, activeMap); } catch (e) { console.warn('effects preview redraw failed', e); }
            }
            try {
                const project = state.projects.find(p => String(p.id) === String(state.activeProjectId));
                (project?.pixelMaps || []).forEach(map => {
                    const thumb = document.getElementById(`effects-thumb-canvas-${map.id}`);
                    if (thumb) drawVisualizerCanvas(thumb, map);
                });
            } catch (_) {}
            // If the main visualizer is open, update it too
            if(state.activeTab === 'visualizer') {
                renderVisualizer();
            }

             // If the canvas tab is open, redraw it to reflect changes in any source maps
            if(state.activeTab === 'canvas') {
                drawMainCanvas();
            }
        };

    

    

    // ───────────────────────── Shape-based pixel maps ─────────────────────────
    // Each test receives normalized panel-center coordinates in the range [-1, 1]
    // on both axes and returns true when that panel falls INSIDE the wall shape.
    const SHAPE_TESTS = {
        rectangle: () => true,
        circle: (nx, ny) => (nx * nx + ny * ny) <= 1.0,
        // Ellipse uses the same normalized test; non-square grids naturally become oval.
        ellipse: (nx, ny) => (nx * nx + ny * ny) <= 1.0,
        triangle: (nx, ny) => { const y = (ny + 1) / 2; return Math.abs(nx) <= y + 1e-6; },
        diamond: (nx, ny) => (Math.abs(nx) + Math.abs(ny)) <= 1.0,
        hexagon: (nx, ny) => {
            const x = Math.abs(nx), y = Math.abs(ny);
            if (y > 1) return false;
            return x <= (1 - y * 0.5) && x <= 0.92;
        },
        cross: (nx, ny) => { const arm = 0.34; return Math.abs(nx) <= arm || Math.abs(ny) <= arm; },
        custom: null
    };

    // For a circle, the client may provide radius, diameter or circumference instead of a size.
    // Convert whichever was given into a bounding-square dimension (= diameter) and write it
    // into the map's screen size so all existing layout/pixel math keeps working unchanged.
    const applyCircleSizing = (map) => {
        if (!map || !map.shape || map.shape.type !== 'circle') return;
        const val = parseFloat(map.shape.circleValue);
        if (!(val > 0)) return;
        const mode = map.shape.circleMode || 'diameter';
        let diameter;
        if (mode === 'radius') diameter = val * 2;
        else if (mode === 'circumference') diameter = val / Math.PI;
        else diameter = val;
        diameter = Math.round(diameter * 1000) / 1000;
        map.screenWidthValue = diameter;
        map.screenHeightValue = diameter;
    };

    // Recompute the map.panels[] boolean array so panels outside the chosen shape are disabled.
    // The data model stays a rectangular bounding grid, so export/3D/patching/power all keep working.
    const applyShapeMask = (map) => {
        if (!map) return;
        const shape = (map.shape && map.shape.type) || 'rectangle';
        const calcs = calculateLayout(map) || {};
        // Composite maps are pre-composed; never mask them.
        if (calcs.isComposite) return;
        const cols = Math.max(0, Math.round(calcs.panelsHorizontally || 0));
        const rows = Math.max(0, Math.round(calcs.panelsVertically || 0));
        const total = cols * rows;
        if (!total) { map.panels = []; return; }
        if (shape === 'custom') {
            // Preserve the user's hand-painted panels; only resize if the grid changed.
            if (!Array.isArray(map.panels) || map.panels.length !== total) {
                map.panels = Array(total).fill(true);
            }
            return;
        }
        const test = SHAPE_TESTS[shape] || SHAPE_TESTS.rectangle;
        const panels = new Array(total);
        for (let r = 0; r < rows; r++) {
            for (let c = 0; c < cols; c++) {
                const nx = ((c + 0.5) / cols) * 2 - 1;
                const ny = ((r + 0.5) / rows) * 2 - 1;
                panels[r * cols + c] = !!test(nx, ny);
            }
        }
        map.panels = panels;
    };

    

        
        
        const updateCalculationCards = (calcs) => {
            const container = document.getElementById('info-cards-container');
            if (!container) return;
            const isComposite = !!calcs.isComposite;
            const panelsWideDisplay = (calcs.panelsHorizontally || calcs.panelsHorizontally === 0) ? calcs.panelsHorizontally : '—';
            const panelsHighDisplay = (calcs.panelsVertically || calcs.panelsVertically === 0) ? calcs.panelsVertically : '—';
            const panelTypes = Array.isArray(calcs.panelTypes) ? calcs.panelTypes : [];
            const panelTypesHtml = panelTypes.length
                ? panelTypes.map((t) => {
                    const nm = escapeHtml(t.name || 'Map');
                    const w = Math.round(Number(t.panelWidthMm) || 0);
                    const h = Math.round(Number(t.panelHeightMm) || 0);
                    const rw = Number(t.panelResWidth) || 0;
                    const rh = Number(t.panelResHeight) || 0;
                    const pcs = Number(t.totalPanels) || 0;
                    return `<div class="flex items-center justify-between gap-2 text-[11px] text-gray-300">
                        <span class="truncate" title="${nm}">${nm}</span>
                        <span class="text-gray-400">${w}x${h}mm • ${rw}x${rh}px • ${pcs} pcs</span>
                    </div>`;
                }).join('')
                : `<div class="text-[11px] text-gray-500">${isComposite ? 'No panel data found.' : 'Uniform panel sizing.'}</div>`;
            const panelSizeHtml = isComposite
                ? panelTypesHtml
                : `<div class="text-xs text-gray-300">${Math.round(Number(calcs.panelWidthMm) || 0)} x ${Math.round(Number(calcs.panelHeightMm) || 0)} mm</div>
                   <div class="text-xs text-gray-400">${Number(calcs.panelResWidth) || 0} x ${Number(calcs.panelResHeight) || 0} px</div>`;

            container.innerHTML = `
               <div class="info-card bg-gray-800 p-4 rounded-lg text-center shadow-lg"><p class="text-sm text-gray-400 font-medium">Panels Wide</p><p class="text-2xl font-bold text-accent">${panelsWideDisplay} <span class="text-lg text-gray-300">pcs</span></p></div>
               <div class="info-card bg-gray-800 p-4 rounded-lg text-center shadow-lg"><p class="text-sm text-gray-400 font-medium">Panels High</p><p class="text-2xl font-bold text-accent">${panelsHighDisplay} <span class="text-lg text-gray-300">pcs</span></p></div>
               <div class="info-card bg-gray-800 p-4 rounded-lg text-center shadow-lg"><p class="text-sm text-gray-400 font-medium">Total Panels</p><p class="text-2xl font-bold text-accent">${calcs.totalPanels || 0} <span class="text-lg text-gray-300">pcs</span></p></div>
               <div class="info-card bg-gray-800 p-4 rounded-lg text-center shadow-lg"><p class="text-sm text-gray-400 font-medium">Total Resolution Width</p><p class="text-2xl font-bold text-accent">${calcs.totalResWidth || 0} <span class="text-lg text-gray-300">px</span></p></div>
               <div class="info-card bg-gray-800 p-4 rounded-lg text-center shadow-lg"><p class="text-sm text-gray-400 font-medium">Total Resolution Height</p><p class="text-2xl font-bold text-accent">${calcs.totalResHeight || 0} <span class="text-lg text-gray-300">px</span></p></div>
                    <div class="info-card bg-gray-800 p-4 rounded-lg text-center shadow-lg"><p class="text-sm text-gray-400 font-medium">Aspect Ratio</p><p class="text-2xl font-bold text-accent">${formatAspectRatio(calcs.totalResWidth, calcs.totalResHeight)}</p></div>
               <div class="info-card bg-gray-800 p-4 rounded-lg text-center shadow-lg"><p class="text-sm text-gray-400 font-medium">Total Pixels</p><p class="text-2xl font-bold text-accent">${calcs.totalPixels ? (calcs.totalPixels / 1000000).toFixed(2) : 0} <span class="text-lg text-gray-300">MP</span></p></div>
            `;
        };
        
        const showNotification = (message) => {
            notificationEl.textContent = message;
            notificationEl.style.display = 'block';
            setTimeout(() => {
                notificationEl.style.display = 'none';
            }, 4000);
        };
        
        const parsePdfText = (text) => {
            const data = {};
            // More flexible regex patterns to catch common variations
            const patterns = {
                model: /Model\s*[:\s]\s*([A-Z0-9.-]+)/i,
                pitch: /Pixel Pitch\s*[:\s]\s*([\d.]+)/i,
                brightness: /Brightness\s*[:\s]\s*(\d+)/i,
                refreshRate: /Refresh Rate\s*[:\s]\s*(\d+)/i,
                // Look for "Panel Size" or just "Size" followed by dimensions in mm
                panelSize: /(?:Panel\s*)?Size\s*(?:\(mm\))?\s*[:\s]\s*(\d+)\s*[x*]\s*([\d.]+)/im,
                // Look for "Panel Resolution", "Resolution", or just pixel dimensions
                panelRes: /(?:Panel\s*)?Resolution\s*(?:\(px\))?\s*[:\s]\s*(\d+)\s*[x*]\s*(\d+)/im,
            };

            data.model = text.match(patterns.model)?.[1] || `PDF-Panel-${Date.now() % 1000}`;
            data.pitch = parseFloat(text.match(patterns.pitch)?.[1]);
            data.brightness = parseInt(text.match(patterns.brightness)?.[1], 10);
            data.refreshRate = parseInt(text.match(patterns.refreshRate)?.[1], 10);

            const panelSizeMatch = text.match(patterns.panelSize);
            if (panelSizeMatch) {
                data.panelWidth = parseFloat(panelSizeMatch[1].trim());
                data.panelHeight = parseFloat(panelSizeMatch[2].trim());
            }
            
            const panelResMatch = text.match(patterns.panelRes);
            if (panelResMatch) {
                data.resWidth = parseInt(panelResMatch[1].trim(), 10);
                data.resHeight = parseInt(panelResMatch[2].trim(), 10);
            }

            if (!data.pitch || !data.panelWidth || !data.resWidth) return null;
            return data;
        };

        const addPixelMap = () => {
            const project = state.projects.find(p => p.id === state.activeProjectId);
            if (!project) return;
            const newMap = createNewPixelMapObject(project.pixelMaps.length + 1);
            // Ensure panels are initialized (in case layout wasn't available during object creation)
            try {
                const calcs = calculateLayout(newMap) || {};
                if (!newMap.panels || newMap.panels.length === 0) newMap.panels = Array(calcs.totalPanels || 0).fill(true);
            } catch (e) { /* ignore */ }
            project.pixelMaps.push(newMap);
            project.activePixelMapId = newMap.id;
            renderPixelMapDesigner();
        };

        const deletePixelMap = (targetMapId) => {
            const project = state.projects.find(p => p.id === state.activeProjectId);
            if (!project || project.pixelMaps.length <= 1) {
                showNotification("Cannot delete the last pixel map in a project.");
                return;
            }
            // If targetMapId is passed as an id (string or number), delete that specific map; otherwise delete the active pixel map
            const mapId = (targetMapId !== undefined && targetMapId !== null && typeof targetMapId !== 'object')
                ? targetMapId
                : project.activePixelMapId;
            const targetMap = project.pixelMaps.find(m => String(m.id) === String(mapId));
            if (!targetMap) return;
            const mapName = targetMap.name ? targetMap.name : 'this map';
            const confirmed = window.confirm(`Are you sure you want to delete "${mapName}"? This action cannot be undone.`);
            if (!confirmed) return;
            const mapIndex = project.pixelMaps.findIndex(m => String(m.id) === String(mapId));
            if (mapIndex > -1) {
                const mapTabScroller = document.querySelector('[data-map-tab-scroller]');
                const mapTabScrollLeft = mapTabScroller ? mapTabScroller.scrollLeft : 0;
                project.pixelMaps.splice(mapIndex, 1);
                // If the deleted map was active, select adjacent map
                if (String(project.activePixelMapId) === String(mapId)) {
                    const nextIdx = Math.min(mapIndex, project.pixelMaps.length - 1);
                    project.activePixelMapId = project.pixelMaps[nextIdx].id;
                }
                saveState();
                if (typeof redrawAffectedVisuals === 'function') {
                    redrawAffectedVisuals();
                } else {
                    renderPixelMapDesigner();
                }
                const nextScroller = document.querySelector('[data-map-tab-scroller]');
                if (nextScroller) nextScroller.scrollLeft = mapTabScrollLeft;
                showNotification(`Pixel map "${mapName}" deleted.`);
            }
        };
        window.deletePixelMap = deletePixelMap;

        const duplicatePixelMap = () => {
            const project = state.projects.find(p => p.id === state.activeProjectId);
            if (!project) return;
            const original = project.pixelMaps.find(m => String(m.id) === String(project.activePixelMapId));
            if (!original) { showNotification('No active pixel map to duplicate.'); return; }

            // Deep clone via JSON; sanitize non-serializable fields afterwards
            let clone;
            try { clone = JSON.parse(JSON.stringify(original)); }
            catch (_) { clone = Object.assign({}, original); }

            // Assign a new unique id
            clone.id = Date.now() + Math.random();

            // Name it as a copy, ensuring uniqueness within the project
            const base = original.name || 'Pixel Map';
            let proposed = base.endsWith(' Copy') ? base : `${base} Copy`;
            const existingNames = new Set((project.pixelMaps || []).map(m => m && m.name).filter(Boolean));
            if (existingNames.has(proposed)) {
                let i = 2;
                while (existingNames.has(`${base} Copy ${i}`)) i++;
                proposed = `${base} Copy ${i}`;
            }
            clone.name = proposed;

            // Ensure transient fields are reset
            try { if (clone.details && clone.details.logo) clone.details.logo.imageObject = null; } catch (_) {}

            // Insert right after the original
            const at = project.pixelMaps.findIndex(m => String(m.id) === String(original.id));
            if (at >= 0) project.pixelMaps.splice(at + 1, 0, clone); else project.pixelMaps.push(clone);
            project.activePixelMapId = clone.id;

            renderPixelMapDesigner();
            showNotification('Pixel map duplicated.');
        };

        const renameItem = (type) => {
            const project = state.projects.find(p => p.id === state.activeProjectId);
            if(!project) return;

            let item, promptText, renderFunc;

            if(type === 'pixelMap') {
                // Use helper to ensure we always get the latest active map reference
                item = getActivePixelMap();
                if (!item) { showNotification('No active pixel map to rename.'); return; }
                promptText = "Enter new name for Pixel Map:";
                renderFunc = renderPixelMapDesigner;
            } else if (type === 'outputMap') {
                item = getActiveOutputMap();
                if (!item) { showNotification('No active Output Map to rename.'); return; }
                promptText = "Enter new name for Output Map:";
                renderFunc = renderCanvas;
            } else if (type === 'canvas') {
                item = getActiveCanvas();
                promptText = "Enter new name for Output Canvas:";
                renderFunc = renderCanvas;
            }
            else if (type === 'project') {
                item = project; // The project is the item
                promptText = "Edit Project Details";
                renderFunc = () => { /* dashboard removed */ };
                showInputModal(promptText, item, (newValues) => {
                    if (newValues) {
                        item.name = newValues.name || item.name;
                        item.location = newValues.location || item.location;
                        item.salesperson = newValues.salesperson || item.salesperson;
                        item.venue = (typeof newValues.venue === 'string') ? newValues.venue : (item.venue || '');
                        // No dashboard to re-render; optionally refresh current tab
                        if (state.activeTab === 'designer') renderPixelMapDesigner();
                    }
                });
                return; // Use the multi-field modal and exit
            }
            
            if(!item) return;

            showInputModal(promptText, item.name, (newName) => {
                if (type === 'outputMap' && (!newName || !newName.trim())) {
                    showNotification('Output Map name cannot be empty.');
                    return;
                }
                if (newName && newName.trim() !== '') {
                    item.name = newName.trim();
                    if (type === 'outputMap') saveState();
                    renderFunc();
                }
            });
        };

        const getActivePixelMap = () => {
            const project = state.projects.find(p => String(p.id) === String(state.activeProjectId));
            if (!project || !Array.isArray(project.pixelMaps) || project.pixelMaps.length === 0) return null;
            const match = project.pixelMaps.find(m => String(m.id) === String(project.activePixelMapId));
            return match || project.pixelMaps[0];
        };

        const pixelLogicLogoImage = new Image();
        pixelLogicLogoImage.onload = () => {
            try { redrawAffectedVisuals(); } catch (_) {}
        };
        pixelLogicLogoImage.src = 'external-files/pixelogic-logo.png';

        
        
        
            // end drawVisualizerCanvas

        // Uniform-only click toggle for Visualizer and Effects preview
        const onVisualizerCanvasClick = (e) => {
            try {
                const activeMap = getActivePixelMap();
                if (!activeMap) return;
                const calcs = calculateLayout(activeMap);
                const canvas = e.currentTarget;
                if (!canvas || !calcs || !(calcs.totalResWidth > 0 && calcs.totalResHeight > 0)) return;

                const rect = canvas.getBoundingClientRect();
                const scaleX = canvas.width / rect.width;
                const scaleY = canvas.height / rect.height;
                const mouseX = (e.clientX - rect.left) * scaleX;
                const mouseY = (e.clientY - rect.top) * scaleY;

                // Match previewScale used in drawVisualizerCanvas
                const userScale = Math.max(0.05, Math.min(1, (state.visualizerState?.previewScale ?? 1)));
                const fullW = calcs.totalResWidth;
                const fullH = calcs.totalResHeight;
                const fullPixels = Math.max(1, fullW * fullH);
                const MAX_PREVIEW_PIXELS = 4000000;
                const capScale = Math.min(1, Math.sqrt(MAX_PREVIEW_PIXELS / fullPixels));
                const previewScale = Math.max(0.05, Math.min(userScale, capScale));

                // Derive hit-testing directly from rendered canvas size to avoid scale mismatches
                const cols = Math.max(1, Math.round(calcs.panelsHorizontally));
                const rows = Math.max(1, Math.round(calcs.panelsVertically));
                const cellWpx = canvas.width / cols;
                const cellHpx = canvas.height / rows;

                const col = Math.floor(mouseX / cellWpx);
                const row = Math.floor(mouseY / cellHpx);
                if (row < 0 || row >= rows || col < 0 || col >= cols) return;
                const index = row * cols + col;
                const expectedPanels = Number.isFinite(calcs.totalPanels) && calcs.totalPanels > 0 ? calcs.totalPanels : (rows * cols);
                if (!Array.isArray(activeMap.panels) || activeMap.panels.length !== expectedPanels) {
                    activeMap.panels = Array(expectedPanels).fill(true);
                }
                activeMap.panels[index] = !activeMap.panels[index];
                drawVisualizerCanvas(canvas, activeMap);
            } catch(_) { /* ignore */ }
        };

        const fitVisualizerToScreen = (forceRecalc = false) => {
            const container = document.getElementById('visualizer-scroll-container');
            const canvas = document.getElementById('visualizer-canvas');
            const wrapper = document.getElementById('visualizer-wrapper');

            if (!container || !canvas || !wrapper) return;
            if (state.visualizerState.autoFitPreview === false && !forceRecalc) return;
            
            const containerStyle = getComputedStyle(container);
            const paddingX = parseFloat(containerStyle.paddingLeft) + parseFloat(containerStyle.paddingRight);
            const paddingY = parseFloat(containerStyle.paddingTop) + parseFloat(containerStyle.paddingBottom);
            const containerWidth = container.clientWidth - paddingX;
            const containerHeight = container.clientHeight - paddingY;

            if (canvas.width === 0 || canvas.height === 0) return;

            const scaleX = containerWidth / canvas.width;
            const scaleY = containerHeight / canvas.height;
            const newZoom = Math.min(scaleX, scaleY) * 0.98;

            state.visualizerState.zoom = newZoom;
            // Update canvas CSS size to reflect zoom, scrollbars handle navigation
            canvas.style.width = `${Math.round(canvas.width * newZoom)}px`;
            canvas.style.height = `${Math.round(canvas.height * newZoom)}px`;
            state.visualizerState.autoFitPreview = false; // Reset after fitting
        };

        const handleVisualizerZoom = (factor, absoluteZoom = null) => {
            if (absoluteZoom !== null) {
                state.visualizerState.zoom = absoluteZoom;
            } else {
                state.visualizerState.zoom = Math.max(0.1, Math.min(10, state.visualizerState.zoom * factor));
            }

            const wrapper = document.getElementById('visualizer-wrapper');
            const canvas = document.getElementById('visualizer-canvas');
            if (canvas) {
                const z = state.visualizerState.zoom || 1;
                canvas.style.width = `${Math.round(canvas.width * z)}px`;
                canvas.style.height = `${Math.round(canvas.height * z)}px`;
            }
            state.visualizerState.autoFitPreview = false; // User is manually zooming
        };

        // --- OUTPUT MAP AND NESTED CANVAS LOGIC ---
        const ensureOutputMapRegions = (outputMap) => {
            if (!outputMap) return null;
            if (!Array.isArray(outputMap.regions) || outputMap.regions.length === 0) {
                const outputMapId = outputMap.id;
                const outputMapName = outputMap.name || 'Output Map';
                const firstRegion = { ...outputMap, id: Date.now() + Math.floor(Math.random() * 1000000), name: 'Canvas 1' };
                delete firstRegion.regions;
                delete firstRegion.activeRegionId;
                Object.keys(outputMap).forEach(key => {
                    if (key !== 'id' && key !== 'name') delete outputMap[key];
                });
                outputMap.id = outputMapId;
                outputMap.name = outputMapName;
                outputMap.regions = [firstRegion];
                outputMap.activeRegionId = firstRegion.id;
            }
            if (!outputMap.regions.some(region => region.id === outputMap.activeRegionId)) {
                outputMap.activeRegionId = outputMap.regions[0].id;
            }
            outputMap.regionLayout = outputMap.regionLayout === 'vertical' ? 'vertical' : 'horizontal';
            outputMap.regionGap = Math.max(20, Number(outputMap.regionGap) || 20);
            return outputMap;
        };

        const getActiveOutputMap = () => {
            const project = state.projects.find(p => p.id === state.activeProjectId);
            if (!project || !project.canvases || !project.activeCanvasId) return null;
            return ensureOutputMapRegions(project.canvases.find(c => c.id === project.activeCanvasId));
        };

         const getActiveCanvas = () => {
            const outputMap = getActiveOutputMap();
            if (!outputMap) return null;
            return outputMap.regions.find(region => region.id === outputMap.activeRegionId) || outputMap.regions[0];
        };

        const addCanvas = () => {
            const project = state.projects.find(p => p.id === state.activeProjectId);
            if(!project) return;
            const newCanvasName = formatOutputCanvasName(project.canvases.length + 1);
            const region = {id: Date.now() + 1, name: 'Canvas 1', width: 1920, height: 1080, maps: [], masks: []};
            const newCanvas = {id: Date.now(), name: newCanvasName, regions: [region], activeRegionId: region.id};
            project.canvases.push(newCanvas);
            project.activeCanvasId = newCanvas.id;
            renderCanvas();
        };

        const addCanvasRegion = () => {
            const outputMap = getActiveOutputMap();
            if (!outputMap) return;
            const region = {
                id: Date.now() + Math.floor(Math.random() * 1000000),
                name: `Canvas ${outputMap.regions.length + 1}`,
                width: 1920,
                height: 1080,
                maps: [],
                masks: []
            };
            outputMap.regions.push(region);
            outputMap.activeRegionId = region.id;
            state.canvasState.selectedMapId = null;
            saveState();
            renderCanvas();
            showNotification('Canvas added to Output Map.');
        };

        const duplicateCanvasRegion = () => {
            const outputMap = getActiveOutputMap();
            const original = getActiveCanvas();
            if (!outputMap || !original) return;
            const clone = JSON.parse(JSON.stringify(original));
            clone.id = Date.now() + Math.floor(Math.random() * 1000000);
            clone.name = `${original.name || 'Canvas'} Copy`;
            const index = outputMap.regions.findIndex(region => region.id === original.id);
            outputMap.regions.splice(index + 1, 0, clone);
            outputMap.activeRegionId = clone.id;
            state.canvasState.selectedMapId = null;
            saveState();
            renderCanvas();
            showNotification('Canvas duplicated inside Output Map.');
        };

        const deleteCanvasRegion = () => {
            const outputMap = getActiveOutputMap();
            const activeCanvas = getActiveCanvas();
            if (!outputMap || !activeCanvas || outputMap.regions.length <= 1) {
                showNotification('Cannot delete the last canvas in an Output Map.');
                return;
            }
            outputMap.regions = outputMap.regions.filter(region => region.id !== activeCanvas.id);
            outputMap.activeRegionId = outputMap.regions[0].id;
            state.canvasState.selectedMapId = null;
            saveState();
            renderCanvas();
            showNotification(`Canvas "${activeCanvas.name}" deleted.`);
        };

        const deleteCanvas = () => {
            const project = state.projects.find(p => p.id === state.activeProjectId);
            const activeOutputMap = getActiveOutputMap();
            if(!project || !activeOutputMap || project.canvases.length <= 1) {
                showNotification("Cannot delete the last Output Map.");
                return;
            }
            
            project.canvases = project.canvases.filter(c => c.id !== project.activeCanvasId);
            project.activeCanvasId = project.canvases[0].id;
            showNotification(`Output Map "${activeOutputMap.name}" deleted.`);
            renderCanvas();
        };

        const duplicateCanvas = () => {
            const project = state.projects.find(p => p.id === state.activeProjectId);
            const original = getActiveOutputMap();
            if (!project || !original) { showNotification('No active Output Map to duplicate.'); return; }

            // Deep clone canvas, including maps and drawings
            let clone;
            try { clone = JSON.parse(JSON.stringify(original)); }
            catch (_) { clone = Object.assign({}, original); }

            // Restore transient references for logos (if any) in maps
            try {
                if (Array.isArray(original.maps) && Array.isArray(clone.maps)) {
                    clone.maps.forEach((m, i) => {
                        const src = original.maps[i];
                        if (src && src.details && src.details.logo && src.details.logo.imageObject) {
                            m.details = m.details || {};
                            m.details.logo = m.details.logo || {};
                            m.details.logo.imageObject = src.details.logo.imageObject;
                        }
                    });
                }
            } catch (_) {}

            // New unique integer id and name (avoid decimals to keep tab selection working)
            clone.id = Date.now() + Math.floor(Math.random() * 1000000);
            const base = original.name || 'Canvas';
            let proposed = base.endsWith(' Copy') ? base : `${base} Copy`;
            const existingNames = new Set((project.canvases || []).map(c => c && c.name).filter(Boolean));
            if (existingNames.has(proposed)) {
                let i = 2;
                while (existingNames.has(`${base} Copy ${i}`)) i++;
                proposed = `${base} Copy ${i}`;
            }
            clone.name = proposed;

            // Insert after original and activate
            const idx = project.canvases.findIndex(c => String(c.id) === String(original.id));
            if (idx >= 0) project.canvases.splice(idx + 1, 0, clone); else project.canvases.push(clone);
            project.activeCanvasId = clone.id;

            renderCanvas();
            showNotification('Output canvas duplicated.');
        };

        const sendVisualizerToCanvas = () => {
            const activeMap = getActivePixelMap();
            if (!activeMap) return;

            const calcs = calculateLayout(activeMap);
            if (!calcs.totalResWidth) {
                showNotification("Current map has no valid dimensions to send.");
                return;
            }
            // Create a deep copy for the canvas
            const mapCopy = JSON.parse(JSON.stringify(activeMap));
            // Manually copy non-serializable properties (guard nested objects)
            try {
                if (activeMap.details && activeMap.details.logo && activeMap.details.logo.imageObject) {
                    mapCopy.details = mapCopy.details || {};
                    mapCopy.details.logo = mapCopy.details.logo || {};
                    mapCopy.details.logo.imageObject = activeMap.details.logo.imageObject;
                }
            } catch (e) { /* ignore */ }

            // Create a canvas-instance map with its own unique id so multiple copies of
            // the same pixel map can coexist and be selected/moved independently.
            // Place the spread first so our explicit fields override copied ones (id, x/y, size).
            const newCanvasMap = {
                ...mapCopy,
                id: (typeof uid === 'function' ? uid() : (Date.now() + Math.floor(Math.random() * 1e6))),
                sourceMapId: activeMap.id, // Reference to original
                sourceProjectId: state.activeProjectId,
                x: 0,
                y: 0,
                width: calcs.totalResWidth,
                height: calcs.totalResHeight,
                calcs: calcs
            };

            let activeCanvas = getActiveCanvas();
            // If there is no active canvas, create one automatically
            if (!activeCanvas) {
                console.info('No active output canvas found — creating one automatically.');
                const project = state.projects.find(p => p.id === state.activeProjectId);
                if (!project) {
                    showNotification('No active project to create output canvas in.');
                    return;
                }
                const region = { id: Date.now() + 1, name: 'Canvas 1', width: calcs.totalResWidth || 1920, height: calcs.totalResHeight || 1080, maps: [], masks: [] };
                const newCanvas = { id: Date.now(), name: formatOutputCanvasName((project.canvases || []).length + 1), regions: [region], activeRegionId: region.id };
                project.canvases = project.canvases || [];
                project.canvases.push(newCanvas);
                project.activeCanvasId = newCanvas.id;
                activeCanvas = region;
            }

            activeCanvas.maps = activeCanvas.maps || [];
            activeCanvas.maps.push(newCanvasMap);
            showNotification(`'${activeMap.name}' sent to Output Canvas.`);
            // re-render canvases so user can see it immediately
            try { renderCanvas(); } catch (e) { console.warn('renderCanvas error after send', e); }
            switchTab('canvas');
        };
        
        const syncSelectedMaskProperties = () => {
            const ac = getActiveCanvas();
            const mask = state.canvasState.selectedMaskId != null && ac?.masks?.find(m => String(m.id) === String(state.canvasState.selectedMaskId));
            const badge = document.getElementById("mask-selected-name-badge");
            const hint = document.getElementById("mask-selected-hint");
            if (badge) badge.textContent = mask ? (mask.name || "Selected Mask") : "None";
            if (hint) hint.textContent = mask ? `${mask.type.toUpperCase()} · ${mask.locked ? 'LOCKED' : 'ACTIVE'}` : "Select a mask on canvas or in layer list to adjust";

            const fillColor = document.getElementById("mask-fill-color");
            const fillOpacity = document.getElementById("mask-fill-opacity");
            const fillOpacityVal = document.getElementById("mask-fill-opacity-val");
            const propX = document.getElementById("mask-prop-x");
            const propY = document.getElementById("mask-prop-y");
            const propW = document.getElementById("mask-prop-w");
            const propH = document.getElementById("mask-prop-h");
            const delBtn = document.getElementById("mask-delete-btn");
            const dupBtn = document.getElementById("mask-duplicate-btn");
            const propMode = document.getElementById("mask-prop-mode");
            const propRadius = document.getElementById("mask-prop-radius");
            const propFeather = document.getElementById("mask-prop-feather");
            const snapWallBtn = document.getElementById("mask-snap-wall-btn");
            const snapPanelBtn = document.getElementById("mask-snap-panel-btn");
            const aspectSelect = document.getElementById("mask-aspect-select");

            [fillColor, fillOpacity, propX, propY, propW, propH, propMode, propRadius, propFeather, snapWallBtn, snapPanelBtn, aspectSelect].forEach(control => {
                if (control) {
                    control.disabled = !mask;
                    if (!mask) control.classList.add("opacity-40", "cursor-not-allowed");
                    else control.classList.remove("opacity-40", "cursor-not-allowed");
                }
            });
            if (delBtn) delBtn.disabled = !mask;
            if (dupBtn) dupBtn.disabled = !mask;
            if (propRadius) {
                const canRadius = mask && mask.type === 'rect';
                propRadius.disabled = !canRadius;
                if (!canRadius) propRadius.classList.add("opacity-40", "cursor-not-allowed");
                else propRadius.classList.remove("opacity-40", "cursor-not-allowed");
            }
            if (!mask) return;

            if (fillColor) fillColor.value = mask.color || "#000000";
            if (fillOpacity) fillOpacity.value = mask.opacity != null ? mask.opacity : 100;
            if (fillOpacityVal) fillOpacityVal.textContent = (mask.opacity != null ? mask.opacity : 100) + "%";
            if (propMode) propMode.value = mask.mode || "blackout";
            if (propRadius) propRadius.value = mask.radius != null ? mask.radius : 0;
            if (propFeather) propFeather.value = mask.feather != null ? mask.feather : 0;

            const unit = state.canvasState.maskUnit || "px";
            const ppu = state.canvasState.maskPxPerUnit || 1;
            const toUnit = (px) => unit === "px" ? Math.round(px) : +(px / ppu).toFixed(2);
            if (propX) propX.value = toUnit(mask.x);
            if (propY) propY.value = toUnit(mask.y);
            if (propW) propW.value = toUnit(mask.w);
            if (propH) propH.value = toUnit(mask.h);
        };

        // Global mask list updater - updates the mask list panel in the toolbar
        const updateMaskList = () => {
            const body = document.getElementById("mask-list-body");
            const countEl = document.getElementById("mask-list-count");
            const ac = getActiveCanvas();
            const masks = ac?.masks || [];
            if (countEl) countEl.textContent = masks.length;
            if (!body) return;
            if (masks.length === 0) {
                body.innerHTML = '<div class="px-3 py-4 text-xs text-gray-500 italic text-center">No masks defined. Use the buttons above to add one.</div>';
                return;
            }
            body.innerHTML = masks.map((m, i) => {
                const sel = String(m.id) === String(state.canvasState.selectedMaskId);
                const typ = m.type === "polygon" ? "Poly" : m.type === "rect" ? "Rect" : "Ellipse";
                const mode = m.mode || "blackout";
                const modeLabel = mode === "guide" ? "Guide" : mode === "cutout" ? "Cutout" : "Blackout";
                const modeBadgeClass = mode === "guide" ? "text-cyan-400 bg-cyan-950/80 border-cyan-700/60" : mode === "cutout" ? "text-pink-400 bg-pink-950/80 border-pink-700/60" : "text-purple-300 bg-purple-950/80 border-purple-700/60";
                const name = m.name || (typ + " " + (i + 1));
                const isVis = m.visible !== false;
                const isLock = !!m.locked;
                const dims = Math.round(m.w) + "×" + Math.round(m.h) + " px";

                const borderCls = sel ? "bg-purple-900/50 border-purple-400 shadow-sm" : "bg-gray-900/80 hover:bg-gray-700/70 border-gray-700";
                
                const eyeSvg = isVis ? 
                    '<svg class="w-3.5 h-3.5 text-gray-300 hover:text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>' :
                    '<svg class="w-3.5 h-3.5 text-gray-600 hover:text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>';

                const lockSvg = isLock ?
                    '<svg class="w-3.5 h-3.5 text-amber-400 hover:text-amber-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>' :
                    '<svg class="w-3.5 h-3.5 text-gray-500 hover:text-gray-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11"></rect><path d="M7 11V7a5 5 0 0 1 9.9-1"></path></svg>';

                return `<div class="mask-list-item flex items-center gap-2 px-2 py-1.5 cursor-pointer transition-colors border rounded-none ${borderCls}" data-mask-id="${m.id}">` +
                    `<button type="button" class="mask-vis-btn p-1 flex items-center justify-center hover:bg-gray-700/60 transition-colors" data-mask-id="${m.id}" title="${isVis ? 'Hide mask overlay' : 'Show mask overlay'}">${eyeSvg}</button>` +
                    `<button type="button" class="mask-lock-btn p-1 flex items-center justify-center hover:bg-gray-700/60 transition-colors" data-mask-id="${m.id}" title="${isLock ? 'Unlock mask' : 'Lock mask (prevent drag/resize)'}">${lockSvg}</button>` +
                    `<span class="w-3 h-3 flex-shrink-0 border" style="background:${mode === 'guide' ? 'transparent' : (m.color||'#000')}; border-color:${mode === 'guide' ? '#06b6d4' : '#6b7280'}"></span>` +
                    `<input type="text" class="mask-name-input bg-transparent text-xs font-semibold text-gray-200 border-b border-transparent focus:border-purple-400 focus:bg-gray-950 px-1 py-0.5 w-24 truncate" value="${escapeHtml(name)}" data-mask-id="${m.id}" title="Click to rename mask">` +
                    `<span class="text-[10px] px-1.5 py-0.2 border uppercase font-semibold ${modeBadgeClass}">${modeLabel}</span>` +
                    `<span class="text-xs text-gray-400 font-mono ml-auto whitespace-nowrap">${dims}</span>` +
                    `<button type="button" class="mask-up-btn text-xs text-gray-400 hover:text-white px-1 py-0.5 hover:bg-gray-700" data-mask-id="${m.id}" title="Move up / bring forward">&#9650;</button>` +
                    `<button type="button" class="mask-down-btn text-xs text-gray-400 hover:text-white px-1 py-0.5 hover:bg-gray-700" data-mask-id="${m.id}" title="Move down / send backward">&#9660;</button>` +
                    `<button type="button" class="mask-del-item-btn text-xs font-bold text-red-400 hover:text-red-200 px-1.5 py-0.5 hover:bg-red-900/60" data-mask-id="${m.id}" title="Delete mask">&#10005;</button>` +
                `</div>`;
            }).join("");

            // Wire up item clicks
            body.querySelectorAll(".mask-list-item").forEach(item => {
                item.addEventListener("click", (e) => {
                    if (e.target.closest('.mask-vis-btn, .mask-lock-btn, .mask-name-input, .mask-up-btn, .mask-down-btn, .mask-del-item-btn')) return;
                    const maskId = item.dataset.maskId;
                    if (maskId) {
                        state.canvasState.selectedMaskId = maskId;
                        state.canvasState.maskMode = null;
                        updateMaskModeButtons();
                        syncSelectedMaskProperties();
                        updateMaskList();
                        drawMainCanvas();
                    }
                });
            });

            // Visibility
            body.querySelectorAll(".mask-vis-btn").forEach(btn => {
                btn.addEventListener("click", (e) => {
                    e.stopPropagation();
                    const mask = masks.find(m => String(m.id) === String(btn.dataset.maskId));
                    if (mask) {
                        mask.visible = mask.visible === false ? true : false;
                        updateMaskList();
                        drawMainCanvas();
                        saveState();
                    }
                });
            });

            // Lock
            body.querySelectorAll(".mask-lock-btn").forEach(btn => {
                btn.addEventListener("click", (e) => {
                    e.stopPropagation();
                    const mask = masks.find(m => String(m.id) === String(btn.dataset.maskId));
                    if (mask) {
                        mask.locked = !mask.locked;
                        updateMaskList();
                        syncSelectedMaskProperties();
                        drawMainCanvas();
                        saveState();
                    }
                });
            });

            // Rename
            body.querySelectorAll(".mask-name-input").forEach(input => {
                input.addEventListener("click", (e) => e.stopPropagation());
                input.addEventListener("change", (e) => {
                    e.stopPropagation();
                    const mask = masks.find(m => String(m.id) === String(input.dataset.maskId));
                    if (mask) {
                        mask.name = String(e.target.value || '').trim() || (mask.type === "polygon" ? "Polygon" : mask.type === "ellipse" ? "Ellipse" : "Rectangle");
                        saveState();
                        syncSelectedMaskProperties();
                    }
                });
            });

            // Move Up
            body.querySelectorAll(".mask-up-btn").forEach(btn => {
                btn.addEventListener("click", (e) => {
                    e.stopPropagation();
                    const idx = masks.findIndex(m => String(m.id) === String(btn.dataset.maskId));
                    if (idx > 0) {
                        const temp = masks[idx];
                        masks[idx] = masks[idx - 1];
                        masks[idx - 1] = temp;
                        updateMaskList();
                        drawMainCanvas();
                        saveState();
                    }
                });
            });

            // Move Down
            body.querySelectorAll(".mask-down-btn").forEach(btn => {
                btn.addEventListener("click", (e) => {
                    e.stopPropagation();
                    const idx = masks.findIndex(m => String(m.id) === String(btn.dataset.maskId));
                    if (idx >= 0 && idx < masks.length - 1) {
                        const temp = masks[idx];
                        masks[idx] = masks[idx + 1];
                        masks[idx + 1] = temp;
                        updateMaskList();
                        drawMainCanvas();
                        saveState();
                    }
                });
            });

            // Delete
            body.querySelectorAll(".mask-del-item-btn").forEach(btn => {
                btn.addEventListener("click", (e) => {
                    e.stopPropagation();
                    const idx = masks.findIndex(m => String(m.id) === String(btn.dataset.maskId));
                    if (idx >= 0) {
                        const delId = masks[idx].id;
                        masks.splice(idx, 1);
                        if (String(state.canvasState.selectedMaskId) === String(delId)) {
                            state.canvasState.selectedMaskId = null;
                            state.canvasState.maskMode = null;
                            state.canvasState.maskDrawing = false;
                            state.canvasState.maskPreview = null;
                            state.canvasState.maskStart = null;
                            state.canvasState.maskDragging = false;
                            state.canvasState.maskResizing = false;
                            updateMaskModeButtons();
                        }
                        syncSelectedMaskProperties();
                        updateMaskList();
                        drawMainCanvas();
                        saveState();
                    }
                });
            });
        };

        const syncCanvasMapSource = (canvasMap, project) => {
            if (canvasMap.sourceMapId == null || canvasMap.sourceProjectId != null && String(canvasMap.sourceProjectId) !== String(project.id)) return;
            const sourceMap = project.pixelMaps?.find(map => String(map.id) === String(canvasMap.sourceMapId));
            if (!sourceMap) return;
            const sourceCopy = JSON.parse(JSON.stringify(sourceMap));
            if (sourceMap.details?.logo?.imageObject) {
                sourceCopy.details.logo.imageObject = sourceMap.details.logo.imageObject;
            }
            const instanceState = {
                id: canvasMap.id,
                sourceMapId: canvasMap.sourceMapId,
                sourceProjectId: canvasMap.sourceProjectId,
                x: canvasMap.x,
                y: canvasMap.y,
                outputScaleX: canvasMap.outputScaleX ?? 1,
                outputScaleY: canvasMap.outputScaleY ?? 1,
                cropLeft: canvasMap.cropLeft,
                cropRight: canvasMap.cropRight,
                cropTop: canvasMap.cropTop,
                cropBottom: canvasMap.cropBottom,
                sliceLeft: canvasMap.sliceLeft,
                sliceRight: canvasMap.sliceRight
            };
            Object.assign(canvasMap, sourceCopy, instanceState);
            const calcs = calculateLayout(sourceMap);
            canvasMap.calcs = calcs;
            canvasMap.width = calcs.totalResWidth * instanceState.outputScaleX;
            canvasMap.height = calcs.totalResHeight * instanceState.outputScaleY;
        };

        const layoutCanvasWorkspace = (outputMap, zoom, panX, panY, rulerSize) => {
            const stage = document.getElementById('canvas-regions-stage');
            const wrapper = document.getElementById('main-canvas-wrapper');
            if (!outputMap || !stage || !wrapper) return;
            const gap = Math.max(20, Number(outputMap.regionGap) || 20);
            const vertical = outputMap.regionLayout === 'vertical';
            let cursorX = panX + rulerSize;
            let cursorY = panY + rulerSize;
            let stageWidth = 0;
            let stageHeight = 0;
            let activeOffsetX = 0;
            let activeOffsetY = 0;

            outputMap.regions.forEach(region => {
                const frame = stage.querySelector(`[data-workspace-region-id="${region.id}"]`);
                if (!frame) return;
                const displayWidth = Math.max(1, Math.round(region.width * zoom));
                const displayHeight = Math.max(1, Math.round(region.height * zoom));
                if (region.id === outputMap.activeRegionId) {
                    activeOffsetX = cursorX - (panX + rulerSize);
                    activeOffsetY = cursorY - (panY + rulerSize);
                }
                frame.style.left = `${Math.round(cursorX)}px`;
                frame.style.top = `${Math.round(cursorY)}px`;
                frame.style.width = `${displayWidth}px`;
                frame.style.height = `${displayHeight}px`;
                stageWidth = Math.max(stageWidth, cursorX + displayWidth);
                stageHeight = Math.max(stageHeight, cursorY + displayHeight);
                if (vertical) cursorY += displayHeight + gap;
                else cursorX += displayWidth + gap;
            });

            stage.style.width = `${Math.max(wrapper.clientWidth, Math.ceil(stageWidth + gap))}px`;
            stage.style.height = `${Math.max(wrapper.clientHeight, Math.ceil(stageHeight + gap))}px`;
            state.canvasState.regionOffsetX = activeOffsetX;
            state.canvasState.regionOffsetY = activeOffsetY;
        };

        const outputBitmapCache = PixelLogicRendering.createBitmapCache();
        const getOutputMapBitmap = (map, options) => {
            const render = () => {
                const canvas = document.createElement('canvas');
                drawVisualizerCanvas(canvas, map, options);
                return canvas;
            };
            // Coordinates (including those inside composites) depend on the active workspace.
            if (map.details?.coords?.enabled || map.composite?.enabled) return render();
            const key = PixelLogicRendering.bitmapKey(map, {
                options,
                cap: localStorage.getItem('pixi-logic-preview-cap-mp'),
                quality: state.visualizerState.previewScale,
                logoReady: pixelLogicLogoImage.complete && pixelLogicLogoImage.naturalWidth > 0
            });
            return outputBitmapCache.get(key, render);
        };
        document.fonts.addEventListener('loadingdone', () => {
            outputBitmapCache.clear();
            redrawAffectedVisuals();
        });

        const drawInactiveCanvasPreviews = (outputMap, project) => {
            if (!outputMap || !project) return;
            outputMap.regions.forEach(region => {
                if (region.id === outputMap.activeRegionId) return;
                const preview = document.querySelector(`[data-preview-region-id="${region.id}"]`);
                if (!preview) return;
                const previewScale = Math.min(1, 800 / Math.max(1, region.width), 600 / Math.max(1, region.height));
                preview.width = Math.max(1, Math.round(region.width * previewScale));
                preview.height = Math.max(1, Math.round(region.height * previewScale));
                const previewCtx = preview.getContext('2d');
                previewCtx.fillStyle = '#111827';
                previewCtx.fillRect(0, 0, preview.width, preview.height);
                (region.maps || []).forEach(map => {
                    syncCanvasMapSource(map, project);
                    const mapScale = Math.min(1, 512 / Math.max(1, map.width || 1), 512 / Math.max(1, map.height || 1));
                    const tempCanvas = getOutputMapBitmap(map, { fixedScale: mapScale });
                    if (tempCanvas.width > 0 && tempCanvas.height > 0) {
                        previewCtx.drawImage(
                            tempCanvas,
                            Math.round((map.x || 0) * previewScale),
                            Math.round((map.y || 0) * previewScale),
                            Math.max(1, Math.round((map.width || tempCanvas.width) * previewScale)),
                            Math.max(1, Math.round((map.height || tempCanvas.height) * previewScale))
                        );
                    }
                });
                previewCtx.save();
                previewCtx.scale(previewScale, previewScale);
                try { drawCanvasDrawingsToContext(previewCtx, region); } catch (_) {}
                previewCtx.restore();
            });
        };

        const outputFrameRenderer = PixelLogicRendering.createFrameRenderer(
            () => drawMainCanvasNow(),
            callback => requestAnimationFrame(callback),
            id => cancelAnimationFrame(id)
        );
        const drawMainCanvas = () => {
            if (state.canvasState._mouseIsDown) outputFrameRenderer.request();
            else outputFrameRenderer.flush();
        };
        const drawMainCanvasNow = () => {
            const project = state.projects.find(p => p.id === state.activeProjectId);
            const canvas = document.getElementById('main-canvas');
            const container = document.getElementById('main-canvas-container');
            const drawOverlay = document.getElementById('draw-overlay');
            if(!project || !canvas || !container) return;
            const activeCanvas = getActiveCanvas();
            if(!activeCanvas) return;
            
            const { zoom, panX, panY } = state.canvasState;
            const rulerSize = state.canvasState.rulers ? 30 : 0;

            const activeOutputMap = getActiveOutputMap();
            layoutCanvasWorkspace(activeOutputMap, zoom, panX, panY, rulerSize);
            drawInactiveCanvasPreviews(activeOutputMap, project);

            container.style.width = `${activeCanvas.width}px`;
            container.style.height = `${activeCanvas.height}px`;
            // First translate in screen pixels (including ruler offset), then scale.
            // This yields: screen = world * zoom + (pan + ruler),
            // and the inverse used in mouse handlers: world = (screen - (pan + ruler)) / zoom.
            const regionOffsetX = state.canvasState.regionOffsetX || 0;
            const regionOffsetY = state.canvasState.regionOffsetY || 0;
            container.style.transform = `translate(${panX + rulerSize + regionOffsetX}px, ${panY + rulerSize + regionOffsetY}px) scale(${zoom})`;
            container.style.transformOrigin = 'top left';

            const ctx = canvas.getContext('2d');
            if (canvas.width !== activeCanvas.width || canvas.height !== activeCanvas.height) {
                 canvas.width = activeCanvas.width;
                 canvas.height = activeCanvas.height;
            }
            if (drawOverlay) {
                // Keep overlay same size as main canvas so world coords line up
                if (drawOverlay.width !== activeCanvas.width || drawOverlay.height !== activeCanvas.height) {
                    drawOverlay.width = activeCanvas.width;
                    drawOverlay.height = activeCanvas.height;
                }
            }
            
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            
            activeCanvas.maps.forEach(map => {
                syncCanvasMapSource(map, project);
                // Force full resolution (ignore preview quality scale)
                const tempCanvas = getOutputMapBitmap(map, { forceFullRes: true });
                if (tempCanvas.width > 0 && tempCanvas.height > 0) {
                    const sw0 = tempCanvas.width;
                    const sh0 = tempCanvas.height;
                    const sL = Math.max(0, Math.floor((map.cropLeft ?? map.sliceLeft ?? 0)));
                    const sR = Math.max(0, Math.floor((map.cropRight ?? map.sliceRight ?? 0)));
                    const sT = Math.max(0, Math.floor((map.cropTop ?? 0)));
                    const sB = Math.max(0, Math.floor((map.cropBottom ?? 0)));
                    // Allow full crop to zero, clamp totals to source dimensions
                    const totalCropW = Math.min(sw0, sL + sR);
                    const totalCropH = Math.min(sh0, sT + sB);
                    const srcX = Math.min(sL, sw0);
                    const srcY = Math.min(sT, sh0);
                    const srcW = Math.max(0, sw0 - totalCropW);
                    const srcH = Math.max(0, sh0 - totalCropH);
                    if (srcW === 0 || srcH === 0) return; // nothing visible after crop
                    // Cropping: keep same placement scale; reduce destination rect accordingly
                    const scaleX = map.width / sw0;
                    const scaleY = map.height / sh0;
                    const destX = map.x + scaleX * srcX;
                    const destW = scaleX * srcW;
                    const destY = map.y + scaleY * srcY;
                    const destH = scaleY * srcH;
                    ctx.drawImage(tempCanvas, srcX, srcY, srcW, srcH, destX, destY, destW, destH);

                    // Processor patch overlay on Output Canvas (if enabled)
                    try {
                        const pp = activeCanvas.processorPatch || {};
                        const cfg = activeCanvas.processorConfig || {};
                        if (pp.showOverlay) {
                            const style = Object.assign({ color: '#ff0000', width: 5, lineStyle: 'solid', wiringPattern: 'H-TL' }, pp.overlayStyle || {});
                            const calcs = (typeof calculateLayout === 'function') ? calculateLayout(map) : null;
                            if (calcs && calcs.panelResWidth && calcs.panelResHeight && calcs.panelsHorizontally && calcs.panelsVertically) {
                                // Visible panel counts after crop
                                const pW = Math.max(1, Math.floor(calcs.panelResWidth));
                                const pH = Math.max(1, Math.floor(calcs.panelResHeight));
                                const panelsX = Math.max(1, Math.floor(calcs.panelsHorizontally));
                                const panelsY = Math.max(1, Math.floor(calcs.panelsVertically));
                                const offColsLeft = Math.min(panelsX, Math.ceil(sL / pW));
                                const offColsRight = Math.min(panelsX - offColsLeft, Math.ceil(sR / pW));
                                const offRowsTop = Math.min(panelsY, Math.ceil(sT / pH));
                                const offRowsBottom = Math.min(panelsY - offRowsTop, Math.ceil(sB / pH));
                                const visCols = Math.max(0, panelsX - offColsLeft - offColsRight);
                                const visRows = Math.max(0, panelsY - offRowsTop - offRowsBottom);
                                if (visCols > 0 && visRows > 0) {
                                    // Destination per-panel size
                                    const dPW = destW / visCols;
                                    const dPH = destH / visRows;
                                    // Stroke style
                                    ctx.save();
                                    ctx.strokeStyle = style.color;
                                    ctx.lineWidth = Math.max(1, style.width);
                                    ctx.lineJoin = 'round';
                                    ctx.lineCap = 'round';
                                    if (style.lineStyle === 'dashed') ctx.setLineDash([Math.max(8, style.width*2), Math.max(6, style.width*1.5)]);
                                    else if (style.lineStyle === 'dotted') ctx.setLineDash([style.width, Math.max(6, style.width*2)]);
                                    // Arrow helper
                                    const drawHead = (x1,y1,x2,y2) => {
                                        const headLen = Math.max(6, Math.round(style.width * 2));
                                        const ang = Math.atan2(y2 - y1, x2 - x1);
                                        ctx.beginPath();
                                        ctx.moveTo(x2, y2);
                                        ctx.lineTo(x2 - headLen * Math.cos(ang - Math.PI/6), y2 - headLen * Math.sin(ang - Math.PI/6));
                                        ctx.moveTo(x2, y2);
                                        ctx.lineTo(x2 - headLen * Math.cos(ang + Math.PI/6), y2 - headLen * Math.sin(ang + Math.PI/6));
                                        ctx.stroke();
                                    };
                                    const isH = String(style.wiringPattern||'H-TL').startsWith('H-');
                                    const startCorner = String(style.wiringPattern||'H-TL').slice(2);
                                    if (isH) {
                                        const topFirst = (startCorner === 'TL' || startCorner === 'TR');
                                        const leftStart = (startCorner === 'TL' || startCorner === 'BL');
                                        const rowOrder = [...Array(visRows).keys()];
                                        if (!topFirst) rowOrder.reverse();
                                        rowOrder.forEach((rowAbsIdx, relIdx) => {
                                            const y = destY + rowAbsIdx * dPH + dPH/2;
                                            const ltr = (relIdx % 2 === 0) ? leftStart : !leftStart;
                                            const xStart = ltr ? (destX + dPW/2) : (destX + destW - dPW/2);
                                            const xEnd = ltr ? (destX + destW - dPW/2) : (destX + dPW/2);
                                            ctx.beginPath();
                                            ctx.moveTo(xStart, y);
                                            ctx.lineTo(xEnd, y);
                                            ctx.stroke();
                                            drawHead(xStart, y, xEnd, y);
                                            // connector down to next row
                                            const nextRowAbs = rowOrder[relIdx + 1];
                                            if (nextRowAbs != null) {
                                                const y2 = destY + nextRowAbs * dPH + dPH/2;
                                                const xConn = xEnd;
                                                ctx.beginPath();
                                                ctx.moveTo(xConn, y);
                                                ctx.lineTo(xConn, y2);
                                                ctx.stroke();
                                            }
                                        });
                                    } else {
                                        // vertical
                                        const leftFirst = (startCorner === 'TL' || startCorner === 'BL');
                                        const topStart = (startCorner === 'TL' || startCorner === 'TR');
                                        const colOrder = [...Array(visCols).keys()];
                                        if (!leftFirst) colOrder.reverse();
                                        colOrder.forEach((colAbsIdx, relIdx) => {
                                            const x = destX + colAbsIdx * dPW + dPW/2;
                                            const ttb = (relIdx % 2 === 0) ? topStart : !topStart;
                                            const yStart = ttb ? (destY + dPH/2) : (destY + destH - dPH/2);
                                            const yEnd = ttb ? (destY + destH - dPH/2) : (destY + dPH/2);
                                            ctx.beginPath();
                                            ctx.moveTo(x, yStart);
                                            ctx.lineTo(x, yEnd);
                                            ctx.stroke();
                                            drawHead(x, yStart, x, yEnd);
                                            const nextColAbs = colOrder[relIdx + 1];
                                            if (nextColAbs != null) {
                                                const x2 = destX + nextColAbs * dPW + dPW/2;
                                                const yConn = yEnd;
                                                ctx.beginPath();
                                                ctx.moveTo(x, yConn);
                                                ctx.lineTo(x2, yConn);
                                                ctx.stroke();
                                            }
                                        });
                                    }

                                    // Per-port bounding boxes/labels for this map
                                    try {
                                        const assigns = Array.isArray(pp.assignments) ? pp.assignments : [];
                                        const mine = assigns.filter(a => String(a.mapId) === String(map.id));
                                        if (mine.length) {
                                            ctx.setLineDash([]);
                                            ctx.lineWidth = 1;
                                            const sX = scaleX; // map.width / sw0
                                            const sY = scaleY; // map.height / sh0
                                            mine.forEach(a => {
                                                const dx = destX + sX * (a.relX + sL);
                                                const dy = destY + sY * (a.relY + sT);
                                                const dw = sX * a.w;
                                                const dh = sY * a.h;
                                                const portColor = a.portColor || '#ffffff';
                                                ctx.strokeStyle = portColor;
                                                ctx.strokeRect(dx + 0.5, dy + 0.5, Math.max(0, dw - 1), Math.max(0, dh - 1));
                                                const text = `U${a.unit}-P${a.port}`;
                                                const fs = Math.max(8, Math.round(Math.min(dPW, dPH) * 0.35));
                                                ctx.font = `${fs}px Inter`;
                                                const pad = 2;
                                                const tw = ctx.measureText(text).width + pad*2;
                                                const th = fs + pad*2;
                                                const cx = dx + dw/2 - tw/2;
                                                const cy = dy + dh/2 - th/2;
                                                ctx.fillStyle = 'rgba(0,0,0,0.6)';
                                                ctx.fillRect(cx, cy, tw, th);
                                                ctx.fillStyle = portColor;
                                                ctx.fillText(text, cx + pad, cy + th - pad - 2);
                                            });
                                        }
                                    } catch(_) {}

                                    ctx.restore();
                                }
                            }
                        }
                    } catch(_) {}
                                    }
            });

            // Draw coordinates overlay labels on top of all map images
            activeCanvas.maps.forEach(map => {
                try {
                    const vr = getVisibleRectForMap(map);
                    if (!vr || vr.width <= 0 || vr.height <= 0) return;
                    const destX = vr.left, destY = vr.top, destW = vr.width, destH = vr.height;
                    const baseFs = state.canvasState.coordFontSize || 12;
                    const fs = Math.max(8, Math.round(baseFs / zoom));
                    ctx.font = fs + "px Inter, Arial";
                    const gaps = computeNearestGapsForMap(activeCanvas, map);
                    const parts = ["X: " + Math.round(map.x), "Y: " + Math.round(map.y)];
                    if (gaps && gaps.hGap != null && gaps.hGap > 0) parts.push("H: " + Math.round(gaps.hGap) + " px");
                    if (gaps && gaps.vGap != null && gaps.vGap > 0) parts.push("V: " + Math.round(gaps.vGap) + " px");
                    const label = parts.join("  ");
                    const pad = 4 / zoom;
                    const tw = ctx.measureText(label).width + pad * 2;
                    const th = fs + pad * 2;
                    const visLeft = destX, visTop = destY, visRight = destX + destW, visBottom = destY + destH;
                    let lx = visLeft;
                    let ly = visTop - th - 2 / zoom; // above
                    if (ly < 0) {
                        ly = visBottom + 2 / zoom; // below
                        if (ly + th > canvas.height) {
                            lx = visLeft - tw - 2 / zoom;
                            ly = Math.max(0, visTop);
                            if (lx < 0) {
                                lx = visRight + 2 / zoom;
                                ly = Math.max(0, visTop);
                                if (lx + tw > canvas.width) {
                                    lx = Math.max(0, canvas.width - tw - 2 / zoom);
                                }
                            }
                        }
                    }
                    lx = Math.max(0, Math.min(lx, canvas.width - tw));
                    ly = Math.max(0, Math.min(ly, canvas.height - th));
                    ctx.fillStyle = "rgba(0,0,0,0.6)";
                    ctx.fillRect(lx, ly, tw, th);
                    ctx.fillStyle = "#ffffff";
                    ctx.fillText(label, lx + pad, ly + fs + (pad - 2 / zoom));
                } catch (_) {}
            });

            // Draw selection outlines and corner handles on top of all maps so active selection is never obscured
            const selIds = Array.isArray(state.canvasState.selectedMapIds) ? state.canvasState.selectedMapIds : [];
            const primarySelId = state.canvasState.selectedMapId;

            activeCanvas.maps.forEach(map => {
                const isPrimary = primarySelId != null && String(map.id) === String(primarySelId);
                const isMulti = !isPrimary && selIds.some(id => String(id) === String(map.id));
                if (!isPrimary && !isMulti) return;

                const vr = getVisibleRectForMap(map);
                if (!vr || vr.width <= 0 || vr.height <= 0) return;
                const destX = vr.left, destY = vr.top, destW = vr.width, destH = vr.height;

                ctx.save();
                if (isPrimary) {
                    // Double outline (dark contrast border + gold highlight)
                    ctx.strokeStyle = "#000000";
                    ctx.lineWidth = 5 / zoom;
                    ctx.strokeRect(destX, destY, destW, destH);
                    ctx.strokeStyle = "#eab308";
                    ctx.lineWidth = 3 / zoom;
                    ctx.strokeRect(destX, destY, destW, destH);

                    // Corner selection handles
                    const handleSize = Math.max(6, Math.min(12, 8 / zoom));
                    ctx.fillStyle = "#ffffff";
                    ctx.strokeStyle = "#000000";
                    ctx.lineWidth = 1.5 / zoom;
                    const corners = [
                        [destX, destY],
                        [destX + destW, destY],
                        [destX, destY + destH],
                        [destX + destW, destY + destH]
                    ];
                    corners.forEach(([cx, cy]) => {
                        ctx.fillRect(cx - handleSize / 2, cy - handleSize / 2, handleSize, handleSize);
                        ctx.strokeRect(cx - handleSize / 2, cy - handleSize / 2, handleSize, handleSize);
                    });
                } else if (isMulti) {
                    ctx.strokeStyle = "#000000";
                    ctx.lineWidth = 4 / zoom;
                    ctx.strokeRect(destX, destY, destW, destH);
                    ctx.strokeStyle = "#38bdf8";
                    ctx.lineWidth = 2 / zoom;
                    ctx.strokeRect(destX, destY, destW, destH);
                }
                ctx.restore();
            });

            // Draw crop selection rectangle overlay (if any)
            if (state.canvasState.cropSelecting && state.canvasState.cropRect) {
                const r = state.canvasState.cropRect;
                const x = Math.min(r.x1, r.x2);
                const y = Math.min(r.y1, r.y2);
                const w = Math.abs(r.x2 - r.x1);
                const h = Math.abs(r.y2 - r.y1);
                if (isFinite(w) && isFinite(h) && w >= 0 && h >= 0) {
                    ctx.save();
                    ctx.setLineDash([6 / zoom, 4 / zoom]);
                    ctx.lineWidth = 2 / zoom;
                    ctx.strokeStyle = 'rgba(255, 255, 0, 0.9)';
                    ctx.strokeRect(x, y, w, h);
                    ctx.fillStyle = 'rgba(255, 255, 0, 0.15)';
                    ctx.fillRect(x, y, w, h);
                    ctx.restore();
                }
            }

            if (state.canvasState.snapLines.length > 0) {
                ctx.strokeStyle = 'rgba(234, 179, 8, 0.9)';
                ctx.lineWidth = 2 / zoom;
                ctx.beginPath();
                state.canvasState.snapLines.forEach(line => {
                    ctx.moveTo(line.x1, line.y1);
                    ctx.lineTo(line.x2, line.y2);
                });
                ctx.stroke();
            }

            if (state.canvasState.grid) {
                drawCanvasGrid();
            } else {
                const gridCanvas = document.getElementById('grid-canvas');
                if(gridCanvas) gridCanvas.style.display = 'none';
            }

            if (state.canvasState.rulers) {
                const pointer = state.canvasState.rulerPointer;
                drawRulers(pointer?.x, pointer?.y);
            } else {
                const rulerTop = document.getElementById('ruler-top');
                const rulerLeft = document.getElementById('ruler-left');
                if(rulerTop) rulerTop.style.display = 'none';
                if(rulerLeft) rulerLeft.style.display = 'none';
            }

            // Draw gap measurement guides if any (live), otherwise the last persistent guides.
            // If none present, draw transient guides for the selected map so users can see gap text between maps.
            try {
                const guides = state.canvasState.gapGuides;
                const persistent = state.canvasState.persistentGuides;
                let gsrc = guides || persistent;
                // If no guides present, compute transient guides for selected map
                if (!gsrc && state.canvasState.selectedMapId) {
                    const activeCanvas = getActiveCanvas();
                    const sel = activeCanvas?.maps?.find(m => String(m.id) === String(state.canvasState.selectedMapId));
                    if (sel) gsrc = computeGapGuidesForTarget(activeCanvas, sel);
                }
                if (gsrc) {
                    ctx.save();
                    ctx.setLineDash([6/zoom, 6/zoom]);
                    ctx.lineWidth = 2/zoom;
                    ctx.strokeStyle = 'rgba(59, 130, 246, 0.9)';
                    ctx.fillStyle = 'rgba(17,24,39,0.8)';
                    const drawGuide = (g) => {
                        if (!g) return;
                        ctx.beginPath();
                        ctx.moveTo(g.x1, g.y1);
                        ctx.lineTo(g.x2, g.y2);
                        ctx.stroke();
                        const fs = Math.max(10, Math.round(12/zoom));
                        ctx.font = `${fs}px Inter, Arial`;
                        const pad = 4/zoom;
                        const tw = ctx.measureText(g.text).width + pad*2;
                        const th = fs + pad*2;
                        const bx = g.tx - tw/2;
                        const by = g.ty - th/2;
                        ctx.fillRect(bx, by, tw, th);
                        ctx.fillStyle = '#ffffff';
                        ctx.fillText(g.text, bx + pad, by + fs + (pad - 2/zoom));
                        ctx.fillStyle = 'rgba(17,24,39,0.8)';
                    };
                    drawGuide(gsrc.h);
                    drawGuide(gsrc.v);
                    ctx.restore();
                }
            } catch(_) {}


            // Draw mask overlays on main canvas
            try {
                const activeCanvas = getActiveCanvas();
                if (state.canvasState.showMasks && activeCanvas?.masks?.length > 0) {
                    drawMaskOverlays(ctx, activeCanvas.masks, activeCanvas.width, activeCanvas.height);
                }
                // Draw mask preview while drawing
                if (state.canvasState.maskPreview) {
                    drawMaskOverlays(ctx, [state.canvasState.maskPreview], canvas.width, canvas.height, { selectedId: null });
                }
                // Draw polygon points in progress
                if (state.canvasState.maskMode === "polygon" && state.canvasState.maskPolygonPoints.length > 0) {
                    ctx.save();
                    ctx.strokeStyle = "#a855f7";
                    ctx.lineWidth = 2 / zoom;
                    ctx.setLineDash([4/zoom, 3/zoom]);
                    ctx.beginPath();
                    const pts = state.canvasState.maskPolygonPoints;
                    ctx.moveTo(pts[0].x, pts[0].y);
                    for (let i = 1; i < pts.length; i++) ctx.lineTo(pts[i].x, pts[i].y);
                    ctx.stroke();
                    ctx.fillStyle = "#a855f7";
                    pts.forEach(pt => { ctx.beginPath(); ctx.arc(pt.x, pt.y, 4/zoom, 0, Math.PI*2); ctx.fill(); });
                    // Snap indicator: highlight first point when 3+ points exist
                    if (pts.length >= 3) {
                        ctx.beginPath();
                        ctx.arc(pts[0].x, pts[0].y, (state.canvasState.maskSnapThreshold || 12) / zoom, 0, Math.PI*2);
                        ctx.strokeStyle = "#22c55e";
                        ctx.lineWidth = 2 / zoom;
                        ctx.setLineDash([]);
                        ctx.stroke();
                        // Green filled circle at first point
                        ctx.beginPath();
                        ctx.arc(pts[0].x, pts[0].y, 6/zoom, 0, Math.PI*2);
                        ctx.fillStyle = "#22c55e";
                        ctx.fill();
                    }
                    ctx.restore();
                }
            } catch(_) {}

            // After base render, draw manual overlay strokes and preview
            try { renderDrawOverlay(); } catch(_) {}
        };

        // Compute the visible rectangle of a map accounting for cropping
        const getVisibleRectForMap = (m) => {
            if (!m) return null;
            const sw0 = Math.max(1, Math.floor(m?.calcs?.totalResWidth || m.width || 1));
            const sh0 = Math.max(1, Math.floor(m?.calcs?.totalResHeight || m.height || 1));
            const sL = Math.max(0, Math.floor(m.cropLeft ?? m.sliceLeft ?? 0));
            const sR = Math.max(0, Math.floor(m.cropRight ?? m.sliceRight ?? 0));
            const sT = Math.max(0, Math.floor(m.cropTop ?? 0));
            const sB = Math.max(0, Math.floor(m.cropBottom ?? 0));
            const totalCropW = Math.min(sw0, sL + sR);
            const totalCropH = Math.min(sh0, sT + sB);
            const srcW = Math.max(0, sw0 - totalCropW);
            const srcH = Math.max(0, sh0 - totalCropH);
            if (srcW === 0 || srcH === 0) return { left: m.x, top: m.y, right: m.x, bottom: m.y, width: 0, height: 0 };
            const scaleX = m.width / sw0;
            const scaleY = m.height / sh0;
            const left = m.x + scaleX * sL;
            const top = m.y + scaleY * sT;
            const right = left + scaleX * srcW;
            const bottom = top + scaleY * srcH;
            return { left, top, right, bottom, width: right - left, height: bottom - top };
        };

        // For a given map, compute nearest horizontal and vertical gap (in pixels) to any other map that overlaps on the perpendicular axis.
        const computeNearestGapsForMap = (canvasObj, target) => {
            if (!canvasObj || !target || !Array.isArray(canvasObj.maps)) return { hGap: null, vGap: null };
            const self = getVisibleRectForMap(target);
            let hGap = null, vGap = null;
            canvasObj.maps.forEach(other => {
                if (!other || other.id === target.id) return;
                const r = getVisibleRectForMap(other);
                // Horizontal gap if vertical overlap exists
                const vOverlap = Math.min(self.bottom, r.bottom) - Math.max(self.top, r.top);
                if (vOverlap > 0) {
                    if (self.right <= r.left) {
                        const d = r.left - self.right; hGap = (hGap == null) ? d : Math.min(hGap, d);
                    } else if (r.right <= self.left) {
                        const d = self.left - r.right; hGap = (hGap == null) ? d : Math.min(hGap, d);
                    }
                }
                // Vertical gap if horizontal overlap exists
                const hOverlap = Math.min(self.right, r.right) - Math.max(self.left, r.left);
                if (hOverlap > 0) {
                    if (self.bottom <= r.top) {
                        const d = r.top - self.bottom; vGap = (vGap == null) ? d : Math.min(vGap, d);
                    } else if (r.bottom <= self.top) {
                        const d = self.top - r.bottom; vGap = (vGap == null) ? d : Math.min(vGap, d);
                    }
                }
            });
            return { hGap, vGap };
        };

        // Compute full gap guide geometry for a target map relative to others
        // Returns { h?: {x1,y1,x2,y2,text,tx,ty}, v?: {...} }
        const computeGapGuidesForTarget = (canvasObj, target) => {
            if (!canvasObj || !target || !Array.isArray(canvasObj.maps)) return null;
            const self = getVisibleRectForMap(target);
            let bestH = null, bestV = null;
            canvasObj.maps.forEach(other => {
                if (!other || other.id === target.id) return;
                const r = getVisibleRectForMap(other);
                // Horizontal (requires vertical overlap)
                const vOverlap = Math.min(self.bottom, r.bottom) - Math.max(self.top, r.top);
                if (vOverlap > 0) {
                    let dist = null, x1, x2, y;
                    if (self.right <= r.left) { dist = r.left - self.right; x1 = self.right; x2 = r.left; }
                    else if (r.right <= self.left) { dist = self.left - r.right; x1 = r.right; x2 = self.left; }
                    if (dist != null) {
                        y = Math.max(self.top, r.top) + vOverlap/2;
                        if (!bestH || dist < bestH.dist) bestH = { dist, x1, x2, y };
                    }
                }
                // Vertical (requires horizontal overlap)
                const hOverlap = Math.min(self.right, r.right) - Math.max(self.left, r.left);
                if (hOverlap > 0) {
                    let dist = null, y1, y2, x;
                    if (self.bottom <= r.top) { dist = r.top - self.bottom; y1 = self.bottom; y2 = r.top; }
                    else if (r.bottom <= self.top) { dist = self.top - r.bottom; y1 = r.bottom; y2 = self.top; }
                    if (dist != null) {
                        x = Math.max(self.left, r.left) + hOverlap/2;
                        if (!bestV || dist < bestV.dist) bestV = { dist, y1, y2, x };
                    }
                }
            });
            const out = {};
            if (bestH) out.h = { x1: bestH.x1, y1: bestH.y, x2: bestH.x2, y2: bestH.y, text: `${Math.round(bestH.dist)} px`, tx: (bestH.x1+bestH.x2)/2, ty: bestH.y };
            if (bestV) out.v = { x1: bestV.x, y1: bestV.y1, x2: bestV.x, y2: bestV.y2, text: `${Math.round(bestV.dist)} px`, tx: bestV.x, ty: (bestV.y1+bestV.y2)/2 };
            return (out.h || out.v) ? out : null;
        };

    // Draw a line with optional arrowheads on the given context
        

        // Draw a freehand pencil polyline and arrowheads at crossings
        

        // Render all saved strokes and current preview on overlay canvas
        const renderDrawOverlay = () => {
            const activeCanvas = getActiveCanvas();
            const overlay = document.getElementById('draw-overlay');
            if (!activeCanvas || !overlay) return;
            // Keep overlay dimensions in sync with world space so clearing is exact and previews don't smear when zoom/pan change.
            if (overlay.width !== activeCanvas.width || overlay.height !== activeCanvas.height) {
                overlay.width = activeCanvas.width;
                overlay.height = activeCanvas.height;
            }
            const ctx = overlay.getContext('2d');
            // Reset any transform/dash state before clearing to avoid leaving trails.
            ctx.setTransform(1, 0, 0, 1, 0, 0);
            ctx.setLineDash([]);
            ctx.clearRect(0, 0, overlay.width, overlay.height);
            const showLines = state.canvasState.drawing?.showLines !== false;
            const strokes = Array.isArray(activeCanvas.drawings) ? activeCanvas.drawings : [];
            if (showLines) {
                strokes.forEach(s => {
                    if (s.lineStyle === 'pencil' && Array.isArray(s.points) && s.points.length > 1) {
                        drawPencilPolyline(ctx, s.points, s.arrowPoints, s);
                    } else {
                        drawLineWithArrows(ctx, s.x1, s.y1, s.x2, s.y2, s);
                    }
                });
                // Highlight selected stroke if any
                const selIdx = state.canvasState.drawing?.selectedStrokeIndex;
                const selMany = Array.isArray(state.canvasState.drawing?.selectedStrokeIndices) ? state.canvasState.drawing.selectedStrokeIndices : [];
                const toHighlight = new Set();
                if (typeof selIdx === 'number' && selIdx >= 0 && selIdx < strokes.length) toHighlight.add(selIdx);
                selMany.forEach(i => { if (i >= 0 && i < strokes.length) toHighlight.add(i); });
                if (toHighlight.size > 0) {
                    ctx.save();
                    toHighlight.forEach(i => {
                        const s = strokes[i];
                        if (!s) return;
                        if (s.lineStyle === 'pencil' && Array.isArray(s.points) && s.points.length > 1) {
                            drawPencilPolyline(ctx, s.points, s.arrowPoints, {
                                color: '#00ffff',
                                width: Math.max(2, (s.width||2) + 3),
                                arrowSize: (s.arrowSize||1),
                                arrowStart: s.arrowStart,
                                arrowEnd: s.arrowEnd
                            });
                        } else {
                            drawLineWithArrows(ctx, s.x1, s.y1, s.x2, s.y2, { color: '#00ffff', width: Math.max(2, (s.width||2) + 3), lineStyle: s.lineStyle, arrowStart: s.arrowStart, arrowEnd: s.arrowEnd, arrowSize: s.arrowSize, arrowAngle: s.arrowAngle });
                        }
                    });
                    ctx.restore();
                }
            }
            // Preview (supports straight preview or pencil freehand path)
            const p = state.canvasState.drawing && state.canvasState.drawing.preview;
            const pPath = state.canvasState.drawing && state.canvasState.drawing.previewPath;
            if (pPath && state.canvasState.drawing.lineStyle === 'pencil') {
                drawPencilPolyline(ctx, pPath, state.canvasState.drawing.arrowPoints, {
                    color: state.canvasState.drawing.color,
                    width: state.canvasState.drawing.width,
                    arrowSize: state.canvasState.drawing.arrowSize,
                    arrowStart: state.canvasState.drawing.arrowStart,
                    arrowEnd: state.canvasState.drawing.arrowEnd
                });
            } else if (p) {
                // If snapping, show a different color for the preview
                let previewColor = state.canvasState.drawing.color;
                if (p.snapped) previewColor = '#00ff00'; // bright green for snap effect
                drawLineWithArrows(ctx, p.x1, p.y1, p.x2, p.y2, {
                    color: previewColor,
                    width: state.canvasState.drawing.width,
                    lineStyle: state.canvasState.drawing.lineStyle,
                    arrowSize: state.canvasState.drawing.arrowSize,
                    arrowStart: state.canvasState.drawing.arrowStart,
                    arrowEnd: state.canvasState.drawing.arrowEnd
                });
                // Draw a green snap dot at the snapped endpoint for clear feedback
                try {
                    const sp = state.canvasState.drawing.snapPoint;
                    if (sp && p.snapped) {
                        const zoom = state.canvasState.zoom || 1;
                        const r = Math.max(3, 6 / zoom);
                        ctx.save();
                        ctx.beginPath();
                        ctx.arc(sp.x, sp.y, r, 0, Math.PI * 2);
                        ctx.fillStyle = '#00ff00';
                        ctx.fill();
                        ctx.lineWidth = Math.max(1, 2 / zoom);
                        ctx.strokeStyle = '#0a0a0a';
                        ctx.stroke();
                        ctx.restore();
                    }
                } catch(_) {}
            }

            // Draw marquee selection rectangle if any (select mode)
            try {
                const drawCfg = state.canvasState.drawing || {};
                const mr = drawCfg.marqueeRect;
                if (drawCfg.selectEnabled && drawCfg.marqueeSelecting && mr) {
                    const x = Math.min(mr.x1, mr.x2);
                    const y = Math.min(mr.y1, mr.y2);
                    const w = Math.abs(mr.x2 - mr.x1);
                    const h = Math.abs(mr.y2 - mr.y1);
                    ctx.save();
                    ctx.setLineDash([6, 4]);
                    ctx.lineWidth = 1.5;
                    ctx.strokeStyle = 'rgba(59, 130, 246, 0.9)';
                    ctx.fillStyle = 'rgba(59, 130, 246, 0.15)';
                    ctx.strokeRect(x, y, w, h);
                    ctx.fillRect(x, y, w, h);
                    ctx.restore();
                }
            } catch(_) {}

            // Update Undo/Redo buttons states
            try {
                const undoBtn = document.getElementById('draw-undo');
                const redoBtn = document.getElementById('draw-redo');
                if (undoBtn) undoBtn.disabled = !(activeCanvas && Array.isArray(activeCanvas.drawings) && activeCanvas.drawings.length > 0);
                if (redoBtn) redoBtn.disabled = !(activeCanvas && Array.isArray(activeCanvas.drawingsRedo) && activeCanvas.drawingsRedo.length > 0);
            } catch(_) {}
        };

        // Sync selection UI and control values based on selected stroke or defaults
        function syncSelectionUIFromStroke() {
            try {
                const ac = getActiveCanvas();
                const drawCfg = state.canvasState.drawing || {};
                const selIdx = state.canvasState.drawing?.selectedStrokeIndex;
                const selMany = Array.isArray(state.canvasState.drawing?.selectedStrokeIndices) ? state.canvasState.drawing.selectedStrokeIndices : [];
                const lbl = document.getElementById('selected-stroke-label');
                const delBtn = document.getElementById('draw-delete-selected');
                const colorEl = document.getElementById('draw-color');
                const widthEl = document.getElementById('draw-width');
                const styleEl = document.getElementById('draw-style');
                const aStartEl = document.getElementById('draw-arrow-start');
                const aEndEl = document.getElementById('draw-arrow-end');
                const arrowSizeEl = document.getElementById('draw-arrow-size');
                const arrowSizeVal = document.getElementById('draw-arrow-size-val');
                const hasSingle = (typeof selIdx === 'number' && ac && ac.drawings && selIdx >= 0 && selIdx < ac.drawings.length && (!selMany || selMany.length <= 1));
                if (hasSingle) {
                    const s = ac.drawings[selIdx] || {};
                    if (lbl) lbl.textContent = `Selected: #${selIdx + 1}`;
                    if (delBtn) delBtn.disabled = false;
                    if (colorEl && s.color) colorEl.value = s.color;
                    if (widthEl && s.width) widthEl.value = s.width;
                    if (styleEl && s.lineStyle) styleEl.value = s.lineStyle;
                    if (aStartEl) aStartEl.checked = !!s.arrowStart;
                    if (aEndEl) aEndEl.checked = !!s.arrowEnd;
                    if (arrowSizeEl) arrowSizeEl.value = s.arrowSize || (drawCfg.arrowSize || 1.2);
                    if (arrowSizeVal) arrowSizeVal.textContent = `x${arrowSizeEl ? arrowSizeEl.value : (s.arrowSize || drawCfg.arrowSize || 1.2)}`;
                } else if (Array.isArray(selMany) && selMany.length > 0) {
                    if (lbl) lbl.textContent = `Selected: ${selMany.length}`;
                    if (delBtn) delBtn.disabled = false;
                    // Leave control values as-is for batch editing; they will apply to all selected on change
                } else {
                    if (lbl) lbl.textContent = 'Selected: None';
                    if (delBtn) delBtn.disabled = true;
                    if (colorEl) colorEl.value = drawCfg.color || '#ff0000';
                    if (widthEl) widthEl.value = drawCfg.width || 5;
                    if (styleEl) styleEl.value = drawCfg.lineStyle || 'solid';
                    if (aStartEl) aStartEl.checked = !!drawCfg.arrowStart;
                    if (aEndEl) aEndEl.checked = !!drawCfg.arrowEnd;
                    if (arrowSizeEl) arrowSizeEl.value = drawCfg.arrowSize || 1.2;
                    if (arrowSizeVal) arrowSizeVal.textContent = `x${drawCfg.arrowSize || 1.2}`;
                }

            } catch(_) {}
        }


        // Helper: paint this canvas object's saved drawings onto a 2D context
        

        // =============== MASK SYSTEM ===============
        // Helper: build a Path2D from a mask shape
        

        // Draw mask overlays on a context (for preview on main canvas)
        const drawMaskOverlays = (ctx, masks, canvasW, canvasH, options = {}) => {
            if (!masks || masks.length === 0) return;
            const selectedId = options.selectedId || state.canvasState.selectedMaskId;
            masks.forEach(mask => {
                if (mask.visible === false) return;
                if (options.isExport && mask.mode === 'guide') return;
                const path = buildMaskPath(mask);
                ctx.save();
                if (mask.mode === 'guide') {
                    ctx.strokeStyle = mask.id === selectedId ? "#facc15" : (mask.color && mask.color !== "#000000" ? mask.color : "#06b6d4");
                    ctx.lineWidth = mask.id === selectedId ? 3 : 1.5;
                    ctx.setLineDash([8, 4]);
                    ctx.stroke(path);
                    ctx.fillStyle = "rgba(6, 182, 212, 0.08)";
                    ctx.fill(path);
                } else if (mask.mode === 'cutout') {
                    const alpha = (mask.opacity != null ? mask.opacity : 100) / 100;
                    if (mask.feather && mask.feather > 0) {
                        ctx.shadowColor = mask.color || "#000000";
                        ctx.shadowBlur = mask.feather;
                    }
                    ctx.fillStyle = `rgba(15, 23, 42, ${Math.min(0.85, alpha * 0.85)})`;
                    ctx.fill(path);
                    ctx.strokeStyle = mask.id === selectedId ? "#facc15" : "#ec4899";
                    ctx.lineWidth = mask.id === selectedId ? 3 : 1.5;
                    ctx.setLineDash(mask.id === selectedId ? [] : [4, 4]);
                    ctx.stroke(path);
                } else {
                    const alpha = (mask.opacity != null ? mask.opacity : 100) / 100;
                    const color = mask.color || "#000000";
                    const r = parseInt(color.slice(1,3),16)||0, g = parseInt(color.slice(3,5),16)||0, b = parseInt(color.slice(5,7),16)||0;
                    if (mask.feather && mask.feather > 0) {
                        ctx.shadowColor = color;
                        ctx.shadowBlur = mask.feather;
                    }
                    ctx.fillStyle = `rgba(${r},${g},${b},${alpha})`;
                    ctx.fill(path);
                    ctx.strokeStyle = mask.id === selectedId ? "#facc15" : "rgba(168,85,247,0.7)";
                    ctx.lineWidth = mask.id === selectedId ? 3 : 1.5;
                    ctx.setLineDash(mask.id === selectedId ? [] : [6, 4]);
                    ctx.stroke(path);
                }
                ctx.restore();

                // Draw resize handles for selected
                if (mask.id === selectedId && (mask.type === "rect" || mask.type === "ellipse") && !options.hideDimensions) {
                    const zoom = state.canvasState.zoom || 1;
                    if (mask.locked) {
                        ctx.save();
                        ctx.fillStyle = "#ef4444";
                        ctx.fillRect(mask.x + mask.w - 18 / zoom, mask.y - 12 / zoom, 18 / zoom, 18 / zoom);
                        ctx.fillStyle = "#ffffff";
                        ctx.font = `bold ${Math.max(10, 12 / zoom)}px sans-serif`;
                        ctx.textAlign = "center";
                        ctx.textBaseline = "middle";
                        ctx.fillText("🔒", mask.x + mask.w - 9 / zoom, mask.y - 3 / zoom);
                        ctx.restore();
                    } else {
                        const hs = Math.max(4, 6 / zoom);
                        const hx = [mask.x, mask.x + mask.w / 2, mask.x + mask.w];
                        const hy = [mask.y, mask.y + mask.h / 2, mask.y + mask.h];
                        ctx.save();
                        ctx.fillStyle = "#facc15";
                        ctx.strokeStyle = "#111827";
                        ctx.lineWidth = Math.max(1, 2 / zoom);
                        for (const x of hx) for (const y of hy) {
                            if (x === hx[1] && y === hy[1]) continue;
                            ctx.fillRect(x - hs, y - hs, hs * 2, hs * 2);
                            ctx.strokeRect(x - hs, y - hs, hs * 2, hs * 2);
                        }
                        ctx.restore();
                    }
                }

                // Draw vertex handles for selected polygon
                if (mask.id === selectedId && mask.type === "polygon" && Array.isArray(mask.points) && !options.hideDimensions) {
                    const zoom = state.canvasState.zoom || 1;
                    const handleR = Math.max(5, 7 / zoom);
                    ctx.save();
                    mask.points.forEach((pt, idx) => {
                        ctx.beginPath();
                        ctx.arc(pt.x, pt.y, handleR, 0, Math.PI * 2);
                        ctx.fillStyle = mask.locked ? "#ef4444" : "#facc15";
                        ctx.fill();
                        ctx.strokeStyle = "#111827";
                        ctx.lineWidth = 2 / zoom;
                        ctx.stroke();
                        ctx.fillStyle = "#ffffff";
                        ctx.font = `bold ${Math.max(8, 10/zoom)}px sans-serif`;
                        ctx.textAlign = "center";
                        ctx.textBaseline = "middle";
                        ctx.fillText(idx + 1, pt.x, pt.y);
                    });
                    ctx.restore();
                }

                // Draw dimension labels for selected mask
                if (mask.id === selectedId && !options.hideDimensions) {
                    const unit = state.canvasState.maskUnit || "px";
                    const ppu = state.canvasState.maskPxPerUnit || 1;
                    const toUnit = (px) => unit === "px" ? Math.round(px) : (px / ppu).toFixed(1);
                    const tag = mask.name ? mask.name + " · " : "";
                    const modeTag = mask.mode === 'guide' ? " [GUIDE]" : mask.mode === 'cutout' ? " [CUTOUT]" : "";
                    const wLabel = tag + toUnit(mask.w) + " " + unit + modeTag;
                    const hLabel = toUnit(mask.h) + " " + unit;
                    const zoom = state.canvasState.zoom || 1;
                    const fontSize = Math.max(10, 13 / zoom);
                    ctx.save();
                    ctx.font = `bold ${fontSize}px sans-serif`;
                    ctx.textAlign = "center";
                    ctx.textBaseline = "bottom";
                    const wMetrics = ctx.measureText(wLabel);
                    const wLx = mask.x + mask.w / 2, wLy = mask.y - 4 / zoom;
                    ctx.fillStyle = "rgba(0,0,0,0.8)";
                    ctx.fillRect(wLx - wMetrics.width/2 - 4/zoom, wLy - fontSize - 2/zoom, wMetrics.width + 8/zoom, fontSize + 4/zoom);
                    ctx.fillStyle = mask.mode === 'guide' ? "#06b6d4" : mask.mode === 'cutout' ? "#f472b6" : "#a855f7";
                    ctx.fillText(wLabel, wLx, wLy);

                    ctx.textAlign = "right";
                    ctx.textBaseline = "middle";
                    const hLx = mask.x - 4 / zoom, hLy = mask.y + mask.h / 2;
                    const hMetrics = ctx.measureText(hLabel);
                    ctx.fillStyle = "rgba(0,0,0,0.8)";
                    ctx.fillRect(hLx - hMetrics.width - 4/zoom, hLy - fontSize/2 - 2/zoom, hMetrics.width + 8/zoom, fontSize + 4/zoom);
                    ctx.fillStyle = mask.mode === 'guide' ? "#06b6d4" : mask.mode === 'cutout' ? "#f472b6" : "#a855f7";
                    ctx.fillText(hLabel, hLx, hLy);
                    ctx.restore();
                }
            });
        };

        const exportCanvasWithMask = () => {
            const activeCanvas = getActiveCanvas();
            const project = state.projects.find(p => p.id === state.activeProjectId);
            if (!project || !activeCanvas || !activeCanvas.width || !activeCanvas.height) {
                showNotification("Canvas has no valid dimensions to export."); return;
            }
            if (!activeCanvas.masks || activeCanvas.masks.length === 0) {
                showNotification("No masks defined. Add masks first."); return;
            }
            showNotification("Generating map + mask overlay...");
            const tmpCanvas = document.createElement("canvas");
            tmpCanvas.width = activeCanvas.width;
            tmpCanvas.height = activeCanvas.height;
            const ctx = tmpCanvas.getContext("2d");
            ctx.clearRect(0, 0, tmpCanvas.width, tmpCanvas.height);
            // Step 1: Draw all maps/LEDs (full canvas, no clipping)
            activeCanvas.maps.forEach(map => {
                const tempMapCanvas = document.createElement("canvas");
                drawVisualizerCanvas(tempMapCanvas, map, { forceFullRes: true });
                if (tempMapCanvas.width > 0 && tempMapCanvas.height > 0) {
                    const sw0 = tempMapCanvas.width, sh0 = tempMapCanvas.height;
                    const sL = Math.max(0, Math.floor(map.cropLeft ?? map.sliceLeft ?? 0));
                    const sR = Math.max(0, Math.floor(map.cropRight ?? map.sliceRight ?? 0));
                    const sT = Math.max(0, Math.floor(map.cropTop ?? 0));
                    const sB = Math.max(0, Math.floor(map.cropBottom ?? 0));
                    const totalCropW = Math.min(sw0, sL + sR);
                    const totalCropH = Math.min(sh0, sT + sB);
                    const srcX = Math.min(sL, sw0), srcY = Math.min(sT, sh0);
                    const srcW = Math.max(0, sw0 - totalCropW), srcH = Math.max(0, sh0 - totalCropH);
                    if (srcW === 0 || srcH === 0) return;
                    const scaleX = map.width / sw0, scaleY = map.height / sh0;
                    ctx.drawImage(tempMapCanvas, srcX, srcY, srcW, srcH, map.x + scaleX * srcX, map.y + scaleY * srcY, scaleX * srcW, scaleY * srcH);
                }
            });
            // Step 2: Draw mask overlays on top (visible colored shapes)
            drawMaskOverlays(ctx, activeCanvas.masks, tmpCanvas.width, tmpCanvas.height, { selectedId: null, hideDimensions: true, isExport: true });
            applyDemoWatermarkToCanvas(tmpCanvas);
            const link = document.createElement("a");
            link.download = `${(project.name || "canvas").replace(/\s+/g, "_")}_${(activeCanvas.name || "map_mask").replace(/\s+/g, "_")}_map_mask.png`;
            link.href = tmpCanvas.toDataURL("image/png");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            showNotification("Map + mask overlay exported as PNG.");
        };

        // Export LED content cut/clipped to the mask area only
        const exportMaskOnly = () => {
            const activeCanvas = getActiveCanvas();
            const project = state.projects.find(p => p.id === state.activeProjectId);
            if (!project || !activeCanvas || !activeCanvas.width || !activeCanvas.height) {
                showNotification("Canvas has no valid dimensions to export."); return;
            }
            if (!activeCanvas.masks || activeCanvas.masks.length === 0) {
                showNotification("No masks defined. Add masks first."); return;
            }
            const invert = !!document.getElementById("mask-invert-toggle")?.checked;
            showNotification("Generating cut LED export...");
            const tmpCanvas = document.createElement("canvas");
            tmpCanvas.width = activeCanvas.width;
            tmpCanvas.height = activeCanvas.height;
            const ctx = tmpCanvas.getContext("2d");
            ctx.clearRect(0, 0, tmpCanvas.width, tmpCanvas.height);
            // Apply mask clip so only content inside mask area is drawn
            ctx.save();
            applyMaskClip(ctx, activeCanvas.masks, tmpCanvas.width, tmpCanvas.height, invert);
            // Draw maps/LEDs (only the parts inside the mask will be visible)
            activeCanvas.maps.forEach(map => {
                const tempMapCanvas = document.createElement("canvas");
                drawVisualizerCanvas(tempMapCanvas, map, { forceFullRes: true });
                if (tempMapCanvas.width > 0 && tempMapCanvas.height > 0) {
                    const sw0 = tempMapCanvas.width, sh0 = tempMapCanvas.height;
                    const sL = Math.max(0, Math.floor(map.cropLeft ?? map.sliceLeft ?? 0));
                    const sR = Math.max(0, Math.floor(map.cropRight ?? map.sliceRight ?? 0));
                    const sT = Math.max(0, Math.floor(map.cropTop ?? 0));
                    const sB = Math.max(0, Math.floor(map.cropBottom ?? 0));
                    const totalCropW = Math.min(sw0, sL + sR);
                    const totalCropH = Math.min(sh0, sT + sB);
                    const srcX = Math.min(sL, sw0), srcY = Math.min(sT, sh0);
                    const srcW = Math.max(0, sw0 - totalCropW), srcH = Math.max(0, sh0 - totalCropH);
                    if (srcW === 0 || srcH === 0) return;
                    const scaleX = map.width / sw0, scaleY = map.height / sh0;
                    ctx.drawImage(tempMapCanvas, srcX, srcY, srcW, srcH, map.x + scaleX * srcX, map.y + scaleY * srcY, scaleX * srcW, scaleY * srcH);
                }
            });
            ctx.restore();
            const link = document.createElement("a");
            link.download = `${(project.name || "canvas").replace(/\s+/g, "_")}_${(activeCanvas.name || "cut").replace(/\s+/g, "_")}_cut_leds.png`;
            link.href = tmpCanvas.toDataURL("image/png");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            showNotification("Cut LED content exported as PNG.");
        };
        // Hit-test: find mask under point
        const hitTestMask = (masks, wx, wy) => {
            if (!masks) return null;
            const tolerance = Math.max(8, 14 / (state.canvasState.zoom || 1));
            const tmpCanvas = document.createElement("canvas");
            tmpCanvas.width = 1; tmpCanvas.height = 1;
            const ctx = tmpCanvas.getContext("2d");
            for (let i = masks.length - 1; i >= 0; i--) {
                const mask = masks[i];
                if (mask.visible === false) continue;
                if (mask.type === "rect" && wx >= mask.x - tolerance && wx <= mask.x + mask.w + tolerance && wy >= mask.y - tolerance && wy <= mask.y + mask.h + tolerance) return mask;
                if (mask.type === "ellipse") {
                    const rx = Math.abs(mask.w) / 2 + tolerance, ry = Math.abs(mask.h) / 2 + tolerance;
                    const dx = wx - (mask.x + mask.w / 2), dy = wy - (mask.y + mask.h / 2);
                    if (rx > 0 && ry > 0 && (dx * dx) / (rx * rx) + (dy * dy) / (ry * ry) <= 1) return mask;
                }
                const p = buildMaskPath(mask);
                if (ctx.isPointInPath(p, wx, wy)) return mask;
                if (mask.type === "polygon" && Array.isArray(mask.points) && mask.points.length) {
                    const xs = mask.points.map(point => point.x), ys = mask.points.map(point => point.y);
                    if (wx >= Math.min(...xs) - tolerance && wx <= Math.max(...xs) + tolerance && wy >= Math.min(...ys) - tolerance && wy <= Math.max(...ys) + tolerance) return mask;
                }
            }
            return null;
        };

        // Hit-test resize handle for rect/ellipse + polygon vertices
        const hitTestMaskHandle = (mask, wx, wy, threshold) => {
            if (!mask) return null;
            // Polygon: check vertex handles
            if (mask.type === "polygon" && Array.isArray(mask.points)) {
                for (let i = 0; i < mask.points.length; i++) {
                    if (Math.abs(wx - mask.points[i].x) <= threshold && Math.abs(wy - mask.points[i].y) <= threshold) {
                        return "v" + i; // vertex handle
                    }
                }
                return null;
            }
            // Rect/Ellipse: 8 edge+corner handles
            if (mask.type !== "rect" && mask.type !== "ellipse") return null;
            const hx = [mask.x, mask.x + mask.w / 2, mask.x + mask.w];
            const hy = [mask.y, mask.y + mask.h / 2, mask.y + mask.h];
            const names = [["nw","n","ne"],["w","c","e"],["sw","s","se"]];
            for (let yi = 0; yi < 3; yi++) for (let xi = 0; xi < 3; xi++) {
                if (xi === 1 && yi === 1) continue;
                if (Math.abs(wx - hx[xi]) <= threshold && Math.abs(wy - hy[yi]) <= threshold) return names[yi][xi];
            }
            return null;
        };
        // =============== END MASK SYSTEM ===============

        
        const drawCanvasGrid = () => {
            const gridCanvas = document.getElementById('grid-canvas');
            const container = document.getElementById('main-canvas-wrapper');
            if(!gridCanvas || !container) return;
            
            gridCanvas.style.display = 'block';
            const { zoom, panX, panY } = state.canvasState;
            const rulerSize = state.canvasState.rulers ? 30 : 0;
            
            gridCanvas.width = container.clientWidth;
            gridCanvas.height = container.clientHeight;
            gridCanvas.style.transform = `translate(0, 0)`;

            const ctx = gridCanvas.getContext('2d');
            ctx.clearRect(0, 0, gridCanvas.width, gridCanvas.height);
            
            let interval = 100;
            if (zoom < 0.25) interval = 500;
            else if (zoom < 0.5) interval = 200;
            
            const scaledInterval = interval * zoom;
            
            const startX = rulerSize + ((panX + (state.canvasState.regionOffsetX || 0)) % scaledInterval);
            const startY = rulerSize + ((panY + (state.canvasState.regionOffsetY || 0)) % scaledInterval);
            
            ctx.strokeStyle = "rgba(255, 255, 255, 0.05)";
            ctx.lineWidth = 1;
            
            for(let x = startX; x < gridCanvas.width; x += scaledInterval) {
                ctx.beginPath();
                ctx.moveTo(x, rulerSize);
                ctx.lineTo(x, gridCanvas.height);
                ctx.stroke();
            }
            for(let y = startY; y < gridCanvas.height; y += scaledInterval) {
                ctx.beginPath();
                ctx.moveTo(rulerSize, y);
                ctx.lineTo(gridCanvas.width, y);
                ctx.stroke();
            }
        };

        const renderCanvasToElement = (targetCanvas, project, options = {}) => {
            if (!project || !targetCanvas || !targetCanvas.width || !targetCanvas.height) return null;
            const transparentPng = !!options.transparentPng;
            const exportCanvas = document.createElement('canvas');
            exportCanvas.width = targetCanvas.width;
            exportCanvas.height = targetCanvas.height;
            const ctx = exportCanvas.getContext('2d');

            // Draw background (skip for transparent PNG)
            if (!transparentPng) {
                ctx.fillStyle = '#111827';
                ctx.fillRect(0, 0, exportCanvas.width, exportCanvas.height);
            }

            // Draw each map and collect coordinate labels to draw on top
            const coordLabels = [];
            (targetCanvas.maps || []).forEach(map => {
                const tempMapCanvas = document.createElement('canvas');
                drawVisualizerCanvas(tempMapCanvas, map, { forceFullRes: true });
                if (tempMapCanvas.width > 0 && tempMapCanvas.height > 0) {
                    const sw0 = tempMapCanvas.width;
                    const sh0 = tempMapCanvas.height;
                    const sL = Math.max(0, Math.floor((map.cropLeft ?? map.sliceLeft ?? 0)));
                    const sR = Math.max(0, Math.floor((map.cropRight ?? map.sliceRight ?? 0)));
                    const sT = Math.max(0, Math.floor((map.cropTop ?? 0)));
                    const sB = Math.max(0, Math.floor((map.cropBottom ?? 0)));
                    const totalCropW = Math.min(sw0, sL + sR);
                    const totalCropH = Math.min(sh0, sT + sB);
                    const srcX = Math.min(sL, sw0);
                    const srcY = Math.min(sT, sh0);
                    const srcW = Math.max(0, sw0 - totalCropW);
                    const srcH = Math.max(0, sh0 - totalCropH);
                    if (srcW === 0 || srcH === 0) return;
                    const scaleX = map.width / sw0;
                    const scaleY = map.height / sh0;
                    const destX = map.x + scaleX * srcX;
                    const destW = scaleX * srcW;
                    const destY = map.y + scaleY * srcY;
                    const destH = scaleY * srcH;
                    ctx.drawImage(tempMapCanvas, srcX, srcY, srcW, srcH, destX, destY, destW, destH);

                    // Prepare coordinates label placed outside the visible rect
                    try {
                        const fs = Math.max(8, state.canvasState.coordFontSize || 12);
                        const pad = Math.max(4, Math.round(fs * 0.3));
                        const gaps = computeNearestGapsForMap(targetCanvas, map);
                        const parts = [`X: ${Math.round(map.x)}`, `Y: ${Math.round(map.y)}`];
                        if (gaps && gaps.hGap != null && gaps.hGap > 0) parts.push(`H: ${Math.round(gaps.hGap)} px`);
                        if (gaps && gaps.vGap != null && gaps.vGap > 0) parts.push(`V: ${Math.round(gaps.vGap)} px`);
                        const text = parts.join('  ');
                        const visLeft = destX, visTop = destY, visRight = destX + destW, visBottom = destY + destH;
                        ctx.save();
                        ctx.font = `${fs}px Inter, Arial`;
                        const tw = ctx.measureText(text).width + pad * 2;
                        const th = fs + pad * 2;
                        let lx = visLeft;
                        let ly = visTop - th - 2;
                        if (ly < 0) {
                            ly = visBottom + 2;
                            if (ly + th > exportCanvas.height) {
                                lx = visLeft - tw - 2;
                                ly = Math.max(0, visTop);
                                if (lx < 0) {
                                    lx = visRight + 2;
                                    ly = Math.max(0, visTop);
                                    if (lx + tw > exportCanvas.width) {
                                        lx = Math.max(0, exportCanvas.width - tw - 2);
                                    }
                                }
                            }
                        }
                        lx = Math.max(0, Math.min(lx, exportCanvas.width - tw));
                        ly = Math.max(0, Math.min(ly, exportCanvas.height - th));
                        ctx.restore();
                        coordLabels.push({ text, fs, pad, x: lx, y: ly });
                    } catch(_) {}
                }
            });

            // Draw gap guides
            try {
                let gsrc = state.canvasState.gapGuides || state.canvasState.persistentGuides;
                if (!gsrc && state.canvasState.selectedMapId) {
                    const sel = targetCanvas.maps?.find(m => String(m.id) === String(state.canvasState.selectedMapId));
                    if (sel) gsrc = computeGapGuidesForTarget(targetCanvas, sel);
                }
                if (gsrc) {
                    ctx.save();
                    ctx.setLineDash([6, 6]);
                    ctx.lineWidth = 2;
                    ctx.strokeStyle = 'rgba(59, 130, 246, 0.9)';
                    ctx.fillStyle = 'rgba(17,24,39,0.8)';
                    const drawGuide = (g) => {
                        if (!g) return;
                        ctx.beginPath();
                        ctx.moveTo(g.x1, g.y1);
                        ctx.lineTo(g.x2, g.y2);
                        ctx.stroke();
                        const fs = Math.max(8, state.canvasState.coordFontSize || 12);
                        ctx.font = `${fs}px Inter, Arial`;
                        const pad = Math.max(4, Math.round(fs * 0.3));
                        const tw = ctx.measureText(g.text).width + pad*2;
                        const th = fs + pad*2;
                        const bx = g.tx - tw/2;
                        const by = g.ty - th/2;
                        ctx.fillRect(bx, by, tw, th);
                        ctx.fillStyle = '#ffffff';
                        ctx.fillText(g.text, bx + pad, by + fs + (pad - 2));
                        ctx.fillStyle = 'rgba(17,24,39,0.8)';
                    };
                    drawGuide(gsrc.h);
                    drawGuide(gsrc.v);
                    ctx.restore();
                }
            } catch(_) {}

            // Draw labels on top
            try {
                coordLabels.forEach(l => {
                    ctx.save();
                    ctx.font = `${l.fs}px Inter, Arial`;
                    const tw = ctx.measureText(l.text).width + l.pad * 2;
                    const th = l.fs + l.pad * 2;
                    ctx.fillStyle = 'rgba(0,0,0,0.6)';
                    ctx.fillRect(l.x, l.y, tw, th);
                    ctx.fillStyle = '#ffffff';
                    ctx.fillText(l.text, l.x + l.pad, l.y + l.fs + (l.pad - 2));
                    ctx.restore();
                });
            } catch(_) {}

            // Draw saved manual drawings on top
            try { drawCanvasDrawingsToContext(ctx, targetCanvas); } catch(_) {}

            // Add stats overlay for canvas and actual pixel usage
            try {
                const usedBounds = (() => {
                    let left = Infinity, top = Infinity, right = -Infinity, bottom = -Infinity;
                    (targetCanvas.maps || []).forEach(map => {
                        const rect = getVisibleRectForMap(map);
                        if (!rect || rect.width <= 0 || rect.height <= 0) return;
                        left = Math.min(left, rect.left);
                        top = Math.min(top, rect.top);
                        right = Math.max(right, rect.right);
                        bottom = Math.max(bottom, rect.bottom);
                    });
                    if (!Number.isFinite(left) || !Number.isFinite(top) || !Number.isFinite(right) || !Number.isFinite(bottom)) {
                        return null;
                    }
                    return {
                        width: Math.max(0, Math.round(right - left)),
                        height: Math.max(0, Math.round(bottom - top))
                    };
                })();

                const stats = [];
                if (options.outputMapName) {
                    stats.push({ title: 'Output Map', value: options.outputMapName });
                }
                stats.push({ title: 'Canvas', value: targetCanvas.name || 'Canvas' });
                stats.push({ title: 'Canvas Size', value: `${exportCanvas.width} x ${exportCanvas.height} px` });
                stats.push({ title: 'Actual Pixels', value: usedBounds ? `${usedBounds.width} x ${usedBounds.height} px` : '0 x 0 px' });

                const margin = 12;
                const padX = 12;
                const padY = 10;
                const baseFs = Math.max(12, Math.round(Math.min(exportCanvas.width, exportCanvas.height) * 0.018));
                const titleFs = Math.max(10, Math.round(baseFs * 0.6));
                const valueFs = Math.max(titleFs + 2, Math.round(baseFs * 1.05));
                const lineGap = Math.max(4, Math.round(valueFs * 0.2));
                const boxSpacing = Math.max(8, Math.round(margin * 0.4));

                ctx.save();
                ctx.textBaseline = 'top';
                let maxWidth = 0;
                stats.forEach(stat => {
                    ctx.font = `${titleFs}px Inter, Arial`;
                    const titleWidth = ctx.measureText(stat.title).width;
                    ctx.font = `${valueFs}px Inter, Arial`;
                    const valueWidth = ctx.measureText(stat.value).width;
                    stat.boxWidth = Math.ceil(Math.max(titleWidth, valueWidth) + padX * 2);
                    stat.boxHeight = Math.ceil(padY * 2 + titleFs + lineGap + valueFs);
                    if (stat.boxWidth > maxWidth) maxWidth = stat.boxWidth;
                });

                let yCursor = exportCanvas.height - margin;
                for (let i = stats.length - 1; i >= 0; i--) {
                    const stat = stats[i];
                    yCursor -= stat.boxHeight;
                    const x = exportCanvas.width - margin - maxWidth;
                    const y = Math.max(margin, yCursor);
                    ctx.fillStyle = 'rgba(3, 7, 18, 0.78)';
                    ctx.strokeStyle = 'rgba(255, 255, 255, 0.15)';
                    ctx.lineWidth = 1;
                    ctx.fillRect(x, y, maxWidth, stat.boxHeight);
                    ctx.strokeRect(x + 0.5, y + 0.5, maxWidth - 1, stat.boxHeight - 1);
                    ctx.font = `${titleFs}px Inter, Arial`;
                    ctx.fillStyle = 'rgba(156, 163, 175, 0.95)';
                    ctx.fillText(stat.title, x + padX, y + padY);
                    ctx.font = `${valueFs}px Inter, Arial`;
                    ctx.fillStyle = '#ffffff';
                    ctx.fillText(stat.value, x + padX, y + padY + titleFs + lineGap);
                    yCursor -= boxSpacing;
                }
                ctx.restore();
            } catch(_) {}

            return exportCanvas;
        };

        const exportCanvas = (format, canvasOverride = null) => {
            const project = state.projects.find(p => p.id === state.activeProjectId);
            const activeCanvas = canvasOverride || getActiveCanvas();
            if (!project || !activeCanvas || !activeCanvas.width || !activeCanvas.height) {
                showNotification("Canvas has no valid dimensions to export.");
                return;
            }

            const transparentPng = format === 'png' && !!document.getElementById('export-canvas-transparent')?.checked;
            const activeOutputMap = getActiveOutputMap();

            if (format === 'pdf') {
                try {
                    if (!window.jspdf || !window.jspdf.jsPDF) { showNotification('PDF library not loaded.'); return; }
                    const jsPDF = window.jspdf.jsPDF;
                    const scopeEl = document.getElementById('export-canvas-pdf-scope');
                    const scope = canvasOverride ? 'active' : (scopeEl?.value || 'current-output-map');

                    const itemsToExport = [];
                    if (scope === 'active') {
                        itemsToExport.push({ canvas: activeCanvas, mapName: activeOutputMap?.name || 'Output Map' });
                    } else if (scope === 'current-output-map') {
                        const ensuredMap = ensureOutputMapRegions(activeOutputMap);
                        const regions = (ensuredMap?.regions && ensuredMap.regions.length) ? ensuredMap.regions : [activeCanvas];
                        regions.forEach(r => itemsToExport.push({ canvas: r, mapName: activeOutputMap?.name || 'Output Map' }));
                    } else if (scope === 'all-output-maps') {
                        const allOutputMaps = project.canvases || [];
                        allOutputMaps.forEach(om => {
                            const ensured = ensureOutputMapRegions(om);
                            const regions = (ensured?.regions && ensured.regions.length) ? ensured.regions : [om];
                            regions.forEach(r => itemsToExport.push({ canvas: r, mapName: om.name || 'Output Map' }));
                        });
                        if (!itemsToExport.length) itemsToExport.push({ canvas: activeCanvas, mapName: activeOutputMap?.name || 'Output Map' });
                    }

                    showNotification(`Generating PDF with ${itemsToExport.length} canvas page${itemsToExport.length > 1 ? 's' : ''}...`);

                    let pdfDoc = null;
                    let exportedCount = 0;

                    for (let i = 0; i < itemsToExport.length; i++) {
                        const item = itemsToExport[i];
                        const targetCanvas = item.canvas;
                        if (!targetCanvas || !targetCanvas.width || !targetCanvas.height) continue;

                        const renderedCanvas = renderCanvasToElement(targetCanvas, project, {
                            outputMapName: item.mapName,
                            transparentPng: false
                        });
                        if (!renderedCanvas) continue;

                        const w = renderedCanvas.width;
                        const h = renderedCanvas.height;
                        const orientation = w >= h ? 'landscape' : 'portrait';
                        const imgData = renderedCanvas.toDataURL('image/jpeg', 0.92);

                        if (!pdfDoc) {
                            pdfDoc = new jsPDF({ orientation, unit: 'px', format: [w, h], compress: true });
                            pdfDoc.addImage(imgData, 'JPEG', 0, 0, w, h, undefined, 'FAST');
                        } else {
                            pdfDoc.addPage([w, h], orientation);
                            pdfDoc.addImage(imgData, 'JPEG', 0, 0, w, h, undefined, 'FAST');
                        }
                        exportedCount++;
                    }

                    if (!pdfDoc || exportedCount === 0) {
                        showNotification('Failed to generate canvas PDF.');
                        return;
                    }

                    const safeProject = (project.name || 'Project').replace(/\s+/g, '_');
                    const safeMap = (activeOutputMap?.name || 'Output_Map').replace(/\s+/g, '_');
                    let pdfFileName = `${safeProject}_${safeMap}.pdf`;
                    if (scope === 'all-output-maps') {
                        pdfFileName = `${safeProject}_All_Output_Maps.pdf`;
                    } else if (scope === 'current-output-map') {
                        pdfFileName = `${safeProject}_${safeMap}_All_Canvases.pdf`;
                    }
                    pdfDoc.save(pdfFileName);
                    showNotification(`Saved ${exportedCount} canvas page${exportedCount > 1 ? 's' : ''} to ${pdfFileName}`);
                } catch (e) {
                    console.warn('Output canvas PDF export failed', e);
                    showNotification('Failed to save PDF.');
                }
                return;
            }

            // Single canvas PNG / JPG export
            showNotification(`Generating ${format.toUpperCase()} image...`);
            const renderedCanvas = renderCanvasToElement(activeCanvas, project, {
                transparentPng,
                outputMapName: activeOutputMap?.name
            });
            if (!renderedCanvas) {
                showNotification('Failed to export canvas image.');
                return;
            }
            const safeName = `${project.name.replace(/\s+/g, '_')}_${activeCanvas.name.replace(/\s+/g, '_')}`;
            const link = document.createElement('a');
            link.download = `${safeName}.${format}`;
            link.href = renderedCanvas.toDataURL(`image/${format}`, 0.9);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        };

        // --- Single Visualizer Export (PNG/JPG) ---
        const sanitizeFilename = (name) => {
            try { return String(name || '').trim().replace(/[\\\/:*?"<>|]+/g, '').replace(/\s+/g, '_'); } catch(_) { return 'pixel_map'; }
        };

        const exportVisualizer = (format = 'png', canvasId, nameHint, exportOptions = {}) => {
            try {
                const project = state.projects.find(p => String(p.id) === String(state.activeProjectId));
                const map = getActivePixelMap();
                if (!project || !map) { showNotification('No active pixel map to export'); return; }
                const temp = document.createElement('canvas');
                if (canvasId === 'visualizer-canvas') {
                    const composeState = state.visualizerState?.compose || { mapIds: [], secondaryMapId: null, tertiaryMapId: null, placement: 'right', gapPx: 0 };
                    const extraIds = Array.isArray(composeState.mapIds) ? composeState.mapIds : [];
                    const extraMaps = (project?.pixelMaps || []).filter(pm => extraIds.includes(String(pm.id)));
                    if (extraMaps.length) {
                        const maps = [map, ...extraMaps].filter(Boolean).slice(0, 6);
                        composeVisualizerCanvasMulti(temp, maps, composeState.placement, composeState.gapPx, { forceFullRes: true, transparent: !!exportOptions.transparent });
                    } else {
                        drawVisualizerCanvas(temp, map, { forceFullRes: true, transparent: !!exportOptions.transparent });
                    }
                } else {
                    drawVisualizerCanvas(temp, map, { forceFullRes: true, transparent: !!exportOptions.transparent });
                }
                if (!temp.width || !temp.height) { showNotification('Pixel map has no valid resolution'); return; }
                applyDemoWatermarkToCanvas(temp);
                const w = temp.width, h = temp.height;
                const mime = format === 'jpeg' ? 'image/jpeg' : 'image/png';
                const ext = format === 'jpeg' ? 'jpg' : 'png';
                const pname = sanitizeFilename(project.name);
                const mname = sanitizeFilename(nameHint || map.name || 'pixel_map');
                const a = document.createElement('a');
                a.download = `${pname}_${mname}_${w}x${h}.${ext}`;
                a.href = temp.toDataURL(mime, 0.92);
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
            } catch (e) {
                console.warn('exportVisualizer failed', e);
                showNotification('Failed to export image');
            }
        };

        // --- Batch Export: Save All Pixel Maps as PNG ---
        const exportAllPixelMapsAsPNGs = async (exportOptions = {}) => {
            try {
                const project = state.projects.find(p => String(p.id) === String(state.activeProjectId));
                const maps = project?.pixelMaps || [];
                if (!project || maps.length === 0) { showNotification('No pixel maps to export'); return; }
                showNotification(`Saving ${maps.length} PNG${maps.length>1?'s':''}...`);
                const pname = sanitizeFilename(project.name);
                for (let i = 0; i < maps.length; i++) {
                    const map = maps[i];
                    const temp = document.createElement('canvas');
                    drawVisualizerCanvas(temp, map, { forceFullRes: true, transparent: !!exportOptions.transparent });
                    if (!temp.width || !temp.height) continue;
                    applyDemoWatermarkToCanvas(temp);
                    const w = temp.width, h = temp.height;
                    const mname = sanitizeFilename(map.name || `pixel_map_${i+1}`);
                    const a = document.createElement('a');
                    a.download = `${pname}_${mname}_${w}x${h}.png`;
                    a.href = temp.toDataURL('image/png');
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    // small delay between downloads to keep things smooth
                    await new Promise(res => setTimeout(res, 80));
                }
                showNotification('All PNGs saved');
            } catch (e) {
                console.warn('exportAllPixelMapsAsPNGs failed', e);
                showNotification('Failed to save all PNGs');
            }
        };


        const CANVAS_CUSTOM_PRESETS_STORAGE_KEY = 'pixellogic-canvas-size-presets';

        const parseCanvasDimensionExpr = (raw) => {
            if (raw == null) return null;
            let expr = String(raw).trim();
            if (!expr) return null;
            expr = expr
                .replace(/[xX×]/g, '*')
                .replace(/÷/g, '/')
                .replace(/\s+/g, '');
            if (!/^[0-9+\-*/().]+$/.test(expr)) return null;
            try {
                const value = Function(`"use strict"; return (${expr});`)();
                if (!Number.isFinite(value)) return null;
                const rounded = Math.round(value);
                if (rounded < 1) return null;
                return rounded;
            } catch (_) {
                return null;
            }
        };

        function getSavedCanvasSizePresets() {
            try {
                const raw = JSON.parse(localStorage.getItem(CANVAS_CUSTOM_PRESETS_STORAGE_KEY) || '[]');
                if (!Array.isArray(raw)) return [];
                const seen = new Set();
                const cleaned = [];
                for (const item of raw) {
                    const w = Math.round(Number(item?.w));
                    const h = Math.round(Number(item?.h));
                    if (!Number.isFinite(w) || !Number.isFinite(h) || w < 1 || h < 1) continue;
                    const key = `${w}x${h}`;
                    if (seen.has(key)) continue;
                    seen.add(key);
                    cleaned.push({ w, h });
                }
                return cleaned.slice(0, 50);
            } catch (_) {
                return [];
            }
        }

        function saveCanvasSizePreset(width, height) {
            const w = Math.round(Number(width));
            const h = Math.round(Number(height));
            if (!Number.isFinite(w) || !Number.isFinite(h) || w < 1 || h < 1) return { ok: false, reason: 'invalid' };
            const list = getSavedCanvasSizePresets();
            const key = `${w}x${h}`;
            if (list.some(item => `${item.w}x${item.h}` === key)) return { ok: false, reason: 'exists' };
            list.push({ w, h });
            try { localStorage.setItem(CANVAS_CUSTOM_PRESETS_STORAGE_KEY, JSON.stringify(list)); } catch (_) {}
            return { ok: true };
        }

        function deleteCanvasSizePreset(width, height) {
            const w = Math.round(Number(width));
            const h = Math.round(Number(height));
            if (!Number.isFinite(w) || !Number.isFinite(h) || w < 1 || h < 1) return { ok: false, reason: 'invalid' };
            const list = getSavedCanvasSizePresets();
            const key = `${w}x${h}`;
            if (!list.some(item => `${item.w}x${item.h}` === key)) return { ok: false, reason: 'missing' };
            const next = list.filter(item => `${item.w}x${item.h}` !== key);
            try { localStorage.setItem(CANVAS_CUSTOM_PRESETS_STORAGE_KEY, JSON.stringify(next)); } catch (_) {}
            return { ok: true };
        }

        function clearCanvasSizePresets() {
            try { localStorage.setItem(CANVAS_CUSTOM_PRESETS_STORAGE_KEY, JSON.stringify([])); } catch (_) {}
            return { ok: true };
        }

        function saveCurrentCanvasCustomSize() {
            const widthEl = document.getElementById('canvas-custom-width');
            const heightEl = document.getElementById('canvas-custom-height');
            const width = parseCanvasDimensionExpr(widthEl?.value);
            const height = parseCanvasDimensionExpr(heightEl?.value);
            if (!width || !height) {
                showNotification('Enter valid width/height expressions to save.');
                return;
            }
            const res = saveCanvasSizePreset(width, height);
            if (!res.ok && res.reason === 'exists') {
                showNotification('This custom size is already saved.');
                return;
            }
            if (!res.ok) {
                showNotification('Failed to save custom size.');
                return;
            }
            showNotification('Custom size saved to presets.');
            renderCanvas();
        }

        function deleteCurrentCanvasCustomSize() {
            const widthEl = document.getElementById('canvas-custom-width');
            const heightEl = document.getElementById('canvas-custom-height');
            const width = parseCanvasDimensionExpr(widthEl?.value);
            const height = parseCanvasDimensionExpr(heightEl?.value);
            if (!width || !height) {
                showNotification('Enter valid width/height expressions to delete.');
                return;
            }
            const res = deleteCanvasSizePreset(width, height);
            if (!res.ok && res.reason === 'missing') {
                showNotification('This size is not in saved presets.');
                return;
            }
            if (!res.ok) {
                showNotification('Failed to delete saved size.');
                return;
            }
            showNotification('Saved custom size removed.');
            renderCanvas();
        }

        function clearAllCanvasCustomSizes() {
            const ok = window.confirm('Clear all saved custom canvas sizes?');
            if (!ok) return;
            clearCanvasSizePresets();
            showNotification('All saved custom sizes cleared.');
            renderCanvas();
        }

        const handleCanvasPresetChange = (e) => {
            const activeCanvas = getActiveCanvas();
            if(!activeCanvas) return;
            const customControls = document.getElementById('canvas-custom-size');
            if (e.target.value === 'custom') {
                customControls.style.display = 'flex';
            } else {
                const [width, height] = e.target.value.split('x').map(Number);
                activeCanvas.width = width;
                activeCanvas.height = height;
                document.getElementById('canvas-custom-width').value = width;
                document.getElementById('canvas-custom-height').value = height;
                drawMainCanvas();
            }
        };

        const handleCanvasCustomSizeChange = () => {
            const activeCanvas = getActiveCanvas();
            if(!activeCanvas) return;
            const widthEl = document.getElementById('canvas-custom-width');
            const heightEl = document.getElementById('canvas-custom-height');
            const width = parseCanvasDimensionExpr(widthEl?.value);
            const height = parseCanvasDimensionExpr(heightEl?.value);
            if (!width || !height) return;
            activeCanvas.width = width;
            activeCanvas.height = height;
            if (widthEl) widthEl.value = String(width);
            if (heightEl) heightEl.value = String(height);
            const presetEl = document.getElementById('canvas-preset-select');
            if (presetEl) presetEl.value = 'custom';
            drawMainCanvas();
        };

        const deleteSelectedMapFromCanvas = () => {
            const activeCanvas = getActiveCanvas();
            const selIds = Array.isArray(state.canvasState.selectedMapIds) ? state.canvasState.selectedMapIds : [];
            const effectiveIds = selIds.length ? selIds.slice() : (state.canvasState.selectedMapId != null ? [state.canvasState.selectedMapId] : []);
            if (!activeCanvas || effectiveIds.length === 0) {
                showNotification("No map selected to delete.");
                return;
            }
            const indexMap = activeCanvas.maps
                .map((m, i) => ({ m, i }))
                .filter(entry => effectiveIds.includes(entry.m.id))
                .sort((a, b) => b.i - a.i);
            if (indexMap.length === 0) {
                showNotification("No map selected to delete.");
                return;
            }

            state.canvasState.mapDeleteHistory = state.canvasState.mapDeleteHistory || [];
            state.canvasState.mapDeleteRedo = [];

            indexMap.forEach(({ m, i }) => {
                let snapshot;
                try { snapshot = JSON.parse(JSON.stringify(m)); }
                catch (_) { snapshot = Object.assign({}, m); }
                try {
                    if (m?.details?.logo?.imageObject) {
                        snapshot.details = snapshot.details || {};
                        snapshot.details.logo = snapshot.details.logo || {};
                        snapshot.details.logo.imageObject = m.details.logo.imageObject;
                    }
                } catch(_) {}
                state.canvasState.mapDeleteHistory.push({ map: snapshot, index: i, canvasId: activeCanvas.id });
                activeCanvas.maps.splice(i, 1);
            });

            state.canvasState.selectedMapId = null;
            state.canvasState.selectedMapIds = [];
            state.canvasState.gapGuides = null;
            state.canvasState.persistentGuides = null;
            drawMainCanvas();
            showNotification(indexMap.length > 1 ? 'Maps deleted from canvas.' : 'Map deleted from canvas.');
            // Reset cropping controls when no selection
            const leftEl = document.getElementById('crop-left-input');
            const rightEl = document.getElementById('crop-right-input');
            const topEl = document.getElementById('crop-top-input');
            const bottomEl = document.getElementById('crop-bottom-input');
            const pLeftEl = document.getElementById('crop-panels-left-input');
            const pRightEl = document.getElementById('crop-panels-right-input');
            const pTopEl = document.getElementById('crop-panels-top-input');
            const pBottomEl = document.getElementById('crop-panels-bottom-input');
            if (leftEl && rightEl && topEl && bottomEl) { 
                leftEl.disabled = true; rightEl.disabled = true; topEl.disabled = true; bottomEl.disabled = true; 
                leftEl.value = 0; rightEl.value = 0; topEl.value = 0; bottomEl.value = 0; 
            }
            if (pLeftEl && pRightEl && pTopEl && pBottomEl) {
                pLeftEl.disabled = true; pRightEl.disabled = true; pTopEl.disabled = true; pBottomEl.disabled = true;
                pLeftEl.value = 0; pRightEl.value = 0; pTopEl.value = 0; pBottomEl.value = 0;
            }
            try { updateMapUndoRedoButtons(); } catch(_) {}
        };

        // Undo last deleted map on the active canvas
        function undoCanvasMapDelete() {
            try {
                const ac = getActiveCanvas();
                if (!ac) return;
                if (!Array.isArray(state.canvasState.mapDeleteHistory) || state.canvasState.mapDeleteHistory.length === 0) return;
                // Find the most recent deletion for this canvas
                let entryIdx = -1;
                for (let i = state.canvasState.mapDeleteHistory.length - 1; i >= 0; i--) {
                    if (state.canvasState.mapDeleteHistory[i].canvasId === ac.id) { entryIdx = i; break; }
                }
                if (entryIdx < 0) return;
                const entry = state.canvasState.mapDeleteHistory.splice(entryIdx, 1)[0];
                const mapSnap = entry.map;
                const insertIndex = Math.min(Math.max(0, entry.index), ac.maps.length);
                ac.maps.splice(insertIndex, 0, mapSnap);
                // Select restored map
                state.canvasState.selectedMapId = mapSnap.id;
                state.canvasState.selectedMapIds = [mapSnap.id];
                // Push to redo stack so we can reapply deletion
                state.canvasState.mapDeleteRedo = state.canvasState.mapDeleteRedo || [];
                state.canvasState.mapDeleteRedo.push({ map: JSON.parse(JSON.stringify(mapSnap)), index: insertIndex, canvasId: ac.id });
                drawMainCanvas();
                showNotification('Restored deleted map.');
            } catch(_) {}
            try { updateMapUndoRedoButtons(); } catch(_) {}
        }

        // Redo the last undone deletion on the active canvas
        function redoCanvasMapDelete() {
            try {
                const ac = getActiveCanvas();
                if (!ac) return;
                if (!Array.isArray(state.canvasState.mapDeleteRedo) || state.canvasState.mapDeleteRedo.length === 0) return;
                // Find the most recent redo for this canvas
                let entryIdx = -1;
                for (let i = state.canvasState.mapDeleteRedo.length - 1; i >= 0; i--) {
                    if (state.canvasState.mapDeleteRedo[i].canvasId === ac.id) { entryIdx = i; break; }
                }
                if (entryIdx < 0) return;
                const entry = state.canvasState.mapDeleteRedo.splice(entryIdx, 1)[0];
                const targetId = entry.map && entry.map.id;
                // Find the map by id (prefer id match), fallback to index bounds
                let idx = ac.maps.findIndex(m => m.id === targetId);
                if (idx < 0) {
                    idx = Math.min(Math.max(0, entry.index), ac.maps.length - 1);
                }
                if (idx >= 0 && idx < ac.maps.length) {
                    const removed = ac.maps.splice(idx, 1)[0];
                    // Push back to history so it can be undone again
                    state.canvasState.mapDeleteHistory = state.canvasState.mapDeleteHistory || [];
                    const copy = JSON.parse(JSON.stringify(removed));
                    try {
                        if (removed?.details?.logo?.imageObject) {
                            copy.details = copy.details || {}; copy.details.logo = copy.details.logo || {};
                            copy.details.logo.imageObject = removed.details.logo.imageObject;
                        }
                    } catch(_) {}
                    state.canvasState.mapDeleteHistory.push({ map: copy, index: idx, canvasId: ac.id });
                    // Clear selection if the deleted map was selected
                    if (state.canvasState.selectedMapId === (removed && removed.id)) {
                        state.canvasState.selectedMapId = null;
                    }
                    if (Array.isArray(state.canvasState.selectedMapIds) && removed && removed.id != null) {
                        state.canvasState.selectedMapIds = state.canvasState.selectedMapIds.filter(id => id !== removed.id);
                    }
                    drawMainCanvas();
                    showNotification('Reapplied deletion.');
                }
            } catch(_) {}
            try { updateMapUndoRedoButtons(); } catch(_) {}
        }

        // Enable/disable Undo/Redo buttons for map deletions
        function updateMapUndoRedoButtons() {
            try {
                const ac = getActiveCanvas();
                const undoBtn = document.getElementById('undo-map-delete-btn');
                const redoBtn = document.getElementById('redo-map-delete-btn');
                if (undoBtn) {
                    const has = !!(Array.isArray(state.canvasState.mapDeleteHistory) && state.canvasState.mapDeleteHistory.some(e => e.canvasId === (ac && ac.id)));
                    undoBtn.disabled = !has;
                }
                if (redoBtn) {
                    const has = !!(Array.isArray(state.canvasState.mapDeleteRedo) && state.canvasState.mapDeleteRedo.some(e => e.canvasId === (ac && ac.id)));
                    redoBtn.disabled = !has;
                }
            } catch(_) {}
        }

        const getPanelAt = (worldX, worldY, activeCanvas) => {
            if (!activeCanvas || !Array.isArray(activeCanvas.maps)) return null;
            for (let i = activeCanvas.maps.length - 1; i >= 0; i--) {
                const m = activeCanvas.maps[i];
                const vr = getVisibleRectForMap(m);
                if (!vr) continue;
                if (worldX >= vr.left && worldX <= vr.right && worldY >= vr.top && worldY <= vr.bottom) {
                    return m.id;
                }
            }
            return null;
        };

        // --- Draw Mode helpers (v2) ---
        // Goal: make endpoint snapping reliable even near/over panel boundaries.
        const getAllowedRectForPanelId = (panelId, activeCanvas) => {
            if (panelId == null || !activeCanvas || !Array.isArray(activeCanvas.maps)) return null;
            const m = activeCanvas.maps.find(mm => mm && mm.id === panelId);
            return m ? getVisibleRectForMap(m) : null;
        };

        const getDrawSnapThresholdWorld = (zoom) => {
            const z = (zoom || 1);
            return (state.canvasState.drawSnapThreshold || 50) / z;
        };

        const findDrawSnapPoint = (x, y, activeCanvas, zoom, allowedRect, allowedPanelId, wantSnap) => {
            if (!wantSnap) return { x, y, snapped: false };
            const thresholdWorld = getDrawSnapThresholdWorld(zoom);
            // Prefer snapping within current panel scope, but fall back to global snapping
            // so users can connect across panel boundaries.
            let r = findSnapPoint(x, y, activeCanvas, thresholdWorld, allowedRect, allowedPanelId);
            if (!r.snapped) {
                r = findSnapPoint(x, y, activeCanvas, thresholdWorld, null, null);
            }
            return r;
        };

        const computeDrawStartContext = (worldX, worldY, activeCanvas, zoom, wantSnap) => {
            let panelId = getPanelAt(worldX, worldY, activeCanvas);
            let allowedRect = getAllowedRectForPanelId(panelId, activeCanvas);
            const snap = findDrawSnapPoint(worldX, worldY, activeCanvas, zoom, allowedRect, panelId, wantSnap);
            // If snapping moved the start point into a different panel, track that panel.
            const snappedPanelId = getPanelAt(snap.x, snap.y, activeCanvas);
            if (snappedPanelId != null) {
                panelId = snappedPanelId;
                allowedRect = getAllowedRectForPanelId(panelId, activeCanvas);
            }
            return { x: snap.x, y: snap.y, snapped: snap.snapped, panelId, allowedRect };
        };

        const findSnapPoint = (x, y, canvas, threshold, allowedRect, allowedPanelId) => {
            if (!canvas || !Array.isArray(canvas.drawings)) return { x, y, snapped: false };

            let bestSnap = { dist: Infinity, x, y };

            canvas.drawings.forEach(stroke => {
                if (allowedPanelId != null && typeof stroke.panelId !== 'undefined' && stroke.panelId !== allowedPanelId) {
                    return; // restrict snapping to strokes started in same panel
                }
                if (stroke.lineStyle === 'pencil' && stroke.points) {
                    // Snap to start/end of pencil strokes
                    const first = stroke.points[0];
                    const last = stroke.points[stroke.points.length - 1];
                    [first, last].forEach(p => {
                        if (allowedRect) {
                            if (p.x < allowedRect.left || p.x > allowedRect.right || p.y < allowedRect.top || p.y > allowedRect.bottom) return;
                        }
                        const d = Math.hypot(x - p.x, y - p.y);
                        if (d < threshold && d < bestSnap.dist) {
                            bestSnap = { dist: d, x: p.x, y: p.y };
                        }
                    });
                } else if (stroke.x1 != null) {
                    // Snap to start/end of straight lines
                    [{x: stroke.x1, y: stroke.y1}, {x: stroke.x2, y: stroke.y2}].forEach(p => {
                        if (allowedRect) {
                            if (p.x < allowedRect.left || p.x > allowedRect.right || p.y < allowedRect.top || p.y > allowedRect.bottom) return;
                        }
                        const d = Math.hypot(x - p.x, y - p.y);
                        if (d < threshold && d < bestSnap.dist) {
                            bestSnap = { dist: d, x: p.x, y: p.y };
                        }
                    });
                }
            });

            if (bestSnap.dist < threshold) {
                return { x: bestSnap.x, y: bestSnap.y, snapped: true };
            }
            return { x, y, snapped: false };
        };

        // Hit-test to find a stroke near a point (world coords). Returns { index } or null
        const findStrokeAtPoint = (canvasObj, x, y, threshold) => {
            if (!canvasObj || !Array.isArray(canvasObj.drawings)) return null;
            const distPointToSeg = (px, py, x1, y1, x2, y2) => {
                const vx = x2 - x1, vy = y2 - y1;
                const wx = px - x1, wy = py - y1;
                const c1 = vx*wx + vy*wy;
                if (c1 <= 0) return Math.hypot(px - x1, py - y1);
                const c2 = vx*vx + vy*vy;
                if (c2 <= 0) return Math.hypot(px - x1, py - y1);
                const t = Math.max(0, Math.min(1, c1 / c2));
                const projx = x1 + t * vx, projy = y1 + t * vy;
                return Math.hypot(px - projx, py - projy);
            };
            for (let i = canvasObj.drawings.length - 1; i >= 0; i--) {
                const s = canvasObj.drawings[i];
                if (s && s.lineStyle === 'pencil' && Array.isArray(s.points) && s.points.length > 1) {
                    for (let j = 0; j < s.points.length - 1; j++) {
                        const a = s.points[j], b = s.points[j+1];
                        const d = distPointToSeg(x, y, a.x, a.y, b.x, b.y);
                        if (d <= Math.max(threshold, (s.width||2)/2)) return { index: i };
                    }
                } else if (s && typeof s.x1 === 'number' && typeof s.y1 === 'number' && typeof s.x2 === 'number' && typeof s.y2 === 'number') {
                    const d = distPointToSeg(x, y, s.x1, s.y1, s.x2, s.y2);
                    const tol = Math.max(threshold, (s.width||2)/2);
                    if (d <= tol) return { index: i };
                    // Additional axis-aligned fallback for near-vertical or near-horizontal segments
                    const dx = s.x2 - s.x1;
                    const dy = s.y2 - s.y1;
                    const minX = Math.min(s.x1, s.x2) - tol;
                    const maxX = Math.max(s.x1, s.x2) + tol;
                    const minY = Math.min(s.y1, s.y2) - tol;
                    const maxY = Math.max(s.y1, s.y2) + tol;
                    // If segment is effectively vertical, check x proximity and y range
                    if (Math.abs(dx) < 1e-6) {
                        if (Math.abs(x - s.x1) <= tol && y >= minY && y <= maxY) return { index: i };
                    }
                    // If segment is effectively horizontal, check y proximity and x range
                    if (Math.abs(dy) < 1e-6) {
                        if (Math.abs(y - s.y1) <= tol && x >= minX && x <= maxX) return { index: i };
                    }
                }
            }
            return null;
        };

        // Compute a stroke's bounding box in world coordinates
        const getStrokeBounds = (s) => {
            if (!s) return null;
            if (s.lineStyle === 'pencil' && Array.isArray(s.points) && s.points.length > 0) {
                let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
                s.points.forEach(p => { if (!p) return; if (p.x < minX) minX = p.x; if (p.x > maxX) maxX = p.x; if (p.y < minY) minY = p.y; if (p.y > maxY) maxY = p.y; });
                if (!isFinite(minX) || !isFinite(minY) || !isFinite(maxX) || !isFinite(maxY)) return null;
                return { x1: minX, y1: minY, x2: maxX, y2: maxY };
            } else if (typeof s.x1 === 'number' && typeof s.y1 === 'number' && typeof s.x2 === 'number' && typeof s.y2 === 'number') {
                const x1 = Math.min(s.x1, s.x2), x2 = Math.max(s.x1, s.x2);
                const y1 = Math.min(s.y1, s.y2), y2 = Math.max(s.y1, s.y2);
                return { x1, y1, x2, y2 };
            }
            return null;
        };

        // Convert pointer coordinates into wrapper "layout pixels".
        // This compensates for UI scaling via `document.body.style.zoom` where
        // `getBoundingClientRect()` reflects visual pixels but `clientWidth/Height`
        // reflect layout pixels.
        const getPointerInWrapper = (e, wrapper) => {
            const rect = wrapper.getBoundingClientRect();
            const safeRectW = Math.max(1, rect.width || 0);
            const safeRectH = Math.max(1, rect.height || 0);
            const scaleX = (wrapper.clientWidth || safeRectW) / safeRectW;
            const scaleY = (wrapper.clientHeight || safeRectH) / safeRectH;
            const x = (e.clientX - rect.left) * scaleX;
            const y = (e.clientY - rect.top) * scaleY;
            // UI scale is uniform; use average to be robust.
            const uiScale = (scaleX + scaleY) / 2;
            return { x, y, uiScale };
        };

        const getMaskTileGrid = (activeCanvas, mask) => {
            const centerX = Number(mask?.x || 0) + Number(mask?.w || 0) / 2;
            const centerY = Number(mask?.y || 0) + Number(mask?.h || 0) / 2;
            const map = (activeCanvas?.maps || []).find(m => centerX >= Number(m.x || 0) && centerX <= Number(m.x || 0) + Number(m.width || 0) && centerY >= Number(m.y || 0) && centerY <= Number(m.y || 0) + Number(m.height || 0));
            return {
                map,
                x: Math.max(1, Number(map?.panelResWidth) || 128),
                y: Math.max(1, Number(map?.panelResHeight) || 128)
            };
        };
        const snapMaskToTile = (value, origin, step) => {
            const safeStep = Math.max(1, Number(step) || 1);
            const nearest = origin + Math.round((value - origin) / safeStep) * safeStep;
            const snapDistance = Math.min(48, Math.max(16, safeStep * 0.3));
            return Math.abs(value - nearest) <= snapDistance ? nearest : value;
        };

        const handleCanvasMouseDown = (e) => {
            const activeCanvas = getActiveCanvas();
            if (!activeCanvas) return;
            state.canvasState._mouseIsDown = true;
            const wrapper = document.getElementById('main-canvas-wrapper');
            if (!wrapper) return;
            wrapper.classList.remove('grabbing', 'mask-hover');
            const { zoom, panX, panY } = state.canvasState;
            const rulerSize = state.canvasState.rulers ? 30 : 0;

            const ptr = getPointerInWrapper(e, wrapper);
            const mouseXInWrapper = ptr.x;
            const mouseYInWrapper = ptr.y;
            const zoomForScreen = (zoom || 1) / (ptr.uiScale || 1);

            const regionOffsetX = state.canvasState.regionOffsetX || 0;
            const regionOffsetY = state.canvasState.regionOffsetY || 0;
            const worldX = (mouseXInWrapper - (panX + rulerSize + regionOffsetX)) / (zoom || 1);
            const worldY = (mouseYInWrapper - (panY + rulerSize + regionOffsetY)) / (zoom || 1);

            // Existing masks are always directly selectable; creation modes apply on empty canvas.
            const directMaskHit = hitTestMask(activeCanvas.masks || [], worldX, worldY);
            if (directMaskHit) {
                wrapper.classList.remove('grabbing');
                state.canvasState.maskMode = null;
                state.canvasState.maskDrawing = false;
                state.canvasState.maskPreview = null;
                state.canvasState.maskPolygonPoints = [];
                state.canvasState.selectedMaskId = directMaskHit.id;
                state.canvasState.maskDragging = false;
                state.canvasState.maskResizing = false;
                if (!directMaskHit.locked) {
                    const directHandle = hitTestMaskHandle(directMaskHit, worldX, worldY, Math.max(14, 18 / (zoom || 1)));
                    if (directHandle) {
                        state.canvasState.maskResizing = true;
                        state.canvasState.maskResizeHandle = directHandle;
                        state.canvasState.maskStart = { x: worldX, y: worldY, origX: directMaskHit.x, origY: directMaskHit.y, origW: directMaskHit.w, origH: directMaskHit.h };
                    } else {
                        state.canvasState.maskDragging = true;
                        state.canvasState.maskDragOffset = { x: worldX - directMaskHit.x, y: worldY - directMaskHit.y };
                        if (directMaskHit.type === "polygon" && directMaskHit.points?.length > 0) {
                            state.canvasState.maskDragOffset = { x: worldX, y: worldY, origPoints: JSON.parse(JSON.stringify(directMaskHit.points)) };
                        }
                    }
                }
                syncSelectedMaskProperties();
                updateMaskList();
                drawMainCanvas();
                return;
            }

            // Clicked outside any mask: if a mask was selected, deselect it and fall through to map hit-test
            if (state.canvasState.selectedMaskId != null) {
                state.canvasState.selectedMaskId = null;
                state.canvasState.maskDragging = false;
                state.canvasState.maskResizing = false;
                syncSelectedMaskProperties();
                if (typeof updateMaskList === 'function') updateMaskList();
                drawMainCanvas();
            }

            // ====== MASK CREATION MODES (rect, ellipse, polygon) ======
            if (state.canvasState.maskMode === "rect" || state.canvasState.maskMode === "ellipse") {
                state.canvasState.maskDrawing = true;
                state.canvasState.maskStart = { x: worldX, y: worldY };
                state.canvasState.maskPreview = { id: Date.now(), type: state.canvasState.maskMode, x: worldX, y: worldY, w: 0, h: 0,
                    color: document.getElementById("mask-fill-color")?.value || "#000000",
                    opacity: parseInt(document.getElementById("mask-fill-opacity")?.value || "100", 10) };
                return;
            } else if (state.canvasState.maskMode === "polygon") {
                const pts = state.canvasState.maskPolygonPoints;
                const snapThreshold = (state.canvasState.maskSnapThreshold || 12) / (state.canvasState.zoom || 1);
                // If we have 3+ points and click near the first point, close the polygon
                if (pts.length >= 3) {
                    const dx = worldX - pts[0].x, dy = worldY - pts[0].y;
                    if (Math.sqrt(dx*dx + dy*dy) <= snapThreshold) {
                        const ac = getActiveCanvas();
                        ac.masks = ac.masks || [];
                        const xs = pts.map(p => p.x), ys = pts.map(p => p.y);
                        const count = ac.masks.length + 1;
                        ac.masks.push({
                            id: Date.now(),
                            name: "Polygon " + count,
                            type: "polygon",
                            mode: document.getElementById("mask-prop-mode")?.value || "blackout",
                            points: JSON.parse(JSON.stringify(pts)),
                            x: Math.min(...xs), y: Math.min(...ys),
                            w: Math.max(...xs) - Math.min(...xs), h: Math.max(...ys) - Math.min(...ys),
                            feather: parseInt(document.getElementById("mask-prop-feather")?.value, 10) || 0,
                            visible: true,
                            locked: false,
                            color: document.getElementById("mask-fill-color")?.value || "#000000",
                            opacity: parseInt(document.getElementById("mask-fill-opacity")?.value || "100", 10)
                        });
                        state.canvasState.selectedMaskId = ac.masks[ac.masks.length - 1]?.id;
                        state.canvasState.maskPolygonPoints = [];
                        state.canvasState.maskMode = null;
                        updateMaskModeButtons();
                        saveState();
                        updateMaskList();
                        drawMainCanvas();
                        return;
                    }
                }
                // Otherwise, add point
                pts.push({ x: worldX, y: worldY });
                drawMainCanvas();
                return;
            }
            // ====== END MASK MOUSEDOWN ======

            // Manual line drawing mode takes precedence over other interactions (unless Select mode is on)
            const drawCfg = state.canvasState.drawing || {};

            if (drawCfg.selectEnabled && mouseXInWrapper > rulerSize && mouseYInWrapper > rulerSize) {
                // Try selecting a stroke or begin marquee
                const thresholdScreen = 8; // px
                const thresholdWorld = thresholdScreen / (zoomForScreen || 1);
                const hit = findStrokeAtPoint(activeCanvas, worldX, worldY, thresholdWorld);
                const multi = !!(e.ctrlKey || e.metaKey || e.shiftKey);
                if (hit && hit.index != null) {
                    const arr = Array.isArray(state.canvasState.drawing.selectedStrokeIndices) ? state.canvasState.drawing.selectedStrokeIndices : [];
                    if (multi) {
                        const i = arr.indexOf(hit.index);
                        if (i >= 0) arr.splice(i, 1); else arr.push(hit.index);
                        state.canvasState.drawing.selectedStrokeIndices = arr;
                        state.canvasState.drawing.selectedStrokeIndex = (arr.length === 1) ? arr[0] : null;
                    } else {
                        state.canvasState.drawing.selectedStrokeIndices = [hit.index];
                        state.canvasState.drawing.selectedStrokeIndex = hit.index;
                    }
                    // reset marquee
                    state.canvasState.drawing.marqueeSelecting = false;
                    state.canvasState.drawing.marqueeRect = null;
                    syncSelectionUIFromStroke();
                    renderDrawOverlay();
                    return;
                } else {
                    // Clear selection (unless multi append attempted) and start marquee selection
                    if (!multi) {
                        state.canvasState.drawing.selectedStrokeIndex = null;
                        state.canvasState.drawing.selectedStrokeIndices = [];
                        syncSelectionUIFromStroke();
                    }
                    state.canvasState.drawing.marqueeSelecting = true;
                    state.canvasState.drawing.marqueeRect = { x1: worldX, y1: worldY, x2: worldX, y2: worldY };
                    renderDrawOverlay();
                    return;
                }
            }
            if (drawCfg.enabled && mouseXInWrapper > rulerSize && mouseYInWrapper > rulerSize) {
                // Color palette for alternating lines
                if (!window._pixiLogicLinePalette) {
                    window._pixiLogicLinePalette = ['#ff0000', '#00bfff', '#00c853', '#ffab00', '#d500f9', '#ff4081', '#00e5ff', '#ffd600'];
                }
                if (typeof state.canvasState.drawing.nextColorIdx !== 'number') state.canvasState.drawing.nextColorIdx = 0;

                const wantSnap = !!(state.canvasState.drawing?.snapEnabled) || e.altKey || e.ctrlKey;
                const startCtx = computeDrawStartContext(worldX, worldY, activeCanvas, zoomForScreen, wantSnap);
                const startX = startCtx.x;
                const startY = startCtx.y;
                state.canvasState.drawing.startPanelId = startCtx.panelId;
                state.canvasState.drawing.allowedRect = startCtx.allowedRect;

                // Pencil mode: start a new freehand path
                if ((drawCfg.lineStyle || 'solid') === 'pencil') {
                    state.canvasState.drawing.preview = null;
                    state.canvasState.drawing.previewPath = [{ x: startX, y: startY }];
                    state.canvasState.drawing.arrowPoints = [];
                    state.canvasState.drawing.lastPanel = startCtx.panelId;
                    if (state.canvasState.drawing.multiColor) {
                        state.canvasState.drawing.color = window._pixiLogicLinePalette[state.canvasState.drawing.nextColorIdx % window._pixiLogicLinePalette.length];
                        state.canvasState.drawing.nextColorIdx++;
                    } else {
                        state.canvasState.drawing.color = state.canvasState.drawing.color || '#ff0000';
                    }
                } else {
                    state.canvasState.drawing.previewPath = null;
                    state.canvasState.drawing.preview = { x1: startX, y1: startY, x2: startX, y2: startY, snapped: startCtx.snapped };
                    state.canvasState.drawing.snapPoint = startCtx.snapped ? { x: startX, y: startY } : null;
                    if (state.canvasState.drawing.multiColor) {
                        state.canvasState.drawing.color = window._pixiLogicLinePalette[state.canvasState.drawing.nextColorIdx % window._pixiLogicLinePalette.length];
                        state.canvasState.drawing.nextColorIdx++;
                    } else {
                        state.canvasState.drawing.color = state.canvasState.drawing.color || '#ff0000';
                    }
                }
                renderDrawOverlay();
                return;
            }

            // If crop-by-panel mode is active and a map is selected, start a crop selection drag
            if (state.canvasState.cropMode && state.canvasState.selectedMapId != null && mouseXInWrapper > rulerSize && mouseYInWrapper > rulerSize) {
                const map = activeCanvas.maps.find(m => String(m.id) === String(state.canvasState.selectedMapId));
                if (map) {
                    const clamp = (v, min, max) => Math.max(min, Math.min(max, v));
                    const sx = clamp(worldX, map.x, map.x + map.width);
                    const sy = clamp(worldY, map.y, map.y + map.height);
                    state.canvasState.cropSelecting = true;
                    state.canvasState.cropStart = { x: sx, y: sy };
                    state.canvasState.cropRect = { x1: sx, y1: sy, x2: sx, y2: sy };
                    // Prevent map dragging in crop mode
                    state.canvasState.draggingMapId = null;
                    drawMainCanvas();
                    return;
                }
            }

            let clickedMapId = null;
            let clickedMap = null;
            // Hit-test maps using their actual visible rectangle (accounting for crop/slice)
            // Search top-to-bottom (activeCanvas.maps[length - 1] down to 0)
            const tol = Math.max(2, 6 / (zoom || 1));
            const hits = [];
            for (let i = activeCanvas.maps.length - 1; i >= 0; i--) {
                const map = activeCanvas.maps[i];
                const vr = getVisibleRectForMap(map);
                if (!vr || vr.width <= 0 || vr.height <= 0) continue;
                if (worldX >= vr.left - tol && worldX <= vr.right + tol &&
                    worldY >= vr.top - tol && worldY <= vr.bottom + tol) {
                    hits.push(map);
                }
            }

            if (hits.length > 0) {
                const currentSelId = state.canvasState.selectedMapId;
                if (hits.length > 1 && currentSelId != null && hits.some(m => String(m.id) === String(currentSelId))) {
                    // If multiple maps hit (overlapping or touching boundary) and one is already selected,
                    // pick the other map to cycle/toggle between them easily!
                    const other = hits.find(m => String(m.id) !== String(currentSelId));
                    clickedMap = other || hits[0];
                } else {
                    clickedMap = hits[0];
                }
                clickedMapId = clickedMap.id;
            }

            const multiSelect = !!(e.ctrlKey || e.metaKey || e.shiftKey);
            if (!Array.isArray(state.canvasState.selectedMapIds)) state.canvasState.selectedMapIds = [];

            state.canvasState._dragDistance = 0;
            state.canvasState._dragStartScreen = { x: mouseXInWrapper, y: mouseYInWrapper };
            state.canvasState._pendingSingleSelectMapId = null;

            if (clickedMapId != null) {
                const selIds = state.canvasState.selectedMapIds;
                const isAlreadySelected = selIds.some(id => String(id) === String(clickedMapId));

                if (multiSelect) {
                    const idx = selIds.findIndex(id => String(id) === String(clickedMapId));
                    if (idx >= 0) {
                        selIds.splice(idx, 1);
                        if (String(state.canvasState.selectedMapId) === String(clickedMapId)) {
                            state.canvasState.selectedMapId = selIds.length ? selIds[selIds.length - 1] : null;
                        }
                    } else {
                        selIds.push(clickedMapId);
                        state.canvasState.selectedMapId = clickedMapId;
                    }
                } else {
                    if (!isAlreadySelected) {
                        state.canvasState.selectedMapIds = [clickedMapId];
                        state.canvasState.selectedMapId = clickedMapId;
                    } else {
                        state.canvasState.selectedMapId = clickedMapId;
                        state.canvasState._pendingSingleSelectMapId = clickedMapId;
                    }
                }

                if (state.canvasState.selectedMapIds.some(id => String(id) === String(clickedMapId)) && clickedMap) {
                    state.canvasState.draggingMapId = clickedMapId;
                    state.canvasState.dragOffsetX = worldX - clickedMap.x;
                    state.canvasState.dragOffsetY = worldY - clickedMap.y;
                    state.canvasState.dragStartWorld = { x: worldX, y: worldY };
                    const starts = {};
                    state.canvasState.selectedMapIds.forEach(id => {
                        const m = activeCanvas.maps.find(mm => String(mm.id) === String(id));
                        if (m) starts[m.id] = { x: m.x, y: m.y };
                    });
                    state.canvasState.dragStartPositions = starts;
                }
            } else {
                if (!multiSelect) {
                    state.canvasState.selectedMapId = null;
                    state.canvasState.selectedMapIds = [];
                }
                state.canvasState.draggingMapId = null;
                state.canvasState.dragStartWorld = null;
                state.canvasState.dragStartPositions = null;
            }
            // Update cropping controls to reflect the current selection
            try {
                const ac = getActiveCanvas();
                const sel = ac?.maps?.find(m => String(m.id) === String(state.canvasState.selectedMapId));
                const leftEl = document.getElementById('crop-left-input');
                const rightEl = document.getElementById('crop-right-input');
                const topEl = document.getElementById('crop-top-input');
                const bottomEl = document.getElementById('crop-bottom-input');
                const pLeftEl = document.getElementById('crop-panels-left-input');
                const pRightEl = document.getElementById('crop-panels-right-input');
                const pTopEl = document.getElementById('crop-panels-top-input');
                const pBottomEl = document.getElementById('crop-panels-bottom-input');
                if (leftEl && rightEl && topEl && bottomEl) {
                    if (sel) {
                        leftEl.disabled = false; rightEl.disabled = false; topEl.disabled = false; bottomEl.disabled = false;
                        leftEl.value = (sel.cropLeft ?? sel.sliceLeft ?? 0);
                        rightEl.value = (sel.cropRight ?? sel.sliceRight ?? 0);
                        topEl.value = (sel.cropTop ?? 0);
                        bottomEl.value = (sel.cropBottom ?? 0);
                    } else {
                        leftEl.disabled = true; rightEl.disabled = true; topEl.disabled = true; bottomEl.disabled = true;
                        leftEl.value = 0; rightEl.value = 0; topEl.value = 0; bottomEl.value = 0;
                    }
                }
                if (pLeftEl && pRightEl && pTopEl && pBottomEl) {
                    if (sel) {
                        const pW = Math.max(1, sel.panelResWidth || 128);
                        const pH = Math.max(1, sel.panelResHeight || 128);
                        pLeftEl.disabled = false; pRightEl.disabled = false; pTopEl.disabled = false; pBottomEl.disabled = false;
                        pLeftEl.value = Math.floor((sel.cropLeft ?? sel.sliceLeft ?? 0) / pW);
                        pRightEl.value = Math.floor((sel.cropRight ?? sel.sliceRight ?? 0) / pW);
                        pTopEl.value = Math.floor((sel.cropTop ?? 0) / pH);
                        pBottomEl.value = Math.floor((sel.cropBottom ?? 0) / pH);
                    } else {
                        pLeftEl.disabled = true; pRightEl.disabled = true; pTopEl.disabled = true; pBottomEl.disabled = true;
                        pLeftEl.value = 0; pRightEl.value = 0; pTopEl.value = 0; pBottomEl.value = 0;
                    }
                }
            } catch(_){}

            if (!clickedMapId && mouseXInWrapper > rulerSize && mouseYInWrapper > rulerSize) {
                state.canvasState.isPanning = true;
                state.canvasState.lastPanX = mouseXInWrapper;
                state.canvasState.lastPanY = mouseYInWrapper;
                wrapper.classList.add('grabbing');
            }
            drawMainCanvas();
        };

        const handleCanvasMouseMove = (e) => {
            const { isPanning, draggingMapId, zoom, panX, panY, snapping, snapThreshold } = state.canvasState;
            const activeCanvas = getActiveCanvas();
            if (!activeCanvas) return;
            const wrapper = document.getElementById('main-canvas-wrapper');
            if(!wrapper) return;
            const rulerSize = state.canvasState.rulers ? 30 : 0;

            const ptr = getPointerInWrapper(e, wrapper);
            const mouseXInWrapper = ptr.x;
            const mouseYInWrapper = ptr.y;
            state.canvasState.rulerPointer = { x: mouseXInWrapper, y: mouseYInWrapper };
            const zoomForScreen = (zoom || 1) / (ptr.uiScale || 1);
            const regionOffsetX = state.canvasState.regionOffsetX || 0;
            const regionOffsetY = state.canvasState.regionOffsetY || 0;
            const worldX = (mouseXInWrapper - (panX + rulerSize + regionOffsetX)) / (zoom || 1);
            const worldY = (mouseYInWrapper - (panY + rulerSize + regionOffsetY)) / (zoom || 1);
            if (!state.canvasState.maskDragging && !state.canvasState.maskResizing) {
                wrapper.classList.toggle('mask-hover', !!hitTestMask(activeCanvas.masks || [], worldX, worldY));
            }
            if (!state.canvasState.isPanning && !state.canvasState.draggingMapId && !state.canvasState.maskMode && !drawCfg.enabled && !drawCfg.selectEnabled) {
                const tol = Math.max(2, 6 / (zoom || 1));
                const hoveringMap = (activeCanvas.maps || []).some(m => {
                    const vr = getVisibleRectForMap(m);
                    return vr && vr.width > 0 && vr.height > 0 &&
                        worldX >= vr.left - tol && worldX <= vr.right + tol &&
                        worldY >= vr.top - tol && worldY <= vr.bottom + tol;
                });
                wrapper.style.cursor = hoveringMap ? 'move' : 'default';
            }

            // ====== MASK MOUSEMOVE ======
            if (state.canvasState.maskDrawing && state.canvasState.maskPreview && state.canvasState.maskStart) {
                // Dragging to create rect/ellipse
                const s = state.canvasState.maskStart;
                let x = Math.min(s.x, worldX), y = Math.min(s.y, worldY);
                let w = Math.abs(worldX - s.x), h = Math.abs(worldY - s.y);
                if (e.shiftKey) { const sz = Math.max(w, h); w = sz; h = sz; } // hold shift for square/circle
                state.canvasState.maskPreview.x = x;
                state.canvasState.maskPreview.y = y;
                state.canvasState.maskPreview.w = w;
                state.canvasState.maskPreview.h = h;
                drawMainCanvas();
                return;
            }
            if (state.canvasState.maskDragging && state.canvasState.selectedMaskId) {
                const ac = getActiveCanvas();
                const mask = ac?.masks?.find(m => String(m.id) === String(state.canvasState.selectedMaskId));
                if (mask) {
                    const off = state.canvasState.maskDragOffset;
                    if (mask.type === "polygon" && off?.origPoints) {
                        const grid = getMaskTileGrid(ac, mask);
                        const originalXs = off.origPoints.map(pt => pt.x), originalYs = off.origPoints.map(pt => pt.y);
                        const rawX = Math.min(...originalXs) + (worldX - off.x);
                        const rawY = Math.min(...originalYs) + (worldY - off.y);
                        const snappedX = Number(grid.map?.x || 0) + Math.round((rawX - Number(grid.map?.x || 0)) / grid.x) * grid.x;
                        const snappedY = Number(grid.map?.y || 0) + Math.round((rawY - Number(grid.map?.y || 0)) / grid.y) * grid.y;
                        const dx = snappedX - Math.min(...originalXs);
                        const dy = snappedY - Math.min(...originalYs);
                        off.origPoints.forEach((pt, i) => { mask.points[i].x = pt.x + dx; mask.points[i].y = pt.y + dy; });
                        // Also update bounding x/y (recompute)
                        const xs = mask.points.map(p => p.x), ys = mask.points.map(p => p.y);
                        mask.x = Math.min(...xs); mask.y = Math.min(...ys);
                        mask.w = Math.max(...xs) - mask.x; mask.h = Math.max(...ys) - mask.y;
                    } else {
                        const grid = getMaskTileGrid(ac, mask);
                        const rawX = worldX - off.x;
                        const rawY = worldY - off.y;
                        mask.x = Number(grid.map?.x || 0) + Math.round((rawX - Number(grid.map?.x || 0)) / grid.x) * grid.x;
                        mask.y = Number(grid.map?.y || 0) + Math.round((rawY - Number(grid.map?.y || 0)) / grid.y) * grid.y;
                    }
                    drawMainCanvas();
                }
                return;
            }
            if (state.canvasState.maskResizing && state.canvasState.selectedMaskId) {
                const ac = getActiveCanvas();
                const mask = ac?.masks?.find(m => String(m.id) === String(state.canvasState.selectedMaskId));
                if (mask && state.canvasState.maskStart) {
                    const s = state.canvasState.maskStart;
                    const handle = state.canvasState.maskResizeHandle;
                    // Polygon vertex drag (handle = "v0", "v1", etc.)
                    if (typeof handle === "string" && handle.startsWith("v") && mask.type === "polygon" && mask.points) {
                        const vi = parseInt(handle.slice(1), 10);
                        if (vi >= 0 && vi < mask.points.length) {
                            const grid = getMaskTileGrid(ac, mask);
                            const originX = Number(grid.map?.x || 0);
                            const originY = Number(grid.map?.y || 0);
                            mask.points[vi].x = e.shiftKey ? worldX : originX + Math.round((worldX - originX) / grid.x) * grid.x;
                            mask.points[vi].y = e.shiftKey ? worldY : originY + Math.round((worldY - originY) / grid.y) * grid.y;
                            // Recompute bounding box
                            const xs = mask.points.map(p => p.x), ys = mask.points.map(p => p.y);
                            mask.x = Math.min(...xs); mask.y = Math.min(...ys);
                            mask.w = Math.max(...xs) - mask.x; mask.h = Math.max(...ys) - mask.y;
                        }
                        drawMainCanvas();
                        return;
                    }
                    let nx = s.origX, ny = s.origY, nw = s.origW, nh = s.origH;
                    if (handle.includes("w")) { nx = worldX; nw = s.origX + s.origW - worldX; }
                    if (handle.includes("e")) { nw = worldX - s.origX; }
                    if (handle.includes("n")) { ny = worldY; nh = s.origY + s.origH - worldY; }
                    if (handle.includes("s")) { nh = worldY - s.origY; }
                    // Proportional resize: hold Shift to keep aspect ratio
                    if (e.shiftKey && s.origW > 0 && s.origH > 0) {
                        const aspect = s.origW / s.origH;
                        if (handle === "n" || handle === "s") { nw = nh * aspect; }
                        else if (handle === "w" || handle === "e") { nh = nw / aspect; }
                        else { // corner handles
                            const newAspect = nw / (nh || 1);
                            if (newAspect > aspect) { nw = nh * aspect; }
                            else { nh = nw / aspect; }
                        }
                        // Re-anchor for w/n handles
                        if (handle.includes("w")) { nx = s.origX + s.origW - nw; }
                        if (handle.includes("n")) { ny = s.origY + s.origH - nh; }
                    }
                    // Normalize negative sizes
                    if (nw < 0) { nx += nw; nw = -nw; }
                    if (nh < 0) { ny += nh; nh = -nh; }
                    const grid = getMaskTileGrid(ac, mask);
                    const originX = Number(grid.map?.x || 0);
                    const originY = Number(grid.map?.y || 0);
                    const right = nx + nw;
                    const bottom = ny + nh;
                    const snappedLeft = handle.includes("w") ? originX + Math.round((nx - originX) / grid.x) * grid.x : nx;
                    const snappedRight = handle.includes("e") ? originX + Math.round((right - originX) / grid.x) * grid.x : right;
                    const snappedTop = handle.includes("n") ? originY + Math.round((ny - originY) / grid.y) * grid.y : ny;
                    const snappedBottom = handle.includes("s") ? originY + Math.round((bottom - originY) / grid.y) * grid.y : bottom;
                    mask.x = snappedLeft;
                    mask.y = snappedTop;
                    mask.w = Math.max(grid.x, snappedRight - snappedLeft);
                    mask.h = Math.max(grid.y, snappedBottom - snappedTop);
                    drawMainCanvas();
                }
                return;
            }
            // ====== END MASK MOUSEMOVE ======

            // Update marquee selection rectangle if selecting
            if (state.canvasState.drawing && state.canvasState.drawing.selectEnabled && state.canvasState.drawing.marqueeSelecting) {
                const mr = state.canvasState.drawing.marqueeRect || { x1: worldX, y1: worldY, x2: worldX, y2: worldY };
                mr.x2 = worldX; mr.y2 = worldY;
                state.canvasState.drawing.marqueeRect = mr;
                // Live update selection set to intersecting strokes
                const ax = Math.min(mr.x1, mr.x2), ay = Math.min(mr.y1, mr.y2);
                const aw = Math.abs(mr.x2 - mr.x1), ah = Math.abs(mr.y2 - mr.y1);
                const bx = ax + aw, by = ay + ah;
                const sel = [];
                const strokes = Array.isArray(activeCanvas.drawings) ? activeCanvas.drawings : [];
                for (let i = 0; i < strokes.length; i++) {
                    const b = getStrokeBounds(strokes[i]);
                    if (!b) continue;
                    const sx1 = Math.min(b.x1, b.x2), sy1 = Math.min(b.y1, b.y2);
                    const sx2 = Math.max(b.x1, b.x2), sy2 = Math.max(b.y1, b.y2);
                    const overlap = (sx1 <= bx && sx2 >= ax && sy1 <= by && sy2 >= ay);
                    if (overlap) sel.push(i);
                }
                state.canvasState.drawing.selectedStrokeIndices = sel;
                state.canvasState.drawing.selectedStrokeIndex = (sel.length === 1) ? sel[0] : null;
                renderDrawOverlay();
                return;
            }

            // Update preview while drawing (not in select-only mode)
            if (state.canvasState.drawing && !state.canvasState.drawing.selectEnabled) {
                if (state.canvasState.drawing.preview) {
                    const p = state.canvasState.drawing.preview;
                    let endX = worldX;
                    let endY = worldY;

                    if (e.shiftKey) {
                        const dx = Math.abs(endX - p.x1);
                        const dy = Math.abs(endY - p.y1);
                        if (dx > dy) {
                            endY = p.y1; // Lock to horizontal
                        } else {
                            endX = p.x1; // Lock to vertical
                        }
                    }
                    
                    const wantSnap = !!(state.canvasState.drawing?.snapEnabled) || e.altKey || e.ctrlKey;
                    if (wantSnap) {
                        const allowedRect = state.canvasState.drawing && state.canvasState.drawing.allowedRect;
                        const startPanelId = state.canvasState.drawing && state.canvasState.drawing.startPanelId;
                        const snapResult = findDrawSnapPoint(endX, endY, activeCanvas, zoomForScreen, allowedRect, startPanelId, true);
                        p.x2 = snapResult.x;
                        p.y2 = snapResult.y;
                        p.snapped = snapResult.snapped;
                        // Record snap point for visual indicator
                        state.canvasState.drawing.snapPoint = snapResult.snapped ? { x: snapResult.x, y: snapResult.y } : null;
                    } else {
                        p.x2 = endX;
                        p.y2 = endY;
                        p.snapped = false;
                        state.canvasState.drawing.snapPoint = null;
                    }

                    renderDrawOverlay();
                    return;
                } else if (state.canvasState.drawing.previewPath && (state.canvasState.drawing.lineStyle === 'pencil')) {
                    const pts = state.canvasState.drawing.previewPath;
                    const last = pts[pts.length - 1];
                    const dx = worldX - last.x, dy = worldY - last.y;
                    // add point when moved at least 2px to keep it light
                    if (dx*dx + dy*dy > 4) {
                        pts.push({ x: worldX, y: worldY });
                        // Panel crossing detection
                        const activeCanvas = getActiveCanvas();
                        const prevPanel = state.canvasState.drawing.lastPanel;
                        const newPanel = getPanelAt(worldX, worldY, activeCanvas);
                        if (prevPanel !== null && newPanel !== null && prevPanel !== newPanel) {
                            // Compute direction angle
                            const angle = Math.atan2(dy, dx);
                            state.canvasState.drawing.arrowPoints.push({ x: worldX, y: worldY, angle });
                        }
                        state.canvasState.drawing.lastPanel = newPanel;
                        renderDrawOverlay();
                    }
                    return;
                }
            }

            // Update crop rectangle while dragging in crop mode
            if (state.canvasState.cropSelecting) {
                const map = activeCanvas.maps.find(m => String(m.id) === String(state.canvasState.selectedMapId));
                if (map) {
                    const clamp = (v, min, max) => Math.max(min, Math.min(max, v));
                    const cx = clamp(worldX, map.x, map.x + map.width);
                    const cy = clamp(worldY, map.y, map.y + map.height);
                    const s = state.canvasState.cropStart || { x: cx, y: cy };
                    state.canvasState.cropRect = { x1: s.x, y1: s.y, x2: cx, y2: cy };
                    drawMainCanvas();
                }
                return;
            }
            
            if (isPanning) {
                const dx = mouseXInWrapper - state.canvasState.lastPanX;
                const dy = mouseYInWrapper - state.canvasState.lastPanY;
                state.canvasState.panX += dx;
                state.canvasState.panY += dy;
                state.canvasState.lastPanX = mouseXInWrapper;
                state.canvasState.lastPanY = mouseYInWrapper;
                drawMainCanvas();
            } else if (draggingMapId) {
                const startScreen = state.canvasState._dragStartScreen;
                if (startScreen) {
                    const dist = Math.hypot(mouseXInWrapper - startScreen.x, mouseYInWrapper - startScreen.y);
                    state.canvasState._dragDistance = dist;
                    if (dist < 4) {
                        return; // Stationary click: do not snap or move map
                    }
                }
                // Use the same inverse transform as for drawing so map drag follows the cursor under zoom/pan.
                const regionOffsetX = state.canvasState.regionOffsetX || 0;
                const regionOffsetY = state.canvasState.regionOffsetY || 0;
                const worldX = (mouseXInWrapper - (panX + rulerSize + regionOffsetX)) / (zoom || 1);
                const worldY = (mouseYInWrapper - (panY + rulerSize + regionOffsetY)) / (zoom || 1);
                const selIds = Array.isArray(state.canvasState.selectedMapIds) ? state.canvasState.selectedMapIds : [];
                const startWorld = state.canvasState.dragStartWorld;
                const startPositions = state.canvasState.dragStartPositions || {};
                if (selIds.length > 1 && startWorld) {
                    const dx = worldX - startWorld.x;
                    const dy = worldY - startWorld.y;
                    selIds.forEach(id => {
                        const m = activeCanvas.maps.find(mm => String(mm.id) === String(id));
                        const s = startPositions[m ? m.id : id] || startPositions[id];
                        if (m && s) {
                            m.x = s.x + dx;
                            m.y = s.y + dy;
                        }
                    });
                    state.canvasState.snapLines = [];
                    state.canvasState.gapGuides = null;
                    drawMainCanvas();
                    return;
                }

                const map = activeCanvas.maps.find(m => String(m.id) === String(draggingMapId));
                if (!map) return;

                // Calculate delta before updating map.x/map.y
                const oldX = map.x;
                const oldY = map.y;
                let newX = worldX - state.canvasState.dragOffsetX;
                let newY = worldY - state.canvasState.dragOffsetY;

                state.canvasState.snapLines = [];
                state.canvasState.gapGuides = null;

                if (snapping) {
                    const snapped = PixelLogicExternalEditing.snapMove(
                        { x: newX, y: newY, width: map.width, height: map.height }, map, activeCanvas,
                        snapThreshold / zoomForScreen, snapThreshold / zoomForScreen
                    );
                    newX = snapped.rect.x;
                    newY = snapped.rect.y;
                    state.canvasState.snapLines = snapped.guides.map(guide => guide.axis === 'x'
                        ? { x1: guide.value, y1: -10000, x2: guide.value, y2: 10000 }
                        : { x1: -10000, y1: guide.value, x2: 10000, y2: guide.value });
                }

                // Allow maps to move into negative space so users can position content left/up as needed
                // If you want to enforce bounds later, clamp against canvas extents instead of zero.

                map.x = Math.round(newX);
                map.y = Math.round(newY);

                // Move all lines whose endpoints are within the old map bounds by the same delta
                const dx = map.x - oldX;
                const dy = map.y - oldY;
                if (Math.abs(dx) > 0 || Math.abs(dy) > 0) {
                    const within = (x, y) => x >= oldX && x <= oldX + map.width && y >= oldY && y <= oldY + map.height;
                    (activeCanvas.drawings || []).forEach(s => {
                        if (s.lineStyle === 'pencil' && Array.isArray(s.points)) {
                            // Move all points if any are within the map
                            if (s.points.some(pt => within(pt.x, pt.y))) {
                                s.points.forEach(pt => { pt.x += dx; pt.y += dy; });
                                if (Array.isArray(s.arrowPoints)) s.arrowPoints.forEach(ap => { ap.x += dx; ap.y += dy; });
                            }
                        } else if (typeof s.x1 === 'number' && typeof s.y1 === 'number' && typeof s.x2 === 'number' && typeof s.y2 === 'number') {
                            // Move line if either endpoint is within the map
                            if (within(s.x1, s.y1) || within(s.x2, s.y2)) {
                                s.x1 += dx; s.y1 += dy; s.x2 += dx; s.y2 += dy;
                            }
                        }
                    });
                }

                // Compute gap guides against nearest other map (visible rect)
                try {
                    const getVisibleRect = (m, x, y) => {
                        const sw0 = Math.max(1, Math.floor(m?.calcs?.totalResWidth || m.width || 1));
                        const sh0 = Math.max(1, Math.floor(m?.calcs?.totalResHeight || m.height || 1));
                        const sL = Math.max(0, Math.floor(m.cropLeft ?? m.sliceLeft ?? 0));
                        const sR = Math.max(0, Math.floor(m.cropRight ?? m.sliceRight ?? 0));
                        const sT = Math.max(0, Math.floor(m.cropTop ?? 0));
                        const sB = Math.max(0, Math.floor(m.cropBottom ?? 0));
                        const totalCropW = Math.min(sw0, sL + sR);
                        const totalCropH = Math.min(sh0, sT + sB);
                        const srcX = Math.min(sL, sw0);
                        const srcY = Math.min(sT, sh0);
                        const srcW = Math.max(0, sw0 - totalCropW);
                        const srcH = Math.max(0, sh0 - totalCropH);
                        const scaleX = sw0 > 0 ? (m.width / sw0) : 1;
                        const scaleY = sh0 > 0 ? (m.height / sh0) : 1;
                        const left = x + scaleX * srcX;
                        const top = y + scaleY * srcY;
                        const right = left + scaleX * srcW;
                        const bottom = top + scaleY * srcH;
                        return { left, top, right, bottom, width: right-left, height: bottom-top };
                    };
                    const self = getVisibleRect(map, map.x, map.y);
                    let bestH = null, bestV = null; // {dist, line}
                    activeCanvas.maps.forEach(other => {
                        if (other.id === draggingMapId) return;
                        const r = getVisibleRect(other, other.x, other.y);
                        // Horizontal gap: if vertical overlap exists, measure edge distance
                        const vOverlap = Math.min(self.bottom, r.bottom) - Math.max(self.top, r.top);
                        if (vOverlap > 0) {
                            let dist = null, x1, x2, y;
                            if (self.right <= r.left) { dist = r.left - self.right; x1 = self.right; x2 = r.left; }
                            else if (r.right <= self.left) { dist = self.left - r.right; x1 = r.right; x2 = self.left; }
                            if (dist != null) {
                                y = Math.max(self.top, r.top) + vOverlap/2;
                                if (!bestH || dist < bestH.dist) bestH = { dist, x1, x2, y };
                            }
                        }
                        // Vertical gap: if horizontal overlap exists, measure edge distance
                        const hOverlap = Math.min(self.right, r.right) - Math.max(self.left, r.left);
                        if (hOverlap > 0) {
                            let dist = null, y1, y2, x;
                            if (self.bottom <= r.top) { dist = r.top - self.bottom; y1 = self.bottom; y2 = r.top; }
                            else if (r.bottom <= self.top) { dist = self.top - r.bottom; y1 = r.bottom; y2 = self.top; }
                            if (dist != null) {
                                x = Math.max(self.left, r.left) + hOverlap/2;
                                if (!bestV || dist < bestV.dist) bestV = { dist, y1, y2, x };
                            }
                        }
                    });
                    if (bestH || bestV) {
                        state.canvasState.gapGuides = {};
                        if (bestH) {
                            state.canvasState.gapGuides.h = { x1: bestH.x1, y1: bestH.y, x2: bestH.x2, y2: bestH.y, text: `${Math.round(bestH.dist)} px`, tx: (bestH.x1+bestH.x2)/2, ty: bestH.y };
                        }
                        if (bestV) {
                            state.canvasState.gapGuides.v = { x1: bestV.x, y1: bestV.y1, x2: bestV.x, y2: bestV.y2, text: `${Math.round(bestV.dist)} px`, tx: bestV.x, ty: (bestV.y1+bestV.y2)/2 };
                        }
                    }
                } catch(_) { /* ignore */ }

                drawMainCanvas();
            }

            if (state.canvasState.rulers) {
                 drawRulers(mouseXInWrapper, mouseYInWrapper);
            }
        };

        const handleCanvasMouseUp = () => {
            // Guard: prevent mouseleave from double-committing if mouseup already ran
            if (!state.canvasState._mouseIsDown) return;
            state.canvasState._mouseIsDown = false;
            const interactionContainer = document.getElementById('main-canvas-wrapper');
            if (interactionContainer) interactionContainer.classList.remove('grabbing', 'mask-hover');

            // ====== MASK MOUSEUP INTERCEPT ======
            if (state.canvasState.maskDrawing && state.canvasState.maskPreview) {
                // Commit rect/ellipse mask
                const preview = state.canvasState.maskPreview;
                if (preview.w > 2 && preview.h > 2) {
                    const ac = getActiveCanvas();
                    ac.masks = ac.masks || [];
                    const count = ac.masks.length + 1;
                    const typName = preview.type === "rect" ? "Rectangle" : preview.type === "ellipse" ? "Ellipse" : "Mask";
                    const modeVal = document.getElementById("mask-prop-mode")?.value || preview.mode || "blackout";
                    const radiusVal = preview.type === "rect" ? (parseInt(document.getElementById("mask-prop-radius")?.value, 10) || preview.radius || 0) : 0;
                    const featherVal = parseInt(document.getElementById("mask-prop-feather")?.value, 10) || preview.feather || 0;
                    ac.masks.push({
                        ...preview,
                        id: Date.now(),
                        name: preview.name || (typName + " " + count),
                        mode: modeVal,
                        radius: radiusVal,
                        feather: featherVal,
                        visible: true,
                        locked: false
                    });
                    state.canvasState.selectedMaskId = ac.masks[ac.masks.length - 1]?.id;
                    saveState();
                    updateMaskList();
                }
                state.canvasState.maskDrawing = false;
                state.canvasState.maskPreview = null;
                state.canvasState.maskStart = null;
                state.canvasState.maskMode = null;
                updateMaskModeButtons();
                syncSelectedMaskProperties(); if (typeof updateMaskList === 'function') updateMaskList();
                drawMainCanvas();
                return;
            }
            if (state.canvasState.maskDragging) {
                state.canvasState.maskDragging = false;
                state.canvasState.maskDragOffset = null;
                saveState();
                syncSelectedMaskProperties(); if (typeof updateMaskList === 'function') updateMaskList();
                drawMainCanvas();
                return;
            }
            if (state.canvasState.maskResizing) {
                state.canvasState.maskResizing = false;
                state.canvasState.maskResizeHandle = null;
                state.canvasState.maskStart = null;
                saveState();
                if (typeof syncMaskPropertiesToUI === 'function') syncMaskPropertiesToUI(); if (typeof updateMaskList === 'function') updateMaskList();
                drawMainCanvas();
                return;
            }
            // ====== END MASK MOUSEUP ======
            // Finish marquee selection if active
            if (state.canvasState.drawing && state.canvasState.drawing.marqueeSelecting) {
                state.canvasState.drawing.marqueeSelecting = false;
                // keep marqueeRect for a momentary draw; then clear on next render
                syncSelectionUIFromStroke();
                renderDrawOverlay();
                // Clear marquee rect after showing selection update
                state.canvasState.drawing.marqueeRect = null;
                return;
            }
            // Persist the last computed guides when interaction ends so the user can still see the gaps
            if (state.canvasState.gapGuides) {
                state.canvasState.persistentGuides = state.canvasState.gapGuides;
            }
            state.canvasState.gapGuides = null;
            // Commit preview stroke if present
            if (state.canvasState.drawing && (state.canvasState.drawing.preview || (Array.isArray(state.canvasState.drawing.previewPath) && state.canvasState.drawing.previewPath.length > 1))) {
                const activeCanvas = getActiveCanvas();
                if (activeCanvas) {
                    activeCanvas.drawings = activeCanvas.drawings || [];
                    // New stroke invalidates redo history
                    activeCanvas.drawingsRedo = [];
                    const drawCfg = state.canvasState.drawing || {};
                    const strokeColor = drawCfg.color || '#ff0000';
                    const strokeWidth = Math.max(1, drawCfg.width || 5);
                    const arrowSize = drawCfg.arrowSize || 1.2;
                    // Respect the UI toggles for arrowheads
                    const arrowStartFlag = !!drawCfg.arrowStart;
                    const arrowEndFlag = !!drawCfg.arrowEnd;
                    if (state.canvasState.drawing.previewPath && state.canvasState.drawing.lineStyle === 'pencil') {
                        const pts = state.canvasState.drawing.previewPath.slice();
                        const arrows = Array.isArray(state.canvasState.drawing.arrowPoints)
                            ? state.canvasState.drawing.arrowPoints.map(ap => ({ x: ap.x, y: ap.y, angle: ap.angle }))
                            : [];
                        if (pts.length > 1) {
                            activeCanvas.drawings.push({
                                points: pts,
                                arrowPoints: arrows,
                                color: strokeColor,
                                width: strokeWidth,
                                lineStyle: 'pencil',
                                arrowSize,
                                arrowStart: arrowStartFlag,
                                arrowEnd: arrowEndFlag,
                                panelId: state.canvasState.drawing.startPanelId
                            });
                        }
                    } else if (state.canvasState.drawing.preview) {
                        const p = state.canvasState.drawing.preview;
                        const dx = p.x2 - p.x1, dy = p.y2 - p.y1;
                        const angle = Math.atan2(dy, dx);
                        activeCanvas.drawings.push({
                            x1: p.x1, y1: p.y1, x2: p.x2, y2: p.y2,
                            color: strokeColor,
                            width: strokeWidth,
                            lineStyle: state.canvasState.drawing.lineStyle,
                            arrowSize,
                            arrowStart: arrowStartFlag,
                            arrowEnd: arrowEndFlag,
                            arrowAngle: angle,
                            panelId: state.canvasState.drawing.startPanelId
                        });
                    }
                }
                state.canvasState.drawing.preview = null;
                state.canvasState.drawing.previewPath = null;
                state.canvasState.drawing.arrowPoints = [];
                state.canvasState.drawing.lastPanel = null;
                state.canvasState.drawing.snapPoint = null;
                renderDrawOverlay();
                return;
            }
            // If finishing a crop selection, convert selection to crop values
            if (state.canvasState.cropSelecting) {
                const activeCanvas = getActiveCanvas();
                if (activeCanvas) {
                    const map = activeCanvas.maps.find(m => String(m.id) === String(state.canvasState.selectedMapId));
                    const r = state.canvasState.cropRect;
                    if (map && r) {
                        const rx = Math.min(r.x1, r.x2);
                        const ry = Math.min(r.y1, r.y2);
                        const rw = Math.abs(r.x2 - r.x1);
                        const rh = Math.abs(r.y2 - r.y1);
                        if (rw > 0 && rh > 0) {
                            const temp = document.createElement('canvas');
                            try { drawVisualizerCanvas(temp, map, { forceFullRes: true }); } catch(_){ }
                            const sw0 = temp.width || 0;
                            const sh0 = temp.height || 0;
                            if (sw0 > 0 && sh0 > 0) {
                                const scaleX = map.width / sw0;
                                const scaleY = map.height / sh0;
                                const clamp = (v, min, max) => Math.max(min, Math.min(max, v));
                                const srcXf = (rx - map.x) / scaleX;
                                const srcYf = (ry - map.y) / scaleY;
                                const srcWf = rw / scaleX;
                                const srcHf = rh / scaleY;
                                let srcX = Math.round(clamp(srcXf, 0, sw0));
                                let srcY = Math.round(clamp(srcYf, 0, sh0));
                                let srcW = Math.round(clamp(srcWf, 0, sw0 - srcX));
                                let srcH = Math.round(clamp(srcHf, 0, sh0 - srcY));
                                // Compute crop values from source rect
                                const left = srcX;
                                const top = srcY;
                                const right = Math.max(0, sw0 - (srcX + srcW));
                                const bottom = Math.max(0, sh0 - (srcY + srcH));
                                map.cropLeft = left; map.cropRight = right; map.cropTop = top; map.cropBottom = bottom;
                                map.sliceLeft = left; map.sliceRight = right; // back-compat
                                // Update inputs
                                const lEl = document.getElementById('crop-left-input'); if (lEl) lEl.value = left;
                                const rEl = document.getElementById('crop-right-input'); if (rEl) rEl.value = right;
                                const tEl = document.getElementById('crop-top-input'); if (tEl) tEl.value = top;
                                const bEl = document.getElementById('crop-bottom-input'); if (bEl) bEl.value = bottom;
                                showNotification('Crop applied from panel selection.');
                            }
                        }
                    }
                }
                state.canvasState.cropSelecting = false;
                state.canvasState.cropRect = null;
            }

            if (state.canvasState._pendingSingleSelectMapId != null) {
                if ((state.canvasState._dragDistance || 0) < 4) {
                    state.canvasState.selectedMapIds = [state.canvasState._pendingSingleSelectMapId];
                    state.canvasState.selectedMapId = state.canvasState._pendingSingleSelectMapId;
                }
                state.canvasState._pendingSingleSelectMapId = null;
            }
            state.canvasState._dragDistance = 0;
            state.canvasState._dragStartScreen = null;
            state.canvasState.isPanning = false;
            state.canvasState.draggingMapId = null;
            state.canvasState.dragStartWorld = null;
            state.canvasState.dragStartPositions = null;
            state.canvasState.snapLines = [];
            const container = document.getElementById('main-canvas-wrapper');
            if(container) container.classList.remove('grabbing');
            drawMainCanvas();
        };
        
        const handleCanvasWheel = (e) => {
            e.preventDefault();
            handleCanvasZoom(e.deltaY < 0 ? 1.1 : 1 / 1.1);
        };
        
        const handleCanvasZoom = (factor) => {
            state.canvasState.zoom = Math.max(0.05, Math.min(10, state.canvasState.zoom * factor));
            outputFrameRenderer.request();
        }
        
        const fitCanvasToScreen = () => {
            const container = document.getElementById('main-canvas-wrapper');
            const activeCanvas = getActiveCanvas();
            if(!container || !activeCanvas) return;
            
            const rulerSize = state.canvasState.rulers ? 30 : 0;
            const containerWidth = container.clientWidth - rulerSize;
            const containerHeight = container.clientHeight - rulerSize;
            const canvasWidth = activeCanvas.width;
            const canvasHeight = activeCanvas.height;
            
            if(canvasWidth === 0 || canvasHeight === 0) return;
            
            const scaleX = containerWidth / canvasWidth;
            const scaleY = containerHeight / canvasHeight;
            state.canvasState.zoom = Math.min(scaleX, scaleY) * 0.95;
            state.canvasState.panX = (containerWidth - canvasWidth * state.canvasState.zoom) / 2;
            state.canvasState.panY = (containerHeight - canvasHeight * state.canvasState.zoom) / 2;
            
            drawMainCanvas();
        };

        const drawRulers = (mouseX, mouseY) => {
            const rulerTop = document.getElementById('ruler-top');
            const rulerLeft = document.getElementById('ruler-left');
            const container = document.getElementById('main-canvas-wrapper');
            if(!rulerTop || !rulerLeft || !container) return;
            
            rulerTop.style.display = 'block';
            rulerLeft.style.display = 'block';

            const { zoom, panX, panY } = state.canvasState;
            const rulerSize = 30;
            
            rulerTop.width = container.clientWidth;
            rulerTop.height = rulerSize;
            rulerLeft.width = rulerSize;
            rulerLeft.height = container.clientHeight;
            
            const ctxTop = rulerTop.getContext('2d');
            const ctxLeft = rulerLeft.getContext('2d');
            
            ctxTop.fillStyle = '#1f2937'; // bg-gray-800
            ctxTop.fillRect(0, 0, rulerTop.width, rulerTop.height);
            ctxLeft.fillStyle = '#1f2937';
            ctxLeft.fillRect(0, 0, rulerLeft.width, rulerLeft.height);
            
            ctxTop.fillStyle = '#9ca3af'; // text-gray-400
            ctxTop.font = '10px Inter';
            ctxLeft.fillStyle = '#9ca3af';
            ctxLeft.font = '10px Inter';

            let interval = 100;
            if (zoom < 0.25) interval = 500;
            else if (zoom < 0.5) interval = 200;

            // Top Ruler (fixed origin: labels start at 0 and increase; pan does not shift label numbers)
            // Compute visible maximum world X based on displayed width and zoom
            const maxWorldX = Math.ceil((rulerTop.width - rulerSize) / zoom);
            for (let wx = 0; wx <= maxWorldX; wx += interval/10) {
                const screenX = wx * zoom + rulerSize; // ignore pan for label anchoring
                if (screenX < rulerSize || screenX > rulerTop.width) continue;
                const markHeight = (wx % interval === 0) ? 10 : (wx % (interval/2) === 0 ? 5 : 3);
                ctxTop.strokeStyle = (wx === 0) ? 'rgba(234, 179, 8, 0.7)' : '#9ca3af';
                ctxTop.beginPath();
                ctxTop.moveTo(screenX, rulerSize - markHeight);
                ctxTop.lineTo(screenX, rulerSize);
                ctxTop.stroke();
                if (wx % interval === 0) ctxTop.fillText(wx, screenX + 2, rulerSize - 12);
            }

            // Left Ruler (fixed origin: labels start at 0 and increase downward; pan does not shift label numbers)
            const maxWorldY = Math.ceil((rulerLeft.height - rulerSize) / zoom);
            for (let wy = 0; wy <= maxWorldY; wy += interval/10) {
                const screenY = wy * zoom + rulerSize; // ignore pan for label anchoring
                if (screenY < rulerSize || screenY > rulerLeft.height) continue;
                const markWidth = (wy % interval === 0) ? 10 : (wy % (interval/2) === 0 ? 5 : 3);
                ctxLeft.strokeStyle = (wy === 0) ? 'rgba(234, 179, 8, 0.7)' : '#9ca3af';
                ctxLeft.beginPath();
                ctxLeft.moveTo(rulerSize - markWidth, screenY);
                ctxLeft.lineTo(rulerSize, screenY);
                ctxLeft.stroke();
                if (wy % interval === 0) {
                    ctxLeft.save();
                    ctxLeft.translate(rulerSize - 12, screenY + 2);
                    ctxLeft.rotate(-Math.PI/2);
                    ctxLeft.fillText(wy, 0, 0);
                    ctxLeft.restore();
                }
            }

            // Mouse Indicators
            if (mouseX !== undefined && mouseY !== undefined) {
                if(mouseX >= rulerSize) {
                    ctxTop.fillStyle = 'rgba(234, 179, 8, 0.7)';
                    ctxTop.fillRect(mouseX, 0, 1, rulerSize);
                }
                if(mouseY >= rulerSize) {
                    ctxLeft.fillStyle = 'rgba(234, 179, 8, 0.7)';
                    ctxLeft.fillRect(0, mouseY, rulerSize, 1);
                }
            }
        };

        // --- PDF EXPORT LOGIC ---
        const handlePdfProjectChange = (e) => {
            state.pdfExport.selectedProjectId = parseInt(e.target.value);
            state.pdfExport.mapNames = {}; // Reset custom names when project changes
            state.pdfExport.pdfTitle = ''; // Reset title as well
            renderPdfExport();
        };
        
        const handlePdfMapNameChange = (e) => {
            const mapId = e.target.dataset.mapId;
            const newName = e.target.value;
            state.pdfExport.mapNames[mapId] = newName;
        };


        const handleTemplateUpload = (e) => {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = (event) => {
                    const imageUrl = event.target.result;
                    const image = new Image();
                    image.onload = () => {
                        state.pdfExport.customTemplateImage = image;
                        state.pdfExport.customTemplateSrc = imageUrl;
                        if (!state.pdfExport.useDefaultTemplate) {
                            state.pdfExport.templateSrc = imageUrl;
                            state.pdfExport.templateImage = image;
                            state.pdfExport.templateIsCustom = true;
                        }
                        state.pdfExport.templateOptOut = false;
                        try { localStorage.setItem('pdfTemplateOptOut', 'false'); } catch(_) {}
                        try { localStorage.setItem('pdfCustomTemplateSrc', imageUrl); } catch (err) { console.warn('Could not persist custom template to localStorage', err); }
                        try { localStorage.setItem('pdfTemplateIsCustom', 'true'); } catch (err) { console.warn('Could not persist template type', err); }
                        renderPdfExport(); // Re-render to show preview
                    };
                    image.src = imageUrl;
                };
                reader.readAsDataURL(file);
            }
        };

        // Build a standalone canvas representing an output-canvas-like object (high-res) for PDF inclusion
        // Accepts an object with { name, width, height, maps: [...] }
        const captureProjectCanvasToCanvas = (canvasObj) => {
            if (!canvasObj || !canvasObj.width || !canvasObj.height) return null;
            const exportCanvas = document.createElement('canvas');
            exportCanvas.width = canvasObj.width;
            exportCanvas.height = canvasObj.height;
            const ctx = exportCanvas.getContext('2d');
            // Background
            ctx.fillStyle = '#111827';
            ctx.fillRect(0, 0, exportCanvas.width, exportCanvas.height);

            // Draw each map snapshot
            if (Array.isArray(canvasObj.maps)) {
                canvasObj.maps.forEach(m => {
                    const temp = document.createElement('canvas');
                    // Full-resolution draw for PDF export
                    drawVisualizerCanvas(temp, m, { forceFullRes: true });
                    if (temp.width > 0 && temp.height > 0) {
                        const sw0 = temp.width;
                        const sh0 = temp.height;
                        const sL = Math.max(0, Math.floor((m.cropLeft ?? m.sliceLeft ?? 0)));
                        const sR = Math.max(0, Math.floor((m.cropRight ?? m.sliceRight ?? 0)));
                        const sT = Math.max(0, Math.floor((m.cropTop ?? 0)));
                        const sB = Math.max(0, Math.floor((m.cropBottom ?? 0)));
                        const maxCropW = Math.max(0, sw0 - 1);
                        const totalW = Math.min(sL + sR, maxCropW);
                        const maxCropH = Math.max(0, sh0 - 1);
                        const totalH = Math.min(sT + sB, maxCropH);
                        const srcX = Math.min(sL, sw0 - 1);
                        const srcW = Math.max(1, sw0 - totalW);
                        const srcY = Math.min(sT, sh0 - 1);
                        const srcH = Math.max(1, sh0 - totalH);
                        const scaleX = m.width / sw0;
                        const scaleY = m.height / sh0;
                        const destX = m.x + scaleX * sL;
                        const destW = scaleX * srcW;
                        const destY = m.y + scaleY * sT;
                        const destH = scaleY * srcH;
                        ctx.drawImage(temp, srcX, srcY, srcW, srcH, destX, destY, destW, destH);
                    }
                });
            }

            // Draw any manual drawing strokes stored on the canvas
            try { drawCanvasDrawingsToContext(ctx, canvasObj); } catch(_) {}

            // Mark some metadata for the PDF helper
            exportCanvas.__isCanvas = true;
            exportCanvas.name = canvasObj.name || 'Output Canvas';
            exportCanvas.mapsCount = canvasObj.maps ? canvasObj.maps.length : 0;
            return exportCanvas;
        };

        const captureCanvasPairToCanvas = (canvasPair) => {
            const items = (canvasPair || []).filter(Boolean).slice(0, 2);
            if (!items.length) return null;
            if (items.length === 1) return captureProjectCanvasToCanvas(items[0]);
            const combined = document.createElement('canvas');
            combined.width = 2000;
            combined.height = 1125;
            const ctx = combined.getContext('2d');
            ctx.fillStyle = '#f8fafc';
            ctx.fillRect(0, 0, combined.width, combined.height);
            const margin = 50;
            const gap = 40;
            const labelHeight = 70;
            const panelWidth = (combined.width - margin * 2 - gap) / 2;
            const panelHeight = combined.height - margin * 2;
            items.forEach((canvasObj, index) => {
                const panelX = margin + index * (panelWidth + gap);
                ctx.fillStyle = '#111827';
                ctx.fillRect(panelX, margin, panelWidth, panelHeight);
                ctx.fillStyle = '#ffffff';
                ctx.font = '700 28px Arial';
                ctx.textBaseline = 'top';
                ctx.fillText(canvasObj.name || `Canvas ${index + 1}`, panelX + 20, margin + 14, panelWidth - 40);
                ctx.fillStyle = '#9ca3af';
                ctx.font = '18px Arial';
                ctx.fillText(`${canvasObj.width} × ${canvasObj.height} px  |  ${(canvasObj.maps || []).length} map${(canvasObj.maps || []).length === 1 ? '' : 's'}`, panelX + 20, margin + 47, panelWidth - 40);
                const captured = captureProjectCanvasToCanvas(canvasObj);
                if (!captured) return;
                const imageAreaX = panelX + 20;
                const imageAreaY = margin + labelHeight + 16;
                const imageAreaW = panelWidth - 40;
                const imageAreaH = panelHeight - labelHeight - 36;
                const scale = Math.min(imageAreaW / captured.width, imageAreaH / captured.height);
                const drawWidth = captured.width * scale;
                const drawHeight = captured.height * scale;
                ctx.drawImage(captured, imageAreaX + (imageAreaW - drawWidth) / 2, imageAreaY + (imageAreaH - drawHeight) / 2, drawWidth, drawHeight);
            });
            combined.name = items.map(item => item.name || 'Canvas').join(' + ');
            combined.mapsCount = items.reduce((sum, item) => sum + (item.maps || []).length, 0);
            return combined;
        };

        const handlePdfSettingsChange = (e) => {
            const setting = e.target.dataset.pdfSetting;
            const value = e.target.value;
            state.pdfExport.placement[setting] = parseFloat(value);

            const labelEl = document.getElementById(`pdf-${setting}-label`);
            if (labelEl) labelEl.textContent = `${setting.charAt(0).toUpperCase() + setting.slice(1)} (${value}%)`;
            updatePdfPreviewOverlay();
            // persist placement so user doesn't need to re-adjust each session
            try {
                localStorage.setItem('pdfPlacement', JSON.stringify(state.pdfExport.placement));
            } catch (err) {
                console.warn('Could not persist PDF placement to localStorage', err);
            }
        };

        const updatePdfPreviewOverlay = () => {
            const overlay = document.getElementById('pdf-placement-preview');
            const label = document.getElementById('pdf-template-area-label');
            const labelTitle = document.getElementById('pdf-title-area-label');
            const labelDetails = document.getElementById('pdf-details-area-label');
            const labelTB = document.getElementById('pdf-title-block-area-label');
            const labelRef = document.getElementById('pdf-ref-area-label');
            const mapOutline = document.getElementById('pdf-map-area-outline');
            const titleBox = document.getElementById('pdf-title-area-preview');
            const detailsBox = document.getElementById('pdf-details-area-preview');
            const tbBox = document.getElementById('pdf-title-block-area-preview');
            const refBox = document.getElementById('pdf-ref-area-preview');
            const container = document.getElementById('template-preview-container');
            const imgEl = document.getElementById('template-preview');
            if (!overlay || !container) return;
            // Calculate displayed image rect within container (object-contain)
            const containerW = container ? container.clientWidth : 0;
            const containerH = container ? container.clientHeight : 0;
            const imgNaturalW = (imgEl && imgEl.naturalWidth) ? imgEl.naturalWidth : containerW;
            const imgNaturalH = (imgEl && imgEl.naturalHeight) ? imgEl.naturalHeight : containerH;
            const scaleToFit = Math.min(
                imgNaturalW ? containerW / imgNaturalW : 1,
                imgNaturalH ? containerH / imgNaturalH : 1
            );
            const dispW = imgNaturalW * scaleToFit;
            const dispH = imgNaturalH * scaleToFit;
            const offsetX = (containerW - dispW) / 2;
            const offsetY = (containerH - dispH) / 2;
            // Helper to place a rect and optional label
            const placeRect = (rect, boxEl, lblEl) => {
                if (!rect || !boxEl) return;
                // Clamp rect to 0..100 and ensure it doesn't exceed image bounds
                const rx = Math.max(0, Math.min(100, Number(rect.x || 0)));
                const ry = Math.max(0, Math.min(100, Number(rect.y || 0)));
                const rw = Math.max(0, Math.min(Number(rect.width || 0), 100 - rx));
                const rh = Math.max(0, Math.min(Number(rect.height || 0), 100 - ry));
                const x = offsetX + dispW * (rx / 100);
                const y = offsetY + dispH * (ry / 100);
                const w = dispW * (rw / 100);
                const h = dispH * (rh / 100);
                boxEl.style.left = `${x}px`;
                boxEl.style.top = `${y}px`;
                boxEl.style.width = `${w}px`;
                boxEl.style.height = `${h}px`;
                if (lblEl) {
                    lblEl.style.display = 'block';
                    lblEl.style.left = `${x + 2}px`;
                    lblEl.style.top = `${y + 2}px`;
                }
            };
            // Draw base areas
            if (mapOutline) placeRect(state.pdfExport.templateArea, mapOutline, label);
            if (titleBox) placeRect(state.pdfExport.titleArea, titleBox, labelTitle);
            if (detailsBox) placeRect(state.pdfExport.detailsArea, detailsBox, labelDetails);
            if (tbBox) placeRect(state.pdfExport.titleBlockArea, tbBox, labelTB);
            if (refBox) placeRect(state.pdfExport.refImageArea, refBox, labelRef);

            // When auto-fit, center a scaled overlay within Template Area; when manual, show placement box — all relative to displayed image rect
            const src = state.pdfExport.autoFitPlacement ? state.pdfExport.templateArea : state.pdfExport.placement;
            overlay.style.display = 'block';
            if (state.pdfExport.autoFitPlacement) {
                const s = Math.max(10, Math.min(200, state.pdfExport.mapScale || 100)) / 100;
                // Base template area within displayed image
                const areaX = offsetX + dispW * (src.x / 100);
                const areaY = offsetY + dispH * (src.y / 100);
                const areaW = dispW * (src.width / 100);
                const areaH = dispH * (src.height / 100);
                // Reduce available Y if title area overlaps
                const t = state.pdfExport.titleArea;
                if (t) {
                    const tX = offsetX + dispW * (t.x / 100);
                    const tY = offsetY + dispH * (t.y / 100);
                    const tW = dispW * (t.width / 100);
                    const tH = dispH * (t.height / 100);
                    const interLeft = Math.max(areaX, tX), interTop = Math.max(areaY, tY);
                    const interRight = Math.min(areaX + areaW, tX + tW), interBottom = Math.min(areaY + areaH, tY + tH);
                    if (interRight > interLeft && interBottom > interTop) {
                        const delta = (tY + tH) - areaY + 6; // 6px gap
                        // adjust areaY/H only visually for overlay
                        const adjY = areaY + Math.max(0, delta);
                        const adjH = Math.max(1, (areaY + areaH) - adjY);
                        // Overwrite locals
                        // eslint-disable-next-line no-var
                        var areaYLocal = adjY, areaHLocal = adjH;
                    }
                }
                // Determine target image aspect from selected project's first pixel map
                let aspect = 16 / 9;
                try {
                    const proj = state.projects.find(p => p.id == state.pdfExport.selectedProjectId) || state.projects[0];
                    const map = proj && Array.isArray(proj.pixelMaps) ? proj.pixelMaps[0] : null;
                    if (map) {
                        const calcs = calculateLayout(map);
                        if (calcs && calcs.totalResWidth > 0 && calcs.totalResHeight > 0) {
                            aspect = calcs.totalResWidth / calcs.totalResHeight;
                        }
                    }
                } catch (e) { /* fallback keeps default aspect */ }
                // Compute base fit box (aspect-fit) inside area
                const aY = (typeof areaYLocal === 'number') ? areaYLocal : areaY;
                const aH = (typeof areaHLocal === 'number') ? areaHLocal : areaH;
                let fitW = areaW;
                let fitH = fitW / aspect;
                if (fitH > aH) {
                    fitH = aH;
                    fitW = fitH * aspect;
                }
                // Apply user scale while preserving aspect
                let ovW = fitW * s;
                let ovH = fitH * s;
                // Ensure overlay does not exceed area by clamping with aspect preservation
                const ratio = ovW / ovH;
                if (ovW > areaW) { ovW = areaW; ovH = ovW / ratio; }
                if (ovH > aH) { ovH = aH; ovW = ovH * ratio; }
                const off = state.pdfExport.mapOffset || { x: 0, y: 0 };
                const remX = Math.max(0, areaW - ovW);
                const remY = Math.max(0, aH - ovH);
                let left = areaX + (areaW - ovW) / 2 + (remX * (off.x / 100));
                let top = aY + (aH - ovH) / 2 + (remY * (off.y / 100));
                // Clamp within area
                left = Math.max(areaX, Math.min(areaX + areaW - ovW, left));
                top = Math.max(aY, Math.min(aY + aH - ovH, top));
                overlay.style.width = `${ovW}px`;
                overlay.style.height = `${ovH}px`;
                overlay.style.left = `${left}px`;
                overlay.style.top = `${top}px`;
                if (label) { label.style.display = 'block'; label.style.left = `${areaX + 2}px`; label.style.top = `${aY + 2}px`; }
            } else {
                // Manual placement mode: clamp box to displayed image rect
                let left = offsetX + dispW * (src.x / 100);
                let top = offsetY + dispH * (src.y / 100);
                let width = dispW * (src.width / 100);
                let height = dispH * (src.height / 100);
                // Ensure size doesn't exceed image rect
                if (width > dispW) width = dispW;
                if (height > dispH) height = dispH;
                // Clamp position so box remains inside
                left = Math.max(offsetX, Math.min(offsetX + dispW - width, left));
                top = Math.max(offsetY, Math.min(offsetY + dispH - height, top));
                overlay.style.left = `${left}px`;
                overlay.style.top = `${top}px`;
                overlay.style.width = `${width}px`;
                overlay.style.height = `${height}px`;
                if (label) label.style.display = 'none';
            }
        };

    const ensurePdfRefImagesLoaded = async (projectForPdf) => {
        const promises = [];
        try {
            (projectForPdf?.pixelMaps || []).forEach(map => {
                const src = map && map.pdfRefImageSrc;
                if (src && (!map.__pdfRefImage || !map.__pdfRefImage.complete)) {
                    promises.push(new Promise((resolve) => {
                        const img = new Image();
                        img.onload = () => { map.__pdfRefImage = img; resolve(); };
                        img.onerror = () => resolve();
                        img.src = src;
                    }));
                }
            });
        } catch(_) {}
        if (promises.length) {
            try { await Promise.all(promises); } catch(_) {}
        }
    };

    const renderPdfToCanvases = async (doc, scale = 1.25) => {
        const pdfBlob = doc.output('blob');
        const arrayBuffer = await pdfBlob.arrayBuffer();
        const typedArray = new Uint8Array(arrayBuffer);
        const pdfjsLib = window['pdfjsLib'] || window['pdfjs-dist/build/pdf'] || window['pdfjs-dist'];
        if (!pdfjsLib || !pdfjsLib.getDocument) {
            throw new Error('PDF preview engine not available');
        }
        const loadingTask = pdfjsLib.getDocument({ data: typedArray });
        const pdf = await loadingTask.promise;
        const canvases = [];
        for (let pageNum = 1; pageNum <= pdf.numPages; pageNum++) {
            const page = await pdf.getPage(pageNum);
            const viewport = page.getViewport({ scale });
            const canvas = document.createElement('canvas');
            const context = canvas.getContext('2d');
            canvas.width = Math.floor(viewport.width);
            canvas.height = Math.floor(viewport.height);
            const renderContext = { canvasContext: context, viewport };
            await page.render(renderContext).promise;
            canvases.push(canvas);
        }
        return canvases;
    };

    /**
     * Render a project as a PDF using the built-in template gallery system.
     * Each page is composed as an HTML node sized to the chosen page size,
     * rasterized via html2canvas, and added as a single image to the PDF.
     */
    const renderSimpleVectorPdf = async (doc, projectForPdf, mode = 'save', options = {}) => {
        const pageW = doc.internal.pageSize.getWidth();
        const pageH = doc.internal.pageSize.getHeight();
        const accent = state.pdfExport.accentColor || '#0f2fa3';
        const tb = state.pdfExport.titleBlock || {};
        const pdfTitle = state.pdfExport.pdfTitle || projectForPdf.name || 'Project';

        const hexToRgb = (hex) => {
            const h = String(hex || '').replace('#', '');
            const n = h.length === 3 ? h.split('').map(ch => ch + ch).join('') : h;
            if (!/^[0-9a-fA-F]{6}$/.test(n)) return { r: 15, g: 47, b: 163 };
            return { r: parseInt(n.slice(0, 2), 16), g: parseInt(n.slice(2, 4), 16), b: parseInt(n.slice(4, 6), 16) };
        };
        const ac = hexToRgb(accent);
        const safe = (v) => String(v == null ? '' : v);

        const captureMapDataUrl = (map) => {
            try {
                const tmp = document.createElement('canvas');
                drawVisualizerCanvas(tmp, map, { forceFullRes: true });
                if (tmp.width > 0 && tmp.height > 0) return tmp.toDataURL('image/png');
            } catch (e) { console.warn('captureMapDataUrl (vector) failed', e); }
            return null;
        };

        const buildMapDetails = (map) => {
            const out = [];
            if (!map) return out;
            try {
                const calcs = (typeof calculateLayout === 'function') ? (calculateLayout(map) || {}) : {};
                const isComposite = !!(map.composite && map.composite.enabled);
                let panelsW = calcs.panelsHorizontally || 0;
                let panelsH = calcs.panelsVertically || 0;
                if (isComposite) {
                    const comp = map.composite || {};
                    const cA = calculateLayout(comp.primary || map) || {};
                    const cB = comp.secondary ? (calculateLayout(comp.secondary) || {}) : {};
                    const place = comp.placement || 'right';
                    const wA = cA.panelsHorizontally || 0, hA = cA.panelsVertically || 0;
                    const wB = cB.panelsHorizontally || 0, hB = cB.panelsVertically || 0;
                    if (place === 'left' || place === 'right') { panelsW = wA + wB; panelsH = Math.max(hA, hB); }
                    else { panelsW = Math.max(wA, wB); panelsH = hA + hB; }
                }

                const screenSizeText = (calcs.screenWidthMm)
                    ? `${(calcs.screenWidthMm / 1000).toFixed(2)} m x ${(calcs.screenHeightMm / 1000).toFixed(2)} m`
                    : null;
                const pitch = (typeof getCompositePitchMm === 'function') ? getCompositePitchMm(map) : null;
                const totalResW = calcs.totalResWidth;
                const totalResH = calcs.totalResHeight;

                if (screenSizeText) out.push(['Screen Size', screenSizeText]);
                if (totalResW && totalResH) out.push(['Resolution', `${totalResW} x ${totalResH} px`]);
                if (pitch != null) out.push(['Pixel Pitch', `${pitch} mm`]);
                if (panelsW && panelsH) out.push(['Total Tiles', `${panelsW} (W) x ${panelsH} (H)`]);
                if (!isComposite && map.panelWidthMm && map.panelHeightMm) out.push(['Panel Size', `${map.panelWidthMm} x ${map.panelHeightMm} mm`]);
                if (!isComposite && map.panelResWidth && map.panelResHeight) out.push(['Pixels per Tile', `${map.panelResWidth} x ${map.panelResHeight}`]);
                if (calcs.totalPanels) out.push(['Total Panels', `${calcs.totalPanels}`]);
            } catch (e) {
                console.warn('buildMapDetails (vector) failed', e);
            }
            return out;
        };

        const pages = [];
        if (state.pdfExport.includeTitlePage) pages.push({ pageType: 'cover' });
        const maps = projectForPdf.pixelMaps || [];
        for (const m of maps) pages.push({ pageType: 'map', map: m });
        const incCanvasMode = state.pdfExport.includeCanvas;
        if (incCanvasMode && incCanvasMode !== 'none') {
            const allOutputMaps = projectForPdf.canvases || [];
            let chosenOutputMaps = [];
            if (incCanvasMode === 'all') chosenOutputMaps = allOutputMaps;
            else if (incCanvasMode === 'specific') {
                const ids = (state.pdfExport.selectedCanvasIds || []).map(String);
                chosenOutputMaps = allOutputMaps.filter(c => ids.includes(String(c.id)));
            } else if (incCanvasMode === 'active') {
                const activeOutputMap = ensureOutputMapRegions(allOutputMaps.find(c => c.id === projectForPdf.activeCanvasId) || allOutputMaps[0]);
                const activeRegion = activeOutputMap?.regions.find(region => region.id === activeOutputMap.activeRegionId) || activeOutputMap?.regions[0];
                if (activeRegion) pages.push({ pageType: 'output', canvases: [activeRegion] });
            } else if (incCanvasMode === true) {
                chosenOutputMaps = allOutputMaps;
            }
            const chosenCanvases = chosenOutputMaps.flatMap(outputMap => ensureOutputMapRegions(outputMap)?.regions || []);
            for (let canvasIndex = 0; canvasIndex < chosenCanvases.length; canvasIndex += 2) {
                pages.push({ pageType: 'output', canvases: chosenCanvases.slice(canvasIndex, canvasIndex + 2) });
            }
        }
        pages.push({ pageType: 'delivery' });
        const totalPages = pages.length;

        const drawContainImage = (imgData, x, y, w, h) => {
            if (!imgData) return;
            try {
                const p = doc.getImageProperties(imgData);
                const iw = p && p.width ? p.width : w;
                const ih = p && p.height ? p.height : h;
                const s = Math.min(w / iw, h / ih);
                const rw = iw * s;
                const rh = ih * s;
                const rx = x + (w - rw) / 2;
                const ry = y + (h - rh) / 2;
                doc.addImage(imgData, 'PNG', rx, ry, rw, rh, undefined, 'FAST');
            } catch (_) {
                try { doc.addImage(imgData, 'PNG', x, y, w, h, undefined, 'FAST'); } catch(__) {}
            }
        };

        const drawCover = (pageNumber) => {
            doc.setFillColor(248, 250, 252);
            doc.rect(0, 0, pageW, pageH, 'F');
            doc.setTextColor(ac.r, ac.g, ac.b);
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(18);
            doc.text('PIXEL MAP SPECIFICATION DRAWING', pageW / 2, pageH * 0.28, { align: 'center' });
            doc.setTextColor(15, 23, 42);
            doc.setFontSize(56);
            const t = doc.splitTextToSize(safe(pdfTitle), pageW * 0.72);
            doc.text(t, pageW / 2, pageH * 0.40, { align: 'center' });
            doc.setTextColor(71, 85, 105);
            doc.setFont('helvetica', 'normal');
            doc.setFontSize(26);
            doc.text(safe(projectForPdf.client || tb.client || ''), pageW / 2, pageH * 0.50, { align: 'center' });

            const bx = pageW * 0.66, by = pageH * 0.56, bw = pageW * 0.30, bh = pageH * 0.30;
            doc.setDrawColor(15, 23, 42);
            doc.setLineWidth(1.5);
            doc.rect(bx, by, bw, bh);
            doc.setFillColor(ac.r, ac.g, ac.b);
            doc.rect(bx, by, bw, 34, 'F');
            doc.setTextColor(255, 255, 255);
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(14);
            doc.text(safe(projectForPdf.name || 'PROJECT').toUpperCase(), bx + 12, by + 22);

            const fields = [
                ['CLIENT', safe(tb.client || projectForPdf.client || '')],
                ['VENUE', safe(tb.venue || projectForPdf.venue || '')],
                ['DATE', safe(tb.projectDate || '')],
                ['DRAWN BY', safe(tb.drawnBy || '')],
                ['SALES', safe(tb.sales || projectForPdf.salesperson || '')],
                ['REVISION', safe(tb.version || '')],
            ];
            let yy = by + 56;
            doc.setFont('helvetica', 'normal');
            for (let i = 0; i < fields.length; i += 2) {
                const left = fields[i], right = fields[i + 1];
                doc.setTextColor(100, 116, 139);
                doc.setFontSize(10);
                doc.text(left[0], bx + 12, yy);
                if (right) doc.text(right[0], bx + bw * 0.52, yy);
                doc.setTextColor(15, 23, 42);
                doc.setFont('helvetica', 'bold');
                doc.setFontSize(11);
                doc.text(left[1], bx + 12, yy + 16, { maxWidth: bw * 0.42 });
                if (right) doc.text(right[1], bx + bw * 0.52, yy + 16, { maxWidth: bw * 0.42 });
                yy += 36;
            }

            doc.setTextColor(71, 85, 105);
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(14);
            doc.text(`Page ${pageNumber} / ${totalPages}`, pageW - 24, pageH - 18, { align: 'right' });
        };

        const drawMapLikePage = (ctx) => {
            const margin = 18;
            const headerH = 50;
            const footerH = 24;
            const rightW = Math.max(250, Math.round(pageW * 0.31));
            const mapX = margin;
            const mapY = headerH + margin;
            const mapW = pageW - rightW - margin * 3;
            const mapH = pageH - mapY - footerH - margin;
            const panelX = mapX + mapW + margin;

            doc.setFillColor(248, 250, 252);
            doc.rect(0, 0, pageW, pageH, 'F');

            doc.setFillColor(ac.r, ac.g, ac.b);
            doc.rect(0, 0, pageW, headerH, 'F');
            doc.setTextColor(255, 255, 255);
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(12);
            doc.text(safe(projectForPdf.name || '').toUpperCase(), margin, 16);
            doc.setFontSize(30);
            doc.text(doc.splitTextToSize(safe(ctx.mapTitle || 'Pixel Map'), pageW - 2 * margin), margin, 42, { maxWidth: pageW - 2 * margin });

            doc.setDrawColor(203, 213, 225);
            doc.setLineWidth(1);
            doc.rect(mapX, mapY, mapW, mapH);
            drawContainImage(ctx.mapImageDataUrl, mapX + 8, mapY + 8, mapW - 16, mapH - 16);

            doc.setDrawColor(226, 232, 240);
            doc.setFillColor(241, 245, 249);
            doc.rect(panelX, mapY, rightW, mapH, 'F');
            doc.line(panelX, mapY, panelX, mapY + mapH);

            const details = ctx.details || [];
            doc.setTextColor(ac.r, ac.g, ac.b);
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(12);
            doc.text('SPECIFICATIONS', panelX + 16, mapY + 26);
            doc.setDrawColor(ac.r, ac.g, ac.b);
            doc.line(panelX + 16, mapY + 30, panelX + rightW - 16, mapY + 30);

            const rowY0 = mapY + 52;
            const rowH = 22;
            const labelX = panelX + 16;
            const valueX = panelX + rightW - 16;
            doc.setFontSize(10);
            for (let i = 0; i < Math.min(details.length, 10); i++) {
                const row = details[i];
                const label = Array.isArray(row) ? safe(row[0]) : safe(row).split(':')[0];
                const value = Array.isArray(row) ? safe(row[1]) : safe(row).split(':').slice(1).join(':').trim();
                const y = rowY0 + i * rowH;
                doc.setDrawColor(226, 232, 240);
                doc.line(labelX, y + 6, valueX, y + 6);
                doc.setTextColor(100, 116, 139);
                doc.setFont('helvetica', 'normal');
                doc.text(label, labelX, y);
                doc.setTextColor(15, 23, 42);
                doc.setFont('helvetica', 'bold');
                doc.text(value || '-', valueX, y, { align: 'right', maxWidth: rightW * 0.54 });
            }

            let infoY = rowY0 + Math.min(details.length, 10) * rowH + 24;
            doc.setDrawColor(203, 213, 225);
            doc.line(labelX, infoY - 8, valueX, infoY - 8);
            const info = [
                ['CLIENT', safe(tb.client || projectForPdf.client || '')],
                ['VENUE', safe(tb.venue || projectForPdf.venue || '')],
                ['DATE', safe(tb.projectDate || '')],
            ];
            for (const [k, v] of info) {
                doc.setTextColor(148, 163, 184);
                doc.setFont('helvetica', 'bold');
                doc.setFontSize(8);
                doc.text(k, labelX, infoY);
                doc.setTextColor(15, 23, 42);
                doc.setFont('helvetica', 'bold');
                doc.setFontSize(10);
                doc.text(v, labelX, infoY + 15, { maxWidth: rightW - 32 });
                infoY += 34;
            }

            doc.setDrawColor(226, 232, 240);
            doc.line(0, pageH - footerH, pageW, pageH - footerH);
            doc.setTextColor(148, 163, 184);
            doc.setFont('helvetica', 'normal');
            doc.setFontSize(8);
            doc.text(`${safe(projectForPdf.client || '')} · Rev ${safe(tb.version || '')}`.replace(' · Rev ', tb.version ? ' · Rev ' : ''), margin, pageH - 8);
            doc.setTextColor(71, 85, 105);
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(10);
            doc.text(`Page ${ctx.pageNumber} / ${totalPages}`, pageW - margin, pageH - 8, { align: 'right' });
        };

        const drawDeliveryPage = (ctx) => {
            const ds = state.pdfExport.deliverySpec || {};
            doc.setFillColor(255, 255, 255);
            doc.rect(0, 0, pageW, pageH, 'F');
            doc.setTextColor(ac.r, ac.g, ac.b);
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(20);
            doc.text('VIDEO DELIVERY SPECIFICATIONS', 24, 34);
            doc.setDrawColor(ac.r, ac.g, ac.b);
            doc.line(24, 40, pageW - 24, 40);

            const fields = [
                ['Media Server', ds.mediaServer], ['Format', ds.format],
                ['Codecs', Array.isArray(ds.codecs) ? ds.codecs.join(', ') : ds.codecs],
                ...window.PixelLogicPdfTemplates.getCodecDownloadLinks(ds).map(link => [link.label, link.url, link.url]),
                ['Quality', ds.quality], ['Pixel Aspect Ratio', ds.pixelAspectRatio],
                ['Frame Rate', ds.fps], ['Embedded Audio', ds.embeddedAudio ? (ds.embeddedAudioDetails || 'Yes') : 'No'],
                ['Sample Rate', ds.sampleRate], ['Unembedded Audio', ds.unembeddedAudioFormat],
                ['Still Frame Format', ds.stillFrameFormat], ['Naming Structure', ds.namingStructure],
                ['Example', ds.example], ['Validation Email', ds.contentValidationEmail],
                ['Validation Note', ds.contentValidationNote], ['Comments', ds.comments]
            ].filter(([, v]) => safe(v).trim());

            let y = 60;
            for (const [k, v, url] of fields) {
                if (y > pageH - 40) break;
                doc.setTextColor(100, 116, 139);
                doc.setFont('helvetica', 'bold');
                doc.setFontSize(9);
                doc.text(k.toUpperCase(), 24, y + 2, { baseline: 'top' });
                if (url) doc.setTextColor(200, 0, 0);
                else doc.setTextColor(15, 23, 42);
                doc.setFont('helvetica', 'normal');
                doc.setFontSize(11);
                const lines = doc.splitTextToSize(safe(v), pageW - 210);
                const lineHeight = 11 * (doc.getLineHeightFactor ? doc.getLineHeightFactor() : 1.15);
                doc.text(lines, 180, y + 2, { maxWidth: pageW - 210, baseline: 'top' });
                if (url) {
                    const linkLineHeight = doc.getLineHeight() / doc.internal.scaleFactor;
                    lines.forEach((line, index) => doc.link(180, y + 2 + index * linkLineHeight,
                        doc.getTextWidth(line), linkLineHeight, { url }));
                }
                const h = Math.max(20, lines.length * lineHeight + 8);
                y += h;
                doc.setDrawColor(226, 232, 240);
                doc.line(24, y, pageW - 24, y);
            }
            doc.setTextColor(71, 85, 105);
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(10);
            doc.text(`Page ${ctx.pageNumber} / ${totalPages}`, pageW - 24, pageH - 10, { align: 'right' });
        };

        for (let i = 0; i < pages.length; i++) {
            const p = pages[i];
            if (i > 0) doc.addPage([pageW, pageH], state.pdfExport.pageOrientation || 'landscape');
            if (p.pageType === 'cover') {
                drawCover(i + 1);
                continue;
            }
            if (p.pageType === 'delivery') {
                drawDeliveryPage({ pageNumber: i + 1 });
                continue;
            }

            let mapTitle = '';
            let mapImageDataUrl = null;
            let details = [];
            if (p.pageType === 'map') {
                mapTitle = (state.pdfExport.mapNames && state.pdfExport.mapNames[p.map.id]) || p.map.name || `Pixel Map ${i + 1}`;
                mapImageDataUrl = captureMapDataUrl(p.map);
                details = buildMapDetails(p.map);
            } else if (p.pageType === 'output') {
                const canvasPair = p.canvases || (p.canvas ? [p.canvas] : []);
                mapTitle = canvasPair.map(canvas => canvas.name || 'Output Canvas').join(' + ');
                try {
                    const cap = captureCanvasPairToCanvas(canvasPair);
                    if (cap) mapImageDataUrl = cap.toDataURL('image/png');
                } catch (_) {}
                canvasPair.forEach(canvas => {
                    details.push([canvas.name || 'Canvas', `${canvas.width} × ${canvas.height} px | ${(canvas.maps || []).length} maps`]);
                });
            }
            drawMapLikePage({ pageNumber: i + 1, mapTitle, mapImageDataUrl, details });
        }

        if (options.suppressPanel) return true;
        if (mode === 'preview') {
            try {
                const canvases = await renderPdfToCanvases(doc, 1.25);
                const previewPanel = document.getElementById('pdf-preview-panel');
                const pagesContainer = document.getElementById('pdf-preview-pages');
                if (pagesContainer) {
                    pagesContainer.innerHTML = '';
                    canvases.forEach((cv, idx) => {
                        const wrap = document.createElement('div');
                        wrap.className = 'pdf-preview-page';
                        wrap.style.cssText = 'margin-bottom:14px;border:1px solid rgba(255,255,255,0.08);border-radius:6px;overflow:hidden;background:#fff;';
                        cv.style.cssText = 'width:100%;height:auto;display:block;';
                        wrap.appendChild(cv);
                        const lbl = document.createElement('div');
                        lbl.style.cssText = 'padding:6px 10px;font-size:11px;color:#94a3b8;background:rgba(15,23,42,0.6);';
                        lbl.textContent = `Page ${idx + 1} of ${canvases.length}`;
                        wrap.appendChild(lbl);
                        pagesContainer.appendChild(wrap);
                    });
                }
                if (previewPanel) previewPanel.style.display = 'block';
                state.pdfExport.previewPanelOpen = true;
                state.pdfExport.previewDirty = false;
                const dirty = document.getElementById('pdf-preview-dirty'); if (dirty) dirty.style.display = 'none';
                if (options.returnCanvases) return canvases;
                return true;
            } catch (e) {
                console.error('Vector simple preview failed', e);
                try { const blob = doc.output('blob'); window.open(URL.createObjectURL(blob), '_blank'); } catch (_) {}
                return false;
            }
        }
        const safeOut = (state.pdfExport.outputFileName || 'CANVASMAP_DETAILS').replace(/[\\/:*?"<>|]/g, '_');
        doc.save(`${safeOut}.pdf`);
        return true;
    };

    const renderGalleryPdf = async (doc, projectForPdf, mode = 'save', options = {}) => {
        if ((state.pdfExport && state.pdfExport.uiMode) === 'simple') {
            return renderSimpleVectorPdf(doc, projectForPdf, mode, options);
        }
        const PT = window.PixelLogicPdfTemplates;
        const tpl = PT.getTemplateById(state.pdfExport.galleryTemplateId);
        const pageSize = state.pdfExport.pageSize || 'a4';
        const orientation = state.pdfExport.pageOrientation || 'landscape';
        // Use jsPDF's actual page dimensions (in px) so the HTML render matches the PDF page exactly,
        // and so every subsequent addPage uses identical dimensions.
        const pageW = Math.round(doc.internal.pageSize.getWidth());
        const pageH = Math.round(doc.internal.pageSize.getHeight());

        const accentColor = state.pdfExport.accentColor || '#6366f1';
        const logoDataUrl = state.pdfExport.logoSrc || null;
        const titleBlock = state.pdfExport.titleBlock || {};
        const pdfTitle = state.pdfExport.pdfTitle || projectForPdf.name || '';

        // Pre-build a stable render host (kept near viewport origin to avoid off-screen text artifacts)
        const host = document.createElement('div');
        host.style.cssText = 'position:fixed;left:0;top:0;width:0;height:0;z-index:-1;pointer-events:none;overflow:visible;';
        document.body.appendChild(host);

        // Helper: capture a pixel map to data URL using existing draw helper
        const captureMapDataUrl = (map) => {
            try {
                const tmp = document.createElement('canvas');
                drawVisualizerCanvas(tmp, map, { forceFullRes: true });
                if (tmp.width > 0 && tmp.height > 0) return tmp.toDataURL('image/png');
            } catch (e) { console.warn('captureMapDataUrl failed', e); }
            return null;
        };

        // Build details array for a given map (mirrors legacy buildDetailsLines for parity)
        const buildMapDetails = (map) => {
            const out = [];
            if (!map) return out;
            try {
                const calcs = (typeof calculateLayout === 'function') ? (calculateLayout(map) || {}) : {};
                const isComposite = !!(map.composite && map.composite.enabled);
                let panelsW = calcs.panelsHorizontally || 0;
                let panelsH = calcs.panelsVertically || 0;
                if (isComposite) {
                    const comp = map.composite || {};
                    const cA = calculateLayout(comp.primary || map) || {};
                    const cB = comp.secondary ? (calculateLayout(comp.secondary) || {}) : {};
                    const place = comp.placement || 'right';
                    const wA = cA.panelsHorizontally || 0, hA = cA.panelsVertically || 0;
                    const wB = cB.panelsHorizontally || 0, hB = cB.panelsVertically || 0;
                    if (place === 'left' || place === 'right') { panelsW = wA + wB; panelsH = Math.max(hA, hB); }
                    else { panelsW = Math.max(wA, wB); panelsH = hA + hB; }
                }

                const screenSizeText = (calcs.screenWidthMm)
                    ? `${(calcs.screenWidthMm / 1000).toFixed(2)} m × ${(calcs.screenHeightMm / 1000).toFixed(2)} m`
                    : null;
                const pitch = (typeof getCompositePitchMm === 'function') ? getCompositePitchMm(map) : null;
                const totalResW = calcs.totalResWidth;
                const totalResH = calcs.totalResHeight;

                if (screenSizeText) out.push(`Screen Size: ${screenSizeText}`);
                if (totalResW && totalResH) out.push(`Resolution: ${totalResW} × ${totalResH} px`);
                if (pitch != null) out.push(`Pixel Pitch: ${pitch} mm`);
                if (panelsW && panelsH) out.push(`Total Tiles: ${panelsW} (W) × ${panelsH} (H)`);
                if (!isComposite && map.panelWidthMm && map.panelHeightMm) out.push(`Panel Size: ${map.panelWidthMm} × ${map.panelHeightMm} mm`);
                if (!isComposite && map.panelResWidth && map.panelResHeight) out.push(`Pixels per Tile: ${map.panelResWidth} × ${map.panelResHeight}`);
                if (calcs.totalPanels) out.push(`Total Panels: ${calcs.totalPanels}`);
                if (map.aspectRatio) out.push(`Aspect Ratio: ${map.aspectRatio}`);
            } catch (e) {
                console.warn('buildMapDetails (gallery) failed', e);
                if (map.name) out.push(`Map: ${map.name}`);
            }
            return out;
        };

        // Page list
        const pages = [];
        if (state.pdfExport.includeTitlePage) {
            pages.push({ pageType: 'cover' });
        }
        const maps = projectForPdf.pixelMaps || [];
        for (const m of maps) {
            pages.push({ pageType: 'map', map: m });
        }
        // Output canvases (active or selected)
        const incCanvasMode = state.pdfExport.includeCanvas;
        if (incCanvasMode && incCanvasMode !== 'none') {
            const allOutputMaps = projectForPdf.canvases || [];
            let chosenOutputMaps = [];
            if (incCanvasMode === 'all') chosenOutputMaps = allOutputMaps;
            else if (incCanvasMode === 'specific') {
                const ids = (state.pdfExport.selectedCanvasIds || []).map(String);
                chosenOutputMaps = allOutputMaps.filter(c => ids.includes(String(c.id)));
            } else if (incCanvasMode === 'active') {
                const activeOutputMap = ensureOutputMapRegions(allOutputMaps.find(c => c.id === projectForPdf.activeCanvasId) || allOutputMaps[0]);
                const activeRegion = activeOutputMap?.regions.find(region => region.id === activeOutputMap.activeRegionId) || activeOutputMap?.regions[0];
                if (activeRegion) pages.push({ pageType: 'output', canvases: [activeRegion] });
            } else if (incCanvasMode === true) {
                chosenOutputMaps = allOutputMaps;
            }
            const chosenCanvases = chosenOutputMaps.flatMap(outputMap => ensureOutputMapRegions(outputMap)?.regions || []);
            for (let canvasIndex = 0; canvasIndex < chosenCanvases.length; canvasIndex += 2) {
                pages.push({ pageType: 'output', canvases: chosenCanvases.slice(canvasIndex, canvasIndex + 2) });
            }
        }

        // Always append a Video Delivery Specifications page as the final page.
        // (Renderer shows a friendly placeholder if the user hasn't filled anything in.)
        pages.push({ pageType: 'delivery' });

        const totalPages = pages.length;

        const renderNodeToImage = async (node) => {
            node.style.position = 'fixed';
            node.style.left = '0';
            node.style.top = '0';
            node.style.margin = '0';
            host.appendChild(node);
            try {
                const canvas = await window.html2canvas(node, {
                    backgroundColor: '#ffffff',
                    scale: 2,
                    width: pageW,
                    height: pageH,
                    windowWidth: pageW,
                    windowHeight: pageH,
                    useCORS: true,
                    logging: false,
                    letterRendering: false,
                    scrollX: 0,
                    scrollY: 0,
                    removeContainer: true,
                    imageTimeout: 0,
                });
                // PNG keeps text crisp; JPEG at 0.92 introduces visible halo around small text.
                return canvas.toDataURL('image/png');
            } finally {
                if (node.parentNode === host) host.removeChild(node);
            }
        };

        try {
            for (let i = 0; i < pages.length; i++) {
                const p = pages[i];
                const pageNumber = i + 1;
                let mapTitle = '';
                let mapImageDataUrl = null;
                let details = [];

                if (p.pageType === 'map') {
                    mapTitle = (state.pdfExport.mapNames && state.pdfExport.mapNames[p.map.id]) || p.map.name || `Pixel Map ${pageNumber}`;
                    mapImageDataUrl = captureMapDataUrl(p.map);
                    details = buildMapDetails(p.map);
                } else if (p.pageType === 'output') {
                    const canvasPair = p.canvases || (p.canvas ? [p.canvas] : []);
                    mapTitle = canvasPair.map(canvas => canvas.name || 'Output Canvas').join(' + ');
                    try {
                        const cap = captureCanvasPairToCanvas(canvasPair);
                        if (cap) mapImageDataUrl = cap.toDataURL('image/png');
                    } catch (e) { console.warn('canvas capture failed', e); }
                    canvasPair.forEach(canvas => {
                        details.push(`${canvas.name || 'Canvas'}: ${canvas.width} × ${canvas.height} px | ${(canvas.maps || []).length} maps`);
                    });
                }

                const ctx = {
                    pageType: p.pageType,
                    pageNumber,
                    totalPages,
                    widthPx: pageW,
                    heightPx: pageH,
                    accentColor,
                    logoDataUrl,
                    project: {
                        name: projectForPdf.name,
                        client: projectForPdf.client,
                        venue: projectForPdf.venue,
                        salesperson: projectForPdf.salesperson,
                    },
                    titleBlock,
                    mapTitle,
                    mapImageDataUrl,
                    details,
                    pdfTitle,
                    deliverySpec: state.pdfExport.deliverySpec || {},
                    fontScale: state.pdfExport.fontScale || 1,
                };

                // Delivery page is rendered by the shared helper (template-agnostic).
                const node = (p.pageType === 'delivery' && PT.renderDeliveryPage)
                    ? PT.renderDeliveryPage(ctx)
                    : tpl.renderPage(ctx);
                const imgData = await renderNodeToImage(node);

                if (i > 0) doc.addPage([pageW, pageH], orientation);
                else {
                    // First page already exists from constructor; ensure the size matches.
                    // (jsPDF formats are name-based; our pageW/pageH should match.)
                }
                doc.addImage(imgData, 'PNG', 0, 0, doc.internal.pageSize.getWidth(), doc.internal.pageSize.getHeight(), undefined, 'NONE');
            }
        } finally {
            try { document.body.removeChild(host); } catch (_) {}
        }

        // Output (mirror legacy behaviour)
        if (options.suppressPanel) return true;
        if (mode === 'preview') {
            try {
                const canvases = await renderPdfToCanvases(doc, 1.25);
                const previewPanel = document.getElementById('pdf-preview-panel');
                const pagesContainer = document.getElementById('pdf-preview-pages');
                if (pagesContainer) {
                    pagesContainer.innerHTML = '';
                    canvases.forEach((cv, idx) => {
                        const wrap = document.createElement('div');
                        wrap.className = 'pdf-preview-page';
                        wrap.style.cssText = 'margin-bottom:14px;border:1px solid rgba(255,255,255,0.08);border-radius:6px;overflow:hidden;background:#fff;';
                        cv.style.cssText = 'width:100%;height:auto;display:block;';
                        wrap.appendChild(cv);
                        const lbl = document.createElement('div');
                        lbl.style.cssText = 'padding:6px 10px;font-size:11px;color:#94a3b8;background:rgba(15,23,42,0.6);';
                        lbl.textContent = `Page ${idx + 1} of ${canvases.length}`;
                        wrap.appendChild(lbl);
                        pagesContainer.appendChild(wrap);
                    });
                }
                if (previewPanel) previewPanel.style.display = 'block';
                state.pdfExport.previewPanelOpen = true;
                state.pdfExport.previewDirty = false;
                const dirty = document.getElementById('pdf-preview-dirty'); if (dirty) dirty.style.display = 'none';
                if (options.returnCanvases) return canvases;
                return true;
            } catch (e) {
                console.error('Gallery preview render failed', e);
                try { const blob = doc.output('blob'); window.open(URL.createObjectURL(blob), '_blank'); } catch (_) {}
                return false;
            }
        }
        // mode === 'save'
        const safeOut = (state.pdfExport.outputFileName || 'CANVASMAP_DETAILS').replace(/[\\/:*?"<>|]/g, '_');
        doc.save(`${safeOut}.pdf`);
        return true;
    };

    const generatePdf = async (mode = 'save', options = {}) => {
            try {
            const jspdfUmd = window.jspdf;
            if (!jspdfUmd || !jspdfUmd.jsPDF) {
                showNotification('PDF engine not loaded. Please check your internet connection and reload the page.');
                return;
            }
            const { jsPDF } = jspdfUmd;
            const projectForPdf = state.projects.find(p => p.id == state.pdfExport.selectedProjectId);
            
            if (!projectForPdf || projectForPdf.pixelMaps.length === 0) {
                showNotification('Please select a project with at least one pixel map to export.');
                return;
            }

            showNotification('Generating PDF... This may take a moment.');

            // Resolve page size + orientation from state (gallery mode) or fall back to legacy A4 landscape.
            const _pdfPageSize = (state.pdfExport.pageSize || 'a4').toLowerCase();
            const _pdfOrientation = (state.pdfExport.pageOrientation || 'landscape').toLowerCase();
            const doc = new jsPDF({
                orientation: _pdfOrientation === 'portrait' ? 'portrait' : 'landscape',
                unit: 'px',
                format: _pdfPageSize,
                compress: true
            });

            const encodeAdvancedPdfImage = (sourceCanvas, drawWidth, drawHeight) => {
                const PRINT_DPI = 300;
                const PDF_BASE_DPI = 96;
                const maxWidth = Math.max(1, Math.ceil(drawWidth * PRINT_DPI / PDF_BASE_DPI));
                const maxHeight = Math.max(1, Math.ceil(drawHeight * PRINT_DPI / PDF_BASE_DPI));
                const scale = Math.min(1, maxWidth / sourceCanvas.width, maxHeight / sourceCanvas.height);
                const output = document.createElement('canvas');
                output.width = Math.max(1, Math.round(sourceCanvas.width * scale));
                output.height = Math.max(1, Math.round(sourceCanvas.height * scale));
                const context = output.getContext('2d');
                context.fillStyle = '#ffffff';
                context.fillRect(0, 0, output.width, output.height);
                context.imageSmoothingEnabled = true;
                context.imageSmoothingQuality = 'high';
                context.drawImage(sourceCanvas, 0, 0, output.width, output.height);
                return output.toDataURL('image/jpeg', 0.92);
            };

            // === Built-in Template Gallery render path ============================
            // When the user picks a gallery template, we bypass the legacy zone-based
            // template image overlay system entirely and render each page from a
            // professionally-designed HTML template via html2canvas.
            if (state.pdfExport.templateMode !== 'custom'
                && window.PixelLogicPdfTemplates
                && window.html2canvas) {
                try {
                    const result = await renderGalleryPdf(doc, projectForPdf, mode, options);
                    return result;
                } catch (galleryErr) {
                    console.error('Gallery PDF render failed, falling back to legacy:', galleryErr);
                    showNotification('Gallery template render failed — falling back to legacy export.');
                    // Fall through to legacy code below.
                }
            }
            // === End gallery path =================================================


            // Ensure any per-map reference images are loaded before drawing pages
            try { await ensurePdfRefImagesLoaded(projectForPdf); } catch(_) {}

            // Determine typography with Microsoft font name mapping to jsPDF core fonts
            const ts = (state.pdfExport && state.pdfExport.textStyle) || {};
            const msMap = { arial: 'helvetica', timesnewroman: 'times', couriernew: 'courier' };
            const selectedFamily = String(ts.fontFamily || 'helvetica').toLowerCase();
            const mappedFamily = msMap[selectedFamily] || (['helvetica', 'times', 'courier'].includes(selectedFamily) ? selectedFamily : 'helvetica');
            const effectiveFamily = mappedFamily || 'helvetica';
            try { doc.setFont(effectiveFamily, 'normal'); } catch (_) { try { doc.setFont('helvetica', 'normal'); } catch(__) {} }

            // Helper: draw Title Block values inside Title Block Area with labels, two columns, and page number
            const drawTitleBlock = (doc, pageNumber, totalPages) => {
                try {
                    if (!state.pdfExport.showTitleBlock) return;
                    const area = state.pdfExport.titleBlockArea || { x: 79, y: 18, width: 18, height: 76 };
                    const pageWidth = doc.internal.pageSize.getWidth();
                    const pageHeight = doc.internal.pageSize.getHeight();
                    const x0 = pageWidth * (area.x / 100);
                    const y0 = pageHeight * (area.y / 100);
                    const w = pageWidth * (area.width / 100);
                    const h = pageHeight * (area.height / 100);
                    const padX = Math.max(6, Math.round(w * 0.08));
                    const padY = Math.max(6, Math.round(h * 0.04));

                    const s = state.pdfExport.titleBlock || {};
                    const proj = projectForPdf;
                    const entries = [
                        { label: 'Project Name', value: (s.projectName || proj?.name || '').toString() },
                        { label: 'Project Date', value: (s.projectDate || '').toString() },
                        { label: 'Venue', value: (s.venue || proj?.venue || '').toString() },
                        { label: 'Sales', value: (s.sales || proj?.salesperson || '').toString() },
                        { label: 'Client', value: (s.client || proj?.client || '').toString() },
                        { label: 'Page no', value: `Page ${pageNumber}${totalPages ? ` of ${totalPages}` : ''}` },
                        { label: 'Drawn By', value: (s.drawnBy || '').toString() },
                        { label: 'Version', value: (s.version || '').toString() },
                    ];

                    // Single-column layout: one field per line (Label: Value), wrapping values as needed
                    const innerX = x0 + padX;
                    const innerY = y0 + padY;
                    const innerW = w - padX * 2;
                    const innerH = h - padY * 2;

                    // Typography settings and fallbacks
                    const tbs = (state.pdfExport && state.pdfExport.titleBlockStyle) || {};
                    let labelFS = Math.round(Number.isFinite(tbs.labelBaseFS) ? tbs.labelBaseFS : 8);
                    let valueFS = Math.round(Number.isFinite(tbs.valueBaseFS) ? tbs.valueBaseFS : 9);
                    const minLabelFS = Math.max(5, Math.min(labelFS, Math.round(Number.isFinite(tbs.minLabelFS) ? tbs.minLabelFS : 6)));
                    const minValueFS = Math.max(5, Math.min(valueFS, Math.round(Number.isFinite(tbs.minValueFS) ? tbs.minValueFS : 7)));
                    let entryGap = Number.isFinite(tbs.entryGap) ? tbs.entryGap : 4;

                    // Layout tuning: tighter label-to-value spacing using per-row label width
                    let lhScale = 1.2; // start with comfortable line height
                    const cellPadX = 2; // horizontal padding inside each outlined row
                    const rowPadY = 1; // vertical padding inside each outlined row
                    const valueGapX = 2; // gap between label and value text
                    const minWrap = 20; // minimal wrap width for value text
                    const measureHeight = () => {
                        const lhLabel = Math.round(labelFS * lhScale);
                        const lhValue = Math.round(valueFS * lhScale);
                        let total = 0;
                        // measure label widths (bold) including colon
                        try { doc.setFont(effectiveFamily, 'bold'); } catch(_) { try { doc.setFont('helvetica', 'bold'); } catch(__) {} }
                        doc.setFontSize(labelFS);
                        const labelWidths = entries.map(e => doc.getTextWidth(String((e.label || '') + ' :')));
                        // wrap values (normal)
                        try { doc.setFont(effectiveFamily, 'normal'); } catch(_) { try { doc.setFont('helvetica', 'normal'); } catch(__) {} }
                        doc.setFontSize(valueFS);
                        for (let idx = 0; idx < entries.length; idx++) {
                            const e = entries[idx];
                            const available = innerW - cellPadX * 2 - labelWidths[idx] - valueGapX;
                            const valueWrapW = Math.max(minWrap, available);
                            const wrapped = doc.splitTextToSize(String(e.value || ''), valueWrapW);
                            const lines = Math.max(1, wrapped.length);
                            total += (rowPadY * 2) + Math.max(lhLabel, lines * lhValue);
                            if (idx !== entries.length - 1) total += entryGap; // no extra gap after last
                        }
                        return { total, lhLabel, lhValue };
                    };

                    

                    // Shrink fonts if needed to fit height
                    let metrics = measureHeight();
                    while (metrics.total > innerH) {
                        if (valueFS > minValueFS) {
                            valueFS -= 1;
                        } else if (labelFS > minLabelFS) {
                            labelFS -= 1;
                        } else if (entryGap > 1) {
                            entryGap -= 1;
                        } else if (lhScale > 1.05) {
                            lhScale = Math.max(1.05, +(lhScale - 0.05).toFixed(2));
                        } else {
                            break; // can't shrink further
                        }
                        // Recompute metrics as font sizes/spacing change
                        metrics = measureHeight();
                    }

                    // Draw single-column rows
                    doc.setTextColor('#000000');
                    let y = innerY;
                    const lhLabel = metrics.lhLabel;
                    const lhValue = metrics.lhValue;
                    // Set line style for outlining details
                    try { doc.setDrawColor(0, 0, 0); } catch(_) {}
                    if (typeof doc.setLineWidth === 'function') { doc.setLineWidth(0.2); }
                    for (let idx = 0; idx < entries.length; idx++) {
                        const e = entries[idx];
                        // Measure wrapped value and row height first
                        // label width in bold
                        try { doc.setFont(effectiveFamily, 'bold'); } catch(_) { try { doc.setFont('helvetica', 'bold'); } catch(__) {} }
                        doc.setFontSize(labelFS);
                        const labelWidth = doc.getTextWidth(String((e.label || '') + ' :'));
                        // wrap value with available width
                        try { doc.setFont(effectiveFamily, 'normal'); } catch(_) { try { doc.setFont('helvetica', 'normal'); } catch(__) {} }
                        doc.setFontSize(valueFS);
                        const available = innerW - cellPadX * 2 - labelWidth - valueGapX;
                        const valueWrapW = Math.max(minWrap, available);
                        const wrapped = doc.splitTextToSize(String(e.value || ''), valueWrapW);
                        const lines = Math.max(1, wrapped.length);
                        const consumed = Math.max(lhLabel, lines * lhValue);

                        // Draw outline rectangle for this detail row (exclude gap area)
                        const rowY = y;
                        const rowH = consumed + rowPadY * 2;
                        if (rowY + rowH <= innerY + innerH) {
                            try { doc.rect(innerX, rowY, innerW, rowH, 'S'); } catch(_) {}
                        }

                        // Label (bold)
                        try { doc.setFont(effectiveFamily, 'bold'); } catch(_) { try { doc.setFont('helvetica', 'bold'); } catch(__) {} }
                        doc.setFontSize(labelFS);
                        const labelBaselineY = y + rowPadY + lhLabel; // baseline with top padding
                        doc.text(String(e.label || '') + ' :', innerX + cellPadX, labelBaselineY); // small left padding inside row box

                        // Value (normal), aligned to label column right edge
                        const valueX = innerX + cellPadX + labelWidth + valueGapX; // small padding from label end
                        try { doc.setFont(effectiveFamily, 'normal'); } catch(_) { try { doc.setFont('helvetica', 'normal'); } catch(__) {} }
                        doc.setFontSize(valueFS);
                        let vy = labelBaselineY;
                        for (let i = 0; i < lines; i++) {
                            if (i === 0) {
                                doc.text(wrapped[i] || '', valueX, vy);
                            } else {
                                vy += lhValue;
                                if (vy > innerY + innerH - rowPadY) break;
                                doc.text(wrapped[i], valueX, vy);
                            }
                        }

                        // Advance y by row height plus gap (no gap after last)
                        y += rowH + (idx !== entries.length - 1 ? entryGap : 0);
                        if (y > innerY + innerH) break;
                    }
                } catch (e) { /* graceful no-op if something off */ }
            };

            const addImageToPage = (doc, title, imageCanvas, detailsSourceMap, pageNumber, totalPages) => {
                const templateImg = state.pdfExport.exportWithoutTemplate ? null : state.pdfExport.templateImage;
                const placement = state.pdfExport.placement;
                const pageWidth = doc.internal.pageSize.getWidth();
                const pageHeight = doc.internal.pageSize.getHeight();
                const rasterDpi = Number(state.pdfExport?.rasterizeDpi) || 0;

                // If rasterizeDpi > 0, draw the entire page to an offscreen canvas and place it as a single image
                if (rasterDpi > 0) {
                    const scale = Math.max(1, Math.round(rasterDpi / 96)); // base jsPDF px ~96 DPI
                    const off = document.createElement('canvas');
                    off.width = Math.max(1, Math.round(pageWidth * scale));
                    off.height = Math.max(1, Math.round(pageHeight * scale));
                    const ctx = off.getContext('2d');
                    if (!ctx) return;
                    ctx.imageSmoothingEnabled = true;
                    ctx.imageSmoothingQuality = 'high';

                    // Helpers to convert page percent areas to pixel coords in offscreen canvas
                    const px = (p) => Math.round(p * scale);
                    const areaToRect = (area) => ({
                        x: px(pageWidth * (area.x / 100)),
                        y: px(pageHeight * (area.y / 100)),
                        w: px(pageWidth * (area.width / 100)),
                        h: px(pageHeight * (area.height / 100)),
                    });

                    // Background (template image) if present
                    if (templateImg) {
                        try { ctx.drawImage(templateImg, 0, 0, templateImg.naturalWidth || templateImg.width, templateImg.naturalHeight || templateImg.height, 0, 0, off.width, off.height); } catch(_) {}
                    } else {
                        // white background
                        ctx.fillStyle = '#ffffff';
                        ctx.fillRect(0, 0, off.width, off.height);
                    }

                    // Title banner
                    const tA = state.pdfExport.titleArea || { x: 20, y: 5, width: 50, height: 8 };
                    const tb = areaToRect(tA);
                    ctx.fillStyle = 'rgb(235,235,235)';
                    ctx.strokeStyle = 'rgb(180,180,180)';
                    ctx.lineWidth = Math.max(1, Math.round(scale * 0.8));
                    ctx.beginPath(); ctx.rect(tb.x, tb.y, tb.w, tb.h); ctx.fill(); ctx.stroke();
                    ctx.fillStyle = '#000000';
                    // Compose banner text
                    const ts = (state.pdfExport && state.pdfExport.textStyle) || {};
                    const baseTitle = (state.pdfExport.pdfTitle || state.projects.find(p => p.id == state.pdfExport.selectedProjectId)?.name || 'NAME OF THE SHOW');
                    let subTitle = '';
                    if (ts.includeMapNameInBanner) {
                        if (detailsSourceMap && detailsSourceMap.__isCanvas) subTitle = detailsSourceMap.name || '';
                        else if (detailsSourceMap) subTitle = (state.pdfExport.mapNames?.[detailsSourceMap.id] || detailsSourceMap.name || '');
                    }
                    const bannerText = (subTitle ? `${baseTitle} - ${subTitle}` : baseTitle).toUpperCase();
                    // Fit text into tb.w
                    const fontBase = Math.min(px(22), Math.max(px(12), tb.h - px(6)));
                    let fontSize = fontBase; ctx.font = `${fontSize}px sans-serif`;
                    let textWidth = ctx.measureText(bannerText).width;
                    if (ts.bannerFitToWidth) {
                        const avail = Math.max(px(12), tb.w - px(12));
                        if (textWidth > avail && fontSize > px(6)) {
                            const scaleF = avail / textWidth;
                            fontSize = Math.max(px(6), Math.floor(fontSize * scaleF));
                            ctx.font = `${fontSize}px sans-serif`;
                            textWidth = ctx.measureText(bannerText).width;
                        }
                    }
                    const align = (ts.bannerAlignH || 'center');
                    const baseline = (ts.bannerAlignV || 'middle');
                    const ax = align === 'left' ? (tb.x + px(6)) : align === 'right' ? (tb.x + tb.w - px(6)) : (tb.x + tb.w / 2);
                    const ay = baseline === 'top' ? (tb.y + px(6)) : baseline === 'bottom' ? (tb.y + tb.h - px(6)) : (tb.y + tb.h / 2);
                    ctx.textAlign = align === 'left' ? 'left' : align === 'right' ? 'right' : 'center';
                    ctx.textBaseline = baseline === 'top' ? 'top' : baseline === 'bottom' ? 'bottom' : 'middle';
                    ctx.fillText(bannerText, ax, ay);

                    // Place map image inside template area with scaling and offsets
                    const area = state.pdfExport.templateArea || { x: 6, y: 6, width: 44, height: 80 };
                    const imgRect = areaToRect(area);
                    const aspect = imageCanvas.width / imageCanvas.height;
                    let imgW = imgRect.w, imgH = Math.round(imgW / aspect);
                    if (imgH > imgRect.h) { imgH = imgRect.h; imgW = Math.round(imgH * aspect); }
                    const scaleImg = (state.pdfExport.mapScale || 100) / 100;
                    imgW = Math.round(imgW * scaleImg); imgH = Math.round(imgH * scaleImg);
                    const baseX = imgRect.x + Math.round((imgRect.w - imgW) / 2);
                    const baseY = imgRect.y + Math.round((imgRect.h - imgH) / 2);
                    const offPct = state.pdfExport.mapOffset || { x: 0, y: 0 };
                    const remX = Math.max(0, imgRect.w - imgW), remY = Math.max(0, imgRect.h - imgH);
                    let imgX = baseX + Math.round(remX * (offPct.x / 100));
                    let imgY = baseY + Math.round(remY * (offPct.y / 100));
                    imgX = Math.max(imgRect.x, Math.min(imgRect.x + imgRect.w - imgW, imgX));
                    imgY = Math.max(imgRect.y, Math.min(imgRect.y + imgRect.h - imgH, imgY));
                    // Draw
                    ctx.drawImage(imageCanvas, 0, 0, imageCanvas.width, imageCanvas.height, imgX, imgY, imgW, imgH);

                    // Details block
                    const dA = state.pdfExport.detailsArea || { x: 4, y: 80, width: 52, height: 16 };
                    const dr = areaToRect(dA);
                    const calcs = calculateLayout(detailsSourceMap);
                    let lines = [];
                    if (detailsSourceMap && detailsSourceMap.__isCanvas) {
                        const canvasName = detailsSourceMap.name || 'Output Canvas';
                        lines = [
                            `Screen Name: ${state.pdfExport.pdfTitle ? `${state.pdfExport.pdfTitle} - ` : ''}${canvasName}`,
                            `Canvas Size (px): ${detailsSourceMap.width} x ${detailsSourceMap.height}`,
                            `Maps on Canvas: ${detailsSourceMap.mapsCount || 0}`
                        ];
                    } else {
                        const isComposite = !!(detailsSourceMap && detailsSourceMap.composite && detailsSourceMap.composite.enabled);
                        let compositePanelsW = calcs.panelsHorizontally || 'N/A';
                        let compositePanelsH = calcs.panelsVertically || 'N/A';
                        if (isComposite) {
                            const comp = detailsSourceMap.composite;
                            const pA = comp.primary || detailsSourceMap;
                            const pB = comp.secondary || null;
                            const cA = calculateLayout(pA) || {};
                            const cB = pB ? (calculateLayout(pB) || {}) : {};
                            const place = comp.placement || 'right';
                            const wA = cA.panelsHorizontally || 0;
                            const hA = cA.panelsVertically || 0;
                            const wB = cB.panelsHorizontally || 0;
                            const hB = cB.panelsVertically || 0;
                            if (place === 'left' || place === 'right') {
                                compositePanelsW = wA + wB;
                                compositePanelsH = Math.max(hA, hB);
                            } else {
                                compositePanelsW = Math.max(wA, wB);
                                compositePanelsH = hA + hB;
                            }
                        }
                        const mapName = detailsSourceMap ? (state.pdfExport.mapNames[detailsSourceMap.id] || detailsSourceMap.name) : '';
                        const screenSizeText = (calcs && calcs.screenWidthMm) ? `${(calcs.screenWidthMm / 1000).toFixed(2)}m x ${(calcs.screenHeightMm / 1000).toFixed(2)}m` : 'N/A';
                        const computedPitch = getCompositePitchMm(detailsSourceMap);
                        lines = [
                            `Screen Name: ${state.pdfExport.pdfTitle ? `${state.pdfExport.pdfTitle} - ` : ''}${mapName}`,
                            `Screen Size (m): ${screenSizeText}`,
                            ...(!isComposite ? [`Pixels per Tile: ${detailsSourceMap.panelResWidth || 'N/A'}px x ${detailsSourceMap.panelResHeight || 'N/A'}px`] : []),
                            ...(state.pdfExport.includePitchInDetails ? [
                                `Pixel Pitch: ${computedPitch!=null ? (computedPitch + ' mm') : 'N/A'}`
                            ] : []),
                            `Total Tiles: ${compositePanelsW || 'N/A'} (W) x ${compositePanelsH || 'N/A'} (H)`,
                            ...(!isComposite ? [`Panel Size (mm): ${detailsSourceMap.panelWidthMm || 'N/A'}mm x ${detailsSourceMap.panelHeightMm || 'N/A'}mm`] : []),
                            `Total Pixel Size: ${calcs.totalResWidth || 'N/A'}px x ${calcs.totalResHeight || 'N/A'}px`,
                            `Aspect Ratio: ${formatAspectRatio(calcs.totalResWidth, calcs.totalResHeight)}`
                        ];
                    }
                    const pad = px(6);
                    let fontSizeD = Math.max(px(6), Math.min(px(16), Math.round(((state.pdfExport?.textStyle?.detailsFS) ?? 14) * scale)));
                    const lh = Math.round(fontSizeD * 1.2);
                    const neededH = pad * 2 + (lines.length * lh);
                    const useAutoFit = !!(state.pdfExport?.textStyle?.detailsFitToText);
                    const boxH = Math.min(dr.h, useAutoFit ? neededH : dr.h);
                    ctx.fillStyle = 'rgb(230,230,230)'; ctx.strokeStyle = '#000'; ctx.lineWidth = Math.max(1, Math.round(scale * 0.8));
                    ctx.beginPath(); ctx.rect(dr.x, dr.y, dr.w, boxH); ctx.fill(); ctx.stroke();
                    ctx.fillStyle = '#000'; ctx.font = `${fontSizeD}px sans-serif`; ctx.textAlign = 'left'; ctx.textBaseline = 'alphabetic';
                    for (let i = 0; i < lines.length; i++) {
                        const ty = dr.y + pad + (i + 1) * lh;
                        if (ty > dr.y + boxH - pad) break;
                        ctx.fillText(lines[i], dr.x + pad, ty);
                    }

                    // Optional per-map reference image (e.g., room photo) inside refImageArea
                    try {
                        const refImg = detailsSourceMap && detailsSourceMap.__pdfRefImage;
                        if (refImg && refImg.naturalWidth && refImg.naturalHeight && state.pdfExport && state.pdfExport.refImageArea) {
                            const rA = state.pdfExport.refImageArea;
                            const rr = areaToRect(rA);
                            const rAspect = refImg.naturalWidth / refImg.naturalHeight;
                            let rw = rr.w;
                            let rh = Math.round(rw / rAspect);
                            if (rh > rr.h) { rh = rr.h; rw = Math.round(rh * rAspect); }
                            const rx = rr.x + Math.round((rr.w - rw) / 2);
                            const ry = rr.y + Math.round((rr.h - rh) / 2);
                            ctx.drawImage(refImg, 0, 0, refImg.naturalWidth, refImg.naturalHeight, rx, ry, rw, rh);
                        }
                    } catch(_) {}

                    // Title Block rows (simple text-only rendering using existing drawTitleBlock data via jsPDF would be redundant here; keep compact)
                    // Finally add the offscreen image to PDF page
                    // Export as compressed JPEG to drastically reduce PDF size
                    const q = Math.min(0.9, Math.max(0.3, Number(state.pdfExport?.rasterizeJpegQuality) || 0.6));
                    const url = off.toDataURL('image/jpeg', q);
                    doc.addImage(url, 'JPEG', 0, 0, pageWidth, pageHeight);
                    return;
                }

                
                if (templateImg) {
                    doc.addImage(templateImg, 'JPEG', 0, 0, pageWidth, pageHeight);
                }
                // Draw page title banner inside titleArea
                const tA = state.pdfExport.titleArea || { x: 20, y: 5, width: 50, height: 8 };
                const tX = pageWidth * (tA.x / 100);
                const tY = pageHeight * (tA.y / 100);
                const tW = pageWidth * (tA.width / 100);
                const tH = pageHeight * (tA.height / 100);
                doc.setFillColor(235, 235, 235);
                doc.setDrawColor(180, 180, 180);
                doc.rect(tX, tY, tW, tH, 'FD');
                doc.setTextColor('#000000');
                try { doc.setFont(effectiveFamily, 'bold'); } catch(_) { try { doc.setFont('helvetica', 'bold'); } catch(__) {} }
                let fsB = (Number.isFinite(+ts.bannerFS) && +ts.bannerFS > 0) ? +ts.bannerFS : Math.min(22, Math.max(12, tH - 6));
                doc.setFontSize(fsB);
                // Compose banner text with optional pixel map/output name
                const baseTitle = (state.pdfExport.pdfTitle || state.projects.find(p => p.id == state.pdfExport.selectedProjectId)?.name || 'NAME OF THE SHOW');
                let subTitle = '';
                if (ts.includeMapNameInBanner) {
                    if (detailsSourceMap && detailsSourceMap.__isCanvas) {
                        subTitle = detailsSourceMap.name || '';
                    } else if (detailsSourceMap) {
                        const mapped = state.pdfExport.mapNames?.[detailsSourceMap.id];
                        subTitle = (mapped || detailsSourceMap.name || '');
                    }
                }
                const bannerText = (subTitle ? `${baseTitle} - ${subTitle}` : baseTitle).toUpperCase();
                // Optionally fit text to title width by shrinking font size
                if (ts.bannerFitToWidth) {
                    const avail = Math.max(12, tW - 12); // 6px padding on each side
                    const w = doc.getTextWidth(bannerText);
                    if (w > avail && fsB > 6) {
                        const scale = avail / w;
                        fsB = Math.max(6, Math.floor(fsB * scale));
                        doc.setFontSize(fsB);
                    }
                }
                const alignMap = { left: 'left', center: 'center', right: 'right' };
                const baselineMap = { top: 'top', middle: 'middle', bottom: 'bottom' };
                const align = alignMap[(ts.bannerAlignH || 'center')] || 'center';
                const baseline = baselineMap[(ts.bannerAlignV || 'middle')] || 'middle';
                // Compute anchor X and Y per alignment
                const ax = align === 'left' ? (tX + 6) : align === 'right' ? (tX + tW - 6) : (tX + tW / 2);
                const ay = baseline === 'top' ? (tY + 6) : baseline === 'bottom' ? (tY + tH - 6) : (tY + tH / 2);
                doc.text(bannerText, ax, ay, { align, baseline });
                
                doc.setFontSize(18);
                doc.setTextColor("#000000");

                const aspect = imageCanvas.width / imageCanvas.height;
                let imgWidth, imgHeight, x, y;
                if (state.pdfExport.autoFitPlacement) {
                    // Fit the image into the defined templateArea while preserving aspect ratio
                    const area = state.pdfExport.templateArea || { x: 6, y: 6, width: 44, height: 80 };
                    let areaX = pageWidth * (area.x / 100);
                    let areaY = pageHeight * (area.y / 100);
                    const areaW = pageWidth * (area.width / 100);
                    let areaH = pageHeight * (area.height / 100);
                    // If title area overlaps this area at the top, push image area down
                    const t = state.pdfExport.titleArea;
                    if (t) {
                        const tX = pageWidth * (t.x / 100);
                        const tY = pageHeight * (t.y / 100);
                        const tW = pageWidth * (t.width / 100);
                        const tH = pageHeight * (t.height / 100);
                        const interLeft = Math.max(areaX, tX), interTop = Math.max(areaY, tY);
                        const interRight = Math.min(areaX + areaW, tX + tW), interBottom = Math.min(areaY + areaH, tY + tH);
                        if (interRight > interLeft && interBottom > interTop) {
                            const delta = (tY + tH) - areaY + 12; // 12px gap under title banner
                            areaY = areaY + Math.max(0, delta);
                            areaH = Math.max(1, (pageHeight * (area.y / 100) + pageHeight * (area.height / 100)) - areaY);
                        }
                    }
                    // Base aspect-fit inside area
                    imgWidth = areaW;
                    imgHeight = imgWidth / aspect;
                    if (imgHeight > areaH) {
                        imgHeight = areaH;
                        imgWidth = imgHeight * aspect;
                    }
                    // Apply user scale (10% - 200%)
                    const scale = (state.pdfExport.mapScale || 100) / 100;
                    imgWidth *= scale;
                    imgHeight *= scale;
                    // Centered base position
                    let baseX = areaX + (areaW - imgWidth) / 2;
                    let baseY = areaY + (areaH - imgHeight) / 2;
                    // Apply offset: interpret [-50,50]% as movement across remaining space
                    const off = state.pdfExport.mapOffset || { x: 0, y: 0 };
                    const remX = Math.max(0, areaW - imgWidth);
                    const remY = Math.max(0, areaH - imgHeight);
                    x = baseX + (remX * (off.x / 100));
                    y = baseY + (remY * (off.y / 100));
                    // Clamp within template area
                    x = Math.max(areaX, Math.min(areaX + areaW - imgWidth, x));
                    y = Math.max(areaY, Math.min(areaY + areaH - imgHeight, y));
                    // Avoid overlapping the details block area, if defined
                    const d = state.pdfExport.detailsArea;
                    if (d) {
                        const dX = pageWidth * (d.x / 100);
                        const dY = pageHeight * (d.y / 100);
                        const dW = pageWidth * (d.width / 100);
                        const dH = pageHeight * (d.height / 100);
                        const limitBottom = dY - 8; // 8px gap above details
                        const maxY = Math.min(areaY + areaH - imgHeight, limitBottom - imgHeight);
                        const minY = areaY;
                        if (y > maxY) y = Math.max(minY, maxY);
                    }
                } else {
                    const placementAreaX = pageWidth * (placement.x / 100);
                    const placementAreaY = pageHeight * (placement.y / 100);
                    const placementAreaWidth = pageWidth * (placement.width / 100);
                    const placementAreaHeight = pageHeight * (placement.height / 100);
                    imgWidth = placementAreaWidth;
                    imgHeight = imgWidth / aspect;
                    if (imgHeight > placementAreaHeight) {
                        imgHeight = placementAreaHeight;
                        imgWidth = imgHeight * aspect;
                    }
                    x = placementAreaX + (placementAreaWidth - imgWidth) / 2;
                    y = placementAreaY + (placementAreaHeight - imgHeight) / 2;
                    // Avoid overlapping the details block area (manual mode)
                    const d = state.pdfExport.detailsArea;
                    if (d) {
                        const dY = pageHeight * (d.y / 100);
                        const maxY = dY - 8 - imgHeight;
                        if (y > maxY) y = Math.max(0, maxY);
                    }
                }
                const dataUrl = encodeAdvancedPdfImage(imageCanvas, imgWidth, imgHeight);
                doc.addImage(dataUrl, 'JPEG', x, y, imgWidth, imgHeight, undefined, 'MEDIUM');

                // Optional per-map reference image (non-raster path)
                try {
                    const refImg = detailsSourceMap && detailsSourceMap.__pdfRefImage;
                    if (refImg && refImg.naturalWidth && refImg.naturalHeight && state.pdfExport && state.pdfExport.refImageArea) {
                        const rA = state.pdfExport.refImageArea;
                        const rX = pageWidth * (rA.x / 100);
                        const rY = pageHeight * (rA.y / 100);
                        const rW = pageWidth * (rA.width / 100);
                        const rH = pageHeight * (rA.height / 100);
                        const aspectR = refImg.naturalWidth / refImg.naturalHeight;
                        let rw = rW;
                        let rh = rw / aspectR;
                        if (rh > rH) { rh = rH; rw = rh * aspectR; }
                        const rx = rX + (rW - rw) / 2;
                        const ry = rY + (rH - rh) / 2;
                        // Use the image element directly; jsPDF will handle encoding
                        doc.addImage(refImg, 'PNG', rx, ry, rw, rh);
                    }
                } catch(_) {}

                // Add Details Block inside detailsArea with grey background and black outline
                const calcs = calculateLayout(detailsSourceMap);
                let lines = [];
                if (detailsSourceMap && detailsSourceMap.__isCanvas) {
                    const canvasName = detailsSourceMap.name || 'Output Canvas';
                    lines = [
                        `Screen Name: ${state.pdfExport.pdfTitle ? `${state.pdfExport.pdfTitle} - ` : ''}${canvasName}`,
                        `Canvas Size (px): ${detailsSourceMap.width} x ${detailsSourceMap.height}`,
                        `Maps on Canvas: ${detailsSourceMap.mapsCount || 0}`
                    ];
                } else {
                    const isComposite = !!(detailsSourceMap && detailsSourceMap.composite && detailsSourceMap.composite.enabled);
                    let compositePanelsW = calcs.panelsHorizontally || 'N/A';
                    let compositePanelsH = calcs.panelsVertically || 'N/A';
                    if (isComposite) {
                        const comp = detailsSourceMap.composite;
                        const pA = comp.primary || detailsSourceMap;
                        const pB = comp.secondary || null;
                        const cA = calculateLayout(pA) || {};
                        const cB = pB ? (calculateLayout(pB) || {}) : {};
                        const place = comp.placement || 'right';
                        const wA = cA.panelsHorizontally || 0;
                        const hA = cA.panelsVertically || 0;
                        const wB = cB.panelsHorizontally || 0;
                        const hB = cB.panelsVertically || 0;
                        if (place === 'left' || place === 'right') {
                            compositePanelsW = wA + wB;
                            compositePanelsH = Math.max(hA, hB);
                        } else {
                            compositePanelsW = Math.max(wA, wB);
                            compositePanelsH = hA + hB;
                        }
                    }
                    const mapName = detailsSourceMap ? (state.pdfExport.mapNames[detailsSourceMap.id] || detailsSourceMap.name) : '';
                    const screenSizeText = (calcs && calcs.screenWidthMm) ? `${(calcs.screenWidthMm / 1000).toFixed(2)}m x ${(calcs.screenHeightMm / 1000).toFixed(2)}m` : 'N/A';
                    const computedPitch = getCompositePitchMm(detailsSourceMap);
                    lines = [
                        `Screen Name: ${state.pdfExport.pdfTitle ? `${state.pdfExport.pdfTitle} - ` : ''}${mapName}`,
                        `Screen Size (m): ${screenSizeText}`,
                        ...(!isComposite ? [`Pixels per Tile: ${detailsSourceMap.panelResWidth || 'N/A'}px x ${detailsSourceMap.panelResHeight || 'N/A'}px`] : []),
                        ...(state.pdfExport.includePitchInDetails ? [
                            `Pixel Pitch: ${computedPitch!=null ? (computedPitch + ' mm') : 'N/A'}`
                        ] : []),
                        `Total Tiles: ${compositePanelsW || 'N/A'} (W) x ${compositePanelsH || 'N/A'} (H)`,
                        ...(!isComposite ? [`Panel Size (mm): ${detailsSourceMap.panelWidthMm || 'N/A'}mm x ${detailsSourceMap.panelHeightMm || 'N/A'}mm`] : []),
                        `Total Pixel Size: ${calcs.totalResWidth || 'N/A'}px x ${calcs.totalResHeight || 'N/A'}px`,
                        `Aspect Ratio: ${formatAspectRatio(calcs.totalResWidth, calcs.totalResHeight)}`
                    ];
                }
                let fontSize = Math.max(6, Math.min(16, Number.isFinite(+ts.detailsFS) ? +ts.detailsFS : 14));
                let lineHeight = 12;
                const pad = 6;
                const d = state.pdfExport.detailsArea || { x: 4, y: 80, width: 52, height: 16 };
                const dX = pageWidth * (d.x / 100);
                const dY = pageHeight * (d.y / 100);
                const dW = pageWidth * (d.width / 100);
                const dH = pageHeight * (d.height / 100);
                // Fit text within details box by reducing font if needed
                const fits = (fs) => {
                    doc.setFontSize(fs);
                    const lh = Math.round(fs * 1.2);
                    const maxLines = Math.floor((dH - pad * 2) / lh);
                    return maxLines >= lines.length;
                };
                while (!fits(fontSize) && fontSize > 8) { fontSize -= 1; }
                lineHeight = Math.round(fontSize * 1.2);
                doc.setFontSize(fontSize);
                doc.setTextColor('#000000');
                // Grey fill with black outline
                doc.setFillColor(230, 230, 230);
                doc.setDrawColor(0, 0, 0);
                // Optionally auto-fit the box height to content
                const neededH = pad * 2 + (lines.length * lineHeight);
                const useAutoFit = !!(ts && ts.detailsFitToText);
                const boxH = Math.min(dH, useAutoFit ? neededH : dH);
                doc.rect(dX, dY, dW, boxH, 'FD');
                // Draw text in details block
                let ty = dY + pad + lineHeight;
                const tx = dX + pad;
                lines.forEach((line, index) => {
                    if (ty > dY + boxH - pad) return; // stop if overflow
                    doc.text(line, tx, dY + pad + (index + 1) * lineHeight);
                });

                // Draw Title Block values on right panel for this page
                drawTitleBlock(doc, pageNumber, totalPages);
            };

            // Helper: two similar-sized maps side-by-side on one PDF page
            const addTwoImagesToPage = (doc, imageCanvas1, detailsMap1, imageCanvas2, detailsMap2, pageNumber, totalPages) => {
                const templateImg = state.pdfExport.exportWithoutTemplate ? null : state.pdfExport.templateImage;
                const pageWidth = doc.internal.pageSize.getWidth();
                const pageHeight = doc.internal.pageSize.getHeight();
                const rasterDpi = Number(state.pdfExport?.rasterizeDpi) || 0;

                const areaFull = state.pdfExport.templateArea || { x: 3.8, y: 16, width: 81, height: 58 };
                const dAFull   = state.pdfExport.detailsArea   || { x: 2,   y: 81, width: 38, height: 16 };
                const tA       = state.pdfExport.titleArea     || { x: 21,  y: 3.3, width: 50, height: 8  };

                // Split template area horizontally into two equal halves with a small gap
                const GAP    = 1; // percent
                const halfW  = (areaFull.width - GAP) / 2;
                const area1  = { x: areaFull.x,               y: areaFull.y, width: halfW, height: areaFull.height };
                const area2  = { x: areaFull.x + halfW + GAP, y: areaFull.y, width: halfW, height: areaFull.height };
                const dA1    = { x: areaFull.x,               y: dAFull.y,  width: halfW, height: dAFull.height };
                const dA2    = { x: areaFull.x + halfW + GAP, y: dAFull.y,  width: halfW, height: dAFull.height };

                // Build details text lines for a map
                const buildLines = (dsMap) => {
                    if (!dsMap) return [];
                    const calcs = calculateLayout(dsMap);
                    if (dsMap.__isCanvas) {
                        return [
                            `Screen Name: ${state.pdfExport.pdfTitle ? `${state.pdfExport.pdfTitle} - ` : ''}${dsMap.name || 'Output Canvas'}`,
                            `Canvas Size (px): ${dsMap.width} x ${dsMap.height}`,
                            `Maps on Canvas: ${dsMap.mapsCount || 0}`
                        ];
                    }
                    const isComposite = !!(dsMap.composite && dsMap.composite.enabled);
                    let compW = calcs.panelsHorizontally || 'N/A';
                    let compH = calcs.panelsVertically   || 'N/A';
                    if (isComposite) {
                        const comp = dsMap.composite;
                        const pA = comp.primary || dsMap;
                        const pB = comp.secondary || null;
                        const cA = calculateLayout(pA) || {};
                        const cB = pB ? (calculateLayout(pB) || {}) : {};
                        const place = comp.placement || 'right';
                        if (place === 'left' || place === 'right') {
                            compW = (cA.panelsHorizontally || 0) + (cB.panelsHorizontally || 0);
                            compH = Math.max(cA.panelsVertically || 0, cB.panelsVertically || 0);
                        } else {
                            compW = Math.max(cA.panelsHorizontally || 0, cB.panelsHorizontally || 0);
                            compH = (cA.panelsVertically || 0) + (cB.panelsVertically || 0);
                        }
                    }
                    const mapName = state.pdfExport.mapNames[dsMap.id] || dsMap.name;
                    const screenSizeText = (calcs && calcs.screenWidthMm) ? `${(calcs.screenWidthMm / 1000).toFixed(2)}m x ${(calcs.screenHeightMm / 1000).toFixed(2)}m` : 'N/A';
                    const computedPitch  = getCompositePitchMm(dsMap);
                    return [
                        `Screen Name: ${state.pdfExport.pdfTitle ? `${state.pdfExport.pdfTitle} - ` : ''}${mapName}`,
                        `Screen Size (m): ${screenSizeText}`,
                        ...(!isComposite ? [`Pixels per Tile: ${dsMap.panelResWidth || 'N/A'}px x ${dsMap.panelResHeight || 'N/A'}px`] : []),
                        ...(state.pdfExport.includePitchInDetails ? [`Pixel Pitch: ${computedPitch != null ? (computedPitch + ' mm') : 'N/A'}`] : []),
                        `Total Tiles: ${compW || 'N/A'} (W) x ${compH || 'N/A'} (H)`,
                        ...(!isComposite ? [`Panel Size (mm): ${dsMap.panelWidthMm || 'N/A'}mm x ${dsMap.panelHeightMm || 'N/A'}mm`] : []),
                        `Total Pixel Size: ${calcs.totalResWidth || 'N/A'}px x ${calcs.totalResHeight || 'N/A'}px`,
                        `Aspect Ratio: ${formatAspectRatio(calcs.totalResWidth, calcs.totalResHeight)}`
                    ];
                };

                const getName = (dsMap) => {
                    if (!dsMap) return '';
                    if (dsMap.__isCanvas) return dsMap.name || '';
                    return state.pdfExport.mapNames?.[dsMap.id] || dsMap.name || '';
                };

                if (rasterDpi > 0) {
                    const scale = Math.max(1, Math.round(rasterDpi / 96));
                    const off = document.createElement('canvas');
                    off.width  = Math.max(1, Math.round(pageWidth  * scale));
                    off.height = Math.max(1, Math.round(pageHeight * scale));
                    const ctx = off.getContext('2d');
                    if (!ctx) return;
                    ctx.imageSmoothingEnabled = true;
                    ctx.imageSmoothingQuality = 'high';
                    const px = (p) => Math.round(p * scale);
                    const areaToRect = (a) => ({
                        x: px(pageWidth  * (a.x / 100)), y: px(pageHeight * (a.y / 100)),
                        w: px(pageWidth  * (a.width / 100)), h: px(pageHeight * (a.height / 100))
                    });
                    if (templateImg) {
                        try { ctx.drawImage(templateImg, 0, 0, templateImg.naturalWidth || templateImg.width, templateImg.naturalHeight || templateImg.height, 0, 0, off.width, off.height); } catch(_) {}
                    } else {
                        ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 0, off.width, off.height);
                    }
                    // Title banner
                    const tb = areaToRect(tA);
                    ctx.fillStyle = 'rgb(235,235,235)'; ctx.strokeStyle = 'rgb(180,180,180)';
                    ctx.lineWidth = Math.max(1, Math.round(scale * 0.8));
                    ctx.beginPath(); ctx.rect(tb.x, tb.y, tb.w, tb.h); ctx.fill(); ctx.stroke();
                    const ts_ = (state.pdfExport && state.pdfExport.textStyle) || {};
                    const baseTitle_ = (state.pdfExport.pdfTitle || state.projects.find(p => p.id == state.pdfExport.selectedProjectId)?.name || 'NAME OF THE SHOW');
                    const n1_ = getName(detailsMap1), n2_ = getName(detailsMap2);
                    const subTitle_ = ts_.includeMapNameInBanner ? (n1_ && n2_ ? `${n1_} / ${n2_}` : (n1_ || n2_)) : '';
                    const bannerText_ = (subTitle_ ? `${baseTitle_} - ${subTitle_}` : baseTitle_).toUpperCase();
                    let bfs_ = Math.min(px(22), Math.max(px(12), tb.h - px(6)));
                    ctx.font = `${bfs_}px sans-serif`;
                    if (ts_.bannerFitToWidth) {
                        const avail_ = Math.max(px(12), tb.w - px(12));
                        const tw_ = ctx.measureText(bannerText_).width;
                        if (tw_ > avail_ && bfs_ > px(6)) { bfs_ = Math.max(px(6), Math.floor(bfs_ * (avail_ / tw_))); ctx.font = `${bfs_}px sans-serif`; }
                    }
                    const al_ = ts_.bannerAlignH || 'center';
                    const bl_ = ts_.bannerAlignV || 'middle';
                    ctx.textAlign    = al_ === 'left' ? 'left' : al_ === 'right' ? 'right' : 'center';
                    ctx.textBaseline = bl_ === 'top'  ? 'top'  : bl_ === 'bottom' ? 'bottom' : 'middle';
                    ctx.fillStyle = '#000000';
                    const bax_ = al_ === 'left' ? tb.x + px(6) : al_ === 'right' ? tb.x + tb.w - px(6) : tb.x + tb.w / 2;
                    const bay_ = bl_ === 'top'  ? tb.y + px(6) : bl_ === 'bottom' ? tb.y + tb.h - px(6) : tb.y + tb.h / 2;
                    ctx.fillText(bannerText_, bax_, bay_);
                    // Draw each map image in its half
                    const drawMapR = (imgC, tgtArea) => {
                        if (!imgC || imgC.width <= 0) return;
                        const r = areaToRect(tgtArea);
                        const aspect = imgC.width / imgC.height;
                        let iw = r.w, ih = Math.round(iw / aspect);
                        if (ih > r.h) { ih = r.h; iw = Math.round(ih * aspect); }
                        const sc = (state.pdfExport.mapScale || 100) / 100;
                        iw = Math.round(iw * sc); ih = Math.round(ih * sc);
                        const ix_ = r.x + Math.round((r.w - iw) / 2);
                        const iy_ = r.y + Math.round((r.h - ih) / 2);
                        ctx.drawImage(imgC, 0, 0, imgC.width, imgC.height, ix_, iy_, iw, ih);
                    };
                    drawMapR(imageCanvas1, area1);
                    drawMapR(imageCanvas2, area2);
                    // Separator
                    const sepX_ = px(pageWidth * ((areaFull.x + halfW + GAP / 2) / 100));
                    ctx.strokeStyle = 'rgba(150,150,150,0.5)'; ctx.lineWidth = Math.max(1, Math.round(scale * 0.5));
                    ctx.beginPath();
                    ctx.moveTo(sepX_, px(pageHeight * (areaFull.y / 100)));
                    ctx.lineTo(sepX_, px(pageHeight * ((areaFull.y + areaFull.height) / 100)));
                    ctx.stroke();
                    // Details
                    const drawDetR = (lines, tgtDA) => {
                        const dr = areaToRect(tgtDA);
                        let fsd = Math.max(px(6), Math.min(px(16), Math.round(((state.pdfExport?.textStyle?.detailsFS) ?? 14) * scale)));
                        const lh = Math.round(fsd * 1.2);
                        const pad_ = px(6);
                        const neededH_ = pad_ * 2 + lines.length * lh;
                        const useAF = !!(state.pdfExport?.textStyle?.detailsFitToText);
                        const boxH_ = Math.min(dr.h, useAF ? neededH_ : dr.h);
                        ctx.fillStyle = 'rgb(230,230,230)'; ctx.strokeStyle = '#000';
                        ctx.lineWidth = Math.max(1, Math.round(scale * 0.8));
                        ctx.beginPath(); ctx.rect(dr.x, dr.y, dr.w, boxH_); ctx.fill(); ctx.stroke();
                        ctx.fillStyle = '#000'; ctx.font = `${fsd}px sans-serif`;
                        ctx.textAlign = 'left'; ctx.textBaseline = 'alphabetic';
                        for (let li = 0; li < lines.length; li++) {
                            const ty_ = dr.y + pad_ + (li + 1) * lh;
                            if (ty_ > dr.y + boxH_ - pad_) break;
                            ctx.fillText(lines[li], dr.x + pad_, ty_);
                        }
                    };
                    drawDetR(buildLines(detailsMap1), dA1);
                    drawDetR(buildLines(detailsMap2), dA2);
                    const q = Math.min(0.9, Math.max(0.3, Number(state.pdfExport?.rasterizeJpegQuality) || 0.6));
                    doc.addImage(off.toDataURL('image/jpeg', q), 'JPEG', 0, 0, pageWidth, pageHeight);
                    return;
                }

                // ── Non-rasterize path (default) ──
                if (templateImg) { doc.addImage(templateImg, 'JPEG', 0, 0, pageWidth, pageHeight); }

                // Title banner (full width, both map names)
                const tX = pageWidth  * (tA.x / 100);
                const tY = pageHeight * (tA.y / 100);
                const tW = pageWidth  * (tA.width  / 100);
                const tH = pageHeight * (tA.height / 100);
                doc.setFillColor(235, 235, 235); doc.setDrawColor(180, 180, 180);
                doc.rect(tX, tY, tW, tH, 'FD');
                doc.setTextColor('#000000');
                try { doc.setFont(effectiveFamily, 'bold'); } catch(_) { try { doc.setFont('helvetica', 'bold'); } catch(__) {} }
                let fsB2 = (Number.isFinite(+ts.bannerFS) && +ts.bannerFS > 0) ? +ts.bannerFS : Math.min(22, Math.max(12, tH - 6));
                doc.setFontSize(fsB2);
                const baseTitle2 = (state.pdfExport.pdfTitle || state.projects.find(p => p.id == state.pdfExport.selectedProjectId)?.name || 'NAME OF THE SHOW');
                const n1 = getName(detailsMap1), n2 = getName(detailsMap2);
                const subTitle2 = ts.includeMapNameInBanner ? (n1 && n2 ? `${n1} / ${n2}` : (n1 || n2)) : '';
                const bannerText2 = (subTitle2 ? `${baseTitle2} - ${subTitle2}` : baseTitle2).toUpperCase();
                if (ts.bannerFitToWidth) {
                    const avail2 = Math.max(12, tW - 12);
                    const bw2 = doc.getTextWidth(bannerText2);
                    if (bw2 > avail2 && fsB2 > 6) { fsB2 = Math.max(6, Math.floor(fsB2 * (avail2 / bw2))); doc.setFontSize(fsB2); }
                }
                const alignMap2_  = { left: 'left', center: 'center', right: 'right' };
                const baselineMap2_ = { top: 'top', middle: 'middle', bottom: 'bottom' };
                const align2_    = alignMap2_[(ts.bannerAlignH || 'center')] || 'center';
                const baseline2_ = baselineMap2_[(ts.bannerAlignV || 'middle')] || 'middle';
                const ax2_ = align2_ === 'left' ? (tX + 6) : align2_ === 'right' ? (tX + tW - 6) : (tX + tW / 2);
                const ay2_ = baseline2_ === 'top' ? (tY + 6) : baseline2_ === 'bottom' ? (tY + tH - 6) : (tY + tH / 2);
                doc.text(bannerText2, ax2_, ay2_, { align: align2_, baseline: baseline2_ });

                // Draw each map in its half of the template area
                const drawMapHalf = (imgCanvas, targetArea) => {
                    if (!imgCanvas || imgCanvas.width <= 0) return;
                    const aspect  = imgCanvas.width / imgCanvas.height;
                    const aX = pageWidth  * (targetArea.x      / 100);
                    const aY = pageHeight * (targetArea.y      / 100);
                    const aW = pageWidth  * (targetArea.width  / 100);
                    const aH = pageHeight * (targetArea.height / 100);
                    let imgW = aW, imgH = aW / aspect;
                    if (imgH > aH) { imgH = aH; imgW = imgH * aspect; }
                    const sc = (state.pdfExport.mapScale || 100) / 100;
                    imgW *= sc; imgH *= sc;
                    const ix = aX + (aW - imgW) / 2;
                    const iy = aY + (aH - imgH) / 2;
                    const dataUrl = encodeAdvancedPdfImage(imgCanvas, imgW, imgH);
                    doc.addImage(dataUrl, 'JPEG', ix, iy, imgW, imgH, undefined, 'MEDIUM');
                };
                drawMapHalf(imageCanvas1, area1);
                drawMapHalf(imageCanvas2, area2);

                // Subtle separator line between the two maps
                const sepX2 = pageWidth  * ((areaFull.x + halfW + GAP / 2) / 100);
                const sepY1 = pageHeight * (areaFull.y / 100);
                const sepY2 = pageHeight * ((areaFull.y + areaFull.height) / 100);
                doc.setDrawColor(180, 180, 180);
                if (typeof doc.setLineWidth === 'function') doc.setLineWidth(0.5);
                doc.line(sepX2, sepY1, sepX2, sepY2);

                // Draw details block for each map in its half of the details area
                const drawDetHalf = (lines, targetDA) => {
                    const dX2 = pageWidth  * (targetDA.x      / 100);
                    const dY2 = pageHeight * (targetDA.y      / 100);
                    const dW2 = pageWidth  * (targetDA.width  / 100);
                    const dH2 = pageHeight * (targetDA.height / 100);
                    let fsd2 = Math.max(6, Math.min(16, Number.isFinite(+ts.detailsFS) ? +ts.detailsFS : 14));
                    const pad2 = 6;
                    const fitsD = (fs) => {
                        doc.setFontSize(fs);
                        return Math.floor((dH2 - pad2 * 2) / Math.round(fs * 1.2)) >= lines.length;
                    };
                    while (!fitsD(fsd2) && fsd2 > 8) { fsd2 -= 1; }
                    const lh2 = Math.round(fsd2 * 1.2);
                    doc.setFontSize(fsd2); doc.setTextColor('#000000');
                    doc.setFillColor(230, 230, 230); doc.setDrawColor(0, 0, 0);
                    const neededH2 = pad2 * 2 + lines.length * lh2;
                    const useAF2   = !!(ts && ts.detailsFitToText);
                    const boxH2    = Math.min(dH2, useAF2 ? neededH2 : dH2);
                    doc.rect(dX2, dY2, dW2, boxH2, 'FD');
                    lines.forEach((line, idx) => {
                        const ty2 = dY2 + pad2 + (idx + 1) * lh2;
                        if (ty2 > dY2 + boxH2 - pad2) return;
                        doc.text(line, dX2 + pad2, ty2);
                    });
                };
                drawDetHalf(buildLines(detailsMap1), dA1);
                drawDetHalf(buildLines(detailsMap2), dA2);

                drawTitleBlock(doc, pageNumber, totalPages);
            };

            // Helper: get total-pixel-resolution key for a map (used for pairing similar maps)
            const getMapSizeKey = (map) => {
                try {
                    const c = calculateLayout(map);
                    const w = c && c.totalResWidth;
                    const h = c && c.totalResHeight;
                    if (!w || !h || w === 'N/A' || h === 'N/A' || isNaN(+w) || isNaN(+h)) return null;
                    return `${w}x${h}`;
                } catch (_) { return null; }
            };

            // Group maps: same total pixel resolution → pair on one page, others get their own page
            const buildMapGroups = (maps) => {
                const groups = [];
                const used   = new Set();

                // 1. Apply manual pairs first (from state.pdfExport.mapPairs)
                const manualPairs = Array.isArray(state.pdfExport.mapPairs) ? state.pdfExport.mapPairs : [];
                for (const pair of manualPairs) {
                    if (!pair.id1 || !pair.id2 || String(pair.id1) === String(pair.id2)) continue;
                    const i = maps.findIndex(m => String(m.id) === String(pair.id1));
                    const j = maps.findIndex(m => String(m.id) === String(pair.id2));
                    if (i < 0 || j < 0 || used.has(i) || used.has(j)) continue;
                    groups.push([maps[i], maps[j]]);
                    used.add(i); used.add(j);
                }

                // 2. Auto-pair remaining maps by matching total pixel resolution
                for (let i = 0; i < maps.length; i++) {
                    if (used.has(i)) continue;
                    const keyI = getMapSizeKey(maps[i]);
                    let pairIdx = -1;
                    if (keyI) {
                        for (let j = i + 1; j < maps.length; j++) {
                            if (used.has(j)) continue;
                            if (getMapSizeKey(maps[j]) === keyI) { pairIdx = j; break; }
                        }
                    }
                    if (pairIdx >= 0) {
                        groups.push([maps[i], maps[pairIdx]]);
                        used.add(i); used.add(pairIdx);
                    } else {
                        groups.push([maps[i]]);
                        used.add(i);
                    }
                }
                return groups;
            };

            
            const collectPdfCanvases = () => {
                const mode = state.pdfExport.includeCanvas;
                if (!mode || mode === 'none') return [];
                const outputMaps = projectForPdf.canvases || [];
                if (mode === 'active') {
                    const outputMap = ensureOutputMapRegions(outputMaps.find(item => item.id === projectForPdf.activeCanvasId) || outputMaps[0]);
                    const active = outputMap?.regions.find(region => region.id === outputMap.activeRegionId) || outputMap?.regions[0];
                    return active && active.width > 0 ? [active] : [];
                }
                if (mode === 'current-map') {
                    const outputMap = ensureOutputMapRegions(outputMaps.find(item => item.id === projectForPdf.activeCanvasId) || outputMaps[0]);
                    return (outputMap?.regions || []).filter(canvas => canvas && canvas.width > 0);
                }
                const selectedIds = (state.pdfExport.selectedCanvasIds || []).map(String);
                const selectedOutputMaps = mode === 'specific'
                    ? outputMaps.filter(outputMap => selectedIds.includes(String(outputMap.id)))
                    : outputMaps;
                return selectedOutputMaps.flatMap(outputMap => ensureOutputMapRegions(outputMap)?.regions || []).filter(canvas => canvas && canvas.width > 0);
            };
            const pdfCanvases = collectPdfCanvases();
            const countPlannedCanvasPages = () => Math.ceil(pdfCanvases.length / 2);
            const mapGroups = buildMapGroups(projectForPdf.pixelMaps || []);
            const totalPages = (state.pdfExport.includeTitlePage ? 1 : 0) + mapGroups.length + countPlannedCanvasPages() + 1; // +1 Delivery page
            let pageIndex = 0;

            // Optional Title Page (cover)
            if (state.pdfExport.includeTitlePage) {
                const pageWidth = doc.internal.pageSize.getWidth();
                const pageHeight = doc.internal.pageSize.getHeight();
                const templateImg = state.pdfExport.exportWithoutTemplate ? null : state.pdfExport.templateImage;
                if (templateImg) { try { doc.addImage(templateImg, 'JPEG', 0, 0, pageWidth, pageHeight); } catch (e) { /* ignore */ } }

                // Use configured areas
                const area = state.pdfExport.templateArea || { x: 3, y: 3, width: 77, height: 92 };
                const titleArea = state.pdfExport.titleArea || { x: 20, y: 5, width: 50, height: 8 };
                const areaX = pageWidth * (area.x / 100);
                const areaY = pageHeight * (area.y / 100);
                const areaW = pageWidth * (area.width / 100);
                const areaH = pageHeight * (area.height / 100);
                const tX = pageWidth * (titleArea.x / 100);
                const tY = pageHeight * (titleArea.y / 100);
                const tW = pageWidth * (titleArea.width / 100);
                const tH = pageHeight * (titleArea.height / 100);

                // Title banner (aligned inside area)
                const titleText = (state.pdfExport.pdfTitle || projectForPdf.name || '').toUpperCase() || 'NAME OF THE SHOW';
                try { doc.setFont(effectiveFamily, 'bold'); } catch(_) { try { doc.setFont('helvetica', 'bold'); } catch(__) {} }
                let coverFS = (Number.isFinite(+ts.bannerFS) && +ts.bannerFS > 0) ? Math.max(10, +ts.bannerFS) : Math.min(32, Math.max(16, tH - 6));
                doc.setFontSize(coverFS);
                const padX = 12, padY = 6;
                const bX = tX;
                const bY = tY;
                const bW = tW;
                const bH = tH;
                doc.setFillColor(235, 235, 235);
                doc.setDrawColor(180, 180, 180);
                doc.rect(bX, bY, bW, bH, 'FD');
                doc.setTextColor('#000000');
                {
                    const alignMap2 = { left: 'left', center: 'center', right: 'right' };
                    const baselineMap2 = { top: 'top', middle: 'middle', bottom: 'bottom' };
                    const align2 = alignMap2[(ts.bannerAlignH || 'center')] || 'center';
                    const baseline2 = baselineMap2[(ts.bannerAlignV || 'middle')] || 'middle';
                    if (ts.bannerFitToWidth) {
                        const avail = Math.max(12, bW - 12);
                        const w = doc.getTextWidth(titleText);
                        if (w > avail && coverFS > 6) {
                            const scale = avail / w;
                            coverFS = Math.max(6, Math.floor(coverFS * scale));
                            doc.setFontSize(coverFS);
                        }
                    }
                    const ax2 = align2 === 'left' ? (bX + 6) : align2 === 'right' ? (bX + bW - 6) : (bX + bW / 2);
                    const ay2 = baseline2 === 'top' ? (bY + 6) : baseline2 === 'bottom' ? (bY + bH - 6) : (bY + bH / 2);
                    doc.text(titleText, ax2, ay2, { align: align2, baseline: baseline2 });
                }

                // Optional cover image (fits below banner inside area)
                if (state.pdfExport.coverImage) {
                    const img = state.pdfExport.coverImage;
                    const imgAspect = img.naturalWidth / img.naturalHeight;
                    const padTop = Math.max(8, (tY + tH) - areaY + 12);
                    const imgX = areaX + 10;
                    const imgY = areaY + padTop;
                    const imgW = areaW - 20;
                    let drawW = imgW;
                    let drawH = drawW / imgAspect;
                    const maxH = areaH - padTop - 14;
                    if (drawH > maxH) { drawH = maxH; drawW = drawH * imgAspect; }
                    const dx = areaX + (areaW - drawW) / 2;
                    const dy = imgY + (maxH - drawH) / 2; // vertically center within remaining area
                    try { doc.addImage(img, 'JPEG', dx, dy, drawW, drawH); } catch (e) { /* ignore */ }
                }

                // Place Title Block on the title page as well (Page 1)
                drawTitleBlock(doc, 1, totalPages);
                pageIndex = 1;
                // Do not add a page here; the loop will add a page before the first map page when needed
            }

            // Pixel map pages — similar-sized maps share a single page
            const isFirstMapPage = !state.pdfExport.includeTitlePage;
            for (let gi = 0; gi < mapGroups.length; gi++) {
                const group = mapGroups[gi];
                if (!(gi === 0 && isFirstMapPage)) { doc.addPage(); }
                pageIndex += 1;

                if (group.length === 2) {
                    // Two maps with the same pixel dimensions → side-by-side on one page
                    const map1 = group[0], map2 = group[1];
                    const canvas1 = document.createElement('canvas');
                    const canvas2 = document.createElement('canvas');
                    drawVisualizerCanvas(canvas1, map1, { forceFullRes: true });
                    drawVisualizerCanvas(canvas2, map2, { forceFullRes: true });
                    if (canvas1.width > 0 || canvas2.width > 0) {
                        addTwoImagesToPage(doc, canvas1, map1, canvas2, map2, pageIndex, totalPages);
                    }
                } else {
                    // Single map — original single-page behaviour
                    const map = group[0];
                    const tempCanvas = document.createElement('canvas');
                    drawVisualizerCanvas(tempCanvas, map, { forceFullRes: true });
                    if (tempCanvas.width > 0) {
                        const mapName = state.pdfExport.mapNames[map.id] || map.name;
                        const title = state.pdfExport.pdfTitle ? `${state.pdfExport.pdfTitle} - ${mapName}` : `Pixel Map: ${mapName}`;
                        addImageToPage(doc, title, tempCanvas, map, pageIndex, totalPages);
                    }
                }
            }
            if (state.pdfExport.includeCanvas === 'specific' && !(state.pdfExport.selectedCanvasIds || []).length) {
                showNotification('Select at least one output map in the Specific Output list.');
            }
            for (let canvasIndex = 0; canvasIndex < pdfCanvases.length; canvasIndex += 2) {
                const firstCanvas = pdfCanvases[canvasIndex];
                const secondCanvas = pdfCanvases[canvasIndex + 1];
                const firstImage = captureProjectCanvasToCanvas(firstCanvas);
                const secondImage = secondCanvas ? captureProjectCanvasToCanvas(secondCanvas) : null;
                if (!firstImage) continue;
                doc.addPage();
                pageIndex += 1;
                const firstDetails = { __isCanvas: true, name: firstCanvas.name, width: firstCanvas.width, height: firstCanvas.height, mapsCount: (firstCanvas.maps || []).length };
                if (secondCanvas && secondImage) {
                    const secondDetails = { __isCanvas: true, name: secondCanvas.name, width: secondCanvas.width, height: secondCanvas.height, mapsCount: (secondCanvas.maps || []).length };
                    addTwoImagesToPage(doc, firstImage, firstDetails, secondImage, secondDetails, pageIndex, totalPages);
                } else {
                    const title = state.pdfExport.pdfTitle ? `${state.pdfExport.pdfTitle} - ${firstCanvas.name}` : firstCanvas.name;
                    addImageToPage(doc, title, firstImage, firstDetails, pageIndex, totalPages);
                }
            }

            // Add 3D View snapshot page if requested
            if (state.pdfExport.include3dView) {
                try {
                    const v3dCanvas = document.getElementById('view3d-canvas');
                    if (v3dCanvas && v3dCanvas.width > 0 && v3dCanvas.height > 0) {
                        // Build a plain canvas wrapper that addImageToPage expects
                        const snap3d = document.createElement('canvas');
                        snap3d.width = v3dCanvas.width;
                        snap3d.height = v3dCanvas.height;
                        snap3d.getContext('2d').drawImage(v3dCanvas, 0, 0);
                        doc.addPage();
                        pageIndex += 1;
                        const title3d = state.pdfExport.pdfTitle ? `${state.pdfExport.pdfTitle} - 3D View` : '3D View';
                        addImageToPage(doc, title3d, snap3d, { name: '3D View', __is3d: true }, pageIndex, totalPages);
                    }
                } catch (_) {}
            }

            // Add final page: Delivery Specification (inside template area with grey bg, black outline, justified)
            const addDeliverySpecPage = (doc, pageNumber) => {
                const spec = state.pdfExport.deliverySpec || {};
                // start a new page and draw template background if present
                doc.addPage();
                const pageWidth = doc.internal.pageSize.getWidth();
                const pageHeight = doc.internal.pageSize.getHeight();
                const margin = 36;

                const templateImg = state.pdfExport.exportWithoutTemplate ? null : state.pdfExport.templateImage;
                if (templateImg) {
                    try {
                        doc.addImage(templateImg, 'JPEG', 0, 0, pageWidth, pageHeight);
                    } catch (e) {
                        // fallback: ignore image drawing errors
                        console.warn('Failed to draw template on delivery page', e);
                    }
                }

                // Compute the template area and the title banner area
                const area = state.pdfExport.templateArea || { x: 6, y: 6, width: 44, height: 80 };
                const titleArea = state.pdfExport.titleArea || { x: 20, y: 5, width: 50, height: 8 };
                const areaX = pageWidth * (area.x / 100);
                const areaY = pageHeight * (area.y / 100);
                const areaW = pageWidth * (area.width / 100);
                const areaH = pageHeight * (area.height / 100);
                const tX = pageWidth * (titleArea.x / 100);
                const tY = pageHeight * (titleArea.y / 100);
                const tW = pageWidth * (titleArea.width / 100);
                const tH = pageHeight * (titleArea.height / 100);

                // Draw centered title banner with two lines
                const showTitle = (state.pdfExport.pdfTitle || state.projects.find(p => p.id == state.pdfExport.selectedProjectId)?.name || 'NAME OF THE SHOW').toUpperCase();
                const mediaName = (spec.mediaServer === 'Custom' && spec.mediaServerCustom) ? spec.mediaServerCustom : spec.mediaServer;
                const specLine = `*${(mediaName || 'FILE DELIVERY').toUpperCase()} - FILE DELIVERY SPECIFICATIONS*`;
                doc.setFillColor(235, 235, 235);
                doc.setDrawColor(180, 180, 180);
                doc.rect(tX, tY, tW, tH, 'FD');
                doc.setTextColor('#000000');
                try { doc.setFont(effectiveFamily, 'bold'); } catch(_) { try { doc.setFont('helvetica', 'bold'); } catch(__) {} }
                let line1Size = (Number.isFinite(+ts.bannerFS) && +ts.bannerFS > 0) ? Math.max(10, Math.min(24, +ts.bannerFS)) : Math.min(20, Math.max(12, tH * 0.45));
                let line2Size = Math.max(8, Math.min(24, Math.round(line1Size * 0.8)));
                // Fit each line to the available width if enabled
                if (ts.bannerFitToWidth) {
                    const avail = Math.max(12, tW - 12); // 6px padding on each side
                    doc.setFontSize(line1Size);
                    const w1 = doc.getTextWidth(showTitle);
                    if (w1 > avail) {
                        const s1 = avail / Math.max(1, w1);
                        line1Size = Math.max(8, Math.floor(line1Size * s1));
                    }
                    doc.setFontSize(line2Size);
                    const w2 = doc.getTextWidth(specLine);
                    if (w2 > avail) {
                        const s2 = avail / Math.max(1, w2);
                        line2Size = Math.max(8, Math.floor(line2Size * s2));
                    }
                }
                doc.setFontSize(line1Size);
                doc.text(showTitle, tX + tW / 2, tY + (tH * 0.45), { align: 'center', baseline: 'middle' });
                doc.setFontSize(line2Size);
                doc.text(specLine, tX + tW / 2, tY + (tH * 0.8), { align: 'center', baseline: 'middle' });

                // Inner grey panel for the fields (below banner, inside template area)
                const panelPad = 12;
                const panelY = Math.max(areaY + panelPad, tY + tH + 8);
                const panelX = areaX + panelPad;
                const panelW = areaW - panelPad * 2;
                const panelH = areaY + areaH - panelPad - panelY;
                doc.setDrawColor(0, 0, 0);
                if (spec.showPanelBackground) {
                    doc.setFillColor(230, 230, 230);
                    doc.rect(panelX, panelY, panelW, panelH, 'FD');
                }

                // Three-column text layout: Label | : | Value
                const rowGap = 6;
                const labelX = panelX + 10;
                const colonX = labelX + 130;
                const valueX = colonX + 10;
                const valueW = panelW - (valueX - panelX) - 10;

                const codecsList = Array.isArray(spec.codecs) ? spec.codecs.filter(c => c !== 'Other') : (spec.codecs ? [spec.codecs] : []);
                const codecsText = (codecsList.length ? codecsList.join(' / ') : (spec.codecsCustom || '')) || 'N/A';
                const mediaServerValue = (spec.mediaServer === 'Custom' && spec.mediaServerCustom) ? spec.mediaServerCustom : spec.mediaServer;
                const linesDLBase = window.PixelLogicPdfTemplates.getCodecDownloadLinks(spec).map(link => `${link.label}: ${link.url}`);

                // Build rows (unwrapped yet; wrapping depends on font size)
                const rows = [
                    { label: 'Media Server', value: mediaServerValue || 'N/A' },
                    { label: 'Format', value: spec.format || 'N/A' },
                    { label: 'Codec', value: codecsText },
                    { label: 'Download Link', dl: linesDLBase },
                    { label: 'Quality', value: spec.quality || 'N/A' },
                    { label: 'Pixel Aspect Ratio', value: spec.pixelAspectRatio || 'N/A' },
                    { label: 'FPS', value: spec.fps || 'N/A' },
                    { label: 'Embedded Audio Settings', value: spec.embeddedAudio ? (spec.embeddedAudioDetails || 'Yes') : 'No' },
                    { label: 'Sample Rate', value: spec.sampleRate || 'N/A' },
                    { label: 'Unembedded Audio Format', value: spec.unembeddedAudioFormat || 'N/A' },
                    { label: 'Still Frame Format', value: spec.stillFrameFormat || 'N/A' },
                    { label: 'Naming Structure', value: spec.namingStructure || 'N/A' },
                    { label: 'Example', value: spec.example || '' },
                    { label: 'Comments', value: spec.comments || '' },
                ];

                // Add Content Validation Email row (from dedicated field or detected inside note)
                const emailFromNote = (spec.contentValidationNote || '').match(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}/i)?.[0] || '';
                const validationEmail = (spec.contentValidationEmail || emailFromNote || '').trim();
                if (validationEmail) {
                    const commentsIdx = rows.findIndex(r => r.label === 'Comments');
                    const emailRow = { label: 'Content Validation Email', email: validationEmail };
                    if (commentsIdx >= 0) rows.splice(commentsIdx, 0, emailRow); else rows.push(emailRow);
                }

                const startY = panelY + 18;
                const minRowsFS = 9;
                let rowsFS = Math.max(8, Math.min(72, Number.isFinite(+ts.deliveryFS) ? +ts.deliveryFS : 12));
                let noteFS = 10; // will be adjusted relative to rowsFS
                const padBottom = 10;

                const measureWithFont = (fsRows) => {
                    // Measure rows
                    doc.setFontSize(fsRows);
                    const lhRows = Math.round(fsRows * 1.2);
                    let totalRowsH = 0;
                    for (const r of rows) {
                        if (r.dl && r.dl.length) {
                            totalRowsH += (r.dl.length * lhRows) + rowGap;
                        } else if (r.email) {
                            const wrapped = doc.splitTextToSize(String(r.email || ''), valueW);
                            totalRowsH += (Math.max(1, wrapped.length) * lhRows) + rowGap;
                        } else {
                            const wrapped = doc.splitTextToSize(String(r.value || ''), valueW);
                            totalRowsH += (Math.max(1, wrapped.length) * lhRows) + rowGap;
                        }
                    }
                    totalRowsH -= rowGap; // remove last gap
                    // Measure note with slightly smaller font
                    const fsNote = Math.max(8, fsRows - 1);
                    doc.setFontSize(fsNote);
                    const lhNote = Math.round(fsNote * 1.2);
                    const noteLines = spec.contentValidationNote ? doc.splitTextToSize(spec.contentValidationNote, panelW - 20) : [];
                    const noteH = noteLines.length ? (noteLines.length * lhNote) : 0;
                    const total = (startY - panelY) + totalRowsH + padBottom + noteH;
                    return { total, lhRows, fsNote, lhNote, noteLines };
                };

                // Fit loop
                let measure = measureWithFont(rowsFS);
                while (rowsFS > minRowsFS && measure.total > panelH) {
                    rowsFS -= 1;
                    measure = measureWithFont(rowsFS);
                }
                noteFS = measure.fsNote;

                // Render
                let y = startY;
                doc.setFont(undefined, 'normal');
                doc.setFontSize(rowsFS);
                for (let rIndex = 0; rIndex < rows.length; rIndex++) {
                    const r = rows[rIndex];
                    doc.setTextColor('#000000');
                    const lh = measure.lhRows;
                    doc.text(String(r.label || ''), labelX, y);
                    doc.text(':', colonX, y);
                    if (r.dl && r.dl.length) {
                        r.dl.forEach((full, idx) => {
                            const [prefix, url] = full.split(': ');
                            const yLine = y + (idx * lh);
                            doc.setTextColor('#000000');
                            doc.text(prefix + ':', valueX, yLine);
                            const pxW = doc.getTextWidth(prefix + ': ');
                            doc.setTextColor(200, 0, 0);
                            doc.text(url, valueX + pxW, yLine);
                            try { doc.link(valueX + pxW, yLine - (lh - rowsFS), doc.getTextWidth(url), lh, { url }); } catch (e) { /* ignore */ }
                        });
                        doc.setTextColor('#000000');
                        y += (r.dl.length * lh);
                        if (rIndex < rows.length - 1) y += rowGap;
                    } else if (r.email) {
                        // Render email as clickable mailto link
                        const wrapped = doc.splitTextToSize(String(r.email || ''), valueW);
                        let first = true;
                        wrapped.forEach(line => {
                            if (!first) y += lh;
                            doc.setTextColor(200, 0, 0);
                            doc.text(line, valueX, y);
                            try { doc.link(valueX, y - (lh - rowsFS), doc.getTextWidth(line), lh, { url: `mailto:${line}` }); } catch (e) { /* ignore */ }
                            first = false;
                        });
                        doc.setTextColor('#000000');
                        y += lh;
                        if (rIndex < rows.length - 1) y += rowGap;
                    } else {
                        const wrapped = doc.splitTextToSize(String(r.value || ''), valueW);
                        let first = true;
                        wrapped.forEach(line => {
                            if (!first) y += lh;
                            doc.text(line, valueX, y);
                            first = false;
                        });
                        y += lh;
                        if (rIndex < rows.length - 1) y += rowGap;
                    }
                }

                // Bottom red validation note inside the grey panel (anchored near bottom)
                if (spec.showValidationNote && spec.contentValidationNote) {
                    doc.setTextColor(200, 0, 0);
                    doc.setFontSize(noteFS);
                    const lhNote = Math.round(noteFS * 1.2);
                    const noteLines = doc.splitTextToSize(spec.contentValidationNote, panelW - 20);
                    const totalH = noteLines.length * lhNote;
                    const noteY = Math.max(panelY + panelH - 10 - totalH, y + 6);
                    doc.text(noteLines, panelX + 10, noteY);
                    doc.setTextColor('#000000');
                }

                // Draw Title Block on this Delivery page as well
                drawTitleBlock(doc, pageNumber, totalPages);
            };

            // Delivery page is the last page
            pageIndex += 1;
            addDeliverySpecPage(doc, pageIndex);

            if (mode === 'preview') {
                try {
                    const canvases = await renderPdfToCanvases(doc, 1.25);
                    if (options && options.returnCanvases) {
                        return canvases;
                    }
                    if (options && options.suppressPanel) {
                        return true;
                    }
                    const panel = document.getElementById('pdf-preview-panel');
                    const pagesEl = document.getElementById('pdf-preview-pages');
                    if (!panel || !pagesEl) return;
                    pagesEl.innerHTML = '';
                    canvases.forEach((canvas, idx) => {
                        canvas.style.width = '100%';
                        const wrapper = document.createElement('div');
                        wrapper.className = 'bg-white rounded shadow overflow-hidden';
                        wrapper.appendChild(canvas);
                        const caption = document.createElement('div');
                        caption.className = 'text-xs text-gray-300 mt-1';
                        caption.textContent = `Page ${idx + 1} of ${canvases.length}`;
                        pagesEl.appendChild(wrapper);
                        pagesEl.appendChild(caption);
                    });
                    panel.classList.remove('hidden');
                    state.pdfExport.previewPanelOpen = true;
                    state.pdfExport.previewDirty = false;
                    const badge = document.getElementById('pdf-preview-dirty');
                    if (badge) badge.classList.add('hidden');
                    showNotification('Preview ready');
                } catch (e) {
                    console.warn('PDF preview error', e);
                    try {
                        const pdfBlob = doc.output('blob');
                        const blobUrl = URL.createObjectURL(pdfBlob);
                        window.open(blobUrl, '_blank');
                        showNotification('Preview opened in a new tab');
                    } catch (_) {
                        showNotification('Failed to render preview');
                    }
                }
            } else {
                applyDemoWatermarkToPDF(doc);
                const safeOut = (state.pdfExport.outputFileName || `${projectForPdf.name}_PixelMaps_Export`).replace(/[^A-Za-z0-9_\-]/g, '_');
                doc.save(`${safeOut}.pdf`);
                showNotification('PDF generated successfully!');
            }
        } catch (err) {
            console.error('PDF generation error', err);
            showNotification('Failed to generate/preview PDF: ' + (err && err.message ? err.message : String(err)));
        }
        };

        const generatePptx = async () => {
            try {
                const PptxGen = window.PptxGenJS || window.PptxGen;
                if (!PptxGen) {
                    showNotification('PowerPoint engine not loaded. Please reload the app.');
                    return;
                }

                const projectForPdf = state.projects.find(p => p.id == state.pdfExport.selectedProjectId);
                if (!projectForPdf || projectForPdf.pixelMaps.length === 0) {
                    showNotification('Please select a project with at least one pixel map to export.');
                    return;
                }

                showNotification('Generating PPTX... This may take a moment.');

                const pptx = new PptxGen();
                const layoutName = 'A4_LANDSCAPE';
                if (typeof pptx.defineLayout === 'function') {
                    pptx.defineLayout({ name: layoutName, width: 11.69, height: 8.27 });
                    pptx.layout = layoutName;
                } else {
                    pptx.layout = 'LAYOUT_WIDE';
                }
                pptx.author = 'Pixelogic';
                pptx.company = 'Pixelogic';
                pptx.title = state.pdfExport.pdfTitle || projectForPdf.name || 'Pixelogic Export';

                const slideW = (pptx.layout === layoutName) ? 11.69 : 13.333;
                const slideH = (pptx.layout === layoutName) ? 8.27 : 7.5;
                const ptPerInch = 72;
                const percentToInches = (pct, total) => (total * (pct / 100));
                const areaToRect = (area) => ({
                    x: percentToInches(area.x, slideW),
                    y: percentToInches(area.y, slideH),
                    w: percentToInches(area.width, slideW),
                    h: percentToInches(area.height, slideH),
                });
                const drawTemplateBg = (slide) => {
                    if (!state.pdfExport.exportWithoutTemplate && state.pdfExport.templateSrc) {
                        slide.addImage({ data: state.pdfExport.templateSrc, x: 0, y: 0, w: slideW, h: slideH });
                    } else {
                        slide.addShape(pptx.ShapeType.rect, { x: 0, y: 0, w: slideW, h: slideH, fill: { color: 'FFFFFF' }, line: { color: 'FFFFFF' } });
                    }
                };
                const buildDetailsLines = (detailsSourceMap) => {
                    const calcs = calculateLayout(detailsSourceMap);
                    let lines = [];
                    if (detailsSourceMap && detailsSourceMap.__isCanvas) {
                        const canvasName = detailsSourceMap.name || 'Output Canvas';
                        lines = [
                            `Screen Name: ${state.pdfExport.pdfTitle ? `${state.pdfExport.pdfTitle} - ` : ''}${canvasName}`,
                            `Canvas Size (px): ${detailsSourceMap.width} x ${detailsSourceMap.height}`,
                            `Maps on Canvas: ${detailsSourceMap.mapsCount || 0}`
                        ];
                    } else {
                        const isComposite = !!(detailsSourceMap && detailsSourceMap.composite && detailsSourceMap.composite.enabled);
                        let compositePanelsW = calcs.panelsHorizontally || 'N/A';
                        let compositePanelsH = calcs.panelsVertically || 'N/A';
                        if (isComposite) {
                            const comp = detailsSourceMap.composite;
                            const pA = comp.primary || detailsSourceMap;
                            const pB = comp.secondary || null;
                            const cA = calculateLayout(pA) || {};
                            const cB = pB ? (calculateLayout(pB) || {}) : {};
                            const place = comp.placement || 'right';
                            const wA = cA.panelsHorizontally || 0;
                            const hA = cA.panelsVertically || 0;
                            const wB = cB.panelsHorizontally || 0;
                            const hB = cB.panelsVertically || 0;
                            if (place === 'left' || place === 'right') {
                                compositePanelsW = wA + wB;
                                compositePanelsH = Math.max(hA, hB);
                            } else {
                                compositePanelsW = Math.max(wA, wB);
                                compositePanelsH = hA + hB;
                            }
                        }
                        const mapName = detailsSourceMap ? (state.pdfExport.mapNames[detailsSourceMap.id] || detailsSourceMap.name) : '';
                        const screenSizeText = (calcs && calcs.screenWidthMm) ? `${(calcs.screenWidthMm / 1000).toFixed(2)}m x ${(calcs.screenHeightMm / 1000).toFixed(2)}m` : 'N/A';
                        const computedPitch = getCompositePitchMm(detailsSourceMap);
                        lines = [
                            `Screen Name: ${state.pdfExport.pdfTitle ? `${state.pdfExport.pdfTitle} - ` : ''}${mapName}`,
                            `Screen Size (m): ${screenSizeText}`,
                            ...(!isComposite ? [`Pixels per Tile: ${detailsSourceMap.panelResWidth || 'N/A'}px x ${detailsSourceMap.panelResHeight || 'N/A'}px`] : []),
                            ...(state.pdfExport.includePitchInDetails ? [
                                `Pixel Pitch: ${computedPitch!=null ? (computedPitch + ' mm') : 'N/A'}`
                            ] : []),
                            `Total Tiles: ${compositePanelsW || 'N/A'} (W) x ${compositePanelsH || 'N/A'} (H)`,
                            ...(!isComposite ? [`Panel Size (mm): ${detailsSourceMap.panelWidthMm || 'N/A'}mm x ${detailsSourceMap.panelHeightMm || 'N/A'}mm`] : []),
                            `Total Pixel Size: ${calcs.totalResWidth || 'N/A'}px x ${calcs.totalResHeight || 'N/A'}px`,
                            `Aspect Ratio: ${formatAspectRatio(calcs.totalResWidth, calcs.totalResHeight)}`
                        ];
                    }
                    return lines;
                };
                const addTitleBanner = (slide, detailsSourceMap) => {
                    const ts = (state.pdfExport && state.pdfExport.textStyle) || {};
                    const baseTitle = (state.pdfExport.pdfTitle || projectForPdf.name || 'NAME OF THE SHOW');
                    let subTitle = '';
                    if (ts.includeMapNameInBanner) {
                        if (detailsSourceMap && detailsSourceMap.__isCanvas) subTitle = detailsSourceMap.name || '';
                        else if (detailsSourceMap) subTitle = (state.pdfExport.mapNames?.[detailsSourceMap.id] || detailsSourceMap.name || '');
                    }
                    const bannerText = (subTitle ? `${baseTitle} - ${subTitle}` : baseTitle).toUpperCase();
                    const tA = state.pdfExport.titleArea || { x: 20, y: 5, width: 50, height: 8 };
                    const r = areaToRect(tA);
                    slide.addShape(pptx.ShapeType.rect, {
                        x: r.x,
                        y: r.y,
                        w: r.w,
                        h: r.h,
                        fill: { color: 'EBEBEB' },
                        line: { color: 'B4B4B4' },
                    });
                    const alignMap = { left: 'left', center: 'center', right: 'right' };
                    const valignMap = { top: 'top', middle: 'mid', bottom: 'bottom' };
                    const align = alignMap[(ts.bannerAlignH || 'center')] || 'center';
                    const valign = valignMap[(ts.bannerAlignV || 'middle')] || 'mid';
                    let fsB = (Number.isFinite(+ts.bannerFS) && +ts.bannerFS > 0) ? +ts.bannerFS : Math.min(22, Math.max(12, Math.round((r.h * ptPerInch) - 6)));
                    slide.addText(bannerText, {
                        x: r.x,
                        y: r.y,
                        w: r.w,
                        h: r.h,
                        fontSize: fsB,
                        bold: true,
                        color: '000000',
                        align,
                        valign,
                    });
                };
                const addDetailsBlock = (slide, detailsSourceMap) => {
                    const ts = (state.pdfExport && state.pdfExport.textStyle) || {};
                    const dA = state.pdfExport.detailsArea || { x: 4, y: 80, width: 52, height: 16 };
                    const r = areaToRect(dA);
                    const lines = buildDetailsLines(detailsSourceMap);
                    let fontSize = Math.max(8, Math.min(16, Number.isFinite(+ts.detailsFS) ? +ts.detailsFS : 14));
                    const pad = 0.1;
                    const maxH = r.h - pad * 2;
                    const fits = (fs) => {
                        const lineH = (fs * 1.2) / ptPerInch;
                        return (lines.length * lineH) <= maxH;
                    };
                    while (!fits(fontSize) && fontSize > 8) fontSize -= 1;
                    slide.addShape(pptx.ShapeType.rect, {
                        x: r.x,
                        y: r.y,
                        w: r.w,
                        h: r.h,
                        fill: { color: 'E6E6E6' },
                        line: { color: '000000' },
                    });
                    slide.addText(lines.join('\n'), {
                        x: r.x + pad,
                        y: r.y + pad,
                        w: r.w - pad * 2,
                        h: r.h - pad * 2,
                        fontSize,
                        color: '000000',
                        align: 'left',
                        valign: 'top',
                    });
                };
                const addTitleBlock = (slide, pageNumber, totalPages) => {
                    if (!state.pdfExport.showTitleBlock) return;
                    const area = state.pdfExport.titleBlockArea || { x: 79, y: 18, width: 18, height: 76 };
                    const r = areaToRect(area);
                    const s = state.pdfExport.titleBlock || {};
                    const entries = [
                        { label: 'Project Name', value: (s.projectName || projectForPdf?.name || '').toString() },
                        { label: 'Project Date', value: (s.projectDate || '').toString() },
                        { label: 'Venue', value: (s.venue || projectForPdf?.venue || '').toString() },
                        { label: 'Sales', value: (s.sales || projectForPdf?.salesperson || '').toString() },
                        { label: 'Client', value: (s.client || projectForPdf?.client || '').toString() },
                        { label: 'Page no', value: `Page ${pageNumber} of ${totalPages}` },
                        { label: 'Drawn By', value: (s.drawnBy || '').toString() },
                        { label: 'Version', value: (s.version || '').toString() },
                    ];
                    const tbs = (state.pdfExport && state.pdfExport.titleBlockStyle) || {};
                    const pxToIn = 1 / 96;
                    const padX = Math.max(0.06, Math.round((r.w * 0.08) * 100) / 100);
                    const padY = Math.max(0.06, Math.round((r.h * 0.04) * 100) / 100);
                    let fontSize = Math.round(Number.isFinite(tbs.valueBaseFS) ? tbs.valueBaseFS : 9);
                    const minFS = Math.max(6, Math.min(fontSize, Math.round(Number.isFinite(tbs.minValueFS) ? tbs.minValueFS : 7)));
                    let entryGap = Number.isFinite(tbs.entryGap) ? tbs.entryGap : 4;
                    const gapIn = Math.max(0, entryGap * pxToIn);
                    const rowPad = 0.02;
                    const labelW = (r.w - padX * 2) * 0.45;
                    const colonW = (r.w - padX * 2) * 0.05;
                    const valueW = (r.w - padX * 2) - labelW - colonW;
                    const maxCharsValue = (fs) => Math.max(8, Math.floor((valueW * ptPerInch) / (fs * 0.6)));
                    const availableH = Math.max(0.1, r.h - padY * 2);
                    let rowH = (availableH - gapIn * (entries.length - 1)) / entries.length;
                    rowH = Math.max(0.12, rowH);
                    const baseRowFs = Math.max(minFS, Math.min(fontSize, Math.floor(rowH * ptPerInch * 0.8)));
                    let y = r.y + padY;
                    for (let i = 0; i < entries.length; i++) {
                        let fsRow = baseRowFs;
                        let lines = wrapTextSimple(entries[i].value, maxCharsValue(fsRow));
                        let lineH = (fsRow * 1.2) / ptPerInch;
                        while ((lines.length * lineH) > rowH && fsRow > minFS) {
                            fsRow -= 1;
                            lines = wrapTextSimple(entries[i].value, maxCharsValue(fsRow));
                            lineH = (fsRow * 1.2) / ptPerInch;
                        }
                        slide.addShape(pptx.ShapeType.rect, {
                            x: r.x + padX,
                            y: y - rowPad,
                            w: r.w - padX * 2,
                            h: rowH + rowPad * 2,
                            line: { color: '000000' },
                            fill: { color: 'FFFFFF', transparency: 100 },
                        });
                        slide.addText(entries[i].label, {
                            x: r.x + padX + 0.02,
                            y,
                            w: labelW,
                            h: rowH,
                            fontSize: fsRow,
                            color: '000000',
                            align: 'left',
                            valign: 'top',
                        });
                        slide.addText(':', {
                            x: r.x + padX + labelW,
                            y,
                            w: colonW,
                            h: rowH,
                            fontSize: fsRow,
                            color: '000000',
                            align: 'center',
                            valign: 'top',
                        });
                        slide.addText(lines.join('\n'), {
                            x: r.x + padX + labelW + colonW,
                            y,
                            w: valueW,
                            h: rowH,
                            fontSize: fsRow,
                            color: '000000',
                            align: 'left',
                            valign: 'top',
                        });
                        y += rowH + gapIn;
                        if (y > r.y + r.h - padY) break;
                    }
                };
                const addRefImage = (slide, detailsSourceMap) => {
                    try {
                        const refImg = detailsSourceMap && detailsSourceMap.__pdfRefImage;
                        if (refImg && refImg.naturalWidth && refImg.naturalHeight && state.pdfExport && state.pdfExport.refImageArea) {
                            const rA = state.pdfExport.refImageArea;
                            const r = areaToRect(rA);
                            const aspectR = refImg.naturalWidth / refImg.naturalHeight;
                            let rw = r.w;
                            let rh = rw / aspectR;
                            if (rh > r.h) { rh = r.h; rw = rh * aspectR; }
                            const rx = r.x + (r.w - rw) / 2;
                            const ry = r.y + (r.h - rh) / 2;
                            slide.addImage({ data: refImg.src || refImg, x: rx, y: ry, w: rw, h: rh });
                        }
                    } catch(_) {}
                };
                const wrapTextSimple = (text, maxChars) => {
                    const str = String(text || '');
                    if (!maxChars || maxChars < 4) return [str];
                    const words = str.split(/\s+/);
                    const lines = [];
                    let line = '';
                    words.forEach(word => {
                        if (!line) {
                            line = word;
                            return;
                        }
                        if ((line.length + 1 + word.length) <= maxChars) {
                            line += ' ' + word;
                        } else {
                            lines.push(line);
                            line = word;
                        }
                    });
                    if (line) lines.push(line);
                    return lines.length ? lines : [str];
                };
                const addMapImage = (slide, imageCanvas) => {
                    const placement = state.pdfExport.placement;
                    const aspect = imageCanvas.width / imageCanvas.height;
                    let imgW, imgH, x, y;
                    if (state.pdfExport.autoFitPlacement) {
                        const area = state.pdfExport.templateArea || { x: 6, y: 6, width: 44, height: 80 };
                        let areaX = percentToInches(area.x, slideW);
                        let areaY = percentToInches(area.y, slideH);
                        const areaW = percentToInches(area.width, slideW);
                        let areaH = percentToInches(area.height, slideH);
                        const t = state.pdfExport.titleArea;
                        if (t) {
                            const tX = percentToInches(t.x, slideW);
                            const tY = percentToInches(t.y, slideH);
                            const tW = percentToInches(t.width, slideW);
                            const tH = percentToInches(t.height, slideH);
                            const interLeft = Math.max(areaX, tX), interTop = Math.max(areaY, tY);
                            const interRight = Math.min(areaX + areaW, tX + tW), interBottom = Math.min(areaY + areaH, tY + tH);
                            if (interRight > interLeft && interBottom > interTop) {
                                const delta = (tY + tH) - areaY + (12 / ptPerInch);
                                areaY = areaY + Math.max(0, delta);
                                areaH = Math.max(0.1, (percentToInches(area.y + area.height, slideH)) - areaY);
                            }
                        }
                        imgW = areaW;
                        imgH = imgW / aspect;
                        if (imgH > areaH) { imgH = areaH; imgW = imgH * aspect; }
                        const scale = (state.pdfExport.mapScale || 100) / 100;
                        imgW *= scale; imgH *= scale;
                        let baseX = areaX + (areaW - imgW) / 2;
                        let baseY = areaY + (areaH - imgH) / 2;
                        const off = state.pdfExport.mapOffset || { x: 0, y: 0 };
                        const remX = Math.max(0, areaW - imgW);
                        const remY = Math.max(0, areaH - imgH);
                        x = baseX + (remX * (off.x / 100));
                        y = baseY + (remY * (off.y / 100));
                        x = Math.max(areaX, Math.min(areaX + areaW - imgW, x));
                        y = Math.max(areaY, Math.min(areaY + areaH - imgH, y));
                    } else {
                        const placementAreaX = percentToInches(placement.x, slideW);
                        const placementAreaY = percentToInches(placement.y, slideH);
                        const placementAreaWidth = percentToInches(placement.width, slideW);
                        const placementAreaHeight = percentToInches(placement.height, slideH);
                        imgW = placementAreaWidth;
                        imgH = imgW / aspect;
                        if (imgH > placementAreaHeight) { imgH = placementAreaHeight; imgW = imgH * aspect; }
                        x = placementAreaX + (placementAreaWidth - imgW) / 2;
                        y = placementAreaY + (placementAreaHeight - imgH) / 2;
                    }
                    const dataUrl = imageCanvas.toDataURL('image/png');
                    slide.addImage({ data: dataUrl, x, y, w: imgW, h: imgH });
                };

                const collectPdfCanvases = () => {
                    const mode = state.pdfExport.includeCanvas;
                    if (!mode || mode === 'none') return [];
                    const outputMaps = projectForPdf.canvases || [];
                    if (mode === 'active') {
                        const outputMap = ensureOutputMapRegions(outputMaps.find(item => item.id === projectForPdf.activeCanvasId) || outputMaps[0]);
                        const active = outputMap?.regions.find(region => region.id === outputMap.activeRegionId) || outputMap?.regions[0];
                        return active && active.width > 0 ? [active] : [];
                    }
                    const selectedIds = (state.pdfExport.selectedCanvasIds || []).map(String);
                    const selectedOutputMaps = mode === 'specific'
                        ? outputMaps.filter(outputMap => selectedIds.includes(String(outputMap.id)))
                        : outputMaps;
                    return selectedOutputMaps.flatMap(outputMap => ensureOutputMapRegions(outputMap)?.regions || []).filter(canvas => canvas && canvas.width > 0);
                };
                const pdfCanvases = collectPdfCanvases();
                const countPlannedCanvasPages = () => Math.ceil(pdfCanvases.length / 2);
                const totalPages = (state.pdfExport.includeTitlePage ? 1 : 0) + (projectForPdf.pixelMaps?.length || 0) + countPlannedCanvasPages() + 1;
                let pageIndex = 0;

                if (state.pdfExport.includeTitlePage) {
                    const slide = pptx.addSlide();
                    drawTemplateBg(slide);
                    addTitleBanner(slide, null);
                    if (state.pdfExport.coverImageSrc) {
                        slide.addImage({ data: state.pdfExport.coverImageSrc, x: 0.8, y: 1.2, w: 11.7, h: 5.8, sizing: { type: 'contain', w: 11.7, h: 5.8 } });
                    }
                    pageIndex += 1;
                    addTitleBlock(slide, pageIndex, totalPages);
                }

                (projectForPdf.pixelMaps || []).forEach(map => {
                    const slide = pptx.addSlide();
                    drawTemplateBg(slide);
                    addTitleBanner(slide, map);
                    const tempCanvas = document.createElement('canvas');
                    try { drawVisualizerCanvas(tempCanvas, map, { forceFullRes: true }); } catch (_) {}
                    if (tempCanvas.width > 0 && tempCanvas.height > 0) {
                        addMapImage(slide, tempCanvas);
                    }
                    addDetailsBlock(slide, map);
                    addRefImage(slide, map);
                    pageIndex += 1;
                    addTitleBlock(slide, pageIndex, totalPages);
                });

                const addCanvasPairPage = (canvasPair) => {
                    const slide = pptx.addSlide();
                    drawTemplateBg(slide);
                    addTitleBanner(slide, { name: canvasPair.length > 1 ? 'Output Canvases' : canvasPair[0]?.name || 'Output Canvas' });
                    const area = state.pdfExport.templateArea || { x: 6, y: 14, width: 88, height: 76 };
                    let areaX = percentToInches(area.x, slideW);
                    let areaY = percentToInches(area.y, slideH);
                    let areaW = percentToInches(area.width, slideW);
                    let areaH = percentToInches(area.height, slideH);
                    const titleArea = state.pdfExport.titleArea;
                    if (titleArea) {
                        const titleBottom = percentToInches(titleArea.y + titleArea.height, slideH) + (10 / ptPerInch);
                        if (titleBottom > areaY && titleBottom < areaY + areaH) {
                            areaH = Math.max(0.5, areaY + areaH - titleBottom);
                            areaY = titleBottom;
                        }
                    }
                    const panelGap = 0.24;
                    const panelCount = Math.max(1, canvasPair.length);
                    const panelW = (areaW - panelGap * (panelCount - 1)) / panelCount;
                    const labelH = Math.min(0.58, Math.max(0.38, areaH * 0.12));
                    canvasPair.forEach((canvasObj, index) => {
                        const panelX = areaX + index * (panelW + panelGap);
                        const canvasImage = captureProjectCanvasToCanvas(canvasObj);
                        slide.addText(canvasObj.name || `Canvas ${index + 1}`, {
                            x: panelX,
                            y: areaY,
                            w: panelW,
                            h: labelH * 0.55,
                            fontFace: 'Arial',
                            fontSize: 14,
                            bold: true,
                            color: 'FFFFFF',
                            margin: 0,
                            breakLine: false,
                            fit: 'shrink'
                        });
                        slide.addText(`${canvasObj.width} × ${canvasObj.height} px  |  ${(canvasObj.maps || []).length} map${(canvasObj.maps || []).length === 1 ? '' : 's'}`, {
                            x: panelX,
                            y: areaY + labelH * 0.55,
                            w: panelW,
                            h: labelH * 0.35,
                            fontFace: 'Arial',
                            fontSize: 8,
                            color: '9CA3AF',
                            margin: 0,
                            fit: 'shrink'
                        });
                        if (!canvasImage || canvasImage.width <= 0 || canvasImage.height <= 0) return;
                        const imageAreaY = areaY + labelH;
                        const imageAreaH = Math.max(0.2, areaH - labelH);
                        const aspect = canvasImage.width / canvasImage.height;
                        let imageW = panelW;
                        let imageH = imageW / aspect;
                        if (imageH > imageAreaH) {
                            imageH = imageAreaH;
                            imageW = imageH * aspect;
                        }
                        slide.addImage({
                            data: canvasImage.toDataURL('image/jpeg', 0.88),
                            x: panelX + (panelW - imageW) / 2,
                            y: imageAreaY + (imageAreaH - imageH) / 2,
                            w: imageW,
                            h: imageH
                        });
                    });
                    pageIndex += 1;
                    addTitleBlock(slide, pageIndex, totalPages);
                };
                for (let canvasIndex = 0; canvasIndex < pdfCanvases.length; canvasIndex += 2) {
                    addCanvasPairPage(pdfCanvases.slice(canvasIndex, canvasIndex + 2));
                }

                const deliverySlide = pptx.addSlide();
                drawTemplateBg(deliverySlide);
                addTitleBanner(deliverySlide, { name: 'Delivery Specification' });
                const spec = state.pdfExport.deliverySpec || {};

                const area = state.pdfExport.templateArea || { x: 6, y: 6, width: 44, height: 80 };
                const titleArea = state.pdfExport.titleArea || { x: 20, y: 5, width: 50, height: 8 };
                const areaX = percentToInches(area.x, slideW);
                const areaY = percentToInches(area.y, slideH);
                const areaW = percentToInches(area.width, slideW);
                const areaH = percentToInches(area.height, slideH);
                const tX = percentToInches(titleArea.x, slideW);
                const tY = percentToInches(titleArea.y, slideH);
                const tW = percentToInches(titleArea.width, slideW);
                const tH = percentToInches(titleArea.height, slideH);
                const panelPad = 0.16;
                const panelY = Math.max(areaY + panelPad, tY + tH + 0.12);
                const panelX = areaX + panelPad;
                const panelW = areaW - panelPad * 2;
                const panelH = areaY + areaH - panelPad - panelY;

                const codecsList = Array.isArray(spec.codecs) ? spec.codecs.filter(c => c !== 'Other') : (spec.codecs ? [spec.codecs] : []);
                const codecsText = (codecsList.length ? codecsList.join(' / ') : (spec.codecsCustom || '')) || 'N/A';
                const mediaServerValue = (spec.mediaServer === 'Custom' && spec.mediaServerCustom) ? spec.mediaServerCustom : spec.mediaServer;
                const linesDLBase = window.PixelLogicPdfTemplates.getCodecDownloadLinks(spec).map(link => `${link.label}: ${link.url}`);

                const rows = [
                    { label: 'Media Server', value: mediaServerValue || 'N/A' },
                    { label: 'Format', value: spec.format || 'N/A' },
                    { label: 'Codec', value: codecsText },
                    { label: 'Download Link', value: linesDLBase.join(' | ') || 'N/A' },
                    { label: 'Quality', value: spec.quality || 'N/A' },
                    { label: 'Pixel Aspect Ratio', value: spec.pixelAspectRatio || 'N/A' },
                    { label: 'FPS', value: spec.fps || 'N/A' },
                    { label: 'Embedded Audio Settings', value: spec.embeddedAudio ? (spec.embeddedAudioDetails || 'Yes') : 'No' },
                    { label: 'Sample Rate', value: spec.sampleRate || 'N/A' },
                    { label: 'Unembedded Audio Format', value: spec.unembeddedAudioFormat || 'N/A' },
                    { label: 'Still Frame Format', value: spec.stillFrameFormat || 'N/A' },
                    { label: 'Naming Structure', value: spec.namingStructure || 'N/A' },
                    { label: 'Example', value: spec.example || '' },
                    { label: 'Comments', value: spec.comments || '' },
                ];

                const emailFromNote = (spec.contentValidationNote || '').match(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}/i)?.[0] || '';
                const validationEmail = (spec.contentValidationEmail || emailFromNote || '').trim();
                if (validationEmail) {
                    const commentsIdx = rows.findIndex(r => r.label === 'Comments');
                    const emailRow = { label: 'Content Validation Email', value: validationEmail };
                    if (commentsIdx >= 0) rows.splice(commentsIdx, 0, emailRow); else rows.push(emailRow);
                }

                const labelW = panelW * 0.32;
                const colonW = panelW * 0.03;
                const valueW = panelW - labelW - colonW;
                const baseFS = Math.max(8, Math.min(16, Number.isFinite(+((state.pdfExport && state.pdfExport.textStyle) || {}).deliveryFS) ? +((state.pdfExport && state.pdfExport.textStyle) || {}).deliveryFS : 12));
                const minFS = 8;
                const rowGap = 0.05;
                const maxCharsValue = (fs) => Math.max(10, Math.floor((valueW * ptPerInch) / (fs * 0.6)));
                const measureDelivery = (fs) => {
                    const lineH = (fs * 1.2) / ptPerInch;
                    let total = 0;
                    rows.forEach(r => {
                        const lines = wrapTextSimple(r.value, maxCharsValue(fs));
                        total += Math.max(1, lines.length) * lineH;
                    });
                    total += (rows.length - 1) * rowGap;
                    return { total, lineH };
                };
                let fs = baseFS;
                let measure = measureDelivery(fs);
                while (fs > minFS && measure.total > panelH) {
                    fs -= 1;
                    measure = measureDelivery(fs);
                }
                let y = panelY + 0.1;
                rows.forEach((r) => {
                    const lines = wrapTextSimple(r.value, maxCharsValue(fs));
                    const rowH = Math.max(1, lines.length) * measure.lineH;
                    if (y + rowH > panelY + panelH) return;
                    deliverySlide.addText(r.label, {
                        x: panelX + 0.05,
                        y,
                        w: labelW,
                        h: rowH,
                        fontSize: fs,
                        color: '000000',
                        align: 'left',
                        valign: 'top',
                    });
                    deliverySlide.addText(':', {
                        x: panelX + labelW,
                        y,
                        w: colonW,
                        h: rowH,
                        fontSize: fs,
                        color: '000000',
                        align: 'center',
                        valign: 'top',
                    });
                    const valueX = panelX + labelW + colonW;
                    const valueWAdj = valueW - 0.05;
                    if ((r.label || '').toLowerCase() === 'content validation email') {
                        deliverySlide.addText(lines.join('\n'), {
                            x: valueX,
                            y,
                            w: valueWAdj,
                            h: rowH,
                            fontSize: fs,
                            color: 'C80000',
                            align: 'left',
                            valign: 'top',
                            hyperlink: { url: `mailto:${r.value}` },
                        });
                    } else {
                        deliverySlide.addText(lines.join('\n'), {
                            x: valueX,
                            y,
                            w: valueWAdj,
                            h: rowH,
                            fontSize: fs,
                            color: '000000',
                            align: 'left',
                            valign: 'top',
                        });
                    }
                    y += rowH + rowGap;
                });
                pageIndex += 1;
                addTitleBlock(deliverySlide, pageIndex, totalPages);

                const safeOut = (state.pdfExport.outputFileName || `${projectForPdf.name}_PixelMaps_Export`).replace(/[^A-Za-z0-9_\-]/g, '_');
                await pptx.writeFile({ fileName: `${safeOut}.pptx` });
                showNotification('PPTX generated successfully!');
            } catch (err) {
                console.error('PPTX generation error', err);
                showNotification('Failed to generate PPTX: ' + (err && err.message ? err.message : String(err)));
            }
        };


        const applyTheme = (accentColor, textColor) => {
            document.documentElement.style.setProperty('--color-accent', accentColor);
            document.documentElement.style.setProperty('--color-text-base', textColor);
        };

        const clampUiScale = (value) => {
            const numeric = Number(value);
            if (Number.isNaN(numeric)) return 1;
            return Math.min(2, Math.max(0.5, numeric));
        };

        const applyUiScale = (value) => {
            const scale = clampUiScale(value || state.uiScale || 1);
            state.uiScale = scale;
            if (document && document.body) {
                document.body.style.zoom = scale;
            }
            const slider = document.getElementById('app-scale-input');
            if (slider) slider.value = parseFloat((scale * 100).toFixed(1));
            const label = document.getElementById('app-scale-value');
            if (label) label.textContent = `${parseFloat((scale * 100).toFixed(1))}%`;
            try { localStorage.setItem('pixellogic-ui-scale', String(scale)); } catch (_) { /* ignore */ }
        };

        const loadGoogleFont = (family) => {
            try {
                const href = `https://fonts.googleapis.com/css2?family=${family}:wght@400;600;700;900&display=swap`;
                if (!document.querySelector(`link[href="${href}"]`)) {
                    const link = document.createElement('link');
                    link.rel = 'stylesheet';
                    link.href = href;
                    document.head.appendChild(link);
                }
            } catch (e) { /* best-effort */ }
        };

        const showInputModal = (title, currentValue, callback, isNewProject = false) => {
            const fieldsContainer = document.getElementById('input-modal-fields');
            fieldsContainer.innerHTML = ''; // Clear previous fields

            if (typeof currentValue === 'object' && currentValue !== null) {
                inputModalIsObject = true;
                // Multi-field for project details (now includes client and venue)
                fieldsContainer.innerHTML = `
                    <div><label class="text-sm text-gray-400">Project Name</label>
                        <input type="text" id="input-modal-field-name" value="${currentValue.name}" placeholder="e.g., Summer Festival 2025" class="w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2 mt-1">
                    </div>
                    <div><label class="text-sm text-gray-400">Location (Optional)</label>
                        <input type="text" id="input-modal-field-location" value="${currentValue.location || ''}" placeholder="e.g., New York, NY" class="w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2 mt-1">
                    </div>
                    <div><label class="text-sm text-gray-400">Salesperson (Optional)</label>
                        <input type="text" id="input-modal-field-salesperson" value="${currentValue.salesperson || ''}" placeholder="e.g., Jane Doe" class="w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2 mt-1">
                    </div>
                    <div><label class="text-sm text-gray-400">Client (Optional)</label>
                        <input type="text" id="input-modal-field-client" value="${currentValue.client || ''}" placeholder="e.g., Client Name" class="w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2 mt-1">
                    </div>
                    <div><label class="text-sm text-gray-400">Venue (Optional)</label>
                        <input type="text" id="input-modal-field-venue" value="${currentValue.venue || ''}" placeholder="e.g., Madison Square Garden" class="w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2 mt-1">
                    </div>
                `;
            } else {
                inputModalIsObject = false;
                // Single field for map/canvas name
                fieldsContainer.innerHTML = `<input type="text" id="input-modal-field" value="${escapeHtml(currentValue)}" class="w-full bg-gray-900 border border-gray-600 rounded-lg px-3 py-2">`;
            }

            const modal = document.getElementById('input-modal');
            document.getElementById('input-modal-title').textContent = title;
            const saveButton = document.getElementById('input-modal-save');
            saveButton.textContent = isNewProject ? 'Create Project' : 'Save';

            inputModalCallback = callback;
            modal.style.display = 'flex';

            const firstInput = fieldsContainer.querySelector('input');
            if (firstInput) {
                firstInput.focus();
                firstInput.select();
                firstInput.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        const btn = document.getElementById('input-modal-save');
                        if (btn) btn.click();
                    }
                });
            }
        };

        const hideInputModal = () => {
            document.getElementById('input-modal').style.display = 'none';
        };

        
        const initAboutSocialSprite = () => {
            const links = Array.from(document.querySelectorAll('.about-social-link[data-sprite-index]'));
            if (!links.length) return;
            const spriteUrl = 'external-files/social-logos.png';
            const img = new Image();
            img.onload = () => {
                const spriteW = img.naturalWidth || 0;
                const spriteH = img.naturalHeight || 0;
                if (!spriteW || !spriteH) return;

                const maxIndex = Math.max(...links.map(el => Number(el.dataset.spriteIndex || 0)));
                const tiles = Math.max(1, maxIndex + 1);
                const tileW = spriteW / tiles;
                const tileH = spriteH;

                const canvas = document.createElement('canvas');
                canvas.width = spriteW;
                canvas.height = spriteH;
                const ctx = canvas.getContext('2d', { willReadFrequently: true });
                if (!ctx) return;
                ctx.drawImage(img, 0, 0);

                const getTileCenter = (idx) => {
                    const sx = Math.round(idx * tileW);
                    const sw = Math.round(tileW);
                    const sh = Math.round(tileH);
                    let minX = sw, minY = sh, maxX = 0, maxY = 0;
                    let found = false;
                    try {
                        const data = ctx.getImageData(sx, 0, sw, sh).data;
                        for (let y = 0; y < sh; y++) {
                            for (let x = 0; x < sw; x++) {
                                const i = (y * sw + x) * 4;
                                const a = data[i + 3];
                                if (a > 10) {
                                    found = true;
                                    if (x < minX) minX = x;
                                    if (y < minY) minY = y;
                                    if (x > maxX) maxX = x;
                                    if (y > maxY) maxY = y;
                                }
                            }
                        }
                    } catch (_) {}
                    if (!found) {
                        return { cx: sw / 2, cy: sh / 2 };
                    }
                    return { cx: (minX + maxX) / 2, cy: (minY + maxY) / 2 };
                };

                links.forEach((el) => {
                    const idx = Number(el.dataset.spriteIndex || 0);
                    const rect = el.getBoundingClientRect();
                    const targetW = rect && rect.width ? rect.width : 64;
                    const targetH = rect && rect.height ? rect.height : 64;
                    const scale = targetH / spriteH;
                    const scaledW = spriteW * scale;
                    const scaledH = spriteH * scale;
                    const tileOriginX = tileW * idx;
                    const { cx, cy } = getTileCenter(idx);
                    const bgPosX = (targetW / 2) - ((tileOriginX + cx) * scale);
                    const bgPosY = (targetH / 2) - (cy * scale);
                    el.style.backgroundSize = `${scaledW}px ${scaledH}px`;
                    el.style.backgroundPosition = `${bgPosX}px ${bgPosY}px`;
                });
            };
            img.src = spriteUrl;
        };

        // --- INITIALIZATION ---
    document.addEventListener('DOMContentLoaded', () => {
        window.createExternalOutputControls({
            notify: showNotification,
            ...PixelLogicExternalEditing.createProjectAdapter({
                getProject: () => state.projects.find(p => String(p.id) === String(state.activeProjectId)),
                calculateLayout, syncMap: syncCanvasMapSource, normalizeOutput: ensureOutputMapRegions,
                save: () => persistProjects(true),
                changed: () => { if (document.getElementById('main-canvas')) drawMainCanvas(); },
                validateFrame: frame => PixelLogicExternalRenderer.validateFrame(frame, calculateLayout),
                placement: PixelLogicExternalRenderer.placement,
                newId: (() => {
                    let lastId = 0;
                    return () => {
                        const used = new Set(state.projects.flatMap(project => [
                            project.id, ...(project.pixelMaps || []).map(map => map.id),
                            ...(project.canvases || []).flatMap(output => [
                                output.id, ...(output.regions || []).flatMap(region => [region.id, ...(region.maps || []).map(map => map.id)])
                            ])
                        ]).map(String));
                        lastId = Math.max(Date.now(), lastId + 1);
                        while (used.has(String(lastId))) lastId++;
                        return lastId;
                    };
                })()
            })
        });
            if(window.pdfjsLib) {
                const v = window.pdfjsLib.version || '2.16.105';
                window.pdfjsLib.GlobalWorkerOptions.workerSrc = `https://cdnjs.cloudflare.com/ajax/libs/pdf.js/${v}/pdf.worker.min.js`;
            }

            hydrateSystemFonts();

            initAboutSocialSprite();

            // Load and apply theme
            const savedAccent = localStorage.getItem('pixi-logic-accent-color') || '#6366f1';
            const savedText = localStorage.getItem('pixi-logic-text-color') || '#ffffff';
            // applyTheme controls accent and text color; interface background is controlled by --interface-bg
            applyTheme(savedAccent, savedText);
            // initialize background from savedAccent for backward compatibility (layout color picker used to map to accent)
            const savedBg = localStorage.getItem('pixi-logic-interface-bg') || savedAccent || '#0a0a1a';
            document.documentElement.style.setProperty('--interface-bg', savedBg);
            { const _lp = document.getElementById('layout-color-picker'); if (_lp) _lp.value = savedBg; }
            { const _fp = document.getElementById('font-color-picker'); if (_fp) _fp.value = savedText; }
            const savedFont = localStorage.getItem('pixi-logic-font') || "Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial";
            document.documentElement.style.setProperty('--interface-font', savedFont);
            const fontSelect = document.getElementById('interface-font-select'); if (fontSelect) fontSelect.value = savedFont;
            // Load a Google font where appropriate
            if (savedFont.includes('Roboto')) loadGoogleFont('Roboto');
            else if (savedFont.includes('Montserrat')) loadGoogleFont('Montserrat');
            else if (savedFont.includes('IBM Plex Sans')) loadGoogleFont('IBM+Plex+Sans');
            else if (savedFont.includes('Source Sans Pro')) loadGoogleFont('Source+Sans+Pro');
            else if (savedFont.includes('Fira Sans')) loadGoogleFont('Fira+Sans');

            // Restore previously selected active Effects preset (non-destructive preview selection)
            try {
                const savedActivePreset = localStorage.getItem('pixellogic-active-effects-preset');
                if (savedActivePreset) {
                    if (!state.ui) state.ui = {};
                    state.ui.activeEffectsPresetId = savedActivePreset;
                }
            } catch(_) {}
            const firstPixelMap = createNewPixelMapObject(1);
            Object.assign(firstPixelMap, {
                id: Date.now(), name: formatPixelMapName(1),
                screenWidthValue: 2, screenHeightValue: 2, screenDimensionsUnit: 'm',
                panelWidthMm: 500, panelHeightMm: 500, panelResWidth: 128, panelResHeight: 128,
                details: {
                    ...firstPixelMap.details,
                    info: { ...firstPixelMap.details.info, enabled: true, name: 'Main Stage Center', position: 'top-left', fontSize: 50 },
                }
            });
            const calcs = calculateLayout(firstPixelMap);
            firstPixelMap.panels = Array(calcs.totalPanels || 0).fill(true);

            const firstCanvas = {id: Date.now() + 1, name: formatOutputCanvasName(1), width: 3840, height: 2160, maps: []};

            // Load Devices DB (v2) from localStorage; ignore other versions to avoid cross-impact
            try { loadDevicesFromStorage(); } catch(_) {}

            // Dev workflow: always clear generated pixel maps for a fresh start while iterating
            resetGeneratedPixelMapsForDev();

            // Try to load from localStorage; if not present, seed a sample project
            let loaded = loadProjectsFromStorage();
            if (!loaded) {
                const now = new Date().toISOString();
                const sampleProject = {
                    id: 1,
                    name: 'Project - 01',
                    createdAt: now,
                    savedAt: now,
                    status: 'draft',
                    eventDate: '',
                    eventTime: '',
                    location: 'New York, NY',
                    salesperson: 'Jane Doe',
                    client: 'ACME Corp',
                    venue: '',
                    pixelMaps: [firstPixelMap],
                    activePixelMapId: firstPixelMap.id,
                    canvases: [firstCanvas], 
                    activeCanvasId: firstCanvas.id
                };
                state.projects.push(sampleProject);
                state.activeProjectId = sampleProject.id;
                persistProjects();
            }
            // Normalize legacy default name if loaded from older sessions
            try {
                let renamed = false;
                state.projects.forEach(p => {
                    if (p && typeof p.name === 'string' && p.name === 'Sample Show Project') {
                        p.name = 'Project - 01';
                        renamed = true;
                    }
                    if (p && Array.isArray(p.pixelMaps) && p.pixelMaps.length) {
                        const firstMap = p.pixelMaps[0];
                        if (firstMap && typeof firstMap.name === 'string' && firstMap.name === 'Main Backdrop') {
                            firstMap.name = formatPixelMapName(1);
                            renamed = true;
                        }
                        p.pixelMaps.forEach((m, idx) => {
                            if (!m) return;
                            if (p.name === 'Project - 01' && idx === 0 && typeof m.name === 'string' && m.name === 'Pixel_Map_01') {
                                // keep name but normalize dimensions below
                            }
                            if (m.screenDimensionsUnit === 'm' && Number(m.screenWidthValue) === 8 && Number(m.screenHeightValue) === 4.5) {
                                m.screenWidthValue = 2;
                                m.screenHeightValue = 2;
                                renamed = true;
                            }
                        });
                    }
                    if (p && Array.isArray(p.canvases) && p.canvases.length) {
                        const firstCanvas = p.canvases[0];
                        if (firstCanvas && typeof firstCanvas.name === 'string' && (firstCanvas.name === 'Main Output' || firstCanvas.name === 'Canvas 1')) {
                            firstCanvas.name = formatOutputCanvasName(1);
                            renamed = true;
                        }
                    }
                });
                if (renamed) persistProjects();
            } catch(_) {}
            // Sync PDF Export selection with active project
            state.pdfExport.selectedProjectId = state.activeProjectId || (state.projects[0]?.id ?? null);

            switchTab('designer');

            // --- First-run tutorial prompt ---
            if (window.firstRun && window.tutorialPdf) {
                window.firstRun.check().then(res => {
                    if (res && res.firstRun) {
                        const overlay = document.createElement('div');
                        overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:99999;display:flex;align-items:center;justify-content:center;';
                        overlay.innerHTML = `
                          <div style="background:#1e1e2e;border:1px solid #444;border-radius:12px;padding:32px 36px;max-width:420px;text-align:center;color:#e0e0e0;font-family:Inter,sans-serif;box-shadow:0 8px 32px rgba(0,0,0,0.5);">
                            <h2 style="margin:0 0 12px;font-size:20px;color:#fff;">Welcome to Pixelogic!</h2>
                            <p style="margin:0 0 24px;font-size:14px;line-height:1.5;color:#bbb;">A tutorial PDF is included to help you get started. Would you like to open it now?</p>
                            <div style="display:flex;gap:12px;justify-content:center;">
                              <button id="fr-open-pdf" style="padding:8px 24px;border:none;border-radius:6px;background:#6366f1;color:#fff;font-size:14px;cursor:pointer;">Open Tutorial</button>
                              <button id="fr-dismiss" style="padding:8px 24px;border:none;border-radius:6px;background:#333;color:#ccc;font-size:14px;cursor:pointer;">Maybe Later</button>
                            </div>
                          </div>`;
                        document.body.appendChild(overlay);
                        overlay.querySelector('#fr-open-pdf').addEventListener('click', () => {
                            window.tutorialPdf.open();
                            overlay.remove();
                        });
                        overlay.querySelector('#fr-dismiss').addEventListener('click', () => overlay.remove());
                        overlay.addEventListener('click', (e) => { if (e.target === overlay) overlay.remove(); });
                    }
                }).catch(() => {});
            }

            // --- Global Event Listeners ---
            navTabs.forEach(tab => tab.addEventListener('click', (e) => switchTab(e.currentTarget.dataset.tab)));
            if (modeSwitch && !forcedAppMode) {
                modeSwitch.addEventListener('change', () => {
                    applyAppMode(modeSwitch.checked ? APP_MODES.projection : APP_MODES.pixel);
                });
            }
            if (editionSwitch) {
                editionSwitch.addEventListener('change', () => {
                    applyAppEdition(editionSwitch.checked ? APP_EDITIONS.advanced : APP_EDITIONS.simple);
                });
            }
            initAppEdition();
            initAppMode();

            // Keydown listener for canvas actions
            document.addEventListener('keydown', (e) => {
                if (state.activeTab !== 'canvas') return;
                const t = e.target;
                const tag = t && t.tagName ? t.tagName.toLowerCase() : '';
                const isEditable = !!(t && (t.isContentEditable || tag === 'input' || tag === 'textarea' || tag === 'select'));
                if (isEditable) return;

                const selIds = Array.isArray(state.canvasState.selectedMapIds) ? state.canvasState.selectedMapIds : [];
                const hasSelection = selIds.length > 0 || state.canvasState.selectedMapId != null;
                if (e.key === 'Escape' && (state.canvasState.maskMode || state.canvasState.maskDrawing || state.canvasState.selectedMaskId)) {
                    state.canvasState.maskMode = null;
                    state.canvasState.maskDrawing = false;
                    state.canvasState.maskPreview = null;
                    state.canvasState.maskPolygonPoints = [];
                    state.canvasState.maskDragging = false;
                    state.canvasState.maskResizing = false;
                    state.canvasState.selectedMaskId = null;
                    if (typeof updateMaskModeButtons === 'function') updateMaskModeButtons();
                    syncSelectedMaskProperties();
                    if (typeof updateMaskList === 'function') updateMaskList();
                    if (typeof drawMainCanvas === 'function') drawMainCanvas();
                    return;
                }
                if ((e.key === 'Delete' || e.key === 'Backspace') && state.canvasState.selectedMaskId) {
                    e.preventDefault();
                    const ac = getActiveCanvas();
                    if (ac && Array.isArray(ac.masks)) {
                        const idx = ac.masks.findIndex(m => String(m.id) === String(state.canvasState.selectedMaskId));
                        if (idx >= 0) {
                            ac.masks.splice(idx, 1);
                            state.canvasState.selectedMaskId = null;
                            state.canvasState.maskMode = null;
                            state.canvasState.maskDrawing = false;
                            state.canvasState.maskPreview = null;
                            state.canvasState.maskStart = null;
                            state.canvasState.maskDragging = false;
                            state.canvasState.maskResizing = false;
                            if (typeof updateMaskModeButtons === 'function') updateMaskModeButtons();
                            syncSelectedMaskProperties();
                            if (typeof updateMaskList === 'function') updateMaskList();
                            if (typeof drawMainCanvas === 'function') drawMainCanvas();
                            if (typeof saveState === 'function') saveState();
                            const delBtn = document.getElementById('mask-delete-btn');
                            if (delBtn) delBtn.disabled = true;
                        }
                    }
                    return;
                }
                if ((e.key === 'Delete' || e.key === 'Backspace') && hasSelection) {
                    deleteSelectedMapFromCanvas();
                    return;
                }

                const key = String(e.key || '').toLowerCase();
                const mod = e.ctrlKey || e.metaKey;
                if (mod && key === 'z' && !e.shiftKey) {
                    e.preventDefault();
                    undoCanvasMapDelete();
                    return;
                }
                if (mod && (key === 'y' || (key === 'z' && e.shiftKey))) {
                    e.preventDefault();
                    redoCanvasMapDelete();
                    return;
                }
            });

            // About Modal Listeners
            const aboutBtn = document.getElementById('about-btn');
            const aboutModal = document.getElementById('about-modal');
            const closeModalBtn = document.getElementById('close-about-modal');
            // Help Modal Listeners
            const helpBtn = document.getElementById('help-btn');
            const helpModal = document.getElementById('help-modal');
            const closeHelpBtn = document.getElementById('close-help-modal');
            const layoutColorPicker = document.getElementById('layout-color-picker');
            const fontColorPicker = document.getElementById('font-color-picker');
            const interfaceFontSelect = document.getElementById('interface-font-select');
            const appScaleInput = document.getElementById('app-scale-input');
            const appScaleResetButton = document.getElementById('app-scale-reset');

            applyUiScale(state.uiScale);

            if (appScaleInput) {
                const commitScale = () => {
                    const v = parseFloat(appScaleInput.value);
                    if (!isNaN(v) && v >= 50 && v <= 200) {
                        applyUiScale(v / 100);
                    } else {
                        appScaleInput.value = parseFloat((state.uiScale * 100).toFixed(1));
                    }
                };
                appScaleInput.addEventListener('change', commitScale);
                appScaleInput.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter') { commitScale(); appScaleInput.blur(); }
                    if (e.key === 'Escape') { appScaleInput.value = parseFloat((state.uiScale * 100).toFixed(1)); appScaleInput.blur(); }
                });
                appScaleInput.addEventListener('focus', () => appScaleInput.select());
            }
            if (appScaleResetButton) {
                appScaleResetButton.addEventListener('click', (e) => {
                    e.preventDefault();
                    applyUiScale(1);
                    if (appScaleInput) appScaleInput.focus();
                });
            }

                // Focus management for modal
                let lastFocusedElement = null;
                const focusableSelectors = 'a[href], area[href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), button:not([disabled]), [tabindex]:not([tabindex="-1"])';

                const trapFocus = (container) => {
                    const focusable = Array.from(container.querySelectorAll(focusableSelectors)).filter(el => el.offsetParent !== null);
                    if (focusable.length === 0) return null;
                    const first = focusable[0];
                    const last = focusable[focusable.length - 1];
                    const handler = (e) => {
                        if (e.key === 'Tab') {
                            if (e.shiftKey) {
                                if (document.activeElement === first) { e.preventDefault(); last.focus(); }
                            } else {
                                if (document.activeElement === last) { e.preventDefault(); first.focus(); }
                            }
                        } else if (e.key === 'Escape') {
                            closeAboutModal();
                        }
                    };
                    document.addEventListener('keydown', handler);
                    return () => document.removeEventListener('keydown', handler);
                };

                let releaseFocusTrap = null;
                const openAboutModal = () => {
                    lastFocusedElement = document.activeElement;
                    aboutModal.classList.remove('hidden');
                    aboutModal.setAttribute('aria-hidden', 'false');
                    aboutBtn.setAttribute('aria-expanded', 'true');
                    // delay focus to first focusable element inside the dialog
                    setTimeout(() => {
                        const dialog = aboutModal.querySelector('[role="dialog"]');
                        if (dialog) {
                            const firstFocusable = dialog.querySelector(focusableSelectors);
                            if (firstFocusable) firstFocusable.focus();
                        }
                        releaseFocusTrap = trapFocus(aboutModal);
                    }, 10);
                };

                const closeAboutModal = () => {
                    aboutModal.classList.add('hidden');
                    aboutModal.setAttribute('aria-hidden', 'true');
                    aboutBtn.setAttribute('aria-expanded', 'false');
                    if (typeof releaseFocusTrap === 'function') { releaseFocusTrap(); releaseFocusTrap = null; }
                    if (lastFocusedElement && lastFocusedElement.focus) lastFocusedElement.focus();
                };

                // Help modal open/close using same focus trap utilities
                const openHelpModal = () => {
                    if (!helpModal) return;
                    lastFocusedElement = document.activeElement;
                    helpModal.classList.remove('hidden');
                    helpModal.setAttribute('aria-hidden', 'false');
                    if (helpBtn) helpBtn.setAttribute('aria-expanded', 'true');
                    setTimeout(() => {
                        const dialog = helpModal.querySelector('[role="dialog"]');
                        if (dialog) {
                            const firstFocusable = dialog.querySelector(focusableSelectors);
                            if (firstFocusable) firstFocusable.focus();
                        }
                        releaseFocusTrap = trapFocus(helpModal);
                    }, 10);
                };
                const closeHelpModal = () => {
                    if (!helpModal) return;
                    helpModal.classList.add('hidden');
                    helpModal.setAttribute('aria-hidden', 'true');
                    if (helpBtn) helpBtn.setAttribute('aria-expanded', 'false');
                    if (typeof releaseFocusTrap === 'function') { releaseFocusTrap(); releaseFocusTrap = null; }
                    if (lastFocusedElement && lastFocusedElement.focus) lastFocusedElement.focus();
                };

                aboutBtn.addEventListener('click', openAboutModal);
                closeModalBtn.addEventListener('click', closeAboutModal);
                // clicking backdrop closes
                const aboutBackdrop = document.querySelector('[data-about-backdrop]');
                if (aboutBackdrop) aboutBackdrop.addEventListener('click', closeAboutModal);

                if (helpBtn) helpBtn.addEventListener('click', openHelpModal);
                if (closeHelpBtn) closeHelpBtn.addEventListener('click', closeHelpModal);
                const helpBackdrop = document.querySelector('[data-help-backdrop]');
                if (helpBackdrop) helpBackdrop.addEventListener('click', closeHelpModal);

                // ensure Escape key closes when focus not trapped
                document.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape') {
                        if (aboutModal && !aboutModal.classList.contains('hidden')) closeAboutModal();
                        if (helpModal && !helpModal.classList.contains('hidden')) closeHelpModal();
                    }
                });

                aboutModal.addEventListener('click', (e) => {
                    // close only when clicking outside the dialog box (backdrop area)
                    const dialog = aboutModal.querySelector('[role="dialog"]');
                    if (dialog && !dialog.contains(e.target) && !e.target.closest('[role="dialog"]')) closeAboutModal();
                });
                if (helpModal) helpModal.addEventListener('click', (e) => {
                    const dialog = helpModal.querySelector('[role="dialog"]');
                    if (dialog && !dialog.contains(e.target) && !e.target.closest('[role="dialog"]')) closeHelpModal();
                });

                // About modal Help button removed

                if (layoutColorPicker) layoutColorPicker.addEventListener('input', (e) => {
                    // Use layout color picker to set interface background (not font color)
                    document.documentElement.style.setProperty('--interface-bg', e.target.value);
                    // persist to dedicated interface bg key
                    localStorage.setItem('pixi-logic-interface-bg', e.target.value);
                });
             if (fontColorPicker) fontColorPicker.addEventListener('input', (e) => {
                applyTheme(localStorage.getItem('pixi-logic-accent-color') || '#6366f1', e.target.value);
                localStorage.setItem('pixi-logic-text-color', e.target.value);
            });
            if (interfaceFontSelect) interfaceFontSelect.addEventListener('change', (e) => {
                const val = e.target.value;
                document.documentElement.style.setProperty('--interface-font', val);
                localStorage.setItem('pixi-logic-font', val);
                // Try to load matching Google font families where applicable (best-effort)
                if (val.includes('Roboto')) loadGoogleFont('Roboto');
                else if (val.includes('Montserrat')) loadGoogleFont('Montserrat');
                else if (val.includes('IBM Plex Sans')) loadGoogleFont('ISans');
                else if (val.includes('Source Sans Pro')) loadGoogleFont('Source+Sans+Pro');
                else if (val.includes('Fira Sans')) loadGoogleFont('Fira+Sans');
            });
            // Theme mode handlers
            const applyThemeMode = (mode) => {
                const root = document.documentElement;
                root.classList.remove('theme-dark','theme-light','theme-invert');
                const savedAccent = localStorage.getItem('pixi-logic-accent-color') || '#6366f1';
                const savedText = localStorage.getItem('pixi-logic-text-color') || '#ffffff';
                if (mode === 'dark') {
                    root.classList.add('theme-dark');
                    root.style.setProperty('--color-accent', savedAccent);
                    root.style.setProperty('--color-text-base', savedText);
                    const savedBg = localStorage.getItem('pixi-logic-interface-bg') || '#0a0a1a';
                    root.style.setProperty('--interface-bg', savedBg);
                } else if (mode === 'light') {
                    root.classList.add('theme-light');
                    root.style.setProperty('--color-accent', savedAccent);
                    root.style.setProperty('--color-text-base', '#0b1220');
                    root.style.setProperty('--interface-bg', '#f8fafc');
                } else if (mode === 'invert') {
                    root.classList.add('theme-invert');
                    root.style.setProperty('--color-accent', '#ffffff');
                    root.style.setProperty('--color-text-base', '#000000');
                    root.style.setProperty('--interface-bg', '#ffffff');
                }
                localStorage.setItem('pixi-logic-theme-mode', mode);
            };

            const renderHeaderSocialLinks = () => {
                const container = document.getElementById('header-social-links');
                if (!container) return;
                container.innerHTML = '';
                // Website
                const a0 = document.createElement('a'); a0.href = AUTHOR_WEBSITE; a0.target = '_blank'; a0.rel = 'noreferrer noopener'; a0.title = 'www.pixelogic.co.in';
                a0.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`;
                container.appendChild(a0);
                // Instagram
                const a1 = document.createElement('a'); a1.href = AUTHOR_INSTAGRAM; a1.target = '_blank'; a1.rel = 'noreferrer noopener'; a1.title = 'Instagram';
                a1.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-pink-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>`;
                container.appendChild(a1);
                // LinkedIn
                const a2 = document.createElement('a'); a2.href = AUTHOR_LINKEDIN; a2.target = '_blank'; a2.rel = 'noreferrer noopener'; a2.title = 'LinkedIn';
                a2.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-blue-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 8a6 6 0 0 1 6 6v6h-4v-6a2 2 0 0 0-2-2c-1.657 0-3 1.343-3 3v5h-4v-11h4v2.2c.9-1.6 2.7-2.7 4.6-2.7z"/></svg>`;
                container.appendChild(a2);
            };
            

            { const _td = document.getElementById('theme-dark'); if (_td) _td.addEventListener('click', () => applyThemeMode('dark')); }
            { const _tl = document.getElementById('theme-light'); if (_tl) _tl.addEventListener('click', () => applyThemeMode('light')); }
            { const _ti = document.getElementById('theme-invert'); if (_ti) _ti.addEventListener('click', () => applyThemeMode('invert')); }

            // Social links are fixed; no save handler required

            // Backup & Restore now lives in Projects tab (renderShows binds listeners per render)

            // Render fixed social links in header
            renderHeaderSocialLinks();
            // Bind quick theme swatches in header
            try {
                const container = document.getElementById('header-theme-swatches');
                if (container) {
                    const updatePerformanceBadge = () => {
                        const el = document.getElementById('header-performance-status');
                        if (!el) return;
                        const mode = (localStorage.getItem('pixi-logic-performance-mode') || '').toLowerCase();
                        if (mode === 'lite') {
                            el.textContent = 'Lite';
                            el.classList.remove('hidden');
                        } else {
                            el.classList.add('hidden');
                        }
                    };
                    container.querySelectorAll('button[data-accent]').forEach(btn => {
                        btn.addEventListener('click', () => {
                            const accent = btn.getAttribute('data-accent') || '#6366f1';
                            const bg = btn.getAttribute('data-bg') || '#0a0a1a';
                            applyTheme(accent, localStorage.getItem('pixi-logic-text-color') || '#ffffff');
                            document.documentElement.style.setProperty('--interface-bg', bg);
                            try {
                                localStorage.setItem('pixi-logic-accent-color', accent);
                                localStorage.setItem('pixi-logic-interface-bg', bg);
                                const lp = document.getElementById('layout-color-picker'); if (lp) lp.value = bg;
                            } catch(_) {}
                        });
                    });
                    const darkBtn = document.getElementById('header-theme-dark');
                    const lightBtn = document.getElementById('header-theme-light');
                    if (darkBtn) darkBtn.addEventListener('click', () => applyThemeMode('dark'));
                    if (lightBtn) lightBtn.addEventListener('click', () => applyThemeMode('light'));
                    // Initialize badge state on start
                    updatePerformanceBadge();
                }
            } catch(_) {}
            const savedMode = localStorage.getItem('pixi-logic-theme-mode') || 'dark'; applyThemeMode(savedMode);
            
            // Input modal buttons wiring
            const modalSaveBtn = document.getElementById('input-modal-save');
            const modalCancelBtn = document.getElementById('input-modal-cancel');
            if (modalCancelBtn) modalCancelBtn.addEventListener('click', hideInputModal);
            if (modalSaveBtn) modalSaveBtn.addEventListener('click', () => {
                try {
                    if (typeof inputModalCallback !== 'function') { hideInputModal(); return; }
                    if (inputModalIsObject) {
                        const values = {
                            name: (document.getElementById('input-modal-field-name')?.value || '').trim(),
                            location: (document.getElementById('input-modal-field-location')?.value || '').trim(),
                            salesperson: (document.getElementById('input-modal-field-salesperson')?.value || '').trim(),
                            client: (document.getElementById('input-modal-field-client')?.value || '').trim(),
                            venue: (document.getElementById('input-modal-field-venue')?.value || '').trim(),
                        };
                        inputModalCallback(values);
                    } else {
                        const value = (document.getElementById('input-modal-field')?.value || '').trim();
                        inputModalCallback(value);
                    }
                } finally {
                    hideInputModal();
                    inputModalCallback = null;
                }
            });

            // Global delegated handler as a safety net for Rename buttons (Shows only)
            document.body.addEventListener('click', (e) => {
                const showsBtn = e.target.closest('.shows-rename');
                if (showsBtn) {
                    const id = parseInt(showsBtn.getAttribute('data-id'));
                    const proj = (state.projects || []).find(p => p.id === id);
                    if (proj) openRenameProjectModal(proj);
                    return;
                }
            });

            // Close rename modal on Escape or click outside
            const renameModal = document.getElementById('rename-project-modal');
            if (renameModal) {
                document.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape' && renameModal.style.display === 'flex') {
                        renameModal.style.display = 'none';
                    }
                });
                renameModal.addEventListener('click', (e) => {
                    const content = renameModal.querySelector('.bg-gray-800.rounded-xl');
                    if (content && !content.contains(e.target)) {
                        renameModal.style.display = 'none';
                    }
                });
            }

            // Global responsive fitting: keep all previews visible on window resize
            let _resizeTimer = null;
            const doGlobalFit = () => {
                try {
                    // Designer preview
                    const designerWrapper = document.getElementById('designer-preview-wrapper');
                    if (designerWrapper) {
                        try { fitDesignerPreviewToScreen(false, true); } catch (_) {}
                    }
                    // Visualizer
                    const visualWrapper = document.getElementById('visualizer-wrapper');
                    if (visualWrapper) {
                        try { fitVisualizerToScreen(true); } catch (_) {}
                    }
                    // Effects live preview
                    const effectsViewport = document.getElementById('effects-preview-viewport');
                    const effectsCanvas = document.getElementById('effects-preview-canvas');
                    const effectsWrapper = document.getElementById('effects-preview-wrapper');
                    const effectsLabel = document.getElementById('effects-zoom-label');
                    if (effectsViewport && effectsCanvas && effectsWrapper) {
                        const vw = effectsViewport.clientWidth;
                        const vh = effectsViewport.clientHeight;
                        const cw = effectsCanvas.clientWidth || effectsCanvas.width || 1;
                        const ch = effectsCanvas.clientHeight || effectsCanvas.height || 1;
                        const fitScale = Math.max(0.1, Math.min(8, Math.min(vw / cw, vh / ch)));
                        try { state.ui = state.ui || {}; state.ui.effectsPreviewScale = fitScale; saveState(); } catch(_) {}
                        effectsWrapper.style.transform = `scale(${fitScale})`;
                        if (effectsLabel) effectsLabel.textContent = `${Math.round(fitScale * 100)}%`;
                    }
                    // Output Canvas
                    const mainCanvasWrap = document.getElementById('main-canvas-wrapper');
                    if (mainCanvasWrap) {
                        try { fitCanvasToScreen(); } catch (_) {}
                    }
                } catch(_) {}
            };
            window.addEventListener('resize', () => {
                if (_resizeTimer) clearTimeout(_resizeTimer);
                _resizeTimer = setTimeout(doGlobalFit, 150);
            });
            // When app regains focus, ensure Projects tab is unlocked (addresses freeze that clears after tab switch)
            window.addEventListener('focus', () => {
                try {
                    if (state && state.activeTab === 'shows' && typeof unlockShowsUi === 'function') {
                        unlockShowsUi();
                        setTimeout(unlockShowsUi, 50);
                    }
                } catch(_) {}
            });
            // Also on visibility change
            document.addEventListener('visibilitychange', () => {
                try {
                    if (document.visibilityState === 'visible' && state && state.activeTab === 'shows' && typeof unlockShowsUi === 'function') {
                        unlockShowsUi();
                        setTimeout(unlockShowsUi, 50);
                    }
                } catch(_) {}
            });
            
        });
    </script>
        <script>
            // Lightweight anti-inspect and anti-copy deterrents (not bulletproof)
            (function () {
                const ENABLE_PROTECTION = false; // disabled
                if (!ENABLE_PROTECTION) return;

                // Disable right-click context menu
                document.addEventListener('contextmenu', (e) => {
                    e.preventDefault();
                }, { capture: true });

                // Block common shortcut combos (View Source, DevTools, Save, Print)
                // Allow normal browser shortcuts; do not block DevTools or printing
                // (previously prevented F12/Ctrl+Shift+I/C/etc. which could interfere in Chrome)

                // Heuristic DevTools detection: if opened, blur UI temporarily
                let devtoolsOpen = false;
                const overlay = document.createElement('div');
                overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.6);backdrop-filter:blur(3px);z-index:99999;display:none;color:#fff;align-items:center;justify-content:center;font:600 16px Inter,system-ui;';
                overlay.textContent = 'Protected Mode: Developer Tools detected';
                document.body.appendChild(overlay);

                const checkDevtools = () => {
                    // Disable heuristic overlay to prevent accidental UI blackout
                    const threshold = Number.MAX_SAFE_INTEGER;
                    const widthDiff = Math.abs(window.outerWidth - window.innerWidth);
                    const heightDiff = Math.abs(window.outerHeight - window.innerHeight);
                    const suspected = widthDiff > threshold || heightDiff > threshold;
                    if (suspected !== devtoolsOpen) {
                        devtoolsOpen = false;
                        overlay.style.display = 'none';
                    }
                };
                setInterval(checkDevtools, 1000);
            })();
        </script>
</div>

