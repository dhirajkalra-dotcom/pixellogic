<script>
/* ================================================================
   Pixelogic Tutorial Engine — v4
   CSS-class highlight on element. No getBoundingClientRect.
   Immune to document.body.style.zoom scaling issues.
   ================================================================ */
(function () {
    'use strict';

    /* ================================================================
       MODE-AWARE STEP DEFINITIONS
       Pixelogic tour and Projection Logic tour are separate.
       Active mode is detected at start() time via the mode checkbox.
       ================================================================ */

        /* Pixelogic — 14 steps (Welcome + 12 tabs + Complete) */
    var PIXEL_COLORS = [
        '#6366f1','#6366f1','#10b981','#ec4899','#14b8a6','#f59e0b','#f43f5e','#0ea5e9',
        '#22d3ee','#8b5cf6','#10b981','#06b6d4','#ef4444','#f97316','#d97706','#64748b','#6366f1'
    ];
    var PIXEL_STEPS = [
        {
            title: 'Welcome to Pixelogic Pro!',
            desc: 'This guided tour walks you through every tool in Pixelogic. From spreadsheet project scheduling and 8 architectural CAD engineering drawings, to precision pixel mapping, 3D venue staging, 24-path LED patching, and vector PDF/PPTX delivery reports. Use Next / Back or arrow keys. Press Esc to exit anytime.',
            items: [], target: null, tab: null
        },
        {
            title: 'Projects & Drafts Hub',
            desc: 'Your central project management hub. Create, edit, and organize project specifications before designing.',
            items: [
                { label: 'Create Project', text: 'Name your project and hit Create — default pixel maps and output canvases are generated automatically.' },
                { label: 'Project Metadata', text: 'Define Date, Time, Location, Venue, and Salesperson for accurate title blocks across all sheets.' },
                { label: 'In-Place Save & Auto-Save', text: 'Save keeps projects open in the editor. Auto-save runs automatically every 3 minutes (toggleable).' },
                { label: 'Backup & Restore', text: 'Export all projects or active projects as JSON. Import, merge, or restore without data loss.' }
            ],
            target: '.nav-tab[data-tab="shows"]', tab: 'shows'
        },
        {
            title: 'LED Master Sheets & CAD Drawings ★ NEW',
            desc: 'Live-synced spreadsheet schedule, 30+ brand LED catalog database, and 8 architectural CAD engineering blueprints.',
            items: [
                { label: 'Project Schedule (Excel Grid)', text: 'Live spreadsheet view of all project screens with tile counts, physical dimensions (m/ft), aspect ratios, total pixel resolutions, power loads (kW/Amps), and weight estimates.' },
                { label: 'LED Catalog Database', text: 'Extensive technical database of 30+ brands (Absen, Unilumin, ROE Visual, Infiled, Gloshine, CreateLED, Dicolor, etc.) with cabinet dimensions, pitch, and electrical specs, plus custom model authoring.' },
                { label: '8 Vector CAD Sheets', text: '1 Dimensions (Front/Side/Bottom/Iso), 2 Raster Map, 3 Data Wiring, 4 Power Wiring, 5 System Diagram, 6 Weight Estimate, 7 Heat Load (BTU), and 8 Bill of Materials.' },
                { label: 'Publish All Screens PDF', text: 'One-click export generates a continuous multi-page master engineering package containing all screens and all 8 sheets.' },
                { label: 'Company Logo & Paper Sizes', text: 'Upload your company logo into the CAD Title Block. Switch page sizes dynamically: A3 (Standard CAD), A4 (Office), A2, A1 (Blueprint), A5, Letter, and Tabloid.' }
            ],
            target: '.nav-tab[data-tab="sheets"]', tab: 'sheets'
        },
        {
            title: 'Pixel Designer & Shapes Geometry',
            desc: 'The core LED canvas tool. Build, dimension, and style pixel maps with live millimeter and pixel feedback.',
            items: [
                { label: 'Two-Way Sizing', text: 'Enter physical Width/Height in meters, cm, mm, ft, or in to update tiles, or edit tile counts to recalculate dimensions.' },
                { label: '7 Parametric Shapes', text: 'Instantly build Circle, Ellipse/Oval, Triangle, Diamond, Hexagon, Cross/Plus, or Custom walls. Outer panels disable automatically.' },
                { label: 'Click-to-Paint Panels', text: 'Click tiles in the Live Preview to toggle them on/off — draw logos, letters, archways, or irregular stage shapes.' },
                { label: 'Circle by Single Value', text: 'Size circular screens by entering Radius, Diameter, or Circumference — remaining dimensions and tile grids auto-calculate.' },
                { label: 'Visual Styling & Numbering', text: 'Gradients (Linear/Radial), 60+ checker palettes (SMPTE, Classic), and panel numbering (A1, B1, Row/Col).' }
            ],
            target: '.nav-tab[data-tab="designer"]', tab: 'designer'
        },
        {
            title: 'Map Annotations & Test Patterns',
            desc: 'Overlay engineering data, test patterns, alignment grids, and center badges directly over your pixel maps.',
            items: [
                { label: 'Center Badge with Live Metrics', text: 'Displays physical size, native resolution, total tile count, and reduced/decimal aspect ratios (e.g. 16:9 / 1.78:1).' },
                { label: 'Quick Overlays (One-Click)', text: 'Toggle Coordinates, Center Crosshair, Corner Circles, and L-Markers on or off with sensible defaults.' },
                { label: 'Broadcast Color Bars', text: 'Horizontal or vertical SMPTE, RGBW, and RGB color bars with position and opacity sliders.' },
                { label: 'Canvas Coordinates', text: 'Displays exact (X, Y) top-left canvas coordinates on all previews for multi-screen physical alignment.' }
            ],
            target: '.nav-tab[data-tab="effects"]', tab: 'effects'
        },
        {
            title: '3D Visualizer Pro & Stage Staging',
            desc: 'Realistic 3D perspective viewport of all mapped screens with venue stage platforms and camera recall.',
            items: [
                { label: 'Camera Orbit, Pan & Zoom', text: 'Left-drag to orbit, right-drag to pan, scroll to zoom. Save custom camera angles (FOH, Balcony, Stage Left) for instant recall.' },
                { label: 'Curved Wall Modeling', text: 'Accurately visualizes concave or convex curved LED screens with realistic curvature radii.' },
                { label: 'Stage Deck Builder', text: 'Add stage decks beneath screens. Use "Span to LED Bottom" to match screen width and snap to wall base.' },
                { label: 'Clean Viewport Capture', text: 'Export high-res PNG or JPG snapshots with screen metadata callouts; editor axes and gizmos are automatically hidden.' }
            ],
            target: '.nav-tab[data-tab="view3d"]', tab: 'view3d'
        },
        {
            title: 'Output Maps & Multi-Canvas Workspaces',
            desc: 'Compose pixel maps onto multi-canvas layouts matching processor inputs (4K UHD, 1080p, custom rasters).',
            items: [
                { label: 'Multiple Named Canvases', text: 'Organize complex outputs across multiple named canvases arranged horizontally or vertically.' },
                { label: 'Tile-Snapped Masks', text: 'Draw Rectangle, Ellipse, or Polygon masks that snap directly to cabinet boundaries (hold Shift for free vertex edit).' },
                { label: 'External Display Output', text: 'Extend desktop (Win+P > Extend) and push canvases directly to secondary monitors with 1:1 pixel accuracy, freeze, and blackout.' },
                { label: 'Linked Source Maps', text: 'Designer edits refresh on output canvases without losing custom canvas placement or crops.' }
            ],
            target: '.nav-tab[data-tab="canvas"]', tab: 'canvas'
        },
        {
            title: 'LED Signal & Power Patching Pro',
            desc: 'Plan signal distribution and electrical circuits across arrays with live bandwidth and safety capacity feedback.',
            items: [
                { label: '24 Wiring Path Patterns', text: 'Visual routing: U-Turn Snake, Zig-Zag, Isolated Column/Row from any corner (TL, TR, BL, BR) horizontally or vertically.' },
                { label: 'Port Labels (C1-P1)', text: 'Every signal line and badge displays controller and port designations (e.g. Port 1 [C1-P1], Port 2 [C1-P2]).' },
                { label: 'Cable Legend Bar', text: 'Live interactive bar displaying active cables, tile counts, and port capacities with color-coded swatches.' },
                { label: 'NovaStar & COEX Auto Bandwidth', text: 'Auto-calculates modules per port based on controller model (MX40 Pro, MX6000 Pro, VX16s, COEX, Brompton), link speed, bit depth, and refresh rate.' },
                { label: 'Manual Drawing Dock', text: 'Click or drag across adjacent tiles to draw custom routes. Dock includes Undo, Redo, Next Port, and Clear All.' }
            ],
            target: '.nav-tab[data-tab="led-patching"]', tab: 'led-patching'
        },
        {
            title: 'Professional PDF & PPTX Reporting',
            desc: 'Generate branded, vector-accurate client reports and technical delivery spec sheets in one click.',
            items: [
                { label: 'Two Canvases per Page', text: 'PDF and PPTX exports pair two output canvases per page, keeping documentation compact and readable.' },
                { label: '300 DPI Print-Ready Advanced PDF', text: 'High-res raster artwork capped at 300 DPI with razor-sharp vector title blocks, typography, and line work.' },
                { label: 'Video Delivery Specifications', text: 'Presets for Disguise, Resolume, Watchout, Pixera, Green Hippo, and Playback Pro with codecs, frame rates, and pixel specs.' },
                { label: 'Custom Branding & Title Block', text: 'Full control over project title, date, venue, client, sales contact, revision number, and typography.' }
            ],
            target: '.nav-tab[data-tab="pdf"]', tab: 'pdf'
        },
        {
            title: 'Electrical Power & Phase Load Calculator',
            desc: 'Calculate total power consumption using bench-tested Amperage readings from real LED tiles across 30+ manufacturers.',
            items: [
                { label: 'Real Measured Tile Loads', text: 'Measured amp draws across Full White, Full Red, Full Green, Full Blue, and Standby states at 100% and 50% brightness.' },
                { label: '1-Phase & 3-Phase Balancing', text: 'Splits load evenly across L1, L2, and L3 in 3-phase mode, reporting per-phase current and kVA apparent power at 0.9 PF.' },
                { label: 'Breaker Sizing & 1.25x Safety Factor', text: 'Applies NEC 80% continuous load rules (1.25× multiplier) to recommend exact breaker capacities.' },
                { label: 'Power PDF Export', text: 'Exports a dedicated dark-themed Electrical Load Spec sheet for venue electricians and generator operators.' }
            ],
            target: '.nav-tab[data-tab="power-calc"]', tab: 'power-calc'
        },
        {
            title: 'Misc Tools & Audio/Video Converter',
            desc: 'Essential utility calculators and high-performance video transcoding built directly into PixelLogic.',
            items: [
                { label: 'Aspect Ratio Calculator', text: 'Calculates standard (16:9, 16:10, 4:3, 21:9) and custom aspect ratios across pixels, mm, cm, meters, inches, and feet.' },
                { label: 'SMPTE LTC WAV Generator', text: 'Generates broadcast-grade linear timecode audio tracks (23.976, 24, 25, 29.97ndf, 30 fps) at 44.1 or 48 kHz.' },
                { label: 'ProRes & DNxHD Video Converter', text: 'Batch-converts media to Apple ProRes (422, HQ, 4444), Avid DNxHD, H.264, and H.265 with progress bars and queue controls.' }
            ],
            target: '.nav-tab[data-tab="utility-tools"]', tab: 'utility-tools'
        },
        {
            title: 'Help & Technical Reference',
            desc: 'Complete documentation hub with release highlights, tab-by-tab guide, GPU diagnostics, and printable manual.',
            items: [
                { label: 'Tutorial PDF', text: 'Click "Tutorial PDF" to open the 7-page comprehensive vector engineering manual.' },
                { label: 'Check GPU Diagnostics', text: 'Inspect active desktop GPU, WebGL renderer, and hardware compositing acceleration status.' },
                { label: 'Performance Modes', text: 'Full mode (up to 8.3MP / 4K native preview) vs Lite mode (1MP cap) for smooth editing.' }
            ],
            target: '.nav-tab[data-tab="help"]', tab: 'help'
        },
        {
            title: 'Tour Complete!',
            desc: "You are ready to create! The full PixelLogic workflow is at your fingertips: create project → schedule in Master Sheets → design pixel maps → stage in 3D → compose output canvases → patch LED signal & power → publish CAD blueprints & reports. Revisit the Help tab anytime!",
            items: [], target: null, tab: null
        }
    ];

    /* Projection Logic — 7 steps (Welcome + 4 calculator sub-tabs + Help + Complete) */
    var PROJECTION_COLORS = [
        '#6366f1','#22d3ee','#f59e0b','#10b981','#ec4899','#64748b','#6366f1'
    ];
    var PROJECTION_STEPS = [
        {
            title: 'Welcome to Projection Logic!',
            desc: 'This guided tour walks you through Projection Logic — your projector alignment, test pattern and projection calculator suite. Use Next / Back or arrow keys. Press Esc to exit anytime.',
            items: [], target: null, tab: null
        },
        {
            title: 'Projector Test Pattern',
            desc: 'Generate test patterns, alignment grids and projector identification images. Configure grid details, logos and per-projector settings.',
            items: [
                { label: 'Screen Settings', text: 'Choose native resolution from presets or custom. Set display grid (X\u00d7Y), overlap pixels and percentages, and image name with font size controls.' },
                { label: 'Grid & Colours', text: 'Adjust Grid Size, Line Width, Grid Colour, Text Colour and Overlap Colour. Toggle Circles, Hatching (Cross/Forward/Backward) and Grid Numbers.' },
                { label: 'Logo', text: 'Upload a logo image and control its size with a slider.' },
                { label: 'Projectors', text: 'Set Overlay Opacity, and customise each projector\u2019s Name and Colour individually.' },
                { label: 'Dome Mode', text: 'Enable Circular (Dome) Pattern to unlock the Dome Visualizer with diameter and pixels/m controls.' },
                { label: 'Export', text: 'Save Image, Save PNG, Save All PNGs, or generate a Projector Test Pattern PDF.' }
            ],
            target: '.nav-tab[data-tab="projector-test-pattern"]', tab: 'projector-test-pattern'
        },
        {
            title: 'Flat Screen Calculator',
            desc: 'Compute pixel pitch, resolution, overlap and throw distance for flat projection screens. Inside the Projector Test Pattern tab.',
            items: [
                { label: 'Projector & Screen', text: 'Set projector native resolution, screen width/height in metres, and projector grid count (H\u00d7V).' },
                { label: 'Calculation Modes', text: 'Calculate Ratio (from Distance), Calculate Distance (from Ratio), or Suggest Lens \u2014 Auto Advisor.' },
                { label: 'Blend Zones', text: 'Horizontal and Vertical blend percentages with auto-calc projectors option.' },
                { label: 'Results', text: 'Total Resolution, Calculated Throw, Single Image W/H, Overlap in pixels, Blend Zone (px), Projector Spacing, and Overthrow.' }
            ],
            target: '.nav-tab[data-tab="projector-test-pattern"]', tab: 'projector-test-pattern'
        },
        {
            title: 'Curve Screen Projection',
            desc: 'Compute curve radius, arc length, angle and throw for concave or convex projection screens. Inside the Projector Test Pattern tab.',
            items: [
                { label: 'Curve Setup', text: 'Choose Concave or Convex. Enter Screen Width (Chord), Height and Curve Depth (Sagitta) in metres.' },
                { label: 'Projection Grid', text: 'Projectors Along Arc (H), Rows Vertically (V), Overlap H/V percentages with auto-calc along arc option.' },
                { label: 'Results', text: 'Radius of Curvature, Arc Length, Arc Angle, Grid H\u00d7V, Total Projectors, Pixel Pitch, Throw Distance/Ratio and Canvas size.' }
            ],
            target: '.nav-tab[data-tab="projector-test-pattern"]', tab: 'projector-test-pattern'
        },
        {
            title: 'Circular / Semi-circular Calculator',
            desc: 'Compute pixel pitch, throw and projector requirements for 360\u00b0, 180\u00b0 or custom-arc circular screens. Inside the Projector Test Pattern tab.',
            items: [
                { label: 'Shape', text: 'Circle (360\u00b0), Semi-circle (180\u00b0), or Custom Arc with user-defined angle.' },
                { label: 'Dimensions', text: 'Set Diameter in metres, Screen Height and Projector Resolution.' },
                { label: 'Results', text: 'Pixel Pitch H (arc), Pixel Pitch V plus additional projection metrics.' }
            ],
            target: '.nav-tab[data-tab="projector-test-pattern"]', tab: 'projector-test-pattern'
        },
        {
            title: 'Help',
            desc: 'In-app manual with guides, release notes and performance controls. Available in both Pixelogic and Projection Logic modes.',
            items: [
                { label: 'Documentation', text: 'Tab-by-tab guide with detailed help cards.' },
                { label: 'Check GPU', text: 'Inspect the active desktop GPU and renderer in Help. On Windows, choose High performance for the app in System &gt; Display &gt; Graphics, then restart. Browser mode uses browser-managed graphics.' },
                { label: 'Performance Mode', text: 'For pixel-map previews, Full supports up to 8.3MP and Lite caps at 1MP. These preview controls do not change exported source resolution or project dimensions.' },
                { label: 'Tutorial PDF', text: 'Open the full printable walkthrough.' }
            ],
            target: '.nav-tab[data-tab="help"]', tab: 'help'
        },
        {
            title: 'Tour Complete!',
            desc: "You've seen the full Projection Logic toolkit: test pattern generation, flat/curve/circular projection calculators and the help system. Switch to Pixelogic mode anytime using the toggle at the top of the sidebar to access LED design tools!",
            items: [], target: null, tab: null
        }
    ];

    /* Active step set — selected when tour starts based on current app mode */
    var steps  = PIXEL_STEPS;
    var colors = PIXEL_COLORS;
    var step   = 0;
    var active = false;
    var TOTAL  = steps.length;

    var prevTarget = null;
    var card       = document.getElementById('pl-tutorial-card');
    var accentBar  = document.getElementById('pl-tut-accent-bar');
    var iconEl     = document.getElementById('pl-tut-icon');
    var iconSvg    = document.getElementById('pl-tut-icon-svg');
    var titleEl    = document.getElementById('pl-tut-title');
    var stepLabel  = document.getElementById('pl-tut-step-label');
    var descEl     = document.getElementById('pl-tut-desc');
    var itemsEl    = document.getElementById('pl-tut-items');
    var dotsEl     = document.getElementById('pl-tut-dots');
    var btnPrev    = document.getElementById('pl-tut-prev');
    var btnNext    = document.getElementById('pl-tut-next');
    var btnClose   = document.getElementById('pl-tut-close-btn');

    /* ---- Highlight: add/remove CSS class directly on the target element ---- */
    /* Zero getBoundingClientRect — immune to document.body.style.zoom */
    function clearHighlight() {
        if (prevTarget) {
            prevTarget.classList.remove('pl-tut-target');
            prevTarget.style.borderColor = '';
            prevTarget.style.boxShadow = '';
            prevTarget = null;
        }
    }

    function highlightTarget(selector, color) {
        clearHighlight();
        if (!selector) return null;
        var el = document.querySelector(selector);
        if (!el) return null;
        el.classList.add('pl-tut-target');
        el.style.borderColor = color;
        el.style.boxShadow = '0 0 20px ' + color + '66, inset 0 0 10px ' + color + '14';
        /* Ensure button is scrolled into view within sidebar */
        var sidebar = el.closest('.sidebar-fixed');
        if (sidebar) {
            var elTop = el.offsetTop;
            var elBot = elTop + el.offsetHeight;
            var sTop = sidebar.scrollTop;
            var sBot = sTop + sidebar.clientHeight;
            if (elTop < sTop + 8) sidebar.scrollTop = elTop - 12;
            else if (elBot > sBot - 8) sidebar.scrollTop = elBot - sidebar.clientHeight + 12;
        }
        prevTarget = el;
        return el;
    }

    /* ---- Card position: offsetTop-based, no getBoundingClientRect ---- */
    function positionCard(targetEl) {
        var CW = 348, MARGIN = 12;
        var vw = window.innerWidth, vh = window.innerHeight;
        var ch = card.offsetHeight || 320;
        if (!targetEl) {
            card.style.left = Math.max(MARGIN, (vw - CW) / 2) + 'px';
            card.style.top  = Math.max(MARGIN, (vh - ch) / 2) + 'px';
            return;
        }
        /* Place card to the right of sidebar (content area starts at ~300px) */
        var cardLeft = 316;
        if (cardLeft + CW > vw - MARGIN) cardLeft = Math.max(MARGIN, vw - CW - MARGIN);
        card.style.left = cardLeft + 'px';
        /* Vertically align with the target using offsetTop (no coordinate bugs from zoom) */
        var sidebar = targetEl.closest('.sidebar-fixed');
        var scrollTop = sidebar ? sidebar.scrollTop : 0;
        var btnVisualTop = targetEl.offsetTop - scrollTop;
        var top = Math.max(MARGIN, Math.min(btnVisualTop, vh - ch - MARGIN));
        card.style.top = top + 'px';
    }

    /* ---- Build rich items list ---- */
    function buildItems(items, color) {
        itemsEl.innerHTML = '';
        if (!items || !items.length) return;
        items.forEach(function (it) {
            var row  = document.createElement('div');
            row.className = 'pl-tut-item';
            var dot  = document.createElement('div');
            dot.className = 'pl-tut-item-dot';
            dot.style.background = color;
            var txt  = document.createElement('div');
            txt.className = 'pl-tut-item-text';
            txt.innerHTML = '<strong>' + it.label + '</strong> — ' + it.text;
            row.appendChild(dot);
            row.appendChild(txt);
            itemsEl.appendChild(row);
        });
    }

    /* ---- Build progress dots ---- */
    function buildDots(idx) {
        dotsEl.innerHTML = '';
        for (var i = 0; i < TOTAL; i++) {
            var d = document.createElement('div');
            d.className = 'pl-tut-dot' + (i < idx ? ' pl-dot-done' : i === idx ? ' pl-dot-cur' : '');
            dotsEl.appendChild(d);
        }
    }

    /* ---- Render a step ---- */
    function render(idx) {
        var s     = steps[idx];
        var color = colors[idx] || '#6366f1';

        /* Text content */
        titleEl.textContent  = s.title;
        stepLabel.textContent = 'Step ' + (idx + 1) + ' of ' + TOTAL;
        descEl.textContent   = s.desc;

        /* Color theming */
        accentBar.style.background    = color;
        stepLabel.style.color         = color;
        iconEl.style.background       = color + '28';
        iconSvg.style.color           = color;
        var nextBtn = document.getElementById('pl-tut-next');
        nextBtn.style.background      = color;
        nextBtn.style.borderColor     = color;

        /* Rich items */
        buildItems(s.items, color);

        /* Dots */
        buildDots(idx);

        /* Buttons */
        btnPrev.style.visibility = idx === 0 ? 'hidden' : 'visible';
        nextBtn.innerHTML = idx === TOTAL - 1
            ? 'Finish <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>'
            : 'Next <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>';

        /* Clear previous highlight */
        clearHighlight();

        /* Switch to the correct tab by clicking the nav button */
        if (s.tab) {
            try {
                var navBtn = document.querySelector('.nav-tab[data-tab="' + s.tab + '"]');
                if (navBtn) navBtn.click();
            } catch (_) {}
        }

        /* After paint: apply highlight class + position card */
        requestAnimationFrame(function () {
            requestAnimationFrame(function () {
                var targetEl = highlightTarget(s.target, color);
                positionCard(targetEl);
            });
        });
    }

    function start() {
        /* Detect current app mode and select the right step set */
        var modeSwitch = document.getElementById('app-mode-switch');
        var isProjection = modeSwitch && modeSwitch.checked;
        steps  = isProjection ? PROJECTION_STEPS : PIXEL_STEPS;
        colors = isProjection ? PROJECTION_COLORS : PIXEL_COLORS;
        TOTAL  = steps.length;

        active = true; step = 0;
        card.classList.add('pl-card-visible');
        render(0);
    }

    function end() {
        active = false;
        card.classList.remove('pl-card-visible');
        clearHighlight();
    }

    document.getElementById('pl-tut-next').addEventListener('click', function () {
        if (step >= TOTAL - 1) { end(); return; }
        step++; render(step);
    });
    document.getElementById('pl-tut-prev').addEventListener('click', function () {
        if (step <= 0) return;
        step--; render(step);
    });
    btnClose.addEventListener('click', end);

    document.addEventListener('keydown', function (e) {
        if (!active) return;
        if (e.key === 'Escape') end();
        if (e.key === 'ArrowRight' || e.key === 'Enter') document.getElementById('pl-tut-next').click();
        if (e.key === 'ArrowLeft') document.getElementById('pl-tut-prev').click();
    });

    var _rt;
    window.addEventListener('resize', function () {
        clearTimeout(_rt);
        _rt = setTimeout(function () { if (active) render(step); }, 120);
    });

    window.startPixelLogicTutorial = start;
})();
</script>

<!-- ── Licence / 15-day trial gate ─────────────────────────────────────────── -->
<script>
(function () {
    'use strict';
    if (!window.licensing || typeof window.licensing.status !== 'function') return;

    var SUPPORT_EMAIL = 'dhiraj.kalra@gmail.com';
    var APP_NAME = 'PixelLogic';

    function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }

    function expiryLabel(sec) {
        if (!sec) return '';
        try {
            return new Date(sec * 1000).toLocaleDateString(undefined, {
                year: 'numeric', month: 'long', day: 'numeric',
            });
        } catch (_) { return ''; }
    }

    // Shared activation form markup (machine ID + key + activate button).
    function activationFormHtml(ent) {
        var machine = esc(ent.machineId || '—');
        return ''
            + '<div style="text-align:left;margin-top:8px">'
            + '  <div style="margin-bottom:16px">'
            + '    <div class="pl-lic-label">Your Machine ID</div>'
            + '    <div style="display:flex;gap:8px">'
            + '      <code id="pl-lic-machine" style="flex:1;background:#0b0d10;border:1px solid #2a2d38;border-radius:8px;padding:9px 12px;color:#93c5fd;font-size:13px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.04em;overflow-x:auto;white-space:nowrap">' + machine + '</code>'
            + '      <button type="button" id="pl-lic-copy" class="pl-lic-btn-ghost">Copy</button>'
            + '    </div>'
            + '    <p style="color:rgba(255,255,255,.35);font-size:11px;margin:8px 0 0;line-height:1.5">Send this ID to us and we will issue a licence key locked to this computer.</p>'
            + '  </div>'
            + '  <div style="margin-bottom:12px">'
            + '    <label class="pl-lic-label" for="pl-lic-key">Licence Key</label>'
            + '    <textarea id="pl-lic-key" rows="3" spellcheck="false" placeholder="Paste your licence key here…" style="width:100%;box-sizing:border-box;background:#0b0d10;border:1px solid #2a2d38;border-radius:8px;padding:10px 12px;color:#e2e8f0;font-size:12px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;resize:vertical;outline:none"></textarea>'
            + '  </div>'
            + '  <p id="pl-lic-error" style="color:#fca5a5;font-size:12px;margin:0 0 12px;line-height:1.5;display:none"></p>'
            + '  <button type="button" id="pl-lic-activate" class="pl-lic-btn-primary">Activate Licence</button>'
            + '</div>';
    }

    function wireActivation(root, ent, onActivated) {
        var copyBtn = root.querySelector('#pl-lic-copy');
        var keyEl = root.querySelector('#pl-lic-key');
        var actBtn = root.querySelector('#pl-lic-activate');
        var errEl = root.querySelector('#pl-lic-error');
        var machineEl = root.querySelector('#pl-lic-machine');

        if (copyBtn) {
            copyBtn.addEventListener('click', function () {
                var text = machineEl ? machineEl.textContent : (ent.machineId || '');
                try {
                    navigator.clipboard.writeText(text).then(function () {
                        copyBtn.textContent = 'Copied';
                        setTimeout(function () { copyBtn.textContent = 'Copy'; }, 1500);
                    });
                } catch (_) { /* clipboard unavailable */ }
            });
        }

        function submit() {
            if (!keyEl) return;
            var key = keyEl.value.trim();
            if (!key) return;
            actBtn.disabled = true;
            actBtn.textContent = 'Activating…';
            if (errEl) errEl.style.display = 'none';
            Promise.resolve(window.licensing.activate(key)).then(function (res) {
                actBtn.disabled = false;
                actBtn.textContent = 'Activate Licence';
                if (res && res.ok) {
                    onActivated(res.entitlement);
                } else if (errEl) {
                    errEl.textContent = (res && res.error) || 'Activation failed. Please check your key.';
                    errEl.style.display = 'block';
                }
            }).catch(function () {
                actBtn.disabled = false;
                actBtn.textContent = 'Activate Licence';
                if (errEl) { errEl.textContent = 'Activation failed. Please try again.'; errEl.style.display = 'block'; }
            });
        }

        if (actBtn) actBtn.addEventListener('click', submit);
    }

    function injectStyles() {
        if (document.getElementById('pl-lic-styles')) return;
        var st = document.createElement('style');
        st.id = 'pl-lic-styles';
        st.textContent = ''
            + '.pl-lic-label{display:block;color:rgba(255,255,255,.5);font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;margin-bottom:6px}'
            + '.pl-lic-btn-ghost{display:inline-flex;align-items:center;gap:6px;background:#1f2430;border:1px solid #2a2d38;border-radius:8px;color:#cbd5e1;padding:0 12px;font-size:12px;font-weight:600;cursor:pointer;white-space:nowrap}'
            + '.pl-lic-btn-primary{width:100%;display:inline-flex;align-items:center;justify-content:center;gap:8px;background:#6366f1;color:#fff;padding:11px 22px;border-radius:8px;font-size:14px;font-weight:600;border:none;cursor:pointer}'
            + '.pl-lic-btn-primary:disabled{opacity:.6;cursor:default}'
            + '#pl-lic-banner{position:fixed;top:0;left:0;right:0;height:30px;display:flex;align-items:center;justify-content:space-between;padding:0 14px;font-family:system-ui,-apple-system,Segoe UI,sans-serif;font-size:11px;font-weight:600;letter-spacing:.03em;user-select:none;z-index:2147483000}'
            + '#pl-lic-banner .pl-lic-activate-btn{background:#111;color:#fff;border:none;border-radius:5px;padding:3px 12px;font-size:11px;font-weight:700;cursor:pointer}'
            + '.pl-lic-overlay{position:fixed;inset:0;z-index:2147483600;display:flex;align-items:center;justify-content:center;font-family:system-ui,-apple-system,Segoe UI,sans-serif;padding:20px;overflow-y:auto}'
            + '.pl-lic-card{background:#141823;border:1px solid #2a2d38;border-radius:16px;padding:40px 44px;max-width:520px;width:100%;text-align:center;box-shadow:0 24px 64px rgba(0,0,0,.6)}';
        document.head.appendChild(st);
    }

    var bannerEl = null;
    var overlayEl = null;
    var currentEnt = null;

    function clearUi() {
        if (bannerEl) { bannerEl.remove(); bannerEl = null; }
        if (overlayEl) { overlayEl.remove(); overlayEl = null; }
        document.body.style.paddingTop = '';
    }

    function onActivatedSuccess() {
        clearUi();
        // Reload so the whole app re-initialises in its fully unlocked state.
        window.location.reload();
    }

    function renderBanner(ent) {
        var daysLeft = ent.trial.daysRemaining;
        var urgent = daysLeft <= 7;
        bannerEl = document.createElement('div');
        bannerEl.id = 'pl-lic-banner';
        bannerEl.style.background = urgent ? '#7c1d1d' : '#78350f';
        bannerEl.style.borderBottom = '1px solid ' + (urgent ? '#991b1b' : '#92400e');
        bannerEl.style.color = urgent ? '#fca5a5' : '#fde68a';
        bannerEl.innerHTML = ''
            + '<div style="display:flex;align-items:center;gap:8px">'
            + '  <span style="text-transform:uppercase;letter-spacing:.08em">Demo Version</span>'
            + '  <span style="opacity:.6;font-weight:400">—</span>'
            + '  <span style="font-weight:400">' + ent.trial.trialDays + '-day evaluation, not for production use</span>'
            + '</div>'
            + '<div style="display:flex;align-items:center;gap:10px">'
            + '  <span style="font-weight:400;opacity:.85">Expires ' + esc(expiryLabel(ent.trial.expiresAt)) + '</span>'
            + '  <span style="background:' + (urgent ? '#ef4444' : '#f59e0b') + ';color:#000;padding:1px 8px;border-radius:4px;font-size:10px;font-weight:700">' + daysLeft + 'd left</span>'
            + '  <button type="button" class="pl-lic-activate-btn">Activate</button>'
            + '</div>';
        document.body.appendChild(bannerEl);
        document.body.style.paddingTop = '30px';
        bannerEl.querySelector('.pl-lic-activate-btn').addEventListener('click', function () {
            openActivationModal(ent);
        });
    }

    function openActivationModal(ent) {
        var modal = document.createElement('div');
        modal.className = 'pl-lic-overlay';
        modal.style.background = 'rgba(0,0,0,.6)';
        modal.innerHTML = ''
            + '<div class="pl-lic-card" style="text-align:left;position:relative">'
            + '  <button type="button" id="pl-lic-close" style="position:absolute;top:14px;right:14px;background:transparent;border:none;color:rgba(255,255,255,.4);cursor:pointer;font-size:20px;line-height:1;padding:4px">×</button>'
            + '  <h1 style="color:#f1f5f9;font-size:19px;font-weight:700;margin:0 0 6px">Activate ' + APP_NAME + '</h1>'
            + '  <p style="color:rgba(255,255,255,.45);font-size:13px;line-height:1.6;margin:0 0 18px">Enter your licence key to unlock the app permanently on this machine.</p>'
            + activationFormHtml(ent)
            + '</div>';
        document.body.appendChild(modal);
        modal.addEventListener('click', function (e) { if (e.target === modal) modal.remove(); });
        modal.querySelector('#pl-lic-close').addEventListener('click', function () { modal.remove(); });
        wireActivation(modal, ent, onActivatedSuccess);
    }

    function renderLockScreen(ent) {
        var tampered = ent.trial.tampered;
        var accent = tampered ? '#f97316' : '#ef4444';
        overlayEl = document.createElement('div');
        overlayEl.className = 'pl-lic-overlay';
        overlayEl.style.background = '#0b0d10';
        var heading = tampered ? 'Trial Validation Failed' : 'Demo Period Expired';
        var body = tampered
            ? 'The trial data for <strong style="color:rgba(255,255,255,.7)">' + APP_NAME + '</strong> could not be verified. Enter a valid licence key below to unlock the app permanently on this machine.'
            : 'Your ' + ent.trial.trialDays + '-day evaluation of <strong style="color:rgba(255,255,255,.7)">' + APP_NAME + '</strong> has ended. Enter a licence key to continue.';
        overlayEl.innerHTML = ''
            + '<div class="pl-lic-card">'
            + '  <div style="width:64px;height:64px;border-radius:50%;background:' + accent + '1f;border:1px solid ' + accent + '4d;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;font-size:30px">' + (tampered ? '⚠' : '🔒') + '</div>'
            + '  <h1 style="color:#f1f5f9;font-size:21px;font-weight:700;margin:0 0 8px">' + heading + '</h1>'
            + '  <p style="color:rgba(255,255,255,.45);font-size:13.5px;line-height:1.6;margin:0 0 24px">' + body + '</p>'
            + activationFormHtml(ent)
            + '  <div style="margin-top:20px;padding-top:18px;border-top:1px solid #2a2d38;display:flex;align-items:center;justify-content:center">'
            + '    <a href="mailto:' + SUPPORT_EMAIL + '?subject=' + encodeURIComponent(APP_NAME + ' — Full License') + '" style="color:#93c5fd;font-size:13px;font-weight:600;text-decoration:none">Need a key? Contact us</a>'
            + '  </div>'
            + '  <p style="margin-top:20px;color:rgba(255,255,255,.2);font-size:11px">' + APP_NAME + ' — Demo Version</p>'
            + '</div>';
        document.body.appendChild(overlayEl);
        wireActivation(overlayEl, ent, onActivatedSuccess);
    }

    function applyEntitlement(ent) {
        clearUi();
        currentEnt = ent;
        updateAboutModal(ent);
        if (!ent || !ent.enforced) return;      // dev / unlocked build
        if (ent.licensed) return;               // fully licensed
        injectStyles();
        if (ent.locked) {
            renderLockScreen(ent);
        } else {
            renderBanner(ent);
        }
    }

    // ── About-modal licence status ────────────────────────────────────────────
    function updateAboutModal(ent) {
        var badge = document.getElementById('about-license-badge');
        var detail = document.getElementById('about-license-detail');
        var machineRow = document.getElementById('about-license-machine-row');
        var machineEl = document.getElementById('about-license-machine');
        var activateBtn = document.getElementById('about-license-activate');
        if (!badge) return;

        var licensed = ent && ent.licensed;
        // In dev / unlocked (not enforced) builds, present as activated.
        badge.textContent = licensed ? '● Activated' : '● Demo Version';
        badge.style.background = licensed ? '#064e3b' : '#78350f';
        badge.style.color = licensed ? '#6ee7b7' : '#fcd34d';

        if (detail) {
            if (licensed) {
                var exp = ent.licenseExpiresAt;
                detail.textContent = exp ? ('Licensed to this machine · valid until ' + expiryLabel(exp)) : 'Licensed to this machine · perpetual';
            } else if (ent && ent.trial) {
                detail.textContent = ent.trial.expired
                    ? 'Trial expired — activation required'
                    : (ent.trial.daysRemaining + ' day' + (ent.trial.daysRemaining === 1 ? '' : 's') + ' left · expires ' + expiryLabel(ent.trial.expiresAt));
            } else {
                detail.textContent = '';
            }
        }

        if (machineEl && ent) machineEl.textContent = ent.machineId || '—';

        // Show Machine ID + Activate only when not licensed (and enforced).
        var showActivate = ent && ent.enforced && !licensed;
        if (machineRow) machineRow.style.display = showActivate ? 'block' : 'none';
        if (activateBtn) {
            activateBtn.style.display = showActivate ? 'inline-block' : 'none';
            if (!activateBtn._plWired) {
                activateBtn._plWired = true;
                activateBtn.addEventListener('click', function () {
                    if (currentEnt) openActivationModal(currentEnt);
                });
            }
        }

        var copyBtn = document.getElementById('about-license-copy');
        if (copyBtn && !copyBtn._plWired) {
            copyBtn._plWired = true;
            copyBtn.addEventListener('click', function () {
                var text = (currentEnt && currentEnt.machineId) || '';
                try {
                    navigator.clipboard.writeText(text).then(function () {
                        copyBtn.textContent = 'Copied';
                        setTimeout(function () { copyBtn.textContent = 'Copy'; }, 1500);
                    });
                } catch (_) { /* clipboard unavailable */ }
            });
        }
    }

    function boot() {
        injectStyles();
        Promise.resolve(window.licensing.status())
            .then(applyEntitlement)
            .catch(function (err) { console.error('[licensing] status failed', err); });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot);
    } else {
        boot();
    }
})();
</script>
</body>
</html>
