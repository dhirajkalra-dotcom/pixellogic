}
.pl-tut-btn-back {
    background: rgba(255,255,255,0.06);
    color: #94a3b8;
    border-color: rgba(255,255,255,0.1);
}
.pl-tut-btn-back:hover { background: rgba(255,255,255,0.11); color: #cbd5e1; }
.pl-tut-btn-next {
    background: #6366f1;
    color: #fff;
    border-color: rgba(99,102,241,0.6);
    display: flex;
