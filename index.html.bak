}
.pl-tut-dot.pl-dot-done { background: rgba(99,102,241,0.45); }
.pl-tut-dot.pl-dot-cur  { background: #6366f1; transform: scale(1.35); }

/* Buttons */
#pl-tut-btns {
    display: flex;
