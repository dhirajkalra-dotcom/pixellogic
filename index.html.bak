    background: rgba(99,102,241,0.22);
    color: #c7d2fe;
}
#pl-tutorial-launcher svg { flex-shrink: 0; }

/* Highlight class applied DIRECTLY on the target element — no coordinate math, immune to body zoom */
.pl-tut-target {
    border-style: dashed !important;
    border-width: 2.5px !important;
    position: relative !important;
    z-index: 20 !important;
}

/* Floating card */
#pl-tutorial-card {
    position: fixed;
    z-index: 9100;
    width: 340px;
    background: #1a1f2e;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 14px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.04);
    overflow: hidden;
    display: none;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
}
#pl-tutorial-card.pl-card-visible { display: block; }

/* Colored left accent bar */
#pl-tut-accent-bar {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 4px;
    border-radius: 14px 0 0 14px;
    background: #6366f1;
    transition: background 0.3s ease;
}

/* Card inner padding (offset from accent bar) */
#pl-tut-card-inner {
    padding: 18px 18px 16px 22px;
}

/* Card header row */
#pl-tut-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 4px;
}
#pl-tut-icon {
    width: 28px;
