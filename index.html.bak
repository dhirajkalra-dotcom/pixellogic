<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PIXI LOGIC</title>
    <link rel="stylesheet" href="styles.css">
    <link rel="stylesheet" href="styles-theme.css">
    <style>

        /* ==========================================================================
           SQUARE DESIGN SYSTEM OVERRIDE (High Performance, No Text Cutoff)
           Removes rounded corners across all tabs, cards, panels, buttons & inputs
           ========================================================================== */
        *,
        *::before,
        *::after {
            border-radius: 0 !important;
        }

        /* Minimal functional exceptions for circular indicator dots */
        .window-dot {
            border-radius: 9999px !important;
        }
        .toggle-switch .dot,
        .toggle-switch .block {
            border-radius: 2px !important;
        }

        /* Clean rectangular engineering tabs with no text clipping */
        .pixel-map-tab {
            border-radius: 0 !important;
            height: 34px !important;
            box-sizing: border-box !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
        }
        .pixel-map-tab[data-active="true"] {
            box-shadow: 0 0 0 1px var(--color-accent) !important;
        }
        .canvas-tab {
            border-radius: 0 !important;
            height: 34px !important;
            box-sizing: border-box !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
        }
        .canvas-tab[data-active="true"] {
            box-shadow: 0 0 0 1px #38bdf8 !important;
        }
        .pl-excel-sheettab {
            border-radius: 0 !important;
        }
        .nav-tab,
        .sidebar-macos .item {
            border-radius: 0 !important;
        }
        .pixel-designer-section-heading {
            display: flex;
            align-items: center;
            gap: .6rem;
            min-height: 2.25rem;
            padding-left: .7rem;
            padding-right: .7rem;
            border-left: 4px solid var(--designer-section-color, #22d3ee);
            border-bottom-color: color-mix(in srgb, var(--designer-section-color, #22d3ee) 45%, transparent) !important;
            color: var(--designer-section-color, #22d3ee) !important;
            background: linear-gradient(90deg, color-mix(in srgb, var(--designer-section-color, #22d3ee) 16%, transparent), color-mix(in srgb, var(--designer-section-color, #22d3ee) 4%, transparent) 70%, transparent);
            border-radius: 0 .35rem .35rem 0;
        }
        .pixel-designer-section-heading--name { --designer-section-color: #fbbf24; }
        .pixel-designer-section-heading--dimensions { --designer-section-color: #38bdf8; }
        .pixel-designer-section-heading--shape { --designer-section-color: #a78bfa; }
        .pixel-designer-section-heading--specs { --designer-section-color: #34d399; }
        .pixel-designer-section-heading--style { --designer-section-color: #f472b6; }
        .pixel-designer-section-heading--details { --designer-section-color: #fb923c; }
        .pixel-designer-section-heading--border { --designer-section-color: #f87171; }
        .pixel-designer-section-heading--presets { --designer-section-color: #c084fc; }
        .pixel-designer-section-heading--preview { --designer-section-color: #2dd4bf; }

        /* Map Annotations follows a canvas + parameter-inspector workspace. */
        #effects-content .annotations-shell {
            padding: 0;
            overflow: hidden;
            background: #10242d;
        }
        #effects-content .annotations-workspace {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 340px;
            height: calc(100vh - 9.5rem);
            min-height: 32rem;
        }
        #effects-content .annotations-stage {
            min-width: 0;
            min-height: 0;
            overflow: auto;
            padding: 1rem;
        }
        #effects-content .annotations-preview-viewport {
            height: 58vh;
            min-height: 26rem;
        }
        #effects-content .annotations-inspector {
            min-width: 0;
            min-height: 0;
            height: 100%;
            overflow-y: auto;
            overscroll-behavior: contain;
            border-left: 1px solid #314955;
            background: #1a303a;
        }
        #effects-content .annotations-inspector-header {
            position: sticky;
            top: 0;
            z-index: 20;
            padding: .75rem 1rem;
            border-bottom: 1px solid #314955;
            background: #1a303a;
        }
        #effects-content .annotations-controls-grid {
            display: block;
            padding: 0 .75rem 1rem;
        }
        #effects-content .annotations-controls-grid > div {
            margin: 0 !important;
        }
        #effects-content .annotations-controls-grid > div > div {
            margin-top: .75rem;
            padding: .85rem !important;
            border-radius: .25rem !important;
            background: #162a33 !important;
            box-shadow: none !important;
        }
        #effects-content .annotations-inspector h3 {
            color: #c7d5db;
            letter-spacing: 0;
        }
        #effects-content .annotations-inspector .grid-cols-2,
        #effects-content .annotations-inspector .grid-cols-3 {
            grid-template-columns: minmax(0, 1fr);
            gap: .55rem;
        }
        #effects-content .annotations-inspector .grid-cols-2 > div,
        #effects-content .annotations-inspector .grid-cols-3 > div {
            display: grid;
            grid-template-columns: minmax(100px, .85fr) minmax(0, 1.15fr);
            align-items: center;
            gap: .65rem;
        }
        #effects-content .annotations-inspector label {
            font-size: .72rem;
            line-height: 1.15;
            color: #aebfc7;
        }
        #effects-content .annotations-inspector select,
        #effects-content .annotations-inspector input[type="text"] {
            min-height: 1.8rem;
            padding: .25rem .45rem;
            border-radius: .2rem;
            font-size: .72rem;
        }
        #effects-content .annotations-inspector input[type="color"] {
            height: 1.8rem !important;
            margin-top: 0 !important;
            border-radius: .2rem;
        }
        #effects-content .annotation-button-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: .4rem;
        }
        #effects-content .annotation-action-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: .5rem;
        }
        #effects-content .annotation-choice {
            min-height: 2rem;
            padding: .35rem .5rem;
            border: 1px solid #49616c;
            border-radius: .25rem;
            background: #243b46;
            color: #c7d5db;
            font-size: .7rem;
            font-weight: 600;
            text-align: center;
        }
        #effects-content .annotation-choice:hover { background: #2e4a57; }
        #effects-content .annotation-choice[aria-pressed="true"] {
            border-color: #38bdf8;
            background: #0369a1;
            color: #fff;
        }
        #effects-content .annotation-section {
            border-left: 3px solid var(--section-accent) !important;
        }
        #effects-content .annotation-section h3.annotation-section-title {
            color: var(--section-accent) !important;
        }
        #effects-content .annotation-section-project { --section-accent: #38bdf8; }
        #effects-content .annotation-section-overlays { --section-accent: #f59e0b; }
        #effects-content .annotation-section-logo { --section-accent: #a78bfa; }
        #effects-content .annotation-section-color-bars { --section-accent: #34d399; }
        #effects-content .annotation-section-presets { --section-accent: #fb7185; }
        #effects-content .annotation-collapsible > :first-child h3 {
            display: flex;
            flex: 1;
            align-items: center;
            justify-content: space-between;
            cursor: pointer;
        }
        #effects-content .annotation-collapsible > :first-child h3::after {
            content: '−';
            margin-left: .75rem;
            color: #94a3b8;
            font-size: 1rem;
        }
        #effects-content .annotation-collapsible.annotation-collapsed > :first-child h3::after { content: '+'; }
        #effects-content .annotation-collapsible.annotation-collapsed > :not(:first-child) { display: none; }
        #effects-content .annotation-collapsible.annotation-collapsed > :first-child { margin-bottom: 0 !important; }
        @media (max-width: 1100px) {
            #effects-content .annotations-workspace {
                grid-template-columns: minmax(0, 1fr) 300px;
            }
        }
        @media (max-width: 820px) {
            #effects-content .annotations-workspace {
                display: block;
                height: auto;
                min-height: 0;
            }
            #effects-content .annotations-inspector {
                height: auto;
                overflow: visible;
                border-top: 1px solid #314955;
                border-left: 0;
            }
            #effects-content .annotations-preview-viewport {
                height: 52vh;
                min-height: 20rem;
            }
        }
    </style>
    <style>
        /* Custom Styles & Animations */
        /* Remove number input spinners */
        #app-scale-input::-webkit-inner-spin-button,
        #app-scale-input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
        #app-scale-input:focus { border-color: rgba(103,232,249,0.7) !important; box-shadow: 0 0 0 2px rgba(103,232,249,0.15); }
        :root {
            --color-accent: #6366f1; /* Default Indigo */
            --color-text-base: #ffffff; /* Default White */
            --interface-font: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;
            --interface-bg: #5e2471; /* Default background */
        }

        body {
            font-family: var(--interface-font);
            background-color: var(--interface-bg);
            /* subtle grid overlay kept but based on bg */
            background-image: 
                linear-gradient(rgba(0,0,0,0.08), rgba(0,0,0,0.08)),
                linear-gradient(0deg, transparent 24%, rgba(255, 255, 255, 0.02) 25%, rgba(255, 255, 255, 0.02) 26%, transparent 27%, transparent 74%, rgba(255, 255, 255, 0.02) 75%, rgba(255, 255, 255, 0.02) 76%, transparent 77%, transparent),
                linear-gradient(90deg, transparent 24%, rgba(255, 255, 255, 0.02) 25%, rgba(255, 255, 255, 0.02) 26%, transparent 27%, transparent 74%, rgba(255, 255, 255, 0.02) 75%, rgba(255, 255, 255, 0.02) 76%, transparent 77%, transparent);
            background-size: 50px 50px;
            color: var(--color-text-base);
            -webkit-user-select: none;
            user-select: none;
        }

    img, canvas, svg, video { -webkit-user-drag: none; }

        /* --- Themeable Utility Classes --- */
        .text-accent { color: var(--color-accent); }
        .bg-accent { background-color: var(--color-accent); }
        .hover\:bg-accent-dark:hover { filter: brightness(0.9); }
        .focus\:ring-accent:focus { --tw-ring-color: var(--color-accent); }
        .border-accent-semi { border-color: color-mix(in srgb, var(--color-accent) 30%, transparent); }
        .nav-tab.active-pixelmaps, .nav-tab.active-designer { background-color: var(--color-accent); color: white; box-shadow: 0 0 15px color-mix(in srgb, var(--color-accent) 60%, transparent); }
        
        /* --- Creative Enhancements --- */
        header {
            /* Checkerboard background */
            background-color: #111827;
            background-image:
                linear-gradient(45deg, rgba(255,255,255,0.08) 25%, transparent 25%, transparent 75%, rgba(255,255,255,0.08) 75%, rgba(255,255,255,0.08)),
                linear-gradient(45deg, rgba(255,255,255,0.08) 25%, transparent 25%, transparent 75%, rgba(255,255,255,0.08) 75%, rgba(255,255,255,0.08));
            background-size: 24px 24px;
            background-position: 0 0, 12px 12px;
            border-radius: 0;
            padding: 0.75rem 1.5rem;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        }

        nav {
            background: rgba(31, 41, 55, 0.5);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .btn-glow { transition: all 0.3s ease; }
        .btn-glow.bg-accent:hover { box-shadow: 0 0 15px 5px color-mix(in srgb, var(--color-accent) 40%, transparent); }

        /* Sidebar active-tab accent glows — match the left-border accent colors */
        .sidebar-macos .item.active-shows    { box-shadow: 0 0 0 1px rgba(99,102,241,.4) inset; }
        .sidebar-macos .item.active-sheets   { box-shadow: 0 0 0 1px rgba(34,197,94,.45) inset; }

        /* Excel-Style LED Sheets Tab */
        .pl-excel-wrap {
            background: rgba(11, 17, 30, 0.94);
            border: 1px solid rgba(148, 163, 184, 0.22);
            border-radius: 0;
            overflow: hidden;
            box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
        }
        .pl-excel-ribbon {
            background: linear-gradient(180deg, rgba(16, 185, 129, 0.14) 0%, rgba(15, 23, 42, 0.92) 100%);
            border-bottom: 1px solid rgba(148, 163, 184, 0.2);
            padding: 10px 14px;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }
        .pl-excel-formulabar {
            background: rgba(15, 23, 42, 0.96);
            border-bottom: 1px solid rgba(148, 163, 184, 0.2);
            padding: 6px 12px;
            display: flex;
            align-items: center;
            gap: 8px;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 12px;
        }
        .pl-excel-cellref {
            background: rgba(30, 41, 59, 0.9);
            border: 1px solid rgba(148, 163, 184, 0.28);
            border-radius: 4px;
            padding: 2px 8px;
            min-width: 64px;
            text-align: center;
            color: #34d399;
            font-weight: 700;
        }
        .pl-excel-grid-scroll {
            overflow-x: auto;
            overflow-y: auto;
            max-height: calc(100vh - 285px);
            background: #090d16;
        }
        .pl-excel-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
            color: #e2e8f0;
            table-layout: auto;
        }
        .pl-excel-table th,
        .pl-excel-table td {
            border: 1px solid rgba(71, 85, 105, 0.48);
            padding: 0;
            vertical-align: middle;
            white-space: nowrap;
        }
        .pl-excel-table thead th {
            position: sticky;
            top: 0;
            z-index: 15;
            background: #162032;
            color: #cbd5e1;
            font-weight: 600;
            padding: 6px 8px;
            text-align: center;
            font-size: 11px;
            letter-spacing: 0.02em;
            user-select: none;
        }
        .pl-excel-table thead tr.pl-excel-col-letters th {
            background: #0f172a;
            color: #64748b;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 10px;
            padding: 3px 6px;
            border-bottom: 1px solid rgba(100, 116, 139, 0.5);
        }
        .pl-excel-table thead tr.pl-excel-group-headers th {
            top: 21px;
            z-index: 16;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            padding: 4px 8px;
        }
        .pl-excel-table thead tr.pl-excel-sub-headers th {
            top: 44px;
            z-index: 16;
        }
        .pl-excel-rownum {
            background: #0f172a !important;
            color: #94a3b8;
            text-align: center;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 11px;
            font-weight: 600;
            width: 36px;
            min-width: 36px;
            padding: 4px 6px !important;
            user-select: none;
            position: sticky;
            left: 0;
            z-index: 10;
        }
        .pl-excel-row.active-map-row td {
            background: rgba(16, 185, 129, 0.07);
        }
        .pl-excel-row:hover td {
            background: rgba(51, 65, 85, 0.32);
        }
        .pl-excel-input,
        .pl-excel-select {
            width: 100%;
            height: 30px;
            background: transparent;
            border: 1.5px solid transparent;
            color: #f8fafc;
            padding: 2px 7px;
            font-size: 12px;
            outline: none;
            transition: border-color 0.12s ease, background-color 0.12s ease;
        }
        .pl-excel-input.num {
            text-align: right;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            min-width: 72px;
        }
        .pl-excel-input:focus,
        .pl-excel-select:focus {
            background: rgba(15, 23, 42, 0.98);
            border-color: #22c55e;
            box-shadow: 0 0 0 1px rgba(34, 197, 94, 0.45) inset;
        }
        .pl-excel-select option {
            background: #0f172a;
            color: #f8fafc;
        }
        .pl-excel-readonly {
            padding: 5px 8px;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            text-align: right;
            background: rgba(15, 23, 42, 0.45);
            color: #cbd5e1;
        }
        .pl-excel-sheettabs {
            background: linear-gradient(90deg, #0b1322 0%, #0f172a 100%);
            border-bottom: 1px solid rgba(148, 163, 184, 0.25);
            padding: 8px 14px;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            font-size: 12px;
        }
        .pl-excel-sheettab {
            padding: 6px 14px;
            border-radius: 0;
            border: 1px solid rgba(148, 163, 184, 0.22);
            background: rgba(30, 41, 59, 0.72);
            color: #94a3b8;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.15s ease;
        }
        .pl-excel-sheettab:hover {
            background: rgba(51, 65, 85, 0.85);
            color: #e2e8f0;
        }
        .pl-excel-sheettab.active {
            background: rgba(16, 185, 129, 0.22);
            color: #34d399;
            border-color: rgba(34, 197, 94, 0.55);
            box-shadow: 0 0 0 1px rgba(34, 197, 94, 0.25) inset;
        }
        .sidebar-macos .item.active-designer { box-shadow: 0 0 0 1px rgba(139,92,246,.4) inset; }
        .sidebar-macos .item.active-effects  { box-shadow: 0 0 0 1px rgba(236,72,153,.4) inset; }
        .sidebar-macos .item.active-visualizer { box-shadow: 0 0 0 1px rgba(20,184,166,.4) inset; }
        .sidebar-macos .item.active-view3d   { box-shadow: 0 0 0 1px rgba(34,211,238,.4) inset; }
        .sidebar-macos .item.active-canvas   { box-shadow: 0 0 0 1px rgba(59,130,246,.4) inset; }
        .sidebar-macos .item.active-led-patching { box-shadow: 0 0 0 1px rgba(245,158,11,.4) inset; }
        .sidebar-macos .item.active-pdf      { box-shadow: 0 0 0 1px rgba(244,63,94,.4) inset; }
        .sidebar-macos .item.active-power-calc { box-shadow: 0 0 0 1px rgba(251,146,60,.4) inset; }
        .sidebar-macos .item.active-utility-tools { box-shadow: 0 0 0 1px rgba(167,139,250,.4) inset; }
        .sidebar-macos .item.active-help     { box-shadow: 0 0 0 1px rgba(100,116,139,.4) inset; }

        /* About modal social logo sprite */
        .about-social-sprite {
            display: flex;
            gap: 10px;
            align-items: center;
            flex-wrap: wrap;
        }
        .about-social-link {
            width: 64px;
            height: 64px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background-image: url('external-files/social-logos.png');
            background-repeat: no-repeat;
            background-size: 400% 100%;
            background-position: 0% 50%;
            border-radius: 14px;
            border: 1px solid rgba(255, 255, 255, 0.12);
            background-color: rgba(255, 255, 255, 0.04);
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }
        .about-social-link:hover {
            transform: translateY(-1px) scale(1.02);
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35), 0 0 18px rgba(255, 255, 255, 0.85);
        }
        .about-social-link.linkedin { background-position: 0% 50%; }
        .about-social-link.whatsapp { background-position: 33.333% 50%; }
        .about-social-link.instagram { background-position: 66.666% 50%; }
        .about-social-link.email { background-position: 100% 50%; }
        .about-social-link span { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

        /* ── Combine Strip (Designer + Visualizer) ─────────────────────── */
        .combine-strip {
            background: linear-gradient(180deg, rgba(15,23,42,0.65), rgba(15,23,42,0.4));
            border: 1px solid rgba(71,85,105,0.55);
            border-radius: 10px;
            padding: 8px 12px;
            margin-bottom: 12px;
        }
        .combine-strip-header { display:flex; align-items:center; gap:8px; margin-bottom:6px; flex-wrap:wrap; }
        .combine-strip-title { font-size:12px; font-weight:600; color:#e2e8f0; display:inline-flex; align-items:center; gap:6px; }
        .combine-strip-title svg { width:14px; height:14px; color:#38bdf8; }
        .combine-strip-primary { font-size:11px; color:#94a3b8; }
        .combine-strip-primary b { color:#cbd5e1; font-weight:600; }
        .combine-strip-count { margin-left:auto; font-size:11px; color:#64748b; font-variant-numeric:tabular-nums; }
        .combine-strip-count.has-selection { color:#34d399; font-weight:600; }
        .combine-strip-body { display:flex; flex-wrap:wrap; align-items:center; gap:10px; }
        .combine-chips { display:flex; flex-wrap:wrap; gap:6px; flex:1 1 220px; min-width:0; max-height:92px; overflow-y:auto; padding:2px; }
        .combine-chips::-webkit-scrollbar { height:6px; width:6px; }
        .combine-chips::-webkit-scrollbar-thumb { background:rgba(148,163,184,0.4); border-radius:3px; }
        .combine-chip {
            display:inline-flex; align-items:center; gap:4px;
            padding:4px 10px; font-size:11px; font-weight:500;
            background: rgba(30,41,59,0.8); color:#cbd5e1;
            border:1px solid rgba(71,85,105,0.7); border-radius:999px;
            cursor:pointer; user-select:none;
            transition: all 120ms ease;
        }
        .combine-chip:hover { border-color:#38bdf8; color:#f1f5f9; background:rgba(30,41,59,0.95); }
        .combine-chip.selected {
            background: linear-gradient(135deg,#0ea5e9,#0284c7);
            color:#fff; border-color:#0284c7;
            box-shadow: 0 0 0 1px rgba(56,189,248,0.35), 0 2px 6px rgba(2,132,199,0.4);
        }
        .combine-chip.selected::before { content:'\2713'; font-size:10px; font-weight:700; }
        .combine-chip.disabled { opacity:0.45; cursor:not-allowed; }
        .combine-empty { font-size:11px; color:#64748b; font-style:italic; padding:4px 2px; }
        .combine-placement {
            display:inline-flex; gap:2px; padding:2px;
            background: rgba(15,23,42,0.8); border:1px solid rgba(71,85,105,0.7); border-radius:8px;
        }
        .placement-btn {
            width:28px; height:28px; display:inline-flex; align-items:center; justify-content:center;
            background:transparent; border:none; color:#94a3b8; border-radius:6px; cursor:pointer;
            font-size:14px; transition: all 120ms ease;
        }
        .placement-btn:hover { background: rgba(51,65,85,0.7); color:#e2e8f0; }
        .placement-btn.active { background: linear-gradient(135deg,#6366f1,#4f46e5); color:#fff; box-shadow:0 0 0 1px rgba(99,102,241,0.4) inset; }
        .placement-btn svg { width:14px; height:14px; }
        .combine-go-btn {
            padding:6px 14px; font-size:12px; font-weight:600; border-radius:7px;
            background: linear-gradient(135deg,#10b981,#059669); color:#fff; border:none; cursor:pointer;
            display:inline-flex; align-items:center; gap:6px;
            transition: all 120ms ease;
        }
        .combine-go-btn:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(16,185,129,0.35); }
        .combine-go-btn:disabled { background: rgba(51,65,85,0.6); color: #64748b; cursor:not-allowed; }
        .combine-go-btn svg { width:14px; height:14px; }
        .combine-clear {
            font-size:11px; color:#94a3b8; background:none; border:none; cursor:pointer; padding:4px 8px; border-radius:4px;
        }
        .combine-clear:hover { color:#f87171; background:rgba(239,68,68,0.08); }

        .viz-grid-bg {
            background-color: #0b1220;
            background-image:
                linear-gradient(0deg, rgba(255,255,255,0.06) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,0.06) 1px, transparent 1px);
            background-size: 24px 24px;
        }

        /* Mode toggle styling */
        .mode-toggle {
            background: rgba(17, 24, 39, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 0.9rem;
            padding: 0.6rem 0.75rem;
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }
        .mode-switch {
            position: relative;
            display: inline-flex;
            align-items: center;
            width: 54px;
            height: 30px;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 9999px;
            cursor: pointer;
            transition: background 0.2s ease, border-color 0.2s ease;
        }
        .mode-switch input {
            position: absolute;
            opacity: 0;
            width: 0;
            height: 0;
        }
        .mode-slider {
            position: absolute;
            left: 3px;
            top: 3px;
            width: 22px;
            height: 22px;
            background: #ffffff;
            border-radius: 9999px;
            transition: transform 0.2s ease;
            box-shadow: 0 2px 6px rgba(0,0,0,0.35);
        }
        .mode-switch input:checked + .mode-slider {
            transform: translateX(24px);
        }
        .mode-switch input:checked ~ .mode-slider {
            transform: translateX(24px);
        }
        .mode-switch input:checked + .mode-slider,
        .mode-switch input:checked ~ .mode-slider {
            background: var(--color-accent);
        }
        .mode-switch input:checked ~ .mode-slider {
            box-shadow: 0 0 12px color-mix(in srgb, var(--color-accent) 40%, transparent);
        }
        .edition-toggle {
            margin-top: -0.5rem;
        }
        .edition-toggle .mode-switch input:checked + .mode-slider,
        .edition-toggle .mode-switch input:checked ~ .mode-slider {
            background: #f59e0b;
            box-shadow: 0 0 12px rgba(245, 158, 11, 0.4);
        }
        
        .info-card {
            transition: box-shadow 0.3s ease;
            border: 1px solid rgba(255, 255, 255, 0.12); /* subtle outline to separate stats */
        }

        .tab-content { display: none; }
        .tab-content.active { display: block; }

        /* Sticky (floating) preview panels for long-scroll tabs */
        .pl-sticky-preview {
            position: sticky;
            top: 0.75rem;
            z-index: 20;
            align-self: start;
        }
        .pl-sticky-preview-designer {
            position: sticky !important;
            top: 0.75rem;
            z-index: 28;
            align-self: start;
        }
        .pl-fixed-preview-designer {
            position: fixed !important;
            top: 0.75rem;
            z-index: 42;
        }
        #designer-content, #effects-content { overflow: visible; }

        .fx-advanced {
            border: 1px solid rgba(148, 163, 184, 0.25);
            border-radius: 0.5rem;
            background: rgba(15, 23, 42, 0.55);
            padding: 0.5rem 0.65rem;
        }
        .fx-advanced > summary {
            cursor: pointer;
            color: #cbd5e1;
            font-size: 0.75rem;
            font-weight: 600;
            list-style: none;
        }
        .fx-advanced > summary::-webkit-details-marker { display: none; }

        #main-canvas-wrapper {
            cursor: default;
            background-color: #0b1220;
            background-image:
                linear-gradient(45deg, rgba(255,255,255,0.04) 25%, transparent 25%),
                linear-gradient(-45deg, rgba(255,255,255,0.04) 25%, transparent 25%),
                linear-gradient(45deg, transparent 75%, rgba(255,255,255,0.04) 75%),
                linear-gradient(-45deg, transparent 75%, rgba(255,255,255,0.04) 75%);
            background-size: 24px 24px;
            background-position: 0 0, 0 12px, 12px -12px, -12px 0px;
        }
        #main-canvas-wrapper.mask-hover { cursor: default; }
        #main-canvas-wrapper.grabbing { cursor: grabbing; }
        #main-canvas-container {
            box-shadow: 0 0 0 4px rgba(57, 255, 20, 0.95), 0 0 28px rgba(57, 255, 20, 0.62), 0 0 48px rgba(57, 255, 20, 0.28), 0 12px 30px rgba(0,0,0,0.45);
            z-index: 2;
        }
        .canvas-workspace-frame {
            position: absolute;
            border: 2px solid rgba(57, 255, 20, 0.85);
            box-shadow: 0 0 16px rgba(57, 255, 20, 0.28);
            overflow: hidden;
            z-index: 4;
            transition: filter 160ms ease, opacity 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
        }
        .canvas-workspace-frame.is-active {
            background: transparent;
            pointer-events: none;
        }
        .canvas-workspace-frame:not(.is-active) {
            background-color: #111827;
            background-image: repeating-linear-gradient(135deg, rgba(255,255,255,0.035) 0 12px, transparent 12px 24px);
            border-color: rgba(148, 163, 184, 0.5);
            box-shadow: none;
            filter: grayscale(1);
            opacity: 0.48;
            cursor: pointer;
        }
        .canvas-workspace-frame:not(.is-active):hover {
            opacity: 0.7;
            border-color: rgba(148, 163, 184, 0.8);
        }
        .canvas-workspace-preview {
            display: block;
            width: 100%;
            height: 100%;
        }
        .canvas-workspace-label {
            position: absolute;
            top: 8px;
            left: 8px;
            display: flex;
            align-items: center;
            gap: 8px;
            max-width: calc(100% - 16px);
            padding: 5px 9px;
            border: 1px solid rgba(52, 211, 153, 0.55);
            border-radius: 4px;
            background: rgba(3, 7, 18, 0.9);
            color: #d1fae5;
            font-size: 12px;
            font-weight: 700;
            line-height: 1;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            z-index: 2;
        }

        /* Projector preview toolbar */
        .ptp-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            padding: 0.5rem 0.75rem;
            border-radius: 0.75rem;
            background: rgba(17, 24, 39, 0.7);
            border: 1px solid rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }
        .ptp-toolbar-title {
            font-size: 0.85rem;
            color: #d1d5db;
            letter-spacing: 0.02em;
        }
        .ptp-toolbar-actions {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.4rem;
        }
        .ptp-toolbar-btn {
            padding: 0.35rem 0.55rem;
            border-radius: 0.5rem;
            border: 1px solid rgba(255, 255, 255, 0.12);
            background: rgba(255, 255, 255, 0.06);
            color: #e5e7eb;
            font-size: 0.75rem;
            font-weight: 600;
            transition: all 0.15s ease;
        }
        .ptp-toolbar-btn:hover {
            background: rgba(255, 255, 255, 0.12);
        }
        .ptp-toolbar-btn.primary {
            background: #f59e0b;
            border-color: #f59e0b;
            color: #111827;
        }
        .ptp-toolbar-btn.success {
            background: #10b981;
            border-color: #10b981;
            color: #111827;
        }
        .ptp-toolbar-pill {
            padding: 0.35rem 0.6rem;
            border-radius: 9999px;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: #e5e7eb;
            font-size: 0.72rem;
            font-weight: 600;
            min-width: 56px;
            text-align: center;
        }
        .ptp-preview-stage {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }
        .ptp-preview-zoom {
            transform-origin: center center;
            transition: transform 0.15s ease;
        }

        .toggle-switch .dot {
            transition: transform 0.2s ease-in-out;
        }
        .toggle-switch input:checked ~ .dot {
            transform: translateX(100%);
            background-color: var(--color-accent);
        }
        .toggle-switch input:checked ~ .block {
             background-color: color-mix(in srgb, var(--color-accent) 50%, #374151);
        }

        /* Auto-highlight animation for Learn more jumps */
        @keyframes pulse-ring {
            0% { box-shadow: 0 0 0 0 rgba(99, 102, 241, 0.7); }
            70% { box-shadow: 0 0 0 8px rgba(99, 102, 241, 0.0); }
            100% { box-shadow: 0 0 0 0 rgba(99, 102, 241, 0.0); }
        }
        .auto-highlight {
            outline: 2px solid #6366f1;
            border-radius: 0.5rem;
            animation: pulse-ring 1.2s ease-out 2;
            transition: outline-color 0.3s ease;
        }

        /* Unified page background for all tabs */
        main {
            position: relative;
            border: 1px solid rgba(148, 163, 184, 0.2);
            border-radius: 1rem;
            overflow: visible;
            background:
                linear-gradient(90deg, rgba(30,58,138,0.28) 0%, rgba(15,23,42,0.55) 44%, rgba(109,40,217,0.24) 100%),
                linear-gradient(180deg, rgba(15,23,42,0.85), rgba(17,24,39,0.85));
            box-shadow: 0 16px 36px rgba(2, 6, 23, 0.42);
            min-height: 68vh;
        }
        main::before,
        main::after {
            content: '';
            position: absolute;
            inset: 0;
            pointer-events: none;
        }
        main::before {
            background:
                linear-gradient(135deg, rgba(56,189,248,0.08), transparent 35%),
                linear-gradient(225deg, rgba(236,72,153,0.07), transparent 34%),
                radial-gradient(circle at 8% 26%, rgba(125,211,252,0.22) 0 1px, transparent 1px 100%),
                radial-gradient(circle at 92% 74%, rgba(196,181,253,0.18) 0 1px, transparent 1px 100%);
            background-size: auto, auto, 16px 16px, 16px 16px;
            opacity: 0.42;
        }
        main::after {
            background:
                linear-gradient(145deg, rgba(59,130,246,0.10), rgba(14,165,233,0.01));
            clip-path: polygon(2% 16%, 10% 8%, 13% 26%, 9% 37%, 18% 50%, 10% 62%, 9% 82%, 5% 90%, 2% 82%, 5% 60%, 3% 44%, 4% 28%),
                       polygon(91% 11%, 96% 8%, 98% 24%, 94% 34%, 97% 46%, 92% 58%, 93% 75%, 90% 86%, 87% 72%, 89% 58%, 87% 41%, 89% 24%);
            opacity: 0.45;
        }
        main > .tab-content {
            position: relative;
            z-index: 1;
        }

        /* Safe global geometric background (visual only, no layout impact) */
        body {
            position: relative;
            overflow-x: hidden;
        }
        body::after {
            content: '';
            position: fixed;
            inset: -15%;
            pointer-events: none;
            z-index: -1;
            background:
                radial-gradient(circle at 14% 18%, rgba(56, 189, 248, 0.16), transparent 34%),
                radial-gradient(circle at 84% 20%, rgba(236, 72, 153, 0.12), transparent 36%),
                radial-gradient(circle at 22% 82%, rgba(16, 185, 129, 0.11), transparent 33%),
                radial-gradient(circle at 80% 78%, rgba(99, 102, 241, 0.14), transparent 38%);
        }

    </style>
    <script src="vendor/react.production.min.js" defer></script>
    <script src="vendor/react-dom.production.min.js" defer></script>
    <script src="vendor/htm.umd.js" defer></script>
    <script src="src/default-template-data.js"></script>
    <script src="src/rendering-engine.js"></script>
    <script src="src/map-renderer.js"></script>
    <script src="src/external-output-renderer.js"></script>
    <script src="src/external-output-editing.js"></script>
    <script src="src/external-output-controls.js" defer></script>
    <script src="src/pdf-templates/index.js" defer></script>
    <script src="src/signal-patching-pro.js" defer></script>
    <script src="src/view3d-pro.js" defer></script>
    <script src="src/sheets-cad-drawings.js" defer></script>
    <script>
        import('./vendor/pdf.min.js').then((pdfjsLib) => {
            window.pdfjsLib = pdfjsLib;
            if (pdfjsLib.GlobalWorkerOptions) pdfjsLib.GlobalWorkerOptions.workerSrc = 'vendor/pdf.worker.min.js';
        }).catch((error) => console.warn('PDF.js failed to load', error));
    </script>
    <script src="vendor/jspdf.umd.min.js" defer></script>
    <script src="vendor/html2canvas.min.js" defer></script>
    <script src="vendor/pptxgen.bundle.js" defer></script>
    <script>
        // Set PDF.js worker after page and deferred scripts load
        window.addEventListener('load', () => {
            try {
                if (window.pdfjsLib && window.pdfjsLib.GlobalWorkerOptions) {
                    const v = window.pdfjsLib.version || '2.16.105';
                    window.pdfjsLib.GlobalWorkerOptions.workerSrc = `https://cdnjs.cloudflare.com/ajax/libs/pdf.js/${v}/pdf.worker.min.js`;
                }
            } catch (_) {}
        });
    </script>
</head>
<body class="min-h-screen pt-2 px-3 pb-3 sm:px-4 sm:pb-4 lg:px-3 lg:pb-3">
    <!-- macOS-style fixed sidebar -->
    <aside class="app-sidebar sidebar-macos sidebar-fixed card translucent">
        <div class="window-chrome mb-4">
            <span class="window-dot close"></span>
            <span class="window-dot min"></span>
            <span class="window-dot max"></span>
        </div>
        <div id="app-mode-toggle" class="mode-toggle flex items-center justify-between gap-3 mb-4">
            <div class="flex flex-col">
                <span class="text-[11px] uppercase tracking-[0.2em] text-gray-400">App Mode</span>
                <span id="app-mode-label" class="text-sm text-gray-200">Pixelogic</span>
            </div>
            <label class="mode-switch" aria-label="Toggle Pixelogic / Projection Logic">
                <input id="app-mode-switch" type="checkbox" />
                <span class="mode-slider" aria-hidden="true"></span>
            </label>
        </div>
        <div id="app-edition-toggle" class="mode-toggle edition-toggle flex items-center justify-between gap-3 mb-4">
            <div class="flex flex-col">
                <span class="text-[11px] uppercase tracking-[0.2em] text-gray-400">Experience</span>
                <span id="app-edition-label" class="text-sm text-gray-200">Simple</span>
            </div>
            <label class="mode-switch" aria-label="Toggle Simple / Advanced experience">
                <input id="app-edition-switch" type="checkbox" />
                <span class="mode-slider" aria-hidden="true"></span>
            </label>
        </div>
        <div class="section-label">Sections</div>
        <div id="sidebar-nav" class="flex flex-col gap-1">
            <button data-tab="shows" data-modes="pixel" class="nav-tab item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" style="flex-shrink:0"><path d="M2 6a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6z"/></svg>
                Projects
            </button>
            <button data-tab="sheets" data-modes="pixel" data-editions="advanced" class="nav-tab item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" style="flex-shrink:0"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="3" x2="9" y2="21"/><line x1="15" y1="3" x2="15" y2="21"/></svg>
                Sheets
            </button>
            <button data-tab="designer" data-modes="pixel" class="nav-tab item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" style="flex-shrink:0"><rect x="3" y="3" width="5" height="5" rx="1"/><rect x="10" y="3" width="5" height="5" rx="1"/><rect x="3" y="10" width="5" height="5" rx="1"/><rect x="10" y="10" width="5" height="5" rx="1"/><rect x="17" y="3" width="4" height="5" rx="1"/><rect x="3" y="17" width="5" height="4" rx="1"/><rect x="10" y="17" width="5" height="4" rx="1"/></svg>
                Pixel Designer
            </button>
            <button data-tab="effects" data-modes="pixel" class="nav-tab item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" style="flex-shrink:0"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/></svg>
                Map Annotations
            </button>
            <button data-tab="visualizer" data-modes="pixel" data-editions="simple" class="nav-tab item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" style="flex-shrink:0"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                2D Visualizer
            </button>
            <button data-tab="view3d" data-modes="pixel" data-editions="advanced" class="nav-tab item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" style="flex-shrink:0"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                3D Visualizer
            </button>
            <button data-tab="canvas" data-modes="pixel" data-editions="advanced" class="nav-tab item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" style="flex-shrink:0"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
                Output Maps
            </button>
            <button data-tab="led-patching" data-modes="pixel" data-editions="advanced" class="nav-tab item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" style="flex-shrink:0"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                LED Patching
            </button>
            <button data-tab="pdf" data-modes="pixel" class="nav-tab item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" style="flex-shrink:0"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                PDF Export
            </button>
            <button data-tab="power-calc" data-modes="pixel" data-editions="advanced" class="nav-tab item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" style="flex-shrink:0"><rect x="6" y="3" width="12" height="18" rx="2"/><path d="M9 8h6M9 12h3M9 16h2"/></svg>
                Power Calc
            </button>
            <button data-tab="projector-test-pattern" data-modes="projection" class="nav-tab item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" style="flex-shrink:0"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M8 3h8M12 3v4M9 17l2-4 2 4"/></svg>
                Projector Test Pattern
            </button>
            <button data-tab="devices" data-modes="pixel" class="nav-tab item hidden" aria-hidden="true" tabindex="-1" style="display: none !important; pointer-events: none; opacity: 0;">Devices</button>
            <button data-tab="utility-tools" data-modes="pixel" class="nav-tab item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" style="flex-shrink:0"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                Misc Tools
            </button>
            <button data-tab="video-converter" data-modes="pixel" class="nav-tab item" style="display:none;">Video Converter</button>
            <button data-tab="help" data-modes="pixel projection" class="nav-tab item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" style="flex-shrink:0"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                Help
            </button>
        </div>
        <!-- Tutorial launcher -->
        <div style="height:1px;background:rgba(255,255,255,0.07);margin:10px 0 6px;"></div>
        <button id="pl-tutorial-launcher" aria-label="Start app tutorial tour" onclick="window.startPixelLogicTutorial && window.startPixelLogicTutorial()">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            <span>Start App Tour</span>
        </button>
    </aside>
    <div class="content-offset">
        <!-- Header -->
        <header class="relative mb-2 pb-3 overflow-hidden card fade-in">
            <div class="flex items-center justify-between relative z-10">
                <!-- Brand: pixel mark + wordmark -->
                <div class="flex items-center gap-3">
                    <img src="external-files/pixelogic-logo.png" alt="Pixel Logic" style="height:72px;width:auto;object-fit:contain;display:block;mix-blend-mode:screen;filter:brightness(1.2);">
                    <div class="flex flex-col">
                        <h1 id="app-title" class="text-2xl sm:text-3xl font-semibold tracking-wide text-white">Pixel Logic</h1>
                        <div id="app-subtitle" class="text-[12px] sm:text-sm text-cyan-300/90">LED &amp; Projector Patterns Generator</div>
                    </div>
                </div>
                <div class="flex items-center gap-3">
                    <button id="external-output-btn" class="px-3 py-2 rounded-lg bg-sky-700 hover:bg-sky-600 text-sm text-white" title="Show a pixel map or output canvas on another monitor">External Output</button>
                    <button id="about-btn" class="flex items-center gap-2 text-gray-300 hover:text-white transition-colors" aria-haspopup="dialog" aria-controls="about-modal" title="About Pixelogic" aria-expanded="false">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                        <span class="sr-only">About</span>
                    </button>
                    <div id="header-social-links" class="hidden items-center gap-2"></div>
                    <!-- Quick Theme Switcher (moved to sidebar; hide in header) -->
                    <div id="header-theme-swatches" class="hidden md:hidden items-center gap-2 bg-gray-800/70 border border-gray-700 rounded-full px-2 py-1">
                        <button class="w-5 h-5 rounded-full" data-accent="#6366f1" data-bg="#0a0a1a" title="Indigo" style="background-color:#6366f1"></button>
                        <button class="w-5 h-5 rounded-full" data-accent="#10b981" data-bg="#052b22" title="Emerald" style="background-color:#10b981"></button>
                        <button class="w-5 h-5 rounded-full" data-accent="#14b8a6" data-bg="#06292a" title="Teal" style="background-color:#14b8a6"></button>
                        <button class="w-5 h-5 rounded-full" data-accent="#f59e0b" data-bg="#2a1e06" title="Amber" style="background-color:#f59e0b"></button>
                        <button class="w-5 h-5 rounded-full" data-accent="#ef4444" data-bg="#2a0a0a" title="Red" style="background-color:#ef4444"></button>
                        <button class="w-5 h-5 rounded-full" data-accent="#3b82f6" data-bg="#081b2f" title="Sky" style="background-color:#3b82f6"></button>
                        <button class="w-5 h-5 rounded-full" data-accent="#8b5cf6" data-bg="#141028" title="Violet" style="background-color:#8b5cf6"></button>
                        <div class="w-px h-4 bg-gray-700 mx-1"></div>
                        <button id="header-theme-dark" class="text-xs px-2 py-0.5 rounded bg-gray-700 hover:bg-gray-600 text-gray-200" title="Dark">Dark</button>
                        <button id="header-theme-light" class="text-xs px-2 py-0.5 rounded bg-gray-700 hover:bg-gray-600 text-gray-200" title="Light">Light</button>
                        <div class="w-px h-4 bg-gray-700 mx-1"></div>
                        <button id="header-performance-lite" class="text-xs px-2 py-0.5 rounded bg-amber-600 hover:bg-amber-700 text-white" title="Lower preview resolution to reduce CPU/GPU">Lite</button>
                        <button id="header-performance-full" class="text-xs px-2 py-0.5 rounded bg-emerald-600 hover:bg-emerald-700 text-white" title="Sharper previews up to 8.3MP (4K); exports stay full resolution">Full</button>
                    </div>
                    <div id="app-scale-control" class="hidden md:flex flex-col items-end gap-1 px-3 py-2 border border-white/10 rounded-xl bg-white/5 backdrop-blur">
                        <div class="flex items-center gap-1 text-[10px] uppercase tracking-[0.2em] text-gray-400">
                            <span>Interface Scale</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <input type="number" id="app-scale-input" min="50" max="200" step="0.1" value="100"
                                   style="width:72px;background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.2);border-radius:6px;padding:2px 6px;font-size:12px;color:#67e8f9;font-weight:600;text-align:center;outline:none;-moz-appearance:textfield;appearance:textfield;"
                                   aria-label="Interface Scale">
                            <span class="text-[10px] text-gray-400" style="margin-left:-4px">%</span>
                            <button id="app-scale-reset" class="text-[10px] uppercase tracking-wide px-2 py-0.5 rounded border border-white/20 text-gray-200 hover:bg-white/10">Reset</button>
                        </div>
                    </div>
                    <span id="header-performance-status" class="hidden text-[11px] leading-none px-2 py-1 rounded bg-amber-600 text-white">Lite</span>
                </div>
            </div>

        </header>

        <!-- Main Navigation removed (duplicated in sidebar) -->

        <!-- Main Content Area -->
        <main>
            <div id="sheets-content" class="tab-content panel"></div>
            <div id="designer-content" class="tab-content active panel-soft"></div>
            <div id="visualizer-content" class="tab-content panel"></div>
            <div id="view3d-content" class="tab-content panel"></div>
            <div id="effects-content" class="tab-content panel-contrast"></div>
            
            <div id="canvas-content" class="tab-content panel"></div>
            <div id="led-patching-content" class="tab-content panel"></div>
            <div id="pdf-export-content" class="tab-content panel-contrast"></div>
            <div id="shows-content" class="tab-content panel"></div>
            <div id="circular-led-content" class="tab-content panel"></div>
            <div id="projector-test-pattern-content" class="tab-content panel"></div>
            <div id="devices-content" class="tab-content panel hidden" aria-hidden="true"></div>
            <div id="help-content" class="tab-content panel"></div>
            <div id="utility-tools-content" class="tab-content panel"></div>
            <div id="power-calc-content" class="tab-content panel"></div>
            <div id="video-converter-content" class="tab-content panel"></div>
        <script>
        // --- Projector Test Pattern Generator Tab Render ---
    function drawProjectorTestPattern(canvas, s, isPreview = true, circularOverride = null) {
            if (!canvas || !s) return;
            const ctx = canvas.getContext('2d');

            // Normalize numeric values
            const totalWidth = Math.max(1, parseInt(s.totalWidth, 10) || 1);
            const totalHeight = Math.max(1, parseInt(s.totalHeight, 10) || 1);
            const displayW = Math.max(1, parseInt(s.displayWidth, 10) || 1);
            const displayH = Math.max(1, parseInt(s.displayHeight, 10) || 1);
            const displaysX = Math.max(1, parseInt(s.displaysX, 10) || 1);
            const displaysY = Math.max(1, parseInt(s.displaysY, 10) || 1);
            // Use pixel overlaps from state (kept in sync with percent)
            let overlapX = s.overlap ? Math.max(0, Math.min(displayW - 1, parseInt(s.overlapX, 10) || 0)) : 0;
            let overlapY = s.overlap ? Math.max(0, Math.min(displayH - 1, parseInt(s.overlapY, 10) || 0)) : 0;

            // Clear and background in preview space
            const targetW = canvas.width;
            const targetH = canvas.height;
            ctx.setTransform(1, 0, 0, 1, 0, 0);
            ctx.clearRect(0, 0, targetW, targetH);
            ctx.fillStyle = '#000000';
            ctx.fillRect(0, 0, targetW, targetH);

            // Scale and center the logical pattern in the preview canvas
            const scale = Math.min(targetW / totalWidth, targetH / totalHeight) || 1;
            const offsetX = (targetW - totalWidth * scale) / 2;
            const offsetY = (targetH - totalHeight * scale) / 2;
            ctx.save();
            ctx.translate(offsetX, offsetY);
            ctx.scale(scale, scale);

            // Optional circular (dome) mask
            let clippedForCircle = false;
            const useCircular = (typeof circularOverride === 'boolean') ? circularOverride : !!s.circular;
            if (useCircular) {
                clippedForCircle = true;
                ctx.save();
                ctx.beginPath();
                const r = Math.min(totalWidth, totalHeight) / 2;
                ctx.arc(totalWidth / 2, totalHeight / 2, r, 0, Math.PI * 2);
                ctx.clip();
            }

            // Draw display rectangles, per-projector overlay, circles, names, and center numbers
            ctx.strokeStyle = '#ffffff';
            ctx.fillStyle = s.textColor;
            ctx.font = '48px Arial';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            for (let y = 0; y < displaysY; y++) {
                for (let x = 0; x < displaysX; x++) {
                    const posX = x * (displayW - overlapX);
                    const posY = y * (displayH - overlapY);
                    const idx = y * displaysX + x;

                            // Color overlay: per-projector only
                            let overlayHex = (Array.isArray(s.projectors) && s.projectors[idx] && s.projectors[idx].color)
                                ? s.projectors[idx].color
                                : null;
                    if (overlayHex) {
                        const m = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(overlayHex);
                        if (m) {
                            const r = parseInt(m[1], 16), g = parseInt(m[2], 16), b = parseInt(m[3], 16);
                            ctx.save();
                            const alpha = Math.max(0, Math.min(1, (Number(s.overlayOpacity) ?? 40) / 100));
                            ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${alpha})`;
                            ctx.fillRect(posX, posY, displayW, displayH);
                            ctx.restore();
                        }
                    }

                    // Outline
                    ctx.strokeRect(posX, posY, displayW, displayH);
                    // Selection highlight (preview-only)
                    if (s.selectedProjectorIndex === idx && (typeof isPreview === 'undefined' || isPreview)) {
                        ctx.save();
                        ctx.lineWidth = Math.max(3, (Number(s.widthPxN) || 1) + 2);
                        ctx.strokeStyle = '#ffffff';
                        ctx.strokeRect(posX + 1, posY + 1, displayW - 2, displayH - 2);
                        ctx.restore();
                    }

                    // Projector label centered in tile and index below it (no shadow/outline)
                    ctx.save();
                                    try {
                                        if (window.__debugPush) window.__debugPush(`led parse summary: brand=${hint.brand} model=${hint.model} pitch=${hint.pitchMm} res=${hint.panelResW}x${hint.panelResH} cab=${hint.cabinetWmm}x${hint.cabinetHmm}x${hint.cabinetDmm} curve=${hint.curveType} usage=${hint.usage} viewDistM=${hint.viewDistanceM} nits=${hint.brightnessNits} refresh=${hint.refreshHz}`);
                                    } catch(_) {}
                    const hasName = Array.isArray(s.projectors) && s.projectors[idx] && s.projectors[idx].name;
                    const baseFont = Math.max(12, Math.round(Math.min(displayW, displayH) * 0.12));
                    const name = hasName ? String(s.projectors[idx].name) : `P${idx + 1}`;
                    ctx.font = `${baseFont}px Arial`;
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'alphabetic';
                    const cx = posX + displayW / 2;
                    const cy = posY + displayH / 2 - Math.round(baseFont * 0.15);
                    ctx.fillStyle = s.textColor || '#ffffff';
                                        try {
                                            if (window.__debugPush) window.__debugPush(`projector parse summary: brand=${hint.brand} model=${hint.model} res=${hint.resolution} lumens=${hint.brightnessLumens} tech=${hint.technology} lens=${hint.lens} throw=${hint.throwRatio}`);
                                        } catch(_) {}
                    ctx.fillText(name, cx, cy);
                    // index small below
                    const idxFont = Math.max(10, Math.round(baseFont * 0.5));
                    ctx.font = `${idxFont}px Arial`;
                    ctx.fillText(String(idx + 1), cx, cy + Math.round(baseFont * 0.9));
                    ctx.restore();

                    // Per-projector circle centered in tile
                    if (s.circles) {
                        ctx.save();
                        ctx.strokeStyle = s.gridColor;
                        ctx.lineWidth = Math.max(1, Number(s.widthPxN) || 1);
                        const r = Math.min(displayW, displayH) / 2 - 10;
                        ctx.beginPath();
                        ctx.arc(posX + displayW / 2, posY + displayH / 2, Math.max(0, r), 0, Math.PI * 2);
                        ctx.stroke();
                        ctx.restore();
                    }
                    
                }
            }

            // Overlap shading (different color)
            if (s.overlap && (overlapX > 0 || overlapY > 0)) {
                const hexToRgb = (hex) => {
                    const m = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex || '#ffffff');
                    return m ? { r: parseInt(m[1], 16), g: parseInt(m[2], 16), b: parseInt(m[3], 16) } : { r: 255, g: 255, b: 255 };
                };
                const rgb = hexToRgb(s.overlapColor || '#ffffff');
                ctx.fillStyle = `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, 0.18)`;

                // Vertical overlap bands between columns
                if (overlapX > 0 && displaysX > 1) {
                    for (let i = 1; i < displaysX; i++) {
                        const xStart = i * (displayW - overlapX);
                        ctx.fillRect(xStart, 0, overlapX, totalHeight);
                    }
                }
                // Horizontal overlap bands between rows
                if (overlapY > 0 && displaysY > 1) {
                    for (let j = 1; j < displaysY; j++) {
                        const yStart = j * (displayH - overlapY);
                        ctx.fillRect(0, yStart, totalWidth, overlapY);
                    }
                }
            }

            // Grid
            if (s.gridSize > 0) {
                ctx.strokeStyle = s.gridColor;
                ctx.lineWidth = Math.max(1, Number(s.widthPxN) || 1);
                const gridSize = Math.max(1, Number(s.gridSize) || 1) * 20;
                for (let x = 0; x <= totalWidth; x += gridSize) {
                    ctx.beginPath();
                    ctx.moveTo(x, 0);
                    ctx.lineTo(x, totalHeight);
                    ctx.stroke();
                }
                for (let y = 0; y <= totalHeight; y += gridSize) {
                    ctx.beginPath();
                    ctx.moveTo(0, y);
                    ctx.lineTo(totalWidth, y);
                    ctx.stroke();
                }

                // Grid numbers (top and bottom)
                if (s.numbers) {
                    const centerX = totalWidth / 2;
                    const maxSteps = Math.floor(totalWidth / (2 * gridSize));
                    const fontSize = Math.min(48, Math.max(12, Math.round(gridSize * 0.5)));
                    ctx.font = `${fontSize}px Arial`;
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'alphabetic';
                    const topY = fontSize + 6;
                    const bottomY = totalHeight - 8;
                    for (let i = -maxSteps; i <= maxSteps; i++) {
                        if (i === 0) continue; // skip zero to match common patterns
                        const x = centerX + i * gridSize;
                        if (x < 0 || x > totalWidth) continue;
                        const label = String(i);
                        ctx.fillStyle = s.textColor || '#ffffff';
                        ctx.fillText(label, x, topY);
                        ctx.fillText(label, x, bottomY);
                    }

                    // Vertical grid numbers (left and right edges)
                    const centerY = totalHeight / 2;
                    const maxStepsY = Math.floor(totalHeight / (2 * gridSize));
                    const leftX = 16;
                    const rightX = totalWidth - 16;
                    ctx.textBaseline = 'middle';
                    // prevent overlaps near top/bottom corners
                    const vFontSize = fontSize;
                    ctx.font = `${vFontSize}px Arial`;
                    const avoidTop = vFontSize * 1.8; // room for top labels
                    const avoidBottom = totalHeight - vFontSize * 1.2;
                    for (let j = -maxStepsY; j <= maxStepsY; j++) {
                        if (j === 0) continue;
                        const y = centerY + j * gridSize;
                        if (y < 0 || y > totalHeight) continue;
                        if (y < avoidTop || y > avoidBottom) continue;
                        const vLabel = String(j);
                        // Left side (align left so text extends inward)
                        ctx.textAlign = 'left';
                        ctx.fillStyle = s.textColor || '#ffffff';
                        ctx.fillText(vLabel, leftX, y);
                        // Right side (align right so text extends inward)
                        ctx.textAlign = 'right';
                        ctx.fillText(vLabel, rightX, y);
                    }
                }
            }

            // Global concentric circles (disabled by default)
            if (s.circlesGlobal) {
                ctx.strokeStyle = s.gridColor;
                ctx.lineWidth = Math.max(1, Number(s.widthPxN) || 1);
                const centerX = totalWidth / 2;
                const centerY = totalHeight / 2;
                const maxRadius = Math.min(totalWidth, totalHeight) / 2;
                for (let r = maxRadius / 10; r < maxRadius; r += maxRadius / 10) {
                    ctx.beginPath();
                    ctx.arc(centerX, centerY, r, 0, 2 * Math.PI);
                    ctx.stroke();
                }
            }

            // Hatching overlay with styles
            if (s.hatching) {
                const density = Math.max(1, Math.min(10, Number(s.hatchingDensity) || 1));
                const base = Math.max(10, (Number(s.gridSize) || 1) * 20);
                const spacing = Math.max(6, Math.round(base / density));
                const style = s.hatchingStyle || 'cross';
                ctx.save();
                ctx.strokeStyle = s.gridColor;
                ctx.globalAlpha = 0.35;
                ctx.lineWidth = 1;
                if (style === 'forward' || style === 'cross') {
                    for (let d = -totalHeight; d < totalWidth; d += spacing) {
                        ctx.beginPath();
                        ctx.moveTo(d, 0);
                        ctx.lineTo(d + totalHeight, totalHeight);
                        ctx.stroke();
                    }
                }
                if (style === 'backward' || style === 'cross') {
                    for (let d = 0; d < totalWidth + totalHeight; d += spacing) {
                        ctx.beginPath();
                        ctx.moveTo(d, 0);
                        ctx.lineTo(d - totalHeight, totalHeight);
                        ctx.stroke();
                    }
                }
                ctx.restore();
            }

            // Image name label (centered, with offsets) and total size under it
            if (s.imageName) {
                const nameSize = Math.max(8, Number(s.nameFontSize) || 48);
                ctx.textAlign = 'center';
                const offx = Number(s.nameOffsetXPercent) || 0;
                const offy = Number(s.nameOffsetYPercent) || 0;
                const cx = Math.round(totalWidth / 2 + (totalWidth * offx / 100));
                const cy = Math.round(totalHeight / 2 + (totalHeight * offy / 100));
                // Image name
                ctx.textBaseline = 'alphabetic';
                ctx.font = `${nameSize}px Arial`;
                ctx.fillStyle = s.textColor || '#ffffff';
                ctx.fillText(String(s.imageName), cx, cy);
                // Total size below
                const totalLabel = `${Math.round(totalWidth)} x ${Math.round(totalHeight)}`;
                const subSize = Math.max(18, Math.round(nameSize * 0.7));
                ctx.font = `${subSize}px Arial`;
                ctx.textBaseline = 'top';
                const gap = Math.round(nameSize * 0.25);
                ctx.fillText(totalLabel, cx, cy + gap);
            }

            // Remove circular clip and draw border
            if (clippedForCircle) {
                ctx.restore();
                ctx.strokeStyle = s.gridColor;
                ctx.lineWidth = Math.max(1, Number(s.widthPxN) || 1);
                ctx.beginPath();
                const r = Math.min(totalWidth, totalHeight) / 2 - ctx.lineWidth / 2;
                ctx.arc(totalWidth / 2, totalHeight / 2, r, 0, Math.PI * 2);
                ctx.stroke();
            }

            // Logo (bottom-right) if enabled and loaded
            if (s.logo && s._logoImg && s._logoImg.complete) {
                try {
                    const img = s._logoImg;
                    const margin = 20;
                    const availW = totalWidth - margin * 2;
                    const availH = totalHeight - margin * 2;
                    const base = Math.min(availW, availH);
                    const pct = Math.max(0.05, Math.min(0.25, (Number(s.logoSize) || 5) / 10 * 0.2 + 0.05));
                    const target = base * pct;
                    const ar = img.naturalWidth / img.naturalHeight;
                    let drawW = target, drawH = target;
                    if (ar >= 1) { drawH = target / ar; } else { drawW = target * ar; }
                    const dx = totalWidth - margin - drawW;
                    const dy = totalHeight - margin - drawH;
                    ctx.drawImage(img, dx, dy, drawW, drawH);
                } catch (_) {}
            }

            ctx.restore();
        }
        // Dedicated Dome renderer: uses explicit diameter/radius independent of rectangular totals
        function drawDomeTestPattern(canvas, s) {
            if (!canvas || !s) return;
            const ctx = canvas.getContext('2d');
            const D = Math.max(1, Number(s.domeDiameterPx) || Math.min(Number(s.totalWidth) || 1, Number(s.totalHeight) || 1));
            const targetW = canvas.width;
            const targetH = canvas.height;
            ctx.setTransform(1, 0, 0, 1, 0, 0);
            ctx.clearRect(0, 0, targetW, targetH);
            ctx.fillStyle = '#000000';
            ctx.fillRect(0, 0, targetW, targetH);

            // Scale and center a D x D logical square into canvas
            const scale = Math.min(targetW / D, targetH / D) || 1;
            const offsetX = (targetW - D * scale) / 2;
            const offsetY = (targetH - D * scale) / 2;
            ctx.save();
            ctx.translate(offsetX, offsetY);
            ctx.scale(scale, scale);

            // Circular clip using explicit diameter
            ctx.save();
            ctx.beginPath();
            const r = D / 2;
            ctx.arc(D / 2, D / 2, r, 0, Math.PI * 2);
            ctx.clip();

            // Grid inside circle (cartesian)
            if (s.gridSize > 0) {
                ctx.strokeStyle = s.gridColor;
                ctx.lineWidth = Math.max(1, Number(s.widthPxN) || 1);
                const gridSize = Math.max(1, Number(s.gridSize) || 1) * 20;
                for (let x = 0; x <= D; x += gridSize) {
                    ctx.beginPath();
                    ctx.moveTo(x, 0);
                    ctx.lineTo(x, D);
                    ctx.stroke();
                }
                for (let y = 0; y <= D; y += gridSize) {
                    ctx.beginPath();
                    ctx.moveTo(0, y);
                    ctx.lineTo(D, y);
                    ctx.stroke();
                }

                if (s.numbers) {
                    const centerX = D / 2;
                    const maxSteps = Math.floor(D / (2 * gridSize));
                    const fontSize = Math.min(48, Math.max(12, Math.round(gridSize * 0.5)));
                    ctx.font = `${fontSize}px Arial`;
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'alphabetic';
                    const topY = fontSize + 6;
                    const bottomY = D - 8;
                    for (let i = -maxSteps; i <= maxSteps; i++) {
                        if (i === 0) continue;
                        const x = centerX + i * gridSize;
                        if (x < 0 || x > D) continue;
                        const label = String(i);
                        ctx.fillStyle = s.textColor || '#ffffff';
                        ctx.fillText(label, x, topY);
                        ctx.fillText(label, x, bottomY);
                    }

                    const centerY = D / 2;
                    const maxStepsY = Math.floor(D / (2 * gridSize));
                    const leftX = 16;
                    const rightX = D - 16;
                    ctx.textBaseline = 'middle';
                    const vFontSize = fontSize;
                    ctx.font = `${vFontSize}px Arial`;
                    const avoidTop = vFontSize * 1.8;
                    const avoidBottom = D - vFontSize * 1.2;
                    for (let j = -maxStepsY; j <= maxStepsY; j++) {
                        if (j === 0) continue;
                        const y = centerY + j * gridSize;
                        if (y < 0 || y > D) continue;
                        if (y < avoidTop || y > avoidBottom) continue;
                        const vLabel = String(j);
                        ctx.textAlign = 'left';
                        ctx.fillStyle = s.textColor || '#ffffff';
                        ctx.fillText(vLabel, leftX, y);
                        ctx.textAlign = 'right';
                        ctx.fillText(vLabel, rightX, y);
                    }
                }
            }

            // Hatching inside circle
            if (s.hatching) {
                const density = Math.max(1, Math.min(10, Number(s.hatchingDensity) || 1));
                const base = Math.max(10, (Number(s.gridSize) || 1) * 20);
                const spacing = Math.max(6, Math.round(base / density));
                const style = s.hatchingStyle || 'cross';
                ctx.save();
                ctx.strokeStyle = s.gridColor;
                ctx.globalAlpha = 0.35;
                ctx.lineWidth = 1;
                if (style === 'forward' || style === 'cross') {
                    for (let d = -D; d < D; d += spacing) {
                        ctx.beginPath();
                        ctx.moveTo(d, 0);
                        ctx.lineTo(d + D, D);
                        ctx.stroke();
                    }
                }
                if (style === 'backward' || style === 'cross') {
                    for (let d = 0; d < D + D; d += spacing) {
                        ctx.beginPath();
                        ctx.moveTo(d, 0);
                        ctx.lineTo(d - D, D);
                        ctx.stroke();
                    }
                }
                ctx.restore();
            }

            // Name and diameter label
            if (s.imageName) {
                const nameSize = Math.max(8, Number(s.nameFontSize) || 48);
                ctx.textAlign = 'center';
                const offx = Number(s.nameOffsetXPercent) || 0;
                const offy = Number(s.nameOffsetYPercent) || 0;
                const cx = Math.round(D / 2 + (D * offx / 100));
                const cy = Math.round(D / 2 + (D * offy / 100));
                ctx.textBaseline = 'alphabetic';
                ctx.font = `${nameSize}px Arial`;
                ctx.fillStyle = s.textColor || '#ffffff';
                ctx.fillText(String(s.imageName), cx, cy);
                const totalLabel = `Ø ${Math.round(D)} px`;
                const subSize = Math.max(18, Math.round(nameSize * 0.7));
                ctx.font = `${subSize}px Arial`;
                ctx.textBaseline = 'top';
                const gap = Math.round(nameSize * 0.25);
                ctx.fillText(totalLabel, cx, cy + gap);
            }

            // Logo bottom-right within circle bounds
            if (s.logo && s._logoImg && s._logoImg.complete) {
                try {
                    const img = s._logoImg;
                    const margin = 20;
                    const avail = D - margin * 2;
                    const target = avail * (Math.max(0.05, Math.min(0.25, (Number(s.logoSize) || 5) / 10 * 0.2 + 0.05)));
                    const ar = img.naturalWidth / img.naturalHeight;
                    let drawW = target, drawH = target;
                    if (ar >= 1) { drawH = target / ar; } else { drawW = target * ar; }
                    const dx = D - margin - drawW;
                    const dy = D - margin - drawH;
                    ctx.drawImage(img, dx, dy, drawW, drawH);
                } catch (_) {}
            }

            // Remove clip and draw circle border
            ctx.restore();
            ctx.strokeStyle = s.gridColor;
            ctx.lineWidth = Math.max(1, Number(s.widthPxN) || 1);
            ctx.beginPath();
            ctx.arc(D / 2, D / 2, D / 2 - ctx.lineWidth / 2, 0, Math.PI * 2);
            ctx.stroke();
            ctx.restore();
        }
    function renderProjectorTestPattern() {
            const container = document.getElementById('projector-test-pattern-content');
            if (!container) return;
            // Local state for the generator
            if (!window.projectorTestPatternState) {
                const storedRes = (() => {
                    try { return JSON.parse(localStorage.getItem('ptp-custom-resolutions') || '[]') || []; } catch(_) { return []; }
                })();
                window.projectorTestPatternState = {
                    imageName: 'Name your testpattern',
                    displayWidth: 1920,
                    displayHeight: 1080,
                    displaysX: 2,
                    displaysY: 1,
                    overlapX: 190,
                    overlapY: 0,
                    totalWidth: 3650,
                    totalHeight: 1080,
                    overlap: true,
                    logo: false,
                    gridSize: 5,
                    widthPxN: 5,
                    gridColor: '#ff0000',
                    textColor: '#ffffff',
                    circles: true,
                    hatching: false,
                    overlapUnit: 'px',
                    overlapXPercent: 0,
                    overlapYPercent: 0,
                    logoFile: null,
                    logoSize: 5,
                    circular: false,
                    nameFontSize: 48,
                    nameOffsetXPercent: 0,
                    nameOffsetYPercent: 0,
                    numbers: true,
                    overlapColor: '#ffffff',
                    projectors: [],
                    circlesGlobal: false,
                    customResList: Array.isArray(storedRes) ? storedRes : [],
                    overlayOpacity: 40,
                    hatchingStyle: 'cross',
                    hatchingDensity: 5,
                    selectedProjectorIndex: -1,
                    uiSubTab: 'calc-flat',
                    previewZoom: 1,
                    // Flat calculator defaults
                    calcFlat: {
                        screenWidthMeters: 10,
                        screenHeightMeters: 5.625,
                        calcMode: 'distanceToRatio', // 'distanceToRatio' | 'ratioToDistance'
                        throwLow: 8,
                        throwHigh: 8,
                        autoCalc: true,
                        numProjectorsHorizontal: 2,
                        overlapPercentHorizontal: 25,
                        numProjectorsVertical: 2,
                        overlapPercentVertical: 25,
                        projectorWidthPx: 1920,
                        projectorHeightPx: 1080
                    },
                    // Circular/semi calculator defaults
                    calcCirc: {
                        shape: 'circle', // 'circle' | 'semi'
                        diameter: 8,
                        screenHeight: 3,
                        projectionSide: 'outside', // 'outside' | 'inside'
                        safeAngleDeg: 90,
                        arcAngleDeg: 120,
                        calcMode: 'distanceToRatio',
                        throwLow: 8,
                        throwHigh: 8,
                        numProjectorsHorizontal: 4,
                        overlapPercentHorizontal: 20,
                        numProjectorsVertical: 1,
                        overlapPercentVertical: 0,
                        autoCalcV: false,
                        projectorWidthPx: 1920,
                        projectorHeightPx: 1080
                    },
                    // Curved screen projection defaults
                    calcCurve: {
                        screenWidthMeters: 10,
                        screenHeightMeters: 3,
                        curveDepthMeters: 1,
                        curveType: 'concave',
                        projectorWidthPx: 1920,
                        projectorHeightPx: 1080,
                        numProjectors: 3,
                        numProjectorsV: 1,
                        overlapPercent: 15,
                        overlapPercentV: 10,
                        autoCalc: false,
                        safeAngleDeg: 40,
                        calcMode: 'ratioToDistance',
                        throwLow: 1.5,
                        throwHigh: 2.1
                    },
                    // Screen (physical) inputs
                    screenWidthValue: '',
                    screenHeightValue: '',
                    screenUnit: 'm', // m | ft | mm
                    // Dome-specific
                    domeDiameterPx: null,
                    domeDiameterLock: true,
                    domeDiameterValue: null,
                    domeDiameterUnit: 'm',
                    domePixelsPerMeter: 500
                };
            }
            const s = window.projectorTestPatternState;
            // Ensure current subtab is valid (screen tab removed)
            if (!['settings','calc-flat','calc-curve','calc-circ'].includes(s.uiSubTab)) {
                s.uiSubTab = 'settings';
            }
            if (!s.calcCirc.projectionSide) s.calcCirc.projectionSide = 'outside';
            if (!s.calcCirc.safeAngleDeg) s.calcCirc.safeAngleDeg = 90;
            if (!s.calcCirc.arcAngleDeg) s.calcCirc.arcAngleDeg = 120;
            // Ensure projector list length matches current layout
            const ensureProjectors = () => {
                const nx = Math.max(1, Number(s.displaysX) || 1);
                const ny = Math.max(1, Number(s.displaysY) || 1);
                const needed = nx * ny;
                const palette = ['#e6194b','#3cb44b','#ffe119','#0082c8','#f58231','#911eb4','#46f0f0','#f032e6','#d2f53c','#fabebe','#008080','#e6beff','#aa6e28','#fffac8','#800000','#aaffc3','#808000','#ffd8b1','#000080','#808080'];
                if (!Array.isArray(s.projectors)) s.projectors = [];
                let changed = false;
                while (s.projectors.length < needed) {
                    const i = s.projectors.length;
                    s.projectors.push({ name: `Projector ${i + 1}`, color: palette[i % palette.length] });
                    changed = true;
                }
                while (s.projectors.length > needed) { s.projectors.pop(); changed = true; }
                return changed;
            };
            ensureProjectors();
            // Helpers for dome unit conversions
            const unitToMeters = (v, unit) => unit === 'ft' ? (v * 0.3048) : v;
            const metersToUnit = (m, unit) => unit === 'ft' ? (m / 0.3048) : m;
            const fmtDomeVal = (n, unit) => {
                const dp = (unit === 'ft') ? 2 : 3;
                const val = Number.isFinite(n) ? n : 0;
                return String(val.toFixed(dp));
            };
            // Initialize dome diameter once or when lock is enabled
            if (s.domeDiameterPx == null || s.domeDiameterLock) {
                const tw0 = Math.max(1, Number(s.totalWidth) || 1);
                const th0 = Math.max(1, Number(s.totalHeight) || 1);
                s.domeDiameterPx = Math.min(tw0, th0);
            }
            if (s.domeDiameterValue == null) {
                const meters = (Math.max(1, Number(s.domePixelsPerMeter) || 1) > 0) ? s.domeDiameterPx / Math.max(1, Number(s.domePixelsPerMeter) || 1) : 0;
                s.domeDiameterValue = metersToUnit(meters, s.domeDiameterUnit || 'm');
            }
            const defaultResolutions = [
                { w: 800, h: 600, label: '800×600 (4:3)' },
                { w: 1024, h: 768, label: '1024×768 (4:3)' },
                { w: 1152, h: 864, label: '1152×864 (4:3)' },
                { w: 1280, h: 960, label: '1280×960 (4:3)' },
                { w: 1400, h: 1050, label: '1400×1050 (4:3)' },
                { w: 1600, h: 1200, label: '1600×1200 (4:3)' },
                { w: 2048, h: 1536, label: '2048×1536 (4:3)' },
                { w: 1280, h: 1024, label: '1280×1024 (5:4)' },
                { w: 2560, h: 2048, label: '2560×2048 (5:4)' },
                { w: 1280, h: 720, label: '1280×720 (16:9)' },
                { w: 1366, h: 768, label: '1366×768 (16:9)' },
                { w: 1600, h: 900, label: '1600×900 (16:9)' },
                { w: 1920, h: 1080, label: '1920×1080 (16:9)' },
                { w: 2048, h: 1152, label: '2048×1152 (16:9)' },
                { w: 3840, h: 2160, label: '3840×2160 (16:9)' },
                { w: 1280, h: 800, label: '1280×800 (16:10)' },
                { w: 1440, h: 900, label: '1440×900 (16:10)' },
                { w: 1680, h: 1050, label: '1680×1050 (16:10)' },
                { w: 1920, h: 1200, label: '1920×1200 (16:10)' },
                { w: 2560, h: 1600, label: '2560×1600 (16:10)' },
                { w: 2048, h: 1080, label: '2048×1080 (17:9)' },
                { w: 4096, h: 2160, label: '4096×2160 (17:9)' },
                { w: 800, h: 480, label: '800×480 (5:3)' },
                { w: 1280, h: 768, label: '1280×768 (5:3)' },
                { w: 1080, h: 1920, label: '1080×1920 (9:16)' },
                { w: 1200, h: 1920, label: '1200×1920 (10:16)' },
                { w: 2160, h: 3840, label: '2160×3840 (9:16)' },
                { w: 2160, h: 4096, label: '2160×4096 (10:17)' }
            ];
            const customRes = Array.isArray(s.customResList) ? s.customResList : [];
            const allRes = [...defaultResolutions, ...customRes.map(({w,h}) => ({ w, h, label: `Custom (${w}×${h})` }))];
            const buildOptions = (selW, selH) => {
                const matchIdx = allRes.findIndex(r => r.w === Number(selW) && r.h === Number(selH));
                const isCustomSelection = matchIdx === -1;
                const optionsHtml = allRes.map((r, idx) => {
                    const selected = (!isCustomSelection && idx === matchIdx) ? 'selected' : '';
                    return `<option value="${r.w}x${r.h}" ${selected}>${r.label}</option>`;
                }).join('') + `<option value="__custom__" ${isCustomSelection ? 'selected' : ''}>Custom…</option>`;
                return { optionsHtml, isCustomSelection };
            };
            const settingsOptions = buildOptions(s.displayWidth, s.displayHeight);
            const flatOptions = buildOptions(s.calcFlat?.projectorWidthPx, s.calcFlat?.projectorHeightPx);
            container.innerHTML = `
                <div class="p-6 ptp-theme-amber">
                    <!-- Sub-tabs -->
                    <nav class="rounded-xl p-2 flex flex-wrap gap-2 mb-4">
                        ${['calc-flat','calc-curve','calc-circ','settings'].map(key => {
                            const labels = {
                                settings:'Projector Test Pattern',
                                'calc-flat':'Flat Screen Calculator',
                                'calc-curve':'Curve Screen Projection',
                                'calc-circ':'Circular / Semi-circular Calculator'
                            };
                            const tips = {
                                settings: 'Screen details, grid/colors, logo, and projectors settings',
                                'calc-flat': 'Compute pixel pitch, resolution, overlap and throw for flat screens',
                                'calc-curve': 'Compute curve radius, arc length, and angle from width and depth',
                                'calc-circ': 'Compute pixel pitch and throw for circular / semi-circular screens'
                            };
                            const active = (s.uiSubTab === key) ? 'text-white bg-amber-600/30' : 'text-gray-300 bg-amber-600/0 hover:text-white hover:bg-amber-600/20';
                            return `<button data-subtab="${key}" title="${tips[key]}" class="ptp-subtab flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg transition-colors duration-200 ${active}">${labels[key]}</button>`;
                        }).join('')}
                    </nav>
                    <!-- Core PTP layout -->
                    <div id="ptp-core-layout" class="${s.uiSubTab.startsWith('calc-') ? 'hidden' : ''} flex flex-col lg:flex-row gap-8 items-start">
                        <!-- Left: Controls stacked vertically -->
                        <div class="flex flex-col gap-8 w-full lg:w-[400px] min-w-[320px]">
                            <div id="ptp-panel-settings" class="${s.uiSubTab==='settings' ? '' : 'hidden'} bg-slate-900/80 rounded-xl border border-amber-500/40 p-5 shadow-2xl space-y-5">
                                <div class="text-xl font-semibold text-amber-400 mb-3">Projector Test Pattern</div>
                                <div class="grid grid-cols-2 gap-5">
                                    <label class="flex flex-col text-sm text-gray-200 col-span-2">Native Resolution<select id="ptp-native-res" class="mt-1 rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500">${settingsOptions.optionsHtml}</select></label>
                                    <div id="ptp-custom-res-controls" class="col-span-2 flex items-end gap-3 mt-1 ${settingsOptions.isCustomSelection ? '' : 'hidden'}">
                                        <div class="flex gap-2 items-center">
                                            <label class="flex flex-col text-sm text-gray-200">Custom W<input id="ptp-custom-w" type="number" min="1" class="mt-1 rounded-md px-3 py-2 w-28 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" placeholder="e.g., 1536"></label>
                                            <span class="text-gray-400 pb-2">x</span>
                                            <label class="flex flex-col text-sm text-gray-200">Custom H<input id="ptp-custom-h" type="number" min="1" class="mt-1 rounded-md px-3 py-2 w-28 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" placeholder="e.g., 2048"></label>
                                        </div>
                                        <button id="ptp-add-custom-res" class="h-10 px-4 bg-amber-600 text-white font-semibold rounded-md hover:bg-amber-700">Add</button>
                                    </div>
                                    <label class="flex flex-col text-sm text-gray-200 col-span-2">Image Name<input id="ptp-image-name" type="text" class="mt-1 rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.imageName}" placeholder="Name your testpattern"></label>
                                    <label class="flex flex-col text-sm text-gray-200 col-span-2">Image Font Size<input id="ptp-name-fontsize" type="range" min="8" max="200" step="1" class="mt-2 h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer" value="${s.nameFontSize}"></label>
                                    <label class="flex flex-col text-sm text-gray-200">Name Offset X (<span id="ptp-name-offx-label">${s.nameOffsetXPercent ?? 0}</span>%)
                                        <input id="ptp-name-offx" type="range" min="-50" max="50" step="1" class="mt-2 h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer" value="${s.nameOffsetXPercent ?? 0}">
                                    </label>
                                    <label class="flex flex-col text-sm text-gray-200">Name Offset Y (<span id="ptp-name-offy-label">${s.nameOffsetYPercent ?? 0}</span>%)
                                        <input id="ptp-name-offy" type="range" min="-50" max="50" step="1" class="mt-2 h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer" value="${s.nameOffsetYPercent ?? 0}">
                                    </label>
                                </div>

                                

                                <div class="grid grid-cols-2 gap-5">
                                    
                                    <label class="flex flex-col text-sm text-gray-200">Display size [px]<div class="flex gap-2 mt-1"><input id="ptp-display-width" type="number" class="rounded-md px-3 py-2 w-full bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.displayWidth}"><span class="text-gray-400 self-center">x</span><input id="ptp-display-height" type="number" class="rounded-md px-3 py-2 w-full bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.displayHeight}"></div></label>
                                    <label class="flex flex-col text-sm text-gray-200">Displays<div class="flex gap-2 mt-1"><input id="ptp-displays-x" type="number" class="rounded-md px-3 py-2 w-full bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.displaysX}"><span class="text-gray-400 self-center">x</span><input id="ptp-displays-y" type="number" class="rounded-md px-3 py-2 w-full bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.displaysY}"></div></label>
                                    <div class="flex flex-col text-sm text-gray-200 gap-2 col-span-2">
                                        <span>Overlap</span>
                                        <div class="flex flex-wrap items-center gap-3 w-full">
                                            <div class="flex items-center gap-2">
                                                <span class="text-gray-400 w-4">X</span>
                                                <div class="flex items-center gap-1">
                                                    <input id="ptp-overlap-x-px" type="number" class="rounded-md px-3 py-2 w-24 text-base bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.overlapX || 0}">
                                                    <span class="text-gray-400">px</span>
                                                </div>
                                                <div class="flex items-center gap-1">
                                                    <input id="ptp-overlap-x-pct" type="number" class="rounded-md px-3 py-2 w-20 text-base bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.overlapXPercent || 0}">
                                                    <span class="text-gray-400">%</span>
                                                </div>
                                            </div>
                                            <div class="flex items-center gap-2">
                                                <span class="text-gray-400 w-4">Y</span>
                                                <div class="flex items-center gap-1">
                                                    <input id="ptp-overlap-y-px" type="number" class="rounded-md px-3 py-2 w-24 text-base bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.overlapY || 0}">
                                                    <span class="text-gray-400">px</span>
                                                </div>
                                                <div class="flex items-center gap-1">
                                                    <input id="ptp-overlap-y-pct" type="number" class="rounded-md px-3 py-2 w-20 text-base bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.overlapYPercent || 0}">
                                                    <span class="text-gray-400">%</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <label class="flex flex-col text-sm text-gray-200">Total size [px]<div class="flex gap-2 mt-1"><input id="ptp-total-width" type="number" class="rounded-md px-3 py-2 w-full bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.totalWidth}"><span class="text-gray-400 self-center">x</span><input id="ptp-total-height" type="number" class="rounded-md px-3 py-2 w-full bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.totalHeight}"></div></label>
                                </div>
                                
                                <div class="flex gap-4 mt-3 flex-wrap">
                                    <label class="flex items-center gap-2 text-sm text-gray-200"><input id="ptp-overlap" type="checkbox" class="accent-amber-500 w-4 h-4" ${s.overlap ? 'checked' : ''}> Overlap</label>
                                    <label class="flex items-center gap-2 text-sm text-gray-200"><input id="ptp-logo" type="checkbox" class="accent-amber-500 w-4 h-4" ${s.logo ? 'checked' : ''}> Logo</label>
                                    <label class="flex items-center gap-2 text-sm text-gray-200"><input id="ptp-circular" type="checkbox" class="accent-amber-500 w-4 h-4" ${s.circular ? 'checked' : ''}> Circular (Dome) Pattern</label>
                                </div>

                                <div class="border-t border-amber-500/20 pt-5">
                                    <div id="ptp-panel-grid" class="bg-slate-900/60 rounded-xl border border-amber-500/30 p-5 shadow-xl space-y-5">
                                        <div class="text-xl font-semibold text-amber-400 mb-3">Grid & Colors</div>
                                        <div class="grid grid-cols-2 gap-5">
                                            <label class="flex flex-col text-sm text-gray-200">Grid Size<input id="ptp-gridsize" type="range" min="1" max="10" value="${s.gridSize}" class="mt-2 h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer"></label>
                                            <label class="flex flex-col text-sm text-gray-200">Line Width (px)<input id="ptp-widthpxn" type="range" min="1" max="10" value="${s.widthPxN}" class="mt-2 h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer"></label>
                                            <label class="flex flex-col text-sm text-gray-200 items-center">Grid Color<input id="ptp-gridcolor" type="color" value="${s.gridColor}" class="mt-2 w-12 h-12 p-0 border-none rounded-md cursor-pointer"></label>
                                            <label class="flex flex-col text-sm text-gray-200 items-center">Text Color<input id="ptp-textcolor" type="color" value="${s.textColor}" class="mt-2 w-12 h-12 p-0 border-none rounded-md cursor-pointer"></label>
                                            <label class="flex flex-col text-sm text-gray-200 items-center col-span-2">Overlap Color<input id="ptp-overlapcolor" type="color" value="${s.overlapColor}" class="mt-2 w-12 h-12 p-0 border-none rounded-md cursor-pointer"></label>
                                        </div>
                                        <div class="grid grid-cols-2 gap-4 mt-3">
                                            <label class="flex items-center gap-2 text-sm text-gray-200"><input id="ptp-circles" type="checkbox" class="accent-amber-500 w-4 h-4" ${s.circles ? 'checked' : ''}> Circles</label>
                                            <label class="flex items-center gap-2 text-sm text-gray-200"><input id="ptp-hatching" type="checkbox" class="accent-amber-500 w-4 h-4" ${s.hatching ? 'checked' : ''}> Hatching</label>
                                            <label class="flex items-center gap-2 text-sm text-gray-200 col-span-2"><input id="ptp-numbers" type="checkbox" class="accent-amber-500 w-4 h-4" ${s.numbers ? 'checked' : ''}> Grid Numbers</label>
                                        </div>
                                        <div id="ptp-hatching-controls" class="grid grid-cols-2 gap-5 mt-2 ${s.hatching ? '' : 'opacity-50 pointer-events-none'}">
                                            <label class="flex flex-col text-sm text-gray-200 col-span-2">Hatching Style
                                                <select id="ptp-hatching-style" class="mt-1 rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500">
                                                    <option value="cross" ${s.hatchingStyle === 'cross' ? 'selected' : ''}>Cross (both diagonals)</option>
                                                    <option value="forward" ${s.hatchingStyle === 'forward' ? 'selected' : ''}>Forward /</option>
                                                    <option value="backward" ${s.hatchingStyle === 'backward' ? 'selected' : ''}>Backward \\</option>
                                                </select>
                                            </label>
                                            <label class="flex flex-col text-sm text-gray-200 col-span-2">
                                                <div class="flex items-center gap-2">
                                                    <span>Hatching Density:</span>
                                                    <span id="ptp-hatching-density-label" class="tabular-nums">${s.hatchingDensity}</span>
                                                </div>
                                                <input id="ptp-hatching-density" type="range" min="1" max="10" value="${s.hatchingDensity}" class="mt-2 h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer">
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <div class="border-t border-amber-500/20 pt-5">
                                    <div id="ptp-panel-logo" class="bg-slate-900/60 rounded-xl border border-amber-500/30 p-5 shadow-xl space-y-5">
                                        <div class="text-xl font-semibold text-amber-400 mb-3">Logo</div>
                                        <div class="flex flex-col gap-4">
                                            <label class="flex flex-col text-sm text-gray-200">Logo File<input id="ptp-logo-file" type="file" class="mt-2 text-sm text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-gray-700 file:text-gray-200 hover:file:bg-gray-600"></label>
                                            <label class="flex flex-col text-sm text-gray-200">Logo Size<input id="ptp-logo-size" type="range" min="1" max="10" value="${s.logoSize}" class="mt-2 h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer"></label>
                                        </div>
                                    </div>
                                </div>

                                <div class="border-t border-amber-500/20 pt-5">
                                    <div id="ptp-panel-projectors" class="bg-slate-900/60 rounded-xl border border-amber-500/30 p-5 shadow-xl space-y-4">
                                        <div class="text-xl font-semibold text-amber-400">Projectors</div>
                                        <div class="flex items-center gap-3">
                                            <label for="ptp-overlay-opacity" class="text-sm text-gray-200">Overlay Opacity (<span id="ptp-overlay-opacity-label">${s.overlayOpacity ?? 40}</span>%)</label>
                                            <input id="ptp-overlay-opacity" type="range" min="0" max="100" value="${s.overlayOpacity ?? 40}" class="flex-1 h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer">
                                        </div>
                                        <div class="flex flex-col gap-3 max-h-[320px] overflow-auto pr-2">
                                            ${s.projectors.map((p, i) => `
                                                <div class=\"flex items-center gap-3\">
                                                    <span class=\"text-xs text-gray-400 w-16\">#${i+1}</span>
                                                    <input id=\"ptp-proj-name-${i}\" type=\"text\" value=\"${p.name || ''}\" class=\"flex-1 rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500\" placeholder=\"Projector ${i+1}\">
                                                    <input id=\"ptp-proj-color-${i}\" type=\"color\" value=\"${p.color || '#ffffff'}\" class=\"w-10 h-10 p-0 border-none rounded-md cursor-pointer\">
                                                </div>
                                            `).join('')}
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <button id="ptp-save-image" class="mt-4 w-full bg-amber-600 text-white font-bold py-3 rounded-lg shadow-lg hover:bg-amber-700 transition-transform transform hover:scale-105">Save Image</button>
                            <div class="mt-3 flex flex-col gap-2">
                                <button id="fc-generate-pdf" class="w-full px-4 py-2 rounded-lg bg-amber-600 hover:bg-amber-700 text-white font-semibold">Projector Test Pattern PDF</button>
                                <span id="fc-pdf-status" class="text-xs text-gray-400"></span>
                            </div>
                        </div>
                        <!-- Right: Visualizer -->
                        <div class="flex-1 flex flex-col gap-4 pl-sticky-preview">
                            <div class="ptp-toolbar">
                                <div class="ptp-toolbar-title">Live Preview: Main Backdrop</div>
                                <div class="ptp-toolbar-actions">
                                    <button class="ptp-toolbar-btn" data-ptp-zoom="out" title="Zoom out">−</button>
                                    <button class="ptp-toolbar-btn" data-ptp-zoom="in" title="Zoom in">+</button>
                                    <button class="ptp-toolbar-btn" data-ptp-zoom="fit" title="Fit to view">Fit</button>
                                    <button class="ptp-toolbar-btn" data-ptp-zoom="actual" title="Actual size">Actual</button>
                                    <span id="ptp-zoom-label" class="ptp-toolbar-pill">100%</span>
                                    <button id="ptp-save-png" class="ptp-toolbar-btn success">Save PNG</button>
                                    <button id="ptp-save-all-pngs" class="ptp-toolbar-btn">Save All PNGs</button>
                                </div>
                            </div>
                            <div class="bg-black preview-grid rounded-xl border border-amber-500/40 p-3 flex items-center justify-center min-h-[550px] shadow-2xl">
                                <div id="ptp-preview-stage" class="ptp-preview-stage preview-grid">
                                    <div id="ptp-preview-zoom" class="ptp-preview-zoom">
                                        <canvas id="testpattern-preview-canvas" width="700" height="500" class="bg-black rounded-md"></canvas>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Dome Visualizer (appears when Circular is enabled) -->
                            <div id="dome-visualizer-card" class="bg-black preview-grid rounded-xl border border-amber-500/40 p-3 flex items-center justify-center min-h-[300px] shadow-2xl ${s.circular ? '' : 'hidden'}">
                                <div class="w-full">
                                    <div class="flex items-center justify-between mb-2 px-1 flex-wrap gap-3">
                                        <div class="text-sm text-gray-300">Circular Dome Preview</div>
                                        <div class="flex items-center gap-4 flex-wrap">
                                            <label class="flex items-center gap-2 text-xs text-gray-300"><input id="ptp-dome-lock" type="checkbox" class="accent-amber-500 w-4 h-4" ${s.domeDiameterLock ? 'checked' : ''}> Lock to Total</label>
                                            <div class="flex items-center gap-2 text-xs text-gray-300">
                                                <span>Diameter</span>
                                                <input id="ptp-dome-dia-value" type="number" min="0.001" step="0.001" class="rounded-md px-2 py-1 w-28 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${fmtDomeVal(s.domeDiameterValue, s.domeDiameterUnit)}">
                                                <select id="ptp-dome-dia-unit" class="rounded-md px-2 py-1 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500">
                                                    <option value="m" ${s.domeDiameterUnit==='m'?'selected':''}>m</option>
                                                    <option value="ft" ${s.domeDiameterUnit==='ft'?'selected':''}>ft</option>
                                                </select>
                                            </div>
                                            <div class="flex items-center gap-2 text-xs text-gray-300">
                                                <span>Pixels/m</span>
                                                <input id="ptp-dome-ppm" type="number" min="1" class="rounded-md px-2 py-1 w-24 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.domePixelsPerMeter}">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="flex items-center justify-center">
                                        <canvas id="testpattern-dome-canvas" width="700" height="400" class="bg-black rounded-md"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Flat Screen Calculator Panel -->
                    <div id="ptp-panel-calc-flat" class="${s.uiSubTab==='calc-flat' ? '' : 'hidden'}">
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
                            <div class="bg-slate-900/80 rounded-xl border border-amber-500/40 p-5 shadow-2xl">
                                <div class="text-xl font-semibold text-amber-400 mb-4">Flat Screen Calculator</div>
                                <div class="grid grid-cols-1 gap-4">
                                    <div>
                                        <label class="text-sm text-gray-200 font-medium mb-1">Native Resolution</label>
                                        <select id="fc-native-res" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500">${flatOptions.optionsHtml}</select>
                                    </div>
                                    <div id="fc-custom-res-controls" class="flex items-end gap-3 ${flatOptions.isCustomSelection ? '' : 'hidden'}">
                                        <div class="flex gap-2 items-center">
                                            <label class="flex flex-col text-sm text-gray-200">Custom W<input id="fc-custom-w" type="number" min="1" class="mt-1 rounded-md px-3 py-2 w-28 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" placeholder="e.g., 1536"></label>
                                            <span class="text-gray-400 pb-2">x</span>
                                            <label class="flex flex-col text-sm text-gray-200">Custom H<input id="fc-custom-h" type="number" min="1" class="mt-1 rounded-md px-3 py-2 w-28 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" placeholder="e.g., 2048"></label>
                                        </div>
                                        <button id="fc-add-custom-res" class="h-10 px-4 bg-amber-600 text-white font-semibold rounded-md hover:bg-amber-700">Add</button>
                                    </div>
                                    <div class="grid grid-cols-2 gap-4">
                                        <div>
                                            <div class="text-sm text-gray-200 font-medium mb-1">Projector Width (px)</div>
                                            <input id="fc-pxw" type="number" step="1" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.calcFlat.projectorWidthPx}">
                                        </div>
                                        <div>
                                            <div class="text-sm text-gray-200 font-medium mb-1">Projector Height (px)</div>
                                            <input id="fc-pxh" type="number" step="1" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.calcFlat.projectorHeightPx}">
                                        </div>
                                    </div>
                                    <div>
                                        <div class="text-sm text-gray-200 font-medium mb-1">Screen Width (m)</div>
                                        <input id="fc-screen-w" type="number" step="0.001" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.calcFlat.screenWidthMeters}">
                                    </div>
                                    <div>
                                        <div class="text-sm text-gray-200 font-medium mb-1">Screen Height (m)</div>
                                        <input id="fc-screen-h" type="number" step="0.001" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.calcFlat.screenHeightMeters}">
                                    </div>
                                    <div>
                                        <div class="text-sm text-gray-200 font-medium mb-1">Calculation Mode</div>
                                        <select id="fc-mode" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500">
                                            <option value="distanceToRatio" ${s.calcFlat.calcMode==='distanceToRatio'?'selected':''}>Calculate Ratio (from Distance)</option>
                                            <option value="ratioToDistance" ${s.calcFlat.calcMode==='ratioToDistance'?'selected':''}>Calculate Distance (from Ratio)</option>
                                            <option value="suggestLens" ${s.calcFlat.calcMode==='suggestLens'?'selected':''}>Suggest Lens — Auto Advisor</option>
                                        </select>
                                    </div>
                                    <div>
                                        <div id="fc-throw-low-label" class="text-sm text-gray-200 font-medium mb-1">${s.calcFlat.calcMode==='ratioToDistance'?'Lens Throw Ratio (Low)':'Throw Distance (m)'} </div>
                                        <input id="fc-throw-low" type="number" step="0.01" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.calcFlat.throwLow}">
                                    </div>
                                    <div id="fc-throw-high-wrap" class="${s.calcFlat.calcMode==='ratioToDistance'?'':'hidden'}">
                                        <div class="text-sm text-gray-200 font-medium mb-1">Lens Throw Ratio (High)</div>
                                        <input id="fc-throw-high" type="number" step="0.01" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.calcFlat.throwHigh}">
                                    </div>
                                    <div class="grid grid-cols-2 gap-4">
                                        <div>
                                            <div class="text-sm text-gray-200 font-medium mb-1">Projectors (H)</div>
                                            <input id="fc-nh" type="number" min="1" step="1" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.calcFlat.numProjectorsHorizontal}">
                                        </div>
                                        <div>
                                            <label class="text-sm text-gray-200 font-medium mb-1">Horizontal Blend (<span id="fc-ovh-val">${s.calcFlat.overlapPercentHorizontal.toFixed ? s.calcFlat.overlapPercentHorizontal.toFixed(1) : s.calcFlat.overlapPercentHorizontal}</span>%)</label>
                                            <div class="flex items-center gap-2">
                                                <input id="fc-ovh" type="range" min="0" max="90" step="0.1" class="w-full h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer" value="${s.calcFlat.overlapPercentHorizontal}">
                                                <input id="fc-ovh-num" type="number" min="0" max="90" step="0.1" class="w-20 rounded-md px-2 py-1 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500 text-sm" value="${s.calcFlat.overlapPercentHorizontal}">
                                            </div>
                                        </div>
                                        <div>
                                            <div class="text-sm text-gray-200 font-medium mb-1">Projectors (V)</div>
                                            <input id="fc-nv" type="number" min="1" step="1" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.calcFlat.numProjectorsVertical}">
                                        </div>
                                        <div>
                                            <label class="text-sm text-gray-200 font-medium mb-1">Vertical Blend (<span id="fc-ovv-val">${s.calcFlat.overlapPercentVertical.toFixed ? s.calcFlat.overlapPercentVertical.toFixed(1) : s.calcFlat.overlapPercentVertical}</span>%)</label>
                                            <div class="flex items-center gap-2">
                                                <input id="fc-ovv" type="range" min="0" max="90" step="0.1" class="w-full h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer" value="${s.calcFlat.overlapPercentVertical}">
                                                <input id="fc-ovv-num" type="number" min="0" max="90" step="0.1" class="w-20 rounded-md px-2 py-1 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500 text-sm" value="${s.calcFlat.overlapPercentVertical}">
                                            </div>
                                        </div>
                                        <div class="col-span-2 flex items-center gap-3 mt-1">
                                            <label class="flex items-center gap-2 text-sm text-gray-200"><input id="fc-auto" type="checkbox" class="accent-amber-500 w-4 h-4" ${s.calcFlat.autoCalc ? 'checked' : ''}> Auto-calc projectors</label>
                                            <span class="text-xs text-gray-400">Uses screen size, blends, and projector aspect to choose a minimal grid</span>
                                        </div>
                                    </div>
                                    
                                </div>
                                <div class="mt-5 grid grid-cols-1 md:grid-cols-2 gap-3 text-gray-200">
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>Total Resolution</span><span id="fc-res" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span id="fc-throw-label">${s.calcFlat.calcMode==='ratioToDistance'?'Calculated Throw Distance':'Calculated Throw Ratio'}</span><span id="fc-throw" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>Single Image Width</span><span id="fc-single-w" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>Single Image Height</span><span id="fc-single-h" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>Required Overlap (H)</span><span id="fc-overlap-req" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>Fit-Height Canvas</span><span id="fc-fit-canvas" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>Pixel Width</span><span id="fc-pxwmm" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>Pixel Height</span><span id="fc-pxhmm" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>Horizontal Overlap</span><span id="fc-ovh-out" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>Vertical Overlap</span><span id="fc-ovv-out" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>Blend Zone (px)</span><span id="fc-blend-px" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>Projector Spacing</span><span id="fc-proj-spacing" class="font-bold text-amber-400">-</span></div>
                                    <div id="fc-overthrow-row" class="col-span-1 md:col-span-2 rounded-md border border-amber-500/30 bg-slate-800/50 p-3">
                                        <div class="text-xs text-amber-400 font-semibold uppercase tracking-wider mb-2">Single Projector Overthrow (Scale-to-Fill)</div>
                                        <div class="grid grid-cols-2 gap-2 text-sm">
                                            <div class="flex items-center justify-between"><span class="text-gray-300">Overthrow Width</span><span id="fc-overthrow-w" class="font-bold text-cyan-400">-</span></div>
                                            <div class="flex items-center justify-between"><span class="text-gray-300">Overthrow Height</span><span id="fc-overthrow-h" class="font-bold text-cyan-400">-</span></div>
                                            <div class="flex items-center justify-between"><span class="text-gray-300">Per-side Width</span><span id="fc-overthrow-w-side" class="font-bold text-cyan-400">-</span></div>
                                            <div class="flex items-center justify-between"><span class="text-gray-300">Per-side Height</span><span id="fc-overthrow-h-side" class="font-bold text-cyan-400">-</span></div>
                                            <div class="col-span-2 border-t border-slate-700 mt-1 pt-2 flex items-center justify-between"><span class="text-gray-300">Adjusted Resolution <span class="text-gray-500 text-xs">(after removing overthrow)</span></span><span id="fc-overthrow-adj" class="font-bold text-green-400">-</span></div>
                                        </div>
                                        <div class="mt-2 text-xs text-gray-500" id="fc-overthrow-formula"></div>
                                    </div>
                                    <div id="fc-lens-adv" class="col-span-1 md:col-span-2 hidden rounded-xl bg-slate-800/70 p-4 border border-amber-500/20"></div>
                                </div>
                            </div>
                            <div class="bg-black rounded-xl border border-amber-500/40 p-3 flex items-center justify-center min-h-[550px] shadow-2xl">
                                <svg id="fc-svg" viewBox="-50 -50 1100 700" class="w-full h-full"></svg>
                            </div>
                        </div>
                    </div>

                    <!-- Curved Screen Projection Panel -->
                    <div id="ptp-panel-calc-curve" class="${s.uiSubTab==='calc-curve' ? '' : 'hidden'}">
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
                            <div class="bg-slate-900/80 rounded-xl border border-amber-500/40 p-5 shadow-2xl">
                                <div class="text-xl font-semibold text-amber-400 mb-4">Curve Screen Projection</div>

                                <!-- Screen Shape -->
                                <div class="text-xs text-gray-400 uppercase tracking-wider mb-2">Screen Shape</div>
                                <div class="grid grid-cols-2 gap-3 mb-4">
                                    <div class="col-span-2">
                                        <div class="text-sm text-gray-200 font-medium mb-1">Curve Type</div>
                                        <select id="cv-type" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500">
                                            <option value="concave" ${s.calcCurve.curveType==='concave'?'selected':''}>Concave — hollow/inner face toward projectors (screen curves away, like a theater bowl)</option>
                                            <option value="convex" ${s.calcCurve.curveType==='convex'?'selected':''}>Convex — outer/dome face toward projectors (screen bulges toward projectors)</option>
                                        </select>
                                    </div>
                                    <div>
                                        <div class="text-sm text-gray-200 font-medium mb-1">Screen Width / Chord (m)</div>
                                        <input id="cv-screen-w" type="number" step="0.01" min="0" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.calcCurve.screenWidthMeters}">
                                    </div>
                                    <div>
                                        <div class="text-sm text-gray-200 font-medium mb-1">Screen Height (m)</div>
                                        <input id="cv-screen-h" type="number" step="0.01" min="0" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.calcCurve.screenHeightMeters}">
                                    </div>
                                    <div class="col-span-2">
                                        <div class="text-sm text-gray-200 font-medium mb-1">Curve Depth / Sagitta (m) <span class="text-gray-500 text-xs">— perpendicular distance from chord mid to arc</span></div>
                                        <input id="cv-depth" type="number" step="0.01" min="0" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.calcCurve.curveDepthMeters}">
                                    </div>
                                </div>

                                <!-- Projector -->
                                <div class="text-xs text-gray-400 uppercase tracking-wider mb-2">Projector</div>
                                <div class="grid grid-cols-2 gap-3 mb-4">
                                    <div>
                                        <div class="text-sm text-gray-200 font-medium mb-1">Resolution Width (px)</div>
                                        <input id="cv-pxw" type="number" step="1" min="1" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.calcCurve.projectorWidthPx}">
                                    </div>
                                    <div>
                                        <div class="text-sm text-gray-200 font-medium mb-1">Resolution Height (px)</div>
                                        <input id="cv-pxh" type="number" step="1" min="1" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.calcCurve.projectorHeightPx}">
                                    </div>
                                </div>

                                <!-- Layout -->
                                <div class="text-xs text-gray-400 uppercase tracking-wider mb-2">Layout</div>
                                <div class="grid grid-cols-2 gap-3 mb-3">
                                    <div class="col-span-2 flex items-start gap-3 bg-slate-800/60 rounded-md p-3">
                                        <label class="flex items-center gap-2 text-sm text-gray-200 cursor-pointer">
                                            <input id="cv-auto" type="checkbox" class="accent-amber-500 w-4 h-4 mt-0.5" ${s.calcCurve.autoCalc ? 'checked' : ''}>
                                            <span>Auto-calc projectors along arc</span>
                                        </label>
                                        <div id="cv-safe-wrap" class="ml-auto flex items-center gap-2 ${s.calcCurve.autoCalc ? '' : 'hidden'}">
                                            <span class="text-xs text-gray-400">Max °/projector</span>
                                            <input id="cv-safe-angle" type="number" min="10" max="90" step="1" class="w-16 rounded px-2 py-1 bg-gray-900 border border-gray-700 text-sm focus:ring-1 focus:ring-amber-500" value="${s.calcCurve.safeAngleDeg}">
                                        </div>
                                    </div>
                                    <div>
                                        <div class="text-sm text-gray-200 font-medium mb-1">Projectors Along Arc (H)</div>
                                        <input id="cv-nh" type="number" step="1" min="1" max="32" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.calcCurve.numProjectors}" ${s.calcCurve.autoCalc ? 'readonly' : ''}>
                                    </div>
                                    <div>
                                        <div class="text-sm text-gray-200 font-medium mb-1">Overlap H %</div>
                                        <input id="cv-ovp" type="number" step="0.1" min="0" max="90" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.calcCurve.overlapPercent}">
                                    </div>
                                    <div>
                                        <div class="text-sm text-gray-200 font-medium mb-1">Rows Vertically (V)</div>
                                        <input id="cv-nv" type="number" step="1" min="1" max="16" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.calcCurve.numProjectorsV}">
                                    </div>
                                    <div>
                                        <div class="text-sm text-gray-200 font-medium mb-1">Overlap V %</div>
                                        <input id="cv-ovv" type="number" step="0.1" min="0" max="90" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.calcCurve.overlapPercentV}">
                                    </div>
                                </div>

                                <!-- Throw -->
                                <div class="text-xs text-gray-400 uppercase tracking-wider mb-2">Throw</div>
                                <div class="grid grid-cols-1 gap-3 mb-1">
                                    <div>
                                        <div class="text-sm text-gray-200 font-medium mb-1">Calculation Mode</div>
                                        <select id="cv-mode" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500">
                                            <option value="ratioToDistance" ${s.calcCurve.calcMode==='ratioToDistance'?'selected':''}>Calculate Distance (from Ratio)</option>
                                            <option value="distanceToRatio" ${s.calcCurve.calcMode==='distanceToRatio'?'selected':''}>Calculate Ratio (from Distance)</option>
                                            <option value="suggestLens" ${s.calcCurve.calcMode==='suggestLens'?'selected':''}>Suggest Lens — Auto Advisor</option>
                                        </select>
                                    </div>
                                    <div class="grid grid-cols-2 gap-3">
                                        <div>
                                            <div id="cv-throw-low-label" class="text-sm text-gray-200 font-medium mb-1">${s.calcCurve.calcMode==='distanceToRatio'?'Throw Distance (m)':'Lens Throw Ratio (Low)'}</div>
                                            <input id="cv-throw-low" type="number" step="0.01" min="0" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.calcCurve.throwLow}">
                                        </div>
                                        <div id="cv-throw-high-wrap" class="${s.calcCurve.calcMode==='distanceToRatio'?'hidden':''}">
                                            <div class="text-sm text-gray-200 font-medium mb-1">Lens Throw Ratio (High)</div>
                                            <input id="cv-throw-high" type="number" step="0.01" min="0" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.calcCurve.throwHigh}">
                                        </div>
                                    </div>
                                </div>

                                <!-- Results -->
                                <div class="mt-5 grid grid-cols-1 md:grid-cols-2 gap-3 text-gray-200">
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>Radius of Curvature</span><span id="cv-radius" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>Arc Length</span><span id="cv-arc" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>Arc Angle</span><span id="cv-angle" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>Screen Height</span><span id="cv-chord-h" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>Grid (H × V)</span><span id="cv-proj-count" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>Total Projectors</span><span id="cv-total-proj" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>Arc Width / Projector</span><span id="cv-image-size" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>Chord Width / Projector</span><span id="cv-chord-proj" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>Height Per Row</span><span id="cv-single-h" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>Overlap H Zone</span><span id="cv-overlap" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>Overlap V Zone</span><span id="cv-overlap-v" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>Total Canvas</span><span id="cv-canvas" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>Pixel Pitch H (arc)</span><span id="cv-pitch" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span id="cv-throw-label">Throw Distance</span><span id="cv-throw" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span id="cv-ratio-label">Throw Ratio</span><span id="cv-throw-ratio-out" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between md:col-span-2"><span>Notes</span><span id="cv-notes" class="font-bold text-amber-400 text-right text-sm">-</span></div>
                                    <div id="cv-lens-adv" class="col-span-1 md:col-span-2 hidden rounded-xl bg-slate-800/70 p-4 border border-amber-500/20"></div>
                                </div>
                            </div>
                            <div class="bg-black rounded-xl border border-amber-500/40 p-3 flex items-center justify-center min-h-[600px] shadow-2xl">
                                <svg id="cv-svg" viewBox="-60 -60 880 700" class="w-full h-full"></svg>
                            </div>
                        </div>
                    </div>

                    <!-- Circular / Semi-circular Calculator Panel -->
                    <div id="ptp-panel-calc-circular" class="${s.uiSubTab==='calc-circ' ? '' : 'hidden'}">
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
                            <div class="bg-slate-900/80 rounded-xl border border-amber-500/40 p-5 shadow-2xl">
                                <div class="text-xl font-semibold text-amber-400 mb-4">Circular / Semi-circular Calculator</div>
                                <div class="grid grid-cols-1 gap-4">
                                    <div class="grid grid-cols-2 gap-4">
                                        <div>
                                            <div class="text-sm text-gray-200 font-medium mb-1">Shape</div>
                                            <select id="cc-shape" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500">
                                                <option value="circle" ${s.calcCirc.shape==='circle'?'selected':''}>Circle (360°)</option>
                                                <option value="semi" ${s.calcCirc.shape==='semi'?'selected':''}>Semi-circle (180°)</option>
                                                <option value="custom" ${s.calcCirc.shape==='custom'?'selected':''}>Custom Arc</option>
                                            </select>
                                        </div>
                                        <div>
                                            <div class="text-sm text-gray-200 font-medium mb-1">Diameter (m)</div>
                                            <input id="cc-d" type="number" step="0.001" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.calcCirc.diameter}">
                                        </div>
                                        <div>
                                            <div class="text-sm text-gray-200 font-medium mb-1">Screen Height (m)</div>
                                            <input id="cc-sh" type="number" step="0.01" min="0" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.calcCirc.screenHeight || 3}">
                                        </div>
                                    </div>
                                    <div id="cc-angle-wrap" class="${s.calcCirc.shape==='custom'?'':'hidden'}">
                                        <div class="text-sm text-gray-200 font-medium mb-1">Arc Angle (°)</div>
                                        <input id="cc-angle" type="number" min="1" max="360" step="0.1" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.calcCirc.arcAngleDeg || 120}">
                                    </div>
                                    <div class="grid grid-cols-2 gap-4">
                                        <div>
                                            <div class="text-sm text-gray-200 font-medium mb-1">Projection Side</div>
                                            <select id="cc-side" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500">
                                                <option value="outside" ${s.calcCirc.projectionSide==='outside'?'selected':''}>Outside (Convex)</option>
                                                <option value="inside" ${s.calcCirc.projectionSide==='inside'?'selected':''}>Inside (Concave)</option>
                                            </select>
                                        </div>
                                        <div>
                                            <div class="text-sm text-gray-200 font-medium mb-1">Safe Angle / Projector (°)</div>
                                            <input id="cc-safe-angle" type="number" min="30" max="110" step="1" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.calcCirc.safeAngleDeg}">
                                        </div>
                                    </div>
                                    <div>
                                        <div class="text-sm text-gray-200 font-medium mb-1">Calculation Mode</div>
                                        <select id="cc-mode" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500">
                                            <option value="distanceToRatio" ${s.calcCirc.calcMode==='distanceToRatio'?'selected':''}>Calculate Ratio (from Distance)</option>
                                            <option value="ratioToDistance" ${s.calcCirc.calcMode==='ratioToDistance'?'selected':''}>Calculate Distance (from Ratio)</option>
                                            <option value="suggestLens" ${s.calcCirc.calcMode==='suggestLens'?'selected':''}>Suggest Lens — Auto Advisor</option>
                                        </select>
                                    </div>
                                    <div>
                                        <div id="cc-throw-low-label" class="text-sm text-gray-200 font-medium mb-1">${s.calcCirc.calcMode==='ratioToDistance'?'Throw Distance (m)':'Lens Throw Ratio (Low)'} </div>
                                        <input id="cc-throw-low" type="number" step="0.01" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.calcCirc.throwLow}">
                                    </div>
                                    <div id="cc-throw-high-wrap" class="${s.calcCirc.calcMode==='ratioToDistance'?'hidden':''}">
                                        <div class="text-sm text-gray-200 font-medium mb-1">Lens Throw Ratio (High)</div>
                                        <input id="cc-throw-high" type="number" step="0.01" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.calcCirc.throwHigh}">
                                    </div>
                                    <div class="grid grid-cols-2 gap-4">
                                        <div>
                                            <div class="text-sm text-gray-200 font-medium mb-1">Along Arc (Projectors)</div>
                                            <input id="cc-nh" type="number" min="1" step="1" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.calcCirc.numProjectorsHorizontal}">
                                        </div>
                                        <div>
                                            <label class="text-sm text-gray-200 font-medium mb-1">Arc Blend (<span id="cc-ovh-val">${s.calcCirc.overlapPercentHorizontal.toFixed ? s.calcCirc.overlapPercentHorizontal.toFixed(1) : s.calcCirc.overlapPercentHorizontal}</span>%)</label>
                                            <input id="cc-ovh" type="range" min="0" max="90" step="0.1" class="w-full h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer" value="${s.calcCirc.overlapPercentHorizontal}">
                                        </div>
                                        <div>
                                            <div class="text-sm text-gray-200 font-medium mb-1">Projectors (V)</div>
                                            <input id="cc-nv" type="number" min="1" step="1" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.calcCirc.numProjectorsVertical}" ${s.calcCirc.autoCalcV ? 'readonly' : ''}>
                                        </div>
                                        <div>
                                            <label class="text-sm text-gray-200 font-medium mb-1">Vertical Blend (<span id="cc-ovv-val">${s.calcCirc.overlapPercentVertical.toFixed ? s.calcCirc.overlapPercentVertical.toFixed(1) : s.calcCirc.overlapPercentVertical}</span>%)</label>
                                            <input id="cc-ovv" type="range" min="0" max="90" step="0.1" class="w-full h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer" value="${s.calcCirc.overlapPercentVertical}">
                                        </div>
                                        <div class="col-span-2 flex items-start gap-3 bg-slate-800/60 rounded-md p-3">
                                            <label class="flex items-center gap-2 text-sm text-gray-200 cursor-pointer">
                                                <input id="cc-auto-v" type="checkbox" class="accent-amber-500 w-4 h-4 mt-0.5" ${s.calcCirc.autoCalcV ? 'checked' : ''}>
                                                <span>Auto-calc V rows from screen height</span>
                                            </label>
                                            <span class="ml-auto text-xs text-gray-500">Uses projector aspect ratio &amp; arc/proj to find minimum rows</span>
                                        </div>
                                    </div>
                                    <div class="grid grid-cols-2 gap-4">
                                        <div>
                                            <div class="text-sm text-gray-200 font-medium mb-1">Projector Width (px)</div>
                                            <input id="cc-pxw" type="number" step="1" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.calcCirc.projectorWidthPx}">
                                        </div>
                                        <div>
                                            <div class="text-sm text-gray-200 font-medium mb-1">Projector Height (px)</div>
                                            <input id="cc-pxh" type="number" step="1" class="w-full rounded-md px-3 py-2 bg-gray-900 border border-gray-700 focus:ring-2 focus:ring-amber-500" value="${s.calcCirc.projectorHeightPx}">
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-5 grid grid-cols-1 md:grid-cols-2 gap-3 text-gray-200">
                                    <!-- Flat image section -->
                                    <div class="md:col-span-2 text-xs text-amber-500/80 uppercase tracking-wider font-semibold pt-1">Flattened Image Dimensions</div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>Flat Width (unwrapped arc)</span><span id="cc-flat-w" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>Flat Height</span><span id="cc-flat-h" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>Per-Projector Width</span><span id="cc-proj-imgw" class="font-bold text-amber-400 text-right text-sm">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>Per-Projector Height</span><span id="cc-proj-imgh" class="font-bold text-amber-400 text-right text-sm">-</span></div>
                                    <!-- Overlap pixels -->
                                    <div class="md:col-span-2 text-xs text-amber-500/80 uppercase tracking-wider font-semibold pt-1">Overlap / Blend Zones</div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>H Overlap (pixels)</span><span id="cc-ovh-px" class="font-bold text-cyan-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>V Overlap (pixels)</span><span id="cc-ovv-px" class="font-bold text-cyan-400">-</span></div>
                                    <!-- Core metrics -->
                                    <div class="md:col-span-2 text-xs text-amber-500/80 uppercase tracking-wider font-semibold pt-1">Arc &amp; Lens Metrics</div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>Arc Length</span><span id="cc-arc" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>Total Canvas</span><span id="cc-canvas" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>Grid (H × V)</span><span id="cc-total-proj" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>Arc / Projector</span><span id="cc-arc-perproj" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>Chord / Projector</span><span id="cc-chord-perproj" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>° / Projector</span><span id="cc-ang-perproj" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>Pixel Pitch H (arc)</span><span id="cc-pitch-h" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span>Pixel Pitch V</span><span id="cc-pitch-v" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between"><span id="cc-throw-label">${s.calcCirc.calcMode==='ratioToDistance'?'Calculated Throw Distance':'Calculated Throw Ratio'}</span><span id="cc-throw" class="font-bold text-amber-400">-</span></div>
                                    <div class="bg-slate-800/70 rounded-md p-3 flex items-center justify-between md:col-span-2"><span>Projection Check</span><span id="cc-check" class="font-bold text-amber-400 text-right text-sm">-</span></div>
                                    <div id="cc-lens-adv" class="col-span-1 md:col-span-2 hidden rounded-xl bg-slate-800/70 p-4 border border-amber-500/20"></div>
                                </div>
                            </div>
                            <div class="bg-black rounded-xl border border-amber-500/40 p-3 flex items-center justify-center min-h-[550px] shadow-2xl">
                                <svg id="cc-svg" viewBox="0 0 700 560" class="w-full h-full"></svg>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            // Bind sub-tab clicks
            try {
                const subtabButtons = container.querySelectorAll('.ptp-subtab');
                subtabButtons.forEach(btn => {
                    btn.addEventListener('click', () => {
                        const k = btn.getAttribute('data-subtab');
                        if (!k) return;
                        s.uiSubTab = k;
                        renderProjectorTestPattern();
                    });
                });
            } catch(_) {}
            // Bind all controls to state and redraw preview on change
            const canvas = document.getElementById('testpattern-preview-canvas');
            const domeCanvas = document.getElementById('testpattern-dome-canvas');
            const fcSvg = document.getElementById('fc-svg');
            const ccSvg = document.getElementById('cc-svg');
            const cvSvg = document.getElementById('cv-svg');
            const previewStage = document.getElementById('ptp-preview-stage');
            const previewZoomWrap = document.getElementById('ptp-preview-zoom');
            const zoomLabel = document.getElementById('ptp-zoom-label');

            // Helper: draw both previews (main rectangular, dome circular)
            const drawBothPreviews = () => {
                if (canvas) drawProjectorTestPattern(canvas, s, true, false);
                if (domeCanvas) drawDomeTestPattern(domeCanvas, s);
            };

            const setPreviewZoom = (z) => {
                const next = Math.max(0.25, Math.min(3, Number(z) || 1));
                s.previewZoom = next;
                if (previewZoomWrap) previewZoomWrap.style.transform = `scale(${next})`;
                if (zoomLabel) zoomLabel.textContent = `${Math.round(next * 100)}%`;
            };
            const fitPreviewZoom = () => {
                if (!previewStage || !canvas) return;
                const w = Math.max(1, previewStage.clientWidth);
                const h = Math.max(1, previewStage.clientHeight);
                const scale = Math.min(w / canvas.width, h / canvas.height);
                setPreviewZoom(scale);
            };
            // Keep flat calculator projector resolution in sync with Native Resolution
            const syncFlatProjResFromNative = () => {
                try {
                    const w = Math.max(1, Number(s.displayWidth) || 1);
                    const h = Math.max(1, Number(s.displayHeight) || 1);
                    s.calcFlat.projectorWidthPx = w;
                    s.calcFlat.projectorHeightPx = h;
                    const wEl = document.getElementById('fc-pxw');
                    const hEl = document.getElementById('fc-pxh');
                    if (wEl) wEl.value = String(w);
                    if (hEl) hEl.value = String(h);
                } catch(_) {}
            };
            // Helper: toggle dome card visibility
            const syncDomeVisibility = () => {
                const card = document.getElementById('dome-visualizer-card');
                if (!card) return;
                if (s.circular) card.classList.remove('hidden'); else card.classList.add('hidden');
            };
            // --- Lens Advisor Helper ---
            // Generates an HTML table of standard throw ratios with distances + suitability for a given image width.
            // isInside=true + Rad: additionally flags if throw distance exceeds radius.
            const buildLensAdvisorHTML = (imageWidthM, isInside, Rad) => {
                if (!imageWidthM || imageWidthM <= 0) return '<div class="text-gray-500 text-sm">Enter screen geometry to see lens suggestions.</div>';
                const STD_RATIOS = [
                    { ratio: 0.38, cat: 'Ultra Short', cc: '#a78bfa' },
                    { ratio: 0.50, cat: 'Ultra Short', cc: '#a78bfa' },
                    { ratio: 0.65, cat: 'Short Throw',  cc: '#60a5fa' },
                    { ratio: 0.80, cat: 'Short Throw',  cc: '#60a5fa' },
                    { ratio: 1.00, cat: 'Standard',     cc: '#34d399' },
                    { ratio: 1.20, cat: 'Standard',     cc: '#34d399' },
                    { ratio: 1.40, cat: 'Standard',     cc: '#34d399' },
                    { ratio: 1.60, cat: 'Standard',     cc: '#34d399' },
                    { ratio: 1.80, cat: 'Standard',     cc: '#34d399' },
                    { ratio: 2.00, cat: 'Standard',     cc: '#34d399' },
                    { ratio: 2.50, cat: 'Long Throw',   cc: '#fbbf24' },
                    { ratio: 3.00, cat: 'Long Throw',   cc: '#fbbf24' },
                    { ratio: 4.00, cat: 'Long Throw',   cc: '#fbbf24' },
                ];
                let rows = '';
                for (const { ratio, cat, cc } of STD_RATIOS) {
                    const dist = ratio * imageWidthM;
                    let suit, sc, bg = '';
                    if (isInside && Rad > 0 && dist > Rad) {
                        suit = `\u2717 Exceeds radius (${Rad.toFixed(2)} m) \u2014 can\u2019t fit inside`;
                        sc = '#f87171';
                    } else if (dist < 0.5) {
                        suit = '\u2717 Too close \u2014 physical clearance issue';
                        sc = '#f87171';
                    } else if (dist < 0.8) {
                        suit = '\u25b3 Marginal \u2014 very tight placement';
                        sc = '#fbbf24';
                    } else if (dist <= 15.0) {
                        suit = '\u2713 Practical throw distance';
                        sc = '#34d399';
                        bg = 'background:rgba(52,211,153,.06)';
                    } else if (dist <= 25.0) {
                        suit = '\u25b3 Marginal \u2014 high-power lens required';
                        sc = '#fbbf24';
                    } else {
                        suit = '\u2717 Too far \u2014 specialty long-throw lens';
                        sc = '#f87171';
                    }
                    rows += `<tr style="${bg};border-bottom:1px solid #1f2937">` +
                        `<td style="padding:5px 8px;font-family:monospace;font-weight:700;color:#fcd34d">${ratio.toFixed(2)}:1</td>` +
                        `<td style="padding:5px 8px;color:${cc};font-size:12px">${cat}</td>` +
                        `<td style="padding:5px 8px;color:#f3f4f6;font-weight:600">${dist.toFixed(2)} m</td>` +
                        `<td style="padding:5px 8px;font-size:11px;color:${sc}">${suit}</td>` +
                        `</tr>`;
                }
                return `<div style="font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:#f59e0b;font-weight:700;margin-bottom:8px">Lens Advisor \u2014 Suggested Throw Ratios</div>` +
                    `<div style="font-size:12px;color:#9ca3af;margin-bottom:10px">Image width per projector: <strong style="color:#f3f4f6">${imageWidthM.toFixed(3)} m</strong> (chord). Select a ratio from the table below:</div>` +
                    `<div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-size:13px">` +
                    `<thead><tr style="border-bottom:1px solid #374151;color:#9ca3af;font-size:11px">` +
                    `<th style="padding:5px 8px;text-align:left">Ratio</th>` +
                    `<th style="padding:5px 8px;text-align:left">Category</th>` +
                    `<th style="padding:5px 8px;text-align:left">Throw Distance</th>` +
                    `<th style="padding:5px 8px;text-align:left">Suitability</th>` +
                    `</tr></thead><tbody>${rows}</tbody></table></div>` +
                    `<div style="margin-top:10px;font-size:11px;color:#6b7280">Throw Ratio = Distance \u00f7 Image Width (chord). Practical range: <strong style="color:#d1d5db">0.8 m \u2013 15 m</strong> for most venues. Once you choose a ratio, switch mode to \u201cCalculate Distance\u201d and enter it.</div>`;
            };

            // --- Flat Calculator: visualization helper ---
            // Auto-calc projectors (flat): find minimal nV and nH to cover HxW using blends and projector aspect
            const autoCalcFlatProjectors = () => {
                const autoEl = document.getElementById('fc-auto');
                if (!autoEl || !autoEl.checked) return false;
                const Wm = Math.max(0, Number(document.getElementById('fc-screen-w')?.value) || 0);
                const Hm = Math.max(0, Number(document.getElementById('fc-screen-h')?.value) || 0);
                const fH = Math.max(0, Math.min(0.9, (Number(document.getElementById('fc-ovh')?.value) || 0)/100));
                const fV = Math.max(0, Math.min(0.9, (Number(document.getElementById('fc-ovv')?.value) || 0)/100));
                const pxW = Math.max(1, Number(document.getElementById('fc-pxw')?.value) || 1);
                const pxH = Math.max(1, Number(document.getElementById('fc-pxh')?.value) || 1);
                const ar = pxW / pxH;
                let best = { nH: null, nV: null, total: Infinity };
                for (let nV = 1; nV <= 10; nV++) {
                    const effV = nV - (nV - 1) * fV; // coverage factor
                    const Hp = effV > 0 ? (Hm / effV) : Infinity; // per-projector image height required
                    if (!isFinite(Hp) || Hp <= 0) continue;
                    const Wp = Hp * ar; // per-projector image width by aspect
                    // find minimal nH that covers width using overlap
                    let nH = 1;
                    for (; nH <= 16; nH++) {
                        const effH = nH - (nH - 1) * fH;
                        const coverW = Wp * effH;
                        if (coverW + 1e-6 >= Wm) break;
                    }
                    if (nH > 16) continue;
                    const total = nH * nV;
                    if (total < best.total || (total === best.total && (best.nV == null || nH < best.nH))) {
                        best = { nH, nV, total };
                    }
                }
                if (best.nH && best.nV) {
                    const nhEl = document.getElementById('fc-nh');
                    const nvEl = document.getElementById('fc-nv');
                    if (nhEl) nhEl.value = String(best.nH);
                    if (nvEl) nvEl.value = String(best.nV);
                    s.calcFlat.numProjectorsHorizontal = best.nH;
                    s.calcFlat.numProjectorsVertical = best.nV;
                    return true;
                }
                return false;
            };

            const drawFlatCalc = () => {
                if (!document.getElementById('ptp-panel-calc-flat') || !fcSvg) return;
                // read values
                const Wm = Math.max(0, Number(document.getElementById('fc-screen-w')?.value) || 0);
                const Hm = Math.max(0, Number(document.getElementById('fc-screen-h')?.value) || 0);
                const mode = (document.getElementById('fc-mode')?.value) || 'distanceToRatio';
                const tLow = Number(document.getElementById('fc-throw-low')?.value) || 0;
                const tHighRaw = Number(document.getElementById('fc-throw-high')?.value);
                const nH = Math.max(1, Number(document.getElementById('fc-nh')?.value) || 1);
                const nV = Math.max(1, Number(document.getElementById('fc-nv')?.value) || 1);
                let ovH = Math.max(0, Math.min(90, Number(document.getElementById('fc-ovh')?.value) || 0));
                let ovV = Math.max(0, Math.min(90, Number(document.getElementById('fc-ovv')?.value) || 0));
                const pxW = Math.max(1, Number(document.getElementById('fc-pxw')?.value) || 1);
                const pxH = Math.max(1, Number(document.getElementById('fc-pxh')?.value) || 1);

                // If auto-calc is enabled, compute nH/nV before calculations
                autoCalcFlatProjectors();
                // Re-read nH/nV in case they were adjusted
                let nH2 = Math.max(1, Number(document.getElementById('fc-nh')?.value) || nH);
                let nV2 = Math.max(1, Number(document.getElementById('fc-nv')?.value) || nV);

                // Universal grid solver
                const SAFE_OVERLAP = 0.20;
                const projAspect = pxH > 0 ? (pxW / pxH) : 0;
                const screenAspect = (Wm > 0 && Hm > 0) ? (Wm / Hm) : 0;
                let bestRows = 1;
                let bestCols = 1;
                if (screenAspect > 0 && projAspect > 0) {
                    if (screenAspect > projAspect) {
                        bestRows = 1;
                        bestCols = Math.max(1, Math.ceil((screenAspect / projAspect) / (1 - SAFE_OVERLAP)));
                    } else {
                        bestCols = 1;
                        bestRows = Math.max(1, Math.ceil(((projAspect / screenAspect)) / (1 - SAFE_OVERLAP)));
                    }
                }

                const imgHFit = (bestRows > 0) ? (Hm / bestRows) : 0;
                const imgWFit = imgHFit * projAspect;
                const totalWidthA = (bestCols * imgWFit) - ((bestCols - 1) * (imgWFit * SAFE_OVERLAP));
                let imgWFinal = imgWFit;
                let imgHFinal = imgHFit;
                if (totalWidthA < Wm && bestCols > 0) {
                    const denom = bestCols - ((bestCols - 1) * SAFE_OVERLAP);
                    imgWFinal = denom > 0 ? (Wm / denom) : imgWFit;
                    imgHFinal = projAspect > 0 ? (imgWFinal / projAspect) : imgHFit;
                }

                let overlapWM = 0, overlapHM = 0, overlapWPct = 0, overlapHPct = 0;
                if (bestCols > 1 && imgWFinal > 0) {
                    const totalRawW = bestCols * imgWFinal;
                    overlapWM = Math.max(0, (totalRawW - Wm) / (bestCols - 1));
                    overlapWPct = overlapWM / imgWFinal;
                }
                if (bestRows > 1 && imgHFinal > 0) {
                    const totalRawH = bestRows * imgHFinal;
                    overlapHM = Math.max(0, (totalRawH - Hm) / (bestRows - 1));
                    overlapHPct = overlapHM / imgHFinal;
                }

                const ppm = imgWFinal > 0 ? (pxW / imgWFinal) : 0;
                let totalResX = Math.round(Wm * ppm);
                let totalResY = Math.round(Hm * ppm);

                const autoEl = document.getElementById('fc-auto');
                if (autoEl && autoEl.checked) {
                    nH2 = bestCols;
                    nV2 = bestRows;
                    ovH = Math.max(0, Math.min(90, overlapWPct * 100));
                    ovV = Math.max(0, Math.min(90, overlapHPct * 100));
                    const nhEl = document.getElementById('fc-nh');
                    const nvEl = document.getElementById('fc-nv');
                    const ovhEl = document.getElementById('fc-ovh');
                    const ovvEl = document.getElementById('fc-ovv');
                    const ovhNumEl = document.getElementById('fc-ovh-num');
                    const ovvNumEl = document.getElementById('fc-ovv-num');
                    const ovhValEl = document.getElementById('fc-ovh-val');
                    const ovvValEl = document.getElementById('fc-ovv-val');
                    if (nhEl) nhEl.value = String(nH2);
                    if (nvEl) nvEl.value = String(nV2);
                    if (ovhEl) ovhEl.value = String(ovH);
                    if (ovvEl) ovvEl.value = String(ovV);
                    if (ovhNumEl) ovhNumEl.value = String(ovH);
                    if (ovvNumEl) ovvNumEl.value = String(ovV);
                    if (ovhValEl) ovhValEl.textContent = ovH.toFixed(1);
                    if (ovvValEl) ovvValEl.textContent = ovV.toFixed(1);
                    s.calcFlat.numProjectorsHorizontal = nH2;
                    s.calcFlat.numProjectorsVertical = nV2;
                    s.calcFlat.overlapPercentHorizontal = ovH;
                    s.calcFlat.overlapPercentVertical = ovV;
                }

                const ovHDec = ovH/100, ovVDec = ovV/100;
                // Overlap in pixels — declared after auto-block so ovH/ovV are final
                const overlapWPx = Math.round(pxW * ovHDec);
                const overlapHPx = Math.round(pxH * ovVDec);
                const totWpx = (nH2===1)? pxW : (nH2*pxW - (nH2-1)*(pxW*ovHDec));
                const totHpx = (nV2===1)? pxH : (nV2*pxH - (nV2-1)*(pxH*ovVDec));
                const Wmm = Wm*1000, Hmm = Hm*1000;
                const pwmm = totWpx>0 ? (Wmm / totWpx) : 0;
                const phmm = totHpx>0 ? (Hmm / totHpx) : 0;
                const avgPitch = (pwmm + phmm)/2;
                // Per-projector image size: Wm / effective-coverage-factor (correct formula)
                const effH = nH2 - (nH2 - 1) * ovHDec;
                const effV = nV2 - (nV2 - 1) * ovVDec;
                const singleWm = (effH > 0 && Wm > 0) ? Wm / effH : 0;
                const singleHm = (effV > 0 && Hm > 0) ? Hm / effV : 0;
                const pixelOverlap = Math.round(pxW * ovHDec);
                const projectorSpacing = singleWm * (1 - ovHDec);
                // Canvas resolution = total stitched pixels (already computed correctly above)
                totalResX = Math.round(totWpx);
                totalResY = Math.round(totHpx);

                // --- Lens Advisor & suggestLens mode ---
                const isSuggestFC = mode === 'suggestLens';
                const lensAdvFC = document.getElementById('fc-lens-adv');
                const throwLowWrapFC = document.getElementById('fc-throw-low')?.parentElement;
                const throwHiWrapFC2 = document.getElementById('fc-throw-high-wrap');
                if (throwLowWrapFC) throwLowWrapFC.classList.toggle('hidden', isSuggestFC);
                if (throwHiWrapFC2) throwHiWrapFC2.classList.toggle('hidden', isSuggestFC || mode !== 'ratioToDistance');
                if (lensAdvFC) {
                    lensAdvFC.classList.toggle('hidden', !isSuggestFC);
                    if (isSuggestFC && singleWm > 0) lensAdvFC.innerHTML = buildLensAdvisorHTML(singleWm, false, 0);
                }

                // Throw
                let throwOut = '-', throwMeters = 0;
                const throwLabel = document.getElementById('fc-throw-label');
                if (isSuggestFC) {
                    if (throwLabel) throwLabel.textContent = 'Lens Advisor';
                    throwOut = '→ See Lens Advisor below';
                } else if (mode === 'distanceToRatio') {
                    if (throwLabel) throwLabel.textContent = 'Calculated Throw Ratio';
                    const ratio = singleWm>0 ? (tLow / singleWm) : 0;
                    throwOut = `${ratio.toFixed(2)} : 1`;
                    throwMeters = tLow;
                } else {
                    if (throwLabel) throwLabel.textContent = 'Calculated Throw Distance';
                    const tHigh = (isFinite(tHighRaw) && tHighRaw >= tLow) ? tHighRaw : tLow;
                    const dLow = tLow * singleWm;
                    const dHigh = tHigh * singleWm;
                    throwOut = (Math.abs(dHigh-dLow)<1e-6) ? `${dLow.toFixed(2)} m` : `${dLow.toFixed(2)} - ${dHigh.toFixed(2)} m`;
                    throwMeters = dLow;
                }

                // Results
                const ovHPx = pxW * ovHDec; const ovVPx = pxH * ovVDec;
                const ovHM = (ovHPx * pwmm)/1000; const ovVM = (ovVPx * phmm)/1000;
                const byId = id => document.getElementById(id);
                const setTxt = (id, v) => { const el = byId(id); if (el) el.textContent = v; };
                setTxt('fc-res', `${Math.round(totWpx)} x ${Math.round(totHpx)} px`);
                setTxt('fc-throw', throwOut);
                setTxt('fc-single-w', `${singleWm.toFixed(2)} m`);
                setTxt('fc-single-h', `${singleHm.toFixed(2)} m`);
                setTxt('fc-overlap-req', `${ovHM.toFixed(3)} m  (${ovH.toFixed(1)}%)`);
                setTxt('fc-fit-canvas', `${totalResX} x ${totalResY} px`);
                setTxt('fc-pxwmm', `${pwmm.toFixed(2)} mm`);
                setTxt('fc-pxhmm', `${phmm.toFixed(2)} mm`);
                setTxt('fc-ovh-out', `${ovHM.toFixed(3)} m  (${overlapWPx} px)`);
                setTxt('fc-ovv-out', `${ovVM.toFixed(3)} m  (${overlapHPx} px)`);
                setTxt('fc-blend-px', `H: ${overlapWPx} px  /  V: ${overlapHPx} px`);
                setTxt('fc-proj-spacing', `H: ${projectorSpacing.toFixed(3)} m  /  V: ${(singleHm*(1-ovVDec)).toFixed(3)} m`);

                // --- Overthrow calculation (single projector, scale-to-fill) ---
                // When one projector fills the screen, if projector aspect ≠ screen aspect,
                // the image must be scaled until the short axis fills, causing the long axis to overflow.
                // Formula:
                //   projAspect > screenAspect → fit height → overthrowW_px = pxW − round(pxH × Wm/Hm)
                //   projAspect < screenAspect → fit width  → overthrowH_px = pxH − round(pxW × Hm/Wm)
                let overthrowWpx = 0, overthrowHpx = 0, overthrowWm = 0, overthrowHm = 0, overthrowNote = '';
                const overthroughRow = byId('fc-overthrow-row');
                if (nH2 === 1 && nV2 === 1 && Wm > 0 && Hm > 0) {
                    if (overthroughRow) overthroughRow.style.display = '';
                    const projAspect = pxH > 0 ? pxW / pxH : 0;
                    const scrAspect  = Hm  > 0 ? Wm  / Hm  : 0;
                    if (projAspect > scrAspect + 1e-6) {
                        // Projector wider → scale to fit HEIGHT, width overflows
                        const usedWpx = Math.round(pxH * (Wm / Hm));
                        overthrowWpx = Math.max(0, pxW - usedWpx);
                        overthrowNote = `Fit height → overthrow W = pxW − round(pxH × Wm/Hm)  =  ${pxW} − round(${pxH} × ${Wm}/${Hm})  =  ${overthrowWpx} px`;
                    } else if (scrAspect > projAspect + 1e-6) {
                        // Screen wider → scale to fit WIDTH, height overflows
                        const usedHpx = Math.round(pxW * (Hm / Wm));
                        overthrowHpx = Math.max(0, pxH - usedHpx);
                        overthrowNote = `Fit width → overthrow H = pxH − round(pxW × Hm/Wm)  =  ${pxH} − round(${pxW} × ${Hm}/${Wm})  =  ${overthrowHpx} px`;
                    } else {
                        overthrowNote = 'Projector aspect ratio matches screen — no overthrow.';
                    }
                    overthrowWm = overthrowWpx * (pxW > 0 ? singleWm / pxW : 0);
                    overthrowHm = overthrowHpx * (pxH > 0 ? singleHm / pxH : 0);
                    setTxt('fc-overthrow-w',      overthrowWpx > 0 ? `${overthrowWpx} px  (${overthrowWm.toFixed(3)} m)` : '0 px — none');
                    setTxt('fc-overthrow-h',      overthrowHpx > 0 ? `${overthrowHpx} px  (${overthrowHm.toFixed(3)} m)` : '0 px — none');
                    setTxt('fc-overthrow-w-side', overthrowWpx > 0 ? `${(overthrowWpx/2).toFixed(1)} px  /  ${(overthrowWm/2).toFixed(3)} m` : '0 px');
                    setTxt('fc-overthrow-h-side', overthrowHpx > 0 ? `${(overthrowHpx/2).toFixed(1)} px  /  ${(overthrowHm/2).toFixed(3)} m` : '0 px');
                    const adjW = pxW - overthrowWpx;
                    const adjH = pxH - overthrowHpx;
                    setTxt('fc-overthrow-adj', `${adjW} × ${adjH} px`);
                    const formulaEl = byId('fc-overthrow-formula'); if (formulaEl) formulaEl.textContent = overthrowNote;
                } else {
                    if (overthroughRow) overthroughRow.style.display = 'none';
                }

                // Persist flat calc summary for PDF
                s.calcFlat.lastSummary = {
                    screen: `${Wm.toFixed(2)}m x ${Hm.toFixed(2)}m`,
                    projectorRes: `${pxW} x ${pxH}`,
                    grid: `${nH2} H x ${nV2} V`,
                    singleImage: `${singleWm.toFixed(3)}m x ${singleHm.toFixed(3)}m`,
                    overlapH: `${ovHM.toFixed(3)}m  (${overlapWPx} px, ${ovH.toFixed(1)}%)`,
                    overlapV: `${ovVM.toFixed(3)}m  (${overlapHPx} px, ${ovV.toFixed(1)}%)`,
                    canvas: `${totalResX} x ${totalResY} px`,
                    spacing: `H ${projectorSpacing.toFixed(3)} m  /  V ${(singleHm*(1-ovVDec)).toFixed(3)} m`,
                    ...(nH2 === 1 && nV2 === 1 ? {
                        overthrowW: overthrowWpx > 0 ? `${overthrowWpx} px (${overthrowWm.toFixed(3)} m, per-side ${(overthrowWpx/2).toFixed(1)} px)` : '0 px — none',
                        overthrowH: overthrowHpx > 0 ? `${overthrowHpx} px (${overthrowHm.toFixed(3)} m, per-side ${(overthrowHpx/2).toFixed(1)} px)` : '0 px — none',
                        adjustedRes: `${pxW - overthrowWpx} × ${pxH - overthrowHpx} px`
                    } : {})
                };

                // Sync to Projector Test Pattern state and render preview
                try {
                    const ptp = window.projectorTestPatternState || (window.projectorTestPatternState = {});
                    ptp.displayWidth = pxW;
                    ptp.displayHeight = pxH;
                    ptp.displaysX = nH2;
                    ptp.displaysY = nV2;
                    ptp.overlap = (overlapWPx > 0 || overlapHPx > 0);
                    ptp.overlapX = Math.max(0, overlapWPx);
                    ptp.overlapY = Math.max(0, overlapHPx);
                    ptp.overlapXPercent = pxW > 0 ? Math.round((ptp.overlapX / pxW) * 100) : 0;
                    ptp.overlapYPercent = pxH > 0 ? Math.round((ptp.overlapY / pxH) * 100) : 0;
                    ptp.totalWidth = totalResX;
                    ptp.totalHeight = totalResY;
                    ptp.imageName = `Flat_${Wm.toFixed(2)}x${Hm.toFixed(2)}m`;
                    const needed = Math.max(1, nH2 * nV2);
                    if (!Array.isArray(ptp.projectors)) ptp.projectors = [];
                    while (ptp.projectors.length < needed) {
                        const idx = ptp.projectors.length + 1;
                        ptp.projectors.push({ name: `Projector ${idx}`, color: '#ffffff' });
                    }
                    if (ptp.projectors.length > needed) ptp.projectors = ptp.projectors.slice(0, needed);
                    if (typeof drawProjectorTestPattern === 'function') {
                        const previewCanvas = document.getElementById('testpattern-preview-canvas');
                        if (previewCanvas) drawProjectorTestPattern(previewCanvas, ptp, true, false);
                    }
                } catch (_) {}
                const ovhVal = byId('fc-ovh-val'); if (ovhVal) ovhVal.textContent = ovH.toFixed(1);
                const ovvVal = byId('fc-ovv-val'); if (ovvVal) ovvVal.textContent = ovV.toFixed(1);

                // Visualization
                fcSvg.innerHTML = '';
                const svgW = 1000;
                const svgH = (Wm>0) ? (svgW / Wm) * Hm : 600;
                const m = 50;
                const m2px = (Wm>0) ? (svgW / Wm) : 0;
                const projGap = Math.max(60, Math.min(svgH * 1.2, (throwMeters || 0) * m2px));
                fcSvg.setAttribute('viewBox', `${-m} ${-m} ${svgW + m*2} ${svgH + projGap + m*2}`);

                const NS = 'http://www.w3.org/2000/svg';
                // Arrowhead marker for dimension lines
                const defs = document.createElementNS(NS,'defs');
                const marker = document.createElementNS(NS,'marker');
                marker.setAttribute('id','fc-arrow');
                marker.setAttribute('markerWidth','8');
                marker.setAttribute('markerHeight','8');
                marker.setAttribute('refX','4');
                marker.setAttribute('refY','4');
                marker.setAttribute('orient','auto');
                const mpath = document.createElementNS(NS,'path');
                mpath.setAttribute('d','M0,0 L8,4 L0,8 Z');
                mpath.setAttribute('fill','#6B7280');
                marker.appendChild(mpath);
                defs.appendChild(marker);
                fcSvg.appendChild(defs);
                const rect = document.createElementNS(NS,'rect');
                rect.setAttribute('x','0'); rect.setAttribute('y','0'); rect.setAttribute('width', String(svgW)); rect.setAttribute('height', String(svgH));
                rect.setAttribute('fill','none'); rect.setAttribute('stroke','#9CA3AF'); rect.setAttribute('stroke-width','2');
                fcSvg.appendChild(rect);

                const projW = (singleWm / Wm) * svgW;
                const projH = (singleHm / Hm) * svgH;
                // stepX/stepY = distance between adjacent projector left-edges (accounts for overlap)
                const stepX = (nH2 > 1 && projW > 0) ? projW * (1 - ovHDec) : 0;
                const stepY = (nV2 > 1 && projH > 0) ? projH * (1 - ovVDec) : 0;
                // coverage
                for (let y=0;y<nV2;y++){
                    for (let x=0;x<nH2;x++){
                        const r = document.createElementNS(NS,'rect');
                        r.setAttribute('x', String(x*stepX));
                        r.setAttribute('y', String(y*stepY));
                        r.setAttribute('width', String(projW));
                        r.setAttribute('height', String(projH));
                        r.setAttribute('fill','rgba(37,99,235,0.18)');
                        r.setAttribute('stroke','rgba(37,99,235,0.5)');
                        r.setAttribute('stroke-width','1');
                        fcSvg.appendChild(r);
                    }
                }
                // overlap bands
                const ovWpx = projW * ovHDec; const ovHpx = projH * ovVDec;
                if (nH2>1 && ovWpx>0){
                    for (let i=1;i<nH2;i++){
                        const b = document.createElementNS(NS,'rect');
                        b.setAttribute('x', String(i*stepX)); b.setAttribute('y','0');
                        b.setAttribute('width', String(ovWpx)); b.setAttribute('height', String(svgH));
                        b.setAttribute('fill','rgba(37,99,235,0.35)');
                        fcSvg.appendChild(b);
                    }
                }
                if (nV2>1 && ovHpx>0){
                    for (let j=1;j<nV2;j++){
                        const b = document.createElementNS(NS,'rect');
                        b.setAttribute('x','0'); b.setAttribute('y', String(j*stepY));
                        b.setAttribute('width', String(svgW)); b.setAttribute('height', String(ovHpx));
                        b.setAttribute('fill','rgba(37,99,235,0.35)');
                        fcSvg.appendChild(b);
                    }
                }
                // Dimension arrows for width and height
                const dimColor = '#6B7280';
                // Width arrow (top)
                const wLine = document.createElementNS(NS,'line');
                wLine.setAttribute('x1','0'); wLine.setAttribute('y1', String(-20));
                wLine.setAttribute('x2', String(svgW)); wLine.setAttribute('y2', String(-20));
                wLine.setAttribute('stroke', dimColor); wLine.setAttribute('stroke-width','1.5');
                wLine.setAttribute('marker-start','url(#fc-arrow)');
                wLine.setAttribute('marker-end','url(#fc-arrow)');
                fcSvg.appendChild(wLine);
                const wText = document.createElementNS(NS,'text');
                wText.setAttribute('x', String(svgW/2)); wText.setAttribute('y', String(-30));
                wText.setAttribute('fill','#9CA3AF'); wText.setAttribute('font-size','12'); wText.setAttribute('text-anchor','middle');
                wText.textContent = `${(isFinite(Wm)?Wm:0).toFixed(2)} m`;
                fcSvg.appendChild(wText);
                // Height arrow (left)
                const hLine = document.createElementNS(NS,'line');
                hLine.setAttribute('x1', String(-20)); hLine.setAttribute('y1','0');
                hLine.setAttribute('x2', String(-20)); hLine.setAttribute('y2', String(svgH));
                hLine.setAttribute('stroke', dimColor); hLine.setAttribute('stroke-width','1.5');
                hLine.setAttribute('marker-start','url(#fc-arrow)');
                hLine.setAttribute('marker-end','url(#fc-arrow)');
                fcSvg.appendChild(hLine);
                const hText = document.createElementNS(NS,'text');
                hText.setAttribute('x', String(-30)); hText.setAttribute('y', String(svgH/2));
                hText.setAttribute('fill','#9CA3AF'); hText.setAttribute('font-size','12'); hText.setAttribute('text-anchor','middle');
                hText.setAttribute('transform', `rotate(-90 ${-30} ${svgH/2})`);
                hText.textContent = `${(isFinite(Hm)?Hm:0).toFixed(2)} m`;
                fcSvg.appendChild(hText);
                // projector icons and throw lines
                const projY = svgH + projGap; const projSize = 18;
                for (let x=0;x<nH2;x++){
                    const cx = x*stepX + projW/2;
                    const pr = document.createElementNS(NS,'rect');
                    pr.setAttribute('x', String(cx - projSize/2));
                    pr.setAttribute('y', String(projY - projSize/2));
                    pr.setAttribute('width', String(projSize)); pr.setAttribute('height', String(projSize));
                    pr.setAttribute('fill','#ffffff'); pr.setAttribute('stroke','#111827'); pr.setAttribute('stroke-width','1.5');
                    fcSvg.appendChild(pr);
                    const l1 = document.createElementNS(NS,'line'); l1.setAttribute('x1', String(cx)); l1.setAttribute('y1', String(projY)); l1.setAttribute('x2', String(x*stepX)); l1.setAttribute('y2', String(svgH)); l1.setAttribute('stroke','#9CA3AF'); l1.setAttribute('stroke-width','1'); fcSvg.appendChild(l1);
                    const l2 = document.createElementNS(NS,'line'); l2.setAttribute('x1', String(cx)); l2.setAttribute('y1', String(projY)); l2.setAttribute('x2', String(x*stepX + projW)); l2.setAttribute('y2', String(svgH)); l2.setAttribute('stroke','#9CA3AF'); l2.setAttribute('stroke-width','1'); fcSvg.appendChild(l2);
                    // Center throw dimension line and label (annotation)
                    const dLine = document.createElementNS(NS,'line');
                    dLine.setAttribute('x1', String(cx)); dLine.setAttribute('y1', String(projY));
                    dLine.setAttribute('x2', String(cx)); dLine.setAttribute('y2', String(svgH));
                    dLine.setAttribute('stroke', dimColor); dLine.setAttribute('stroke-width','1'); dLine.setAttribute('stroke-dasharray','4,4');
                    fcSvg.appendChild(dLine);
                    const midY = (projY + svgH)/2 - 6;
                    const dText = document.createElementNS(NS,'text');
                    dText.setAttribute('x', String(cx)); dText.setAttribute('y', String(midY));
                    dText.setAttribute('fill','#9CA3AF'); dText.setAttribute('font-size','10'); dText.setAttribute('text-anchor','middle');
                    dText.textContent = `${(isFinite(throwMeters)?throwMeters:0).toFixed(2)} m`;
                    fcSvg.appendChild(dText);
                    if (x < nH-1){
                        const nx = (x+1)*stepX + projW/2; const mid = (cx+nx)/2; const yL = projY + 16;
                        const dash = document.createElementNS(NS,'line'); dash.setAttribute('x1', String(cx)); dash.setAttribute('y1', String(yL)); dash.setAttribute('x2', String(nx)); dash.setAttribute('y2', String(yL)); dash.setAttribute('stroke','#6B7280'); dash.setAttribute('stroke-dasharray','4,4'); fcSvg.appendChild(dash);
                        const label = document.createElementNS(NS,'text'); label.setAttribute('x', String(mid)); label.setAttribute('y', String(yL - 4)); label.setAttribute('fill','#9CA3AF'); label.setAttribute('font-size','10'); label.setAttribute('text-anchor','middle'); label.textContent = `${(singleWm*(1-ovHDec)).toFixed(2)} m`; fcSvg.appendChild(label);
                    }
                }
            };

            // --- Circular Calculator: visualization helper ---
            const drawCircCalc = () => {
                if (!document.getElementById('ptp-panel-calc-circular') || !ccSvg) return;

                // --- Read inputs ---
                const shape        = (document.getElementById('cc-shape')?.value) || 'circle';
                const D            = Math.max(0, Number(document.getElementById('cc-d')?.value) || 0);
                const Rad          = D / 2;
                const H            = Math.max(0, Number(document.getElementById('cc-sh')?.value) || 0);
                const customAngle  = Math.max(1, Math.min(360, Number(document.getElementById('cc-angle')?.value) || 120));
                const totalAngle   = shape==='circle' ? 360 : (shape==='semi' ? 180 : customAngle);
                const totalAngleRad= totalAngle * Math.PI / 180;
                const arcLen       = Rad * totalAngleRad;
                const projSide     = (document.getElementById('cc-side')?.value) || 'outside';
                const safeAngleDeg = Math.max(10, Number(document.getElementById('cc-safe-angle')?.value) || 90);
                const mode         = (document.getElementById('cc-mode')?.value) || 'distanceToRatio';
                const tLow         = Math.max(0, Number(document.getElementById('cc-throw-low')?.value) || 0);
                const tHighRaw     = Number(document.getElementById('cc-throw-high')?.value);
                const tHigh        = (isFinite(tHighRaw) && tHighRaw >= tLow) ? tHighRaw : tLow;
                let   nH           = Math.max(1, Number(document.getElementById('cc-nh')?.value) || 1);
                let   nV           = Math.max(1, Number(document.getElementById('cc-nv')?.value) || 1);
                const ovH          = Math.max(0, Math.min(90, Number(document.getElementById('cc-ovh')?.value) || 0));
                const ovV          = Math.max(0, Math.min(90, Number(document.getElementById('cc-ovv')?.value) || 0));
                const ovHDec       = ovH / 100;
                const ovVDec       = ovV / 100;
                const autoV        = document.getElementById('cc-auto-v')?.checked || false;
                const pxW          = Math.max(1, Number(document.getElementById('cc-pxw')?.value) || 1920);
                const pxH_res      = Math.max(1, Number(document.getElementById('cc-pxh')?.value) || 1080);

                const pxH          = pxH_res;  // alias (fallthrough)
                const setTxt = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };

                // --- Auto-V: compute rows needed from projector aspect + screen height ---
                // Natural image height from a single projector = chordPerProj * (pxH/pxW)
                // We need effV * imgHperProj_nat >= H
                // where effV = nV - (nV-1)*ovVDec
                // Recompute angPerProjRad early to get chordPerProj for auto-V
                const _effH_av     = nH - (nH - 1) * ovHDec;
                const _arcPP_av    = arcLen > 0 && _effH_av > 0 ? arcLen / _effH_av : 0;
                const _angRad_av   = (Rad > 0 && _arcPP_av > 0) ? _arcPP_av / Rad : 0;
                const _chordPP_av  = Rad > 0 && _angRad_av > 0 ? 2 * Rad * Math.sin(_angRad_av / 2) : _arcPP_av;
                const imgHperProj_nat = _chordPP_av > 0 && pxW > 0 ? _chordPP_av * (pxH / pxW) : 0;
                if (autoV && H > 0 && imgHperProj_nat > 0) {
                    let bestNV = 1;
                    for (let n = 1; n <= 32; n++) {
                        const eff = n - (n - 1) * ovVDec;
                        if (eff > 0 && eff * imgHperProj_nat >= H) { bestNV = n; break; }
                    }
                    nV = bestNV;
                    const nvEl = document.getElementById('cc-nv');
                    if (nvEl) nvEl.value = String(nV);
                    if (s && s.calcCirc) s.calcCirc.numProjectorsVertical = nV;
                }
                // Toggle nV readonly
                const nvEl2 = document.getElementById('cc-nv');
                if (nvEl2) nvEl2.readOnly = autoV;

                // Update throw label
                const throwLblEl  = document.getElementById('cc-throw-label');
                const throwLowLbl = document.getElementById('cc-throw-low-label');
                const throwHiWrap = document.getElementById('cc-throw-high-wrap');
                const isSuggestCC = mode === 'suggestLens';
                const throwLowElCC = document.getElementById('cc-throw-low');
                const throwLowWrapCC = throwLowElCC ? throwLowElCC.parentElement : null;
                if (throwLowWrapCC) throwLowWrapCC.classList.toggle('hidden', isSuggestCC);
                if (throwLowLbl) throwLowLbl.textContent = mode==='ratioToDistance' ? 'Lens Throw Ratio (Low)' : 'Throw Distance (m)';
                if (throwHiWrap)  throwHiWrap.classList.toggle('hidden', isSuggestCC || mode!=='ratioToDistance');
                if (throwLblEl)   throwLblEl.textContent = isSuggestCC ? 'Lens Advisor' : (mode==='ratioToDistance' ? 'Calculated Throw Distance' : 'Calculated Throw Ratio');

                // --- Per-projector arc geometry ---
                // effH = nH - (nH-1)*ovHDec  (coverage factor, accounting for overlap)
                const effH         = nH - (nH - 1) * ovHDec;
                // Actual angular span per projector = totalAngle / effH
                const angPerProjDeg = arcLen > 0 && effH > 0 ? totalAngle / effH : 0;
                const angPerProjRad = angPerProjDeg * Math.PI / 180;
                const arcPerProj   = arcLen > 0 && effH > 0 ? arcLen / effH : 0;
                // Chord per projector: 2R·sin(θ/2) — the flat image width the lens sees
                const chordPerProj = (Rad > 0 && angPerProjRad > 0)
                    ? 2 * Rad * Math.sin(angPerProjRad / 2)
                    : arcPerProj;

                // --- Auto safe-angle check (accounts for overlap) ---
                let checkStatus = '-';
                if (projSide === 'outside' && angPerProjDeg > safeAngleDeg) {
                    // Find smallest nH so that totalAngle / (nH - (nH-1)*ovHDec) <= safeAngleDeg
                    let autoNH = nH;
                    for (let n = nH + 1; n <= 64; n++) {
                        const eff = n - (n - 1) * ovHDec;
                        if (eff > 0 && totalAngle / eff <= safeAngleDeg) { autoNH = n; break; }
                    }
                    nH = autoNH;
                    const nhEl = document.getElementById('cc-nh');
                    if (nhEl) nhEl.value = String(nH);
                    if (s && s.calcCirc) s.calcCirc.numProjectorsHorizontal = nH;
                    checkStatus = `Auto-adjusted to ${nH} projectors to keep ≤ ${safeAngleDeg}°/projector.`;
                }

                // Recompute after possible nH adjustment
                const effHFinal    = nH - (nH - 1) * ovHDec;
                const arcPerProjF  = arcLen > 0 && effHFinal > 0 ? arcLen / effHFinal : 0;
                const angDegF      = arcLen > 0 && effHFinal > 0 ? totalAngle / effHFinal : 0;
                const angRadF      = angDegF * Math.PI / 180;
                const chordProjF   = (Rad > 0 && angRadF > 0) ? 2 * Rad * Math.sin(angRadF / 2) : arcPerProjF;
                const totalProj    = nH * nV;

                // --- Canvas resolution ---
                const overlapPxH   = Math.round(pxW * ovHDec);
                const overlapPxV   = Math.round(pxH * ovVDec);
                const totWpx       = nH * pxW - (nH - 1) * overlapPxH;
                const totHpx       = nV * pxH - (nV - 1) * overlapPxV;

                // --- Pixel pitch ---
                const pitchH_mm    = arcPerProjF > 0 && pxW > 0 ? (arcPerProjF * 1000) / pxW : 0;
                const effV         = nV - (nV - 1) * ovVDec;
                const imgHperRow   = H > 0 && effV > 0 ? H / effV : 0;
                const pitchV_mm    = imgHperRow > 0 && pxH > 0 ? (imgHperRow * 1000) / pxH : 0;

                // --- Flat (unwrapped) canvas dimensions ---
                // totWpx / totHpx already computed above; we also need per-projector natural height
                const projImgH_nat = imgHperProj_nat;  // metres — based on arc/chord & aspect
                // Actual per-projector image height from the layout (H / effV)
                const projImgH_lay = imgHperRow;       // metres

                // --- Throw (chord-based) ---
                let throwOut = '-', throwMeters = 0;
                if (chordProjF > 0) {
                    if (mode === 'ratioToDistance') {
                        const dLow  = tLow  * chordProjF;
                        const dHigh = tHigh * chordProjF;
                        throwOut   = Math.abs(dHigh - dLow) < 0.001 ? `${dLow.toFixed(3)} m` : `${dLow.toFixed(3)} – ${dHigh.toFixed(3)} m`;
                        throwMeters = dLow;
                    } else {
                        const ratio = tLow / chordProjF;
                        throwOut   = `${ratio.toFixed(3)} : 1`;
                        throwMeters = tLow;
                    }
                }

                // --- Notes / projection check ---
                if (checkStatus === '-') {
                    if (projSide === 'inside') {
                        if (!D) {
                            checkStatus = 'Enter diameter and throw data for validation.';
                        } else if (throwMeters > 0 && throwMeters > Rad) {
                            checkStatus = `⚠ Throw (${throwMeters.toFixed(2)} m) > radius (${Rad.toFixed(2)} m). Projectors can’t fit inside.`;
                        } else if (throwMeters > 0) {
                            checkStatus = `✓ Inside: projectors ${(Rad - throwMeters).toFixed(2)} m from centre (radius = ${Rad.toFixed(2)} m).`;
                        } else {
                            checkStatus = 'Enter throw distance to validate inside placement.';
                        }
                    } else {
                        if (angDegF > 0) {
                            if (angDegF > 50)
                                checkStatus = `⚠ ${angDegF.toFixed(1)}°/projector: heavy keystone likely — consider more projectors or shorter throw lens.`;
                            else
                                checkStatus = `✓ ${angDegF.toFixed(1)}°/projector — within acceptable keystone range.`;
                        }
                    }
                }

                // Update overlap value labels
                const ovhValEl = document.getElementById('cc-ovh-val'); if (ovhValEl) ovhValEl.textContent = ovH.toFixed(1);
                const ovvValEl = document.getElementById('cc-ovv-val'); if (ovvValEl) ovvValEl.textContent = ovV.toFixed(1);

                // --- Flat image outputs ---
                setTxt('cc-flat-w',       arcLen > 0 ? `${arcLen.toFixed(3)} m  (${totWpx} px)` : '-');
                setTxt('cc-flat-h',       H > 0 ? `${H.toFixed(3)} m  (${totHpx} px)` : 'enter screen height');
                const projImgWTxt = arcPerProjF > 0
                    ? `${arcPerProjF.toFixed(3)} m arc  /  ${chordProjF.toFixed(3)} m chord  (${pxW} px)`
                    : '-';
                const projImgHTxt = imgHperProj_nat > 0
                    ? `${imgHperProj_nat.toFixed(3)} m natural  /  ${projImgH_lay > 0 ? projImgH_lay.toFixed(3) + ' m layout' : '—'}  (${pxH} px)`
                    : (H > 0 ? '-' : 'enter height');
                setTxt('cc-proj-imgw',    projImgWTxt);
                setTxt('cc-proj-imgh',    projImgHTxt);
                // --- Overlap px outputs ---
                setTxt('cc-ovh-px',       nH > 1 ? `${overlapPxH} px  (${ovH.toFixed(1)}%  of ${pxW} px)` : '— single column');
                setTxt('cc-ovv-px',       nV > 1 ? `${overlapPxV} px  (${ovV.toFixed(1)}%  of ${pxH} px)` : (autoV && imgHperProj_nat >= H ? '— 1 row covers screen' : '— single row'));
                // --- Core metric outputs ---
                setTxt('cc-arc',          arcLen     ? `${arcLen.toFixed(3)} m`      : '-');
                setTxt('cc-canvas',       `${totWpx} × ${totHpx} px`);
                setTxt('cc-total-proj',   `${totalProj}  (${nH}H × ${nV}V)`);
                setTxt('cc-arc-perproj',  arcPerProjF ? `${arcPerProjF.toFixed(3)} m` : '-');
                setTxt('cc-chord-perproj', chordProjF ? `${chordProjF.toFixed(3)} m` : '-');
                setTxt('cc-ang-perproj',  angDegF    ? `${angDegF.toFixed(2)}°`      : '-');
                setTxt('cc-pitch-h',      pitchH_mm  ? `${pitchH_mm.toFixed(3)} mm/px` : '-');
                setTxt('cc-pitch-v',      pitchV_mm  ? `${pitchV_mm.toFixed(3)} mm/px` : (H > 0 ? '-' : 'enter height'));
                if (isSuggestCC) {
                    setTxt('cc-throw', '→ See Lens Advisor below');
                } else {
                    setTxt('cc-throw', throwOut);
                }
                setTxt('cc-check', checkStatus);

                // --- Lens Advisor ---
                const lensAdvCC = document.getElementById('cc-lens-adv');
                if (lensAdvCC) {
                    lensAdvCC.classList.toggle('hidden', !isSuggestCC);
                    if (isSuggestCC && chordProjF > 0) lensAdvCC.innerHTML = buildLensAdvisorHTML(chordProjF, projSide === 'inside', Rad);
                }

                // --- SVG Visualization ---
                ccSvg.innerHTML = '';
                const NS = 'http://www.w3.org/2000/svg';
                const svgW = 700, svgH = 560;
                ccSvg.setAttribute('viewBox', `0 0 ${svgW} ${svgH}`);

                if (!D || arcLen <= 0) {
                    const msg = document.createElementNS(NS, 'text');
                    msg.setAttribute('x', String(svgW/2)); msg.setAttribute('y', String(svgH/2));
                    msg.setAttribute('fill', '#6B7280'); msg.setAttribute('font-size', '16');
                    msg.setAttribute('text-anchor', 'middle');
                    msg.textContent = 'Enter diameter to visualize.';
                    ccSvg.appendChild(msg);
                    return;
                }

                const isInside = projSide === 'inside';
                const cx = svgW / 2;
                const cy = shape === 'semi' ? svgH * 0.60 : svgH * 0.50;
                const R_px = Math.min(svgW * 0.42, svgH * 0.42) * (shape === 'semi' ? 0.82 : 0.78);
                const scale_m2px = R_px / Math.max(0.001, Rad);

                const svgLine = (x1,y1,x2,y2,stroke,sw,dash) => {
                    const l = document.createElementNS(NS,'line');
                    l.setAttribute('x1',String(+x1.toFixed(1))); l.setAttribute('y1',String(+y1.toFixed(1)));
                    l.setAttribute('x2',String(+x2.toFixed(1))); l.setAttribute('y2',String(+y2.toFixed(1)));
                    l.setAttribute('stroke',stroke); l.setAttribute('stroke-width',String(sw||1));
                    if (dash) l.setAttribute('stroke-dasharray',dash);
                    ccSvg.appendChild(l);
                };
                const svgText = (x,y,txt,fill,fs,anchor,xform) => {
                    const t = document.createElementNS(NS,'text');
                    t.setAttribute('x',String(+x.toFixed(1))); t.setAttribute('y',String(+y.toFixed(1)));
                    t.setAttribute('fill',fill||'#9CA3AF'); t.setAttribute('font-size',String(fs||12));
                    t.setAttribute('text-anchor',anchor||'middle');
                    if (xform) t.setAttribute('transform',xform);
                    t.textContent = txt; ccSvg.appendChild(t);
                };

                // --- Angle & arc point helpers ---
                // 0° = left edge of arc (3 o'clock for circle, 9 o'clock offset for semi)
                const startDeg = shape === 'semi' ? 180 : 0;
                const toRad = a => a * Math.PI / 180;
                const ap = (r, aDeg) => ({
                    x: cx + r * Math.cos(toRad(startDeg + aDeg)),
                    y: cy + r * Math.sin(toRad(startDeg + aDeg))
                });

                // Full circle outline (dashed if not a full circle)
                const circ = document.createElementNS(NS,'circle');
                circ.setAttribute('cx',String(cx)); circ.setAttribute('cy',String(cy)); circ.setAttribute('r',String(R_px));
                circ.setAttribute('fill','none'); circ.setAttribute('stroke','#374151');
                circ.setAttribute('stroke-width', shape==='circle' ? '2' : '1');
                circ.setAttribute('stroke-dasharray', shape==='circle' ? '' : '5,4');
                ccSvg.appendChild(circ);

                // Active arc if not full circle
                if (shape !== 'circle') {
                    const pa = ap(R_px, 0), pb = ap(R_px, totalAngle);
                    const la = totalAngle > 180 ? 1 : 0;
                    const arcPath = document.createElementNS(NS,'path');
                    arcPath.setAttribute('d', `M ${pa.x.toFixed(1)} ${pa.y.toFixed(1)} A ${R_px} ${R_px} 0 ${la} 1 ${pb.x.toFixed(1)} ${pb.y.toFixed(1)}`);
                    arcPath.setAttribute('fill','none'); arcPath.setAttribute('stroke','#F59E0B'); arcPath.setAttribute('stroke-width','2.5');
                    ccSvg.appendChild(arcPath);
                    svgLine(pa.x, pa.y, pb.x, pb.y, '#4B5563', 1, '5,4');
                }

                // Centre crosshair
                svgLine(cx-12, cy, cx+12, cy, '#4B5563', 1);
                svgLine(cx, cy-12, cx, cy+12, '#4B5563', 1);

                const projCols = [
                    'rgba(37,99,235,0.85)','rgba(16,185,129,0.85)','rgba(239,68,68,0.85)',
                    'rgba(245,158,11,0.85)','rgba(139,92,246,0.85)','rgba(20,184,166,0.85)',
                    'rgba(249,115,22,0.85)','rgba(236,72,153,0.85)'
                ];
                const band    = Math.max(6, R_px * 0.10);
                const stepDeg = angDegF * (1 - ovHDec);  // angular step with overlap
                const throwPx = throwMeters * scale_m2px;

                // --- Draw projector segments & icons ---
                for (let i = 0; i < nH; i++) {
                    const a0 = i * stepDeg;
                    const a1 = a0 + angDegF;
                    const aMid = (a0 + a1) / 2;
                    const la   = (a1 - a0) > 180 ? 1 : 0;
                    const col  = projCols[i % projCols.length];

                    // Arc segment (band on the ring)
                    const pO0 = ap(R_px, a0),        pO1 = ap(R_px, a1);
                    const pI0 = ap(R_px - band, a0), pI1 = ap(R_px - band, a1);
                    const seg = document.createElementNS(NS,'path');
                    const d = [
                        `M ${pI0.x.toFixed(1)} ${pI0.y.toFixed(1)}`,
                        `L ${pO0.x.toFixed(1)} ${pO0.y.toFixed(1)}`,
                        `A ${R_px} ${R_px} 0 ${la} 1 ${pO1.x.toFixed(1)} ${pO1.y.toFixed(1)}`,
                        `L ${pI1.x.toFixed(1)} ${pI1.y.toFixed(1)}`,
                        `A ${R_px-band} ${R_px-band} 0 ${la} 0 ${pI0.x.toFixed(1)} ${pI0.y.toFixed(1)}`,
                        'Z'
                    ].join(' ');
                    seg.setAttribute('d', d);
                    seg.setAttribute('fill', col.replace('0.85','0.22'));
                    seg.setAttribute('stroke', col.replace('0.85','0.65'));
                    seg.setAttribute('stroke-width','1.5');
                    ccSvg.appendChild(seg);

                    // Projector icon position
                    const projSize = 13;
                    const rOff = Math.max(28, Math.min(R_px * 0.55, throwPx || R_px * 0.3));
                    let pjX, pjY;
                    if (isInside) {
                        // Place projector inside the ring, pointing outward
                        const pIn = ap(R_px - band - rOff - projSize, aMid);
                        pjX = pIn.x; pjY = pIn.y;
                    } else {
                        // Place projector outside the ring
                        const pOut = ap(R_px + rOff + projSize, aMid);
                        pjX = pOut.x; pjY = pOut.y;
                    }

                    // Throw cone lines
                    const pMid = ap(R_px, aMid);
                    svgLine(pjX, pjY, pO0.x, pO0.y, 'rgba(148,163,184,0.35)', 1, '3,3');
                    svgLine(pjX, pjY, pO1.x, pO1.y, 'rgba(148,163,184,0.35)', 1, '3,3');
                    svgLine(pjX, pjY, pMid.x, pMid.y, col.replace('0.85','0.45'), 1, '2,2');

                    // Projector box
                    const pr = document.createElementNS(NS,'rect');
                    pr.setAttribute('x', String((pjX - projSize/2).toFixed(1)));
                    pr.setAttribute('y', String((pjY - projSize/2).toFixed(1)));
                    pr.setAttribute('width', String(projSize)); pr.setAttribute('height', String(projSize));
                    pr.setAttribute('fill', '#f8fafc'); pr.setAttribute('stroke', col.replace('0.85','1'));
                    pr.setAttribute('stroke-width', '2');
                    ccSvg.appendChild(pr);
                    svgText(pjX, pjY + projSize + 11, `P${i+1}`, '#9CA3AF', 9);
                }

                // Overlap zones — amber band at each seam
                if (nH > 1 && ovHDec > 0) {
                    for (let i = 1; i < nH; i++) {
                        const a0 = i * stepDeg;
                        const a1 = a0 + angDegF * ovHDec;
                        const la = (a1-a0) > 180 ? 1 : 0;
                        const pO0 = ap(R_px,a0), pO1 = ap(R_px,a1);
                        const pI0 = ap(R_px-band,a0), pI1 = ap(R_px-band,a1);
                        const ov = document.createElementNS(NS,'path');
                        const d = [
                            `M ${pI0.x.toFixed(1)} ${pI0.y.toFixed(1)}`,
                            `L ${pO0.x.toFixed(1)} ${pO0.y.toFixed(1)}`,
                            `A ${R_px} ${R_px} 0 ${la} 1 ${pO1.x.toFixed(1)} ${pO1.y.toFixed(1)}`,
                            `L ${pI1.x.toFixed(1)} ${pI1.y.toFixed(1)}`,
                            `A ${R_px-band} ${R_px-band} 0 ${la} 0 ${pI0.x.toFixed(1)} ${pI0.y.toFixed(1)}`,
                            'Z'
                        ].join(' ');
                        ov.setAttribute('d', d);
                        ov.setAttribute('fill','rgba(251,191,36,0.50)');
                        ov.setAttribute('stroke','rgba(251,191,36,0.8)'); ov.setAttribute('stroke-width','1');
                        ccSvg.appendChild(ov);
                    }
                }

                // Diameter annotation
                svgLine(cx - R_px, cy, cx + R_px, cy, '#374151', 1, '4,3');
                svgText(cx, cy - 8, `D = ${D.toFixed(2)} m`, '#6B7280', 11);

                // Arc label
                const arcTip = ap(R_px + 22, totalAngle / 2);
                svgText(arcTip.x, arcTip.y, `Arc = ${arcLen.toFixed(3)} m`, '#9CA3AF', 10);

                // Bottom caption
                const caption = `${shape==='circle'?'Full Circle':(shape==='semi'?'Semi-circle':totalAngle.toFixed(1)+'° Arc')}  •  ${isInside?'Inside (Concave)':'Outside (Convex)'}  •  ${nH}H×${nV}V  •  D=${D.toFixed(2)} m`;
                svgText(svgW/2, svgH - 14, caption, '#4B5563', 11);
            };

            // --- Curved Screen Calculator: visualization helper ---
            const drawCurveCalc = () => {
                if (!document.getElementById('ptp-panel-calc-curve') || !cvSvg) return;

                // --- Read all inputs ---
                const W  = Math.max(0, Number(document.getElementById('cv-screen-w')?.value) || 0);   // chord (m)
                const H  = Math.max(0, Number(document.getElementById('cv-screen-h')?.value) || 0);   // height (m)
                const D  = Math.max(0, Number(document.getElementById('cv-depth')?.value) || 0);      // sagitta (m)
                const curveType = (document.getElementById('cv-type')?.value) || 'concave';
                const pxW = Math.max(1, Number(document.getElementById('cv-pxw')?.value) || 1920);
                const pxH = Math.max(1, Number(document.getElementById('cv-pxh')?.value) || 1080);
                let nH    = Math.max(1, Number(document.getElementById('cv-nh')?.value) || 1);
                const ovP = Math.max(0, Math.min(90, Number(document.getElementById('cv-ovp')?.value) || 0));
                const ovDec = ovP / 100;
                let nV    = Math.max(1, Number(document.getElementById('cv-nv')?.value)  || 1);
                const ovV    = Math.max(0, Math.min(90, Number(document.getElementById('cv-ovv')?.value) || 0));
                const ovVDec = ovV / 100;
                const autoCalc     = document.getElementById('cv-auto')?.checked || false;
                const safeAngleDeg = Math.max(10, Number(document.getElementById('cv-safe-angle')?.value) || 40);
                const mode = (document.getElementById('cv-mode')?.value) || 'ratioToDistance';
                const tLow = Math.max(0, Number(document.getElementById('cv-throw-low')?.value) || 0);
                const tHighRaw = Number(document.getElementById('cv-throw-high')?.value);
                const tHigh = (isFinite(tHighRaw) && tHighRaw >= tLow) ? tHighRaw : tLow;

                // Update throw UI labels
                const throwLowLbl = document.getElementById('cv-throw-low-label');
                const throwHighWrap = document.getElementById('cv-throw-high-wrap');
                const throwLbl = document.getElementById('cv-throw-label');
                const ratioLbl = document.getElementById('cv-ratio-label');
                const isSuggestCV = mode === 'suggestLens';
                const throwLowElCV = document.getElementById('cv-throw-low');
                const throwLowWrapCV = throwLowElCV ? throwLowElCV.parentElement : null;
                if (throwLowWrapCV) throwLowWrapCV.classList.toggle('hidden', isSuggestCV);
                if (mode === 'distanceToRatio') {
                    if (throwLowLbl) throwLowLbl.textContent = 'Throw Distance (m)';
                    if (throwHighWrap) throwHighWrap.classList.add('hidden');
                    if (throwLbl) throwLbl.textContent = 'Throw Distance (input)';
                    if (ratioLbl) ratioLbl.textContent = 'Calculated Throw Ratio';
                } else if (isSuggestCV) {
                    if (throwHighWrap) throwHighWrap.classList.add('hidden');
                    if (throwLbl) throwLbl.textContent = 'Lens Advisor';
                    if (ratioLbl) ratioLbl.textContent = 'Lens Advisor';
                } else {
                    if (throwLowLbl) throwLowLbl.textContent = 'Lens Throw Ratio (Low)';
                    if (throwHighWrap) throwHighWrap.classList.remove('hidden');
                    if (throwLbl) throwLbl.textContent = 'Calculated Throw Distance';
                    if (ratioLbl) ratioLbl.textContent = 'Throw Ratio (input)';
                }

                const setTxt = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };

                // --- Core arc geometry (sagitta formula) ---
                // R = (D² + (W/2)²) / (2D)
                // θ = 2 * arcsin(W / (2R))    [arc angle in radians]
                // L = R * θ                    [arc length]
                let radius = null, thetaRad = 0, angleDeg = 0, arcLen = 0;
                if (W > 0 && D > 0 && D < W) {
                    const wh = W / 2;
                    radius    = (D * D + wh * wh) / (2 * D);
                    thetaRad  = 2 * Math.asin(Math.max(-1, Math.min(1, wh / radius)));
                    angleDeg  = thetaRad * 180 / Math.PI;
                    arcLen    = radius * thetaRad;
                }

                // --- Auto-calc nH from max safe angle per projector ---
                if (autoCalc && angleDeg > 0) {
                    nH = Math.max(1, Math.ceil(angleDeg / safeAngleDeg));
                    const nhEl = document.getElementById('cv-nh');
                    if (nhEl) nhEl.value = String(nH);
                    if (s && s.calcCurve) s.calcCurve.numProjectors = nH;
                }
                // Toggle safe-angle wrapper + readonly state
                const safeWrap = document.getElementById('cv-safe-wrap');
                if (safeWrap) safeWrap.classList.toggle('hidden', !autoCalc);
                const nhEl2 = document.getElementById('cv-nh');
                if (nhEl2) nhEl2.readOnly = autoCalc;

                // --- Layout math ---
                // effH = nH - (nH-1)*ovDec   (coverage factor)
                // arcPerProj = L / effH       (arc each projector covers)
                // overlapArc = arcPerProj * ovDec
                // overlapPx  = round(pxW * ovDec)
                // totWpx     = nH*pxW - (nH-1)*overlapPx
                // pitchMm    = (arcPerProj * 1000) / pxW
                const effH        = nH - (nH - 1) * ovDec;
                const arcPerProj  = (arcLen > 0 && effH > 0) ? arcLen / effH : 0;
                // Chord per projector: 2R·sin(θ/2) — the *flat* image width the lens actually projects
                const angPerProj  = (radius > 0 && arcPerProj > 0) ? arcPerProj / radius : 0;  // radians
                const chordPerProj = (radius > 0 && angPerProj > 0)
                    ? 2 * radius * Math.sin(angPerProj / 2)
                    : arcPerProj;  // fallback for tiny arcs
                const overlapArc  = arcPerProj * ovDec;
                const overlapPx   = Math.round(pxW * ovDec);
                const totWpx      = nH * pxW - (nH - 1) * overlapPx;
                const pitchMm     = (arcPerProj > 0 && pxW > 0) ? (arcPerProj * 1000) / pxW : 0;
                const chordPitchMm= (chordPerProj > 0 && pxW > 0) ? (chordPerProj * 1000) / pxW : 0;

                // --- Multi-level (vertical) layout math ---
                const effV        = nV - (nV - 1) * ovVDec;
                const imgHperProj = (effV > 0 && H > 0) ? H / effV : 0;
                const overlapVPx  = Math.round(pxH * ovVDec);
                const totHpx      = nV * pxH - (nV - 1) * overlapVPx;
                const pitchVMm    = (imgHperProj > 0 && pxH > 0) ? (imgHperProj * 1000) / pxH : 0;
                const totalProj   = nH * nV;

                // --- Throw (uses CHORD width — correct basis for throw ratio) ---
                let throwDistLow = 0, throwDistHigh = 0, throwOut = '-', throwRatioOut = '-';
                if (chordPerProj > 0) {
                    if (mode === 'ratioToDistance') {
                        throwDistLow  = tLow  * chordPerProj;
                        throwDistHigh = tHigh * chordPerProj;
                        throwRatioOut = Math.abs(tHigh - tLow) < 0.001 ? `${tLow.toFixed(2)} : 1` : `${tLow.toFixed(2)} – ${tHigh.toFixed(2)} : 1`;
                        throwOut      = Math.abs(throwDistHigh - throwDistLow) < 0.001 ? `${throwDistLow.toFixed(3)} m` : `${throwDistLow.toFixed(3)} – ${throwDistHigh.toFixed(3)} m`;
                    } else {
                        throwDistLow  = tLow; throwDistHigh = tLow;
                        const ratio   = chordPerProj > 0 ? tLow / chordPerProj : 0;
                        throwRatioOut = `${ratio.toFixed(3)} : 1`;
                        throwOut      = `${tLow.toFixed(3)} m (input)`;
                    }
                }

                // --- Notes / warnings ---
                let notes = '-';
                if (radius && arcPerProj > 0) {
                    const oneProjAngleDeg = (arcPerProj / radius) * 180 / Math.PI;
                    if (throwDistLow > 0 && throwDistLow < D)
                        notes = `⚠ Throw (${throwDistLow.toFixed(2)} m) < curve depth (${D.toFixed(2)} m) — projectors must sit inside the curve.`;
                    else if (nH > 1 && ovP < 10)
                        notes = `ℹ Overlap ${ovP.toFixed(1)}% is low — consider ≥ 10–25% for proper edge blending.`;
                    else if (oneProjAngleDeg > 50)
                        notes = `⚠ Each projector subtends ${oneProjAngleDeg.toFixed(1)}° — keystoning may be significant beyond ~40°.`;
                    else
                        notes = `✓ Each projector covers ${arcPerProj.toFixed(3)} m of arc (${oneProjAngleDeg.toFixed(1)}°).`;
                }

                // --- Output fields ---
                setTxt('cv-radius',        radius     ? `${radius.toFixed(3)} m`    : '-');
                setTxt('cv-arc',           arcLen     ? `${arcLen.toFixed(3)} m`    : '-');
                setTxt('cv-angle',         angleDeg   ? `${angleDeg.toFixed(2)}°`   : '-');
                setTxt('cv-chord-h',       H          ? `${H.toFixed(3)} m`         : '-');
                setTxt('cv-proj-count',    `${nH}H × ${nV}V`);
                setTxt('cv-total-proj',    `${totalProj}  (${nH}H × ${nV}V)`);
                setTxt('cv-image-size',    arcPerProj ? `${arcPerProj.toFixed(3)} m  (arc)` : '-');
                setTxt('cv-chord-proj',    chordPerProj ? `${chordPerProj.toFixed(3)} m  (${(angPerProj*180/Math.PI).toFixed(1)}°)` : '-');
                setTxt('cv-single-h',      imgHperProj > 0 ? `${imgHperProj.toFixed(3)} m` : '-');
                setTxt('cv-overlap',       nH > 1 ? `${overlapArc.toFixed(3)} m  (${overlapPx} px, ${ovP.toFixed(1)}%)` : '— single projector');
                setTxt('cv-overlap-v',     nV > 1 ? `${overlapVPx} px  (${ovV.toFixed(1)}%)` : '— single row');
                setTxt('cv-canvas',        totWpx ? `${totWpx} × ${totHpx} px` : '-');
                setTxt('cv-pitch',         pitchMm ? `${pitchMm.toFixed(3)} mm/px arc  |  chord: ${chordPitchMm.toFixed(3)} mm/px${pitchVMm > 0 ? '  |  V: ' + pitchVMm.toFixed(3) + ' mm/px' : ''}` : '-');
                setTxt('cv-throw',         throwOut);
                setTxt('cv-throw-ratio-out', throwRatioOut);
                setTxt('cv-notes',         notes);

                // --- Lens Advisor ---
                const lensAdvCV = document.getElementById('cv-lens-adv');
                if (lensAdvCV) {
                    lensAdvCV.classList.toggle('hidden', !isSuggestCV);
                    if (isSuggestCV && chordPerProj > 0) lensAdvCV.innerHTML = buildLensAdvisorHTML(chordPerProj, false, 0);
                }
                if (isSuggestCV) {
                    setTxt('cv-throw', '→ See Lens Advisor below');
                    setTxt('cv-throw-ratio-out', '→ See Lens Advisor below');
                }

                // --- SVG top-down visualization ---
                // Layout: chord horizontal, arc bows toward projectors
                // Concave: arc bows downward (projectors below); Convex: arc bows upward (projectors above)
                cvSvg.innerHTML = '';
                const NS = 'http://www.w3.org/2000/svg';
                const svgW = 760, svgH = 580;
                cvSvg.setAttribute('viewBox', `-60 -60 ${svgW + 120} ${svgH + 120}`);

                if (!radius || arcLen <= 0) {
                    const msg = document.createElementNS(NS, 'text');
                    msg.setAttribute('x', String(svgW/2)); msg.setAttribute('y', String(svgH/2));
                    msg.setAttribute('fill', '#6B7280'); msg.setAttribute('font-size', '18');
                    msg.setAttribute('text-anchor', 'middle');
                    msg.textContent = 'Enter screen width, height and curve depth to visualize.';
                    cvSvg.appendChild(msg);
                    return;
                }

                const useW  = svgW - 120;                       // drawable width
                const scale = W > 0 ? useW / W : 1;            // SVG px per meter
                const rPx   = radius * scale;
                const dPx   = D * scale;
                const throwPx = throwDistLow * scale;

                // Chord at chordY; arc bows toward projectors
                // concave: arc below chord → circle center above chord
                // convex : arc above chord → circle center below chord
                const isConcave = curveType !== 'convex';
                const chordY = isConcave ? 100 : (100 + dPx + 30);
                const cx = svgW / 2;
                const leftX = cx - useW / 2;
                const rightX = cx + useW / 2;

                // Circle center
                const cy_c = isConcave
                    ? chordY - (rPx - dPx)      // above chord → arc goes down toward cy_c + rPx = chordY + dPx
                    : chordY + (rPx - dPx);     // below chord → arc goes up

                // halfArc angle (from downward OR upward vertical from circle center)
                const halfArc = Math.asin(Math.max(-1, Math.min(1, (W / 2) / radius)));

                // Arc point at angle α from the vertical (0 = arc midpoint)
                // concave: x = cx + rPx*sinα,  y = cy_c + rPx*cosα  (midpoint below chord ✓)
                // convex:  x = cx + rPx*sinα,  y = cy_c - rPx*cosα  (midpoint above chord ✓)
                const arcPt = (α) => isConcave
                    ? { x: cx + rPx * Math.sin(α),  y: cy_c + rPx * Math.cos(α) }
                    : { x: cx + rPx * Math.sin(α),  y: cy_c - rPx * Math.cos(α) };

                // Outward normal at α (away from center = toward projectors)
                // Concave: center is above chord; arc midpoint is below → normal (toward proj) points downward = (sin α, +cos α)  ✓
                // Convex:  center is below chord; arc midpoint is above → normal (toward proj) points downward = (-sin α, +cos α)  ✓
                const outNorm = (α) => isConcave
                    ? { nx:  Math.sin(α), ny:  Math.cos(α) }
                    : { nx: -Math.sin(α), ny:  Math.cos(α) };

                // SVG helpers
                const svgLine = (x1,y1,x2,y2,stroke,sw,dash) => {
                    const l = document.createElementNS(NS,'line');
                    l.setAttribute('x1',x1); l.setAttribute('y1',y1); l.setAttribute('x2',x2); l.setAttribute('y2',y2);
                    l.setAttribute('stroke',stroke); l.setAttribute('stroke-width',sw);
                    if (dash) l.setAttribute('stroke-dasharray',dash);
                    cvSvg.appendChild(l); return l;
                };
                const svgText = (x,y,txt,fill,fs,anchor,xform) => {
                    const t = document.createElementNS(NS,'text');
                    t.setAttribute('x',x); t.setAttribute('y',y); t.setAttribute('fill',fill);
                    t.setAttribute('font-size',fs||'12'); t.setAttribute('text-anchor',anchor||'middle');
                    if (xform) t.setAttribute('transform',xform);
                    t.textContent = txt; cvSvg.appendChild(t); return t;
                };
                const svgPath = (d,fill,stroke,sw,extra) => {
                    const p = document.createElementNS(NS,'path');
                    p.setAttribute('d',d); p.setAttribute('fill',fill||'none');
                    p.setAttribute('stroke',stroke||'none'); p.setAttribute('stroke-width',sw||'1');
                    if (extra) Object.entries(extra).forEach(([k,v]) => p.setAttribute(k,v));
                    cvSvg.appendChild(p); return p;
                };
                const polyline = (pts, stroke, sw, fill, dash) => {
                    const pl = document.createElementNS(NS,'polyline');
                    pl.setAttribute('points', pts.map(p=>`${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' '));
                    pl.setAttribute('fill', fill||'none'); pl.setAttribute('stroke', stroke);
                    pl.setAttribute('stroke-width', sw||'1');
                    if (dash) pl.setAttribute('stroke-dasharray', dash);
                    cvSvg.appendChild(pl); return pl;
                };

                // arrowhead defs
                const defs = document.createElementNS(NS,'defs');
                ['cv-arr','cv-arr-b'].forEach((id,idx) => {
                    const m = document.createElementNS(NS,'marker');
                    m.setAttribute('id',id); m.setAttribute('markerWidth','8'); m.setAttribute('markerHeight','8');
                    m.setAttribute('refX','4'); m.setAttribute('refY','4'); m.setAttribute('orient','auto');
                    const mp = document.createElementNS(NS,'path');
                    mp.setAttribute('d','M0,0 L8,4 L0,8 Z'); mp.setAttribute('fill', idx===0?'#6B7280':'#38bdf8');
                    m.appendChild(mp); defs.appendChild(m);
                });
                cvSvg.appendChild(defs);

                // 'TOP VIEW' label + curve type hint
                svgText(svgW/2, -32, `TOP VIEW — ${isConcave ? 'Concave: hollow face toward projectors' : 'Convex: dome/outer face toward projectors'}`, '#4B5563', '13');

                // --- Projector coverage zones on arc ---
                const projCols = ['rgba(37,99,235,0.85)','rgba(16,185,129,0.85)','rgba(239,68,68,0.85)',
                    'rgba(245,158,11,0.85)','rgba(139,92,246,0.85)','rgba(20,184,166,0.85)',
                    'rgba(249,115,22,0.85)','rgba(236,72,153,0.85)'];

                if (nH > 0 && thetaRad > 0) {
                    const spanAngle = thetaRad / effH;
                    const stepAngle = spanAngle * (1 - ovDec);

                    for (let i = 0; i < nH; i++) {
                        const αS = -halfArc + i * stepAngle;
                        const αE = αS + spanAngle;
                        const steps = Math.max(10, Math.round(Math.abs(αE - αS) * 30));
                        const pts = [];
                        for (let s = 0; s <= steps; s++) {
                            pts.push(arcPt(αS + (αE - αS) * s / steps));
                        }
                        polyline(pts, projCols[i % projCols.length], '7', 'none');
                    }

                    // Overlap zones (brighter amber, drawn on top)
                    if (nH > 1 && ovDec > 0) {
                        for (let i = 1; i < nH; i++) {
                            const αS = -halfArc + i * stepAngle;
                            const αE = αS + spanAngle * ovDec;
                            const steps = Math.max(6, Math.round(Math.abs(αE - αS) * 30));
                            const pts = [];
                            for (let s = 0; s <= steps; s++) pts.push(arcPt(αS + (αE - αS) * s / steps));
                            polyline(pts, 'rgba(251,191,36,0.95)', '10', 'none');
                        }
                    }
                }

                // --- Main screen arc ---
                const ptL = arcPt(-halfArc), ptR = arcPt(halfArc), ptM = arcPt(0);
                const lArc = angleDeg > 180 ? 1 : 0;
                const sweep = isConcave ? 1 : 0;
                svgPath(`M ${ptL.x.toFixed(1)} ${ptL.y.toFixed(1)} A ${rPx.toFixed(1)} ${rPx.toFixed(1)} 0 ${lArc} ${sweep} ${ptR.x.toFixed(1)} ${ptR.y.toFixed(1)}`,
                    'none', 'rgba(251,191,36,0.95)', '3');

                // --- Chord dashed line ---
                svgLine(ptL.x, ptL.y, ptR.x, ptR.y, '#374151', '1.5', '6,4');

                // --- Depth indicator (chord midpoint → arc midpoint) ---
                const chordMidX = (ptL.x + ptR.x) / 2, chordMidY = (ptL.y + ptR.y) / 2;
                svgLine(chordMidX, chordMidY, ptM.x, ptM.y, '#38bdf8', '1.5', '4,3');
                svgText(ptM.x + 10, (chordMidY + ptM.y) / 2, `D = ${D.toFixed(2)} m`, '#38bdf8', '11', 'start');

                // --- Projector icons + throw cones ---
                const projSize = 16;
                if (nH > 0 && thetaRad > 0) {
                    const spanAngle = thetaRad / effH;
                    const stepAngle = spanAngle * (1 - ovDec);
                    for (let i = 0; i < nH; i++) {
                        const αS  = -halfArc + i * stepAngle;
                        const αE  = αS + spanAngle;
                        const αC  = (αS + αE) / 2;
                        const n   = outNorm(αC);
                        const ap  = arcPt(αC);
                        const apL = arcPt(αS);
                        const apR = arcPt(αE);

                        const pjX = ap.x + throwPx * n.nx;
                        const pjY = ap.y + throwPx * n.ny;

                        // Throw cone lines to left/right edges of section
                        svgLine(pjX, pjY, apL.x, apL.y, 'rgba(148,163,184,0.45)', '1', '3,3');
                        svgLine(pjX, pjY, apR.x, apR.y, 'rgba(148,163,184,0.45)', '1', '3,3');

                        // Central throw axis
                        svgLine(pjX, pjY, ap.x, ap.y, projCols[i % projCols.length].replace('0.85','0.5'), '1', '2,2');

                        // Projector rectangle
                        const pr = document.createElementNS(NS,'rect');
                        pr.setAttribute('x', String((pjX - projSize/2).toFixed(1)));
                        pr.setAttribute('y', String((pjY - projSize/2).toFixed(1)));
                        pr.setAttribute('width', String(projSize)); pr.setAttribute('height', String(projSize));
                        pr.setAttribute('fill', '#f8fafc'); pr.setAttribute('stroke', projCols[i % projCols.length].replace('0.85','1'));
                        pr.setAttribute('stroke-width', '2');
                        cvSvg.appendChild(pr);

                        // Projector label
                        svgText(pjX, pjY + projSize + 14, `P${i+1}`, '#9CA3AF', '10', 'middle');
                    }
                }

                // --- Dimension annotations ---
                // Width arrow (chord)
                const dimY = Math.max(ptL.y, ptR.y, ptM.y) + 24;
                const wLine = document.createElementNS(NS,'line');
                wLine.setAttribute('x1',String(ptL.x)); wLine.setAttribute('y1',String(dimY));
                wLine.setAttribute('x2',String(ptR.x)); wLine.setAttribute('y2',String(dimY));
                wLine.setAttribute('stroke','#6B7280'); wLine.setAttribute('stroke-width','1.5');
                wLine.setAttribute('marker-start','url(#cv-arr)'); wLine.setAttribute('marker-end','url(#cv-arr)');
                cvSvg.appendChild(wLine);
                svgText((ptL.x+ptR.x)/2, dimY+16, `W = ${W.toFixed(2)} m  (chord)`, '#9CA3AF', '12');

                // Arc length label (along arc midpoint)
                svgText(ptM.x, ptM.y + (isConcave ? 18 : -10), `Arc = ${arcLen.toFixed(3)} m`, '#9CA3AF', '11');

                // Angle label
                svgText(cx, chordY - 14, `${angleDeg.toFixed(1)}°`, '#6B7280', '11', 'middle');

                // --- Side-elevation inset (when nV > 1) ---
                if (nV > 1 && H > 0) {
                    const inX = svgW - 120, inW = 80, inH2 = Math.min(220, svgH * 0.45);
                    const inY = 20;
                    const rowH = inH2 / nV;
                    const rowCols = ['rgba(37,99,235,0.7)','rgba(16,185,129,0.7)','rgba(239,68,68,0.7)',
                        'rgba(245,158,11,0.7)','rgba(139,92,246,0.7)','rgba(20,184,166,0.7)',
                        'rgba(249,115,22,0.7)','rgba(236,72,153,0.7)'];
                    // Background
                    const bg = document.createElementNS(NS,'rect');
                    bg.setAttribute('x',String(inX-6)); bg.setAttribute('y',String(inY-20));
                    bg.setAttribute('width',String(inW+20)); bg.setAttribute('height',String(inH2+40));
                    bg.setAttribute('fill','rgba(15,23,42,0.85)'); bg.setAttribute('rx','5');
                    cvSvg.appendChild(bg);
                    svgText(inX + inW/2, inY - 6, 'SIDE VIEW', '#6B7280', '9');
                    for (let v = 0; v < nV; v++) {
                        const ry = inY + v * rowH * (1 - ovVDec);
                        const rh = rowH;
                        const rct = document.createElementNS(NS,'rect');
                        rct.setAttribute('x',String(inX)); rct.setAttribute('y',String(ry.toFixed(1)));
                        rct.setAttribute('width',String(inW)); rct.setAttribute('height',String(rh.toFixed(1)));
                        rct.setAttribute('fill', rowCols[v % rowCols.length]);
                        rct.setAttribute('stroke','#1e293b'); rct.setAttribute('stroke-width','1');
                        cvSvg.appendChild(rct);
                        svgText(inX + inW/2, ry + rh/2 + 4, `R${v+1}`, '#f8fafc', '9');
                    }
                    // Overlap highlight (amber) between rows
                    if (ovVDec > 0) {
                        for (let v = 1; v < nV; v++) {
                            const ry = inY + v * rowH * (1 - ovVDec);
                            const oh = rowH * ovVDec;
                            const oRct = document.createElementNS(NS,'rect');
                            oRct.setAttribute('x',String(inX)); oRct.setAttribute('y',String(ry.toFixed(1)));
                            oRct.setAttribute('width',String(inW)); oRct.setAttribute('height',String(oh.toFixed(1)));
                            oRct.setAttribute('fill','rgba(251,191,36,0.55)'); oRct.setAttribute('stroke','none');
                            cvSvg.appendChild(oRct);
                        }
                    }
                    // H label
                    const totalBarH = rowH + (nV - 1) * rowH * (1 - ovVDec);
                    svgLine(inX - 4, inY, inX - 4, inY + totalBarH, '#38bdf8', '1', '3,2');
                    svgText(inX - 8, inY + totalBarH/2, `${H.toFixed(1)} m`, '#38bdf8', '9', 'middle',
                        `rotate(-90, ${inX - 8}, ${(inY + inY + totalBarH)/2})`);
                }
            };
            // Helper: recompute total size based on display and overlap
            const recalcAndSyncTotals = () => {
                const dispW = Math.max(1, Number(s.displayWidth) || 1);
                const dispH = Math.max(1, Number(s.displayHeight) || 1);
                const nx = Math.max(1, Number(s.displaysX) || 1);
                const ny = Math.max(1, Number(s.displaysY) || 1);
                // Clamp px overlaps and sync percents
                let ovx = Math.max(0, Number(s.overlapX) || 0);
                let ovy = Math.max(0, Number(s.overlapY) || 0);
                ovx = Math.min(dispW - 1, ovx);
                ovy = Math.min(dispH - 1, ovy);
                s.overlapX = ovx;
                s.overlapY = ovy;
                s.overlapXPercent = Math.max(0, Math.round(ovx / dispW * 100));
                s.overlapYPercent = Math.max(0, Math.round(ovy / dispH * 100));
                const totalW = Math.max(1, nx * dispW - (nx - 1) * ovx);
                const totalH = Math.max(1, ny * dispH - (ny - 1) * ovy);
                s.totalWidth = totalW;
                s.totalHeight = totalH;
                // Sync dome diameter if locked
                if (s.domeDiameterLock) {
                    s.domeDiameterPx = Math.min(totalW, totalH);
                    const ppm = Math.max(1, Number(s.domePixelsPerMeter) || 1);
                    const meters = s.domeDiameterPx / ppm;
                    s.domeDiameterValue = metersToUnit(meters, s.domeDiameterUnit || 'm');
                    const valEl = document.getElementById('ptp-dome-dia-value');
                    if (valEl) valEl.value = fmtDomeVal(s.domeDiameterValue, s.domeDiameterUnit || 'm');
                }
                const tw = document.getElementById('ptp-total-width');
                const th = document.getElementById('ptp-total-height');
                if (tw) tw.value = String(totalW);
                if (th) th.value = String(totalH);
                // push synced values to inputs if present
                const oxpx = document.getElementById('ptp-overlap-x-px');
                const oxpct = document.getElementById('ptp-overlap-x-pct');
                const oypx = document.getElementById('ptp-overlap-y-px');
                const oypct = document.getElementById('ptp-overlap-y-pct');
                if (oxpx) oxpx.value = String(s.overlapX);
                if (oxpct) oxpct.value = String(s.overlapXPercent);
                if (oypx) oypx.value = String(s.overlapY);
                if (oypct) oypct.value = String(s.overlapYPercent);
                drawBothPreviews();
            };
            // Helper: compute projector counts from target totals (blend-aware)
            const computeCountsFromTotals = (targetW, targetH) => {
                const dispW = Math.max(1, Number(s.displayWidth) || 1);
                const dispH = Math.max(1, Number(s.displayHeight) || 1);
                const ovx = s.overlap ? Math.max(0, Math.min(dispW - 1, Number(s.overlapX) || 0)) : 0;
                const ovy = s.overlap ? Math.max(0, Math.min(dispH - 1, Number(s.overlapY) || 0)) : 0;
                const effW = Math.max(1, dispW - ovx);
                const effH = Math.max(1, dispH - ovy);
                const tx = Math.max(1, Number(targetW) || 1);
                const ty = Math.max(1, Number(targetH) || 1);
                // When multiple projectors, first tile uses full width, subsequent add effW
                // Solve n such that n*dispW - (n-1)*ovx >= tx -> n >= (tx - ovx) / (dispW - ovx)
                const nx = Math.max(1, Math.ceil((tx - ovx) / effW));
                const ny = Math.max(1, Math.ceil((ty - ovy) / effH));
                s.displaysX = nx;
                s.displaysY = ny;
                const dx = document.getElementById('ptp-displays-x'); if (dx) dx.value = String(nx);
                const dy = document.getElementById('ptp-displays-y'); if (dy) dy.value = String(ny);
                return { nx, ny };
            };
            // Screen tab: convert physical size to pixels, then compute counts
            const toMeters = (val, unit) => {
                const v = Math.max(0, Number(val) || 0);
                if (unit === 'ft') return v * 0.3048;
                if (unit === 'mm') return v / 1000;
                return v; // meters
            };
            // Screen inputs removed: no recalcFromScreen needed
            const bind = (id, prop, type = 'value') => {
                const el = document.getElementById(id);
                if (!el) return;
                if (el.type === 'checkbox') {
                    el.addEventListener('change', e => { s[prop] = el.checked; if (prop === 'circular') syncDomeVisibility(); drawBothPreviews(); });
                } else if (el.type === 'file') {
                    el.addEventListener('change', e => { s[prop] = el.files[0] || null; });
                } else {
                    el.addEventListener('input', e => {
                        const isNumeric = el.type === 'number' || el.type === 'range';
                        s[prop] = isNumeric ? Number(el.value) : el.value;
                        drawBothPreviews();
                    });
                }
            };
            bind('ptp-image-name', 'imageName');
            bind('ptp-display-width', 'displayWidth');
            bind('ptp-display-height', 'displayHeight');
            // Also sync flat calculator on native display width/height edits
            const dispWEl = document.getElementById('ptp-display-width');
            const dispHEl = document.getElementById('ptp-display-height');
            if (dispWEl) dispWEl.addEventListener('input', () => { syncFlatProjResFromNative(); try { if (typeof drawFlatCalc === 'function') drawFlatCalc(); } catch(_) {} });
            if (dispHEl) dispHEl.addEventListener('input', () => { syncFlatProjResFromNative(); try { if (typeof drawFlatCalc === 'function') drawFlatCalc(); } catch(_) {} });
            bind('ptp-displays-x', 'displaysX');
            bind('ptp-displays-y', 'displaysY');
            // Overlap inputs — twin px/% kept in sync
            const ovxPxEl = document.getElementById('ptp-overlap-x-px');
            const ovyPxEl = document.getElementById('ptp-overlap-y-px');
            const ovxPctEl = document.getElementById('ptp-overlap-x-pct');
            const ovyPctEl = document.getElementById('ptp-overlap-y-pct');
            const onPxChange = () => {
                const dispW = Math.max(1, Number(s.displayWidth) || 1);
                const dispH = Math.max(1, Number(s.displayHeight) || 1);
                s.overlapX = Math.max(0, Math.min(dispW - 1, Number(ovxPxEl?.value) || 0));
                s.overlapY = Math.max(0, Math.min(dispH - 1, Number(ovyPxEl?.value) || 0));
                s.overlapXPercent = Math.max(0, Math.round(s.overlapX / dispW * 100));
                s.overlapYPercent = Math.max(0, Math.round(s.overlapY / dispH * 100));
                if (ovxPctEl) ovxPctEl.value = String(s.overlapXPercent);
                if (ovyPctEl) ovyPctEl.value = String(s.overlapYPercent);
                recalcAndSyncTotals();
            };
            const onPctChange = () => {
                const dispW = Math.max(1, Number(s.displayWidth) || 1);
                const dispH = Math.max(1, Number(s.displayHeight) || 1);
                s.overlapXPercent = Math.max(0, Math.min(100, Number(ovxPctEl?.value) || 0));
                s.overlapYPercent = Math.max(0, Math.min(100, Number(ovyPctEl?.value) || 0));
                s.overlapX = Math.max(0, Math.min(dispW - 1, Math.round(dispW * s.overlapXPercent / 100)));
                s.overlapY = Math.max(0, Math.min(dispH - 1, Math.round(dispH * s.overlapYPercent / 100)));
                if (ovxPxEl) ovxPxEl.value = String(s.overlapX);
                if (ovyPxEl) ovyPxEl.value = String(s.overlapY);
                recalcAndSyncTotals();
            };
            if (ovxPxEl) ovxPxEl.addEventListener('input', onPxChange);
            if (ovyPxEl) ovyPxEl.addEventListener('input', onPxChange);
            if (ovxPctEl) ovxPctEl.addEventListener('input', onPctChange);
            if (ovyPctEl) ovyPctEl.addEventListener('input', onPctChange);
            bind('ptp-total-width', 'totalWidth');
            bind('ptp-total-height', 'totalHeight');
            bind('ptp-overlap', 'overlap');
            bind('ptp-logo', 'logo');
            bind('ptp-circular', 'circular');
            bind('ptp-gridsize', 'gridSize');
            bind('ptp-widthpxn', 'widthPxN');
            bind('ptp-gridcolor', 'gridColor');
            bind('ptp-textcolor', 'textColor');
            bind('ptp-overlapcolor', 'overlapColor');
            bind('ptp-circles', 'circles');
            bind('ptp-hatching', 'hatching');
            bind('ptp-numbers', 'numbers');
            bind('ptp-logo-file', 'logoFile');
            bind('ptp-logo-size', 'logoSize');
            bind('ptp-name-fontsize', 'nameFontSize');
            // Visual styles removed from Projector tab
            // Dome controls
            const domeLockEl = document.getElementById('ptp-dome-lock');
            if (domeLockEl) {
                domeLockEl.addEventListener('change', () => {
                    s.domeDiameterLock = !!domeLockEl.checked;
                    if (s.domeDiameterLock) {
                        // Snap to current totals and update displayed value
                        const tw0 = Math.max(1, Number(s.totalWidth) || 1);
                        const th0 = Math.max(1, Number(s.totalHeight) || 1);
                        s.domeDiameterPx = Math.min(tw0, th0);
                        const ppm = Math.max(1, Number(s.domePixelsPerMeter) || 1);
                        const meters = s.domeDiameterPx / ppm;
                        s.domeDiameterValue = metersToUnit(meters, s.domeDiameterUnit || 'm');
                        const valEl = document.getElementById('ptp-dome-dia-value');
                        if (valEl) valEl.value = fmtDomeVal(s.domeDiameterValue, s.domeDiameterUnit || 'm');
                    }
                    drawBothPreviews();
                });
            }
            const domeDiaValueEl = document.getElementById('ptp-dome-dia-value');
            const domeDiaUnitEl = document.getElementById('ptp-dome-dia-unit');
            const domePPMEl = document.getElementById('ptp-dome-ppm');
            if (domeDiaValueEl) {
                domeDiaValueEl.addEventListener('input', () => {
                    const unit = (domeDiaUnitEl && domeDiaUnitEl.value === 'ft') ? 'ft' : 'm';
                    const raw = Number(domeDiaValueEl.value);
                    const val = Math.max(0.001, Number.isFinite(raw) ? raw : 0);
                    s.domeDiameterValue = val;
                    const meters = unitToMeters(val, unit);
                    const ppm = Math.max(1, Number(s.domePixelsPerMeter) || 1);
                    s.domeDiameterPx = Math.round(meters * ppm);
                    // Auto-unlock on manual change
                    s.domeDiameterLock = false;
                    if (domeLockEl) domeLockEl.checked = false;
                    drawBothPreviews();
                });
            }
            if (domeDiaUnitEl) {
                domeDiaUnitEl.addEventListener('change', () => {
                    s.domeDiameterUnit = (domeDiaUnitEl.value === 'ft') ? 'ft' : 'm';
                    // Keep physical size constant: recompute displayed value from px & ppm
                    const ppm = Math.max(1, Number(s.domePixelsPerMeter) || 1);
                    const meters = Math.max(0, Number(s.domeDiameterPx) || 0) / ppm;
                    s.domeDiameterValue = metersToUnit(meters, s.domeDiameterUnit);
                    if (domeDiaValueEl) domeDiaValueEl.value = fmtDomeVal(s.domeDiameterValue, s.domeDiameterUnit);
                    drawBothPreviews();
                });
            }
            if (domePPMEl) {
                domePPMEl.addEventListener('input', () => {
                    const ppm = Math.max(1, Number(domePPMEl.value) || 1);
                    s.domePixelsPerMeter = ppm;
                    if (s.domeDiameterLock) {
                        // px tied to totals; update displayed physical value
                        const meters = Math.max(0, Number(s.domeDiameterPx) || 0) / ppm;
                        s.domeDiameterValue = metersToUnit(meters, s.domeDiameterUnit || 'm');
                        if (domeDiaValueEl) domeDiaValueEl.value = fmtDomeVal(s.domeDiameterValue, s.domeDiameterUnit || 'm');
                    } else {
                        // keep physical value constant; update px
                        const meters = unitToMeters(Math.max(0.001, Number(s.domeDiameterValue) || 0), s.domeDiameterUnit || 'm');
                        s.domeDiameterPx = Math.round(meters * ppm);
                    }
                    drawBothPreviews();
                });
            }
            // Name offsets bindings with label updates
            const offx = document.getElementById('ptp-name-offx');
            const offy = document.getElementById('ptp-name-offy');
            const offxLbl = document.getElementById('ptp-name-offx-label');
            const offyLbl = document.getElementById('ptp-name-offy-label');
            if (offx) {
                offx.addEventListener('input', () => {
                    s.nameOffsetXPercent = Number(offx.value) || 0;
                    if (offxLbl) offxLbl.textContent = String(s.nameOffsetXPercent);
                    drawBothPreviews();
                });
            }
            if (offy) {
                offy.addEventListener('input', () => {
                    s.nameOffsetYPercent = Number(offy.value) || 0;
                    if (offyLbl) offyLbl.textContent = String(s.nameOffsetYPercent);
                    drawBothPreviews();
                });
            }

            // No unit selector; twins are kept in sync both ways

            // Overlay opacity slider
            const overlayOpacity = document.getElementById('ptp-overlay-opacity');
            const overlayOpacityLabel = document.getElementById('ptp-overlay-opacity-label');
            if (overlayOpacity) {
                overlayOpacity.addEventListener('input', e => {
                    const v = Math.max(0, Math.min(100, Number(overlayOpacity.value) || 0));
                    s.overlayOpacity = v;
                    if (overlayOpacityLabel) overlayOpacityLabel.textContent = String(v);
                    drawBothPreviews();
                });
            }

            // Hatching controls
            const hatchStyle = document.getElementById('ptp-hatching-style');
            if (hatchStyle) {
                hatchStyle.addEventListener('change', () => {
                    const val = hatchStyle.value;
                    s.hatchingStyle = (val === 'forward' || val === 'backward' || val === 'cross') ? val : 'cross';
                    drawBothPreviews();
                });
            }
            const hatchDensity = document.getElementById('ptp-hatching-density');
            const hatchDensityLabel = document.getElementById('ptp-hatching-density-label');
            if (hatchDensity) {
                hatchDensity.addEventListener('input', () => {
                    const v = Math.max(1, Math.min(10, Number(hatchDensity.value) || 1));
                    s.hatchingDensity = v;
                    if (hatchDensityLabel) hatchDensityLabel.textContent = String(v);
                    drawBothPreviews();
                });
            }

            // Enable/disable hatching sub-controls when toggled
            const hatchToggle = document.getElementById('ptp-hatching');
            const hatchControls = document.getElementById('ptp-hatching-controls');
            if (hatchToggle && hatchControls) {
                const syncHatchControls = () => {
                    if (hatchToggle.checked) {
                        hatchControls.classList.remove('opacity-50','pointer-events-none');
                    } else {
                        hatchControls.classList.add('opacity-50','pointer-events-none');
                    }
                };
                hatchToggle.addEventListener('change', syncHatchControls);
                syncHatchControls();
            }

            // Logo file loader
            const logoFileInput = document.getElementById('ptp-logo-file');
            if (logoFileInput) {
                logoFileInput.addEventListener('change', () => {
                    const file = logoFileInput.files && logoFileInput.files[0];
                    if (!file) { s._logoImg = null; drawBothPreviews(); return; }
                    const reader = new FileReader();
                    reader.onload = () => {
                        const img = new Image();
                        img.onload = () => { s._logoImg = img; drawBothPreviews(); };
                        img.src = String(reader.result);
                    };
                    reader.readAsDataURL(file);
                });
            }

            // Auto-recalc totals when overlap, display size, or display count changes
            ['ptp-display-width','ptp-display-height','ptp-displays-x','ptp-displays-y','ptp-overlap-x','ptp-overlap-y','ptp-overlap'].forEach(id => {
                const el = document.getElementById(id);
                if (!el) return;
                const evt = el.type === 'checkbox' ? 'change' : 'input';
                el.addEventListener(evt, () => {
                    const before = Array.isArray(s.projectors) ? s.projectors.length : 0;
                    recalcAndSyncTotals();
                    const changed = ensureProjectors();
                    const nx = Math.max(1, Number(s.displaysX) || 1);
                    const ny = Math.max(1, Number(s.displaysY) || 1);
                    const needed = nx * ny;
                    if (changed || before !== needed) {
                        renderProjectorTestPattern();
                    }
                });
            });

            // Native resolution dropdown behavior
            const nativeSel = document.getElementById('ptp-native-res');
            if (nativeSel) {
                nativeSel.addEventListener('change', () => {
                    const val = nativeSel.value;
                    // Toggle visibility of custom resolution controls under Native Resolution
                    const customCtrls = document.getElementById('ptp-custom-res-controls');
                    if (customCtrls) customCtrls.classList.toggle('hidden', val !== '__custom__');
                    if (val === '__custom__') { recalcAndSyncTotals(); return; }
                    const [wStr, hStr] = val.split('x');
                    const w = Number(wStr);
                    const h = Number(hStr);
                    if (w > 0 && h > 0) {
                        s.displayWidth = w;
                        s.displayHeight = h;
                        const dw = document.getElementById('ptp-display-width');
                        const dh = document.getElementById('ptp-display-height');
                        if (dw) dw.value = String(w);
                        if (dh) dh.value = String(h);
                        recalcAndSyncTotals();
                        // Also sync Flat Calculator projector resolution and recalc
                        syncFlatProjResFromNative();
                        // Recompute Flat Calculator layout if available
                        try { if (typeof drawFlatCalc === 'function') drawFlatCalc(); } catch(_) {}
                    }
                });
            }

            const flatNativeSel = document.getElementById('fc-native-res');
            if (flatNativeSel) {
                flatNativeSel.addEventListener('change', () => {
                    const val = flatNativeSel.value;
                    const customCtrls = document.getElementById('fc-custom-res-controls');
                    if (customCtrls) customCtrls.classList.toggle('hidden', val !== '__custom__');
                    if (val === '__custom__') { drawFlatCalc(); return; }
                    const [wStr, hStr] = val.split('x');
                    const w = Number(wStr);
                    const h = Number(hStr);
                    if (w > 0 && h > 0) {
                        s.calcFlat.projectorWidthPx = w;
                        s.calcFlat.projectorHeightPx = h;
                        const wEl = document.getElementById('fc-pxw');
                        const hEl = document.getElementById('fc-pxh');
                        if (wEl) wEl.value = String(w);
                        if (hEl) hEl.value = String(h);
                        drawFlatCalc();
                    }
                });
            }

            // Add custom resolution
            const addBtn = document.getElementById('ptp-add-custom-res');
            if (addBtn) {
                addBtn.addEventListener('click', () => {
                    const cw = Number((document.getElementById('ptp-custom-w') || {}).value);
                    const ch = Number((document.getElementById('ptp-custom-h') || {}).value);
                    if (!cw || !ch) return;
                    s.customResList = Array.isArray(s.customResList) ? s.customResList : [];
                    const exists = s.customResList.some(r => r.w === cw && r.h === ch);
                    if (!exists) s.customResList.push({ w: cw, h: ch });
                    try { localStorage.setItem('ptp-custom-resolutions', JSON.stringify(s.customResList)); } catch(_) {}
                    // Set as active selection and re-render to refresh dropdown
                    s.displayWidth = cw;
                    s.displayHeight = ch;
                    // Keep Flat Calculator in sync with this new native resolution
                    s.calcFlat.projectorWidthPx = cw;
                    s.calcFlat.projectorHeightPx = ch;
                    renderProjectorTestPattern();
                });
            }
            const addFlatBtn = document.getElementById('fc-add-custom-res');
            if (addFlatBtn) {
                addFlatBtn.addEventListener('click', () => {
                    const cw = Number((document.getElementById('fc-custom-w') || {}).value);
                    const ch = Number((document.getElementById('fc-custom-h') || {}).value);
                    if (!cw || !ch) return;
                    s.customResList = Array.isArray(s.customResList) ? s.customResList : [];
                    const exists = s.customResList.some(r => r.w === cw && r.h === ch);
                    if (!exists) s.customResList.push({ w: cw, h: ch });
                    try { localStorage.setItem('ptp-custom-resolutions', JSON.stringify(s.customResList)); } catch(_) {}
                    s.calcFlat.projectorWidthPx = cw;
                    s.calcFlat.projectorHeightPx = ch;
                    const wEl = document.getElementById('fc-pxw');
                    const hEl = document.getElementById('fc-pxh');
                    if (wEl) wEl.value = String(cw);
                    if (hEl) hEl.value = String(ch);
                    renderProjectorTestPattern();
                });
            }
            // Initial draw
            drawBothPreviews();
            syncDomeVisibility();
            setPreviewZoom(s.previewZoom || 1);
            if (s.uiSubTab === 'calc-curve') { try { drawCurveCalc(); } catch(_) {} }

            // --- Bind Flat Calculator inputs ---
            try {
                const bindFlat = (id, onInput) => { const el = document.getElementById(id); if (el) el.addEventListener('input', onInput); };
                const syncFlatLabels = () => {
                    const modeEl = document.getElementById('fc-mode');
                    const lowLbl = document.getElementById('fc-throw-low-label');
                    const hiWrap = document.getElementById('fc-throw-high-wrap');
                    const throwLbl = document.getElementById('fc-throw-label');
                    const mode = modeEl ? modeEl.value : 'distanceToRatio';
                    const isSuggest = mode === 'suggestLens';
                    const throwLowEl = document.getElementById('fc-throw-low');
                    const throwLowWrap = throwLowEl ? throwLowEl.parentElement : null;
                    if (throwLowWrap) throwLowWrap.classList.toggle('hidden', isSuggest);
                    if (lowLbl) lowLbl.textContent = mode==='ratioToDistance' ? 'Lens Throw Ratio (Low)' : 'Throw Distance (m)';
                    if (hiWrap) hiWrap.classList.toggle('hidden', isSuggest || mode!=='ratioToDistance');
                    if (throwLbl) throwLbl.textContent = isSuggest ? 'Lens Advisor' : (mode==='ratioToDistance' ? 'Calculated Throw Distance' : 'Calculated Throw Ratio');
                };
                bindFlat('fc-mode', () => { s.calcFlat.calcMode = String(document.getElementById('fc-mode')?.value || 'distanceToRatio'); syncFlatLabels(); drawFlatCalc(); });
                bindFlat('fc-screen-w', () => { s.calcFlat.screenWidthMeters = Number(document.getElementById('fc-screen-w')?.value)||0; drawFlatCalc(); });
                bindFlat('fc-screen-h', () => { s.calcFlat.screenHeightMeters = Number(document.getElementById('fc-screen-h')?.value)||0; drawFlatCalc(); });
                bindFlat('fc-throw-low', () => { s.calcFlat.throwLow = Number(document.getElementById('fc-throw-low')?.value)||0; drawFlatCalc(); });
                bindFlat('fc-throw-high', () => { s.calcFlat.throwHigh = Number(document.getElementById('fc-throw-high')?.value)||0; drawFlatCalc(); });
                bindFlat('fc-nh', () => { s.calcFlat.numProjectorsHorizontal = Math.max(1, Number(document.getElementById('fc-nh')?.value)||1); drawFlatCalc(); });
                bindFlat('fc-nv', () => { s.calcFlat.numProjectorsVertical = Math.max(1, Number(document.getElementById('fc-nv')?.value)||1); drawFlatCalc(); });
                bindFlat('fc-ovh', () => {
                    const val = Math.max(0, Math.min(90, Number(document.getElementById('fc-ovh')?.value)||0));
                    const numEl = document.getElementById('fc-ovh-num');
                    const lbl = document.getElementById('fc-ovh-val');
                    if (numEl) numEl.value = String(val);
                    if (lbl) lbl.textContent = val.toFixed(1);
                    s.calcFlat.overlapPercentHorizontal = val;
                    drawFlatCalc();
                });
                bindFlat('fc-ovv', () => {
                    const val = Math.max(0, Math.min(90, Number(document.getElementById('fc-ovv')?.value)||0));
                    const numEl = document.getElementById('fc-ovv-num');
                    const lbl = document.getElementById('fc-ovv-val');
                    if (numEl) numEl.value = String(val);
                    if (lbl) lbl.textContent = val.toFixed(1);
                    s.calcFlat.overlapPercentVertical = val;
                    drawFlatCalc();
                });
                bindFlat('fc-ovh-num', () => {
                    const val = Math.max(0, Math.min(90, Number(document.getElementById('fc-ovh-num')?.value)||0));
                    const slider = document.getElementById('fc-ovh');
                    const lbl = document.getElementById('fc-ovh-val');
                    if (slider) slider.value = String(val);
                    if (lbl) lbl.textContent = val.toFixed(1);
                    s.calcFlat.overlapPercentHorizontal = val;
                    drawFlatCalc();
                });
                bindFlat('fc-ovv-num', () => {
                    const val = Math.max(0, Math.min(90, Number(document.getElementById('fc-ovv-num')?.value)||0));
                    const slider = document.getElementById('fc-ovv');
                    const lbl = document.getElementById('fc-ovv-val');
                    if (slider) slider.value = String(val);
                    if (lbl) lbl.textContent = val.toFixed(1);
                    s.calcFlat.overlapPercentVertical = val;
                    drawFlatCalc();
                });
                bindFlat('fc-pxw', () => { s.calcFlat.projectorWidthPx = Math.max(1, Number(document.getElementById('fc-pxw')?.value)||1); drawFlatCalc(); });
                bindFlat('fc-pxh', () => { s.calcFlat.projectorHeightPx = Math.max(1, Number(document.getElementById('fc-pxh')?.value)||1); drawFlatCalc(); });
                bindFlat('fc-auto', () => { s.calcFlat.autoCalc = !!document.getElementById('fc-auto')?.checked; drawFlatCalc(); });
                const pdfBtn = document.getElementById('fc-generate-pdf');
                const pdfStatus = document.getElementById('fc-pdf-status');
                const generateFlatCalcPdf = async () => {
                    try {
                        if (!window.jspdf || !window.jspdf.jsPDF) {
                            if (pdfStatus) pdfStatus.textContent = 'PDF library not available';
                            return;
                        }
                        if (typeof window.html2canvas !== 'function') {
                            if (pdfStatus) pdfStatus.textContent = 'Capture library not available';
                            return;
                        }
                        const jsPDF = window.jspdf.jsPDF;
                        const doc = new jsPDF({ orientation: 'landscape', unit: 'pt', format: 'a4' });
                        const summary = (s.calcFlat && s.calcFlat.lastSummary) ? s.calcFlat.lastSummary : {};

                        const pageW = doc.internal.pageSize.getWidth();
                        const pageH = doc.internal.pageSize.getHeight();
                        doc.setFont('helvetica', 'bold');
                        doc.setFontSize(18);
                        doc.text('Flat Screen Calculation', 40, 40);
                        doc.setFontSize(11);
                        doc.setFont('helvetica', 'normal');

                        const rows = [
                            ['Screen Size', summary.screen || '-'],
                            ['Projector Resolution', summary.projectorRes || '-'],
                            ['Grid Setup', summary.grid || '-'],
                            ['Single Image Size', summary.singleImage || '-'],
                            ['Overlap (H)', summary.overlapH || '-'],
                            ['Overlap (V)', summary.overlapV || '-'],
                            ['Canvas Resolution', summary.canvas || '-'],
                            ['Projector Spacing', summary.spacing || '-'],
                        ];
                        let y = 70;
                        rows.forEach(([label, val]) => {
                            doc.setTextColor(120);
                            doc.text(String(label), 40, y);
                            doc.setTextColor(10);
                            doc.text(String(val), 220, y);
                            y += 18;
                        });

                        // Capture Flat Screen Calculator panel as-is
                        const flatPanel = document.getElementById('ptp-panel-calc-flat');
                        if (flatPanel) {
                            try {
                                const panelCanvas = await window.html2canvas(flatPanel, {
                                    backgroundColor: '#0b1020',
                                    scale: 2,
                                    useCORS: true
                                });
                                const panelImg = panelCanvas.toDataURL('image/png');
                                const panelMaxW = pageW - 80;
                                const panelMaxH = Math.max(200, pageH - y - 40);
                                const panelRatio = panelCanvas.width / panelCanvas.height;
                                let panelW = panelMaxW;
                                let panelH = panelW / panelRatio;
                                if (panelH > panelMaxH) { panelH = panelMaxH; panelW = panelH * panelRatio; }
                                doc.setDrawColor(180);
                                doc.rect(40 - 6, y - 6, panelW + 12, panelH + 12);
                                doc.addImage(panelImg, 'PNG', 40, y, panelW, panelH);
                            } catch (panelErr) {
                                console.warn('Flat panel capture failed', panelErr);
                            }
                        }

                        // Render full-resolution test pattern for PDF
                        const ptp = window.projectorTestPatternState || {};
                        const buildTestPatternImage = () => {
                            try {
                                const srcW = Math.max(1, Number(ptp.totalWidth) || 1);
                                const srcH = Math.max(1, Number(ptp.totalHeight) || 1);
                                const maxW = 2000;
                                const scale = Math.min(1, maxW / srcW);
                                const w = Math.max(1, Math.round(srcW * scale));
                                const h = Math.max(1, Math.round(srcH * scale));
                                const off = document.createElement('canvas');
                                off.width = w;
                                off.height = h;
                                const ctx = off.getContext('2d');
                                if (ctx && scale !== 1) ctx.scale(scale, scale);
                                drawProjectorTestPattern(off, ptp, false);
                                return off.toDataURL('image/png');
                            } catch (_) { return null; }
                        };
                        try {
                            const patternImg = buildTestPatternImage();
                            if (patternImg) {
                                doc.addPage('a4', 'landscape');
                                doc.setFont('helvetica', 'bold');
                                doc.setFontSize(16);
                                doc.text('Projector Test Pattern', 40, 40);
                                const imgX = 40;
                                const imgY = 70;
                                const maxW = 760;
                                const maxH = 480;
                                const props = doc.getImageProperties(patternImg);
                                const ratio = props.width && props.height ? (props.width / props.height) : (maxW / maxH);
                                let imgW = maxW;
                                let imgH = imgW / ratio;
                                if (imgH > maxH) { imgH = maxH; imgW = imgH * ratio; }
                                doc.setDrawColor(180);
                                doc.rect(imgX - 6, imgY - 6, imgW + 12, imgH + 12);
                                doc.addImage(patternImg, 'PNG', imgX, imgY, imgW, imgH);
                            }
                        } catch (patternErr) {
                            console.warn('Pattern render failed', patternErr);
                        }

                        applyDemoWatermarkToPDF(doc);
                        doc.save(`projector_testpattern_${Date.now()}.pdf`);
                        if (pdfStatus) pdfStatus.textContent = 'PDF saved';
                        setTimeout(() => { if (pdfStatus) pdfStatus.textContent = ''; }, 2000);
                    } catch (err) {
                        console.warn('Flat calc PDF failed', err);
                        if (pdfStatus) pdfStatus.textContent = err && err.message ? `PDF failed: ${err.message}` : 'PDF failed';
                    }
                };
                if (pdfBtn) pdfBtn.addEventListener('click', generateFlatCalcPdf);

                // On first reveal, draw once
                if (s.uiSubTab === 'calc-flat') { syncFlatLabels(); drawFlatCalc(); }
            } catch(_) {}

            // --- Bind Circular Calculator inputs ---
            try {
                const bindCirc = (id, onInput) => { const el = document.getElementById(id); if (el) el.addEventListener('input', onInput); };
                const syncCircLabels = () => {
                    const modeEl = document.getElementById('cc-mode');
                    const lowLbl = document.getElementById('cc-throw-low-label');
                    const hiWrap = document.getElementById('cc-throw-high-wrap');
                    const throwLbl = document.getElementById('cc-throw-label');
                    const angleWrap = document.getElementById('cc-angle-wrap');
                    const shapeEl = document.getElementById('cc-shape');
                    const mode = modeEl ? modeEl.value : 'distanceToRatio';
                    if (lowLbl) lowLbl.textContent = mode==='ratioToDistance' ? 'Lens Throw Ratio (Low)' : 'Throw Distance (m)';
                    if (hiWrap) hiWrap.classList.toggle('hidden', mode!=='ratioToDistance');
                    if (throwLbl) throwLbl.textContent = mode==='ratioToDistance' ? 'Calculated Throw Distance' : 'Calculated Throw Ratio';
                    if (angleWrap) angleWrap.classList.toggle('hidden', (shapeEl ? shapeEl.value : 'circle') !== 'custom');
                };
                bindCirc('cc-mode', () => { s.calcCirc.calcMode = String(document.getElementById('cc-mode')?.value || 'distanceToRatio'); syncCircLabels(); drawCircCalc(); });
                bindCirc('cc-shape', () => { s.calcCirc.shape = String(document.getElementById('cc-shape')?.value || 'circle'); syncCircLabels(); drawCircCalc(); });
                bindCirc('cc-d', () => { s.calcCirc.diameter = Number(document.getElementById('cc-d')?.value)||0; drawCircCalc(); });
                bindCirc('cc-angle', () => { s.calcCirc.arcAngleDeg = Math.max(1, Math.min(360, Number(document.getElementById('cc-angle')?.value)||0)); drawCircCalc(); });
                bindCirc('cc-side', () => { s.calcCirc.projectionSide = String(document.getElementById('cc-side')?.value || 'outside'); drawCircCalc(); });
                bindCirc('cc-safe-angle', () => { s.calcCirc.safeAngleDeg = Math.max(30, Math.min(110, Number(document.getElementById('cc-safe-angle')?.value)||90)); drawCircCalc(); });
                bindCirc('cc-throw-low', () => { s.calcCirc.throwLow = Number(document.getElementById('cc-throw-low')?.value)||0; drawCircCalc(); });
                bindCirc('cc-throw-high', () => { s.calcCirc.throwHigh = Number(document.getElementById('cc-throw-high')?.value)||0; drawCircCalc(); });
                bindCirc('cc-nh', () => { s.calcCirc.numProjectorsHorizontal = Math.max(1, Number(document.getElementById('cc-nh')?.value)||1); drawCircCalc(); });
                bindCirc('cc-nv', () => { s.calcCirc.numProjectorsVertical = Math.max(1, Number(document.getElementById('cc-nv')?.value)||1); drawCircCalc(); });
                bindCirc('cc-ovh', () => { s.calcCirc.overlapPercentHorizontal = Math.max(0, Math.min(90, Number(document.getElementById('cc-ovh')?.value)||0)); drawCircCalc(); });
                bindCirc('cc-ovv', () => { s.calcCirc.overlapPercentVertical = Math.max(0, Math.min(90, Number(document.getElementById('cc-ovv')?.value)||0)); drawCircCalc(); });
                bindCirc('cc-pxw', () => { s.calcCirc.projectorWidthPx = Math.max(1, Number(document.getElementById('cc-pxw')?.value)||1); drawCircCalc(); });
                bindCirc('cc-pxh', () => { s.calcCirc.projectorHeightPx = Math.max(1, Number(document.getElementById('cc-pxh')?.value)||1); drawCircCalc(); });
                bindCirc('cc-sh',  () => { s.calcCirc.screenHeight = Math.max(0, Number(document.getElementById('cc-sh')?.value)||0); drawCircCalc(); });
                // checkbox needs 'change' event
                const ccAutoVEl = document.getElementById('cc-auto-v');
                if (ccAutoVEl) ccAutoVEl.addEventListener('change', () => { s.calcCirc.autoCalcV = ccAutoVEl.checked; drawCircCalc(); });
                if (s.uiSubTab === 'calc-circ') { syncCircLabels(); drawCircCalc(); }
            } catch(_) {}

            // --- Bind Curved Screen Calculator inputs ---
            try {
                const bc = (id, fn) => { const el = document.getElementById(id); if (el) el.addEventListener('input', fn); };
                const redrawCv = () => drawCurveCalc();
                const saveCv = (key, cast) => () => { s.calcCurve[key] = cast(document.getElementById(key.replace(/([A-Z])/g,'-$1').toLowerCase())?.value); redrawCv(); };
                bc('cv-type',      () => { s.calcCurve.curveType        = document.getElementById('cv-type')?.value || 'concave'; redrawCv(); });
                bc('cv-screen-w',  () => { s.calcCurve.screenWidthMeters  = Number(document.getElementById('cv-screen-w')?.value)||0; redrawCv(); });
                bc('cv-screen-h',  () => { s.calcCurve.screenHeightMeters = Number(document.getElementById('cv-screen-h')?.value)||0; redrawCv(); });
                bc('cv-depth',     () => { s.calcCurve.curveDepthMeters   = Number(document.getElementById('cv-depth')?.value)||0; redrawCv(); });
                bc('cv-pxw',       () => { s.calcCurve.projectorWidthPx   = Number(document.getElementById('cv-pxw')?.value)||1920; redrawCv(); });
                bc('cv-pxh',       () => { s.calcCurve.projectorHeightPx  = Number(document.getElementById('cv-pxh')?.value)||1080; redrawCv(); });
                bc('cv-nh',        () => { s.calcCurve.numProjectors       = Number(document.getElementById('cv-nh')?.value)||1; redrawCv(); });
                bc('cv-ovp',       () => { s.calcCurve.overlapPercent      = Number(document.getElementById('cv-ovp')?.value)||0; redrawCv(); });
                bc('cv-nv',        () => { s.calcCurve.numProjectorsV      = Math.max(1, Number(document.getElementById('cv-nv')?.value)||1); redrawCv(); });
                bc('cv-ovv',       () => { s.calcCurve.overlapPercentV     = Number(document.getElementById('cv-ovv')?.value)||0; redrawCv(); });
                bc('cv-safe-angle',() => { s.calcCurve.safeAngleDeg        = Math.max(10, Number(document.getElementById('cv-safe-angle')?.value)||40); redrawCv(); });
                // checkbox needs 'change' event
                const cvAutoEl = document.getElementById('cv-auto');
                if (cvAutoEl) cvAutoEl.addEventListener('change', () => { s.calcCurve.autoCalc = cvAutoEl.checked; redrawCv(); });
                bc('cv-mode',      () => { s.calcCurve.calcMode            = document.getElementById('cv-mode')?.value || 'ratioToDistance'; redrawCv(); });
                bc('cv-throw-low', () => { s.calcCurve.throwLow            = Number(document.getElementById('cv-throw-low')?.value)||0; redrawCv(); });
                bc('cv-throw-high',() => { s.calcCurve.throwHigh           = Number(document.getElementById('cv-throw-high')?.value)||0; redrawCv(); });
                if (s.uiSubTab === 'calc-curve') { drawCurveCalc(); }
            } catch(_) {}

            // Screen size tab/section removed; no bindings needed

            // Make projector tiles selectable via preview click
            if (canvas && !canvas.dataset.ptpClickBound) {
                canvas.dataset.ptpClickBound = '1';
                canvas.addEventListener('click', (ev) => {
                    try {
                        const totalW = Math.max(1, Number(s.totalWidth) || 1);
                        const totalH = Math.max(1, Number(s.totalHeight) || 1);
                        const prevW = canvas.width, prevH = canvas.height;
                        const scale = Math.min(prevW / totalW, prevH / totalH);
                        const targetW = totalW * scale, targetH = totalH * scale;
                        const offsetX = (prevW - targetW) / 2;
                        const offsetY = (prevH - targetH) / 2;
                        const rect = canvas.getBoundingClientRect();
                        const px = (ev.clientX - rect.left) * (canvas.width / rect.width);
                        const py = (ev.clientY - rect.top) * (canvas.height / rect.height);
                        const lx = (px - offsetX) / scale;
                        const ly = (py - offsetY) / scale;
                        if (lx < 0 || ly < 0 || lx > totalW || ly > totalH) return;
                        const dispW = Math.max(1, Number(s.displayWidth) || 1);
                        const dispH = Math.max(1, Number(s.displayHeight) || 1);
                        const ovx = s.overlap ? Math.max(0, Number(s.overlapX) || 0) : 0;
                        const ovy = s.overlap ? Math.max(0, Number(s.overlapY) || 0) : 0;
                        const nx = Math.max(1, Number(s.displaysX) || 1);
                        const ny = Math.max(1, Number(s.displaysY) || 1);
                        let bestIdx = -1; let bestD = Infinity;
                        for (let y = 0; y < ny; y++) {
                            for (let x = 0; x < nx; x++) {
                                const posX = x * (dispW - ovx);
                                const posY = y * (dispH - ovy);
                                if (lx >= posX && lx <= posX + dispW && ly >= posY && ly <= posY + dispH) {
                                    const cx = posX + dispW / 2, cy = posY + dispH / 2;
                                    const d = (lx - cx) * (lx - cx) + (ly - cy) * (ly - cy);
                                    const idx = y * nx + x;
                                    if (d < bestD) { bestD = d; bestIdx = idx; }
                                }
                            }
                        }
                        if (bestIdx >= 0) {
                            // remove previous highlight
                            if (s.selectedProjectorIndex >= 0) {
                                const prevRow = document.getElementById(`ptp-proj-name-${s.selectedProjectorIndex}`)?.parentElement;
                                if (prevRow) prevRow.classList.remove('ring-2','ring-accent','rounded-md');
                            }
                            s.selectedProjectorIndex = bestIdx;
                            drawBothPreviews();
                            const row = document.getElementById(`ptp-proj-name-${bestIdx}`)?.parentElement;
                            if (row) {
                                row.classList.add('ring-2','ring-accent','rounded-md');
                                try { row.scrollIntoView({ block: 'nearest' }); } catch(_) {}
                            }
                        }
                    } catch (_) {}
                });
            }

            // Calculate UI removed; no handler needed

            // Save Image
            const saveBtn = document.getElementById('ptp-save-image');
            if (saveBtn && canvas) {
                saveBtn.addEventListener('click', async () => {
                    try {
                        const name = (s.imageName || 'testpattern').toString().trim().replace(/[^a-z0-9-_]+/gi, '_') || 'testpattern';
                        const totalW = Math.max(1, Number(s.totalWidth) || 1);
                        const totalH = Math.max(1, Number(s.totalHeight) || 1);

                        // Draw at actual resolution to an offscreen canvas
                        const off = document.createElement('canvas');
                        off.width = totalW;
                        off.height = totalH;
                        drawProjectorTestPattern(off, s, false);

                        applyDemoWatermarkToCanvas(off);
                        const link = document.createElement('a');
                        link.download = `${name}_${totalW}x${totalH}.png`;
                        link.href = off.toDataURL('image/png');
                        link.click();
                    } catch (e) {
                        console.error('Save Image failed', e);
                        // Fallback to preview canvas if something goes wrong
                        applyDemoWatermarkToCanvas(canvas);
                        const link = document.createElement('a');
                        link.download = 'testpattern.png';
                        link.href = canvas.toDataURL('image/png');
                        link.click();
                    }
                });
            }
            const toolbarSaveBtn = document.getElementById('ptp-save-png');
            if (toolbarSaveBtn && saveBtn) {
                toolbarSaveBtn.addEventListener('click', () => saveBtn.click());
            }
            const saveAllBtn = document.getElementById('ptp-save-all-pngs');
            if (saveAllBtn) {
                saveAllBtn.addEventListener('click', () => {
                    try {
                        const base = (s.imageName || 'testpattern').toString().trim().replace(/[^a-z0-9-_]+/gi, '_') || 'testpattern';
                        const downloadCanvas = (srcCanvas, suffix) => {
                            if (!srcCanvas) return;
                            applyDemoWatermarkToCanvas(srcCanvas);
                            const link = document.createElement('a');
                            link.download = `${base}_${suffix}.png`;
                            link.href = srcCanvas.toDataURL('image/png');
                            link.click();
                        };
                        if (canvas) downloadCanvas(canvas, 'main');
                        if (domeCanvas && s.circular) downloadCanvas(domeCanvas, 'dome');
                    } catch (err) {
                        console.warn('Save all PNGs failed', err);
                    }
                });
            }
            const zoomButtons = container.querySelectorAll('[data-ptp-zoom]');
            zoomButtons.forEach(btn => {
                btn.addEventListener('click', () => {
                    const mode = btn.getAttribute('data-ptp-zoom');
                    if (mode === 'in') setPreviewZoom((s.previewZoom || 1) + 0.1);
                    else if (mode === 'out') setPreviewZoom((s.previewZoom || 1) - 0.1);
                    else if (mode === 'fit') fitPreviewZoom();
                    else setPreviewZoom(1);
                });
            });
            // Bind dynamic projector fields
            if (Array.isArray(s.projectors)) {
                s.projectors.forEach((p, i) => {
                    const n = document.getElementById(`ptp-proj-name-${i}`);
                    const c = document.getElementById(`ptp-proj-color-${i}`);
                    if (n) n.addEventListener('input', () => { s.projectors[i].name = n.value; drawBothPreviews(); });
                    if (c) c.addEventListener('input', () => { s.projectors[i].color = c.value; drawBothPreviews(); });
                });
            }
        }
        // Tab switch logic (add this tab to the switchTab function if not already present)
        const origSwitchTab = window.switchTab;
        window.switchTab = function(tab) {
            if (tab === 'projector-test-pattern') renderProjectorTestPattern();
            if (origSwitchTab) origSwitchTab.apply(this, arguments);
        };
        </script>
            <!-- LED Patching content removed per request -->

