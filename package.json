{
  "name": "Pixelogic",
  "version": "1.0.138",
  "description": "A pixelmap calculator",
  "main": "main.js",
  "scripts": {
    "css": "tailwindcss -i ./src/styles/tailwind.css -o ./styles.css -m",
    "css:watch": "tailwindcss -i ./src/styles/tailwind.css -o ./styles.css -w",
    "postinstall": "node ./scripts/copy-vendor.js",
    "start": "npm run css && electron .",
    "build": "node ./scripts/run-build.js",
    "build:win": "node ./scripts/run-build.js --win",
    "build:mac": "node ./scripts/run-build.js --mac",
    "start:pixel": "npm --prefix apps/pixellogic run start",
    "start:projection": "npm --prefix apps/projection-logic run start",
    "build:pixel": "npm --prefix apps/pixellogic run build",
    "build:projection": "npm --prefix apps/projection-logic run build",
    "build:all": "node ./scripts/run-build-all.js",
    "build:web": "npm run css && node ./scripts/build-web.js",
    "deploy:web": "npm run build:web && node ./scripts/deploy-web-to-website.js",
    "license:keypair": "node ./scripts/generate-keypair.mjs",
    "license:gen": "node ./scripts/generate-license.mjs",
    "license:server": "node ./scripts/license-server.mjs"
  },
  "keywords": [],
  "author": "Dhiraj Kalra",
  "license": "ISC",
  "devDependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tailwindcss/browser": "^4.2.1",
    "@types/three": "^0.183.0",
    "autoprefixer": "^10.4.20",
    "electron": "^39.1.0",
    "electron-builder": "^24.9.1",
    "htm": "^3.1.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.3",
    "leva": "^0.10.1",
    "pdfjs-dist": "^5.4.394",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.14",
    "three": "^0.183.0",
    "uuid": "^13.0.0"
  },
  "dependencies": {
    "@google/genai": "^1.42.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "font-list": "^2.0.1"
  },
  "build": {
    "asar": true,
    "asarUnpack": [
      "node_modules/fluent-ffmpeg/**",
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "compression": "maximum",
    "files": [
      "**/*",
      "!apps/**",
      "!out/**",
      "!release/**",
      "!release-new/**",
      "!dist/**",
      "!demo-app/**",
      "!website/**",
      "!pixelogic-license-server/**",
      "!pixellogic-builds/**",
      "!mobile/**",
      "!web-app/**",
      "!screenshots/**",
      "!prototypes/**",
      "!tmp_restore/**",
      "!code bakcups/**",
      "!scripts/**",
      "!scripts_01/**",
      "!power report/**",
      "!.venv/**",
      "!.github/**",
      "!.vscode/**",
      "!src/styles/**",
      "!src/av-schematic/data/**",
      "!src/av-schematic/nodes/**",
      "!**/*.log",
      "!**/*.7z",
      "!**/*.zip",
      "!**/*.map",
      "!**/*.md",
      "!**/*.bak_*",
      "!**/*.canvas_bak",
      "!**/*.layout_bak",
      "!index.html.bak_mask",
      "!index.html.canvas_bak",
      "!index.html.layout_bak",
      "!styles-theme.css.layout_bak",
      "!tailwind.config.js",
      "!postcss.config.js",
      "!build-log.txt",
      "!PixelLogic_Tutorial.pdf",
      "!GUMROAD_LISTING.md",
      "!LINKEDIN_POST*.md",
      "!TABS_DOCUMENTATION.md",
      "!VIDEO_TUTORIAL*.md",
      "!link-generator.html",
      "!node_modules/ffmpeg-static/**",
      "!node_modules/ffprobe-static/**"
    ],
    "directories": {
      "output": "out/${env.BUILD_ID}"
    },
    "appId": "com.dhirajkalra.pixellogic",
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.exe",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        "portable"
      ],
      "publisherName": "Dhiraj Kalra"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "license": "install-info.txt"
    },
    "mac": {
      "identity": null,
      "icon": "build/icon.icns",
      "category": "public.app-category.graphics-design",
      "artifactName": "${productName}-${version}-${arch}.dmg",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "${productName} ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "extraMetadata": {
      "chromium-args": "--disable-software-rasterizer --enable-gpu-rasterization --enable-zero-copy --ignore-gpu-blocklist"
    },
    "extraResources": [
      {
        "from": "./external-files/",
        "to": "installed-resources"
      }
    ]
  }
}
