{
  "name": "pixellogic-desktop",
  "version": "20.0.4",
  "description": "Pixel map design, visualization, and LED engineering tools.",
  "author": "Dhiraj Kalra",
  "private": true,
  "main": "main.js",
  "scripts": {
    "sync": "node ../../scripts/sync-product-app.js pixel",
    "start": "npm run sync && electron .",
    "build": "npm run sync && electron-builder"
  },
  "dependencies": {
    "@google/genai": "^1.42.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "font-list": "^2.0.1"
  },
  "devDependencies": {
    "electron": "39.1.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.dhirajkalra.pixellogic",
    "productName": "Pixelogic",
    "directories": {
      "output": "../../out/pixellogic-v20.0.4"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "extraResources": [
      {
        "from": "external-files",
        "to": "installed-resources"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "install-info.txt"
    }
  }
}
