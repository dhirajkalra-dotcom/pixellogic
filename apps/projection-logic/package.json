{
  "name": "projection-logic-desktop",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "sync": "node ../../scripts/sync-product-app.js projection",
    "start": "npm run sync && electron .",
    "build": "npm run sync && electron-builder"
  },
  "dependencies": {
    "@google/genai": "^1.42.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "font-list": "^2.0.1"
  },
  "devDependencies": {
    "electron": "^39.1.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.dhirajkalra.projectionlogic",
    "productName": "Projection Logic",
    "directories": { "output": "../../out/projection-logic/${env.BUILD_ID}" },
    "win": { "icon": "build/icon.ico", "target": ["nsis", "portable"] },
    "extraResources": [{ "from": "external-files", "to": "installed-resources" }],
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "license": "install-info.txt" }
  }
}